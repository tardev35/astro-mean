---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";

// LOTTOTAX: หน้านี้เป็นบทความอ่าน ไม่ใช่หน้าปุ่มและไม่ใช่วิดเจ็ตกดเล่น ของเดิม
// มีช่องกรอกเลข + ปุ่ม "ตรวจหวย" ที่ตอบว่า "ถูกรางวัล" ทุกครั้งไม่ว่ากรอกอะไร
// ซึ่งเป็นคำกล่าวอ้างที่ไม่จริง จึงถอดออกทั้งชุดพร้อม <script> ของมัน
//
// สีย้ายจากทอง/แดงเลือดหมูของแบรนด์หวยก่อนหน้า มาที่น้ำเงินธงชาติเป็นสีนำและ
// แดงเป็นสีรอง — #dbeafe / #5c9bf0 / #1e63d8 / #12357e / #0d2559 คู่ #e63c28 /
// #a81c04 บนผิว #04091a / #081530 / #0b1b3a เนื้อความ #e6eefb
// สีเขียว success ของแถบสถานะไม่แตะ
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ

// 150–160 ตัวอักษร (ไทย 1 ตัว = 3 ไบต์ ห้ามวัดด้วย wc -c)
const pageDescription = "ตรวจหวยกับ LOTTOTAX ระบบตรวจผลรางวัลออโต้ รู้ผลไวหลังประกาศ สรุปยอดเงินรางวัลเข้าเครดิตให้เอง พร้อมตารางผลย้อนหลังแยกหมวดหมู่และคลังโพยที่ย้อนดูได้ทุกรายการ";

const pageTitle = "ตรวจหวย LOTTOTAX | ระบบตรวจผลรางวัลออโต้ รู้ผลไวทุกงวด";

const pageHeading = "ตรวจหวย LOTTOTAX ระบบตรวจผลรางวัลออโต้ รู้ผลไวทันทีหลังประกาศ";

const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ตรวจหวย", path: "/ตรวจหวย" },
  ],
});

// เขียนคลาสเต็มไว้เป็นค่าคงที่เพื่อให้ Tailwind สแกนเจอ (สแกนเป็นข้อความดิบ
// ไม่ได้ประเมิน template)
const headingClass = "bg-gradient-to-r from-[#dbeafe] via-[#5c9bf0] to-[#1e63d8] bg-clip-text text-xl leading-normal font-bold text-transparent md:text-2xl";

// ตัวอย่างรูปแบบการแสดงผลของตาราง ไม่ได้ผูกกับงวดใดงวดหนึ่ง จึงไม่มีคอลัมน์วันที่
const resultRows = [
  { market: "หวยรัฐบาลไทย", top3: "417", top2: "17", bottom2: "58" },
  { market: "หวยฮานอย (รอบพิเศษ)", top3: "236", top2: "36", bottom2: "04" },
  { market: "หวยลาวพัฒนา", top3: "905", top2: "05", bottom2: "72" },
  { market: "หวยยี่กี (รอบล่าสุด)", top3: "681", top2: "81", bottom2: "29" },
];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxHuay title={pageHeading} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#e6eefb]">
        หวยออกปุ๊บ รู้ผลปั๊บ คือสิ่งที่คอหวยอยากได้มากที่สุดหลังปิดรับของแต่ละงวด <strong class="text-[#5c9bf0]">LOTTOTAX</strong> จึงวางระบบตรวจผลรางวัลไว้ให้ทำงานเองแบบออโต้ ทั้งรวดเร็วและแม่นยำ สมาชิกไม่ต้องนั่งไล่เทียบเลขทีละใบให้เสียเวลาและเสี่ยงอ่านพลาด
        หน้านี้อธิบายว่าระบบตรวจผลของเราทำงานอย่างไร ตารางผลรางวัลย้อนหลังจัดหมวดหมู่ไว้แบบไหน และคลังโพยย้อนหลังตรวจย้อนกลับได้ละเอียดถึงระดับใด
      </p>

      <h2 class={`mb-6 ${headingClass}`}>ระบบตรวจผลรางวัลออโต้ ไม่ต้องนั่งไล่ตรวจโพยทีละใบ</h2>

      <p class="mb-4 text-left text-base leading-relaxed text-[#e6eefb]">
        ทันทีที่ผลของตลาดนั้นประกาศออกมา ระบบจะดึงผลรางวัลเข้ามาเทียบกับโพยทุกใบที่คีย์ไว้ในงวดเดียวกันให้เอง
        <strong class="text-[#5c9bf0]">แล้วสรุปยอดเงินรางวัลเข้าเครดิตทันทีหลังผลออกเสร็จสิ้น</strong>
        ไม่ต้องกดขอตรวจ ไม่ต้องส่งภาพโพยให้แอดมินไล่ดูทีละรายการ และไม่ต้องรอรอบสรุปประจำวันเหมือนการจดโพยแบบเดิม
      </p>

      <p class="mb-4 text-left text-base leading-relaxed text-[#e6eefb]">
        สิ่งที่ประหยัดไปจริง ๆ คือเวลาที่เคยหมดไปกับการนั่งเทียบเลขเอง เพราะการแทงแต่ละแบบใช้เกณฑ์ตัดสินคนละอย่าง ทั้ง 3 ตัวบน 3 ตัวโต๊ดที่สลับหลักได้ 2 ตัวบน 2 ตัวล่าง
        ไปจนถึงเลขวิ่งและเลขรูดที่นับจากหลักไหนก็ต่างกันอีก เมื่อให้ระบบเป็นฝ่ายเทียบ ผลที่ได้จึงออกมาเหมือนกันทุกใบ และไม่ขึ้นกับว่าคืนนั้นเราตาลายแค่ไหน
      </p>

      <p class="mb-8 text-left text-base leading-relaxed text-[#e6eefb]">
        อัตราจ่ายที่ใช้คำนวณคืออัตราที่ล็อกไว้ตั้งแต่ตอนกดยืนยันโพย ไม่ใช่ค่าที่มาปรับทีหลัง ยอดที่ขึ้นในหน้าสรุปจึงตรงกับที่เห็นตอนคีย์ และเป็นตัวเลขเดียวกับที่เข้าเครดิต ไม่มีการหักเพิ่มระหว่างทาง
      </p>

      <h2 class={`mb-6 ${headingClass}`}>ตารางผลรางวัลย้อนหลังแยกหมวดหมู่ ตามผลได้ครบทุกตลาด</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#e6eefb]">
        LOTTOTAX รวมผลของทุกตลาดที่เปิดรับไว้ในที่เดียว ทั้งหวยรัฐบาลไทย หวยลาว หวยฮานอยทั้งรอบปกติ รอบพิเศษและรอบ VIP หวยหุ้นไทยและต่างประเทศ รวมถึงยี่กีที่ออกผลทุก 15 นาที
        แต่ละตลาดแยกหมวดหมู่ของตัวเองและเรียงตามรอบประกาศผล ย้อนกลับไปดูงวดก่อนหน้าได้โดยไม่ต้องสลับแอปหรือไล่หาจากหลายเว็บให้ปวดหัว
      </p>

      <div class="mb-6 overflow-x-auto rounded-xl border border-[#1e63d8]/25 bg-[#04091a]">
        <table class="w-full min-w-[600px] text-left text-sm">
          <caption class="caption-top border-b border-[#1e63d8]/20 p-4 text-left text-xs leading-relaxed text-[#9db4d8]">
            ตัวอย่างรูปแบบตารางผลรางวัลที่ LOTTOTAX จัดไว้ให้อ่านง่าย ตัวเลขในตารางเป็นตัวอย่างการแสดงผลเท่านั้น ไม่ใช่ผลรางวัลของงวดใดงวดหนึ่ง
          </caption>
          <thead class="bg-gradient-to-r from-[#12357e] to-[#0d2559]">
            <tr class="text-[#dbeafe]">
              <th scope="col" class="p-4 font-bold">ตลาดหวย</th>
              <th scope="col" class="p-4 text-center font-bold">3 ตัวบน</th>
              <th scope="col" class="p-4 text-center font-bold">2 ตัวบน</th>
              <th scope="col" class="p-4 text-center font-bold">2 ตัวล่าง</th>
              <th scope="col" class="p-4 text-right font-bold">สถานะการจ่ายรางวัล</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#1e63d8]/15 text-[#e6eefb]">
            {
              resultRows.map((row) => (
                <tr class="transition-colors hover:bg-[#12357e]/40">
                  <th scope="row" class="p-4 text-left font-bold text-[#dbeafe]">
                    {row.market}
                  </th>
                  <td class="p-4 text-center text-xl font-black tracking-wider text-[#5c9bf0]">{row.top3}</td>
                  <td class="p-4 text-center font-bold">{row.top2}</td>
                  <td class="p-4 text-center font-bold">{row.bottom2}</td>
                  <td class="p-4 text-right">
                    <span class="rounded-full bg-green-900/50 px-3 py-1 text-[10px] font-bold text-green-400">สรุปยอดเข้าเครดิตแล้ว</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="mb-8 text-left text-base leading-relaxed text-[#e6eefb]">
        ที่ต้องดูให้ตรงคือประเภทที่แทงไว้ เพราะเลขชุดเดียวกันอาจถูกในหมวดหนึ่งแต่ไม่ถูกในอีกหมวด และแต่ละตลาดปิดรับกับประกาศผลคนละรอบกัน การเทียบผลข้ามงวดหรือข้ามตลาดจึงเป็นสาเหตุ
        ของความเข้าใจผิดบ่อยที่สุด ตารางจึงล็อกหมวดหมู่และรอบไว้ให้เห็นตั้งแต่แถวแรก
      </p>

      <h2 class={`mb-6 ${headingClass}`}>คลังโพยย้อนหลังตรวจได้ทุกรายการ โปร่งใสตั้งแต่ตอนคีย์จนถึงตอนจ่าย</h2>

      <p class="mb-4 text-left text-base leading-relaxed text-[#e6eefb]">
        โพยทุกใบที่คีย์เข้ามาถูกเก็บไว้ในคลังโพยของบัญชีตัวเอง เปิดย้อนดูได้ทุกรายการว่าแทงตลาดไหน งวดใด เลขอะไร ประเภทไหน ยอดเท่าไร และล็อกอัตราจ่ายไว้ที่เท่าไร
        พร้อมผลการตรวจของใบนั้นกำกับอยู่ในบรรทัดเดียวกัน ทำให้ย้อนดูสถิติการเดินเงินของตัวเองได้ ไม่ใช่แค่รู้ว่ารอบนี้ได้หรือเสีย
      </p>

      <p class="mb-4 text-left text-base leading-relaxed text-[#e6eefb]">
        กรณีที่ควรรู้ไว้คือรายการที่สถานะยังไม่ขยับหลังผลประกาศไปแล้ว ซึ่งมักเกิดกับตลาดที่ผลออกช้ากว่ากำหนดหรือรอบที่มีการยืนยันผลซ้ำ ให้แจ้งเลขที่โพยของใบนั้นให้แอดมินตรวจได้ทันที
        <strong class="text-[#5c9bf0]">ทีมงาน LOTTOTAX สแตนด์บายตลอด 24 ชั่วโมง</strong>
        มีเลขที่โพยเป็นตัวอ้างอิงก็ไล่กลับไปดูรายการเดียวกันได้เลย ไม่ต้องเล่าใหม่ทั้งงวด
      </p>

      <p class="text-left text-base leading-relaxed text-[#e6eefb]">
        ระบบตรวจผลที่ดีไม่ได้แปลว่าเลขจะเข้าบ่อยขึ้น มันแค่ทำให้ส่วนที่เป็นข้อเท็จจริง คือผลออกอะไรและโพยของเราตรงหรือไม่ตรง จบเร็วและตรวจสอบย้อนกลับได้ เหลือเวลาไปคิดเรื่องงวดหน้าแทน
      </p>
    </div>
  </ContentBoxHuay>

  <Navfoot />
</MainLayout>
