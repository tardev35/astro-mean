---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBox3ThreeCyberCut from "../components/ContentBox3ThreeCyberCut.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinnersCyber from "../components/LatestWinnersCyber.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Faq from "../components/Faq.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgIphonePrize from "../assets/slide2.png";
import imgAlphardPrize from "../assets/slide1.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxCyberCut as="h1" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   2 → ContentBoxTwoPremium as="h2" (ย่อหน้าเดียวแบ่งสองครึ่งตามลำดับประโยคเดิม:
//       ยกระดับแดชบอร์ดและคัดเกมเกรด A-List → ไม่ต้องสุ่มเกมคุณภาพต่ำ พุ่งตรงเข้าสปิน)
//   3 → ContentBox3ThreeCyberCut as="h2" (ย่อหน้าเดียวแบ่งลงสามคอลัมน์ตามลำดับประโยค
//       เดิม: ขนทัพค่ายชั้นนำระดับโลก → ครบทุกแนวทั้ง 3D คลาสสิก และสายซื้อฟรีสปิน →
//       สลับแนวได้ตลอดผ่านกระเป๋าเดียว) แล้วต่อด้วย ProviderGridPremium ซึ่งกางรายชื่อ
//       ค่ายที่ย่อหน้าเดียวกันระบุไว้ตรงๆ (PG Soft / Pragmatic Play / Joker Gaming)
//   4 → ContentBoxSevenThree as="h2" + slide2 แล้วต่อด้วย FeatureHighlights ซึ่งกาง
//       สี่ฟีเจอร์ที่ย่อหน้าเดียวกันเอ่ยชื่อไว้ตรงๆ (Multiplier / Expanding Wild /
//       Cascading / Bonus Buy) → h3 สี่ตัว ซึ่งเป็น h3 ชุดเดียวที่ได้รับอนุญาตบน
//       หน้านี้ คำอธิบายเขียนขยายความใหม่ ไม่ได้ก๊อบประโยคด้านบนซ้ำ
//   5 → ContentBoxSevenThreeCyberCut as="h2" + slide1 (อาร์ตสไลด์เป็นรถ TOYOTA
//       ALPHARD รางวัลใหญ่สุดของชุดโปร ซึ่งเป็นรูปธรรมของหัวข้อเรื่องโปรน่าตามที่
//       เติมสิทธิ์พิเศษให้สมาชิก)
//   6 → ContentBoxNeumorphism as="h2" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   7 → ContentBoxTwoNeumorphism as="h2" (ย่อหน้าเดียวแบ่งสองครึ่งตามลำดับประโยคเดิม)
//
// variant รอบนี้หมุนออกจากชุดของแบรนด์ก่อนทั้งตระกูล: ทรง ContentBox เปลี่ยนจาก
// Premium + TwoCyberCut + 3ThreePremium + Special + SevenThreePremium +
// SevenThreeNeumorphism + FloatingBadge มาเป็น CyberCut + TwoPremium +
// 3ThreeCyberCut + SevenThree + SevenThreeCyberCut + Neumorphism + TwoNeumorphism
// ส่วน Announcement เป็น AnnouncementCyber, LatestWinners เป็น LatestWinnersCyber,
// กริดค่ายเกมเป็น ProviderGridPremium, การ์ดรีวิวเป็น ReviewCardSumo2 และ Faq เป็น
// ตัวฐาน — Navbar/Footer/ฟอนต์ ถูกสลับไว้แล้วใน MainLayout กับ brandProfile
// GameRankingBoard เป็นสมาชิกตัวเดียวของตระกูลตัวเอง จึงถูกใช้ซ้ำโดยไม่มีตัวหมุน
//
// ContentBoxSevenThree* ปล่อยหัวข้อผ่าน `title` ตัวเดียว ส่วน titleleft เป็นป้าย
// คอลัมน์รูปที่เป็น <p> — ห้ามส่ง titleright เพิ่ม เพราะจะได้ป้ายเกินมาโดยไม่มี
// ต้นทางใน docx
//
// Announcement ส่ง message ตรงๆ เสมอ เพราะ default ของทุก variant ในตระกูลนี้เป็น
// สโลแกนของแบรนด์เก่าคนละเจ้ากัน ข้อความชุดนี้ตรงตัวต่อตัวกับ default ของ
// AnnouncementCyber.astro เพื่อให้ ticker ของหน้าย่อยที่เรียก <Announcement /> เปล่าๆ
// วิ่งข้อความเดียวกับหน้าแรก และห้ามขึ้นต้นด้วย emoji เพราะ marquee render ข้อความ
// ซ้ำและ emoji ที่ฝังในสตริงถูก mark aria-hidden ไม่ได้
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook คู่กับ slide2/slide1 ซึ่งเป็นสไลด์ที่
// อาร์ตตรงกับหัวข้อ docx ข้อ 4 กับข้อ 5 — slide3 (KAWASAKI NINJA H2) ถูกปล่อยไม่ใช้
// ที่นี่โดยตั้งใจ เพราะเพดาน SevenThree เต็มแล้ว และมันไปโผล่ในกริดของหน้า
// /promotion แทน ส่วน slide4 เป็นของแบรนด์เก่าที่ค้างบนดิสก์ ห้าม import ที่ไหน
// ทั้งสิ้น และไฟล์ banner ทุกตัว (ทั้งตัวที่มีเลขต่อท้ายและตัวมือถือ) ห้าม import
// ที่นี่ เพราะรูปที่ import คือรูปที่ถูก emit ลง dist/ ถึงจะไม่มีใคร render ก็ตาม —
// banner1 เป็นของ MainLayout จัดการเอง และรูปในหน้านี้ไม่มีตัวไหนใส่
// loading="eager"/fetchpriority="high" เพราะ LCP เป็นของ hero ใน MainLayout
//
// widget ที่ไม่ได้มาจาก docx (GameRankingBoard, LatestWinnersCyber, LoginRtpSection,
// ReviewCardSumo2, แถวปุ่ม login/register, Faq, Navfoot) ใช้ป้ายเป็น <p>/<span> +
// aria-label บน <section> และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้ายทั้งชุด ยกเว้นสองตัว
// ที่เป็นภาพประกอบของหัวข้อ docx หนึ่งข้อโดยตรง (ProviderGridPremium → ข้อ 3,
// FeatureHighlights → ข้อ 4) ซึ่งวางต่อท้ายบล็อกนั้นๆ
//
// h1 ×1 + h2 ×6 = หัวข้อ docx พอดี บวก h3 ×4 จาก FeatureHighlights ซึ่งเป็นรายการ
// ย่อยของหัวข้อข้อ 4 ตามข้อยกเว้นเดียวที่ playbook อนุญาต — หัว FAQ เป็น <p> ใน
// Faq.astro คำถามเป็น <span> ใน <summary> ชื่อกริดค่ายใน ProviderGridPremium.astro
// เป็น <p> และป้ายคอลัมน์ของทุก ContentBox variant เป็น <p>
//
// title กับ description ใช้บรรทัดที่ brief ให้มาตรงๆ ทั้งคู่ ห้ามเติมหรือตัด และเป็น
// สตริงเดียวกับที่ส่งเข้า pageGraph และ MainLayout
const pageTitle = "VIPSAND356 | สล็อตของพรีเมียม คัดเกมเด็ดมาเต็ม บริการระดับ VIP";
const pageDescription = "VIPSAND356 สล็อตของพรีเมียม คัดเกมเด็ดมาเต็มหลายสไตล์ ครบทั้งเกมดัง ฟีเจอร์ใหม่ และโปรน่าตาม ระบบออโต้ช่วยให้ทำรายการคล่อง พร้อมบริการระดับ VIP";

const announcementMessage =
  "VIPSAND356 สล็อตของพรีเมียม คัดเกมเด็ดมาเต็ม บริการระดับ VIP • เว็บตรงสล็อตพรีเมียม API แท้ ยิงตรงจากคลังเกมหลักสากล ไม่ผ่านเอเย่นต์ ค่า RTP ตรงตามสเปกโรงงานผู้พัฒนา ไร้การดัดแปลงระบบ ไม่ล็อกยูส ฝากถอนออโต้ประมวลผลไวใน 3 วินาที การันตีถอนได้เต็มทุกยอด • ยกระดับหน้าแดชบอร์ดให้หรูหราและใช้งานง่าย จัดหมวดหมู่เกมอย่างเป็นระเบียบ คัดเฉพาะเกมเกรด A-List ที่จ่ายรางวัลโปร่งใสและโบนัสแจ็คพอตแตกง่ายมาไว้ในที่เดียว พุ่งตรงเข้าสปินทำกำไรได้ตั้งแต่เปิดหน้าแรก • ขนทัพค่ายเกมชั้นนำระดับโลก PG Soft, Pragmatic Play, Joker Gaming และอีกมากมาย ครบทุกแนว ทั้งสล็อตวิดีโอ 3D ภาพสวยสมจริง สล็อตคลาสสิกตัวคูณหนัก และสล็อตสายซื้อฟรีสปิน สลับเปลี่ยนแนวได้ตลอดผ่านระบบกระเป๋าเดียว • ฟีเจอร์ยุคใหม่อัปเดตเข้าระบบครบ ทั้ง Multiplier สะสมตัวคูณทวีคูณ Expanding Wild ยืดเต็มรีล คอมโบแตกต่อเนื่อง Cascading และโหมด Bonus Buy พุ่งตรงเข้าลุ้นรอบแจ็คพอตทันที • โปรน่าตามอัปเดตต่อเนื่อง กดรับเองผ่านหน้าเว็บได้เรื่อยๆ ทั้งโบนัสต้อนรับสมาชิกใหม่ โปรฝากแรกของวัน และคืนยอดเสีย Cash Back ทุกวัน เงื่อนไขชัดเจน ไม่ติดเทิร์นโอเวอร์ซับซ้อน • ระบบออโต้ไฮสปีดตัดขั้นตอนรออนุมัติและการส่งสลิปออกทั้งหมด ทำรายการผ่าน Gateway ตรงเสร็จใน 3 วินาที เครดิตเข้าเกมไว ถอนกำไรเด้งเข้าบัญชีทันใจ • บริการระดับ VIP ทีมงานแอดมินมืออาชีพสแตนด์บายตลอด 24 ชั่วโมง ซัพพอร์ตทุกข้อสงสัยรวดเร็ว ทั้งขั้นตอนสมัคร การรับโปรโมชัน และแนะนำระบบการใช้งาน";

// FAQ ห้าข้อเขียนขึ้นใหม่จากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้า
// ไหนมาทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบ
// คำถามที่สายปั่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน — ห้ามปล่อยให้
// Faq ใช้ค่า default ของตัวเอง เพราะ default เป็นลิสต์ว่างโดยตั้งใจ
const faqs = [
  {
    q: "VIPSAND356 เป็นเว็บตรงจริงไหม แล้วค่า RTP ถูกดัดแปลงหรือเปล่า",
    a: "เป็นเว็บตรงสล็อตพรีเมียมที่เชื่อมต่อ API แท้ ยิงตรงจากคลังเกมหลักสากลโดยไม่ผ่านเอเย่นต์ ค่า RTP จึงตรงตามสเปกที่โรงงานผู้พัฒนากำหนดไว้จริง ไร้การดัดแปลงระบบระหว่างทางและไม่ล็อกยูส เมื่อทำเงื่อนไขครบก็การันตีถอนได้เต็มทุกยอดตามมาตรฐานการบริการระดับ VIP",
  },
  {
    q: "เกมเยอะขนาดนี้ หาเกมที่อยากเล่นยากไหม",
    a: "หน้าแดชบอร์ดถูกยกระดับให้หรูหราและใช้งานง่าย จัดหมวดหมู่เกมไว้อย่างเป็นระเบียบ และคัดเฉพาะเกมเกรด A-List ที่จ่ายรางวัลโปร่งใสและโบนัสแจ็คพอตแตกง่ายมารวมไว้ในที่เดียว ผู้เล่นจึงไม่ต้องเสียเวลานั่งสุ่มเล่นเกมคุณภาพต่ำ และพุ่งตรงเข้าสปินทำกำไรได้ตั้งแต่เปิดหน้าแรก",
  },
  {
    q: "มีค่ายเกมอะไรบ้าง แล้วสลับเล่นข้ามค่ายต้องโยกเงินไหม",
    a: "ขนทัพค่ายเกมชั้นนำระดับโลกอย่าง PG Soft, Pragmatic Play, Joker Gaming และอีกมากมายมารวมไว้ในคลังเดียว มีเกมเด็ดครบทุกแนว ทั้งสล็อตวิดีโอ 3D ภาพสวยสมจริง สล็อตคลาสสิกตัวคูณหนัก และสล็อตสายซื้อฟรีสปิน สลับเปลี่ยนแนวการปั่นได้ตลอดเวลาผ่านระบบกระเป๋าเดียวที่ไม่ต้องเสียเวลาโยกเงิน",
  },
  {
    q: "ฟีเจอร์ในเกมมีอะไรให้ลุ้นบ้าง แล้วโปรของสมาชิกมีอะไรต่อเนื่องไหม",
    a: "ฟีเจอร์ยุคใหม่ถูกอัปเดตเข้าระบบครบ ทั้ง Multiplier ที่สะสมตัวคูณทวีคูณ สัญลักษณ์ Expanding Wild ที่ยืดเต็มรีล คอมโบแตกต่อเนื่อง Cascading และโหมด Bonus Buy ที่พุ่งตรงเข้าลุ้นรอบแจ็คพอตทันที ส่วนโปรก็อัปเดตต่อเนื่องให้กดรับเองผ่านหน้าเว็บ ทั้งโบนัสต้อนรับสมาชิกใหม่ โปรฝากแรกของวัน และคืนยอดเสีย Cash Back ทุกวัน",
  },
  {
    q: "ฝากถอนนานไหม ต้องส่งสลิปให้แอดมินหรือเปล่า",
    a: "ระบบการเงินเป็นออโต้ไฮสปีดที่ตัดขั้นตอนรออนุมัติและการส่งสลิปออกทั้งหมด ทำรายการผ่าน Gateway ตรงเสร็จสรรพภายใน 3 วินาที เครดิตอัปเดตเข้าเกมไวและถอนกำไรเด้งเข้าบัญชีทันใจ หากติดขัดตรงไหนก็มีทีมงานแอดมินมืออาชีพสแตนด์บายให้บริการตลอด 24 ชั่วโมง",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxCyberCut as="h1" title="VIPSAND356 สล็อตของพรีเมียม คัดเกมเด็ดมาเต็ม บริการระดับ VIP">
    <p class="text-left text-base leading-relaxed">
      VIPSAND356 เว็บตรงสล็อตพรีเมียม API แท้ ยิงตรงจากคลังเกมหลักสากล ไม่ผ่านเอเย่นต์ ชูจุดเด่นเรื่องความโปร่งใสด้วยค่า RTP ตรงตามสเปกโรงงานผู้พัฒนา ไร้การดัดแปลงระบบ ไม่ล็อกยูส
      มาพร้อมระบบฝากถอนออโต้ประมวลผลไวใน 3 วินาที รองรับทุกช่องทางการเงิน การันตีถอนได้เต็มทุกยอดด้วยมาตรฐานการบริการระดับ VIP
    </p>
  </ContentBoxCyberCut>

  <ContentBoxTwoPremium
    as="h2"
    title="VIPSAND356 สล็อตของพรีเมียม ยกระดับล็อบบี้ให้ทุกเกมมีฟีลน่าค้นกว่าเดิม"
    titleleft="แดชบอร์ดหรูหรา จัดหมวดหมู่เป็นระเบียบ"
    titleright="พุ่งตรงเข้าสปินได้ตั้งแต่เปิดหน้าแรก">
    <p slot="left" class="text-left text-base leading-relaxed">
