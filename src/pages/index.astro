---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBox3Three from "../components/ContentBox3Three.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import LatestWinnersCyber from "../components/LatestWinnersCyber.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Faq4 from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgRankingTiers from "../assets/slide1.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxCyberCut as="h1" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   2 → ContentBoxTwoCyberCut as="h2" (แบ่งย่อหน้าเดียวลง left/right ตามลำดับ
//       ประโยคเดิม ไม่ตัดและไม่ย่อ)
//   3 → ContentBox3Three as="h2" (ย่อหน้าเดียวแบ่งลงสามคอลัมน์ตามจังหวะประโยค:
//       กวาดค่ายยักษ์ใหญ่มาไว้ครบ → คัดเฉพาะตัวที่อัตราจ่ายเป็นธรรม → เบทเริ่ม 1
//       บาท) แล้วต่อด้วย ProviderGrid ซึ่งกางรายชื่อค่ายที่ย่อหน้าเดียวกันพูดถึง
//   4 → ContentBoxSpecial as="h2" (สองครึ่ง: ล็อบบี้จัดระเบียบกับหมวดเกมฮิต /
//       ดึงเกมกระแสมาเสิร์ฟหน้าแรกและสลับค่ายได้ทันที) แล้วต่อด้วย GameRankingBoard
//       ที่กางหมวด "เกมฮิตกระแสแรง" ให้เห็นในหน้าเดียว และ SmoothCarousel ซึ่งรอบนี้
//       เป็นแถบแบนเนอร์ค่ายเกม/เกมออกใหม่ จึงอ่านเป็นภาพล็อบบี้ของหัวข้อเดียวกัน
//   5 → ContentBoxNeumorphism as="h2" (ย่อหน้าเดียวเต็มๆ เรื่องกลไกทำเงินยุคใหม่)
//   6 → ContentBoxSevenThreeCyberCut as="h2" + slide1 (แบนเนอร์ระบบลำดับขั้นสะสม
//       ออร่า ยิ่งฝากยิ่งอัพเลเวลเพื่อรับโบนัส ตรงกับหัวข้อเรื่องโปรดีน่าตามที่เติม
//       สิทธิ์เด็ดให้ตลอดวัน) แล้วต่อด้วย LatestWinnersCyber ซึ่งเป็นหลักฐานของ
//       ประโยค "กดรับแล้วถอนได้จริง"
//   7 → ContentBoxFloatingBadge as="h2" (ป้ายหัวข้อลอยเหนือการ์ดคอลัมน์เดียว)
//
// variant รอบนี้หมุนทั้งตระกูลจากรอบก่อน: ทรง ContentBox ย้ายจากชุด Premium นำมา
// เป็นชุด CyberCut นำ + 3Three + Special + Neumorphism + FloatingBadge ส่วน Navbar
// เป็น NavbarCyber, Footer เป็น FooterCyber, Announcement เป็น AnnouncementCyber,
// LatestWinners เป็น LatestWinnersCyber และ Faq เป็น Faq4
//
// Announcement ส่ง message ตรงๆ เสมอ เพราะ default ของทุก variant ในตระกูลนี้เป็น
// สโลแกนของแบรนด์เก่าคนละเจ้ากัน ข้อความชุดนี้ตรงกับ default ของ AnnouncementCyber
// เป๊ะ เพื่อให้ ticker ของหน้าย่อยที่เรียก <Announcement /> เปล่าๆ วิ่งข้อความเดียว
// กับหน้าแรก และห้ามขึ้นต้นด้วย emoji เพราะ marquee render ข้อความซ้ำและ emoji ที่
// ฝังในสตริงถูก mark aria-hidden ไม่ได้
//
// SevenThree ใช้บล็อกเดียวรอบนี้ (เพดานของ playbook คือสอง) เพราะสไลด์ที่เป็นของ
// แบรนด์นี้จริงมีใบเดียวคือ slide1 — slide2/3/4 กับ banner ทุกหมายเลขเป็นอาร์ตของ
// แบรนด์ก่อนที่มีชื่อและโดเมนของเขาพิมพ์อยู่บนรูป ห้าม import ที่นี่หรือที่ไหนก็ตาม
// เพราะรูปที่ import คือรูปที่ถูก emit ถึงจะไม่มีใคร render ก็ตาม ส่วน banner1 กับ
// banner1-mobile เป็นของ MainLayout จัดการเอง
//
// widget ที่ไม่ได้มาจาก docx (LoginRtpSection, ReviewCardSumo2, แถวปุ่ม
// login/register, FAQ, Navfoot) ใช้ป้ายเป็น <p>/<span> + aria-label บน <section>
// และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้ายทั้งชุด ยกเว้นสี่ตัวที่เป็นภาพประกอบของ
// หัวข้อ docx หนึ่งข้อโดยตรง (ProviderGrid → ข้อ 3, GameRankingBoard กับ
// SmoothCarousel → ข้อ 4, LatestWinnersCyber → ข้อ 6) ซึ่งวางต่อท้ายบล็อกนั้นๆ
//
// h1 ×1 + h2 ×6 = หัวข้อ docx พอดี ไม่มีตัวที่แปด — หัว FAQ เป็น <p> ใน Faq4.astro
// คำถามใน Faq4 เป็น <span> ใน <summary> และป้ายคอลัมน์ของทุก ContentBox variant
// เป็น <p> — docx รอบนี้แบน H1 + H2 ล้วน หน้านี้จึงไม่มี h3 เลย
//
// title ใช้บรรทัด Title ของ docx ตรงๆ ส่วน description อยู่ในเกท 150–160 ตัวอักษร
// ของ tools/verify-build.mjs ทั้งสองค่าเป็นสตริงเดียวกับที่ส่งเข้า pageGraph ตรงกับ
// ที่ส่งให้ MainLayout และตรงกับ default ที่ MainLayout ตั้งไว้เป๊ะ
const pageTitle = "AURA456 | สล็อตตัวตึงออร่าพุ่ง ระบบแรง เกมเด็ดพร้อมลั่น โปรดีน่าตาม";
const pageDescription =
  "AURA456 สล็อตตัวตึงออร่าพุ่ง ระบบแรง เกมเด็ดพร้อมลั่นจากหลายค่าย ตัวฮิตขึ้นหน้า ฟีเจอร์หลากหลาย โปรดีน่าตาม พร้อมออโต้ทำรายการตลอดวัน ฝากถอนไว 3-5 วินาที";

const announcementMessage =
  "AURA456 สล็อตตัวตึงออร่าพุ่ง ระบบแรง เกมเด็ดพร้อมลั่น โปรดีน่าตาม • เว็บตรงสล็อตคัดเกรด รันบนเซิร์ฟเวอร์หลัก API แท้ 100% ค่า RTP โปร่งใส ไม่มีการดัดแปลงระบบหลังบ้าน ออโต้ประมวลผลไว 3 วินาที กดฝากปุ๊บเงินเข้าปั๊บ ถอนกำไรเด้งเข้าบัญชีทันใจ • วางโครงสร้างสถาปัตยกรรมเว็บให้ตอบสนองฉับไวตั้งแต่คลิกแรก อินเทอร์เฟซสะอาดตา ไร้ป๊อปอัปโฆษณากวนใจ โหลดเกมและกราฟิก 3D ลื่นไหลไม่มีกระตุกแม้ช่วงพีค • กวาดเกมสล็อตลิขสิทธิ์แท้จากค่ายยักษ์ใหญ่ทั่วโลกมาไว้ในล็อบบี้ ทั้ง PG Soft Pragmatic Play Joker และอีกมากมาย เบทเริ่มต้นเบาๆ แค่ 1 บาท ก็ลุ้นโบนัสก้อนโตได้ • จัดระเบียบหน้าล็อบบี้ให้ใช้งานง่าย หมวดเกมฮิตกระแสแรงขึ้นโชว์ทันทีที่เข้าสู่ระบบ สลับค่ายเล่นได้ทันทีแบบไม่ต้องโยกเงินในกระเป๋า • อัดแน่นด้วยกลไกทำเงินยุคใหม่ ทั้ง Cascading คอมโบสัญลักษณ์แตกต่อเนื่อง Multiplier ตัวคูณทวีคูณ Wild ยืดขยายทับรีล และโหมด Bonus Buy ซื้อฟรีสปิน • แจกสิทธิประโยชน์ที่ใช้งานได้จริง ทั้งโบนัสต้อนรับสมาชิกใหม่ โปรเพิ่มทุนยอดฝากแรกของวัน และคืนยอดเสีย Cash Back เงื่อนไขตรงไปตรงมา ไม่ติดเทิร์นโอเวอร์มหาโหด • ฝากถอนออโต้ 100% เชื่อมต่อตรงกับธนาคารและวอลเล็ท ทำรายการเสร็จใน 3-5 วินาที ไม่ต้องส่งสลิป ไม่ต้องรอคิวอนุมัติ ถอนได้ตลอด 24 ชั่วโมง";

// FAQ ห้าข้อเขียนขึ้นใหม่จากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้า
// ไหนมาทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบ
// คำถามที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq4> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน
const faqs = [
  {
    q: "AURA456 เป็นเว็บสล็อตแบบไหน แล้วเกมในล็อบบี้เป็นลิขสิทธิ์แท้จริงไหม",
    a: "เป็นเว็บตรงสล็อตคัดเกรดที่รันบนเซิร์ฟเวอร์หลัก เชื่อมด้วย API แท้ 100% เกมทุกตัวในล็อบบี้จึงเป็นลิขสิทธิ์แท้จากค่ายยักษ์ใหญ่ทั่วโลก ทั้ง PG Soft, Pragmatic Play, Joker และอีกมากมาย ค่า RTP โปร่งใสตามที่ค่ายผู้พัฒนาตั้งไว้ ไม่มีการดัดแปลงระบบหลังบ้าน และคัดเน้นๆ เฉพาะเกมที่มีอัตราจ่ายรางวัลเป็นธรรม จ่ายเงินจริงตามระบบอัลกอริทึมโรงงาน",
  },
  {
    q: "ทุนน้อยเล่นได้ไหม เบทเริ่มต้นเท่าไหร่ แล้วต้องโยกเงินข้ามค่ายหรือเปล่า",
    a: "เบทเริ่มต้นเบาๆ แค่ 1 บาทก็พร้อมลุ้นโบนัสก้อนโตได้ทันที ไม่ต้องมีทุนหนักถึงจะเข้าเล่นได้ และระบบใช้กระเป๋าเดียวจบ อยากสลับไปปั่นค่ายไหนก็กดเปลี่ยนได้ทันทีโดยไม่ต้องโยกเงินในกระเป๋าไปมา ทำให้เลือกเกมได้อิสระโดยไม่เสียจังหวะระหว่างทาง",
  },
  {
    q: "ช่วงที่คนเล่นเยอะ เกมจะค้างหรือเด้งหลุดไหม",
    a: "โครงสร้างสถาปัตยกรรมเว็บวางมาให้ตอบสนองฉับไวตั้งแต่คลิกแรก อินเทอร์เฟซสะอาดตา ไร้ป๊อปอัปโฆษณากวนใจ โหลดตัวเกมและกราฟิก 3D ได้ลื่นไหลไม่มีกระตุก แม้จะเป็นช่วงเวลาพีคที่มีผู้เล่นหนาแน่น จังหวะสปินก็ยังสมูธ ไม่มีปัญหาเกมค้างหรือเด้งหลุดมาทำลายอารมณ์บวก",
  },
  {
    q: "หาเกมเด็ดยังไงให้เร็ว แล้วแต่ละเกมมีลูกเล่นอะไรให้ลองบ้าง",
    a: "หน้าล็อบบี้จัดระเบียบไว้ให้ใช้งานง่าย หมวดหมู่ เกมฮิตกระแสแรง ขึ้นโชว์เด่นหราทันทีที่เข้าสู่ระบบ ค่ายดังเปิดตัวเกมไหนหรือคนกำลังฮิตปั่นเกมอะไรก็ถูกดึงมาเสิร์ฟถึงหน้าแรก ส่วนกลไกในตัวเกมมีให้ลองครบ ทั้งระบบ Cascading คอมโบสัญลักษณ์แตกต่อเนื่อง, Multiplier สุ่มแจกตัวคูณหนักแบบทวีคูณ, สัญลักษณ์ Wild ยืดขยายทับรีล และโหมด Bonus Buy สำหรับสายที่อยากซื้อฟรีสปินพุ่งชนแจ็คพอตใหญ่",
  },
  {
    q: "โปรโมชั่นมีอะไรบ้าง ติดเทิร์นโอเวอร์ไหม แล้วฝากถอนใช้เวลานานแค่ไหน",
    a: "สิทธิ์หลักมีทั้งโบนัสต้อนรับสมาชิกใหม่ โปรเพิ่มทุนสำหรับยอดฝากแรกของวัน และระบบคืนยอดเสีย Cash Back ที่ช่วยซัพพอร์ตทุนให้กลับมาแก้ตัวได้ใหม่ เงื่อนไขตรงไปตรงมา ถอนได้จริง ไม่ติดเทิร์นโอเวอร์มหาโหด ส่วนการทำรายการวิ่งผ่านระบบฝากถอนออโต้ 100% ที่เชื่อมต่อตรงกับธนาคารและแอปพลิเคชันวอลเล็ท เสร็จสิ้นใน 3-5 วินาที ไม่ต้องส่งสลิปให้แอดมิน ไม่ต้องรอคิวอนุมัติ และกดถอนได้ตลอด 24 ชั่วโมง",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxCyberCut as="h1" title="AURA456 สล็อตตัวตึงออร่าพุ่ง ระบบแรง เกมเด็ดพร้อมลั่น โปรดีน่าตาม">
    <p class="text-left text-base leading-relaxed">
      AURA456 เว็บตรงสล็อตคัดเกรด รันบนเซิร์ฟเวอร์หลัก API แท้ 100% สล็อตแตกง่าย ค่า RTP โปร่งใส ไม่มีการดัดแปลงระบบหลังบ้าน มาพร้อมระบบออโต้ประมวลผลไว 3 วินาที กดฝากปุ๊บเงินเข้าปั๊บ
      ถอนกำไรเด้งเข้าบัญชีทันใจ ไร้เงื่อนไขจุกจิก ปั่นง่าย ทำกำไรคล่อง ตอบโจทย์สายสปินที่ต้องการผลลัพธ์ชัดเจน
    </p>
  </ContentBoxCyberCut>

  <ContentBoxTwoCyberCut
    as="h2"
    title="AURA456 สล็อตตัวตึงออร่าพุ่ง เปิดฟอร์มระบบแรงให้ทุกจังหวะไปต่อได้คล่อง"
    titleleft="ตอบสนองฉับไวตั้งแต่คลิกแรก"
    titleright="ช่วงพีคคนแน่นก็ยังสปินสมูธ">
    <p slot="left" class="text-left text-base leading-relaxed">
      ระบบแรงไม่ต้องรอโหลดนาน AURA456 วางโครงสร้างสถาปัตยกรรมเว็บให้ตอบสนองฉับไวตั้งแต่คลิกแรก อินเทอร์เฟซสะอาดตา ไร้ป๊อปอัปโฆษณากวนใจ โหลดตัวเกมและกราฟิก 3D ได้ลื่นไหลไม่มีกระตุก
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">แม้จะเป็นช่วงเวลาพีคที่มีผู้เล่นหนาแน่น จังหวะสปินของคุณก็จะยังสมูธ ไม่มีปัญหาเกมค้างหรือเด้งหลุดมาทำลายอารมณ์บวก</p>
  </ContentBoxTwoCyberCut>

  <ContentBox3Three
    as="h2"
    title="เกมเด็ดพร้อมลั่นจากหลายค่าย AURA456 รวมตัวน่าเล่นไว้แน่นแค่ไหน?"
    titleleft="ค่ายยักษ์ใหญ่ครบในล็อบบี้เดียว"
    titlecenter="อัตราจ่ายเป็นธรรม จ่ายเงินจริง"
