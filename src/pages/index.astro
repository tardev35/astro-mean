---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBox3ThreeCyberCut from "../components/ContentBox3ThreeCyberCut.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGridPremium.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgLuckyWheel from "../assets/slide2.png";
import imgCashback from "../assets/slide3.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxCyberCut as="h1"
//   2 → ContentBoxSevenThreeNeumorphism as="h2" + slide2 (โปรโมชั่นกงล้อรับโชค)
//   3 → ContentBox3ThreeCyberCut as="h2" (แบ่งย่อหน้าเดียวลง left/center/right ที่รอยต่อประโยค)
//   4 → ContentBoxTwoNeumorphism as="h2" (แบ่งย่อหน้าเดียวลง left/right)
//   5 → ContentBoxSevenThreeCyberCut as="h2" + slide3 (คืนยอดเสีย 4% ทุกวันอาทิตย์)
//   6 → ContentBoxNeumorphism as="h2"
//   7 → ContentBox as="h2" (การ์ดกลางที่ terms/privacy ใช้ร่วม)
//
// variant รอบนี้เปลี่ยนทั้งตระกูลจากแบรนด์ก่อนหน้า (GALA89 ใช้ Premium +
// TwoPremium + SevenThreePremium + FloatingBadge + SevenThreeFloatingBadge +
// Special + 3ThreePremium) มาเป็นทรง CyberCut + Neumorphism + plain ส่วน Faq ย้าย
// จาก Faq4 มาเป็น Faq2, Announcement จาก 5 มาเป็น 3, LatestWinners จาก 2 มาเป็น 3
// และ ProviderGrid จากตัวธรรมดามาเป็น ProviderGridPremium
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook — slide2 (โปรโมชั่นกงล้อรับโชค
// ลุ้นทองคำหนัก 1 บาท) คู่กับหัวข้อเปิดฟลอร์คาสิโนยกเกมสดมาให้เลือกครบ และ slide3
// (คืนยอดเสีย 4% ทุกวันอาทิตย์) คู่กับหัวข้อฝากถอน 5 วิ ส่วน slide1/slide4 เป็นของ
// SmoothCarousel กับหน้า /promotion แต่ละใบมีบ้านเดียวบนหน้าเว็บ ส่วน banner.png
// กับ banner2/3/4 เป็นอาร์ตค้างของแบรนด์ก่อนๆ จึงไม่ถูก import ที่ไหน — รูปที่
// import คือรูปที่ถูก emit ถึงจะไม่มีใคร render ก็ตาม
//
// banner1 เป็น hero ที่ MainLayout จัดการเอง (พร้อม banner1-mobile ของมันเอง)
// รอบนี้จึงไม่มีรูปประกอบใน ContentBox เดี่ยว
//
// widget ที่ไม่ได้มาจาก docx (ProviderGrid, GameRankingBoard, LatestWinners,
// LoginRtpSection, ReviewCardSumo2, SmoothCarousel, แถวปุ่ม login/register) ใช้
// ป้ายเป็น <p>/<span> + aria-label บน <section> จึงวางต่อท้ายหัวข้อ docx ที่มัน
// สังกัดได้โดยลำดับ h2 ไม่เพี้ยน — ProviderGrid ต่อจากหัวข้อค่ายเกมสดในล็อบบี้เดียว,
// GameRankingBoard ต่อจากหัวข้อเลือกห้องบาคาร่า/รูเล็ต, LatestWinners ต่อจากหัวข้อ
// ฝากถอน 5 วิ, LoginRtpSection ต่อจากหัวข้อประสบการณ์คาสิโนฟลอร์ใหญ่ แล้วปิดท้าย
// ด้วย ReviewCardSumo2 + SmoothCarousel + แถวปุ่ม + FAQ
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx + หัวข้อ FAQ ที่หน้านี้เขียนเอง = 7
// คำถามใน Faq2 เป็น <span> ใน <summary> ไม่ใช่ h3 และ titleleft/titlecenter/
// titleright ของ ContentBox3ThreeCyberCut กับ titleleft/titleright ของ
// ContentBoxTwoNeumorphism เป็น <p> — docx รอบนี้แบน H1+H2 ล้วน หน้านี้จึงไม่มี h3 เลย
const pageTitle = "MAHAHENG333 | คาสิโนฟลอร์ใหญ่ เปิดโต๊ะมหาเฮง เกมสดหลายโต๊ะ";
// บรรทัด Des ของ docx ยาว 153 ตัวอักษร อยู่ในเกท 150–160 ของ verify-build อยู่แล้ว
// จึงใช้ตามที่ brief เขียนมาทั้งบรรทัด ไม่ต้องตัดและไม่ต้องเติม
const pageDescription =
  "MAHAHENG333 คาสิโนฟลอร์ใหญ่ เปิดโต๊ะมหาเฮง เกมสดหลายโต๊ะ ครบทั้งบาคาร่า รูเล็ต และโต๊ะยอดนิยม เลือกห้องง่าย เปลี่ยนโต๊ะคล่อง ฝากถอน 5 วิ พร้อมดูแลทุกเวลา";

// default message ของ Announcement ทุก variant คือสโลแกนของแบรนด์เก่าคนละเจ้ากัน
// จึงส่ง message ตรงๆ เสมอ ไม่พึ่ง default และห้ามขึ้นต้นด้วย emoji
const announcementMessage =
  "MAHAHENG333 คาสิโนฟลอร์ใหญ่ เปิดโต๊ะมหาเฮง เกมสดหลายโต๊ะ • อาณาจักรคาสิโนสดที่รวมโต๊ะเดิมพันคุณภาพสูงไว้เยอะที่สุด ภาพคมชัดระดับ HD ระบบเสถียรไม่มีสะดุด • คัดเฉพาะค่ายเกมสดชื่อดังระดับโลกมาไว้ในล็อบบี้เดียว ถ่ายทอดสดตรงจากคาสิโนจริง มีดีลเลอร์มืออาชีพประจำโต๊ะตลอด 24 ชั่วโมง • บาคาร่าและรูเล็ตพร้อมเปิดโต๊ะ หน้าต่างเลือกห้องจัดมาเป็นระเบียบ แสดงสถิติย้อนหลังของแต่ละโต๊ะอย่างชัดเจน • สลับโต๊ะได้ลื่นไหลในคลิกเดียว ไม่ต้องโยกเงินหรือออกจากระบบ ไม่มีคำว่าโต๊ะเต็มมาขัดจังหวะ • ฝากถอน 5 วิ ด้วยระบบออโต้ไฮสปีด ไม่ต้องส่งสลิปยืนยัน ปลอดภัยสูงสุดทุกธุรกรรม • ครบทั้งบาคาร่า รูเล็ต เสือมังกร และไฮโล พร้อมทีมงานดูแลทุกเวลาตั้งแต่เลือกโต๊ะจนถึงเรื่องการใช้งาน";

// FAQ ห้าข้อเขียนจากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้าไหนมา
// ทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบคำถาม
// ที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน
const faqs = [
  {
    q: "MAHAHENG333 มีเกมสดอะไรให้เลือกเล่นบ้าง",
    a: "ฟลอร์คาสิโนของที่นี่เปิดครบทั้งบาคาร่า รูเล็ต เสือมังกร และไฮโล โดยคัดเฉพาะค่ายเกมสดชื่อดังระดับโลกมารวมไว้ในล็อบบี้เดียว ทุกโต๊ะถ่ายทอดสดตรงจากคาสิโนจริงด้วยภาพคมชัดระดับ HD จึงเลือกได้ทั้งโต๊ะสปีดเกมไวและโต๊ะบรรยากาศสบายๆ ตามสไตล์การเล่นของตัวเอง",
  },
  {
    q: "เลือกห้องเล่นใน MAHAHENG333 ยากไหม ดูสถิติย้อนหลังได้หรือเปล่า",
    a: "หน้าต่างการเลือกห้องออกแบบมาให้เป็นระเบียบ แสดงสถิติย้อนหลังและรายละเอียดของแต่ละโต๊ะไว้อย่างชัดเจน จึงวิเคราะห์เค้าไพ่และวางแผนการเดิมพันได้อย่างแม่นยำก่อนลงเงินจริง ไม่ต้องไล่เปิดทีละโต๊ะเพื่อหาว่าโต๊ะไหนกำลังออกทางไหนอยู่",
  },
  {
    q: "อยากเปลี่ยนโต๊ะกลางคัน ต้องโยกเงินหรือออกจากระบบไหม",
    a: "ไม่ต้องทั้งสองอย่าง หากรู้สึกว่าโต๊ะเดิมดวงไม่มา หรืออยากลองเกมสดรูปแบบอื่น ก็กดเปลี่ยนห้องได้ทันทีในคลิกเดียว ระบบสลับโต๊ะให้ลื่นไหลและรวดเร็ว ความต่อเนื่องตรงนี้ช่วยรักษาจังหวะการทำกำไรเอาไว้ และไม่มีคำว่าโต๊ะเต็มมาขัดจังหวะ",
  },
  {
    q: "ฝากถอนกับ MAHAHENG333 ใช้เวลานานแค่ไหน ต้องส่งสลิปไหม",
    a: "ระบบการเงินเป็นออโต้ไฮสปีดที่จัดการยอดเงินเสร็จภายใน 5 วินาที ทั้งขั้นตอนฝากเพื่อเติมทุนและถอนกำไรเข้าบัญชี ไม่มีขั้นตอนซับซ้อนและไม่ต้องส่งสลิปยืนยันให้แอดมิน ทุกธุรกรรมดำเนินการอย่างรวดเร็ว แม่นยำ และปลอดภัยสูงสุด",
  },
  {
    q: "ถ้ามีข้อสงสัยเรื่องเกมหรือการใช้งาน ติดต่อทีมงานได้ตอนไหน",
    a: "มีทีมงานมืออาชีพคอยดูแลและให้คำแนะนำตลอด 24 ชั่วโมง ไม่ว่าจะเป็นเรื่องการเลือกห้องเล่น ข้อสงสัยเกี่ยวกับตัวเกม หรือปัญหาการใช้งานต่างๆ ก็ซัพพอร์ตให้อย่างรวดเร็วและเป็นกันเอง เช่นเดียวกับดีลเลอร์มืออาชีพที่ประจำโต๊ะให้บริการตลอดทั้งวัน",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxCyberCut as="h1" title="MAHAHENG333 คาสิโนฟลอร์ใหญ่ เปิดโต๊ะมหาเฮง เกมสดหลายโต๊ะ">
    <p class="text-left text-base leading-relaxed">
      ถ้าคุณเป็นสายลุ้นไพ่ที่ชอบบรรยากาศความตื่นเต้นแบบเรียลไทม์ ต้องไม่พลาดที่จะเข้ามาสัมผัสความยิ่งใหญ่ของ MAHAHENG333 อาณาจักรคาสิโนสดที่ยกความหรูหราตระการตามาเสิร์ฟให้ถึงหน้าจอ
      ที่นี่รวมเอาโต๊ะเดิมพันสดคุณภาพสูงไว้เยอะที่สุด มีห้องให้เลือกเล่นหลากหลายสไตล์ พร้อมเปิดโอกาสให้ผู้เล่นได้เข้ามารับความเฮงกันแบบจัดเต็ม ด้วยระบบการทำงานที่เสถียร ภาพคมชัดระดับ HD
      และการบริการที่ได้มาตรฐานระดับสากล ปั่นเงินทำกำไรได้เพลินๆ ทุกวันไม่มีสะดุด
    </p>
  </ContentBoxCyberCut>

  <ContentBoxSevenThreeNeumorphism as="h2" title="MAHAHENG333 เปิดฟลอร์คาสิโนมหาเฮง ยกเกมสดหลายโต๊ะมาให้เลือกครบ">
    <Picture
      slot="left"
      src={imgLuckyWheel}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 767px) 92vw, 382px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น MAHAHENG333 พื้นสีดำประกายทอง มุมบนซ้ายเป็นโลโก้ MAHAHENG333 ตัวอักษรทองขนาบด้วยมังกรทองคู่และกระถางเงินสีแดง ตรงกลางเป็นผู้หญิงชุดแดงยืนคู่ไพ่โพดำกับไพ่ดอกจิก และโทรศัพท์ที่เปิดหน้ากงล้อเสี่ยงโชคแบ่งช่องรางวัลตั้งแต่ 5 ถึง 200 บาท พร้อมปุ่มเริ่มหมุน ด้านขวาเป็นสร้อยคอทองคำบนหุ่นกำมะหยี่สีแดงและกองทองแท่ง คู่ข้อความ ลุ้นรับรางวัลใหญ่ ทองคำหนัก 1 บาท ตัวหนังสือใหญ่ด้านล่างเขียนว่า โปรโมชั่น กงล้อรับโชค แถบล่างสุดเขียนว่า เว็บตรง ฝาก-ถอนรวดเร็ว ตลอด 24 ชม. คู่ไลน์ไอดี @iheng333"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e8b923]/40 shadow-[0_10px_30px_rgba(232,185,35,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      เปิดมิติใหม่ของการเดิมพันกับ MAHAHENG333 ที่ขนเอาฟลอร์คาสิโนชั้นนำมาไว้ในมือถือของคุณ ที่นี่คัดสรรเฉพาะค่ายเกมสดชื่อดังระดับโลกมารวบรวมไว้ในล็อบบี้เดียว
      ทุกโต๊ะเดิมพันถูกถ่ายทอดสดตรงจากคาสิโนจริง ให้ความรู้สึกเหมือนคุณกำลังนั่งอยู่ติดขอบโต๊ะเดิมพัน มีดีลเลอร์มืออาชีพคอยให้บริการตลอด 24 ชั่วโมง เลือกโต๊ะเล่นได้ตามใจชอบ
      ไม่ต้องแย่งที่นั่งกับใคร และไม่มีคำว่าโต๊ะเต็มมาขัดจังหวะความมันส์แน่นอน
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ProviderGrid />

  <ContentBox3ThreeCyberCut
    as="h2"
    title="บาคาร่าและรูเล็ตพร้อมเปิดโต๊ะ เลือกห้องง่ายใน MAHAHENG333 ตามสไตล์ที่ชอบ"
    titleleft="เปิดโต๊ะให้เลือกอิสระ"
    titlecenter="สถิติย้อนหลังทุกโต๊ะ"
    titleright="ปรับตามสไตล์การเล่น">
    <p slot="left" class="text-left text-base leading-relaxed">
      ไม่ว่าคุณจะเป็นสายอ่านเค้าไพ่บาคาร่า หรือชอบลุ้นวงล้อเสี่ยงโชคอย่างรูเล็ต ที่ MAHAHENG333 ก็มีพร้อมเปิดโต๊ะให้คุณเข้ามาเลือกห้องเล่นได้อย่างอิสระ
    </p>
    <p slot="center" class="text-left text-base leading-relaxed">
      ตัวระบบออกแบบหน้าต่างการเลือกห้องมาให้อย่างเป็นระเบียบ มีการแสดงสถิติย้อนหลังและรายละเอียดของแต่ละโต๊ะอย่างชัดเจน ช่วยให้คุณวิเคราะห์และวางแผนการเดิมพันได้อย่างแม่นยำ
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      อยากได้โต๊ะสปีดเกมไว หรือชอบโต๊ะบรรยากาศสบายๆ ก็เลือกปรับให้เข้ากับสไตล์การเล่นของตัวเองได้ทันที
    </p>
  </ContentBox3ThreeCyberCut>

  <GameRankingBoard />

  <ContentBoxTwoNeumorphism
    as="h2"
    title="อยากเปลี่ยนฟีลก็สลับโต๊ะคล่อง เกมสดพร้อมให้ไปต่อแบบไม่จำเจ"
    titleleft="กดเปลี่ยนห้องได้ในคลิกเดียว"
    titleright="รักษาจังหวะการทำกำไร">
    <p slot="left" class="text-left text-base leading-relaxed">
