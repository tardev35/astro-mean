---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBox3ThreeFloatingBadge from "../components/ContentBox3ThreeFloatingBadge.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBox from "../components/ContentBox.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgCashback8 from "../assets/slide2.png";
import imgDeposit200 from "../assets/slide1.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxFloatingBadge as="h1"
//   2 → ContentBoxFloatingBadge as="h2" + GameRankingBoard + ProviderGrid ต่อท้าย
//   3 → ContentBox3ThreeFloatingBadge as="h2" (แบ่งย่อหน้าเดียวลง left/center/right)
//   4 → ContentBoxSevenThree as="h2" + slide2 (คืนยอดเสีย 8% / ค่าคอมมิชชั่น 5%)
//   5 → ContentBox as="h2" (การ์ดกลางที่ terms/privacy ใช้ร่วม)
//   6 → ContentBoxSevenThree as="h2" + slide1 (ฝากเพียง 200 บาท รับสิทธิ์สุดคุ้ม)
//   7 → ContentBoxSpecial as="h2" (แบ่งย่อหน้าเดียวลง left/right)
//
// variant รอบนี้หมุนทั้งตระกูลจากแบรนด์ก่อนหน้า (AM88K ใช้ Premium ×3 + plain ×2 +
// FloatingBadge ×1 + Special ×1) มาเป็น FloatingBadge ×3 + SevenThree ธรรมดา ×2 +
// plain ×1 + Special ×1 ส่วน Navbar ย้ายจาก NavbarPremium มาเป็น NavbarStyle9,
// Footer จาก FooterPremium มาเป็น FooterStyle3, Announcement จาก Announcement3
// มาเป็น Announcement5, LatestWinners จาก LatestWinnersPremium มาเป็น
// LatestWinners3, Faq จาก Faq3 มาเป็น Faq4 และโครงสองคอลัมน์ที่ LoginRtpSection
// ใช้ย้ายจาก ContentBoxTwo มาเป็น ContentBoxTwoPremium
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook — slide2 (คืนยอดเสีย 8% ทุกวัน /
// ค่าคอมมิชชั่น 5% ทุกวัน) คู่กับหัวข้อ "ระบบตรงไว้ใจได้ ทุกขั้นตอนชัดเจน" และ
// slide1 (ฝากเพียง 200 บาท รับสิทธิ์สุดคุ้ม) คู่กับหัวข้อ "เรื่องการเงินต้องไม่
// ซับซ้อน" ส่วน slide3 (รายได้แนะนำเพื่อน รับสูงสุด 2.5%) ไม่ถูก import ในไฟล์นี้
// แต่ยังขึ้นใน SmoothCarousel และหน้า /promotion ส่วน slide4 เป็นอาร์ตพื้นชมพูของ
// แบรนด์ก่อนหน้า และ banner.png กับ banner2/3/4 เป็นอาร์ตค้างของแบรนด์ก่อนๆ ทั้งชุด
// จึงห้าม import ที่ไหนทั้งสิ้น — รูปที่ import คือรูปที่ถูก emit ถึงจะไม่มีใคร
// render ก็ตาม
//
// banner1 เป็น hero ที่ MainLayout จัดการเอง รอบนี้จึงไม่มีรูปประกอบใน ContentBox
// เดี่ยว
//
// widget ที่ไม่ได้มาจาก docx (LatestWinners3, LoginRtpSection, ReviewCardSumo2,
// SmoothCarousel, แถวปุ่ม login/register, FAQ) ใช้ป้ายเป็น <p>/<span> +
// aria-label บน <section> และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้ายทั้งชุด ยกเว้น
// GameRankingBoard กับ ProviderGrid ที่เป็นภาพประกอบของหัวข้อ docx ข้อ 2 โดยตรง
// (โต๊ะเกมสดและค่ายเกมที่คัดมา) จึงวางต่อท้ายบล็อกนั้น ไม่มีตัวไหนคั่นระหว่าง
// หัวข้อ docx สองข้อ
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx พอดี ไม่มีตัวที่เจ็ด — หัว FAQ ถูกลดเป็น <p>
// ใน Faq4.astro (ชื่อ section ย้ายไป aria-label) คำถามใน Faq4 เป็น <span> ใน
// <summary> ไม่ใช่ h3 และป้ายคอลัมน์ของ ContentBox3ThreeFloatingBadge /
// ContentBoxSevenThree / ContentBoxTwoPremium เป็น <p> — docx รอบนี้แบน H1 + H2
// ล้วน หน้านี้จึงไม่มี h3 เลย
const pageTitle = "LUCKYBKK | คาสิโนอันดับต้น เกมสดคุณภาพ VIP ระบบตรงไว้ใจได้";
// บรรทัด Des ของ docx ยาว 139 ตัวอักษร ต่ำกว่าเกท 150–160 ของ verify-build จึงต่อ
// ท้ายวรรคสุดท้ายให้เป็น "พร้อมทีมแอดมินมืออาชีพคอยดูแลตลอดวัน" ตามเนื้อหัวข้อ
// ข้อ 7 ของ docx เอง ได้ 154 ตัวอักษร ทุกวรรคอื่นคงคำเดิมของ docx ไว้ทั้งหมด และ
// เป็นสตริงเดียวกับที่ส่งเข้า pageGraph
const pageDescription =
  "LUCKYBKK คาสิโนอันดับต้น รวมเกมสดคุณภาพ VIP แบบเรียลไทม์ ระบบตรงไว้ใจได้ ชัดเจนทุกขั้นตอน หลังบ้านเสถียร การเงินคล่อง พร้อมทีมแอดมินมืออาชีพคอยดูแลตลอดวัน";

// default message ของ Announcement ทุก variant คือสโลแกนของแบรนด์เก่าคนละเจ้ากัน
// จึงส่ง message ตรงๆ เสมอ ไม่พึ่ง default และห้ามขึ้นต้นด้วย emoji เพราะ marquee
// render ข้อความซ้ำและ emoji ที่ฝังในสตริงถูก mark aria-hidden ไม่ได้
const announcementMessage =
  "LUCKYBKK คาสิโนอันดับต้น เกมสดคุณภาพ VIP ระบบตรงไว้ใจได้ • ศูนย์รวมความบันเทิงระดับพรีเมียมที่ยกระดับมาตรฐานคาสิโนออนไลน์ ด้วยเกมสดส่งตรงจากสตูดิโอชั้นนำ ระบบตรงไม่ผ่านคนกลาง เสถียร ปลอดภัย และโปร่งใสในทุกมิติ • ยิงตรงสัญญาณสดความละเอียดสูง คมชัดระดับ HD ทั้งภาพและเสียง ครบทั้งบาคาร่า รูเล็ต เสือมังกร และไฮโล ดำเนินเกมโดยดีลเลอร์มืออาชีพตลอด 24 ชั่วโมง • คัดสรรโต๊ะเดิมพันและค่ายเกมชั้นนำมารวบรวมไว้ในที่เดียว มีห้องให้เลือกหลากหลายระดับ ตั้งแต่เบทเริ่มต้นสบายๆ ไปจนถึงห้องระดับ High Roller สำหรับสายลุยหนัก • หน้าต่างการใช้งานแสดงข้อมูลและสถิติย้อนหลังได้ชัดเจน ช่วยให้วางแผนเดิมพันได้ง่ายและแม่นยำยิ่งขึ้น • ระบบตรงไม่ผ่านเอเย่นต์ ทุกขั้นตอนโปร่งใสตรวจสอบได้จริง อัตราการจ่ายได้มาตรฐานสากล ผลการเดิมพันยุติธรรมตรงไปตรงมา ไร้การหมกเม็ด ไร้เงื่อนไขซับซ้อน • หลังบ้านเสถียร รองรับผู้เข้าใช้งานพร้อมกันจำนวนมากโดยไม่หน่วงหรือกระตุก สลับเปลี่ยนโต๊ะเดิมพันได้ฉับไว • ฝากถอนผ่านระบบออโต้ด้วยตัวเองในไม่กี่ขั้นตอน ยอดเงินอัปเดตไว โอนเข้าบัญชีโดยตรง พร้อมหน้าต่างเช็กประวัติย้อนหลังที่เปิดดูได้ชัดเจน • ทีมงานแอดมินมืออาชีพคอยดูแลและซัพพอร์ตสมาชิกทุกคนตลอด 24 ชั่วโมง สุภาพ รวดเร็ว และเป็นกันเอง";

// FAQ ห้าข้อเขียนจากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้าไหนมา
// ทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบคำถาม
// ที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน
const faqs = [
  {
    q: "เกมสดของ LUCKYBKK มีเกมอะไรบ้าง และถ่ายทอดมาจากไหน",
    a: "เกมสดถูกส่งตรงจากสตูดิโอชั้นนำ ยิงตรงสัญญาณสดด้วยความละเอียดสูง คมชัดระดับ HD ทั้งภาพและเสียง ครบทั้งบาคาร่า รูเล็ต เสือมังกร และไฮโล ทุกเกมดำเนินการโดยดีลเลอร์มืออาชีพ ให้สัมผัสที่สมจริงเหมือนได้เข้าไปนั่งอยู่ในคาสิโนชั้นนำจริงๆ ตลอด 24 ชั่วโมง",
  },
  {
    q: "มีห้องเดิมพันให้เลือกกี่ระดับ มือใหม่กับสายเบทหนักเล่นห้องเดียวกันไหม",
    a: "มีห้องเดิมพันให้เลือกหลากหลายระดับ ตั้งแต่เบทเริ่มต้นสบายๆ สำหรับคนที่เพิ่งเริ่ม ไปจนถึงห้องระดับ High Roller สำหรับสายลุยหนัก โต๊ะเดิมพันและค่ายเกมชั้นนำถูกคัดสรรมารวบรวมไว้ในที่เดียว เลือกระดับเดิมพันให้พอดีกับทุนของตัวเองได้จากหน้าเดียว",
  },
  {
    q: "ระบบตรงไม่ผ่านเอเย่นต์ ต่างจากเว็บทั่วไปตรงไหน",
    a: "การให้บริการผ่านระบบตรงที่ไม่ผ่านเอเย่นต์ทำให้ทุกขั้นตอนของการใช้งานโปร่งใสและตรวจสอบได้จริง ทั้งอัตราการจ่ายที่ได้มาตรฐานสากล ผลการเดิมพันที่ยุติธรรมตรงไปตรงมา ไปจนถึงขั้นตอนการทำรายการทางการเงิน ไร้การหมกเม็ดและไร้เงื่อนไขซับซ้อนให้ต้องตีความ",
  },
  {
    q: "ช่วงที่คนเข้าเล่นพร้อมกันเยอะ ระบบจะหน่วงหรือหลุดไหม",
    a: "ทีมพัฒนาได้ปรับแต่งโครงสร้างหลังบ้านให้รองรับจำนวนผู้เข้าใช้งานพร้อมกันได้จำนวนมากโดยไม่มีอาการหน่วงหรือกระตุก สลับเปลี่ยนโต๊ะเดิมพันได้ฉับไว เข้าถึงทุกโหมดบริการได้ทันใจ ความต่อเนื่องของระบบตรงนี้เองที่ช่วยให้ผู้เล่นไม่พลาดจังหวะสำคัญตลอดวัน",
  },
  {
    q: "ฝากถอนต้องแจ้งแอดมินไหม และย้อนดูรายการเก่าได้หรือเปล่า",
    a: "ทำรายการฝากและถอนเงินผ่านระบบออโต้ได้ด้วยตัวเองง่ายๆ ภายในไม่กี่ขั้นตอน ยอดเงินอัปเดตไว โอนเข้าบัญชีโดยตรงอย่างแม่นยำ พร้อมหน้าต่างเช็กประวัติย้อนหลังที่เปิดดูได้ชัดเจน และยังมีทีมงานแอดมินคอยซัพพอร์ตตลอด 24 ชั่วโมงหากติดขัดระหว่างทำรายการ",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxFloatingBadge as="h1" title="LUCKYBKK คาสิโนอันดับต้น เกมสดคุณภาพ VIP ระบบตรงไว้ใจได้">
    <p class="text-left text-base leading-relaxed">
      หากคุณกำลังมองหาประสบการณ์เดิมพันสดที่ยกระดับความหรูหราและความน่าเชื่อถือขึ้นไปอีกขั้น LUCKYBKK คือจุดหมายปลายทางที่ไม่ควรมองข้าม
      ที่นี่คือศูนย์รวมความบันเทิงระดับพรีเมียมที่ยกระดับมาตรฐานคาสิโนออนไลน์ ด้วยการนำเสนอเกมสดส่งตรงจากสตูดิโอชั้นนำ โดดเด่นด้วยระบบตรงที่ไม่ผ่านคนกลาง มีความเสถียร ปลอดภัย และโปร่งใสในทุกมิติ
      ช่วยให้คุณเข้าถึงความสนุกได้อย่างมั่นใจ ลื่นไหล ไม่มีสะดุด พร้อมสัมผัสการดูแลและการบริการที่เหนือระดับในสไตล์ VIP อย่างแท้จริง
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxFloatingBadge as="h2" title="LUCKYBKK คาสิโนอันดับต้น เปิดประสบการณ์เกมสดคุณภาพ VIP แบบเรียลไทม์">
    <p class="text-left text-base leading-relaxed">
      สัมผัสบรรยากาศคาสิโนระดับโลกได้จากทุกที่ทุกเวลาเมื่อเข้ามาที่ LUCKYBKK ที่พร้อมเสิร์ฟความตื่นเต้นแบบเรียลไทม์ ยิงตรงสัญญาณสดด้วยความละเอียดสูง คมชัดระดับ HD ทั้งภาพและเสียง
      ไม่ว่าจะเป็นบาคาร่า รูเล็ต เสือมังกร หรือไฮโล ทุกเกมดำเนินการโดยดีลเลอร์มืออาชีพ เพิ่มความหรูหราน่าเล่นให้ทุกโต๊ะเดิมพัน มอบสัมผัสที่สมจริงเหมือนคุณได้เข้าไปนั่งอยู่ในคาสิโนชั้นนำจริงๆ
      ตลอด 24 ชั่วโมง
    </p>
  </ContentBoxFloatingBadge>

  <GameRankingBoard />

  <ProviderGrid />

  <ContentBox3ThreeFloatingBadge
    as="h2"
    title="เกมสดจะพรีเมียมแค่ไหน เมื่อ LUCKYBKK คัดทั้งโต๊ะและประสบการณ์มาให้ครบ"
    titleleft="ห้องเบทเริ่มต้นสบายๆ"
    titlecenter="ห้องระดับ High Roller"
    titleright="หน้าต่างสถิติย้อนหลัง">
    <p slot="left" class="text-left text-base leading-relaxed">
      คำว่าพรีเมียมที่ LUCKYBKK ไม่ใช่แค่เรื่องงานภาพ แต่คือความพิถีพิถันในการคัดสรรโต๊ะเดิมพันและค่ายเกมชั้นนำมารวบรวมไว้ในที่เดียว มีห้องเดิมพันให้เลือกหลากหลายระดับ ตั้งแต่เบทเริ่มต้นสบายๆ
    </p>
    <p slot="center" class="text-left text-base leading-relaxed">ไปจนถึงห้องระดับ High Roller สำหรับสายลุยหนัก</p>
    <p slot="right" class="text-left text-base leading-relaxed">
