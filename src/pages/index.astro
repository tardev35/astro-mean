---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBox3ThreeCyberCut from "../components/ContentBox3ThreeCyberCut.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgLiveTables from "../assets/slide1.png";
import imgAutoBanking from "../assets/slide4.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxNeumorphism as="h1"
//   2 → ContentBoxTwoCyberCut (ส่ง title อย่างเดียว แล้วแบ่งย่อหน้าเดียวลง
//       left/right ที่รอยต่อประโยค — titleleft/titleright เป็น <p> ของ chrome)
//   3 → ContentBoxSevenThree + slide1 (โต๊ะสด ภาพระดับ HD หลายห้องให้เลือก)
//   4 → ContentBoxSevenThreeNeumorphism + slide4 (ฝากไวถอนคล่อง ระบบออโต้)
//   5 → ContentBox3ThreeCyberCut (ส่ง title อย่างเดียว แบ่งย่อหน้าลง
//       left/center/right)
//   6 → ContentBoxCyberCut as="h2"
//   7 → ContentBoxFloatingBadge as="h2"
//
// SevenThree ใช้ 2 บล็อกเท่านั้น (โควตาเต็ม) และแต่ละตัวส่ง `title` เดียว
// ถ้าส่ง titleleft/titleright ด้วยจะได้หัวข้อเกินจำนวนหัวข้อ docx
//
// docx ของแบรนด์นี้แบนราบ (H1 + H2 ล้วน ไม่มี H3) — variant ที่สลับเข้ามารอบนี้
// เคย render หัวคอลัมน์เป็น <h2> คนละตัว (SevenThree, SevenThreeNeumorphism,
// 3ThreeCyberCut) จึงถูกลดเป็น <p> แล้วเพิ่ม prop `title` ตัวเดียวไว้รับหัวข้อ
// docx แทน ส่วน ContentBoxTwoCyberCut เดิม render `title` เป็น <p> เพราะเคยถูกใช้
// เป็น widget รอบนี้มันแบกหัวข้อ docx จริงจึงเป็นหัวข้อได้ — วิธีเดียวกับที่
// ContentBoxTwo/ContentBox3Three ทำไว้แล้ว
//
// slide2/slide3 อยู่ใน SmoothCarousel อย่างเดียว, slide1/slide4 อยู่ใน SevenThree
// อย่างละบล็อก — รูปหนึ่งใบมีบ้านเดียว ไม่ซ้ำกันในหน้าเดียว
//
// การอัพโหลดรอบ 2026-08-11 สลับตัวไฟล์ slide1 กับ slide2 จากรอบก่อน: อาร์ต
// "คาสิโนชั้นนำ ครบจบทุกค่าย" ย้ายมาอยู่ที่ slide1.png และ "แนะนำเพื่อน 0.7%"
// ย้ายไป slide2.png — import ตรงนี้จึงชี้ตามอาร์ต ไม่ใช่ตามเลขไฟล์เดิม
// (alt ของแต่ละใบบรรยายตัวหนังสือบนรูปจริง จึงไม่ต้องแก้ตาม)
// banner2/3/4 กับ banner.png เป็นอาร์ตของแบรนด์ก่อนหน้า จึงไม่ถูก import ที่ไหน
//
// widget ที่ไม่ได้มาจาก docx (SmoothCarousel, ProviderGrid, GameRankingBoard,
// LatestWinners, LoginRtpSection, ReviewCardSumo2, แถวปุ่ม login/register) ใช้
// หัวข้อเป็น <p>/<span> + aria-label บน <section> จึงวางต่อท้ายหัวข้อ docx ที่มัน
// สังกัดได้โดยลำดับ h2 ไม่เพี้ยน
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx + หัวข้อ FAQ ที่หน้านี้เขียนเอง = 7
// คำถามใน Faq2 เป็น <span> ตามระดับที่ variant นั้น ship มา ไม่ใช่ <h3>

const pageTitle = "LONGSAP168 | เว็บสล็อตครบมือ เกมดังค่ายจัดเต็ม โต๊ะสดจัดหนัก";

// Meta description ยาว 157 ตัวอักษร — verify-build บังคับช่วง 150–160 ตัวอักษร
// ตัว Des ใน docx เองยาว 128 ตัวอักษร จึงต่อท้ายด้วยรายละเอียดที่มาจาก brief
// ("ภาพคมชัดระดับ HD", "ด้วยระบบออโต้") ให้เข้าช่วง โดยไม่เพิ่มข้อความที่ brief
// ไม่ได้พูดถึง
const pageDescription = "LONGSAP168 เว็บสล็อตครบมืออันดับ 1 เกมดังค่ายจัดเต็ม โต๊ะสดจัดหนักภาพคมชัดระดับ HD ฝากไวถอนคล่องด้วยระบบออโต้ เล่นลื่นทุกอุปกรณ์ พร้อมความปลอดภัยแบบไม่ลดสเปค";

// default message ของ Announcement ทุก variant คือสโลแกนของแบรนด์เก่าคนละเจ้ากัน
// จึงส่ง message ตรงๆ เสมอ ไม่พึ่ง default
const announcementMessage =
  "LONGSAP168 เว็บสล็อตครบมือ เล่นแล้วจบในที่เดียว ไม่ต้องโยกเงิน ไม่ต้องเปลี่ยนเว็บ • รวมค่ายดังระดับโลกมาไว้เพียบ เปิดหน้าเว็บเข้ามาปุ๊บเจอเกมฮิตที่คุ้นเคยรออยู่ แถมอัปเดตเกมใหม่ๆ ไวมาก ภาพสวย สปินลื่น แตกบ่อย • โต๊ะสดจัดหนัก ภาพคมชัดระดับ HD สตรีมเรียลไทม์ไม่มีกระตุก มีห้องให้เลือกเข้าเพียบตามจังหวะที่ชอบ • ฝากถอนออโต้ไม่ต้องแคปสลิปส่งแอดมิน เล่นได้ปุ๊บกดถอนปั๊บ เงินเด้งเข้าบัญชีแทบจะทันที • รองรับทุกแพลตฟอร์ม สลับจากมือถือไปคอมก็ยังลื่นไม่เสียฟีล • ความปลอดภัยระดับมาตรฐานสากล ดูแลข้อมูลส่วนตัวและบัญชีอย่างเป็นระบบ";

const faqs = [
  {
    q: "LONGSAP168 มีเกมอะไรให้เล่นบ้าง ต้องย้ายเว็บไหมถ้าอยากลุยหลายแนว",
    a: "ไม่ต้องย้ายเลยครับ ที่นี่เป็นเว็บสล็อตครบมือที่จัดมาให้แบบจุกๆ สายปั่นสล็อตที่ชอบเกมดังแตกง่ายจากค่ายใหญ่ก็มี สายลุ้นไพ่ที่ชอบโต๊ะสดแบบเรียลไทม์ก็มี รวบรวมค่ายดังระดับโลกไว้เพียบและอัปเดตเกมใหม่ๆ ไวมาก เข้ามาที่เดียวคือพร้อมลุยได้ยาวๆ ไม่ต้องโยกเงินไปมาให้วุ่นวาย",
  },
  {
    q: "โต๊ะสดของ LONGSAP168 ภาพเป็นยังไง มีให้เลือกกี่ห้อง",
    a: "โต๊ะสดของที่นี่จัดหนักจัดเต็มมาก ภาพคมชัดระดับ HD สตรีมมาแบบเรียลไทม์ไม่มีกระตุกให้เสียอารมณ์ แถมมีห้องให้เลือกเข้าเพียบ ชอบดีลเลอร์คนไหน ชอบจังหวะการเดินเกมโต๊ะไหน ก็เลือกเข้าได้ตามสไตล์เลย บรรยากาศเหมือนบินไปนั่งเล่นที่คาสิโนของจริง",
  },
  {
    q: "ฝากถอนต้องแคปสลิปส่งแอดมินไหม รอเงินเข้านานแค่ไหน",
    a: "ไม่ต้องแคปสลิปส่งหาแอดมินให้เมื่อยมือครับ ฝากถอนเป็นระบบออโต้ที่ไวแบบตอบโจทย์วัยรุ่นใจร้อน เล่นได้ปุ๊บ กดถอนปั๊บ เงินเด้งเข้าบัญชีแทบจะทันที ไม่ต้องมารอข้ามชั่วโมงให้หงุดหงิด จังหวะกำลังดวงขึ้นก็ฝากเข้าไปลุยต่อได้แบบสมูทๆ ไม่มีสะดุด",
  },
  {
    q: "เล่นผ่านมือถือกับคอมพิวเตอร์ต่างกันไหม สลับอุปกรณ์แล้วฟีลขาดหรือเปล่า",
    a: "เว็บนี้รองรับการเล่นผ่านทุกแพลตฟอร์ม จะนอนไถจอเล่นผ่านมือถือบนเตียง หรือจะนั่งเล่นจอใหญ่จัดเต็มผ่านคอมพิวเตอร์ ก็ลื่นไหลไม่มีบั๊ก ระบบหน้าเว็บออกแบบมาให้ใช้งานง่าย ปรับขนาด UI ตามหน้าจอเป๊ะๆ สลับอุปกรณ์เล่นตอนไหนฟีลก็ไม่ขาดตอน",
  },
  {
    q: "ข้อมูลส่วนตัวและข้อมูลบัญชีปลอดภัยแค่ไหน",
    a: "เรื่องความปลอดภัยที่นี่ยืนหนึ่ง เพราะอัดแน่นระบบรักษาความปลอดภัยระดับมาตรฐานสากล ข้อมูลส่วนตัวและข้อมูลบัญชีจะถูกเก็บรักษาไว้อย่างดี ไม่มีรั่วไหลแน่นอน เล่นได้อย่างสบายใจ 100% ปล่อยจอยโฟกัสกับเกมหน้าจอได้เต็มที่โดยไม่ต้องกังวลเรื่องระบบหลังบ้าน",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxNeumorphism as="h1" title="LONGSAP168 เว็บสล็อตครบมือ เกมดังค่ายจัดเต็ม โต๊ะสดจัดหนัก">
    <p class="text-left text-base leading-relaxed">
      ใครที่กำลังมองหาเว็บที่เล่นแล้วจบในที่เดียว ขอป้ายยา LONGSAP168 เลยครับ ตัวนี้เป็นเว็บสล็อตครบมือที่จัดมาให้แบบจุกๆ ไม่ว่าจะเป็นสายปั่นสล็อตที่ชอบเกมดังแตกง่ายจากค่ายใหญ่
      หรือสายลุ้นไพ่ที่ชอบโต๊ะสดแบบเรียลไทม์ ที่นี่คือตอบโจทย์หมด ไม่ต้องโยกเงิน ไม่ต้องเปลี่ยนเว็บให้วุ่นวาย เข้ามาที่เดียวคือพร้อมลุยได้ยาวๆ ได้ฟีลเหมือนเพื่อนบอกต่อของดีที่ต้องลอง
    </p>
  </ContentBoxNeumorphism>

  <SmoothCarousel />

  <ContentBoxTwoCyberCut as="h2" title="LONGSAP168 เว็บสล็อตครบมืออันดับ 1 เปิดทีเดียวเจอเกมดังแบบค่ายจัดเต็ม">
    <p slot="left" class="text-left text-base leading-relaxed">
      พูดถึงเรื่องเกมสล็อต บอกเลยว่าเขาไม่ได้มาเล่นๆ เพราะรวบรวมค่ายดังระดับโลกมาไว้เพียบ เปิดหน้าเว็บเข้ามาปุ๊บคือเจอเกมฮิตที่คุ้นเคยรออยู่เพียบ แถมอัปเดตเกมใหม่ๆ ไวมาก
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">ใครที่ชอบลองของใหม่หรือมีเกมลูกรักในดวงใจอยู่แล้ว มารวมกันตรงนี้ได้เลย ภาพสวย สปินลื่น แตกบ่อยจนต้องหยิบมารีวิวให้ฟัง</p>
  </ContentBoxTwoCyberCut>

  <ProviderGrid />

  <ContentBoxSevenThree as="h2" title="โต๊ะสดจัดหนัก ภาพเกมถึงอารมณ์ พร้อมหลายโต๊ะให้เลือกตามจังหวะที่ชอบ">
    <Picture
      slot="left"
      src={imgLiveTables}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์ LONGSAP168 คาสิโนชั้นนำ ครบจบทุกค่าย ในเว็บเดียว พร้อมภาพหญิงสาวผมชมพูชุดแดงถือชิปคาสิโน แถวโลโก้ค่ายเกมด้านล่าง และหน้าจอมือถือที่เปิดห้องโต๊ะสดเรียงกันหลายห้อง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#f2b024]/35 shadow-[0_10px_30px_rgba(242,176,36,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      ส่วนสายคาสิโนสดก็ไม่น้อยหน้า โต๊ะสดของที่นี่จัดหนักจัดเต็มมาก ภาพคมชัดระดับ HD สตรีมมาแบบเรียลไทม์ไม่มีกระตุกให้เสียอารมณ์ แถมมีห้องให้เลือกเข้าเพียบ ชอบดีลเลอร์คนไหน ชอบจังหวะการเดินเกมโต๊ะไหน
      ก็เลือกเข้าได้ตามสไตล์เลย บรรยากาศเหมือนบินไปนั่งเล่นที่คาสิโนของจริง ได้ฟีลลิ่งสุดๆ
    </p>
  </ContentBoxSevenThree>

  <GameRankingBoard />

  <ContentBoxSevenThreeNeumorphism as="h2" title="ฝากไวถอนคล่องกับ LONGSAP168 ระบบการเงินที่ไม่ปล่อยให้ความสนุกต้องรอนาน">
    <Picture
      slot="left"
      src={imgAutoBanking}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์ LONGSAP168 ฝาก-ถอน ระบบออโต้ ภายใน 2 วินาที ทำรายการเอง ไม่ต้องพึ่งแอดมิน พร้อมภาพหญิงสาวชุดสีทองบนพื้นแดงดำ เหรียญเงินลอยรอบตัว และแถวไอคอนธนาคารกับทรูมันนี่ วอลเล็ท"
      class="mx-auto h-auto w-full rounded-2xl border border-[#f2b024]/35 shadow-[0_10px_30px_rgba(216,31,38,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      เรื่องเงินๆ ทองๆ นี่สำคัญสุด ซึ่งระบบของที่นี่ทำออกมาได้ตอบโจทย์วัยรุ่นใจร้อนมาก ฝากถอนเป็นระบบออโต้ที่ไวแบบไม่ต้องแคปสลิปส่งหาแอดมินให้เมื่อยมือ เล่นได้ปุ๊บ กดถอนปั๊บ
      เงินเด้งเข้าบัญชีแทบจะทันที ไม่ต้องมารอข้ามชั่วโมงให้หงุดหงิด จังหวะกำลังดวงขึ้นก็ฝากเข้าไปลุยต่อได้แบบสมูทๆ ไม่มีสะดุด
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <LatestWinners />

  <ContentBox3ThreeCyberCut as="h2" title="สลับจากมือถือไปคอมก็ยังลื่น LONGSAP168 รองรับทุกอุปกรณ์แบบไม่เสียฟีล">
    <p slot="left" class="text-left text-base leading-relaxed">ยุคนี้ใครๆ ก็เน้นความสะดวกใช่มั้ยล่ะ เว็บนี้เขารองรับการเล่นผ่านทุกแพลตฟอร์ม</p>
    <p slot="center" class="text-left text-base leading-relaxed">ไม่ว่าจะนอนไถจอเล่นผ่านมือถือบนเตียง หรือจะนั่งเล่นจอใหญ่จัดเต็มผ่านคอมพิวเตอร์ ก็ลื่นไหลไม่มีบั๊ก</p>
    <p slot="right" class="text-left text-base leading-relaxed">ระบบหน้าเว็บออกแบบมาให้ใช้งานง่าย ปรับขนาด UI ตามหน้าจอเป๊ะๆ สลับอุปกรณ์เล่นตอนไหนฟีลก็ไม่ขาดตอน</p>
  </ContentBox3ThreeCyberCut>

  <LoginRtpSection />

  <ContentBoxCyberCut as="h2" title="ความปลอดภัยแบบไม่ลดสเปค ดูแลข้อมูลและทุกขั้นตอนการใช้งานอย่างเป็นระบบ">
    <p class="text-left text-base leading-relaxed">
