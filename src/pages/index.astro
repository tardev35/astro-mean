---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBox3ThreeFloatingBadge from "../components/ContentBox3ThreeFloatingBadge.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBox from "../components/ContentBox.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgNewMemberBonus from "../assets/slide2.png";
import imgDailyCashback from "../assets/slide3.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxPremium as="h1"
//   2 → ContentBoxSevenThreePremium as="h2" + slide2 (สมาชิกใหม่ ฝากครั้งแรก 49 รับ 100)
//   3 → ContentBox3ThreeFloatingBadge as="h2" (แบ่งย่อหน้าเดียวลง left/center/right ที่รอยต่อประโยค)
//   4 → ContentBoxTwoPremium as="h2" (แบ่งย่อหน้าเดียวลง left/right)
//   5 → ContentBoxSpecial as="h2" (หนึ่ง element ต่อหนึ่ง slot)
//   6 → ContentBoxSevenThreeFloatingBadge as="h2" + slide3 (ทุกวัน คืนยอดเสีย 5%)
//   7 → ContentBox as="h2" (การ์ดกลางที่ terms/privacy ใช้ร่วม)
//
// variant รอบนี้หมุนทั้งตระกูลจากแบรนด์ก่อนหน้า (รอบก่อนใช้ Neumorphism ×3 +
// CyberCut ×2 + plain ×2) มาเป็น Premium ×3 + FloatingBadge ×2 + Special ×1 +
// plain ×1 ส่วน Navbar ย้ายจาก NavbarPremium มาเป็น NavbarStyle6, Footer จาก
// FooterPremiumSumo มาเป็น FooterStyle2, Announcement จาก AnnouncementPremium
// มาเป็น Announcement5, LatestWinners จาก LatestWinners4 มาเป็น LatestWinners3,
// Faq จาก Faq3 มาเป็น Faq4 และ ProviderGrid จาก ProviderGridPremium มาเป็นตัวธรรมดา
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook — slide2 (สมาชิกใหม่ ฝากครั้งแรก
// 49 รับ 100) คู่กับหัวข้อที่พูดถึงความเอ็นจอยที่มากกว่าแค่เกมฮิต และ slide3
// (ทุกวัน คืนยอดเสีย 5%) คู่กับหัวข้อฟีเจอร์เด่นและกิจกรรมน่าติดตาม ส่วน slide1
// (หมุนวงล้อ) กับ slide4 (แนะนำเพื่อน) ไม่ถูก import ในไฟล์นี้ — ทั้งคู่ยังขึ้นใน
// SmoothCarousel และหน้า /promotion อยู่ เช่นเดียวกับ banner.png และ banner2/3/4
// ที่เป็นอาร์ตค้างของแบรนด์ก่อนๆ ซึ่งห้ามแตะ — รูปที่ import คือรูปที่ถูก emit
// ถึงจะไม่มีใคร render ก็ตาม
//
// banner1 เป็น hero ที่ MainLayout จัดการเอง รอบนี้จึงไม่มีรูปประกอบใน ContentBox
// เดี่ยว
//
// widget ที่ไม่ได้มาจาก docx (ProviderGrid, GameRankingBoard, LatestWinners,
// LoginRtpSection, ReviewCardSumo2, SmoothCarousel, แถวปุ่ม login/register, FAQ)
// ใช้ป้ายเป็น <p>/<span> + aria-label บน <section> และถูกวางต่อท้ายหัวข้อ docx
// ข้อสุดท้ายทั้งชุด จึงไม่มีตัวไหนคั่นระหว่างหัวข้อ docx สองข้อเลย
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx + หัวข้อ FAQ ที่หน้านี้ส่งเป็น prop = 7
// คำถามใน Faq4 เป็น <span> ใน <summary> ไม่ใช่ h3 และป้ายคอลัมน์ของ
// ContentBox3ThreeFloatingBadge / ContentBoxSevenThree* / ContentBoxTwoPremium
// เป็น <p> — docx รอบนี้แบน H1 + H2 ล้วน หน้านี้จึงไม่มี h3 เลย
const pageTitle = "DEKDDD | สล็อตสายเอ็นจอย เกมฮิตติดล็อบบี้ เล่นลื่นไม่มีสะดุด ลองเลย";
// คำอธิบายยาว 156 ตัวอักษร อยู่ในเกท 150–160 ของ verify-build พอดี ตั้งต้นจาก
// บรรทัด Meta ของ docx แล้วต่อท้ายให้ครบช่วง และเป็นสตริงเดียวกับที่ส่งเข้า pageGraph
const pageDescription = "DEKDDD สล็อตสายเอ็นจอย รวมเกมฮิตติดล็อบบี้พร้อมเกมใหม่สลับมาให้ลอง ระบบตอบสนองไว เล่นลื่นไม่มีสะดุดทุกอุปกรณ์ ฟีเจอร์และกิจกรรมน่าติดตาม เปิดให้ลองเลยวันนี้";

// default message ของ Announcement ทุก variant คือสโลแกนของแบรนด์เก่าคนละเจ้ากัน
// จึงส่ง message ตรงๆ เสมอ ไม่พึ่ง default และห้ามขึ้นต้นด้วย emoji เพราะ marquee
// render ข้อความซ้ำและ emoji ที่ฝังในสตริงถูก mark aria-hidden ไม่ได้
const announcementMessage =
  "DEKDDD สล็อตสายเอ็นจอย เกมฮิตติดล็อบบี้ เล่นลื่นไม่มีสะดุด • เว็บสล็อตยุคใหม่ที่รวบรวมเกมเด็ดเกมฮิตไว้เต็มล็อบบี้ เข้ามาเล่นเพื่อผ่อนคลายหรือล่าโบนัสแจ็คพอตก็พร้อมเสิร์ฟความบันเทิงแบบจัดเต็ม • ความเอ็นจอยไม่ได้จบแค่อัตราการแตกของเกมฮิต แต่คือดีไซน์หน้าเว็บที่สบายตา คลังเกมหลากสไตล์ และจังหวะแจกโบนัสที่มาสม่ำเสมอ • เปิดล็อบบี้เมื่อไหร่ก็เจอแต่ตัวเต็ง ทั้งเกมสล็อตยอดฮิตระดับตำนานและเกมมาใหม่ล่าสุดจากค่ายชั้นนำ สลับสับเปลี่ยนเข้ามาให้ลองตลอดเวลา • ระบบหลังบ้านตอบสนองไว สลับเกมหรือสลับค่ายได้สมูธไร้รอยต่อ ไม่ต้องนั่งรอโหลดหน้าเว็บนานให้เสียอารมณ์ • รองรับทุกแพลตฟอร์ม ทั้งสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ หน้าจอปรับให้เหมาะกับอุปกรณ์อัตโนมัติ ปุ่มกดใกล้มือ กราฟิกคมชัด • ฟีเจอร์เด่นครบทั้งตัวคูณรางวัลสุดพิเศษ โหมดฟรีสปินที่ออกบ่อย และกิจกรรมโปรโมชันที่จัดขึ้นเพื่อสมาชิกโดยเฉพาะ • เลือกเกมที่ตรงสไตล์แล้วเปิดโหมดความสนุกไปกับระบบที่ได้มาตรฐาน โอนไว และปลอดภัย 100%";

// FAQ ห้าข้อเขียนจากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้าไหนมา
// ทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบคำถาม
// ที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน
const faqs = [
  {
    q: "DEKDDD เหมาะกับคนที่อยากเล่นสล็อตแบบสายเอ็นจอยตรงไหน",
    a: "ที่นี่ออกแบบบรรยากาศการเล่นมาให้เป็นมิตรและผ่อนคลาย ตั้งแต่ดีไซน์หน้าเว็บที่สบายตา คลังเกมที่มีให้เลือกหลากหลายสไตล์ ไปจนถึงจังหวะการแจกโบนัสที่มาแบบสม่ำเสมอ จะเข้ามาปั่นเพื่อผ่อนคลายหรือล่าโบนัสแจ็คพอตก็เล่นได้ยาวๆ แบบไม่กดดัน และพร้อมต้อนรับสายสปินทุกระดับเข้ามาร่วมสนุกด้วยกัน",
  },
  {
    q: "ในล็อบบี้ของ DEKDDD มีเกมแบบไหนให้เลือกบ้าง",
    a: "เปิดล็อบบี้เข้ามาเมื่อไหร่ก็เจอแต่ตัวเต็ง เพราะคัดสรรเฉพาะเกมฮิตติดกระแสมาไว้ให้เลือกแบบแน่นๆ ทั้งเกมสล็อตยอดฮิตติดระดับตำนานและเกมมาใหม่ล่าสุดจากค่ายชั้นนำ ที่มีสลับสับเปลี่ยนเข้ามาให้ทดลองเล่นอยู่ตลอดเวลา อยากเปลี่ยนบรรยากาศหรือค้นหารูปแบบการเล่นใหม่ๆ ก็แค่คลิกเลือกเกมใหม่ได้ทันที",
  },
  {
    q: "เวลาสลับเกมหรือสลับค่ายต้องรอโหลดนานไหม",
    a: "ไม่ต้องรอนาน จุดเด่นที่ทำให้หลายคนติดใจคือความฉับไวของระบบหลังบ้านที่ตอบสนองได้อย่างทันใจ เวลาต้องการเปลี่ยนเกมหรือสลับค่ายเล่นก็ไม่ต้องนั่งรอโหลดหน้าเว็บนานๆ ให้เสียอารมณ์ ระบบสลับเข้าเกมใหม่ได้อย่างสมูธ รวดเร็ว ไร้รอยต่อ จังหวะกำลังได้ อารมณ์กำลังมา ก็ปั่นต่อได้ทันที",
  },
  {
    q: "เล่นผ่านมือถือกับคอมได้เหมือนกันหรือเปล่า",
    a: "ได้เหมือนกันทั้งหมด เพราะพัฒนามารองรับการใช้งานในทุกแพลตฟอร์ม ทั้งสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ ทุกระบบปฏิบัติการ หน้าจอจะถูกปรับให้เหมาะสมกับอุปกรณ์ที่ใช้อย่างอัตโนมัติ ปุ่มกดใกล้มือ กราฟิกแสดงผลได้อย่างคมชัดและไหลลื่น จึงพกพาความสนุกไปเล่นได้ทุกที่ทุกเวลาตามต้องการ",
  },
  {
    q: "มีฟีเจอร์หรือกิจกรรมอะไรที่ช่วยเพิ่มความน่าลุ้นบ้าง",
    a: "ภายในเกมมีฟีเจอร์เด่นทั้งตัวคูณรางวัลสุดพิเศษและโหมดฟรีสปินที่ออกบ่อย รวมถึงกิจกรรมและโปรโมชันน่าติดตามที่จัดขึ้นเพื่อสมาชิกโดยเฉพาะ สิ่งเหล่านี้ช่วยเติมเต็มจังหวะการหมุนให้น่าลุ้นยิ่งขึ้นและเพิ่มโอกาสรับกำไรก้อนใหญ่ ควรอ่านเงื่อนไขของแต่ละกิจกรรมจากหน้าโปรโมชั่นจริงก่อนกดรับทุกครั้ง",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxPremium as="h1" title="DEKDDD สล็อตสายเอ็นจอย เกมฮิตติดล็อบบี้ เล่นลื่นไม่มีสะดุด ลองเลย">
    <p class="text-left text-base leading-relaxed">
      ถ้าคุณกำลังมองหาพื้นที่ปั่นสล็อตสายเอ็นจอยที่เน้นความสนุก เล่นสบายๆ ไม่ต้องเครียด ต้องไม่พลาดที่จะมาลอง DEKDDD เว็บสล็อตยุคใหม่ที่รวบรวมเกมเด็ดเกมฮิตไว้เต็มล็อบบี้
      โดดเด่นด้วยระบบการทำงานที่ลื่นไหล สมูธ ไม่มีสะดุด ไม่ว่าจะเข้ามาเล่นเพื่อผ่อนคลายหรือล่าโบนัสแจ็คพอต ที่นี่ก็พร้อมเสิร์ฟความบันเทิงให้แบบจัดเต็ม ลองกดเข้ามาสัมผัสด้วยตัวเองสักครั้ง
      แล้วคุณจะรู้ว่าคำว่าเอ็นจอยของจริงเป็นอย่างไร
    </p>
  </ContentBoxPremium>

  <ContentBoxSevenThreePremium as="h2" title="DEKDDD สล็อตสายเอ็นจอย มีอะไรให้สนุกมากกว่าแค่เกมฮิต?" titleleft="สมาชิกใหม่ ฝากครั้งแรก 49 รับ 100">
    <Picture
      slot="left"
      src={imgNewMemberBonus}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 767px) 92vw, 340px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่นพื้นแดงทอง ตัวอักษรใหญ่เขียนว่า สมาชิกใหม่ ฝากครั้งแรก 49 รับ 100 ด้านหลังเป็นตัวการ์ตูนหญิงสาวผมมวยสองข้างถือแว่นขยาย มีมาสคอตยูนิคอร์นและเพนกวินอยู่ซ้ายขวา ล้อมด้วยช่อใบไม้ทอง มงกุฎ และกองเหรียญทอง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#eebb1a]/40 shadow-[0_10px_30px_rgba(238,187,26,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      ความเอ็นจอยที่ DEKDDD มอบให้ ไม่ได้จบอยู่แค่อัตราการแตกของเกมฮิตเท่านั้น แต่คือบรรยากาศการเล่นที่ถูกออกแบบมาให้เป็นมิตรและผ่อนคลายสุดๆ ตั้งแต่ดีไซน์หน้าเว็บที่สบายตา
      คลังเกมที่มีให้เลือกหลากหลายสไตล์ ไปจนถึงจังหวะการแจกโบนัสที่มาแบบสม่ำเสมอ ทำให้ทุกวินาทีที่คุณอยู่ในเว็บเต็มไปด้วยความรู้สึกเพลิดเพลิน เล่นได้ยาวๆ แบบไม่กดดัน
      และพร้อมต้อนรับสายสปินทุกระดับเข้ามาร่วมสนุกด้วยกัน
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBox3ThreeFloatingBadge as="h2" title="เกมฮิตติดล็อบบี้ พร้อมตัวใหม่สลับมาให้ลองแบบไม่จำเจ" titleleft="ล็อบบี้มีแต่ตัวเต็ง" titlecenter="ตำนานชนของมาใหม่" titleright="คลิกเดียวเปลี่ยนฟีล">
    <p slot="left" class="text-left text-base leading-relaxed">เปิดล็อบบี้เข้ามาเมื่อไหร่ก็เจอแต่ตัวเต็ง เพราะ DEKDDD คัดสรรเฉพาะเกมฮิตติดกระแสมาไว้ให้เลือกแบบแน่นๆ</p>
    <p slot="center" class="text-left text-base leading-relaxed">ไม่ว่าจะเป็นเกมสล็อตยอดฮิตติดระดับตำนาน หรือเกมมาใหม่ล่าสุดจากค่ายชั้นนำ ก็มีสลับสับเปลี่ยนเข้ามาให้ทดลองเล่นอยู่ตลอดเวลา</p>
    <p slot="right" class="text-left text-base leading-relaxed">
      ช่วยให้ผู้เล่นสามารถเปลี่ยนบรรยากาศและค้นหารูปแบบการเล่นใหม่ๆ ได้ตลอดทั้งวันไม่มีเบื่อ อยากเปลี่ยนฟีลเมื่อไหร่ก็แค่คลิกเลือกเกมใหม่ได้ทันที
    </p>
  </ContentBox3ThreeFloatingBadge>

