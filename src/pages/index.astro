---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBox3ThreeFloatingBadge from "../components/ContentBox3ThreeFloatingBadge.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBox from "../components/ContentBox.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgLuckySpin from "../assets/slide4.png";
import imgDeposit20 from "../assets/slide1.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxPremium as="h1"
//   2 → ContentBoxSevenThreePremium as="h2" + slide4 (Lucky Spin)
//   3 → ContentBoxTwoPremium as="h2" (แบ่งย่อหน้าเดียวลง left/right ที่รอยต่อประโยค)
//   4 → ContentBoxSevenThreeFloatingBadge as="h2" + slide1 (ฝาก 20 รับ 100)
//   5 → ContentBox3ThreeFloatingBadge as="h2" (แบ่งย่อหน้าลง left/center/right)
//   6 → ContentBoxSpecial as="h2" (สองครึ่ง หนึ่ง element ต่อหนึ่ง slot)
//   7 → ContentBox as="h2" (การ์ดคอลัมน์เดียวแบบเรียบ)
//
// variant รอบนี้เปลี่ยนทั้งตระกูลจากแบรนด์ก่อนหน้า (DRACO65 ใช้ CyberCut +
// Neumorphism + plain) มาเป็น Premium + FloatingBadge + Special + plain
// ส่วน Faq ย้ายจาก Faq2 มาเป็น Faq3 และ LatestWinners จาก Cyber มาเป็น 3
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook — slide4 (Lucky Spin สะสมแต้ม
// หมุนกงล้อ) คู่กับหัวข้อคอนเซปต์ตังเต็มระบบที่แจกจริงไม่มีออมมือ ส่วน slide1
// (ฝาก 20 รับ 100) คู่กับหัวข้อสิทธิพิเศษเติมความคุ้ม ที่เหลือ slide2/slide3
// เป็นของ SmoothCarousel แต่ละใบมีบ้านเดียวบนหน้าเว็บ ส่วน banner.png กับ
// banner2/3/4 เป็นอาร์ตค้างของแบรนด์ก่อนๆ จึงไม่ถูก import ที่ไหน — รูปที่ import
// คือรูปที่ถูก emit ถึงจะไม่มีใคร render ก็ตาม
//
// banner1 เป็น hero ที่ MainLayout จัดการเอง รอบนี้จึงไม่มีรูปประกอบใน ContentBox
// เดี่ยว
//
// widget ที่ไม่ได้มาจาก docx (GameRankingBoard, ProviderGrid, LatestWinners,
// LoginRtpSection, ReviewCardSumo2, SmoothCarousel, แถวปุ่ม login/register) ใช้
// ป้ายเป็น <p>/<span> + aria-label บน <section> จึงวางต่อท้ายหัวข้อ docx ที่มัน
// สังกัดได้โดยลำดับ h2 ไม่เพี้ยน — GameRankingBoard ต่อจากหัวข้อตังเต็มระบบ,
// ProviderGrid ต่อจากหัวข้อคัดตัวฮิตหลายค่าย, LatestWinners ต่อจากหัวข้อสิทธิพิเศษ,
// LoginRtpSection ต่อจากหัวข้อระบบการเงิน แล้วปิดท้ายด้วย ReviewCardSumo2 +
// SmoothCarousel + แถวปุ่ม + FAQ
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx + หัวข้อ FAQ ที่หน้านี้เขียนเอง = 7
// คำถามใน Faq3 เป็น <span> ใน <summary> ไม่ใช่ h3 และ titleleft/titlecenter/
// titleright ของ ContentBox3ThreeFloatingBadge ถูกลดเป็น <p> แล้ว — docx รอบนี้
// แบน H1+H2 ล้วน หน้านี้จึงไม่มี h3 เลย
const pageTitle = "TANGTEM168 | เว็บตรงสล็อตชื่อดัง ตังเต็มระบบ เกมเด็ดให้เลือกครบ";
const pageDescription =
  "TANGTEM168 เว็บตรงสล็อตชื่อดัง แจกตังเต็มระบบ เกมเด็ดให้เลือกครบ คัดตัวฮิตจากหลายค่ายดังมาไว้หน้าเดียว ระบบการเงินแบ่งทุกขั้นตอนชัดเจน ปลอดภัย 100% ทุกการใช้งาน";

// default message ของ Announcement ทุก variant คือสโลแกนของแบรนด์เก่าคนละเจ้ากัน
// จึงส่ง message ตรงๆ เสมอ ไม่พึ่ง default และห้ามขึ้นต้นด้วย emoji
const announcementMessage =
  "TANGTEM168 เว็บตรงสล็อตชื่อดัง ตังเต็มระบบ เกมเด็ดให้เลือกครบ ศูนย์รวมความบันเทิงยุคใหม่ที่เล่นง่ายไม่ยุ่งยาก • คอนเซปต์ตังเต็มระบบสัมผัสได้จริงตั้งแต่ครั้งแรกที่ใช้งาน ระบบพัฒนาให้มีความเสถียรสูง อัตราการแตกของแจ็คพอตตรงไปตรงมา ไม่มีการปรับลดเปอร์เซ็นต์การชนะ • คัดเกมตัวเด็ด ตัวฮิต และเกมแตกง่ายจากค่ายดังระดับโลกมาไว้หน้าเดียว ทั้งแนวสตรีทสุดมันส์ แนวแฟนตาซีอลังการ และแนวคลาสสิกเล่นง่าย ไม่ต้องโยกเงินหรือสลับเว็บ • สิทธิพิเศษเติมทุนให้สมาชิกอย่างสม่ำเสมอ ทั้งโปรโมชันต้อนรับ โบนัสประจำวัน และเครดิตคืนยอดเสีย เพิ่มรอบการปั่นและยืดระยะเวลาความสนุก • ระบบการเงินแบ่งทุกขั้นตอนชัดเจน ฝาก ถอน และเช็กประวัติย้อนหลัง จัดการเองได้ผ่านหน้าเว็บ ไร้ขั้นตอนซับซ้อน • ปลอดภัย 100% ด้วยเทคโนโลยีการเข้ารหัสขั้นสูงที่ปกป้องข้อมูลส่วนตัวของสมาชิก และระบบการเงินที่เชื่อมต่อตรงกับสถาบันการเงินชั้นนำ • สอบผ่านครบทุกมิติ ทั้งเกมเด็ดจากค่ายดัง ระบบหลังบ้านไร้รอยต่อ และการเงินที่รวดเร็ว สมชื่อตังเต็มระบบอย่างแท้จริง";

// FAQ ห้าข้อเขียนจากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้าไหนมา
// ทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบคำถาม
// ที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน
const faqs = [
  {
    q: "คอนเซปต์ตังเต็มระบบของ TANGTEM168 หมายถึงอะไร",
    a: "หมายถึงความตรงไปตรงมาที่ผู้เล่นสัมผัสได้จริงตั้งแต่ครั้งแรกที่ใช้งาน ตัวระบบถูกพัฒนาให้มีความเสถียรสูง อัตราการแตกของแจ็คพอตเป็นไปอย่างตรงไปตรงมา และไม่มีการปรับลดเปอร์เซ็นต์การชนะ ทุกสปินจึงเต็มไปด้วยความหวังและโอกาสรับเงินรางวัลใหญ่เท่าที่เกมนั้นให้ได้จริง",
  },
  {
    q: "ในล็อบบี้ของ TANGTEM168 มีเกมแนวไหนจากค่ายไหนให้เลือกบ้าง",
    a: "รวบรวมเกมสล็อตตัวเด็ด ตัวฮิต และเกมแตกง่ายจากค่ายดังระดับโลกมาไว้ในหน้าเดียว ทั้งเกมแนวสตรีทสุดมันส์ แนวแฟนตาซีอลังการ และแนวคลาสสิกเล่นง่าย ทุกเกมผ่านการคัดสรรมาแล้วว่าทำเงินได้จริงและภาพสวยสมจริง จึงไม่ต้องเสียเวลาโยกเงินหรือสลับเว็บไปมาให้ยุ่งยาก",
  },
  {
    q: "สมาชิกใหม่และสมาชิกเดิมได้สิทธิพิเศษอะไรบ้าง",
    a: "มีกิจกรรมและสิทธิพิเศษคอยเติมทุนให้สมาชิกอย่างสม่ำเสมอ ทั้งโปรโมชันต้อนรับสำหรับคนเปิดบัญชีใหม่ โบนัสประจำวัน และเครดิตคืนยอดเสีย ทุกสิทธิประโยชน์ถูกออกแบบมาเพื่อเพิ่มรอบการปั่นและยืดระยะเวลาความสนุก โดยไม่ต้องแบกรับความเสี่ยงสูงจนเกินไป",
  },
  {
    q: "ฝาก ถอน และเช็กประวัติย้อนหลังกับ TANGTEM168 ต้องทำอย่างไร",
    a: "ระบบการทำรายการถูกจัดสรรมาอย่างมีระเบียบ ทุกขั้นตอนถูกแบ่งออกอย่างชัดเจน ไม่ว่าจะเป็นการฝาก การถอน หรือการเช็กประวัติย้อนหลัง ผู้เล่นจัดการทุกอย่างได้ด้วยตัวเองผ่านหน้าเว็บอย่างรวดเร็ว ไร้ขั้นตอนซับซ้อน ทำรายการจบได้ภายในเวลาไม่นาน",
  },
  {
    q: "ข้อมูลส่วนตัวและเงินในบัญชีปลอดภัยแค่ไหน",
    a: "เว็บไซต์ใช้เทคโนโลยีการเข้ารหัสขั้นสูงเพื่อปกป้องข้อมูลส่วนตัวของสมาชิกทุกคน ไม่ให้รั่วไหลไปสู่ภายนอก รวมถึงระบบการเงินที่เชื่อมต่อตรงกับสถาบันการเงินชั้นนำเพื่อป้องกันความเสี่ยงทุกรูปแบบ ผู้เล่นจึงลงเดิมพันได้อย่างสบายใจในทุกครั้งที่เข้ามาร่วมสนุก",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxPremium as="h1" title="TANGTEM168 เว็บตรงสล็อตชื่อดัง ตังเต็มระบบ เกมเด็ดให้เลือกครบ">
    <p class="text-left text-base leading-relaxed">
      ถ้าพูดถึงเว็บสล็อตที่กำลังมาแรงและถูกพูดถึงกันปากต่อปากในตอนนี้ คงมองข้าม TANGTEM168 ไปไม่ได้เลย ที่นี่คือศูนย์รวมความบันเทิงยุคใหม่ที่จัดเต็มทั้งเรื่องความหลากหลายของเกมสล็อตและระบบการทำงานที่ทันสมัย
      ออกแบบมาเพื่อตอบโจทย์สายปั่นที่ต้องการความชัวร์ ความสนุก และความคุ้มค่าแบบจัดเต็ม เล่นง่าย ไม่ยุ่งยาก พร้อมขนความตื่นเต้นมาให้สัมผัสกันแบบครบรส ปั่นได้เพลินๆ ทำกำไรเข้ากระเป๋าได้จริงตลอดทั้งวัน
    </p>
  </ContentBoxPremium>

  <ContentBoxSevenThreePremium as="h2" title="TANGTEM168 เว็บตรงสล็อตชื่อดัง เปิดสูตรตังเต็มระบบที่ไม่ได้มีดีแค่ชื่อ">
    <Picture
      slot="left"
      src={imgLuckySpin}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์กิจกรรม TANGTEM168 ข้อความ Lucky Spin สะสมครบ 50 แต้ม หมุนกงล้อฟรี 1 ครั้ง กลางภาพเป็นวงล้อเสี่ยงโชคช่องรางวัล 10 20 30 50 100 300 500 และ 1000 ใต้ภาพเป็นตารางเงื่อนไขห้าข้อ ทุกยอดฝาก 300 แบบรับโบนัส รับฟรี 10 แต้ม, ทุกการกดรับคอมมิชชั่น 10 บาท รับฟรี 5 แต้ม, ทุกการกดรับยอดเสียสล็อต 10 บาท รับฟรี 5 แต้ม, ทุกการกดรับยอดเสียยิงปลา 10 บาท รับฟรี 5 แต้ม และออนไลน์ทุก 1 ชั่วโมง รับฟรี 1 แต้ม ด้านซ้ายเป็นพรีเซนเตอร์หญิงชุดชมพูขาว ด้านบนเป็นโลโก้ TANGTEM168 รูปเทพเจ้าจีนถือทอง แถบล่างเรียงโลโก้ค่ายเกม"
      class="mx-auto h-auto w-full rounded-2xl border border-[#fcc30b]/40 shadow-[0_10px_30px_rgba(252,195,11,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      สมกับเป็นเว็บตรงชื่อดัง เพราะ TANGTEM168 มาพร้อมกับคอนเซปต์ "ตังเต็มระบบ" ที่ผู้เล่นทุกคนสัมผัสได้จริงตั้งแต่ครั้งแรกที่ใช้งาน ตัวระบบได้รับการพัฒนาให้มีความเสถียรสูง
      อัตราการแตกของแจ็คพอตเป็นไปอย่างตรงไปตรงมา ไม่มีการปรับลดเปอร์เซ็นต์การชนะ ทำให้ทุกสปินของคุณเต็มไปด้วยความหวังและโอกาสรับเงินรางวัลใหญ่ ความตรงไปตรงมาและแจกจริงแบบไม่มีออมมือนี้เองที่ทำให้ชื่อเสียงของเว็บนี้ถูกบอกต่ออย่างรวดเร็ว
    </p>
  </ContentBoxSevenThreePremium>

  <GameRankingBoard />

  <ContentBoxTwoPremium as="h2" title="คัดตัวฮิตหลายค่ายมาไว้หน้าเดียว TANGTEM168 เกมเด็ดครบจนไม่ต้องไล่หาทีละเว็บ">
    <p slot="left" class="text-left text-base leading-relaxed">
      ไม่ต้องเสียเวลาโยกเงินหรือสลับเว็บไปมาให้ยุ่งยาก เพราะ TANGTEM168 ได้ทำการรวบรวมเกมสล็อตตัวเด็ด ตัวฮิต และเกมแตกง่ายจากค่ายดังระดับโลกมาไว้ในหน้าเดียว ไม่ว่าจะเป็นเกมแนวสตรีทสุดมันส์
      แนวแฟนตาซีอลังการ หรือแนวคลาสสิกเล่นง่าย
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      ทุกเกมผ่านการคัดสรรมาแล้วว่าทำเงินได้จริงและภาพสวยสมจริง อยากเปลี่ยนฟีลเปลี่ยนบรรยากาศเมื่อไหร่ก็แค่คลิกเลือกเกมใหม่ในล็อบบี้ได้ทันที
    </p>
  </ContentBoxTwoPremium>

  <ProviderGrid />

  <ContentBoxSevenThreeFloatingBadge as="h2" title="แจกตังเต็มระบบมีอะไรให้ตาม? เปิดสิทธิพิเศษที่เติมความคุ้มให้การเล่นน่าสนใจกว่าเดิม">
    <Picture
      slot="left"
      src={imgDeposit20}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
