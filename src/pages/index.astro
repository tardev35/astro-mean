---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBox3ThreeCyberCut from "../components/ContentBox3ThreeCyberCut.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import ProviderGrid from "../components/ProviderGridPremium.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSpinPrize from "../assets/slide3.png";
import imgCashbackReferral from "../assets/slide2.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxCyberCut as="h1"
//   2 → ContentBoxSevenThreeCyberCut as="h2" + slide3 (ทุกยอดฝาก 300 ได้ 1 สิทธิ์หมุน)
//   3 → ContentBoxTwoNeumorphism as="h2" (แบ่งย่อหน้าเดียวลง left/right ที่รอยต่อประโยค)
//   4 → ContentBox3ThreeCyberCut as="h2" (แบ่งย่อหน้าเดียวลง left/center/right)
//   5 → ContentBoxNeumorphism as="h2" (สล็อตเดียว)
//   6 → ContentBoxSevenThreeNeumorphism as="h2" + slide2 (คืนยอดเสีย 10% / ค่าคอม 1%)
//   7 → ContentBox as="h2" (การ์ดกลางที่ terms/privacy ใช้ร่วม)
//
// variant รอบนี้หมุนทั้งตระกูลจากแบรนด์ก่อนหน้า (DEKDDD ใช้ Premium ×3 +
// FloatingBadge ×2 + Special ×1 + plain ×1) มาเป็น CyberCut ×3 + Neumorphism ×3 +
// plain ×1 ส่วน Navbar ย้ายจาก NavbarStyle6 มาเป็น NavbarCyber, Footer จาก
// FooterStyle2 มาเป็น FooterCyber, Announcement จาก Announcement5 มาเป็น
// AnnouncementCyber, LatestWinners จาก LatestWinners3 มาเป็น LatestWinnersCyber,
// Faq จาก Faq4 มาเป็น Faq2 และ ProviderGrid จากตัวธรรมดามาเป็น ProviderGridPremium
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook — slide3 (ลุ้นรางวัลจากยอดฝาก 300)
// คู่กับหัวข้อคลังเกมในล็อบบี้ และ slide2 (คืนยอดเสีย 10% + ค่าคอมแนะนำเพื่อน 1%)
// คู่กับหัวข้อระบบฝากถอนไวใน 3 วิ ส่วน slide1 กับ slide4 ไม่ถูก import ในไฟล์นี้ —
// ทั้งคู่ยังขึ้นใน SmoothCarousel และหน้า /promotion อยู่ เช่นเดียวกับ banner.png
// และ banner2/3/4 ที่เป็นอาร์ตค้างของแบรนด์ก่อนๆ ซึ่งห้ามแตะ — รูปที่ import คือรูป
// ที่ถูก emit ถึงจะไม่มีใคร render ก็ตาม
//
// banner1 เป็น hero ที่ MainLayout จัดการเอง รอบนี้จึงไม่มีรูปประกอบใน ContentBox
// เดี่ยว
//
// widget ที่ไม่ได้มาจาก docx (ProviderGridPremium, GameRankingBoard,
// LatestWinnersCyber, LoginRtpSection, ReviewCardSumo2, SmoothCarousel, แถวปุ่ม
// login/register, FAQ) ใช้ป้ายเป็น <p>/<span> + aria-label บน <section> และถูกวาง
// ต่อท้ายหัวข้อ docx ข้อสุดท้ายทั้งชุด จึงไม่มีตัวไหนคั่นระหว่างหัวข้อ docx สองข้อเลย
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx + หัวข้อ FAQ ที่หน้านี้ส่งเป็น prop = 7
// คำถามใน Faq2 เป็น <span> ใน <summary> ไม่ใช่ h3 และป้ายคอลัมน์ของ
// ContentBox3ThreeCyberCut / ContentBoxSevenThree* / ContentBoxTwoNeumorphism
// เป็น <p> — docx รอบนี้แบน H1 + H2 ล้วน หน้านี้จึงไม่มี h3 เลย
const pageTitle = "ORCA789 | สล็อตตัวฮิตมาแรง เกมเด็ดครบเครื่อง เว็บเดียวเอาอยู่";
// คำอธิบายยาว 158 ตัวอักษร อยู่ในเกท 150–160 ของ verify-build พอดี ตั้งต้นจาก
// บรรทัด Meta ของ docx (แก้ typo "ุฝากถอน" เป็น "ฝากถอน") และเป็นสตริงเดียวกับที่
// ส่งเข้า pageGraph
const pageDescription = "ORCA789 สล็อตตัวฮิตมาแรง เกมเด็ดครบเครื่องจัดมาแน่น บาคาร่าและฟุตบอล เติมเกมใหม่ให้ลองเรื่อยๆ ระบบใหม่อัปเดตตลอด ฝากถอนไวใน 3 วิ เว็บเดียวเอาอยู่ครบจบที่เดียว";

// default message ของ Announcement ทุก variant คือสโลแกนของแบรนด์เก่าคนละเจ้ากัน
// จึงส่ง message ตรงๆ เสมอ ไม่พึ่ง default และห้ามขึ้นต้นด้วย emoji เพราะ marquee
// render ข้อความซ้ำและ emoji ที่ฝังในสตริงถูก mark aria-hidden ไม่ได้
const announcementMessage =
  "ORCA789 สล็อตตัวฮิตมาแรง เกมเด็ดครบเครื่อง เว็บเดียวเอาอยู่ • ครบทุกมิติในที่เดียว ทั้งสล็อตตัวฮิตกระแสแรง บาคาร่าสด คาสิโน และแทงบอลออนไลน์ ไม่ต้องย้ายเว็บไปมาให้เสียเวลา • ล็อบบี้คัดเฉพาะเกมเด็ดแตกหนักจากทุกค่ายชั้นนำ ทั้งธีมแฟนตาซีตระการตา แนวสตรีทสุดเท่ และคลาสสิกโบนัสแตกง่าย กราฟิกคมชัด เอฟเฟกต์อลังการ • บาคาร่ายิงตรงสัญญาณสดความละเอียดสูง HD จากคาสิโนจริง ส่วนโหมดเดิมพันฟุตบอลราคาน้ำดี ค่าน้ำเปิดกว้างทุกลีกทั่วโลก สลับเล่นได้ในยูสเซอร์เดียว • ทีมงานอัปเดตไลน์อัปเกมใหม่เข้าระบบต่อเนื่อง ค่ายดังออกเกมอะไรมาก็ได้ลองเป็นกลุ่มแรกๆ เสมอ ล็อบบี้จึงสดใหม่ไม่จำเจ • ระบบหลังบ้านปรับจูนให้เสถียรสูงสุด รองรับสมาชิกจำนวนมากพร้อมกันโดยไม่หน่วง ไม่กระตุก ไม่มีเกมหลุดระหว่างลุ้นโบนัส • ฝากถอนออโต้ไฮสปีดจบภายใน 3 วินาที ไม่ต้องส่งสลิปยืนยัน ไม่ต้องรอแอดมินอนุมัติ คล่องตัวและปลอดภัยทุกธุรกรรม";

// FAQ ห้าข้อเขียนจากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้าไหนมา
// ทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบคำถาม
// ที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน
const faqs = [
  {
    q: "ORCA789 มีโหมดเดิมพันอะไรให้เล่นบ้างในยูสเซอร์เดียว",
    a: "เปิดครบทั้งสล็อตตัวฮิตกระแสแรง บาคาร่าสด คาสิโนออนไลน์ และเดิมพันฟุตบอล ทุกโหมดใช้บัญชีเดียวกัน จึงสลับอารมณ์จากการปั่นสล็อตไปนั่งโต๊ะบาคาร่าหรือไปแทงบอลได้ทันทีโดยไม่ต้องโยกเงินข้ามกระเป๋าและไม่ต้องเปิดเว็บใหม่ให้เสียเวลา",
  },
  {
    q: "เกมสล็อตในล็อบบี้คัดมาแบบไหน มีธีมอะไรให้เลือก",
    a: "คัดเฉพาะตัวเด็ดแตกหนักจากค่ายชั้นนำมารวมไว้ มีทั้งธีมแฟนตาซีตระการตา แนวสตรีทสุดเท่ และสไตล์คลาสสิกที่โบนัสแตกง่าย แต่ละเกมมาพร้อมกราฟิกคมชัดกับเอฟเฟกต์อลังการ อัตราการจ่ายรางวัลคุ้มค่า และจังหวะโบนัสกับแจ็คพอตที่พร้อมระเบิดได้ตลอดเวลา",
  },
  {
    q: "บาคาร่าสดของที่นี่ถ่ายทอดจากคาสิโนจริงหรือเปล่า",
    a: "เป็นการยิงตรงสัญญาณสดความละเอียดสูงระดับ HD จากคาสิโนจริง จึงได้ฟีลลิ่งเรียลไทม์เหมือนนั่งอยู่หน้าโต๊ะ ส่วนโหมดเดิมพันฟุตบอลก็มีราคาน้ำดี ค่าน้ำเปิดกว้าง เลือกเล่นได้ทุกลีกทั่วโลก อยากสลับไปมาระหว่างสองโหมดก็ทำได้ในยูสเซอร์เดียว",
  },
  {
    q: "เกมใหม่เข้าระบบบ่อยแค่ไหน จะเจอแต่เกมเดิมไหม",
    a: "ทีมงานอัปเดตไลน์อัปเกมใหม่เข้าสู่ระบบอย่างต่อเนื่อง ค่ายดังปล่อยเกมอะไรออกมา สมาชิกที่นี่จะได้สัมผัสและทดลองเล่นเป็นกลุ่มแรกๆ เสมอ หน้าล็อบบี้จึงสดใหม่อยู่ตลอด ไม่วนอยู่แต่เกมเดิม อยากลองฟีเจอร์แปลกใหม่เมื่อไหร่ก็คลิกเลือกเล่นได้ทันที",
  },
  {
    q: "ฝากถอนใช้เวลานานไหม ต้องส่งสลิปให้แอดมินหรือเปล่า",
    a: "ใช้ระบบฝากถอนออโต้ไฮสปีด ทำรายการเสร็จภายใน 3 วินาที ทั้งเติมทุนเข้าเล่นต่อและถอนยอดกำไรก้อนโตเข้าบัญชี จัดการเองได้ง่ายๆ ไม่ต้องส่งสลิปยืนยันและไม่ต้องรอแอดมินอนุมัติ ระบบหลังบ้านยังปรับจูนให้เสถียร รองรับสมาชิกจำนวนมากพร้อมกันโดยไม่หน่วง",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxCyberCut as="h1" title="ORCA789 สล็อตตัวฮิตมาแรง เกมเด็ดครบเครื่อง เว็บเดียวเอาอยู่">
    <p class="text-left text-base leading-relaxed">
      ถ้าคุณกำลังมองหาความครบเครื่องแบบไม่ต้องย้ายเว็บไปมา ORCA789 คือตัวเลือกสุดปังที่ตอบโจทย์สายปั่นยุคนี้ได้อย่างแท้จริง ที่นี่รวมเอาความตื่นเต้นครบทุกมิติมาเสิร์ฟไว้ในที่เดียว
      ทั้งสล็อตตัวฮิตกระแสแรง บาคาร่าสด คาสิโน และแทงบอลออนไลน์ โดดเด่นด้วยระบบประมวลผลที่เร็ว เสถียร ลื่นไหล เล่นได้อย่างต่อเนื่องไม่มีสะดุด
      มอบประสบการณ์ความมันส์ระดับพรีเมียมที่ทำให้ใครลองแล้วก็ต้องบอกต่อว่าเว็บนี้เว็บเดียวเอาอยู่ของจริง
    </p>
  </ContentBoxCyberCut>

  <ContentBoxSevenThreeCyberCut as="h2" title="ORCA789 สล็อตตัวฮิตมาแรง มีเกมเด็ดอะไรซ่อนอยู่ในล็อบบี้บ้าง?" titleleft="ทุกยอดฝาก 300 ได้ 1 สิทธิ์หมุน">
    <Picture
      slot="left"
      src={imgSpinPrize}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 767px) 92vw, 340px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่นเขียนว่า สมาชิกเก่าและใหม่ ทุกยอดฝาก 300 บาท ได้ 1 สิทธิ์การหมุน รางวัลมอเตอร์ไซต์ 2 รางวัล iPhone 2 รางวัล ทองคำ 5 รางวัล ลุ้นรางวัลโบนัสสูงสุด 100,000 ภาพหญิงสาวชุดน้ำเงินถือไพ่ ล้อมด้วยเหรียญทอง มงกุฎ สร้อยทอง มือถือ และมอเตอร์ไซค์ พื้นหลังใต้ทะเลสีน้ำเงิน"
      class="mx-auto h-auto w-full rounded-2xl border border-[#00abfc]/40 shadow-[0_10px_30px_rgba(0,171,252,0.3)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      ก้าวเข้าสู่หน้าล็อบบี้ของ ORCA789 คุณจะได้เจอกับคลังเกมสล็อตที่คัดสรรมาเฉพาะตัวเด็ดแตกหนักจากทุกค่ายชั้นนำ ไม่ว่าจะเป็นเกมธีมแฟนตาซีตระการตา เกมแนวสตรีทสุดเท่ หรือเกมสไตล์คลาสสิกโบนัสแตกง่าย
      แต่ละเกมอัดแน่นไปด้วยกราฟิกคมชัดและเอฟเฟกต์สุดอลังการ ที่สำคัญคือมีอัตราการจ่ายรางวัลคุ้มค่า จังหวะโบนัสและแจ็คพอตพร้อมระเบิดได้ตลอดเวลา ให้คุณลุ้นสนุกทำกำไรได้เพลินๆ ทุกวัน
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxTwoNeumorphism
    as="h2"
    title="บาคาร่าและฟุตบอลจัดเต็ม อีกสองโหมดที่สายเล่นจริงไม่ควรมองข้าม"
    titleleft="บาคาร่าสดสัญญาณ HD"
    titleright="ราคาน้ำดีครบทุกลีก">
    <p slot="left" class="text-left text-base leading-relaxed">
      ไม่ได้มีดีแค่เกมสล็อตเท่านั้น แต่ ORCA789 ยังจัดเต็มอีกสองโหมดฮิตอย่างบาคาร่าสดและเดิมพันฟุตบอลแบบครบรส ในส่วนของบาคาร่าเป็นการยิงตรงสัญญาณสดความละเอียดสูง HD จากคาสิโนจริง
      ได้ฟีลลิ่งเรียลไทม์สุดๆ
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      ขณะที่โหมดเดิมพันฟุตบอลก็มีราคาน้ำดี ค่าน้ำเปิดกว้างให้เลือกเล่นทุกลีกทั่วโลก สลับอารมณ์มาเล่นได้ทันทีในยูสเซอร์เดียว ไม่ต้องเสียเวลาโยกเงินให้ยุ่งยาก
    </p>
  </ContentBoxTwoNeumorphism>

  <ContentBox3ThreeCyberCut
    as="h2"
    title="เกมใหม่เข้าเรื่อยๆ ที่ ORCA789 ล็อบบี้จึงสดใหม่ไม่วนอยู่แต่เกมเดิม"
    titleleft="อัปเดตต่อเนื่อง"
    titlecenter="ได้ลองเป็นกลุ่มแรก"
    titleright="คลิกเดียวเปลี่ยนเกม">
    <p slot="left" class="text-left text-base leading-relaxed">
      เบื่อไหมกับการเล่นเว็บเดิมๆ แล้วเจอแต่เกมเก่า? ที่ ORCA789 ตัดปัญหานั้นออกไปได้เลย เพราะทีมงานขยันอัปเดตไลน์อัปเกมใหม่ๆ เข้าสู่ระบบอย่างต่อเนื่อง
    </p>
