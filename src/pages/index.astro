---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners3 from "../components/LatestWinners3.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Faq4 from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide3.png";
import imgAutoBanking from "../assets/slide2.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxPremium as="h1" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   2 → ContentBoxTwoCyberCut as="h2" (ย่อหน้าเดียวแบ่งสองครึ่งตามลำดับประโยคเดิม:
//       คัดเกมโบนัสแตกง่าย ตัดเกมคุณภาพต่ำและเกมล้าหลังออก → จัดระเบียบล็อบบี้
//       เลือกสปินตามไลฟ์สไตล์ได้แม่นยำ)
//   3 → ContentBox3ThreePremium as="h2" (ย่อหน้าเดียวแบ่งลงสามคอลัมน์ตามลำดับประโยค
//       เดิม: คลังลิขสิทธิ์แท้จากค่ายยักษ์ใหญ่ → ทดสอบอัลกอริทึมการจ่ายรางวัล →
//       ปั่นเบทไหนก็ลุ้นแตกเท่ากัน) แล้วต่อด้วย ProviderGrid ซึ่งกางรายชื่อค่ายที่
//       ย่อหน้าเดียวกันระบุไว้ตรงๆ (PG Soft / Pragmatic Play / Joker Gaming)
//   4 → ContentBoxSpecial as="h2" (ย่อหน้าเดียวแบ่งสองครึ่งตามลำดับประโยคเดิม) แล้ว
//       ต่อด้วย FeatureHighlights ซึ่งกางสามลูกเล่นที่ย่อหน้าเดียวกันเอ่ยชื่อไว้ตรงๆ
//       (Multiplier / Expanding Wild / ซื้อฟรีสปิน) → h3 สามตัว ซึ่งเป็น h3 ชุดเดียว
//       ที่ได้รับอนุญาตบนหน้านี้ คำอธิบายเขียนขยายความใหม่ ไม่ได้ก๊อบประโยคด้านบนซ้ำ
//   5 → ContentBoxSevenThreePremium as="h2" + slide3 (อาร์ตสไลด์เขียนว่า ยอดเสีย
//       คืนสูงสุด 10% / เล่นเสีย รับคืนทุกวัน ไม่ต้องลุ้น ซึ่งเป็นรูปธรรมของหัวข้อ
//       เรื่องโปรน่าสนใจที่มีสิทธิ์คืนยอดเสีย Cash Back ทุกวัน)
//   6 → ContentBoxSevenThreeNeumorphism as="h2" + slide2 (อาร์ตสไลด์เขียนว่า ฝาก-ถอน
//       ระบบอัตโนมัติ รวดเร็ว / ปลอดภัย มั่นใจ 100% ซึ่งตรงกับหัวข้อเรื่องออโต้ทันใจ
//       ที่ตัดช่วงรออนุมัติออกทั้งหมด)
//   7 → ContentBoxFloatingBadge as="h2" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว) — ป้ายลอย
//       ของ variant นี้ถูกคำนวณ clearance ใหม่กับหัวข้อจริงยาว 71 ตัวอักษรแล้วในไฟล์
//       component: pt-48/md:pt-40 เหลือช่องว่าง 30px บนจอ 360px และ 52px บน md
//
// variant รอบนี้หมุนออกจากชุดของแบรนด์ก่อนทั้งตระกูล: ทรง ContentBox เปลี่ยนจาก
// CyberCut + TwoPremium + 3ThreeNeumorphism + plain + Neumorphism + SevenThree +
// SevenThreeCyberCut มาเป็น Premium + TwoCyberCut + 3ThreePremium + Special +
// SevenThreePremium + SevenThreeNeumorphism + FloatingBadge ส่วน Announcement เป็น
// Announcement5, LatestWinners เป็น LatestWinners3, กริดค่ายเกมเป็น ProviderGrid,
// การ์ดรีวิวเป็น ReviewCardSumo และ Faq เป็น Faq4 — Navbar/Footer/ฟอนต์ ถูกสลับไว้
// แล้วใน MainLayout กับ brandProfile
//
// ContentBoxSevenThree* ปล่อยหัวข้อผ่าน `title` ตัวเดียว ส่วน titleleft เป็นป้าย
// คอลัมน์รูปที่เป็น <p> — ห้ามส่ง titleright เพิ่ม เพราะจะได้ป้ายเกินมาโดยไม่มี
// ต้นทางใน docx
//
// Announcement ส่ง message ตรงๆ เสมอ เพราะ default ของทุก variant ในตระกูลนี้เป็น
// สโลแกนของแบรนด์เก่าคนละเจ้ากัน ข้อความชุดนี้ตรงตัวต่อตัวกับ default ของ
// Announcement5.astro เพื่อให้ ticker ของหน้าย่อยที่เรียก <Announcement /> เปล่าๆ
// วิ่งข้อความเดียวกับหน้าแรก และห้ามขึ้นต้นด้วย emoji เพราะ marquee render ข้อความ
// ซ้ำและ emoji ที่ฝังในสตริงถูก mark aria-hidden ไม่ได้
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook คู่กับ slide3/slide2 ซึ่งเป็นสไลด์ที่
// อาร์ตตรงกับหัวข้อ docx ข้อ 5 กับข้อ 6 พอดี — slide1 (ชวนเพื่อนรับค่าคอมมิชชั่น)
// ไม่มีหัวข้อ docx รองรับและเพดาน SevenThree เต็มแล้ว จึงไม่ถูกใช้ที่นี่ ส่วน slide4
// เป็นของแบรนด์อื่นที่มีลายน้ำติดมา ห้าม import ที่ไหนทั้งสิ้น และไฟล์ banner ทุกตัว
// (ทั้งตัวที่มีเลขต่อท้ายและตัวมือถือ) ห้าม import ที่นี่ เพราะรูปที่ import คือรูปที่
// ถูก emit ลง dist/ ถึงจะไม่มีใคร render ก็ตาม — banner1 เป็นของ MainLayout จัดการ
// เอง และรูปในหน้านี้ไม่มีตัวไหนใส่ loading="eager"/fetchpriority="high" เพราะ LCP
// เป็นของ hero ใน MainLayout
//
// widget ที่ไม่ได้มาจาก docx (GameRankingBoard, LatestWinners3, LoginRtpSection,
// ReviewCardSumo, แถวปุ่ม login/register, Faq4, Navfoot) ใช้ป้ายเป็น <p>/<span> +
// aria-label บน <section> และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้ายทั้งชุด ยกเว้นสองตัว
// ที่เป็นภาพประกอบของหัวข้อ docx หนึ่งข้อโดยตรง (ProviderGrid → ข้อ 3,
// FeatureHighlights → ข้อ 4) ซึ่งวางต่อท้ายบล็อกนั้นๆ
//
// h1 ×1 + h2 ×6 = หัวข้อ docx พอดี บวก h3 ×3 จาก FeatureHighlights ซึ่งเป็นรายการ
// ย่อยของหัวข้อข้อ 4 ตามข้อยกเว้นเดียวที่ playbook อนุญาต — หัว FAQ เป็น <p> ใน
// Faq4.astro คำถามเป็น <span> ใน <summary> ชื่อกริดค่ายใน ProviderGrid.astro เป็น <p>
// และป้ายคอลัมน์ของทุก ContentBox variant เป็น <p>
//
// title กับ description ใช้บรรทัดที่ brief ให้มาตรงๆ ทั้งคู่ ห้ามเติมหรือตัด และเป็น
// สตริงเดียวกับที่ส่งเข้า pageGraph และ MainLayout
const pageTitle = "SETH88 | สล็อตเว็บตรงเกมคัด เกมลิขสิทธิ์แน่น ออโต้ทันใจ ปลอดภัยชัวร์";
const pageDescription = "SETH88 สล็อตเว็บตรงเกมคัด เกมลิขสิทธิ์แน่นแบบเลือกแล้วไม่เสียฟีล หลายค่ายลูกเล่นเยอะ โปรน่าสนใจเติมต่อเนื่อง ออโต้ทันใจ ระบบปลอดภัยชัวร์";

const announcementMessage =
  "SETH88 สล็อตเว็บตรงเกมคัด เกมลิขสิทธิ์แน่น ออโต้ทันใจ ปลอดภัยชัวร์ • สล็อตเว็บตรง API แท้ ยิงตรงจากเซิร์ฟเวอร์หลัก ไม่ผ่านเอเย่นต์ ค่า RTP มาตรฐานสากลจากค่ายแม่ ไม่มีปรับลดอัตราแตก ไม่ล็อกยูส รวมเกมคัดเกรดคุณภาพระดับ A-List ไว้ในกระเป๋าเดียว ถอนกำไรได้ครบเต็มจำนวนทุกบาท ปลอดภัยชัวร์ 100% • คัดสรรเฉพาะตัวเกมโบนัสแตกง่าย ตัดเกมคุณภาพต่ำและเกมล้าหลังออกทั้งหมด จัดระเบียบหน้าล็อบบี้ให้เข้าถึงง่าย เลือกสปินเกมที่ชอบตามไลฟ์สไตล์การเดิมพันได้อย่างแม่นยำ ไม่ต้องเสียเวลาวนหา • คลังเกมลิขสิทธิ์แท้ส่งตรงจากค่ายยักษ์ใหญ่ระดับโลก ทั้ง PG Soft, Pragmatic Play และ Joker Gaming ทุกเกมผ่านการทดสอบอัลกอริทึมการจ่ายเงินรางวัลตามมาตรฐานโรงงานผู้พัฒนา ปั่นเบทไหนก็มีสิทธิ์ลุ้นแตกหนักเท่ากันทุกรอบ • หลายค่ายลูกเล่นเยอะ สลับเปลี่ยนเกมเมื่อไหร่ก็เจอฟีเจอร์และสไตล์ที่ต่างกัน ทั้งระบบ Multiplier ตัวคูณสะสมโหดๆ สัญลักษณ์ Expanding Wild ขยายเต็มรีล และโหมดซื้อฟรีสปินพุ่งตรงเข้าลุ้นโบนัส • โปรน่าสนใจเติมต่อเนื่อง เลือกกดรับเองผ่านหน้าแดชบอร์ด ทั้งโบนัสต้อนรับสมาชิกใหม่ โปรเติมเงินฝากแรกของวัน และสิทธิ์คืนยอดเสีย Cash Back ทุกวัน เงื่อนไขชัดเจน โปร่งใส ไม่ติดเทิร์นโอเวอร์มหาโหด • ออโต้ทันใจ ฝากถอนเสร็จสิ้นใน 3 วินาทีผ่าน Gateway ตรง รองรับทั้งสถาบันการเงินชั้นนำและ TrueMoney Wallet ไม่ต้องส่งสลิปยืนยัน ไม่ต้องรอแอดมินอนุมัติ ฝากปุ๊บเครดิตเข้าเกมปั๊บ • ระบบปลอดภัยชัวร์ เข้ารหัสปกป้องข้อมูลสมาชิกแน่นหนาด้วยระบบ SSL พร้อมระบบตรวจสอบประวัติการทำรายการแบบเรียลไทม์ กดถอนกำไรได้แบบสบายใจตั้งแต่วันแรก";

// FAQ ห้าข้อเขียนขึ้นใหม่จากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้า
// ไหนมาทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบ
// คำถามที่สายปั่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq4> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน — ห้ามปล่อยให้
// Faq4 ใช้ค่า default ของตัวเอง เพราะ default เป็นลิสต์ว่างโดยตั้งใจ
const faqs = [
  {
    q: "SETH88 เป็นเว็บตรงจริงไหม แล้วค่า RTP ถูกปรับลดหรือเปล่า",
    a: "เป็นสล็อตเว็บตรงที่เชื่อมต่อ API แท้ ยิงตรงจากเซิร์ฟเวอร์หลักโดยไม่ผ่านเอเย่นต์ ค่า RTP จึงเป็นมาตรฐานสากลที่ค่ายแม่กำหนดไว้จริง ไม่มีการปรับลดอัตราแตกระหว่างทางและไม่ล็อกยูส ถอนกำไรได้ครบเต็มจำนวนทุกบาท พร้อมโครงสร้างความปลอดภัยที่เข้ารหัสข้อมูลสมาชิกด้วยระบบ SSL",
  },
  {
    q: "เกมคัดหมายความว่าอย่างไร ต่างจากเว็บที่มีเกมเยอะๆ ตรงไหน",
    a: "คัดสรรเฉพาะตัวเกมโบนัสแตกง่ายเข้าสู่ระบบ แล้วตัดเกมคุณภาพต่ำกับเกมล้าหลังออกทั้งหมด หน้าล็อบบี้จึงถูกจัดระเบียบให้เข้าถึงง่าย ผู้เล่นพุ่งตรงเข้าเกมทำเงินได้ทันทีโดยไม่ต้องเสียเวลาวนหา และเลือกสปินเกมที่ชอบตามไลฟ์สไตล์การเดิมพันได้อย่างแม่นยำตั้งแต่วินาทีแรกที่กดเข้าเล่น",
  },
  {
    q: "มีค่ายเกมอะไรบ้าง แล้วรู้ได้อย่างไรว่าเป็นลิขสิทธิ์แท้",
    a: "คลังเกมส่งตรงจากค่ายยักษ์ใหญ่ระดับโลก ทั้ง PG Soft, Pragmatic Play และ Joker Gaming ทุกเกมผ่านการทดสอบอัลกอริทึมการจ่ายเงินรางวัลว่ามีความยุติธรรมตามมาตรฐานโรงงานผู้พัฒนา ไม่ว่าจะปั่นเบทระดับไหนก็มีสิทธิ์ลุ้นแตกหนักเท่ากันทุกรอบ และสลับเล่นข้ามค่ายได้จากกระเป๋าเดียว",
  },
  {
    q: "ลูกเล่นในเกมมีอะไรให้ลุ้นบ้าง",
    a: "แต่ละค่ายมีเอกลักษณ์เฉพาะตัว สลับเปลี่ยนเกมเมื่อไหร่ก็เจอฟีเจอร์ใหม่ให้ลุ้น ทั้งระบบ Multiplier ตัวคูณสะสมโหดๆ สัญลักษณ์ Expanding Wild ที่ขยายเต็มรีล และโหมดซื้อฟรีสปินที่พุ่งตรงเข้าลุ้นโบนัสได้ทันที ส่วนโปรก็อัปเดตต่อเนื่อง ทั้งโบนัสต้อนรับสมาชิกใหม่ โปรเติมเงินฝากแรกของวัน และคืนยอดเสีย Cash Back ทุกวัน",
  },
  {
    q: "ฝากถอนนานไหม ต้องส่งสลิปให้แอดมินหรือเปล่า",
    a: "ระบบการเงินเป็นออโต้ไฮสปีดผ่าน Gateway ตรง ทำรายการเสร็จสิ้นใน 3 วินาที รองรับทั้งสถาบันการเงินชั้นนำและ TrueMoney Wallet ตัดช่วงเวลารออนุมัติจากแอดมินออกทั้งหมด ไม่ต้องส่งสลิปยืนยัน ฝากปุ๊บเครดิตเข้าเกมปั๊บ ถอนปุ๊บเงินเด้งเข้าบัญชีทันที พร้อมระบบตรวจสอบประวัติการทำรายการแบบเรียลไทม์",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxPremium as="h1" title="SETH88 สล็อตเว็บตรงเกมคัด เกมลิขสิทธิ์แน่น ออโต้ทันใจ ปลอดภัยชัวร์">
    <p class="text-left text-base leading-relaxed">
      SETH88 สล็อตเว็บตรง API แท้ ยิงตรงจากเซิร์ฟเวอร์หลัก ไม่ผ่านเอเย่นต์ ชูจุดเด่นเรื่องความโปร่งใสด้วยค่า RTP มาตรฐานสากลจากค่ายแม่ ไม่มีปรับลดอัตราแตก ไม่ล็อกยูส รวบรวมเกมคัดเกรดคุณภาพระดับ A-List
