---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide3.png";
import imgDirectWeb from "../assets/slide2.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxCyberCut as="h1"
//   2 → ContentBoxPremium as="h2"
//   3 → ContentBoxNeumorphism as="h2"
//   4 → ContentBoxSpecial as="h2" (แบ่งย่อหน้าเดียวเป็นสองครึ่งที่รอยต่อประโยค)
//   5 → ContentBoxSevenThreeCyberCut + slide3 (คืนยอดเสียสูงสุด 5%)
//   6 → ContentBoxSevenThreePremium + slide2 (เว็บตรง มั่นคง ปลอดภัย)
//   7 → ContentBox as="h2"
// SevenThree ใช้ 2 บล็อกเท่านั้น (โควตาเต็ม) และแต่ละตัวส่งหัวข้อเดียว
// (titleright ของ CyberCut / title ของ Premium) ถ้าส่งทั้งซ้ายและขวาจะได้ h2 เกิน
// slide1 ไม่ได้ใช้ในกล่องเนื้อหา ขึ้นเฉพาะใน SmoothCarousel
// slide4 เป็นอาร์ตของแบรนด์ก่อนหน้า จึงไม่ถูก import ที่ไหนในหน้านี้อีกแล้ว
// widget ที่ไม่ได้มาจาก docx ใช้หัวข้อเป็น <p> + aria-label บน <section> จึงวาง
// ต่อท้ายหัวข้อ docx ที่มันสังกัดได้โดยลำดับ H2 ไม่เพี้ยน
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx + หัวข้อ FAQ ที่หน้านี้เขียนเอง = 7
// h3 = 0 — docx ของแบรนด์นี้แบนราบ (H1 + H2 ล้วน) หน้าเว็บจึงต้องแบนตาม
// คำถามใน Faq4 เป็น <span> ตามระดับเดิมที่ variant นั้น ship มา ไม่ใช่ <h3>

const pageTitle = "FLASH789 | สล็อตเว็บตรงมาแรง เกมดีทุกตา ระบบไวทุกคลิก โบนัสคุ้ม";

// Meta description ยาว 158 ตัวอักษร — verify-build บังคับช่วง 150–160 ตัวอักษร
// บรรทัด Des ของ docx ยาว 142 จึงต่อท้ายด้วยวลีสรุปจาก docx ข้อ 7 ให้เข้าช่วง
const pageDescription =
  "FLASH789 สล็อตเว็บตรงมาแรง เกมดีทุกตา ระบบไวทุกคลิก ฟีลการเล่นลื่นทุกสปินไม่มีสะดุด ค่ายดังมาเต็ม โบนัสคุ้มโปรเด็ดตลอดวัน พร้อมมันส์ได้ทุกเวลา จบครบในที่เดียว";

const announcementMessage =
  "FLASH789 สล็อตเว็บตรงมาแรง คัดมาเน้นๆ แต่เกมคุณภาพ แตกง่าย ลุ้นสนุกได้ทุกตา • ยกขบวนเกมสล็อตจากค่ายดังระดับโลกมาไว้ที่เดียว สายภาพสวยฟีลผจญภัย สายมินิมอล สายซื้อฟรีสปิน เลือกได้ครบทุกแนว • ระบบไวทุกคลิก เล่นลื่นทุกสปิน เข้าเล่นผ่านมือถือรุ่นไหนหรือคอมพิวเตอร์ก็รองรับหมด • อัปเดตเกมใหม่เข้ามาตลอดเวลา อะไรฮิตอะไรกำลังเป็นกระแสได้เล่นก่อนใคร • โบนัสคุ้ม โปรเด็ดตลอดวัน ทั้งโบนัสต้อนรับและโปรฝากตามช่วงเวลา ช่วยเพิ่มทุนให้ลุยต่อได้ยาวๆ";

const faqs = [
  {
    q: "FLASH789 มีเกมสล็อตจากค่ายไหนบ้าง เล่นแล้วเบื่อไหม",
    a: "ไม่ต้องกลัวเบื่อเพราะ FLASH789 ยกขบวนเกมสล็อตจากค่ายดังระดับโลกมาไว้ที่นี่ที่เดียว ไม่ว่าคุณจะเป็นสายชอบภาพสวยฟีลผจญภัย สายมินิมอล หรือสายซื้อฟรีสปิน ก็มีให้เลือกครบทุกแนว การันตีว่าเกมดีทุกตา โบนัสเข้าบ่อย เล่นเพลินจนลืมเวลาไปเลย",
  },
  {
    q: "เข้าเล่นผ่านมือถือรุ่นเก่าหรือคอมพิวเตอร์ ระบบจะกระตุกไหม",
    a: "ใครที่เคยหงุดหงิดกับเว็บค้างๆ หมุนแล้วกระตุก บอกเลยว่าปัญหานั้นจะหมดไป ระบบของเว็บถูกพัฒนามาให้ตอบสนองไวทุกคลิก ลื่นไหลทุกการสปิน ไม่ว่าจะเข้าเล่นผ่านมือถือรุ่นไหนหรือคอมพิวเตอร์ก็รองรับหมด เสถียรสุดๆ สัมผัสความสนุกได้แบบไม่มีสะดุดขัดจังหวะ",
  },
  {
    q: "มีเกมใหม่เข้ามาบ่อยแค่ไหน จะได้เล่นก่อนใครหรือเปล่า",
    a: "สายชอบลองของใหม่ต้องเลิฟ เพราะที่นี่ขนค่ายเกมดังๆ มาให้เล่นแบบจัดเต็มไม่มีกั๊ก แถมยังขยันอัปเดตเกมใหม่ๆ เข้ามาตลอดเวลา มีอะไรฮิต อะไรกำลังเป็นกระแส รับรองว่าได้เล่นก่อนใคร ให้คุณสนุกกับการค้นหาเกมโปรดใหม่ๆ ได้แบบไม่มีจุดอิ่มตัว",
  },
  {
    q: "โปรโมชันของ FLASH789 มีแบบไหนบ้าง คุ้มจริงหรือเปล่า",
    a: "เล่นทั้งทีก็ต้องเอาให้คุ้ม FLASH789 จัดโปรโมชันเด็ดๆ ไว้รอต้อนรับสมาชิกตลอดทั้งวัน ไม่ว่าจะเป็นโบนัสต้อนรับ หรือโปรฝากตามช่วงเวลา ก็ออกแบบมาเพื่อเพิ่มทุนให้คุณไปลุยต่อได้ยาวๆ ช่วยเพิ่มโอกาสในการทำกำไรให้ทุกการสปินของคุณน่าตื่นเต้นและคุ้มค่ายิ่งกว่าที่เคย",
  },
  {
    q: "ช่วงคนเล่นเยอะพร้อมกัน เว็บจะค้างตอนโบนัสกำลังจะเข้าไหม",
    a: "อารมณ์เสียที่สุดคือตอนโบนัสกำลังจะเข้าแล้วเว็บค้าง แต่ถ้าเล่นกับ FLASH789 สบายใจได้เลย เพราะเซิร์ฟเวอร์เขาแรงและเสถียรมาก ออกแบบมาเพื่อรองรับคนเล่นพร้อมกันเยอะๆ โดยเฉพาะ ฟีลลิงตอนกดสปินคือสมูทสุดๆ ตอบสนองไวทันใจ ให้คุณโฟกัสกับการทำกำไรได้แบบเต็มที่",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxCyberCut as="h1" title="FLASH789 สล็อตเว็บตรงมาแรง เกมดีทุกตา ระบบไวทุกคลิก โบนัสคุ้ม">
    <p class="text-left text-base leading-relaxed">
      ยุคนี้ถ้าจะหาเว็บปั่นสล็อตที่ตอบโจทย์แบบครบวงจร ต้องยกให้ FLASH789 สล็อตเว็บตรงที่กำลังมาแรงสุดๆ ในตอนนี้ เพราะที่นี่คัดมาเน้นๆ แต่เกมคุณภาพ แตกง่าย ลุ้นสนุกได้ทุกตา
      แถมระบบหลังบ้านยังอัปเกรดมาใหม่ กดปุ๊บมาปั๊บ ไวทุกคลิกไม่มีสะดุด ที่สำคัญคือโบนัสและโปรโมชันจัดเต็ม คุ้มค่าทุกยอดฝากแน่นอน
    </p>
  </ContentBoxCyberCut>

  <ContentBoxPremium as="h2" title="FLASH789 สล็อตเว็บตรงมาแรง พร้อมเกมดีทุกตาจากค่ายดังครบทุกแนว">
    <p class="text-left text-base leading-relaxed">
      ไม่ต้องกลัวเบื่อเพราะ FLASH789 ยกขบวนเกมสล็อตจากค่ายดังระดับโลกมาไว้ที่นี่ที่เดียว ไม่ว่าคุณจะเป็นสายชอบภาพสวยฟีลผจญภัย สายมินิมอล หรือสายซื้อฟรีสปิน ก็มีให้เลือกครบทุกแนว
      การันตีว่าเกมดีทุกตา โบนัสเข้าบ่อย เล่นเพลินจนลืมเวลาไปเลย
    </p>
  </ContentBoxPremium>

  <ProviderGrid />

  <ContentBoxNeumorphism as="h2" title="ระบบไวทุกคลิก เล่นลื่นทุกสปิน รองรับทุกการเข้าใช้งาน">
    <p class="text-left text-base leading-relaxed">
      ใครที่เคยหงุดหงิดกับเว็บค้างๆ หมุนแล้วกระตุก บอกเลยว่าปัญหานั้นจะหมดไป ระบบของเว็บถูกพัฒนามาให้ตอบสนองไวทุกคลิก ลื่นไหลทุกการสปิน ไม่ว่าจะเข้าเล่นผ่านมือถือรุ่นไหนหรือคอมพิวเตอร์ก็รองรับหมด
      เสถียรสุดๆ สัมผัสความสนุกได้แบบไม่มีสะดุดขัดจังหวะ
    </p>
  </ContentBoxNeumorphism>

  <LoginRtpSection />

  <ContentBoxSpecial as="h2" title="ค่ายดังมาเต็ม อัปเดตเกมใหม่ต่อเนื่อง ให้ความสนุกไม่เคยหยุด">
    <p slot="left" class="text-left text-base leading-relaxed">
      สายชอบลองของใหม่ต้องเลิฟ เพราะที่นี่ขนค่ายเกมดังๆ มาให้เล่นแบบจัดเต็มไม่มีกั๊ก แถมยังขยันอัปเดตเกมใหม่ๆ เข้ามาตลอดเวลา
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      มีอะไรฮิต อะไรกำลังเป็นกระแส รับรองว่าได้เล่นก่อนใคร ให้คุณสนุกกับการค้นหาเกมโปรดใหม่ๆ ได้แบบไม่มีจุดอิ่มตัว
    </p>
  </ContentBoxSpecial>

  <GameRankingBoard />

  <ContentBoxSevenThreeCyberCut titleright="โบนัสคุ้ม โปรเด็ดตลอดวัน FLASH789 เพิ่มโอกาสให้ทุกการเล่นน่าสนใจกว่าเดิม">
    <Picture
      slot="left"
      src={imgCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น FLASH789 คืนยอดเสีย รับเยอะ สูงสุด 5 เปอร์เซ็นต์ พร้อมข้อความเล่นเสียไม่ต้องกลัว ได้คืนยอดเสียแน่นอน และภาพเทพเจ้าจีนถือคทาทองยิ้มอยู่บนพื้นสีแดงดำประกายทอง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#ff2b2b]/30 shadow-[0_10px_30px_rgba(255,43,43,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      เล่นทั้งทีก็ต้องเอาให้คุ้ม FLASH789 จัดโปรโมชันเด็ดๆ ไว้รอต้อนรับสมาชิกตลอดทั้งวัน ไม่ว่าจะเป็นโบนัสต้อนรับ หรือโปรฝากตามช่วงเวลา ก็ออกแบบมาเพื่อเพิ่มทุนให้คุณไปลุยต่อได้ยาวๆ
      ช่วยเพิ่มโอกาสในการทำกำไรให้ทุกการสปินของคุณน่าตื่นเต้นและคุ้มค่ายิ่งกว่าที่เคย
    </p>
  </ContentBoxSevenThreeCyberCut>

  <SmoothCarousel />

  <ContentBoxSevenThreePremium title="ฟีลการเล่นไม่มีสะดุด เพราะระบบเสถียรและตอบสนองได้รวดเร็วที่ FLASH789">
    <Picture
      slot="left"
      src={imgDirectWeb}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์ FLASH789 เว็บตรง มั่นคง ปลอดภัย ไว้ใจได้เลย ฝาก-ถอน ไม่มีขั้นต่ำ พร้อมโลโก้สายฟ้าสีทอง หญิงสาวสองคนในชุดราตรีสีแดงและสีเทา และแถวโลโก้ค่ายเกมด้านล่างบนพื้นสีแดงดำ"
      class="mx-auto h-auto w-full rounded-2xl border border-[#ffc531]/30 shadow-[0_10px_30px_rgba(255,197,49,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      อารมณ์เสียที่สุดคือตอนโบนัสกำลังจะเข้าแล้วเว็บค้าง แต่ถ้าเล่นกับ FLASH789 สบายใจได้เลย เพราะเซิร์ฟเวอร์เขาแรงและเสถียรมาก ออกแบบมาเพื่อรองรับคนเล่นพร้อมกันเยอะๆ โดยเฉพาะ
      ฟีลลิงตอนกดสปินคือสมูทสุดๆ ตอบสนองไวทันใจ ให้คุณโฟกัสกับการทำกำไรได้แบบเต็มที่
    </p>
  </ContentBoxSevenThreePremium>

  <LatestWinners />

  <ContentBox as="h2" title="FLASH789 เว็บสล็อตที่รวมเกมคุณภาพ ระบบดี และโปรโมชันไว้ครบในที่เดียว">
    <p class="text-left text-base leading-relaxed">
      สรุปง่ายๆ เลยว่าถ้าอยากหาเว็บสล็อตที่จบในที่เดียว FLASH789 คือคำตอบ เพราะเขารวมทุกอย่างที่คุณต้องการไว้หมดแล้ว ทั้งเกมสล็อตคุณภาพคับแก้ว ระบบออโต้ที่รวดเร็วทันใจ
      และโปรโมชันที่แจกหนักแจกจริง ใครที่กำลังมองหาเว็บประจำที่เชื่อถือได้และเล่นสนุก บอกเลยว่าห้ามพลาดเด็ดขาด
    </p>
  </ContentBox>

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#ffc531] via-[#ff2b2b] to-[#c1121f] px-4 py-3 text-sm font-black whitespace-nowrap text-[#170506] shadow-[0_10px_30px_rgba(255,43,43,0.35)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,197,49,0.45)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#ff2b2b]/60 bg-[#170506]/85 px-4 py-3 text-sm font-black whitespace-nowrap text-[#ff2b2b] backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:border-[#ffc531] hover:bg-[#ffc531] hover:text-[#170506] hover:shadow-[0_15px_40px_rgba(255,197,49,0.4)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ FLASH789" faqs={faqs} />

  <Navfoot />
</MainLayout>
