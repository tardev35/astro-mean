---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBox3ThreeNeumorphism from "../components/ContentBox3ThreeNeumorphism.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinnersPremium from "../components/LatestWinnersPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq2 from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide1.png";
import imgAffiliate from "../assets/slide2.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxPremium as="h1"
//   2 → ContentBoxFloatingBadge as="h2"
//   3 → ContentBoxSevenThreeCyberCut as="h2" + slide1 แล้วต่อด้วย ProviderGrid
//       ซึ่งเป็นภาพประกอบของหัวข้อนี้โดยตรง (รวมค่ายชั้นนำไว้แค่ไหน)
//   4 → ContentBoxTwoCyberCut as="h2" (แบ่งย่อหน้าเดียวลง left/right)
//   5 → ContentBox3ThreeNeumorphism as="h2" (แบ่งลง left/center/right) แล้วต่อด้วย
//       GameRankingBoard ซึ่งเป็นภาพประกอบของหัวข้อนี้โดยตรง (หมวดเกมยอดนิยม)
//   6 → ContentBoxNeumorphism as="h2"
//   7 → ContentBoxSevenThreeNeumorphism as="h2" + slide2
//
// variant รอบนี้หมุนทั้งตระกูลจาก MONEY777 (CyberCut + TwoPremium + 3ThreePremium +
// Special + SevenThreePremium + TwoFloatingBadge + SevenThree) มาเป็น Premium +
// FloatingBadge + SevenThreeCyberCut + TwoCyberCut + 3ThreeNeumorphism +
// Neumorphism + SevenThreeNeumorphism ส่วน Navbar ย้ายจาก NavbarStyle9 มาเป็น
// NavbarPremium, Footer จาก FooterStyle2 มาเป็น FooterPremiumSumo, Announcement
// จาก Announcement5 มาเป็น AnnouncementPremium, LatestWinners จาก LatestWinners3
// มาเป็น LatestWinnersPremium และ Faq จาก Faq4 มาเป็น Faq2
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook — slide1 (คืนยอดเสีย 5% ทุกสัปดาห์
// มือถือโชว์โลโก้ PG SLOT ไพ่ ชิป เหรียญทอง) คู่กับหัวข้อข้อ 3 เรื่องค่ายเกมดังใน
// ล็อบบี้ และ slide2 (ลิงค์รับทรัพย์ สูงสุด 2.5 เปอร์เซนต์ ฟาโรห์อียิปต์กับตู้สล็อต)
// คู่กับหัวข้อข้อ 7 เรื่องระบบพร้อมให้เข้ามาทำกำไรได้ตลอด 24 ชั่วโมง
//
// slide3 (เสือแดง Fortune Tiger) กับ slide4 (มีโลโก้ UOK789 อยู่ในรูป) รวมถึง
// banner.png และ banner2/3/4 เป็นอาร์ตค้างของแบรนด์ก่อนๆ ทั้งชุด จึงห้าม import
// ที่นี่ทั้งสิ้น — รูปที่ import คือรูปที่ถูก emit ถึงจะไม่มีใคร render ก็ตาม ส่วน
// banner1 กับ banner1-mobile เป็น hero ที่ MainLayout จัดการเอง
//
// widget ที่ไม่ได้มาจาก docx (LatestWinnersPremium, LoginRtpSection,
// ReviewCardSumo2, SmoothCarousel, แถวปุ่ม login/register, FAQ) ใช้ป้ายเป็น
// <p>/<span> + aria-label บน <section> และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้าย
// ทั้งชุด ยกเว้น ProviderGrid กับ GameRankingBoard ที่เป็นภาพประกอบของหัวข้อ docx
// ข้อ 3 และ 5 โดยตรง จึงวางต่อท้ายบล็อกนั้นๆ ไม่มีตัวไหนคั่นระหว่างหัวข้อ docx
// สองข้อโดยไม่มีเหตุผล
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx พอดี ไม่มีตัวที่เจ็ด — หัว FAQ เป็น <p> ใน
// Faq2.astro (ชื่อ section ย้ายไป aria-label) คำถามใน Faq เป็น <span> ใน <summary>
// ไม่ใช่ h3 และป้ายคอลัมน์ของ SevenThreeCyberCut / TwoCyberCut /
// 3ThreeNeumorphism / SevenThreeNeumorphism เป็น <p> — docx รอบนี้แบน H1 + H2
// ล้วน หน้านี้จึงไม่มี h3 เลย
//
// title ใช้บรรทัด Title ของ docx ตรงๆ (65 ตัวอักษร) ส่วน description ใช้บรรทัด Des
// ของ docx โดยต่อหางประโยคสุดท้ายเป็น "ฝากถอนออโต้ไวทุกจังหวะ" ให้ยาว 158 ตัวอักษร
// — ข้อความดิบของ docx ต่ำกว่าเกท 150–160 ของ tools/verify-build.mjs ซึ่งจะทำให้
// build แดง ค่าที่ใช้ตรงกับ default ของ MainLayout เป๊ะ และเป็นสตริงเดียวกับที่
// ส่งเข้า pageGraph
const pageTitle = "PROFIT55 | คาสิโนออนไลน์ระดับโปร รวมค่ายชั้นนำ เว็บเดียวครบทุกฟีล";
const pageDescription =
  "PROFIT55 คาสิโนออนไลน์ระดับโปร รวมค่ายชั้นนำ เว็บเดียวครบทุกฟีล ตั้งแต่บาคาร่าไปจนถึงฟุตบอล เลือกเกมง่าย สลับโหมดคล่อง ระบบพร้อมตลอดวัน ฝากถอนออโต้ไวทุกจังหวะ";

// default message ของ Announcement ทุก variant คือสโลแกนของแบรนด์เก่าคนละเจ้ากัน
// จึงส่ง message ตรงๆ เสมอ ไม่พึ่ง default และห้ามขึ้นต้นด้วย emoji เพราะ marquee
// render ข้อความซ้ำและ emoji ที่ฝังในสตริงถูก mark aria-hidden ไม่ได้ — ข้อความชุดนี้
// ตรงกับ default ของ AnnouncementPremium เป๊ะ เพื่อให้ ticker ของหน้าย่อยที่เรียก
// <Announcement /> เปล่าๆ วิ่งข้อความเดียวกับหน้าแรก
const announcementMessage =
  "PROFIT55 คาสิโนออนไลน์ระดับโปร รวมค่ายชั้นนำ เว็บเดียวครบทุกฟีล • รวบรวมค่ายเกมชั้นนำทั่วโลกไว้ในแพลตฟอร์มเดียว ครบทั้งสายไพ่ สายปั่นสล็อต และสายแทงบอลจบในที่เดียว • เกมลิขสิทธิ์แท้ อัตราการจ่ายเงินรางวัลเป็นธรรม พร้อมโครงสร้างระบบหลังบ้านที่แน่นหนาและปลอดภัยในทุกมิติ • ล็อบบี้จัดหมวดหมู่ไว้เป็นระเบียบ ทั้งแยกตามค่ายเกม หมวดเกมยอดนิยม และคาสิโนสด หาเกมที่อยากเล่นเจอในไม่กี่คลิก • จบเกมบาคาร่าสดแล้วสลับไปเช็กราคาค่าน้ำและวางเดิมพันฟุตบอลคู่โปรดได้ทันทีภายในยูสเซอร์เดียว • ระบบกระเป๋าเงินเดียวใช้ได้ทุกหมวดเดิมพัน ไม่ต้องกดโยกเงินไปมาให้เสียเวลาหรือเสี่ยงยอดตกค้าง • เซิร์ฟเวอร์รองรับสมาชิกเข้าใช้งานพร้อมกันจำนวนมาก ฝากถอนออโต้ประมวลผลไวในไม่กี่วินาที เปิดให้เข้ามาทำกำไรได้ตลอด 24 ชั่วโมง";

// FAQ ห้าข้อเขียนจากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้าไหนมา
// ทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบคำถาม
// ที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq2> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน
const faqs = [
  {
    q: "PROFIT55 เหมาะกับสายเดิมพันแนวไหนบ้าง",
    a: "เหมาะกับทุกแนว เพราะที่นี่รวบรวมค่ายเกมชั้นนำทั่วโลกมาไว้ในแพลตฟอร์มเดียว ครบทั้งสายไพ่ที่ชอบบาคาร่าสดและคาสิโนสดสตรีมมิ่งความคมชัดสูง สายปั่นสล็อตที่มองหาเกมภาพสวยโบนัสแตกง่าย ไปจนถึงสายแทงบอลที่ต้องการเช็กราคาค่าน้ำก่อนวางเดิมพัน",
  },
  {
    q: "ต้องเปิดหลายยูสเซอร์หรือโยกเงินข้ามหมวดไหมถ้าอยากเล่นหลายแบบ",
    a: "ไม่ต้องเลย ทุกหมวดเดิมพันใช้ยูสเซอร์เดียวและกระเป๋าเงินเดียวร่วมกัน เงินทุนของคุณจึงพร้อมใช้งานได้ทุกหมวดทันที จบเกมบาคาร่าสดแล้วสลับไปวางเดิมพันฟุตบอลคู่โปรดได้เลย ไม่ต้องกดโยกเงินไปมาให้เสียเวลาหรือเสี่ยงต่อยอดเงินตกค้าง",
  },
  {
    q: "ล็อบบี้ของ PROFIT55 หาเกมที่อยากเล่นยากไหม",
    a: "หน้าการใช้งานถูกจัดหมวดหมู่ไว้อย่างเป็นระเบียบและสบายตา มีทั้งการแยกประเภทตามค่ายเกม หมวดเกมยอดนิยม และคาสิโนสด ช่วยลดเวลาในการไล่หาเกมลงไปมาก ผู้เล่นจึงเข้าถึงตัวเกมที่ต้องการได้อย่างรวดเร็วเพียงไม่กี่คลิก",
  },
  {
    q: "สลับจากคาสิโนไปหน้ากีฬาแล้วระบบค้างหรือกระตุกหรือเปล่า",
    a: "ระบบประมวลผลถูกปรับจูนให้มีความเสถียรสูง เมื่อกดสลับหน้าต่างจากคาสิโนสดไปยังตารางแข่งขันกีฬา ตัวเว็บจะตอบสนองและโหลดข้อมูลขึ้นมาอย่างฉับไว ไร้รอยต่อ ไม่มีอาการค้างหรือกระตุกมาตัดจังหวะการเล่น",
  },
  {
    q: "ช่วงบอลคู่ใหญ่หรือคนเข้าปั่นสล็อตพร้อมกันเยอะ ระบบยังไหวไหม และฝากถอนนานหรือเปล่า",
    a: "เซิร์ฟเวอร์ถูกออกแบบมาให้รองรับการเข้าใช้งานพร้อมกันของสมาชิกจำนวนมากได้สบาย ไม่ว่าจะเป็นช่วงบอลคู่ใหญ่หรือช่วงที่มีคนเข้าปั่นสล็อตสูงสุด ระบบก็ยังทำงานได้ราบรื่น ส่วนฝากถอนเป็นออโต้ประมวลผลไวในไม่กี่วินาที เปิดให้เข้ามาทำกำไรได้ตลอด 24 ชั่วโมง",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxPremium as="h1" title="PROFIT55 คาสิโนออนไลน์ระดับโปร รวมค่ายชั้นนำ เว็บเดียวครบทุกฟีล">
    <p class="text-left text-base leading-relaxed">
      หากคุณกำลังมองหาศูนย์รวมความบันเทิงที่ตอบโจทย์ความต้องการของสายเดิมพันทุกรูปแบบ PROFIT55 คือคำตอบที่ใช่ที่สุดในตอนนี้ ยกระดับการเล่นคาสิโนออนไลน์สู่มาตรฐานระดับโปรด้วยการรวบรวมค่ายเกมชั้นนำทั่วโลกมาไว้ในแพลตฟอร์มเดียว
      ไม่ว่าจะเป็นสายไพ่ สายปั่นสล็อต หรือสายแทงบอล ที่นี่พร้อมมอบสัมผัสการใช้งานที่ลื่นไหล เสถียร และปลอดภัยในทุกมิติ เปลี่ยนการเล่นคาสิโนแบบเดิมให้กลายเป็นความบันเทิงระดับพรีเมียมที่ทำกำไรได้จริงตลอดเวลา
    </p>
  </ContentBoxPremium>

  <ContentBoxFloatingBadge as="h2" title="PROFIT55 คาสิโนออนไลน์ระดับโปร มีอะไรครบจนสายเดิมพันหลายแนวมารวมกันได้">
    <p class="text-left text-base leading-relaxed">
      ปัจจัยหลักที่ทำให้เหล่านักเดิมพันตัวจริงต่างพากันปักหลักใช้งานที่ PROFIT55 คือความอุดมสมบูรณ์ของตัวเกมและระบบบริการที่ไม่เคยตัดทอนคุณภาพ ตัวเว็บถูกออกแบบมาเพื่อรองรับผู้เล่นหลากหลายกลุ่ม
      ไม่ว่าจะเป็นผู้เล่นสายเน้นจังหวะความเร็ว หรือผู้เล่นสายวิเคราะห์เชิงกลยุทธ์ ทุกคนจะได้สัมผัสกับเกมลิขสิทธิ์แท้ที่มีอัตราการจ่ายเงินรางวัลเป็นธรรม พร้อมโครงสร้างระบบหลังบ้านที่แน่นหนา
      ทำให้ที่นี่กลายเป็นจุดหมายปลายทางที่รวมสายเดิมพันทุกแนวไว้ได้อย่างลงตัว
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxSevenThreeCyberCut as="h2" title="รวมค่ายชั้นนำไว้แค่ไหน? เปิด PROFIT55 แล้วเจอเกมดังหลายสไตล์ในที่เดียว" titleleft="คืนยอดเสีย 5% ทุกสัปดาห์">
    <Picture
      slot="left"
      src={imgCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 767px) 92vw, 340px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่นของ PROFIT55 พื้นทองไล่เฉด ด้านซ้ายเป็นมือถือที่เปิดหน้าจอโลโก้ PG SLOT สีแดง ถัดมาเป็นตัวการ์ตูนคาวบอยสวมหมวกปีกกว้างและผ้าพันคอแดง ตรงกลางเป็นวงล้อสีดำทองพร้อมไพ่โพดำและดอกจิก ล้อมด้วยกองเหรียญทอง ด้านบนมีโลโก้ PROFIT55 และด้านขวาเขียนตัวหนังสือขาวขอบทองว่า คืนยอดเสีย 5% ทุกสัปดาห์"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e3ac22]/40 shadow-[0_10px_30px_rgba(227,172,34,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      พอก้าวเข้าสู่ล็อบบี้ของ PROFIT55 คุณจะได้พบกับอาณาจักรความบันเทิงที่ไร้ขีดจำกัด ตัวเว็บจับมือกับค่ายเกมยักษ์ใหญ่ระดับโลกเพื่อนำเสนอเกมตัวตึงแบบจัดเต็ม ตั้งแต่สล็อตภาพสวยโบนัสแตกง่าย
      คาสิโนสดสตรีมมิ่งความคมชัดสูง ไปจนถึงเกมสไตล์ใหม่ๆ ที่กำลังเป็นกระแส คุณสามารถค้นหาและเลือกเล่นเกมฮิตจากทุกค่ายดังได้ทันทีโดยไม่ต้องเสียเวลาตามหาจากหลายๆ เว็บให้ยุ่งยาก
    </p>
