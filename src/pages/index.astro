---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBox3ThreeFloatingBadge from "../components/ContentBox3ThreeFloatingBadge.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBox from "../components/ContentBox.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgTrueWallet from "../assets/slide2.png";
import imgRankOne from "../assets/slide3.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxPremium as="h1"
//   2 → ContentBoxSpecial as="h2" (แบ่งย่อหน้าเดียวลง left/right ที่รอยต่อประโยค)
//   3 → ContentBoxSevenThreePremium as="h2" + slide2 (เว็บตรง ทรูวอเลท 24 ชม.)
//   4 → ContentBox3ThreeFloatingBadge as="h2" (แบ่งย่อหน้าเดียวลง left/center/right)
//   5 → ContentBoxTwoPremium as="h2" (แบ่งย่อหน้าเดียวลง left/right)
//   6 → ContentBoxSevenThree as="h2" + slide3 (อันดับ 1 ในทุกๆ เรื่องของการเดิมพัน)
//   7 → ContentBox as="h2" (การ์ดกลางที่ terms/privacy ใช้ร่วม)
//
// variant รอบนี้เปลี่ยนทั้งตระกูลจากแบรนด์ก่อนหน้า (MAHAHENG333 ใช้ CyberCut +
// Neumorphism + plain) มาเป็นทรง Premium + Special + FloatingBadge +
// SevenThree(plain) + plain ส่วน Faq ย้ายจาก Faq2 มาเป็น Faq3, Announcement จาก 3
// มาเป็น 5, LatestWinners จาก 3 มาเป็น Premium และ ProviderGrid จาก
// ProviderGridPremium มาเป็นตัวธรรมดา
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook — slide2 (เว็บตรง ไม่ผ่านเอเย่นต์
// ทรูวอเลท บริการ 24 ชม.) คู่กับหัวข้อระบบตรง API แท้ และ slide3 (อันดับ 1
// ในทุกๆ เรื่องของการเดิมพัน ฝาก-ถอนออโต้ จ่ายตรงทุกยอด) คู่กับหัวข้อระบบหลังบ้าน
// ส่วน slide4.png เป็นอาร์ตค้างของ MAHAHENG333 จึงไม่ถูก import ที่ไหนอีกแล้ว
// เช่นเดียวกับ banner.png และ banner2/3/4 ที่เป็นอาร์ตค้างของแบรนด์ก่อนๆ — รูปที่
// import คือรูปที่ถูก emit ถึงจะไม่มีใคร render ก็ตาม
//
// banner1 เป็น hero ที่ MainLayout จัดการเอง รอบนี้จึงไม่มีรูปประกอบใน ContentBox
// เดี่ยว
//
// widget ที่ไม่ได้มาจาก docx (ProviderGrid, GameRankingBoard, LatestWinners,
// LoginRtpSection, ReviewCardSumo2, SmoothCarousel, แถวปุ่ม login/register) ใช้
// ป้ายเป็น <p>/<span> + aria-label บน <section> จึงวางต่อท้ายหัวข้อ docx ที่มัน
// สังกัดได้โดยลำดับ h2 ไม่เพี้ยน — ProviderGrid ต่อจากหัวข้อกริดเกมอินเตอร์,
// GameRankingBoard ต่อจากหัวข้อโบนัสแตกบ่อยและฟีเจอร์เด่น, LatestWinners ต่อจาก
// หัวข้อระบบหลังบ้าน แล้วปิดท้ายด้วย LoginRtpSection + ReviewCardSumo2 +
// SmoothCarousel + แถวปุ่ม + FAQ
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx + หัวข้อ FAQ ที่หน้านี้เขียนเอง = 7
// คำถามใน Faq3 เป็น <span> ใน <summary> ไม่ใช่ h3 และ titleleft/titlecenter/
// titleright ของ ContentBox3ThreeFloatingBadge กับ titleleft/titleright ของ
// ContentBoxTwoPremium เป็น <p> — docx รอบนี้แบน H1+H2 ล้วน หน้านี้จึงไม่มี h3 เลย
const pageTitle = "MONACO89 | สล็อตพรีเมียมเบอร์ 1 ระบบตรง API แท้ โบนัสแตกบ่อย";
// บรรทัด Des ของ docx ยาว 147 ตัวอักษร ต่ำกว่าเกท 150–160 ของ verify-build อยู่ 3
// ตัว จึงขยายวรรคปิดท้ายจาก "พร้อมบริการดูแลตลอดวัน" เป็น "พร้อมทีมงานบริการดูแล
// ตลอดทั้งวัน" (157 ตัวอักษร) — ใจความเดิมของ brief ไม่เปลี่ยน
const pageDescription =
  "MONACO89 สล็อตพรีเมียมเบอร์ 1 ระบบตรง API แท้ โบนัสแตกบ่อย ยกเกมดังระดับอินเตอร์มาไว้หน้าเดียว ไม่ล็อกยูส ระบบหลังบ้านเสถียร พร้อมทีมงานบริการดูแลตลอดทั้งวัน";

// default message ของ Announcement ทุก variant คือสโลแกนของแบรนด์เก่าคนละเจ้ากัน
// จึงส่ง message ตรงๆ เสมอ ไม่พึ่ง default และห้ามขึ้นต้นด้วย emoji
const announcementMessage =
  "MONACO89 สล็อตพรีเมียมเบอร์ 1 ระบบตรง API แท้ โบนัสแตกบ่อย • ยกกริดเกมสล็อตอินเตอร์ตัวดังจากค่ายใหญ่ทั่วโลกมาไว้ในหน้าเดียว ล็อบบี้จัดวางเป็นระเบียบ ค้นหาเกมโปรดแล้วเข้าเล่นได้ทันทีไม่ต้องไล่หาทีละเว็บ • ระบบตรง API แท้ส่งสัญญาณตรงจากเซิร์ฟเวอร์หลักของค่ายเกม ไม่ผ่านเอเย่นต์หรือคนกลาง ทุกจังหวะการหมุนสปินจึงลื่นไหลและเที่ยงตรง • โบนัสแตกบ่อยด้วยตัวคูณเงินรางวัลแบบทวีคูณ สัญลักษณ์พิเศษที่เข้าโหมดฟรีสปินได้ง่ายขึ้น และฟีเจอร์สุ่มแจกรางวัลใหญ่ • ไม่ล็อกยูสเซอร์ เล่นได้กำไรมากแค่ไหนหรือเปลี่ยนสไตล์การเดิมพันบ่อยเท่าใด ก็ไม่มีการปรับลดอัตราการชนะ • ระบบหลังบ้านเสถียรตั้งแต่เข้าสู่ระบบที่รวดเร็ว สลับค่ายเกมแบบไร้รอยต่อ ไปจนถึงฝากถอนอัตโนมัติที่จัดการยอดได้แม่นยำ • ทีมงานมืออาชีพดูแลและซัพพอร์ตสมาชิกตลอด 24 ชั่วโมง";

// FAQ ห้าข้อเขียนจากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้าไหนมา
// ทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบคำถาม
// ที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน
const faqs = [
  {
    q: "MONACO89 มีเกมสล็อตค่ายไหนให้เลือกเล่นบ้าง",
    a: "ที่นี่รวบรวมกริดเกมสล็อตอินเตอร์ตัวดังจากค่ายใหญ่ทั่วโลกมาไว้ในหน้าเดียว ทั้งแนวแฟนตาซีสุดตระการตา แนวคลาสสิก และเกมยอดฮิตติดเทรนด์ การจัดวางหน้าล็อบบี้ทำได้เป็นระเบียบสวยงาม จึงค้นหาเกมโปรดและกดเข้าเล่นได้ทันทีโดยไม่ต้องเสียเวลาไล่หาทีละเว็บ",
  },
  {
    q: "ระบบตรง API แท้ของ MONACO89 ต่างจากเว็บที่ผ่านเอเย่นต์อย่างไร",
    a: "ระบบตรง API แท้ส่งสัญญาณโดยตรงจากเซิร์ฟเวอร์หลักของค่ายเกม ไร้การผ่านเอเย่นต์หรือคนกลางใดๆ ทุกจังหวะการหมุนสปินจึงลื่นไหล เที่ยงตรง และไม่มีการดัดแปลงโปรแกรม หมดกังวลเรื่องระบบกระตุก เกมหลุด หรือการประมวลผลที่ล่าช้า",
  },
  {
    q: "ฟีเจอร์อะไรบ้างที่ทำให้โบนัสแตกบ่อยขึ้นในแต่ละรอบ",
    a: "ตัวเกมอัดแน่นไปด้วยฟีเจอร์ที่เพิ่มโอกาสการแตกของโบนัสอยู่ตลอดเวลา ทั้งตัวคูณเงินรางวัลแบบทวีคูณ สัญลักษณ์พิเศษที่ช่วยให้เข้าโหมดฟรีสปินได้ง่ายขึ้น และฟีเจอร์สุ่มแจกรางวัลใหญ่ ทำให้ทุกรอบการปั่นมีความหมายและเพิ่มความคุ้มค่าให้ทุกยอดเบท",
  },
  {
    q: "เล่นได้กำไรเยอะแล้วจะโดนล็อกยูสหรือปรับอัตราการชนะไหม",
    a: "ไม่มีทั้งสองอย่าง MONACO89 ใช้นโยบายไม่ล็อกยูสเซอร์ ปล่อยให้ทุกการเล่นเป็นไปอย่างโปร่งใสตามดวงและกลยุทธ์ของผู้เล่นจริงๆ ไม่ว่าจะทำกำไรได้มากแค่ไหนหรือเปลี่ยนสไตล์การเดิมพันบ่อยเท่าใด ก็ไม่มีการปรับลดอัตราการชนะหรือสร้างเงื่อนไขจุกจิกมากวนใจ",
  },
  {
    q: "ถ้าติดปัญหาระหว่างเล่นหรืออยากสอบถามโปรโมชัน ติดต่อได้ตอนไหน",
    a: "มีทีมงานมืออาชีพคอยดูแลและซัพพอร์ตสมาชิกตลอด 24 ชั่วโมง ไม่ว่าจะติดขัดปัญหาเรื่องการใช้งาน มีข้อสงสัยเกี่ยวกับโปรโมชัน หรืออยากได้คำแนะนำเพิ่มเติม ก็สอบถามได้ทันที บริการด้วยความรวดเร็วและเป็นกันเองทุกช่องทาง",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxPremium as="h1" title="MONACO89 สล็อตพรีเมียมเบอร์ 1 ระบบตรง API แท้ โบนัสแตกบ่อย">
    <p class="text-left text-base leading-relaxed">
      หากคุณกำลังมองหาประสบการณ์การเล่นสล็อตระดับพรีเมียมที่สมบูรณ์แบบที่สุด นาทีนี้ต้องยกให้ MONACO89 เว็บสล็อตที่ตอบโจทย์ความต้องการของนักสปินยุคใหม่ได้อย่างครอบคลุม
      ด้วยการเชื่อมต่อระบบตรง API แท้จากต่างประเทศ ให้คุณมั่นใจได้ในเรื่องความเสถียร ความปลอดภัย และความเที่ยงตรงของอัตราการจ่ายรางวัล โบนัสแตกบ่อย แจกหนักทุกช่วงเวลา
      พร้อมนำเสนอตัวเลือกเกมสล็อตชั้นนำมารวบรวมไว้ในที่เดียว ปั่นเพลิน ลื่นไหล ทำกำไรเข้ากระเป๋าได้แบบไม่มีสะดุด
    </p>
  </ContentBoxPremium>

  <ContentBoxSpecial as="h2" title="MONACO89 สล็อตพรีเมียมยอดนิยม เปิดกริดเกมอินเตอร์ตัวดังไว้ครบหน้าเดียว">
    <p slot="left" class="text-left text-base leading-relaxed">
      ก้าวเข้าสู่อาณาจักรความบันเทิงระดับสากลกับ MONACO89 ที่ได้ทำการรวบรวมกริดเกมสล็อตอินเตอร์ตัวดังจากค่ายใหญ่ทั่วโลกมาไว้ในหน้าเดียว ไม่ว่าคุณจะชอบเกมสไตล์ไหน
      ทั้งแนวแฟนตาซีสุดตระการตา แนวคลาสสิก หรือเกมยอดฮิตติดเทรนด์ ที่นี่ก็มีพร้อมเสิร์ฟให้สัมผัสกันแบบจัดเต็ม
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      การจัดวางหน้าล็อบบี้ทำได้อย่างเป็นระเบียบสวยงาม ช่วยให้ค้นหาเกมโปรดและเข้าเล่นได้ทันทีแบบไม่ต้องเสียเวลาไล่หาทีละเว็บ
    </p>
  </ContentBoxSpecial>

  <ProviderGrid />

  <ContentBoxSevenThreePremium as="h2" title="ระบบตรง API แท้ เบื้องหลังความเสถียรที่ทำให้ MONACO89 พร้อมทุกจังหวะ">
    <Picture
      slot="left"
      src={imgTrueWallet}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 767px) 92vw, 382px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น MONACO89 พื้นทองสว่างมีวิวตึกยามค่ำคืนอยู่ด้านหลัง มุมบนซ้ายเป็นโลโก้ MONACO89 ตัวอักษรทอง ข้อความตัวใหญ่เขียนว่า เว็บตรง ไม่ผ่านเอเย่นต์ ไม่มีขั้นต่ำ ทรูวอเลท บริการ 24 ชม. และบรรทัดล่างว่า บอล หวย มวย เกม คาสิโน ด้านขวาเป็นมาสคอตวัวกระทิงทองคำใส่แว่นกันแดดยิ้มกว้าง รายล้อมด้วยเหรียญทองจำนวนมาก แถบล่างสุดเขียนว่า รองรับฝาก-ถอน ทุกธนาคารและทรูวอลเล็ต พร้อมโลโก้ TrueMoney Wallet และธนาคารต่างๆ คู่ปุ่ม App Store กับ Google Play"
      class="mx-auto h-auto w-full rounded-2xl border border-[#ef8f22]/40 shadow-[0_10px_30px_rgba(239,143,34,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      เบื้องหลังความสำเร็จและความน่าเชื่อถือของ MONACO89 คือการใช้ระบบตรง API แท้ที่ส่งสัญญาณโดยตรงจากเซิร์ฟเวอร์หลักของค่ายเกม ไร้การผ่านเอเย่นต์หรือคนกลางใดๆ
      ทำให้ทุกจังหวะการหมุนสปินมีความลื่นไหล เที่ยงตรง และไม่มีการดัดแปลงโปรแกรม การันตีความเสถียรขั้นสุดที่จะทำให้คุณลงเดิมพันได้อย่างสบายใจ หมดกังวลเรื่องระบบกระตุก เกมหลุด
      หรือการประมวลผลที่ล่าช้าไปได้เลย
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBox3ThreeFloatingBadge
    as="h2"
    title="โบนัสแตกบ่อย ฟีเจอร์เด่นของเกมดังที่เพิ่มอะไรให้แต่ละรอบน่าตามขึ้น?"
    titleleft="ฟีเจอร์อัดแน่นทุกเกม"
    titlecenter="ตัวคูณและฟรีสปิน"
    titleright="คุ้มค่าทุกยอดเบท">
    <p slot="left" class="text-left text-base leading-relaxed">
      ความตื่นเต้นในการเล่นสล็อตที่ MONACO89 ไม่ได้มีอยู่แค่การหมุนธรรมดา แต่ตัวเกมยังอัดแน่นไปด้วยฟีเจอร์เด็ดๆ ที่คอยเพิ่มโอกาสการแตกของโบนัสอยู่ตลอดเวลา
    </p>
    <p slot="center" class="text-left text-base leading-relaxed">
      ไม่ว่าจะเป็นตัวคูณเงินรางวัลแบบทวีคูณ สัญลักษณ์พิเศษที่เข้าโหมดฟรีสปินได้ง่ายขึ้น หรือฟีเจอร์สุ่มแจกรางวัลใหญ่
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
