---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinners2.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgAutoTransfer from "../assets/slide2.png";
import imgLiveCasino from "../assets/slide1.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxPremium as="h1"
//   2 → ContentBoxFloatingBadge as="h2"
//   3 → ContentBoxSevenThreePremium as="h2" + slide2 (โบนัสฝากประจำครบ 7 วัน)
//   4 → ContentBoxTwoPremium as="h2" (แบ่งย่อหน้าเดียวลง left/right ที่รอยต่อประโยค)
//   5 → ContentBoxSevenThreeFloatingBadge as="h2" + slide1 (คืนยอดเสียสูงสุด 5%)
//   6 → ContentBoxSpecial as="h2" (สองครึ่งที่มีไอคอนนำ ส่งหนึ่ง element ต่อ slot)
//   7 → ContentBox3ThreePremium as="h2" (แบ่งย่อหน้าลง left/center/right)
//
// variant รอบนี้เปลี่ยนทั้งตระกูลจากแบรนด์ก่อนหน้า (SGD88 ใช้ CyberCut +
// Neumorphism) มาเป็น Premium + FloatingBadge + Special
//
// SevenThree ใช้สองบล็อกพอดี ซึ่งเป็นเพดานของ playbook — slide2 คู่กับหัวข้อระบบ
// ตรงโอนไว (แบนเนอร์เขียนว่า "โบนัสมาแล้ว ฝากประจำครบ 7 วัน" อยู่ข้างเครื่องสล็อต
// เป็นภาพฝั่งการเงิน/ฝากถอนของชุดนี้) และ slide1 คู่กับหัวข้อโต๊ะสด (แบนเนอร์เป็น
// หญิงสาวถือไพ่โพดำข้างวงล้อรูเล็ตและชิป ซึ่งเป็นภาพโต๊ะคาสิโนของชุดนี้)
// ส่วน slide4 เป็นของ SmoothCarousel และ slide3 อยู่หน้า /promotion จึงไม่ถูก
// import ที่นี่ ไม่ให้รูปใบเดียวกันโผล่สองที่ในหน้าเดียว
//
// banner1 เป็น hero ที่ MainLayout จัดการเอง ส่วน banner2/3/4 เป็นอาร์ตค้างของ
// แบรนด์เก่า (mtime 08-04) จึงไม่ถูก import ที่ไหน รอบนี้จึงไม่มีรูปประกอบใน
// ContentBox เดี่ยว
//
// widget ที่ไม่ได้มาจาก docx (ProviderGrid, GameRankingBoard, LoginRtpSection,
// SmoothCarousel, LatestWinners, ReviewCardSumo2, แถวปุ่ม login/register) ใช้ป้าย
// เป็น <p>/<span> + aria-label บน <section> จึงวางต่อท้ายหัวข้อ docx ที่มันสังกัด
// ได้โดยลำดับ h2 ไม่เพี้ยน — ProviderGrid ต่อจากหัวข้อล็อบบี้เกมดัง,
// GameRankingBoard ต่อจากหัวข้อโต๊ะสด, LoginRtpSection ต่อจากหัวข้อเมนูใช้ง่าย,
// SmoothCarousel กับ LatestWinners ต่อจากหัวข้อสรุป, ReviewCardSumo2 ปิดท้าย
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx + หัวข้อ FAQ ที่หน้านี้เขียนเอง = 7
// คำถามใน Faq4 เป็น <span> ใน <summary> ไม่ใช่ h3 — docx รอบนี้แบน H1+H2 ล้วน
// หน้านี้จึงไม่มี h3 เลย

// Title มาจาก docx ตรงตัว ส่วน Des ของ docx ยาว 141 ตัวอักษร ซึ่งต่ำกว่าเพดานล่าง
// 150 ที่ verify-build บังคับ จึงต่อท้ายด้วย "จบครบในเว็บเดียว" เป็น 158
const pageTitle = "MACAUBET | สล็อตฟอร์มใหญ่ ฟีลมาเก๊ามาไว้หน้าสปิน ระบบตรงโอนไว";
const pageDescription = "MACAUBET สล็อตฟอร์มใหญ่ ยกฟีลมาเก๊ามาไว้หน้าสปิน ระบบตรงโอนไวออโต้ภายใน 3 วิ เกมดังมีครบ โต๊ะสดมีพร้อม เมนูใช้ง่าย การันตีเล่นง่ายได้กำไรจริง จบครบในเว็บเดียว";

// default message ของ Announcement ทุก variant คือสโลแกนของแบรนด์เก่าคนละเจ้ากัน
// จึงส่ง message ตรงๆ เสมอ ไม่พึ่ง default และห้ามขึ้นต้นด้วย emoji
const announcementMessage =
  "MACAUBET สล็อตฟอร์มใหญ่ ฟีลมาเก๊ามาไว้หน้าสปิน ระบบตรงโอนไว • ดีไซน์หน้าเกมและบรรยากาศให้หรูหราสมจริง เหมือนนั่งกดสปินอยู่ในคาสิโนชื่อดังที่มาเก๊า • ระบบตรงออโต้ระดับไฮสปีด ฝากถอนไวภายใน 3 วินาที ไม่ต้องส่งสลิป ไม่ต้องรอแอดมินอนุมัติ • ล็อบบี้รวมสล็อตตัวฮิตจากทุกค่ายดัง คัดเฉพาะเกมคุณภาพสูงที่จ่ายสมน้ำสมเนื้อ • โต๊ะคาสิโนสดถ่ายทอดสดคมชัดระดับ HD ดีลเลอร์มืออาชีพยิงตรงตลอด 24 ชั่วโมง • สลับจากหน้าสปินไปลุ้นไพ่ได้ทันทีโดยไม่ต้องเปลี่ยนยูสเซอร์ • เมนูจัดวางเป็นระเบียบ ตัดขั้นตอนซับซ้อนออก มือใหม่ก็เข้าถึงทุกฟังก์ชันได้ตั้งแต่ครั้งแรก";

// FAQ ห้าข้อเขียนจากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้าไหนมา
// ทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบคำถาม
// ที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน
const faqs = [
  {
    q: "MACAUBET ต่างจากเว็บสล็อตทั่วไปตรงไหน ทำไมถึงเรียกว่าฟีลมาเก๊า",
    a: "ต่างกันที่บรรยากาศตั้งแต่คลิกแรก หน้าเกมของ MACAUBET ถูกดีไซน์ให้หรูหราและสมจริงเหมือนนั่งกดสปินอยู่ในคาสิโนชื่อดังที่มาเก๊า ทั้งงานภาพ แสง สี เสียง และจังหวะการออกรางวัลถูกยกระดับให้มีฟีลลิ่งเหนือกว่าเว็บทั่วไป จึงได้ความหรูหราตระการตาแบบคาสิโนระดับโลกโดยไม่ต้องเสียเวลาเดินทางไปถึงที่",
  },
  {
    q: "ฝากถอนกับ MACAUBET ใช้เวลานานแค่ไหน ต้องส่งสลิปหรือทักแอดมินไหม",
    a: "ไม่ต้องส่งสลิปและไม่ต้องรอแอดมินอนุมัติ เพราะที่นี่ใช้ระบบตรงออโต้ระดับไฮสปีดที่ไม่ผ่านคนกลาง ทำรายการฝากถอนเสร็จภายใน 3 วินาทีเท่านั้น ต่อให้เป็นช่วงเวลาที่ผู้เล่นแน่นหนาแค่ไหน เงินก็เข้าบัญชีตรงเป๊ะแบบไม่ต้องรอนาน จัดการเรื่องการเงินจบแล้วลุยต่อได้ทันทีไม่มีติดขัด",
  },
  {
    q: "ในล็อบบี้ของ MACAUBET มีเกมแนวไหนบ้าง เล่นไปนานๆ จะเจอเกมซ้ำไหม",
    a: "ล็อบบี้รวบรวมสล็อตตัวฮิตจากทุกค่ายดังไว้เยอะที่สุด มีทั้งเกมในกระแส เกมแตกหนัก และเกมคลาสสิกที่ทุกคนชื่นชอบ โดยคัดสรรเฉพาะตัวเกมคุณภาพสูงที่มีอัตราการจ่ายสมน้ำสมเนื้อมาให้เลือกเล่นแบบจุใจ อยากเปลี่ยนสไตล์การเล่นตอนไหนก็เลือกได้ทันที ไม่มีคำว่าจำเจหรือขาดช่วง",
  },
  {
    q: "อยากสลับจากปั่นสล็อตไปลงโต๊ะสด ต้องเปลี่ยนยูสเซอร์หรือสมัครใหม่หรือเปล่า",
    a: "ไม่ต้องเปลี่ยนยูสเซอร์และไม่ต้องสมัครเพิ่ม MACAUBET จัดเต็มด้วยคาสิโนโต๊ะสดถ่ายทอดสดแบบเรียลไทม์คมชัดระดับ HD ให้สลับอารมณ์จากการกดสปินไปลุ้นไพ่หรือเปิดโต๊ะเดิมพันอื่นได้ในทันที มีดีลเลอร์มืออาชีพยิงตรงให้ตลอด 24 ชั่วโมง จึงเติมความสนุกได้หลากหลายในบัญชีเดียว",
  },
  {
    q: "มือใหม่ที่ไม่เคยเล่นมาก่อน จะหาเกมและใช้งานเมนูของ MACAUBET ยากไหม",
    a: "ไม่ยากเลย เพราะระบบเน้นความเรียบง่ายและใช้งานได้จริง เมนูต่างๆ ถูกจัดวางอย่างเป็นระเบียบและตัดขั้นตอนที่ซับซ้อนออกทั้งหมด จึงค้นหาเกมโปรด เลือกค่ายที่ต้องการ หรือเข้าถึงโหมดบริการต่างๆ ได้อย่างรวดเร็ว ไม่ว่าจะเป็นมือใหม่หรือผู้เล่นระดับเก๋าก็เข้าถึงทุกฟังก์ชันได้ตั้งแต่ครั้งแรก",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxPremium as="h1" title="MACAUBET สล็อตฟอร์มใหญ่ ฟีลมาเก๊ามาไว้หน้าสปิน ระบบตรงโอนไว">
    <p class="text-left text-base leading-relaxed">
      ถ้าคุณอยากสัมผัสบรรยากาศความหรูหราตระการตาแบบคาสิโนระดับโลก แต่ไม่อยากเสียเวลาเดินทาง บอกเลยว่าต้องมาลอง MACAUBET เว็บสล็อตฟอร์มใหญ่ที่ยกความมันส์แบบมาเก๊ามาเสิร์ฟให้ถึงหน้าจอ
      ขนความบันเทิงระดับพรีเมียมมาแบบอัดแน่น พร้อมระบบการทำงานตรงที่ไม่ผ่านคนกลาง จัดเต็มความเร็วเรื่องการโอนไวให้คุณลุ้นโบนัสได้อย่างมั่นใจทุกวินาที ใครที่กำลังมองหาเว็บปั่นสล็อตที่ได้ทั้งอารมณ์
      ได้ทั้งความชัวร์ ที่นี่คือจุดหมายที่ไม่ควรมองข้าม
    </p>
  </ContentBoxPremium>

  <ContentBoxFloatingBadge as="h2" title="MACAUBET สล็อตฟอร์มใหญ่ ยกบรรยากาศมาเก๊ามาไว้หน้าสปินให้ทุกเกมมีฟีลมากกว่าเดิม">
    <p class="text-left text-base leading-relaxed">
      สัมผัสความยิ่งใหญ่ตั้งแต่คลิกแรกที่เข้าใช้งาน MACAUBET ได้ดีไซน์หน้าเกมและบรรยากาศให้มีความหรูหรา สมจริง เหมือนคุณกำลังนั่งกดสปินอยู่ในคาสิโนชื่อดังที่มาเก๊า ไม่ว่าจะเป็นงานภาพ แสง สี เสียง
      หรือจังหวะการออกรางวัล ทุกอย่างถูกยกระดับให้มีฟีลลิ่งเหนือกว่าเว็บทั่วไป ปั่นเพลิน เพิ่มความตื่นเต้นตื่นตาตื่นใจให้ทุกการหมุนกลายเป็นเรื่องน่าลุ้นตลอดเวลา
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxSevenThreePremium as="h2" title="ระบบตรงโอนไวออโต้ภายใน 3 วิ จุดเด่นของ MACAUBET ที่ทำให้ทุกขั้นตอนคล่องตัว">
    <Picture
      slot="left"
      src={imgAutoTransfer}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น MACAUBET ข้อความ โบนัสมาแล้ว ฝากประจำครบ 7 วัน รับเครดิตฟรีไปเลย ภาพหญิงสาวสวมชุดสูทสีเขียวยิ้มพร้อมชูการ์ด FREE CREDIT อยู่ข้างเครื่องสล็อตเรืองแสงสีเขียวนีออนบนพื้นสีเขียวเข้ม"
      class="mx-auto h-auto w-full rounded-2xl border border-[#59cb13]/35 shadow-[0_10px_30px_rgba(89,203,19,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      เรื่องความเร็วต้องยกให้เป็นไฮไลต์หลัก เพราะ MACAUBET ใช้ระบบตรงออโต้ระดับไฮสปีด ทำรายการฝากถอนไวแบบทันใจภายใน 3 วินาทีเท่านั้น ไม่ว่าจะเป็นช่วงเวลาที่ผู้เล่นแน่นหนาแค่ไหน
      เงินก็เข้าบัญชีตรงเป๊ะแบบไม่ต้องรอนาน หมดปัญหาการส่งสลิปหรือรอแอดมินอนุมัติ เพิ่มความสะดวกสบายให้คุณจัดการเรื่องการเงินได้อย่างคล่องตัว ลุยต่อได้ทันทีไม่มีติดขัด
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxTwoPremium as="h2" title="เกมดังมีครบแค่ไหน? เปิดล็อบบี้เจอทั้งสล็อตตัวฮิตและค่ายยอดนิยมให้เลือกเต็มที่">
    <p slot="left" class="text-left text-base leading-relaxed">
      แค่เปิดเข้ามาในหน้าล็อบบี้ของ MACAUBET คุณจะพบกับอาณาจักรเกมสล็อตที่รวบรวมตัวฮิตจากทุกค่ายดังไว้เยอะที่สุด ไม่ว่าจะเป็นเกมในกระแส เกมแตกหนัก หรือเกมคลาสสิกที่ทุกคนชื่นชอบ
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      ที่นี่คัดสรรเฉพาะตัวเกมคุณภาพสูงที่มีอัตราการจ่ายสมน้ำสมเนื้อมาให้เลือกเล่นกันแบบจุใจ อยากเปลี่ยนสไตล์การเล่นตอนไหนก็เลือกได้ทันที ไม่มีคำว่าจำเจหรือขาดช่วงแน่นอน
    </p>
  </ContentBoxTwoPremium>

  <ProviderGrid />

  <ContentBoxSevenThreeFloatingBadge as="h2" title="MACAUBET โต๊ะสดมีพร้อม เติมฟีลคาสิโนเรียลไทม์ให้สลับจากหน้าสปินได้ทันที">
    <Picture
      slot="left"
      src={imgLiveCasino}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น MACAUBET ข้อความ สล็อตเว็บตรง เว็บลิขสิทธิ์แท้ คืนยอดเสียสูงสุด 5 % ภาพหญิงสาวสวมชุดเดรสเลื่อมสีเขียวถือไพ่โพดำเรียงเป็นพัด ข้างวงล้อรูเล็ตและชิปคาสิโนสีเขียวสลับขาวบนพื้นสีเขียวเข้ม"
