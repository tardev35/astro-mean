---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinnersPremium from "../components/LatestWinnersPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Faq4 from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgInviteFriend from "../assets/slide4.png";
import imgCashback from "../assets/slide3.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxPremium as="h1" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   2 → ContentBoxFloatingBadge as="h2" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   3 → ContentBoxSpecial as="h2" (ย่อหน้าเดียวแบ่งสองครึ่งตามลำดับประโยคเดิม:
//       ความน่าเชื่อถือกับโครงสร้างแพลตฟอร์มที่ป้องกันการล็อคยูสเซอร์ → การเก็บ
//       ข้อมูลส่วนตัวและประวัติธุรกรรมเป็นความลับ) แล้วต่อด้วย ProviderGridPremium
//       ซึ่งกางค่ายลิขสิทธิ์แท้ที่ส่งตรงจากเซิร์ฟเวอร์หลัก อันเป็นรูปธรรมของหัวข้อ
//       ความน่าเชื่อถือข้อเดียวกัน
//   4 → ContentBoxTwoPremium as="h2" (ย่อหน้าเดียวแบ่งสองครึ่ง: เลิกส่งสลิป/ระบบ AI
//       ประมวลผลไม่กี่วินาที → ฝากดึกถอนเช้าตรู่ก็ไม่สะดุด) แล้วต่อด้วย
//       FeatureHighlights ซึ่งกางสี่จุดย่อยของระบบออโต้ที่ย่อหน้านี้ระบุไว้ตรงๆ →
//       h3 สี่ตัว ซึ่งเป็น h3 ชุดเดียวที่ได้รับอนุญาตบนหน้านี้ คำอธิบายเขียนขยาย
//       ความใหม่ ไม่ได้ก๊อบประโยคด้านบนซ้ำ
//   5 → ContentBox3ThreePremium as="h2" (ย่อหน้าเดียวแบ่งลงสามคอลัมน์ตามลำดับ
//       ประโยคเดิม: ทุนหลักสิบหรือหลักหมื่นลุ้นเท่ากัน → บริหารเงินทุนเองได้อิสระ
//       ผ่านเงื่อนไขไม่มีขั้นต่ำ → ฝาก 1 บาทหรือถอนยอดเล็กก็ทำเองได้ทันที)
//   6 → ContentBoxSevenThreePremium as="h2" + slide4 (อาร์ตสไลด์เขียนว่า "ชวนเพื่อน
//       รับทันที 20% จากยอดเสียเพื่อน" — สิทธิ์ที่มีให้เฉพาะสมาชิกที่ปักหลักเล่นยาว
//       ตรงกับย่อหน้าเรื่องเซียนพนันที่เลือกทำกำไรต่อเนื่องกับที่นี่)
//   7 → ContentBoxSevenThreeFloatingBadge as="h2" + slide3 (อาร์ตสไลด์เขียนว่า
//       "คืนยอดเสีย รับเครดิตคืนสูงสุด 10% ทุกวัน เล่นได้ ไม่ต้องกลัวเสีย" ตรงกับ
//       ย่อหน้าเรื่องการโอนจ่ายจริงทุกบิลโดยไม่หักเปอร์เซ็นต์)
//
// variant รอบนี้หมุนออกจากชุดของแบรนด์ก่อนทั้งตระกูล: ทรง ContentBox เปลี่ยนจากชุด
// CyberCut ×3 + Neumorphism ×3 + TwoNeumorphism มาเป็น Premium ×3 (เดี่ยว/สอง
// คอลัมน์/เจ็ดสาม) + FloatingBadge ×2 (เดี่ยว + เจ็ดสาม) + Special ×1 +
// 3ThreePremium ×1 ส่วน Announcement เป็น Announcement3, LatestWinners เป็น
// LatestWinnersPremium, ProviderGrid เป็น ProviderGridPremium, ReviewCard เป็น
// ReviewCardSumo2 และ Faq เป็น Faq4 — Navbar/Footer/ฟอนต์ ถูกสลับไว้แล้วใน
// MainLayout กับ brandProfile หน้านี้จึงไม่ใช้ ContentBox ตัวธรรมดาเลยรอบนี้
// (มันยังถูกใช้อยู่ที่ terms/privacy)
//
// ContentBoxSevenThree* ทั้งสองตัวปล่อยหัวข้อจาก prop `title` ตัวเดียว ส่วน
// titleleft เป็นป้ายคอลัมน์รูปที่ยังเป็น <p> — ห้ามส่ง titleright เข้าไป เพราะจะเพิ่ม
// ป้ายซ้อนใต้หัวข้อเดียวกัน
//
// Announcement ส่ง message ตรงๆ เสมอ เพราะ default ของทุก variant ในตระกูลนี้เป็น
// สโลแกนของแบรนด์เก่าคนละเจ้ากัน ข้อความชุดนี้ตรงตัวต่อตัวกับ default ของ
// Announcement3.astro เพื่อให้ ticker ของหน้าย่อยที่เรียก <Announcement /> เปล่าๆ
// วิ่งข้อความเดียวกับหน้าแรก และห้ามขึ้นต้นด้วย emoji เพราะ marquee render ข้อความ
// ซ้ำและ emoji ที่ฝังในสตริงถูก mark aria-hidden ไม่ได้
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook คู่กับ slide4/slide3 ซึ่งเป็นสไลด์ที่
// อาร์ตตรงกับหัวข้อ docx ข้อ 6 กับข้อ 7 พอดี — slide1 (สมาชิกใหม่ รับโบนัสเพิ่ม
// 100%) กับ slide2 (ฝากติดต่อกัน 7 วัน รับเครดิตฟรี 100 บาท) เป็นโปรสำหรับสมาชิก
// ใหม่/สายฝากประจำ ซึ่งไม่มีหัวข้อ docx ไหนรองรับ และเพดาน SevenThree เต็มแล้ว จึง
// ปล่อยไว้ให้หน้า /promotion ใช้ ส่วนไฟล์ banner ทุกตัว (ทั้งตัวที่มีเลขต่อท้ายและ
// ตัวมือถือ) ห้าม import ที่นี่หรือที่ไหนก็ตาม เพราะรูปที่ import คือรูปที่ถูก emit
// ลง dist/ ถึงจะไม่มีใคร render ก็ตาม — banner1 เป็นของ MainLayout จัดการเอง และ
// รูปในหน้านี้ไม่มีตัวไหนใส่ loading="eager"/fetchpriority="high" เพราะ LCP เป็นของ
// hero ใน MainLayout
//
// widget ที่ไม่ได้มาจาก docx (SmoothCarousel, GameRankingBoard, LatestWinnersPremium,
// LoginRtpSection, ReviewCardSumo2, แถวปุ่ม login/register, FAQ, Navfoot) ใช้ป้าย
// เป็น <p>/<span> + aria-label บน <section> และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้าย
// ทั้งชุด ยกเว้นสองตัวที่เป็นภาพประกอบของหัวข้อ docx หนึ่งข้อโดยตรง
// (ProviderGridPremium → ข้อ 3, FeatureHighlights → ข้อ 4) ซึ่งวางต่อท้ายบล็อกนั้นๆ
//
// h1 ×1 + h2 ×6 = หัวข้อ docx พอดี บวก h3 ×4 จาก FeatureHighlights ซึ่งเป็นรายการ
// ย่อยของหัวข้อข้อ 4 ตามข้อยกเว้นเดียวที่ playbook อนุญาต — หัว FAQ เป็น <p> ใน
// Faq4.astro คำถามเป็น <span> ใน <summary> และป้ายคอลัมน์ของทุก ContentBox variant
// เป็น <p>
//
// title กับ description ใช้บรรทัดที่ brief ให้มาตรงๆ ทั้งคู่ ห้ามเติมหรือตัด และเป็น
// สตริงเดียวกับที่ส่งเข้า pageGraph และ MainLayout
const pageTitle = "CK1968 สล็อตเว็บตรง แบรนด์แท้ 100% ปลอดภัย จ่ายจริง ไม่มีขั้นต่ำ";
const pageDescription = "CK1968 สล็อตเว็บตรง แบรนด์แท้ 100% ที่นักปั่นไว้วางใจ หมดปัญหาโดนโกง! การันตีความปลอดภัย เล่นได้เท่าไหร่เราจ่ายจริง ระบบออโต้ ฝากถอนไม่มีขั้นต่ำ";

const announcementMessage =
  "CK1968 สล็อตเว็บตรง แบรนด์แท้ 100% ปลอดภัย จ่ายจริง ไม่มีขั้นต่ำ • ผู้ให้บริการลิขสิทธิ์แท้ที่ส่งตรงเกมจากค่ายดังทั่วโลกมาให้สัมผัสด้วยตัวเอง การันตีทุกการสปินโปร่งใสยุติธรรม พร้อมระบบซัพพอร์ตที่ยอดเยี่ยมที่สุดในตอนนี้ • นำเข้าระบบ API แท้จากเซิร์ฟเวอร์หลักของค่ายเกมโดยตรง อัตราการแตก RTP เป็นมาตรฐานสากลจริง ไม่มีการแอบปรับลดเปอร์เซ็นต์การชนะ เล่นลื่นไหลไม่กระตุกไม่หลุดออกจากเกมในจังหวะเข้าฟรีสปิน • วางโครงสร้างแพลตฟอร์มด้วยระบบรักษาความปลอดภัยระดับสูง ข้อมูลส่วนตัวและประวัติการทำธุรกรรมของสมาชิกถูกเก็บเป็นความลับทั้งหมด ไม่มีการล็อคยูสเซอร์เมื่อเล่นได้กำไรก้อนโต • ระบบ AI จัดการธุรกรรมการเงินแบบอัตโนมัติเต็มรูปแบบ กดทำรายการแล้วยอดเงินเข้ากระเป๋าภายในเวลาไม่กี่วินาที จะฝากตอนดึกหรือถอนช่วงเช้าตรู่ก็ลื่นไหลไม่มีสะดุด • ฝากถอนไม่มีขั้นต่ำ ทุนหลักสิบหรือหลักหมื่นก็ร่วมลุ้นรางวัลใหญ่ได้เท่าเทียมกัน อยากฝาก 1 บาทเพื่อปั่นเล่นขำๆ หรือถอนยอดเล็กๆ ออกไปใช้ก่อน ก็ทำรายการเองได้ทันทีโดยไม่มีเงื่อนไขผูกมัด • เกมที่นี่แตกง่ายจริงตามสถิติ มีฟีเจอร์ตัวเกมใหม่ๆ อัปเดตให้เล่นก่อนใคร ระบบหลังบ้านเสถียรสูงมาก รองรับผู้ใช้งานพร้อมกันนับหมื่นคนได้โดยที่เว็บไม่อืด • ชนะเท่าไหร่โอนจ่ายจริงเต็มจำนวนทุกบาททุกสตางค์ ไม่มีการหักค่าธรรมเนียม ไม่มีการแบ่งจ่ายเป็นงวดๆ และไม่ต้องทำเทิร์นโอเวอร์ซ้ำซ้อนให้วุ่นวาย";

// FAQ ห้าข้อเขียนขึ้นใหม่จากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้า
// ไหนมาทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบ
// คำถามที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq4> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน — ห้ามปล่อยให้
// Faq4 ใช้ค่า default ของตัวเอง เพราะ default ของทุก variant ในตระกูลนี้เป็นคำถาม
// ของแบรนด์เก่า
const faqs = [
  {
    q: "CK1968 เป็นเว็บตรงจริงไหม ต่างจากเว็บเอเย่นต์ตรงไหน",
    a: "CK1968 เป็นผู้ให้บริการลิขสิทธิ์แท้ที่ส่งตรงเกมจากค่ายดังทั่วโลกมาให้ผู้เล่นสัมผัสด้วยตัวเอง และนำเข้าระบบ API แท้จากเซิร์ฟเวอร์หลักของค่ายเกมโดยตรง จึงต่างจากเว็บเอเย่นต์ที่ปรับอัตราการชนะหรือฝากถอนล่าช้า อัตราการแตก RTP ที่นี่เป็นมาตรฐานสากลจริง ไม่มีการแอบปรับลดเปอร์เซ็นต์การชนะระหว่างทาง",
  },
  {
    q: "เล่นได้กำไรก้อนโตแล้วจะโดนล็อคยูสเซอร์ไหม",
    a: "ไม่มีการล็อคยูสเซอร์เมื่อสมาชิกเล่นได้กำไรก้อนโต เพราะแพลตฟอร์มถูกวางโครงสร้างด้วยระบบรักษาความปลอดภัยระดับสูงตั้งแต่ต้น ข้อมูลส่วนตัวและประวัติการทำธุรกรรมของสมาชิกทั้งหมดถูกเก็บเป็นความลับ ผู้เล่นจึงโฟกัสกับการปั่นสล็อตได้เต็มที่โดยไม่ต้องระแวงเรื่องตุกติกใดๆ",
  },
  {
    q: "ฝากถอนต้องส่งสลิปให้แอดมินตรวจไหม ใช้เวลานานแค่ไหน",
    a: "ไม่ต้องส่งสลิปและไม่ต้องรอแอดมินตรวจ เพราะที่นี่พัฒนาระบบ AI สำหรับจัดการธุรกรรมการเงินแบบอัตโนมัติเต็มรูปแบบ ทุกครั้งที่กดทำรายการ ระบบจะประมวลผลยอดเงินให้เข้ากระเป๋าภายในเวลาไม่กี่วินาที ไม่ว่าจะฝากเข้าเล่นตอนดึกหรือถอนเงินช่วงเช้าตรู่ก็ลื่นไหลไม่มีสะดุด",
  },
  {
    q: "ต้องมีทุนขั้นต่ำเท่าไหร่ถึงจะเล่นและถอนได้",
    a: "ไม่มีข้อจำกัดขั้นต่ำทั้งการฝากและการถอน จะมีทุนหลักสิบหรือหลักหมื่นก็ร่วมสนุกและลุ้นรางวัลใหญ่ได้เท่าเทียมกัน อยากฝากแค่ 1 บาทเพื่อปั่นสล็อตเล่นขำๆ หรืออยากถอนเงินยอดเล็กๆ ออกไปใช้ก่อน ก็ทำรายการได้ด้วยตัวเองทันทีโดยไม่มีเงื่อนไขผูกมัด",
  },
  {
    q: "ถ้าแจ็คพอตแตกหลักล้าน จะได้เงินเต็มจำนวนหรือถูกหักเปอร์เซ็นต์",
    a: "ได้เต็มจำนวนทุกบาททุกสตางค์ ไม่ว่าจะแจ็คพอตแตกหลักหมื่น หลักแสน หรือทะลุถึงหลักล้าน เพราะที่นี่มีทุนสำรองมหาศาลพร้อมโอนจ่าย ไม่มีการหักค่าธรรมเนียม ไม่มีการแบ่งจ่ายเป็นงวดๆ และไม่ต้องทำเทิร์นโอเวอร์ซ้ำซ้อนให้วุ่นวาย ชนะปุ๊บรับเงินเข้าบัญชีไปเลย",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxPremium as="h1" title="CK1968 สล็อตเว็บตรง แบรนด์แท้ 100% ที่นักปั่นไว้วางใจ">
    <p class="text-left text-base leading-relaxed">
