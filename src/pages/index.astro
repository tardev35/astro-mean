---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBox3ThreeCyberCut from "../components/ContentBox3ThreeCyberCut.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgWelcomeBonus from "../assets/slide1.png";
import imgDailyCashback from "../assets/slide2.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxCyberCut as="h1"
//   2 → ContentBoxSevenThreeCyberCut as="h2" + slide1 (สมัครใหม่ รับ 50%)
//   3 → ContentBoxNeumorphism as="h2"
//   4 → ContentBoxTwoNeumorphism as="h2" (แบ่งย่อหน้าเดียวลง left/right ที่รอย
//       ต่อประโยค)
//   5 → ContentBox3ThreeCyberCut as="h2" (แบ่งย่อหน้าลง left/center/right)
//   6 → ContentBoxSevenThreeNeumorphism as="h2" + slide2 (คืนยอดเสีย 5% ทุกวัน)
//   7 → ContentBox as="h2"
//
// variant รอบนี้เปลี่ยนทั้งตระกูลจากแบรนด์ก่อนหน้า (249UP ใช้ Premium +
// FloatingBadge + Special + plain) มาเป็น CyberCut + Neumorphism + plain
//
// SevenThree ใช้สองบล็อกพอดี ซึ่งเป็นเพดานของ playbook — slide1 คู่กับหัวข้อ
// "เปิดโหมดความมันส์ไวตั้งแต่คลิกแรก" (รูปพิมพ์ว่าสมัครสมาชิกใหม่ รับ 50%) และ
// slide2 คู่กับหัวข้อโบนัส (รูปพิมพ์ว่าคืนยอดเสีย 5% รับได้ทุกวัน) ส่วน slide3
// เป็นของ SmoothCarousel จึงไม่ถูก import ที่นี่ ไม่ให้รูปใบเดียวกันโผล่สองที่ใน
// หน้าเดียว ส่วน slide4.png เป็นอาร์ตค้างของแบรนด์เก่า (mtime 2026-08-12) ไม่ถูก
// import ที่ไหนทั้งสิ้น
//
// banner1/banner1-mobile เป็น hero ที่ MainLayout จัดการเอง ส่วน banner.png กับ
// banner2/3/4 เป็นอาร์ตของแบรนด์เก่า (mtime 2026-08-04) จึงไม่ถูก import ที่ไหน
// รอบนี้จึงไม่มีรูปประกอบใน ContentBox เดี่ยว
//
// widget ที่ไม่ได้มาจาก docx (SmoothCarousel, ProviderGrid, GameRankingBoard,
// LoginRtpSection, LatestWinners, ReviewCardSumo2, แถวปุ่ม login/register) ใช้
// ป้ายเป็น <p>/<span> + aria-label บน <section> จึงวางต่อท้ายหัวข้อ docx ที่มัน
// สังกัดได้โดยลำดับ h2 ไม่เพี้ยน
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx + หัวข้อ FAQ ที่หน้านี้เขียนเอง = 7
// คำถามใน Faq4 เป็น <span> ใน <summary> ไม่ใช่ h3 ตามที่ variant นั้น ship มา

// Title/Des มาจาก docx ตรงตัว แล้วต่อท้ายให้อยู่ในช่วง 150–160 ตัวอักษรที่
// verify-build บังคับ (ตัว Des ของ docx เองยาว 142 ตัวอักษร)
const pageTitle = "FAST369 | เว็บสล็อตสปีดเกมไหล ระบบเร็วแรงถึงใจ โบนัสพร้อมบวก";
const pageDescription =
  "FAST369 เว็บสล็อตสปีดเกมไหล ระบบเร็วแรงถึงใจ โบนัสพร้อมบวก เกมตัวตึงลงครบ ล็อบบี้แน่น ฟีเจอร์มีของ เข้าไวสลับไว พร้อมต่อความมันส์แบบไม่ติดเบรก โหลดไวไม่มีสะดุด";

// default message ของ Announcement ทุก variant คือสโลแกนของแบรนด์เก่าคนละเจ้ากัน
// จึงส่ง message ตรงๆ เสมอ ไม่พึ่ง default และห้ามขึ้นต้นด้วย emoji
const announcementMessage =
  "FAST369 เว็บสล็อตสปีดเกมไหล ระบบเร็วแรงถึงใจ โบนัสพร้อมบวก • เปิดโหมดความมันส์ไวตั้งแต่คลิกแรก โหลดหน้าเกมสมูธ ไม่ต้องรอนานจนหมดอารมณ์ • เกมตัวตึงลงครบ ล็อบบี้แน่น คัดมาแล้วว่าแจกจริง ภาพสวย เอฟเฟกต์อลังการ • เข้าไวสลับไว เปลี่ยนค่ายได้ทันฟีลโดยไม่ต้องกดออกหลายขั้นตอน • ฟีเจอร์มีของทั้งตัวคูณสะสม สัญลักษณ์พิเศษ และโหมดฟรีสปินที่ออกบ่อยจนน่าตกใจ • โบนัสพร้อมบวก เติมทุนให้ตลอด มีกิจกรรมและโปรเด็ดๆ รอกดรับ • พร้อมต่อความมันส์แบบไม่ติดเบรก เกม ระบบ และล็อบบี้เดินหน้าไปพร้อมกัน";

const faqs = [
  {
    q: "FAST369 เข้าเล่นแล้วระบบไวจริงไหม ต้องรอโหลดนานหรือเปล่า",
    a: "ก้าวแรกที่กดเข้า FAST369 คุณจะได้สัมผัสกับสปีดการตอบสนองที่ฉับไวแบบทันที ไม่ต้องรอนานจนหมดอารมณ์ ตัวระบบถูกออกแบบให้โหลดหน้าเกมและองค์ประกอบต่างๆ ได้อย่างสมูธ ช่วยให้ผู้เล่นเข้าถึงโหมดความมันส์ได้ทันทีที่ใจต้องการ ปั่นสนุก ไร้รอยต่อ ตอบโจทย์คนที่อยากเล่นเกมแล้วได้ความสะใจแบบไม่ต้องมีอะไรมาขัดจังหวะ",
  },
  {
    q: "ล็อบบี้ของ FAST369 มีเกมตัวตึงให้เลือกครบแค่ไหน",
    a: "รวมเอาตัวตึงระดับท็อปจากทุกค่ายดังมาปักหลักไว้ในที่เดียว FAST369 จัดเต็มล็อบบี้แน่นๆ ด้วยเกมคุณภาพสูงที่ผ่านการคัดสรรมาแล้วว่าแจกจริง ภาพสวย และเอฟเฟกต์อลังการ ไม่ว่าจะชอบเล่นแนวไหน สไตล์ไหน ก็มีตัวเลือกเด็ดๆ คอยสลับมาให้เล่นกันอย่างไม่ขาดสาย เปิดเข้ามาเมื่อไหร่ก็เจอแต่เกมตึงๆ น่าลองกดสปินทั้งนั้น",
  },
  {
    q: "อยากสลับค่ายเปลี่ยนเกมกลางรอบ ต้องกดออกหลายขั้นตอนไหม",
    a: "ไฮไลต์เด็ดที่ทำให้หลายคนติดใจ FAST369 คือความคล่องตัวในการสลับเปลี่ยนค่ายเกม ไม่ต้องกดออกหลายขั้นตอนหรือรอรีโหลดนานๆ อยากเปลี่ยนบรรยากาศไปลุ้นเกมค่ายอื่นก็ทำได้ในทันที จังหวะกำลังมา ฟีลกำลังได้ ก็จัดต่อได้ทันทีโดยไม่เสีย mood การปั่นที่ต่อเนื่องแบบนี้แหละที่ช่วยเพิ่มโอกาสทำแจ็คพอตแตกได้ดียิ่งขึ้น",
  },
  {
    q: "ฟีเจอร์ในเกมของ FAST369 มีอะไรช่วยเพิ่มจังหวะลุ้นบ้าง",
    a: "นอกจากความไวของระบบแล้ว เกมใน FAST369 ยังอุดมไปด้วยฟีเจอร์เด็ดที่พร้อมระเบิดรางวัลให้ผู้เล่น ไม่ว่าจะเป็นตัวคูณสะสม สัญลักษณ์พิเศษที่ช่วยเข้าฟีเจอร์ง่ายขึ้น หรือโหมดฟรีสปินที่ออกบ่อยจนน่าตกใจ ทำให้การหมุนทุกครั้งไม่ใช่แค่การรอลุ้นรอบปกติ แต่เต็มไปด้วยลูกเล่นที่ช่วยซัพพอร์ตให้ลุ้นกำไรก้อนใหญ่ได้สนุกกว่าเดิม",
  },
  {
    q: "โบนัสและโปรโมชันของ FAST369 มีเติมให้ต่อเนื่องแค่ไหน",
    a: "สายล่าโปรต้องเลิฟ เพราะ FAST369 จัดเตรียมสิทธิประโยชน์และโบนัสพิเศษไว้เติมทุนให้ผู้เล่นอยู่ตลอดเวลา มีกิจกรรมและโปรเด็ดๆ พร้อมบวกเพิ่มเข้าไปในยูสเซอร์ ให้คุณมีทุนเอาไปหมุนต่อยอดได้ยาวขึ้น เพิ่มความคุ้มค่าให้ทุกจังหวะการปั่นมีเรื่องน่าลุ้นและน่าติดตามอยู่เสมอแบบไม่มีคำว่าเกลือ",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxCyberCut as="h1" title="FAST369 เว็บสล็อตสปีดเกมไหล ระบบเร็วแรงถึงใจ โบนัสพร้อมบวก">
    <p class="text-left text-base leading-relaxed">
      ถ้าคุณเป็นสายสปินที่ชอบความสะใจ ไม่ชอบนั่งรออะไรนานๆ FAST369 คือคำตอบที่ใช่ที่สุด การันตีเรื่องความสปีดของระบบที่รวดเร็ว ลื่นไหล จังหวะปั่นเกมต่อกันได้อย่างสมบูรณ์แบบ
      ไม่ว่าจะเข้าเล่นช่วงเวลาไหนก็สปีดแรงไม่มีตก ควบคู่ไปกับอัตราการจ่ายและโบนัสที่พร้อมบวกเพิ่มความคุ้มค่าให้ทุกยอดปั่น ลืมความงก ความช้า หรือหน้าเว็บกระตุกไปได้เลย
      เพราะที่นี่ถูกรีดประสิทธิภาพมาเพื่อความมันส์แบบทะลุขีดจำกัดโดยเฉพาะ
    </p>
  </ContentBoxCyberCut>

  <SmoothCarousel />

  <ContentBoxSevenThreeCyberCut as="h2" title="FAST369 เว็บสล็อตสปีดเกมไหล เปิดโหมดความมันส์ไวตั้งแต่คลิกแรก">
    <Picture
      slot="left"
      src={imgWelcomeBonus}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 500]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น FAST369 ข้อความ สมัครสมาชิกใหม่ รับ 50% สูงสุดถึง 500 บาท ภาพหญิงสาวชุดแดงถือไพ่ยืนคู่กับมังกรทองและกองเหรียญทอง บนพื้นแดงประกายทอง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#ffc531]/35 shadow-[0_10px_30px_rgba(255,197,49,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      ก้าวแรกที่กดเข้า FAST369 คุณจะได้สัมผัสกับสปีดการตอบสนองที่ฉับไวแบบทันที ไม่ต้องรอนานจนหมดอารมณ์ ตัวระบบถูกออกแบบให้โหลดหน้าเกมและองค์ประกอบต่างๆ ได้อย่างสมูธ
      ช่วยให้ผู้เล่นเข้าถึงโหมดความมันส์ได้ทันทีที่ใจต้องการ ปั่นสนุก ไร้รอยต่อ ตอบโจทย์คนที่อยากเล่นเกมแล้วได้ความสะใจแบบไม่ต้องมีอะไรมาขัดจังหวะ
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxNeumorphism as="h2" title="เกมตัวตึงลงครบ ล็อบบี้แน่นแบบ FAST369 เปิดมาทีไรก็มีตัวน่าเล่นรออยู่">
    <p class="text-left text-base leading-relaxed">
      รวมเอาตัวตึงระดับท็อปจากทุกค่ายดังมาปักหลักไว้ในที่เดียว FAST369 จัดเต็มล็อบบี้แน่นๆ ด้วยเกมคุณภาพสูงที่ผ่านการคัดสรรมาแล้วว่าแจกจริง ภาพสวย และเอฟเฟกต์อลังการ
      ไม่ว่าจะชอบเล่นแนวไหน สไตล์ไหน ก็มีตัวเลือกเด็ดๆ คอยสลับมาให้เล่นกันอย่างไม่ขาดสาย เปิดเข้ามาเมื่อไหร่ก็เจอแต่เกมตึงๆ น่าลองกดสปินทั้งนั้น
    </p>
  </ContentBoxNeumorphism>

  <ProviderGrid />

  <ContentBoxTwoNeumorphism as="h2" title="ระบบเร็วแรงถึงใจ เข้าไวสลับไว เปลี่ยนค่ายได้ทันฟีลโดยไม่เสียจังหวะ">
    <p slot="left" class="text-left text-base leading-relaxed">
      ไฮไลต์เด็ดที่ทำให้หลายคนติดใจ FAST369 คือความคล่องตัวในการสลับเปลี่ยนค่ายเกม ไม่ต้องกดออกหลายขั้นตอนหรือรอรีโหลดนานๆ อยากเปลี่ยนบรรยากาศไปลุ้นเกมค่ายอื่นก็ทำได้ในทันที
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      จังหวะกำลังมา ฟีลกำลังได้ ก็จัดต่อได้ทันทีโดยไม่เสีย mood การปั่นที่ต่อเนื่องแบบนี้แหละที่ช่วยเพิ่มโอกาสทำแจ็คพอตแตกได้ดียิ่งขึ้น
    </p>
  </ContentBoxTwoNeumorphism>

  <LoginRtpSection />

  <ContentBox3ThreeCyberCut as="h2" title="ฟีเจอร์มีของใน FAST369 แต่ละเกมซ่อนลูกเล่นเด็ดให้ตามมากกว่าแค่การหมุน">
    <p slot="left" class="text-left text-base leading-relaxed">นอกจากความไวของระบบแล้ว เกมใน FAST369 ยังอุดมไปด้วยฟีเจอร์เด็ดที่พร้อมระเบิดรางวัลให้ผู้เล่น</p>
    <p slot="center" class="text-left text-base leading-relaxed">ไม่ว่าจะเป็นตัวคูณสะสม สัญลักษณ์พิเศษที่ช่วยเข้าฟีเจอร์ง่ายขึ้น หรือโหมดฟรีสปินที่ออกบ่อยจนน่าตกใจ</p>
    <p slot="right" class="text-left text-base leading-relaxed">ทำให้การหมุนทุกครั้งไม่ใช่แค่การรอลุ้นรอบปกติ แต่เต็มไปด้วยลูกเล่นที่ช่วยซัพพอร์ตให้ลุ้นกำไรก้อนใหญ่ได้สนุกกว่าเดิม</p>
  </ContentBox3ThreeCyberCut>

  <GameRankingBoard />

  <ContentBoxSevenThreeNeumorphism as="h2" title="โบนัสพร้อมบวก เติมความคุ้มให้ทุกช่วงการเล่นมีอะไรใหม่ให้น่าจับตา">
    <Picture
      slot="left"
      src={imgDailyCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 500]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น FAST369 ข้อความ คืนยอดเสีย 5% รับได้ทุกวัน ถอนได้สูงสุด 20 เท่า ภาพหญิงสาวชุดแดงประดับเลื่อม ลูกเต๋าแดงคู่ ไพ่ ชิปคาสิโน และวงล้อ บนพื้นแดงประกายทอง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#ffc531]/35 shadow-[0_10px_30px_rgba(255,197,49,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      สายล่าโปรต้องเลิฟ เพราะ FAST369 จัดเตรียมสิทธิประโยชน์และโบนัสพิเศษไว้เติมทุนให้ผู้เล่นอยู่ตลอดเวลา มีกิจกรรมและโปรเด็ดๆ พร้อมบวกเพิ่มเข้าไปในยูสเซอร์
