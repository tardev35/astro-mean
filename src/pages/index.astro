---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgBaccarat from "../assets/slide4.png";
import imgAutoTransfer from "../assets/slide3.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxPremium as="h1"
//   2 → ContentBoxFloatingBadge as="h2"
//   3 → ContentBoxSevenThreePremium as="h2" + slide4 (แทงบาคาร่า)
//   4 → ContentBoxTwoPremium as="h2" (แบ่งย่อหน้าเดียวลง left/right ที่รอยต่อประโยค)
//   5 → ContentBox3ThreePremium as="h2" (แบ่งย่อหน้าลง left/center/right)
//   6 → ContentBoxSevenThreeFloatingBadge as="h2" + slide3 (ฝากถอน AUTO 10 วินาที)
//   7 → ContentBoxSpecial as="h2" (แบ่งย่อหน้าลงสองครึ่ง หนึ่ง element ต่อ slot)
//
// variant รอบนี้เปลี่ยนทั้งตระกูลจากแบรนด์ก่อนหน้า (FAST369 ใช้ CyberCut +
// Neumorphism + plain) มาเป็น Premium + FloatingBadge + Special
//
// SevenThree ใช้สองบล็อกพอดี ซึ่งเป็นเพดานของ playbook — slide4 คู่กับหัวข้อ
// "รวมสล็อต คาสิโนสด และบาคาร่า" (รูปพิมพ์ว่าแทงบาคาร่า สูงสุดไม้ละ 200,000) และ
// slide3 คู่กับหัวข้อฝากถอน (รูปพิมพ์ว่าฝากถอนรวดเร็วทันใจ ระบบ AUTO ภายใน 10
// วินาที) ส่วน slide2 เป็นของ SmoothCarousel จึงไม่ถูก import ที่นี่ ไม่ให้รูปใบ
// เดียวกันโผล่สองที่ในหน้าเดียว และ slide1 เป็นต้นทางของ og.png เท่านั้น
//
// banner1/banner1-mobile เป็น hero ที่ MainLayout จัดการเอง ส่วน banner.png กับ
// banner2/3/4 เป็นอาร์ตค้างของแบรนด์เก่า จึงไม่ถูก import ที่ไหน รอบนี้จึงไม่มี
// รูปประกอบใน ContentBox เดี่ยว
//
// widget ที่ไม่ได้มาจาก docx (ProviderGrid, GameRankingBoard, LoginRtpSection,
// SmoothCarousel, LatestWinners, ReviewCardSumo2, แถวปุ่ม login/register) ใช้ป้าย
// เป็น <p>/<span> + aria-label บน <section> จึงวางต่อท้ายหัวข้อ docx ที่มันสังกัด
// ได้โดยลำดับ h2 ไม่เพี้ยน — ProviderGrid ต่อจากหัวข้อค่ายเกม, GameRankingBoard
// ต่อจากหัวข้อล็อบบี้, LoginRtpSection ต่อจากหัวข้อระบบออโต้, SmoothCarousel
// (แบนเนอร์เพดานถอน) ต่อจากหัวข้อลุยทำกำไร, LatestWinners ต่อจากหัวข้อฝากถอน
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx + หัวข้อ FAQ ที่หน้านี้เขียนเอง = 7
// คำถามใน Faq2 เป็น <span> ใน <summary> ไม่ใช่ h3 ตามที่ variant นั้น ship มา

// Title/Des มาจาก docx ตรงตัว ตัว Des ยาว 151 ตัวอักษร ซึ่งอยู่ในช่วง 150–160 ที่
// verify-build บังคับอยู่แล้ว จึงใช้ทั้งประโยคโดยไม่ต้องต่อท้าย
const pageTitle = "THUNDER87 | สล็อตฟอร์มฟาด เกมครบแบบไม่หวง ระบบแรงออโต้ไว";
const pageDescription =
  "THUNDER87 สล็อตฟอร์มฟาด เกมครบแบบไม่หวง ระบบแรงออโต้ไว รวมสล็อตค่ายดัง คาสิโนสด และบาคาร่าไว้เต็มล็อบบี้ เข้าเกมคล่อง ฝากถอนเป็นระบบ พร้อมลุยได้ทุกเวลา";

// default message ของ Announcement ทุก variant คือสโลแกนของแบรนด์เก่าคนละเจ้ากัน
// จึงส่ง message ตรงๆ เสมอ ไม่พึ่ง default และห้ามขึ้นต้นด้วย emoji
const announcementMessage =
  "THUNDER87 สล็อตฟอร์มฟาด เกมครบแบบไม่หวง ระบบแรงออโต้ไว • ขนเกมค่ายดังระดับโลกมาลงแน่นในที่เดียว คัดมาแล้วทั้งงานภาพคมชัดและอัตราการจ่ายสมน้ำสมเนื้อ • รวมสล็อต คาสิโนสด และบาคาร่าไว้เต็มล็อบบี้ สลับอารมณ์เล่นได้ในยูสเซอร์เดียว • เข้าเกมคล่อง สลับค่ายไว ระบบประมวลผลแรงและเสถียร ไม่มีกระตุกไม่หลุดกลางโบนัส • จังหวะการเล่นสุดตึงพร้อมทุกช่วงเวลา เช้า สาย บ่าย ดึก มาตรฐานการจ่ายเที่ยงตรงเสมอ • ฝากถอนออโต้แม่นยำ ทำรายการไวไม่ผ่านคนกลาง ทุกบาททุกสตางค์ตรงไปตรงมา • ปักหลักเล่นเกมโปรดที่เดียวจบ ครบทั้งความสนุกและความคุ้มค่า";

// FAQ ห้าข้อเขียนจากเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบทับย่อหน้าไหนตรงๆ เพราะ
// เนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบคำถามที่ผู้เล่นถาม
// จริงด้วยข้อเท็จจริงชุดเดียวกัน
const faqs = [
  {
    q: "THUNDER87 มีค่ายเกมให้เลือกเยอะแค่ไหน ต้องสมัครหลายเว็บไหม",
    a: "ไม่ต้องสมัครหลายเว็บเลย THUNDER87 รวมรายชื่อค่ายเกมชั้นนำระดับโลกมาไว้ในที่เดียว ทั้งค่ายใหญ่ในกระแสและค่ายดังเฉพาะกลุ่ม ทุกเกมถูกคัดสรรมาอย่างพิถีพิถันเพื่อตอบโจทย์สายสปินที่ต้องการงานภาพคมชัดและอัตราการจ่ายที่สมน้ำสมเนื้อ เล่นได้ยาวๆ ไม่มีคำว่ากั๊กฟีเจอร์ เปิดโอกาสให้ลุ้นแจ็คพอตแตกหนักได้เต็มที่ในทุกช่วงเวลา",
  },
  {
    q: "อยากสลับจากสล็อตไปเล่นบาคาร่าหรือคาสิโนสด ต้องโยกเงินไหม",
    a: "ไม่ต้องโยกเงินและไม่ต้องเปิดบัญชีเพิ่ม ล็อบบี้ของ THUNDER87 ถูกดีไซน์มาให้อยู่ในรูปแบบอาณาจักรความบันเทิงแบบครบวงจร อยากสลับอารมณ์จากการปั่นวงล้อไปลุ้นหน้าไพ่บาคาร่า หรือสัมผัสความตื่นเต้นกับคาสิโนสดถ่ายทอดตรง ก็ทำได้ทันทีในยูสเซอร์เดียว ความหลากหลายตรงนี้ช่วยเติมเต็มอารมณ์การเล่นให้สดใหม่อยู่เสมอ",
  },
  {
    q: "ระบบของ THUNDER87 เข้าเกมไวจริงไหม จะเจอเกมหลุดกลางโบนัสหรือเปล่า",
    a: "เรื่องเทคโนโลยีเบื้องหลังคือจุดขายที่ทำให้ THUNDER87 ยืนหนึ่งในใจนักเล่น ระบบการประมวลผลแรงและเสถียร กดเข้าเกมได้ฉับไว ตอบสนองทันทีที่คลิก การสลับเปลี่ยนค่ายเกมทำได้อย่างลื่นไหลไม่มีกระตุก หมดปัญหาหน้าจอค้างหรือเกมหลุดระหว่างลุ้นโบนัส ให้ดื่มด่ำกับความสนุกได้อย่างต่อเนื่องไม่มีสะดุดแม้แต่วินาทีเดียว",
  },
  {
    q: "เข้าเล่นช่วงดึกหรือช่วงคนเยอะ จังหวะการจ่ายรางวัลจะเปลี่ยนไปไหม",
    a: "ไม่ว่าจะเข้าใช้งานช่วงเช้า สาย บ่าย หรือดึก ตัวเกมยังคงรักษามาตรฐานการจ่ายรางวัลอย่างเที่ยงตรง จังหวะโบนัสแตกและฟีเจอร์พิเศษพร้อมทำงานตลอดเวลา THUNDER87 ตั้งใจเซ็ตจังหวะการเล่นสุดตึงมาเพื่อผู้เล่นทุกคน เปิดกว้างให้เข้ามาวางกลยุทธ์ ลุยทำกำไร และกอบโกยรางวัลใหญ่กลับออกไปได้ตามใจสั่ง",
  },
  {
    q: "ฝากถอนกับ THUNDER87 ใช้เวลานานไหม ต้องแจ้งสลิปผ่านแอดมินหรือเปล่า",
    a: "ไม่ต้องผ่านคนกลาง THUNDER87 พัฒนาระบบการเงินออโต้ให้มีความแม่นยำและรวดเร็วสูงสุด ไม่ว่าจะฝากเงินเพื่อเติมทุนลุยต่อ หรือถอนกำไรก้อนโตเข้าบัญชี ทุกขั้นตอนถูกจัดการอย่างเรียบร้อยภายในเวลาอันสั้น ไร้ความซับซ้อน ให้มั่นใจได้เต็มร้อยว่าทุกบาททุกสตางค์จะถูกจัดการอย่างตรงไปตรงมา",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxPremium as="h1" title="THUNDER87 สล็อตฟอร์มฟาด เกมครบแบบไม่หวง ระบบแรงออโต้ไว">
    <p class="text-left text-base leading-relaxed">
      ยกระดับความมันส์ให้พุ่งทะลุพิกัดไปกับ THUNDER87 เว็บสล็อตสายดุดันที่พร้อมฟาดทุกวงการด้วยความครบเครื่อง ลืมความจำเจของระบบเดิมๆ ไปได้เลย
      เพราะที่นี่ขนความบันเทิงระดับพรีเมียมมาให้สัมผัสกันแบบจัดเต็ม ทั้งเรื่องความอลังการของตัวเกม ความรวดเร็วของระบบออโต้ และจังหวะการแจกรางวัลที่มาแบบไม่หวง
      ไม่ว่าคุณจะเป็นสายปั่นมือใหม่หรือเซียนเก๋าเกม แค่ได้ก้าวเข้ามาสัมผัสบรรยากาศความสนุกที่นี่ ก็พร้อมเปิดประตูสู่อีกระดับของการทำกำไรที่ไร้ขีดจำกัดแล้ว
    </p>
  </ContentBoxPremium>

  <ContentBoxFloatingBadge as="h2" title="THUNDER87 สล็อตฟอร์มฟาด ขนเกมค่ายดังมาลงแน่นแบบไม่หวง">
    <p class="text-left text-base leading-relaxed">
      จัดหนักจัดเต็มสมชื่อ THUNDER87 ที่รวมเอารายชื่อค่ายเกมชั้นนำระดับโลกมาไว้ในที่เดียว ไม่ว่าจะเป็นค่ายใหญ่ในกระแสหรือค่ายดังเฉพาะกลุ่ม
      ทุกเกมถูกคัดสรรมาอย่างพิถีพิถันเพื่อตอบโจทย์สายสปินที่ต้องการงานภาพคมชัดและอัตราการจ่ายที่สมน้ำสมเนื้อ เล่นได้ยาวๆ ไม่มีคำว่ากั๊กฟีเจอร์
      เปิดโอกาสให้ผู้เล่นได้ลุ้นแจ็คพอตแตกหนักกันอย่างเต็มที่ในทุกช่วงเวลา
    </p>
  </ContentBoxFloatingBadge>

  <ProviderGrid />

  <ContentBoxSevenThreePremium as="h2" title="รวมสล็อต คาสิโนสด และบาคาร่า จัดเต็มล็อบบี้เลือกสลับได้ไม่มีเบื่อ">
    <Picture
      slot="left"
      src={imgBaccarat}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น THUNDER87 ข้อความ แทงบาคาร่า สูงสุดไม้ละ 200,000 แทงบอลสูงสุดไม้ละ 2,000,000 และที่อยู่เว็บ Thunder87.com ภาพหญิงสาวผมบลอนด์สวมชุดออกกำลังกายสีดำสกรีนโลโก้ THUNDER87 คลี่ไพ่ห้าใบไว้ข้างหน้า ยืนอยู่หน้าสายฟ้าสีเหลืองบนพื้นดำ"
      class="mx-auto h-auto w-full rounded-2xl border border-[#fae61c]/35 shadow-[0_10px_30px_rgba(250,230,28,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      ไม่ได้มีดีแค่เรื่องสล็อต เพราะล็อบบี้ของ THUNDER87 ถูกดีไซน์มาให้อยู่ในรูปแบบอาณาจักรความบันเทิงแบบครบวงจร อยากสลับอารมณ์จากการปั่นวงล้อไปลุ้นหน้าไพ่บาคาร่า
      หรือสัมผัสความตื่นเต้นกับคาสิโนสดถ่ายทอดตรง ก็ทำได้ทันทีในยูสเซอร์เดียว ไม่ต้องเสียเวลาโยกเงินหรือสมัครหลายบัญชีให้ยุ่งยาก
      ความหลากหลายตรงนี้ช่วยเติมเต็มอารมณ์การเล่นให้สดใหม่อยู่เสมอ
    </p>
  </ContentBoxSevenThreePremium>

  <GameRankingBoard />

  <ContentBoxTwoPremium as="h2" title="เข้าเกมคล่องสลับค่ายไว ระบบออโต้สปีดแรงที่สุดใน THUNDER87">
    <p slot="left" class="text-left text-base leading-relaxed">
      เรื่องเทคโนโลยีเบื้องหลังคือจุดขายที่ทำให้ THUNDER87 ยืนหนึ่งในใจนักเล่น ด้วยระบบการประมวลผลที่แรงและเสถียรที่สุด สามารถกดเข้าเกมได้ฉับไว ตอบสนองทันทีที่คลิก
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      การสลับเปลี่ยนค่ายเกมทำได้อย่างลื่นไหลไม่มีกระตุก หมดปัญหาหน้าจอค้างหรือเกมหลุดระหว่างลุ้นโบนัส ให้คุณดื่มด่ำกับความสนุกได้อย่างต่อเนื่องไม่มีสะดุดแม้แต่วินาทีเดียว
    </p>
  </ContentBoxTwoPremium>

  <LoginRtpSection />

  <ContentBox3ThreePremium as="h2" title="สัมผัสจังหวะการเล่นสุดตึงกับ THUNDER87 พร้อมลุยทำกำไรได้ทุกเวลา">
    <p slot="left" class="text-left text-base leading-relaxed">
      สายล่ารางวัลต้องไม่พลาดจังหวะการเล่นสุดตึงที่ THUNDER87 ตั้งใจเซ็ตมาเพื่อผู้เล่นทุกคน ไม่ว่าจะเข้าใช้งานช่วงเช้า สาย บ่าย หรือดึก
    </p>
    <p slot="center" class="text-left text-base leading-relaxed">
      ตัวเกมยังคงรักษามาตรฐานการจ่ายรางวัลอย่างเที่ยงตรง จังหวะโบนัสแตกและฟีเจอร์พิเศษพร้อมทำงานตลอดเวลา
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      เปิดกว้างให้ทุกคนเข้ามาวางกลยุทธ์ ลุยทำกำไร และกอบโกยรางวัลใหญ่กลับออกไปได้ตามใจสั่ง
    </p>
  </ContentBox3ThreePremium>

  <SmoothCarousel />

