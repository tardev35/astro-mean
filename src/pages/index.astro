---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement2.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinners2.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide2.png";
import imgLuckyWheel from "../assets/slide4.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxNeumorphism as="h1"
//   2 → ContentBoxPremium as="h2"
//   3 → ContentBoxSevenThreeFloatingBadge + slide2 (CASHBACK คืนยอดเสียทุกวันจันทร์)
//   4 → ContentBoxSevenThreeNeumorphism + slide4 (กิจกรรมวงล้อนำโชค แต้มสะสมเพชร)
//   5 → ContentBox as="h2"
//   6 → ContentBoxFloatingBadge as="h2"
//   7 → ContentBoxPremium as="h2"
// SevenThree ใช้ 2 บล็อกเท่านั้น (โควตาเต็ม) และแต่ละตัวส่งหัวข้อเดียว
// (title ของ FloatingBadge / titleright ของ Neumorphism) ถ้าส่งทั้งซ้ายและขวา
// จะได้ h2 เกินมาอีกตัว
// slide1 (ตารางจ่ายหวย) และ slide3 (แนะนำเพื่อน) ไม่ได้ใช้ในกล่องเนื้อหา
// ขึ้นเฉพาะใน SmoothCarousel
// widget ที่ไม่ได้มาจาก docx ใช้หัวข้อเป็น <p> + aria-label บน <section> จึงแทรก
// ระหว่างกล่องได้โดยลำดับ H2 ไม่เพี้ยน (LoginRtpSection ก็เป็น <p> เช่นกัน)
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx + หัวข้อ FAQ ที่หน้านี้เขียนเอง = 7
// h3 = 5 คือคำถาม FAQ ใต้ h2 ของตัวเอง (Faq3 ตั้งใจให้ซ้อนแบบนี้)

const pageTitle = "PODK888 | เว็บตรงเกมครบทุกสาย คาสิโนสดพร้อมลั่น ระบบใหม่โอนไว";

// Meta description ยาว 156 ตัวอักษร — verify-build บังคับช่วง 150–160
// ประโยคหลักคือบรรทัด Des ของ docx คำต่อคำ ต่อท้ายด้วยหัวข้อสูตรเล่นจาก docx ข้อ 7
const pageDescription =
  "PODK888 เว็บตรงเกมครบทุกสาย คาสิโนสดพร้อมลั่น รวมค่ายแท้แตกโหดเต็มหน้ากระดาน ระบบใหม่โอนไว ปลอดภัยทุกยอด ไม่มีประวัติโกง พร้อมแจกสูตรเล่นและเทคนิคใหม่ทุกวัน";

const announcementMessage =
  "PODK888 เว็บตรงเกมครบทุกสาย รวมสล็อต บาคาร่า และคาสิโนสดไว้ในแพลตฟอร์มเดียว ไม่ต้องจำหลายรหัส ไม่ต้องสลับเว็บให้ปวดหัว • คัดมาเฉพาะค่ายแท้ ภาพคมชัดไม่มีสะดุด ดีลเลอร์แจ่ม จัดหมวดหมู่เกมเด่นไว้ให้เลือกง่าย • แตกโหดเต็มหน้ากระดาน เข้าฟีเจอร์รัวๆ จนคนรีวิวกันปากต่อปาก • ระบบออโต้แบบใหม่ กดปุ๊บเงินเด้งปั๊บ ปลอดภัยทุกยอด ข้อมูลไม่รั่วไหล • ไม่มีประวัติโกงหรือบิดยอดแม้แต่บาทเดียว แอดมินสแตนด์บายดูแลตั้งแต่สมัครจนถึงถอน";

const faqs = [
  {
    q: "PODK888 รวมเกมอะไรไว้บ้าง ต้องสลับเว็บเล่นหลายที่ไหม",
    a: "ที่นี่รวบรวมเกมเอาไว้ครบทุกสายในแพลตฟอร์มเดียว ไม่ว่าจะเป็นสล็อต บาคาร่า หรือคาสิโนสดก็มีให้ลุยกันแบบจุใจ ไม่ต้องจำหลายรหัสและไม่ต้องเสียเวลาสลับเว็บให้ปวดหัว อยากปั่นสล็อตเพลินๆ หรือเปลี่ยนฟีลไปลุ้นไพ่ก็ทำได้เลย ลื่นไหลสุดๆ ถูกใจสายขี้เบื่อที่ชอบลองอะไรใหม่ๆ ตลอดเวลา",
  },
  {
    q: "ห้องคาสิโนสดของ PODK888 เป็นค่ายแท้หรือเปล่า หาเกมยากไหม",
    a: "สายไลฟ์สดต้องโดน เพราะเราขนค่ายคาสิโนดังๆ ระดับโลกมาไว้เพียบ คัดมาแล้วเน้นๆ ว่าเป็นค่ายแท้ชัวร์ ภาพสวย ดีลเลอร์แจ่ม แถมยังจัดหมวดหมู่เกมเด่นๆ ไว้ให้เลือกเล่นง่ายมาก ไม่ต้องไปงมหาเองให้เสียเวลา เข้าปุ๊บก็พร้อมลั่นวางเดิมพันได้ทันที",
  },
  {
    q: "ทำไมช่วงนี้หลายคนถึงพูดถึงอัตราการจ่ายของ PODK888",
    a: "สาเหตุก็เพราะอัตราการจ่ายที่บอกเลยว่าไม่ธรรมดา หลายคนมารีวิวแบบปากต่อปากว่าเกมที่นี่แจกหนัก แตกโหดกันแบบเต็มหน้ากระดาน เข้าฟีเจอร์กันรัวๆ ใครอยากรู้ว่ามันจะเดือดแค่ไหน ต้องลองเข้ามาสัมผัสด้วยตัวเองดูสักครั้ง",
  },
  {
    q: "ฝากถอนกับ PODK888 ใช้เวลานานไหม ยอดใหญ่ปลอดภัยหรือเปล่า",
    a: "ปัญหาเรื่องเงินเข้าช้าจะหมดไป เพราะเราพัฒนาระบบออโต้แบบใหม่ที่ทำรายการได้ไวมาก กดปุ๊บเงินเด้งปั๊บ ไม่ว่าจะยอดหลักร้อยหรือหลักล้านก็รับประกันความปลอดภัย ข้อมูลไม่มีรั่วไหล ให้คุณสนุกกับการเล่นได้ยาวๆ แบบไม่ต้องมานั่งระแวงเรื่องระบบหลังบ้าน",
  },
  {
    q: "มือใหม่ที่ยังเล่นไม่เป็น เริ่มต้นกับ PODK888 ยังไงดี",
    a: "มือใหม่ไม่ต้องกลัวว่าจะเล่นไม่เป็น เพราะที่นี่ไม่ได้มีแค่เกมให้เล่น แต่ยังมีสูตรเด็ดๆ และเทคนิคการเอาชนะมาอัปเดตให้สมาชิกได้อ่านกันเรื่อยๆ เอาไปปรับใช้เป็นแนวทางในการวางแผนของตัวเองได้เลย แถมมีทีมงานแอดมินสแตนด์บายดูแลตลอด ติดขัดตรงไหนทักถามได้เสมอ",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxNeumorphism as="h1" title="PODK888 เว็บตรงเกมครบทุกสาย คาสิโนสดพร้อมลั่น ระบบใหม่โอนไว">
    <p class="text-left text-base leading-relaxed">
      ใครที่กำลังมองหาที่เล่นแบบจบๆ ไม่ต้องโยกเงินไปมา บอกเลยว่า PODK888 ตอบโจทย์สุดๆ เพราะที่นี่รวบรวมเกมเอาไว้ครบทุกสาย ไม่ว่าจะเป็นสล็อต บาคาร่า หรือคาสิโนสดก็มีให้ลุยกันแบบจุใจ
      ภาพคมชัดไม่มีสะดุด แถมระบบใหม่ล่าสุดยังอัปเกรดเรื่องการฝากถอนให้โอนไวปรู๊ดปร๊าด ทันใจคนชอบความต่อเนื่องแน่นอน
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxPremium as="h2" title="เว็บตรงเกมครบทุกสาย PODK888 รวมทุกความสนุกไว้ในแพลตฟอร์มเดียว">
    <p class="text-left text-base leading-relaxed">
      ขี้เกียจจำหลายรหัสใช่ไหม? มาเล่นที่ PODK888 ที่เดียวจบ เพราะเขาจับเอาความสนุกทุกรูปแบบมายัดไว้ในแพลตฟอร์มเดียว ไม่ต้องเสียเวลาสลับเว็บให้ปวดหัว อยากปั่นสล็อตเพลินๆ
      หรือเปลี่ยนฟีลไปลุ้นไพ่ก็ทำได้เลย ลื่นไหลสุดๆ รับรองว่าถูกใจสายขี้เบื่อที่ชอบลองอะไรใหม่ๆ ตลอดเวลา
    </p>
  </ContentBoxPremium>

  <ProviderGrid />

  <ContentBoxSevenThreeFloatingBadge title="คาสิโนสดพร้อมลั่น พร้อมรวมค่ายแท้ที่คัดเกมเด่นมาให้เลือกแบบไม่ต้องเสียเวลาหา">
    <Picture
      slot="left"
      src={imgCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น PODK888 CASHBACK คืนยอดเสียทุกวันจันทร์ คาสิโน 5 เปอร์เซ็นต์ ยิงปลา 5 เปอร์เซ็นต์ สล็อต 5 เปอร์เซ็นต์ และกีฬา 3 เปอร์เซ็นต์ พร้อมไอคอนไพ่ ปลา ตู้สล็อต และลูกฟุตบอลบนพื้นคลื่นสีม่วงชมพู"
      class="mx-auto h-auto w-full rounded-2xl border border-[#f670b7]/30 shadow-[0_10px_30px_rgba(246,112,183,0.2)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      สายไลฟ์สดต้องโดน เพราะ PODK888 ขนค่ายคาสิโนดังๆ ระดับโลกมาไว้เพียบ คัดมาแล้วเน้นๆ ว่าเป็นค่ายแท้ชัวร์ ภาพสวย ดีลเลอร์แจ่ม แถมยังจัดหมวดหมู่เกมเด่นๆ ไว้ให้เลือกเล่นง่ายมาก
      ไม่ต้องไปงมหาเองให้เสียเวลา เข้าปุ๊บก็พร้อมลั่นวางเดิมพันได้ทันที
    </p>
  </ContentBoxSevenThreeFloatingBadge>

  <ContentBoxSevenThreeNeumorphism titleright="แตกโหดเต็มหน้ากระดาน จุดที่ทำให้หลายคนจับตา PODK888 มากขึ้นทุกวัน">
    <Picture
      slot="left"
      src={imgLuckyWheel}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์กิจกรรม PODK888 วงล้อนำโชค แต้มสะสมเพชรจากยอดฝากและยอดเสียคอวัน ทุกยอดฝาก 500 บาทรับ 1 เพชร ยอดฝาก 100 บาทรับ 2 เพชร ยอดฝาก 150 บาทรับ 3 เพชร และยอดฝาก 200 บาทรับ 4 เพชร พร้อมภาพวงล้อรางวัลกับทองแท่งและกองเหรียญ"
      class="mx-auto h-auto w-full rounded-2xl border border-[#f670b7]/30 shadow-[0_10px_30px_rgba(246,112,183,0.2)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      นาทีนี้ใครๆ ก็พูดถึง PODK888 กันทั้งนั้น สาเหตุก็เพราะอัตราการจ่ายที่บอกเลยว่าไม่ธรรมดา หลายคนมารีวิวแบบปากต่อปากว่าเกมที่นี่แจกหนัก แตกโหดกันแบบเต็มหน้ากระดาน เข้าฟีเจอร์กันรัวๆ
      ใครอยากรู้ว่ามันจะเดือดแค่ไหน ต้องลองเข้ามาสัมผัสด้วยตัวเองดูสักครั้ง
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <SmoothCarousel />

  <ContentBox as="h2" title="ระบบใหม่โอนไว ปลอดภัยทุกยอด ใช้งานต่อเนื่องได้แบบไม่ต้องกังวล">
    <p class="text-left text-base leading-relaxed">
      ปัญหาเรื่องเงินเข้าช้าจะหมดไป เพราะ PODK888 พัฒนาระบบออโต้แบบใหม่ที่ทำรายการได้ไวมาก กดปุ๊บเงินเด้งปั๊บ ไม่ว่าจะยอดหลักร้อยหรือหลักล้านก็รับประกันความปลอดภัย ข้อมูลไม่มีรั่วไหล
      ให้คุณสนุกกับการเล่นได้ยาวๆ แบบไม่ต้องมานั่งระแวงเรื่องระบบหลังบ้าน
    </p>
  </ContentBox>

  <GameRankingBoard />

  <ContentBoxFloatingBadge as="h2" title="ไม่มีประวัติโกง พร้อมดูแลทุกการใช้งาน ให้ความมั่นใจตั้งแต่สมัครจนถึงถอน">
    <p class="text-left text-base leading-relaxed">
      เรื่องความน่าเชื่อถือต้องให้เขาเลย PODK888 เปิดให้บริการมาด้วยความโปร่งใส ไม่มีประวัติการโกงหรือบิดยอดแม้แต่บาทเดียว แถมยังมีทีมงานแอดมินคอยสแตนด์บายดูแลตลอด ติดขัดตรงไหนทักถามได้เสมอ
      สร้างความอุ่นใจตั้งแต่ก้าวแรกที่สมัครสมาชิกไปจนถึงตอนกดถอนเงินเข้าบัญชี
    </p>
  </ContentBoxFloatingBadge>

  <LatestWinners />

  <ContentBoxPremium as="h2" title="PODK888 พร้อมแจกสูตรเล่นและเทคนิคดี ๆ ที่ช่วยให้การวางแผนสนุกยิ่งกว่าเดิม">
    <p class="text-left text-base leading-relaxed">
      มือใหม่ไม่ต้องกลัวว่าจะเล่นไม่เป็น เพราะที่ PODK888 ไม่ได้มีแค่เกมให้เล่น แต่ยังมีสูตรเด็ดๆ และเทคนิคการเอาชนะมาอัปเดตให้สมาชิกได้อ่านกันเรื่อยๆ เอาไปปรับใช้เป็นแนวทางในการวางแผนของตัวเองได้เลย
      รับรองว่าช่วยเพิ่มโอกาสบวกและทำให้การเดิมพันสนุกมีรสชาติขึ้นอีกเยอะ
    </p>
  </ContentBoxPremium>

  <ReviewCardSumo2 />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#02dbfd] via-[#f670b7] to-[#f670b7] px-4 py-3 text-sm font-black whitespace-nowrap text-[#12060f] shadow-[0_10px_30px_rgba(246,112,183,0.35)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(2,219,253,0.45)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#f670b7]/60 bg-[#12060f]/85 px-4 py-3 text-sm font-black whitespace-nowrap text-[#f670b7] backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:border-[#02dbfd] hover:bg-[#02dbfd] hover:text-[#12060f] hover:shadow-[0_15px_40px_rgba(2,219,253,0.4)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <LoginRtpSection />

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ PODK888" faqs={faqs} />

  <Navfoot />
</MainLayout>
