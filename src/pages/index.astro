---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBox3Three from "../components/ContentBox3Three.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinnersCyber from "../components/LatestWinnersCyber.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgAutoWithdraw from "../assets/slide1.png";
import imgReferBonus from "../assets/slide2.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxPremium as="h1" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   2 → ContentBoxTwoPremium as="h2" (แบ่งย่อหน้าเดียวลง left/right)
//   3 → ContentBoxSpecial as="h2" (แบ่งย่อหน้าเดียวลงสองครึ่ง ไอคอน 🎰 กับ 🏆)
//       แล้วต่อด้วย ProviderGrid ซึ่งเป็นภาพประกอบของหัวข้อนี้โดยตรง (รวมเกมตัวตึง
//       จากค่ายชั้นนำไว้ครบวงจร)
//   4 → ContentBox3ThreePremium as="h2" (แบ่งย่อหน้าเดียวลง left/center/right)
//       แล้วต่อด้วย GameRankingBoard ซึ่งเป็นภาพประกอบของหัวข้อนี้โดยตรง (จัดหมวด
//       เกมให้เลือกง่าย เจอตัวที่ใช่ไว)
//   5 → ContentBoxSevenThreePremium as="h2" + slide1 (เว็บตรง ลิขสิทธิ์แท้ ฝาก-ถอน
//       AUTO 3 นาที — ตรงกับหัวข้อเรื่องออโต้ไวทันใจพอดี) แล้วต่อด้วย
//       LatestWinnersCyber ซึ่งเป็นฟีดถอนเงินจริงของหัวข้อเดียวกัน
//   6 → ContentBox3Three as="h2" (แบ่งย่อหน้าเดียวลง left/center/right ไอคอน
//       🎁 💰 🎟️ ตรงกับหัวข้อเรื่องไลน์อัปโปรโมชัน)
//   7 → ContentBoxSevenThree as="h2" + slide2 (แนะนำเพื่อน รับค่าคอมมิชชั่น 3%
//       คืนยอดเสียด้วยระบบ Auto — ตรงกับหัวข้อเรื่องโบนัสและสิทธิพิเศษที่เติมทุกวัน)
//
// variant รอบนี้หมุนทั้งตระกูลจากรอบก่อน: ทรง ContentBox ย้ายจากชุด FloatingBadge +
// CyberCut + Neumorphism มาเป็นชุด plain + Premium ส่วน Navbar เป็น NavbarPremium,
// Footer เป็น FooterPremium, Announcement เป็น AnnouncementPremium,
// LatestWinners เป็น LatestWinnersCyber และ Faq เป็น Faq4
//
// Announcement ส่ง message ตรงๆ เสมอ เพราะ default ของทุก variant ในตระกูลนี้เป็น
// สโลแกนของแบรนด์เก่าคนละเจ้ากัน ข้อความชุดนี้ตรงกับ default ของ AnnouncementPremium
// เป๊ะ เพื่อให้ ticker ของหน้าย่อยที่เรียก <Announcement /> เปล่าๆ วิ่งข้อความ
// เดียวกับหน้าแรก และห้ามขึ้นต้นด้วย emoji เพราะ marquee render ข้อความซ้ำและ
// emoji ที่ฝังในสตริงถูก mark aria-hidden ไม่ได้
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook — slide1 คู่กับหัวข้อข้อ 5 และ
// slide2 คู่กับหัวข้อข้อ 7 ส่วน slide3 (สล็อตเว็บตรง ไม่ผ่านเอเยนต์) ไม่ถูกวางบน
// หน้าแรกโดยตั้งใจ — มันอยู่ใน SmoothCarousel กับกริดของหน้า /promotion ซึ่งเป็น
// ที่ของมัน
//
// slide4.png เป็นอาร์ตของแบรนด์ก่อน (แบนเนอร์ชมพู "ไม่ใช้บัญชีม้า" มีโลโก้เก่าอยู่
// ในภาพ) mtime เก่ากว่าไฟล์ชุดปัจจุบัน ห้าม import ที่ไหนทั้งสิ้น เช่นเดียวกับ
// banner.png / banner2 / banner3 / banner4 ที่เป็นอาร์ตค้างของแบรนด์ก่อนๆ — รูปที่
// import คือรูปที่ถูก emit ถึงจะไม่มีใคร render ก็ตาม ส่วน banner1 เป็นของ
// MainLayout จัดการเอง และ banner1-mobile ไม่มีอยู่ในรอบนี้
//
// widget ที่ไม่ได้มาจาก docx (LoginRtpSection, ReviewCardSumo2, SmoothCarousel,
// แถวปุ่ม login/register, FAQ, Navfoot) ใช้ป้ายเป็น <p>/<span> + aria-label บน
// <section> และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้ายทั้งชุด ยกเว้นสามตัวที่เป็น
// ภาพประกอบของหัวข้อ docx หนึ่งข้อโดยตรง (ProviderGrid → ข้อ 3,
// GameRankingBoard → ข้อ 4, LatestWinnersCyber → ข้อ 5) ซึ่งวางต่อท้ายบล็อกนั้นๆ
// ไม่มีตัวไหนคั่นระหว่างหัวข้อ docx สองข้อโดยไม่มีเหตุผล
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx พอดี ไม่มีตัวที่เจ็ด — หัว FAQ เป็น <p> ใน
// Faq4.astro (ชื่อ section ย้ายไป aria-label) คำถามใน Faq เป็น <span> ใน <summary>
// ไม่ใช่ h3 และป้ายคอลัมน์ของ TwoPremium / 3ThreePremium / SevenThreePremium /
// 3Three / SevenThree เป็น <p> — docx รอบนี้แบน H1 + H2 ล้วน หน้านี้จึงไม่มี h3 เลย
//
// title ใช้บรรทัด Title ของ docx ตรงๆ (63 ตัวอักษร) ส่วน description ใช้บรรทัด Des
// ของ docx (138 ตัวอักษร ต่ำกว่าเกท 150–160 ของ tools/verify-build.mjs ซึ่งจะทำให้
// build แดง) โดยต่อหางเป็น "ครบจบในเว็บเดียว" ให้ยาว 155 ตัวอักษร ค่าที่ใช้เป็น
// สตริงเดียวกับที่ส่งเข้า pageGraph และตรงกับที่ส่งให้ MainLayout
const pageTitle = "ASHTON168 | สล็อตระบบแน่น เกมพร้อมรัน ออโต้ไวทันใจ โปรคุ้มสุด ๆ";
const pageDescription =
  "ASHTON168 สล็อตระบบแน่น เกมพร้อมรันจากค่ายชั้นนำ จัดหมวดตัวฮิตให้เลือกง่าย ออโต้ไวทันใจ โปรคุ้มสุด ๆ เติมโบนัสและสิทธิพิเศษให้ตามได้ทุกวัน ครบจบในเว็บเดียว";

const announcementMessage =
  "ASHTON168 สล็อตระบบแน่น เกมพร้อมรัน ออโต้ไวทันใจ โปรคุ้มสุด ๆ • โครงสร้างระบบหลังบ้านแน่นหนา เชื่อมตรงเข้าเซิร์ฟเวอร์หลักของค่ายเกมชั้นนำ ทุกเกมพร้อมรันลื่นไหลแม้ช่วงคนเข้าพร้อมกันเยอะ • รวมเกมสล็อตตัวตึงจากค่ายดังไว้ครบวงจร อัตราการจ่ายได้มาตรฐานยุติธรรม กดเลือกเกมฮิตทำเงินได้ทันที • ล็อบบี้จัดหมวดหมู่ไว้เป็นระเบียบ แยกตามประเภท ค่ายเกม และหมวดเกมยอดฮิต เจอตัวที่ใช่ไวโดยไม่ต้องค้นหลายรอบ • ระบบออโต้ไฮสปีดฝากถอนเองได้ในไม่กี่วินาที ยอดอัปเดตไว ไม่ต้องส่งสลิป ไม่ต้องรอแอดมินอนุมัติ • โปรโมชันจัดเต็มทั้งสมาชิกใหม่ โบนัสเติมเงินรายวัน และเครดิตพิเศษตามช่วงเวลา เลือกกดรับเพิ่มทุนได้อิสระ • กิจกรรมคืนยอดเสียประจำวัน โค้ดเครดิตฟรีตามเทศกาล และระบบสะสมแต้มแลกรางวัล หมุนเวียนมาเติมให้ตามต่อได้ตลอด 24 ชั่วโมง";

// FAQ ห้าข้อเขียนจากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้าไหนมา
// ทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบคำถาม
// ที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน
const faqs = [
  {
    q: "ASHTON168 บอกว่าระบบแน่น วัดจากอะไรได้บ้าง",
    a: "ความแน่นของที่นี่มาจากการวางโครงสร้างระบบหลังบ้านที่เสถียรและทรงพลัง รองรับการเชื่อมต่อตรงเข้าสู่เซิร์ฟเวอร์หลักของค่ายเกมยักษ์ใหญ่ทั่วโลก ตัวระบบจึงพร้อมรันทุกเกมสล็อตได้อย่างสมูธแม้ในช่วงเวลาที่มีผู้เข้าใช้งานพร้อมกันจำนวนมาก กราฟิกแสดงผลคมชัดเต็มประสิทธิภาพ และไม่มีอาการเกมค้างหรือหลุดระหว่างกำลังลุ้นโบนัสก้อนโต",
  },
  {
    q: "ในล็อบบี้มีเกมจากค่ายไหนบ้าง เลือกยากไหม",
    a: "ล็อบบี้รวบรวมเกมสล็อตตัวตึงกระแสแรงจากค่ายชั้นนำระดับโลกไว้แบบครบวงจร ทั้งค่ายสายภาพสวย 3D ค่ายสายแตกโหดตัวคูณเยอะ และค่ายยอดนิยมตลอดกาล ทุกเกมคัดมาแล้วว่ามีอัตราการจ่ายเงินรางวัลที่ได้มาตรฐานยุติธรรมและลุ้นแจ็คพอตง่าย จึงกดเลือกเกมฮิตทำเงินได้ทันทีโดยไม่ต้องเสียเวลาไล่หาจากหลายเว็บ",
  },
  {
    q: "หาเกมที่อยากเล่นเจอเร็วแค่ไหน ต้องค้นหลายรอบหรือเปล่า",
    a: "หน้าเว็บถูกดีไซน์มาเพื่อตอบโจทย์ผู้เล่นโดยเฉพาะ มีการจัดหมวดหมู่เกมไว้อย่างเป็นระเบียบชัดเจน แยกตามประเภท ค่ายเกม และหมวดเกมยอดฮิต ผู้เล่นจึงค้นหาและเจอเกมที่ตรงกับสไตล์การเล่นของตัวเองได้อย่างรวดเร็ว จะเปลี่ยนแนวไปปั่นเกมใหม่หรือกลับมาเล่นเกมโปรดก็ทำได้ในไม่กี่คลิกโดยไม่ต้องค้นหลายรอบ",
  },
  {
    q: "ฝากถอนต้องส่งสลิปหรือรอแอดมินอนุมัติไหม ใช้เวลานานแค่ไหน",
    a: "ระบบออโต้สุดทันสมัยเข้ามาลดขั้นตอนซับซ้อนออกทั้งหมด การฝากและถอนเงินดำเนินการได้เองง่ายๆ ผ่านหน้าเว็บในไม่กี่วินาที ยอดเงินอัปเดตไวและแม่นยำตรงเป๊ะ ไม่ต้องส่งสลิปยืนยัน และไม่ต้องเสียเวลารอแอดมินอนุมัติ ทุกจังหวะการเดิมพันจึงลื่นไหล จัดการทุนและถอนกำไรออกไปใช้ได้อย่างฉับไว",
  },
  {
    q: "โปรโมชันและโบนัสมีอะไรให้ตามต่อบ้าง",
    a: "ไลน์อัปโปรโมชันคิดมาเพื่อรองรับผู้เล่นทุกรูปแบบ ทั้งสิทธิประโยชน์สำหรับสมาชิกใหม่ โบนัสเติมเงินรายวันสำหรับสายลุยต่อเนื่อง และสิทธิ์รับเครดิตพิเศษตามช่วงเวลา นอกจากนี้ยังหมุนเวียนกิจกรรมพิเศษมาเติมไม่ขาดสาย ทั้งคืนยอดเสียประจำวัน โค้ดเครดิตฟรีตามเทศกาล และระบบสะสมแต้มแลกรางวัล",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxPremium as="h1" title="ASHTON168 สล็อตระบบแน่น เกมพร้อมรัน ออโต้ไวทันใจ โปรคุ้มสุด ๆ">
    <p class="text-left text-base leading-relaxed">
      ถ้าคุณกำลังมองหาเว็บสล็อตที่เน้นเสถียรภาพระดับท็อปและความฉับไวในทุกมิติ ASHTON168 คือทางเลือกที่ไม่ควรพลาด เว็บสล็อตที่มาพร้อมโครงสร้างระบบหลังบ้านแน่นหนา
      พร้อมรันทุกเกมสล็อตค่ายดังอย่างลื่นไหล ไร้ปัญหากระตุก โดดเด่นด้วยระบบออโต้ไฮสปีดที่จัดการเรื่องการเงินได้ทันใจ และคลังโปรโมชันสุดคุ้มที่จัดเต็มมาซัพพอร์ตสายปั่นทุกระดับ
      ให้คุณเข้าทำกำไรได้อย่างมั่นใจและต่อเนื่องตลอด 24 ชั่วโมง
    </p>
  </ContentBoxPremium>

  <ContentBoxTwoPremium
    as="h2"
    title="ASHTON168 สล็อตระบบแน่น พร้อมรันเกมค่ายชั้นนำแบบเต็มล็อบบี้"
    titleleft="เชื่อมตรงเซิร์ฟเวอร์หลักของค่ายดัง"
    titleright="กราฟิกคมชัด ไม่ค้างกลางโบนัส">
    <p slot="left" class="text-left text-base leading-relaxed">
      เบื้องหลังความสนุกที่ไม่มีสะดุดของ ASHTON168 คือการวางโครงสร้างระบบหลังบ้านที่เสถียรและทรงพลัง รองรับการเชื่อมต่อตรงเข้าสู่เซิร์ฟเวอร์หลักของค่ายเกมยักษ์ใหญ่ทั่วโลก
      ตัวระบบพร้อมรันทุกเกมสล็อตได้อย่างสมูธ แม้ในช่วงเวลาที่มีผู้เข้าใช้งานพร้อมกันจำนวนมาก
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      กราฟิกแสดงผลได้คมชัดเต็มประสิทธิภาพ เอฟเฟกต์เสียงตื่นเต้น และไม่มีอาการเกมค้างหรือหลุดระหว่างลุ้นโบนัสก้อนโตอย่างแน่นอน
    </p>
  </ContentBoxTwoPremium>

  <ContentBoxSpecial as="h2" title="ค่ายชั้นนำมีอะไรน่าเล่น ASHTON168 รวมตัวฮิตไว้ให้เลือกแบบไม่ต้องไล่หา">
    <p slot="left" class="text-left text-base leading-relaxed">
      ภายในล็อบบี้ของ ASHTON168 ได้รวบรวมเกมสล็อตตัวตึงกระแสแรงจากค่ายชั้นนำระดับโลกไว้แบบครบวงจร ไม่ว่าจะเป็นค่ายเกมสายภาพสวย 3D ค่ายเกมสายแตกโหดตัวคูณเยอะ
      หรือค่ายเกมยอดนิยมตลอดกาล
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
