---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBox3ThreeFloatingBadge from "../components/ContentBox3ThreeFloatingBadge.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgBonus from "../assets/slide4.png";
import imgCashout from "../assets/slide3.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxFloatingBadge as="h1"
//   2 → ContentBox as="h2"
//   3 → ContentBox3ThreeFloatingBadge (ส่ง title อย่างเดียว แล้วแบ่งย่อหน้าเดียว
//       ลง left/center/right ที่รอยต่อประโยค)
//   4 → ContentBoxSevenThree + slide4 (ฝากครั้งแรก รับโบนัส 10%)
//   5 → ContentBoxTwoFloatingBadge (ส่ง title อย่างเดียว แบ่งลง left/right)
//   6 → ContentBoxSevenThreeNeumorphism + slide3 (ฝาก 1,000 รับ 1,300)
//   7 → ContentBox as="h2"
//
// SevenThree ใช้ 2 บล็อกเท่านั้น (โควตาเต็ม) และแต่ละตัวส่งหัวข้อเดียว
// (titleright ของ ContentBoxSevenThree / title ของ Neumorphism ซึ่ง map ไป
// คอลัมน์ขวา) ถ้าส่งทั้งซ้ายและขวาจะได้ h2 เกินจำนวนหัวข้อ docx
//
// docx ของแบรนด์นี้แบนราบ (H1 + H2 ล้วน ไม่มี H3) จึงห้ามส่ง titleleft/
// titlecenter/titleright เข้า *FloatingBadge สองตัวนั้น — prop ชุดนั้น render
// เป็น <h3> h3 ที่หน้านี้ต้องเป็น 0
//
// slide1/slide2 อยู่ใน SmoothCarousel อย่างเดียว, slide3/slide4 อยู่ใน
// SevenThree อย่างละบล็อก — รูปหนึ่งใบมีบ้านเดียว ไม่ซ้ำกันในหน้าเดียว
// banner2/3/4 เป็นอาร์ตของแบรนด์ก่อนหน้า จึงไม่ถูก import ที่ไหนในหน้านี้
//
// widget ที่ไม่ได้มาจาก docx (ProviderGrid, GameRankingBoard, SmoothCarousel,
// LoginRtpSection, LatestWinners, ReviewCardSumo2, แถวปุ่ม login/register)
// ใช้หัวข้อเป็น <p>/<span> + aria-label บน <section> จึงวางต่อท้ายหัวข้อ docx
// ที่มันสังกัดได้โดยลำดับ H2 ไม่เพี้ยน
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx + หัวข้อ FAQ ที่หน้านี้เขียนเอง = 7
// คำถามใน Faq2 เป็น <span> ตามระดับเดิมที่ variant นั้น ship มา ไม่ใช่ <h3>

const pageTitle = "BUFFXBET | สล็อตเว็บตรงสายคุ้ม โบนัสเน้น กำไรอิ่มคุ้ม ถอนคล่องจริง";

// Meta description ยาว 159 ตัวอักษร — verify-build บังคับช่วง 150–160 ตัวอักษร
// บรรทัด Des ของ docx ยาว 143 จึงต่อท้ายด้วยวลีสรุปจาก docx ข้อ 7 ให้เข้าช่วง
const pageDescription =
  "BUFFXBET สล็อตเว็บตรงสายคุ้ม รวมเกมฮิตจากค่ายดัง โบนัสเน้นทุกจังหวะ เล่นสนุกลุ้นกำไรอิ่มคุ้มได้ไม่อั้น ระบบออโต้ลื่น ฝากถอนคล่องจริงใช้งานสะดวก ครบจบในที่เดียว";

// AnnouncementCyber มี default message ของตัวเอง แต่ default ของ Announcement
// ทุก variant คือสโลแกนของแบรนด์เก่าคนละเจ้ากัน จึงส่ง message ตรงๆ เสมอ
const announcementMessage =
  "BUFFXBET สล็อตเว็บตรงสายคุ้ม โบนัสเน้น กำไรอิ่มคุ้ม ถอนคล่องจริง • เหมาค่ายเกมระดับท็อปฮิตมารวมไว้ที่เดียวจบ ทั้งแนวแอคชั่น แฟนตาซี และสไตล์คลาสสิก ภาพคมชัดระดับไฮเอนด์ • โบนัสตัวคูณ ฟรีสปิน และรางวัลยิบย่อยโผล่มาเพิ่มสีสันตลอดเกม ลุ้นกำไรพุ่งกระฉูดได้ไม่อั้น • ระบบออโต้เสถียร ลื่นไหลไม่มีค้างหรือหน่วง มือใหม่เข้าใจระบบได้ในไม่กี่วินาที • ฝากถอนคล่องตัวจริง ชนะปุ๊บสั่งถอนปั๊บ เงินเด้งเข้าบัญชีทันใจ เล่นต่อได้ไม่ขาดตอน";

const faqs = [
  {
    q: "BUFFXBET สล็อตเว็บตรงสายคุ้ม เล่นแล้วคุ้มค่าจริงไหม",
    a: "ใครกำลังมองหาเว็บที่เล่นแล้วรู้สึกคุ้มค่าทุกบาททุกสตางค์ ต้องมารวมกันตรงนี้ BUFFXBET เป็นสล็อตเว็บตรงที่ไม่ได้มีดีแค่ชื่อ แต่จัดเต็มเรื่องความคุ้มแบบเน้นๆ โบนัสแตกง่าย กำไรอิ่มๆ แถมถอนเงินได้คล่องปรื๊ด ไม่มีสะดุดให้หงุดหงิดใจ",
  },
  {
    q: "รวมเกมฮิตจากค่ายดังไว้เยอะแค่ไหน เล่นนานๆ แล้วเบื่อหรือเปล่า",
    a: "สายขี้เบื่อถูกใจสิ่งนี้แน่นอน ไม่ต้องคอยสลับเว็บไปมาให้วุ่นวาย เพราะเขาเหมาค่ายเกมระดับท็อปฮิตมารวมไว้ที่เดียวจบ ไม่ว่าจะเป็นแนวแอคชั่น แฟนตาซี หรือสไตล์คลาสสิก ก็มีให้เลือกเพียบ ภาพคมชัดระดับไฮเอนด์ จะสลับเปลี่ยนกี่เกมก็ยังสนุกเหมือนเดิม",
  },
  {
    q: "โบนัสของ BUFFXBET แจกแบบไหนบ้าง มีอะไรนอกจากแจ็คพอตใหญ่",
    a: "จังหวะการแจกของที่นี่ทำมาได้ตื่นเต้นมาก ไม่ใช่แค่รอแจ็คพอตใหญ่อย่างเดียว แต่มีรางวัลยิบย่อย โบนัสตัวคูณ และฟรีสปินโผล่มาช่วยเพิ่มสีสันตลอดเกม ทำให้กราฟกำไรพุ่งกระฉูดได้แบบไม่อั้น ลุ้นตัวโก่งกันทุกวินาทีจริงๆ",
  },
  {
    q: "ระบบออโต้ใช้งานยากไหม มือใหม่เริ่มเล่นเองได้เลยหรือเปล่า",
    a: "ระบบออโต้ของที่นี่ทำมาเสถียรมาก ลื่นไหลไม่มีอาการค้างหรือหน่วง ไม่ว่าจะกดรับโปรโมชั่น ย้ายค่ายเกม หรือตั้งค่าเมนูต่างๆ ก็ตอบสนองรวดเร็วทันใจ ใช้งานง่ายสุดๆ มือใหม่ก็เข้าใจระบบได้ในไม่กี่วินาทีตั้งแต่ก้าวแรกที่กดสมัคร",
  },
  {
    q: "ฝากถอนกับ BUFFXBET ต้องรอนานไหม ถอนแล้วเงินเข้าเร็วแค่ไหน",
    a: "เรื่องเงินๆ ทองๆ เป็นอะไรที่ซีเรียสสุด แต่กับที่นี่บอกลาความกังวลไปได้เลย เพราะระบบฝากถอนคล่องตัวจริงตามคำเคลม ทำรายการผ่านระบบออโต้แบบไม่ต้องรอยอดนานให้เสียอารมณ์ ชนะปุ๊บ สั่งถอนปั๊บ เงินเด้งเข้าบัญชีทันใจ โฟกัสกับการเล่นต่อได้ไม่ขาดตอน",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxFloatingBadge as="h1" title="BUFFXBET สล็อตเว็บตรงสายคุ้ม โบนัสเน้น กำไรอิ่มคุ้ม ถอนคล่องจริง">
    <p class="text-left text-base leading-relaxed">
      ใครกำลังมองหาเว็บที่เล่นแล้วรู้สึกคุ้มค่า ทุกบาททุกสตางค์ บอกเลยว่าต้องมารวมกันตรงนี้! วันนี้ขอแวะมารีวิวและป้ายยาเว็บที่กำลังมาแรงอย่าง BUFFXBET
      สล็อตเว็บตรงที่ไม่ได้มีดีแค่ชื่อ แต่จัดเต็มเรื่องความคุ้มแบบเน้นๆ โบนัสแตกง่าย กำไรอิ่มๆ แถมที่สำคัญคือถอนเงินได้คล่องปรื๊ด ไม่มีสะดุดให้หงุดหงิดใจ
      ใครสายปั่นที่ชอบความพรีเมียมและมั่นคง ขอท้าให้ลองสัมผัสด้วยตัวเองเลย
    </p>
  </ContentBoxFloatingBadge>

  <ContentBox as="h2" title="BUFFXBET สล็อตเว็บตรงสายคุ้ม จุดรวมความสนุกที่เล่นได้แบบอิ่มคุ้ม">
    <p class="text-left text-base leading-relaxed">
      เอาจริงๆ นะ หลายคนคงเคยเจอเว็บที่เล่นแป๊บๆ ก็เบื่อ หรือรู้สึกว่าได้ไม่คุ้มเสีย แต่ที่นี่เปลี่ยนภาพจำนั้นไปเลย เพราะเขาออกแบบมาให้เป็นจุดศูนย์รวมความสนุกที่ตอบโจทย์คนอยากเล่นยาวๆ
      อินเทอร์เฟซดูแพงสบายตา ฟีเจอร์ต่างๆ ถูกจัดวางมาอย่างใส่ใจ ทำให้ทุกการสปินของคุณรู้สึกถึงความเป็นวีไอพี และอิ่มเอมกับความคุ้มค่าที่หาจากที่อื่นยาก
    </p>
  </ContentBox>

  <ContentBox3ThreeFloatingBadge title="รวมเกมฮิตจากค่ายดัง เลือกเล่นสนุกได้หลากหลายไม่มีเบื่อ">
    <p slot="left" class="text-left text-base leading-relaxed">
      สายขี้เบื่อถูกใจสิ่งนี้แน่นอน! ไม่ต้องคอยสลับเว็บไปมาให้วุ่นวาย เพราะเขาเหมาค่ายเกมระดับท็อปฮิตมารวมไว้ที่เดียวจบ
    </p>
    <p slot="center" class="text-left text-base leading-relaxed">
      ไม่ว่าจะเป็นแนวแอคชั่น แฟนตาซี หรือสไตล์คลาสสิก ก็มีให้เลือกเพียบ แต่ละเกมบอกเลยว่าคัดมาแล้วเน้นๆ ภาพคมชัดระดับไฮเอนด์
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      เล่นเพลินจนลืมเวลา จะสลับเปลี่ยนกี่เกมก็ยังสนุกและลุ้นมันส์เหมือนเดิม
    </p>
  </ContentBox3ThreeFloatingBadge>

  <ProviderGrid />

  <GameRankingBoard />

  <ContentBoxSevenThree titleright="โบนัสเน้นทุกจังหวะ เพิ่มสีสันให้ลุ้นกำไรได้ไม่อั้นที่ BUFFXBET">
    <Picture
      slot="left"
      src={imgBonus}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น BUFFXBET ฝากครั้งแรก รับโบนัส 10% พร้อมภาพกล่องของขวัญสีน้ำเงินผูกโบว์ ลูกโป่งใส และกรอบรูปที่มีสัญลักษณ์ของขวัญบนพื้นสีน้ำเงินม่วงประกายแสง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#3b8df1]/30 shadow-[0_10px_30px_rgba(59,141,241,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      ทีเด็ดที่พลาดไม่ได้เลยคือเรื่องโบนัส นี่แหละ! ขอรีวิวตรงนี้เลยว่าจังหวะการแจกของเขาทำมาได้ตื่นเต้นมาก ไม่ใช่แค่รอแจ็คพอตใหญ่อย่างเดียว แต่มีรางวัลยิบย่อย โบนัสตัวคูณ
      และฟรีสปินโผล่มาช่วยเพิ่มสีสันตลอดเกม ทำให้กราฟกำไรของเราพุ่งกระฉูดได้แบบไม่อั้น ลุ้นตัวโก่งกันทุกวินาทีจริงๆ
    </p>
  </ContentBoxSevenThree>

  <SmoothCarousel />

  <ContentBoxTwoFloatingBadge title="ระบบออโต้ลื่น ตอบสนองไวทุกขั้นตอน ใช้งานสะดวกตั้งแต่เริ่ม">
    <p slot="left" class="text-left text-base leading-relaxed">
      มารีวิวเว็บทั้งทีจะไม่พูดถึงระบบหลังบ้านก็คงไม่ได้ สิ่งที่ทำให้ประทับใจตั้งแต่ก้าวแรกที่กดสมัครคือ "ความไว" ระบบออโต้ของที่นี่ทำมาเสถียรมาก ลื่นไหลไม่มีอาการค้างหรือหน่วง
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      ไม่ว่าจะกดรับโปรโมชั่น ย้ายค่ายเกม หรือตั้งค่าเมนูต่างๆ ก็ตอบสนองรวดเร็วทันใจ ใช้งานง่ายสุดๆ มือใหม่ก็เข้าใจระบบได้ในไม่กี่วินาที
    </p>
  </ContentBoxTwoFloatingBadge>

  <LoginRtpSection />

  <ContentBoxSevenThreeNeumorphism title="ฝากถอนคล่องจริง BUFFXBET ทำรายการง่าย พร้อมเล่นต่อได้ทันใจ">
    <Picture
      slot="left"
      src={imgCashout}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น BUFFXBET สมาชิกใหม่ ฝาก 1,000 รับ 1,300 ถอนสูงสุด 2,500 บาท พร้อมภาพโพดำสวมมงกุฎทอง ไพ่ และลูกเต๋าบนพื้นสีน้ำเงินที่มีเส้นแสงโค้ง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#f5c542]/30 shadow-[0_10px_30px_rgba(245,197,66,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      เรื่องเงินๆ ทองๆ เป็นอะไรที่ซีเรียสสุด แต่กับที่นี่บอกลาความกังวลไปได้เลย เพราะระบบฝากถอนเขาคล่องตัวจริงตามคำเคลม ทำรายการผ่านระบบออโต้แบบไม่ต้องรอยอดนานให้เสียอารมณ์
      ชนะปุ๊บ สั่งถอนปั๊บ เงินเด้งเข้าบัญชีทันใจแบบเอ็กซ์คลูซีฟสุดๆ ทำให้เรามีสมาธิโฟกัสกับการเล่นต่อได้แบบไม่ขาดตอน
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <LatestWinners />

  <ContentBox as="h2" title="เปิดประสบการณ์สล็อต BUFFXBET ครบทั้งเกม โบนัส และความคุ้มในที่เดียว">
    <p class="text-left text-base leading-relaxed">
      สรุปเลยละกัน สำหรับใครที่ยังลังเล ขอบอกเลยว่า BUFFXBET คือตัวจบของการเล่นสล็อตเว็บตรงในตอนนี้แล้ว ทั้งความหลากหลายของเกม โบนัสที่จัดหนักจัดเต็ม ระบบที่ลื่นไหลเฉียบคม
