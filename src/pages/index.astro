---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBox3ThreeCyberCut from "../components/ContentBox3ThreeCyberCut.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners3 from "../components/LatestWinners3.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq4 from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgPromoDeposit500 from "../assets/slide3.png";
import imgGoldWheel from "../assets/slide1.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxCyberCut as="h1" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   2 → ContentBoxTwoNeumorphism as="h2" (แบ่งย่อหน้าเดียวลง left/right) แล้วต่อด้วย
//       ProviderGridPremium ซึ่งเป็นภาพประกอบของหัวข้อเดียวกันเรื่องคลังเกมลิขสิทธิ์
//       จากค่ายใหญ่มาตรฐานสากล
//   3 → ContentBoxFloatingBadge as="h2" (ย่อหน้าเดียวใน slot เดียว) แล้วต่อด้วย
//       GameRankingBoard ซึ่งกางลิสต์เกมที่เพิ่งเข้าคลังของหัวข้อเดียวกัน
//   4 → ContentBox3ThreeCyberCut as="h2" (ย่อหน้าเดียวของ docx ระบุฟีเจอร์ไว้พอดี
//       สามกลุ่ม — Multiplier / Wild ซ้อนทับ กับ Cascading / Bonus Buy — จึงลง
//       คอลัมน์ละกลุ่มตามลำดับประโยคเดิม)
//   5 → ContentBoxSevenThreeCyberCut as="h2" + slide3 (โปสเตอร์โปรฝาก 500 ขึ้นไป
//       รับเพิ่ม 10% ตรงกับหัวข้อเรื่องโปรน่าสนใจ) แล้วต่อด้วย LatestWinners3
//   6 → ContentBoxSpecial as="h2" (บล็อกสองครึ่ง)
//   7 → ContentBoxSevenThreeNeumorphism as="h2" + slide1 (โปสเตอร์ปั่นกงล้อรับทองคำ
//       ซึ่งเป็นกิจกรรมที่กดได้จบในเว็บเดียว ตรงกับหัวข้อสุดท้าย)
//
// variant รอบนี้หมุนทั้งตระกูลจากรอบก่อน: ทรง ContentBox ย้ายจากชุด Premium +
// plain + Special มาเป็นชุด CyberCut + Neumorphism + FloatingBadge + Special
// ส่วน Navbar เป็น NavbarStyle9, Footer เป็น FooterPremiumSumo, Announcement เป็น
// AnnouncementPremium, LatestWinners เป็น LatestWinners3, Faq เป็น Faq4 และ
// provider grid เป็น ProviderGridPremium
//
// Announcement ส่ง message ตรงๆ เสมอ เพราะ default ของทุก variant ในตระกูลนี้เป็น
// สโลแกนของแบรนด์เก่าคนละเจ้ากัน ข้อความชุดนี้ตรงกับ default ของ AnnouncementPremium
// เป๊ะ เพื่อให้ ticker ของหน้าย่อยที่เรียก <Announcement /> เปล่าๆ วิ่งข้อความเดียวกับ
// หน้าแรก และห้ามขึ้นต้นด้วย emoji เพราะ marquee render ข้อความซ้ำและ emoji ที่ฝัง
// ในสตริงถูก mark aria-hidden ไม่ได้
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook — slide3 คู่กับหัวข้อข้อ 5 และ slide1
// คู่กับหัวข้อข้อ 7 ส่วน slide2 ปรากฏบนหน้านี้เฉพาะในแถบ SmoothCarousel (ที่อยู่จริง
// ของมันคือกริดหน้า /promotion) และ slide4 เป็นอาร์ตค้างของแบรนด์ก่อน ห้าม import
// ที่ไหนทั้งสิ้น เช่นเดียวกับ banner ทุกหมายเลข — รูปที่ import คือรูปที่ถูก emit
// ถึงจะไม่มีใคร render ก็ตาม ส่วน banner1 กับ banner1-mobile เป็นของ MainLayout
// จัดการเอง
//
// widget ที่ไม่ได้มาจาก docx (LoginRtpSection, ReviewCardSumo2, SmoothCarousel,
// แถวปุ่ม login/register, FAQ, Navfoot) ใช้ป้ายเป็น <p>/<span> + aria-label บน
// <section> และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้ายทั้งชุด ยกเว้นสามตัวที่เป็น
// ภาพประกอบของหัวข้อ docx หนึ่งข้อโดยตรง (ProviderGridPremium → ข้อ 2,
// GameRankingBoard → ข้อ 3, LatestWinners3 → ข้อ 5) ซึ่งวางต่อท้ายบล็อกนั้นๆ
//
// h1 ×1 + h2 ×6 = หัวข้อ docx พอดี ไม่มีตัวที่แปด — หัว FAQ เป็น <p> ใน Faq4.astro
// คำถามใน Faq4 เป็น <span> ใน <summary> และป้ายคอลัมน์ของทุก ContentBox variant
// เป็น <p> — docx รอบนี้แบน H1 + H2 ล้วน หน้านี้จึงไม่มี h3 เลย
//
// title ใช้บรรทัด Title ของ docx ตรงๆ (57 ตัวอักษร) ส่วน description ใช้บรรทัด Des
// ของ docx ต่อหางให้อยู่ในเกท 150–160 ตัวอักษรของ tools/verify-build.mjs (156
// ตัวอักษร) ค่าที่ใช้เป็นสตริงเดียวกับที่ส่งเข้า pageGraph ตรงกับที่ส่งให้ MainLayout
// และตรงกับ default ที่ MainLayout ตั้งไว้เป๊ะ
const pageTitle = "GUESS168 | สล็อตคัดเกรด เกมลิขสิทธิ์แน่น ฝากถอนออโต้ทันใจ";
const pageDescription = "GUESS168 สล็อตคัดเกรด เกมลิขสิทธิ์แน่นจากค่ายดัง อัปเดตใหม่มีให้ตาม ฟีเจอร์ครบ โปรน่าสนใจ ฝากถอนออโต้ทันใจใน 3 วินาที รวมทุกจังหวะการเล่นไว้ครบจบในเว็บเดียว";

const announcementMessage =
  "GUESS168 สล็อตคัดเกรด เกมลิขสิทธิ์แน่น ฝากถอนออโต้ทันใจ • เว็บตรง API แท้ ยิงตรงจากเซิร์ฟเวอร์หลัก คัดเฉพาะสล็อตแตกง่ายค่า RTP สูง ไม่มีดัดแปลงเปอร์เซ็นต์ชนะ • ระบบฝากถอนออโต้ทำงานใน 3 วินาที ถอนปุ๊บเงินเข้าปั๊บ ไร้เทิร์นโอเวอร์จุกจิก ปั่นได้เท่าไหร่ถอนออกได้ครบทุกบาท • คัดกรองเฉพาะค่ายใหญ่มาตรฐานสากล PG Soft Pragmatic Play และ Joker Gaming ทุกเกมผ่านการทดสอบอัตราจ่าย เบทเริ่มต้น 1 บาทก็ลุ้นโบนัสก้อนโตได้ทันที • ค่ายใหญ่ปล่อยเกมไหน อัปเดตเข้าคลังทันทีใน 24 ชั่วโมง พร้อมโหมดทดลองเล่นฟรีให้เช็กจังหวะโบนัสและกลไกเกมก่อนลงเงินจริง • ฟีเจอร์อัดแน่นทั้ง Multiplier สุ่มตัวคูณหนัก ระบบ Wild ซ้อนทับ คอมโบแตกต่อเนื่อง Cascading และโหมด Bonus Buy ซื้อฟรีสปิน • โบนัสต้อนรับเพิ่มทุนสปิน โปรฝากแรกของวัน และระบบคืนยอดเสีย Cash Back ทุกวัน กดรับเองผ่านหน้าเว็บ เงื่อนไขชัดเจน ไม่ติดล็อกยูส • กระเป๋าเดียวจบ เลือกเกม สลับค่าย กดรับโปร และกดถอนกำไร ทำได้ครบผ่านหน้าแดชบอร์ดเดียว";

// FAQ ห้าข้อเขียนจากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้าไหนมา
// ทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบคำถาม
// ที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq4> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน
const faqs = [
  {
    q: "GUESS168 เป็นเว็บตรงจริงไหม แล้วค่า RTP ถูกดัดแปลงหรือเปล่า",
    a: "เป็นเว็บตรงที่ใช้ API แท้ยิงตรงจากเซิร์ฟเวอร์หลักของค่ายเกม ไม่มีการดัดแปลงเปอร์เซ็นต์ชนะระหว่างทาง เกมที่คัดเข้าคลังจึงเป็นสล็อตแตกง่ายที่ค่า RTP สูงตามที่ค่ายตั้งไว้จริง และเมื่อรวมกับกติกาที่ไม่มีเทิร์นโอเวอร์จุกจิก ปั่นได้เท่าไหร่ก็ถอนออกได้ครบทุกบาทโดยไม่มีเงื่อนไขซ่อนไว้ตอนกดถอน",
  },
  {
    q: "ในคลังมีค่ายเกมอะไรบ้าง แล้วต้องเบทขั้นต่ำเท่าไหร่ถึงจะลุ้นโบนัสได้",
    a: "คลังคัดกรองเฉพาะค่ายใหญ่มาตรฐานสากลอย่าง PG Soft, Pragmatic Play และ Joker Gaming ไม่เอาเกมไร้คุณภาพมาลงให้รกคลัง ทุกเกมผ่านการทดสอบอัตราจ่ายและจ่ายจริงตามอัลกอริทึมโรงงาน ส่วนเรื่องทุนไม่ต้องอัดหนักตั้งแต่ไม้แรก เพราะเบทเริ่มต้นที่ 1 บาทก็อยู่ในเงื่อนไขลุ้นโบนัสก้อนโตได้ทันทีเหมือนกัน",
  },
  {
    q: "เกมที่ค่ายเพิ่งปล่อยใหม่ ต้องรอนานแค่ไหน แล้วลองเล่นก่อนได้ไหม",
    a: "ไม่ต้องรอข้ามสัปดาห์และไม่ต้องคอยให้กระแสซา เพราะค่ายใหญ่ปล่อยเกมไหนก็ถูกอัปเดตเข้าคลังภายใน 24 ชั่วโมง ไม่มีขั้นตอนรอระบบอนุมัติมาคั่น และทุกเกมมีโหมดทดลองเล่นฟรีให้กดเข้าไปเช็กจังหวะโบนัสกับกลไกของเกมก่อนลงเงินจริง จึงจับทางตัวใหม่ได้ก่อนตัดสินใจวางเบท",
  },
  {
    q: "ฟีเจอร์ในเกมมีอะไรบ้าง แล้วสายใจร้อนควรเลือกโหมดไหน",
    a: "ลูกเล่นหลักมีสี่กลุ่ม ได้แก่ Multiplier ที่สุ่มแจกตัวคูณหนัก ระบบ Wild ซ้อนทับ คอมโบแตกต่อเนื่องแบบ Cascading และโหมด Bonus Buy สายใจร้อนที่อยากพุ่งตรงเข้าลุ้นรางวัลใหญ่มักเลือก Bonus Buy เพราะซื้อฟรีสปินเข้ารอบได้เลย ส่วนคนที่ชอบลุ้นยาวในสปินเดียวจะถูกใจ Cascading ที่แตกต่อกันเป็นชุดมากกว่า",
  },
  {
    q: "โปรมีอะไรบ้าง ต้องแจ้งแอดมินไหม แล้วฝากถอนใช้เวลานานเท่าไหร่",
    a: "สิทธิ์หลักมีโบนัสต้อนรับเพิ่มทุนสปิน โปรฝากแรกของวัน และระบบคืนยอดเสีย Cash Back ทุกวัน ทั้งหมดกดรับเองผ่านหน้าเว็บโดยไม่ต้องแจ้งแอดมิน เงื่อนไขเขียนไว้ชัดเจนและไม่ติดล็อกยูส ส่วนการทำรายการวิ่งผ่าน Gateway ตรง ฝากถอนเสร็จใน 3-5 วินาที ไม่ต้องโอนสลิปและไม่ต้องคอยคิวอนุมัติ",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxCyberCut as="h1" title="GUESS168 สล็อตคัดเกรด เกมลิขสิทธิ์แน่น ฝากถอนออโต้ทันใจ">
    <p class="text-left text-base leading-relaxed">
      GUESS168 เว็บตรง API แท้ ยิงตรงจากเซิร์ฟเวอร์หลัก คัดเฉพาะสล็อตแตกง่ายค่า RTP สูง ไม่มีดัดแปลงเปอร์เซ็นต์ชนะ ระบบฝากถอนออโต้ทำงานใน 3 วินาที ถอนปุ๊บเงินเข้าปั๊บ ไร้เทิร์นโอเวอร์จุกจิก
      ปั่นได้เท่าไหร่ถอนออกได้ครบทุกบาท
    </p>
  </ContentBoxCyberCut>

  <ContentBoxTwoNeumorphism
    as="h2"
    title="GUESS168 สล็อตคัดเกรด เปิดคลังเกมลิขสิทธิ์จากค่ายดังแบบเน้นตัวมีของ"
    titleleft="คัดเฉพาะค่ายใหญ่มาตรฐานสากล"
    titleright="ทดสอบอัตราจ่ายทุกเกม เบทเริ่ม 1 บาท">
    <p slot="left" class="text-left text-base leading-relaxed">GUESS168 สล็อตคัดเกรด คัดกรองเฉพาะค่ายใหญ่มาตรฐานสากล เช่น PG Soft, Pragmatic Play, และ Joker Gaming ไม่เอาเกมไร้คุณภาพมาลงให้รกคลัง</p>
    <p slot="right" class="text-left text-base leading-relaxed">ทุกเกมผ่านการทดสอบอัตราจ่าย จ่ายจริงตามอัลกอริทึมโรงงาน เบทเริ่มต้น 1 บาทก็ลุ้นโบนัสก้อนโตได้ทันที</p>
  </ContentBoxTwoNeumorphism>

  <ProviderGridPremium />

  <ContentBoxFloatingBadge as="h2" title="เกมอัปเดตใหม่มีอะไรให้ตาม? GUESS168 เติมตัวน่าลองเข้าลิสต์ต่อเนื่อง">
    <p class="text-left text-base leading-relaxed">
      ค่ายใหญ่ปล่อยเกมไหน GUESS168 อัปเดตเข้าคลังทันทีใน 24 ชั่วโมง ไม่ต้องคอยกระแสซา ไม่ต้องรอระบบอนุมัติข้ามสัปดาห์ พร้อมโหมดทดลองเล่นฟรีให้เช็กจังหวะโบนัสและกลไกเกมก่อนลงเงินจริง
      เข้าถึงเกมใหม่ไฟแรงได้ก่อนใครตลอดเวลา
    </p>
  </ContentBoxFloatingBadge>

  <GameRankingBoard />

  <ContentBox3ThreeCyberCut
    as="h2"
    title="ฟีเจอร์ครบแค่ไหน เจาะลูกเล่นในเกมที่ช่วยให้แต่ละสปินไม่ซ้ำฟีล"
    titleleft="Multiplier สุ่มตัวคูณหนัก"
    titlecenter="Wild ซ้อนทับ และ Cascading"
    titleright="Bonus Buy ซื้อฟรีสปิน">
    <p slot="left" class="text-left text-base leading-relaxed">กดสปินที่นี่ไม่มีคำว่ากริบ ตัวเกมอัดแน่นด้วยฟีเจอร์ Multiplier สุ่มตัวคูณหนัก</p>
    <p slot="center" class="text-left text-base leading-relaxed">ระบบ Wild ซ้อนทับ และคอมโบแตกต่อเนื่อง Cascading</p>
    <p slot="right" class="text-left text-base leading-relaxed">พร้อมโหมด Bonus Buy ซื้อฟรีสปินพุ่งตรงเข้าลุ้นรางวัลใหญ่ทันที ทุกการหมุนมีจังหวะให้ลุ้น ไม่น่าเบื่อ ไม่ปล่อยให้เสียจังหวะฟรี</p>
  </ContentBox3ThreeCyberCut>

  <ContentBoxSevenThreeCyberCut as="h2" title="โปรน่าสนใจของ GUESS168 มีอะไรบ้าง เลือกสิทธิ์ให้เข้ากับจังหวะเล่น" titleleft="ฝาก 500 ขึ้นไปรับเพิ่ม 10%">
    <Picture
      slot="left"
      src={imgPromoDeposit500}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 767px) 92vw, 340px"
      decoding="async"
