---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBox from "../components/ContentBox.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners from "../components/LatestWinners2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlotProviders from "../assets/slide1.png";
import imgBaccaratBonus from "../assets/slide2.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxPremium as="h1"
//   2 → ContentBoxSevenThreePremium as="h2" + slide1 (เว็บสล็อตค่ายดัง การันตีคุณภาพ)
//   3 → ContentBox3ThreePremium as="h2" (แบ่งย่อหน้าเดียวลง left/center/right ที่รอยต่อประโยค)
//   4 → ContentBoxSevenThreeCyberCut as="h2" + slide2 (เว็บบาคาร่าครบทุกค่าย โบนัส 100%)
//   5 → ContentBoxTwoFloatingBadge as="h2" (แบ่งย่อหน้าเดียวลง left/right)
//   6 → ContentBoxSpecial as="h2" (สองครึ่ง หนึ่ง element ต่อหนึ่ง slot)
//   7 → ContentBox as="h2" (การ์ดกลางที่ terms/privacy ใช้ร่วม)
//
// variant รอบนี้หมุนทั้งตระกูลจากแบรนด์ก่อนหน้า (ซึ่งใช้ CyberCut +
// SevenThreeNeumorphism + TwoCyberCut + SevenThreeFloatingBadge +
// 3ThreeNeumorphism + Neumorphism + plain) มาเป็นทรง Premium + 3ThreePremium +
// CyberCut(SevenThree) + TwoFloatingBadge + Special + plain ส่วน Faq ย้ายจาก Faq4
// มาเป็น Faq2, Announcement จาก AnnouncementCyber มาเป็น Announcement3,
// LatestWinners จาก LatestWinners3 มาเป็น LatestWinners2 และ ProviderGrid จาก
// ProviderGridPremium มาเป็นตัวธรรมดา
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook — slide1 (เว็บสล็อตค่ายดัง
// การันตีคุณภาพ) คู่กับหัวข้อคลังเกมใหม่ที่ขนเกมตัวตึงจากทุกค่ายมารวมไว้ และ
// slide2 (เว็บบาคาร่าครบทุกค่าย สมาชิกใหม่รับโบนัสสูงสุด 100%) คู่กับหัวข้อโบนัส
// หลายรูปแบบ ส่วน slide3 (แทงบอล) กับ slide4 (แทงมวย) ไม่ถูก import ในไฟล์นี้
// เช่นเดียวกับ banner.png และ banner2/3/4 ที่เป็นอาร์ตค้างของแบรนด์ก่อนๆ —
// รูปที่ import คือรูปที่ถูก emit ถึงจะไม่มีใคร render ก็ตาม
//
// banner1 เป็น hero ที่ MainLayout จัดการเอง รอบนี้จึงไม่มีรูปประกอบใน ContentBox
// เดี่ยว
//
// widget ที่ไม่ได้มาจาก docx (ProviderGrid, GameRankingBoard, LatestWinners,
// LoginRtpSection, ReviewCardSumo2, SmoothCarousel, แถวปุ่ม login/register, FAQ)
// ใช้ป้ายเป็น <p>/<span> + aria-label บน <section> และถูกวางต่อท้ายหัวข้อ docx
// ข้อสุดท้ายทั้งชุด จึงไม่มีตัวไหนคั่นระหว่างหัวข้อ docx สองข้อเลย
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx + หัวข้อ FAQ ที่หน้านี้ส่งเป็น prop = 7
// คำถามใน Faq2 เป็น <span> ใน <summary> ไม่ใช่ h3 และป้ายคอลัมน์ของ
// ContentBox3ThreePremium / ContentBoxTwoFloatingBadge เป็น <p> — docx รอบนี้แบน
// H1 + H2 ล้วน หน้านี้จึงไม่มี h3 เลย
const pageTitle = "BOOST168 | สล็อตเว็บตรงจัดหนัก เกมดีมีบูสต์ ระบบไวไม่เกินจริง";
// บรรทัด Des ของ docx ยาว 159 ตัวอักษร อยู่ในเกท 150–160 ของ verify-build พอดี
// จึงใช้ตรงๆ ไม่ต้องขยายหรือตัด
const pageDescription =
  "BOOST168 สล็อตเว็บตรงจัดหนัก อัปคลังเกมใหม่ให้มีของตามต่อ เกมดีมีบูสต์ เติมทั้งฟีเจอร์และโบนัสหลายรูปแบบ ระบบไวไม่เกินจริง พร้อมออโต้ช่วยให้ทุกขั้นตอนคล่องขึ้น";

// default message ของ Announcement ทุก variant คือสโลแกนของแบรนด์เก่าคนละเจ้ากัน
// จึงส่ง message ตรงๆ เสมอ ไม่พึ่ง default และห้ามขึ้นต้นด้วย emoji
const announcementMessage =
  "BOOST168 สล็อตเว็บตรงจัดหนัก เกมดีมีบูสต์ ระบบไวไม่เกินจริง • อัปเดตคลังเกมสล็อตใหม่อยู่ตลอดเวลา ขนเกมตัวตึงจากทุกค่ายชั้นนำมารวบรวมไว้ให้เลือกเล่นแบบไม่ขาดช่วง ครบทั้งแนวสตรีทสุดมันส์ แฟนตาซีเวทมนตร์ และคลาสสิกโบนัสแตกง่าย • เกมดีมีบูสต์ด้วยฟีเจอร์สุ่มคูณเงินรางวัล ฟีเจอร์รีสปินล็อกสัญลักษณ์ และโหมดฟรีสปินที่ออกบ่อยเข้าถึงได้ง่าย • โบนัสหลายรูปแบบยืดหยุ่นตามสไตล์การเล่น ทั้งโปรโมชันต้อนรับสมาชิกใหม่ โบนัสเติมเงินรายวัน และกิจกรรมพิเศษคืนกำไรให้ผู้เล่น • ระบบไวไม่เกินจริง หน้าเว็บโหลดฉับไว กดเข้าเกมได้ทันที เชื่อมต่อตรงกับค่ายเกมหลักอย่างเสถียร ไม่มีอาการกระตุกหรือเกมหลุด • ระบบออโต้ลดขั้นตอนตั้งแต่สมัครสมาชิก กดรับโปรโมชัน ไปจนถึงฝากถอน จบได้เองในไม่กี่คลิก • จากเกมใหม่ถึงระบบออโต้ จัดทุกส่วนให้พร้อมบูสต์ไว้ในที่เดียวตลอด 24 ชั่วโมง";

// FAQ ห้าข้อเขียนจากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้าไหนมา
// ทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบคำถาม
// ที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน
const faqs = [
  {
    q: "BOOST168 อัปเดตเกมใหม่บ่อยแค่ไหน และมีเกมแนวไหนให้เลือกบ้าง",
    a: "คลังเกมสล็อตถูกอัปเดตอยู่ตลอดเวลา โดยขนเกมตัวตึงจากทุกค่ายชั้นนำมารวบรวมไว้ให้เลือกเล่นอย่างจุใจ ครบทั้งแนวสตรีทสุดมันส์ แนวแฟนตาซีเวทมนตร์ และแนวคลาสสิกโบนัสแตกง่าย ทุกเกมผ่านการคัดสรรว่ามีคุณภาพสูง กราฟิกสวยงาม และมีจังหวะการจ่ายรางวัลที่น่าลุ้น จึงเปลี่ยนบรรยากาศเล่นเกมเด็ดตามกระแสได้แบบไม่ขาดช่วง",
  },
  {
    q: "คำว่าเกมดีมีบูสต์ของ BOOST168 หมายถึงอะไร",
    a: "ไม่ได้หมายถึงแค่เรื่องภาพสวย แต่หมายถึงตัวเกมที่อุดมไปด้วยฟีเจอร์ช่วยเพิ่มโอกาสการทำกำไรแบบจัดเต็ม ทั้งฟีเจอร์สุ่มคูณเงินรางวัล ฟีเจอร์รีสปินล็อกสัญลักษณ์ และโหมดฟรีสปินที่ออกบ่อยและเข้าถึงได้ง่าย ลูกเล่นเสริมเหล่านี้ทำให้การหมุนวงล้อแต่ละรอบมีความหมายมากกว่าการลุ้นสัญลักษณ์ธรรมดา",
  },
  {
    q: "สมาชิกจะได้รับโบนัสรูปแบบไหนบ้าง",
    a: "สิทธิประโยชน์ถูกออกแบบให้หลากหลายและยืดหยุ่นตามสไตล์การเล่นของแต่ละคน ทั้งโปรโมชันต้อนรับสำหรับสมาชิกใหม่ โบนัสเติมเงินรายวัน และกิจกรรมพิเศษที่คอยคืนกำไรให้ผู้เล่น ทุกสิทธิ์ช่วยเติมทุนให้ออกไปปั่นสล็อตได้นานขึ้น จึงเพิ่มโอกาสลุ้นรางวัลแจ็คพอตก้อนโตโดยไม่ต้องใช้ทุนเยอะ",
  },
  {
    q: "ระบบไวไม่เกินจริงของที่นี่วัดจากอะไร",
    a: "วัดจากการใช้งานจริง ไม่ใช่คำเคลม หน้าเว็บโหลดฉับไว กดเข้าเกมแล้วเข้าได้ทันทีโดยไม่ต้องรอนาน และสัญญาณเชื่อมต่อตรงกับค่ายเกมหลักอย่างเสถียร ระบบหลังบ้านถูกพัฒนาให้ตอบสนองรวดเร็วแบบพอดี ทุกจังหวะการเล่นจึงคล่องตัว ไม่มีปัญหากระตุกหรือเกมหลุดมาทำลายบรรยากาศการทำกำไร",
  },
  {
    q: "ระบบออโต้ช่วยลดขั้นตอนตรงไหนบ้าง",
    a: "ระบบออโต้เข้ามาจัดการตั้งแต่กระบวนการสมัครสมาชิก การกดรับโปรโมชัน ไปจนถึงขั้นตอนการทำรายการฝากและถอนเงิน ทุกอย่างถูกลดความซับซ้อนลงให้ผู้เล่นจัดการเองได้ภายในไม่กี่คลิก ทำรายการได้รวดเร็ว แม่นยำ และปลอดภัย จึงประหยัดเวลาและเอาเวลาไปโฟกัสกับเกมโปรดได้เต็มที่",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxPremium as="h1" title="BOOST168 สล็อตเว็บตรงจัดหนัก เกมดีมีบูสต์ ระบบไวไม่เกินจริง">
    <p class="text-left text-base leading-relaxed">
      เตรียมพบกับมิติใหม่ของการปั่นสล็อตที่เข้าถึงง่ายและเร้าใจยิ่งกว่าเดิมที่ BOOST168 เว็บตรงสายลุยที่ไม่ได้มีดีแค่คำคุย แต่จัดหนักให้จริงทั้งเรื่องค่ายเกมและอัตราการจ่ายรางวัล
      ที่นี่ถูกออกแบบมาเพื่อเติมเต็มความตื่นเต้นให้ผู้เล่นทุกระดับ ด้วยระบบการทำงานที่เสถียร สมูธ และตอบสนองได้อย่างรวดเร็วแบบไม่เกินจริง ลืมภาพเว็บสล็อตที่โฆษณาเกินจริงไปได้เลย
      เพราะที่นี่เน้นให้คุณได้สัมผัสความสนุกของการสปินแบบลื่นไหล ลุ้นโบนัสได้แบบต่อเนื่องในทุกๆ วัน
    </p>
  </ContentBoxPremium>

  <ContentBoxSevenThreePremium
    as="h2"
    title="BOOST168 สล็อตเว็บตรงจัดหนัก เปิดคลังเกมใหม่ให้มีตัวเด็ดตามต่อไม่ขาดช่วง"
    titleleft="คลังเกมอัปใหม่ตลอด">
    <Picture
      slot="left"
      src={imgSlotProviders}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 767px) 92vw, 340px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่นแนวนอนพื้นม่วงน้ำเงิน มุมบนซ้ายเป็นโลโก้ BOOST168 พร้อมจรวด ข้อความตัวใหญ่สีขาวขอบทองว่า เว็บสล็อต ค่ายดัง และแถบว่า การันตีคุณภาพ ใต้ลงมาเขียนว่า สล็อตแตกจริง จ่ายจริง ปลอดภัย 100% พร้อมไอคอนสามข้อ ระบบออโต้ฝากถอนรวดเร็วทันใจ มาตรฐานสากลมั่นคงปลอดภัยเชื่อถือได้ และบริการลูกค้า 24 ชั่วโมง ด้านขวาเป็นหญิงสาวชุดม่วงถือไพ่เอสองใบยืนหน้าตู้สล็อต มีเหรียญทองลอยรอบตัว และป้ายสมัครสมาชิกใหม่รับโบนัสสูงสุด 100% ฝาก-ถอนไม่มีขั้นต่ำ แถบล่างเป็นโลโก้ทรูมันนี่วอลเล็ต ค่ายเกม และไลน์ไอดี @boost168"
      class="mx-auto h-auto w-full rounded-2xl border border-[#ffc233]/40 shadow-[0_10px_30px_rgba(255,194,51,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      ไม่มีคำว่าเหงาหรือจำเจเมื่อเข้ามาใช้งานที่ BOOST168 เพราะที่นี่มีการอัปเดตคลังเกมสล็อตใหม่อยู่ตลอดเวลา ขนเอาเกมตัวตึงจากทุกค่ายชั้นนำมารวบรวมไว้ให้เลือกเล่นอย่างจุใจ
      ไม่ว่าจะเป็นเกมแนวสตรีทสุดมันส์ แนวแฟนตาซีเวทมนตร์ หรือแนวคลาสสิกโบนัสแตกง่าย ทุกเกมถูกคัดสรรมาแล้วว่ามีคุณภาพสูง กราฟิกสวยงาม และมีจังหวะการจ่ายรางวัลที่น่าลุ้น
      ให้คุณได้เปลี่ยนบรรยากาศเล่นเกมเด็ดตามกระแสได้แบบไม่ขาดช่วง
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBox3ThreePremium
    as="h2"
    title="เกมดีมีบูสต์ตรงไหน? ลองแกะฟีเจอร์เด็ดที่ทำให้แต่ละเกมมีลูกเล่นมากขึ้น"
    titleleft="นิยามของคำว่าเกมดีมีบูสต์"
    titlecenter="ฟีเจอร์ที่ใส่มาให้ในตัวเกม"
    titleright="ผลลัพธ์ที่ได้ในทุกรอบสปิน">
    <p slot="left" class="text-left text-base leading-relaxed">
      นิยามคำว่าเกมดีมีบูสต์ของ BOOST168 ไม่ใช่แค่เรื่องภาพสวย แต่หมายถึงตัวเกมที่อุดมไปด้วยฟีเจอร์ช่วยเพิ่มโอกาสการทำกำไรแบบจัดเต็ม
    </p>
    <p slot="center" class="text-left text-base leading-relaxed">
      ไม่ว่าจะเป็นฟีเจอร์สุ่มคูณเงินรางวัล ฟีเจอร์รีสปินล็อกสัญลักษณ์ หรือโหมดฟรีสปินที่ออกบ่อยและเข้าถึงได้ง่าย
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      ลูกเล่นเสริมเหล่านี้แหละที่เข้ามาช่วยยกระดับความสนุก ทำให้การหมุนวงล้อในแต่ละรอบมีความหมายมากกว่าแค่การลุ้นสัญลักษณ์ธรรมดา เพิ่มมิติความตื่นเต้นให้ปั่นเพลินได้ตลอดวัน
    </p>
  </ContentBox3ThreePremium>

  <ContentBoxSevenThreeCyberCut as="h2" title="อัปความสนุกอีกระดับกับ BOOST168 โบนัสหลายรูปแบบมีอะไรน่าจับตาบ้าง">
    <Picture
      slot="left"
      src={imgBaccaratBonus}
      loading="lazy"
      fetchpriority="low"
