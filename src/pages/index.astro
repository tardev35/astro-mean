---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement2.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBox3ThreeCyberCut from "../components/ContentBox3ThreeCyberCut.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners3 from "../components/LatestWinners3.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Faq2 from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgCommissionRebate from "../assets/slide2.png";
import imgSystemUpdateGold from "../assets/slide3.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxNeumorphism as="h1" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   2 → ContentBoxSevenThreeCyberCut as="h2" + slide2 (อาร์ตสไลด์เขียนว่า "คืนค่า
//       คอมมิสชั่นสูงสุด นับจากยอดเดิมพันทุกครั้ง" พร้อมช่องสล็อตกับบาคาร่าอยู่ใน
//       ป้ายเดียวกัน ซึ่งเป็นภาพของ One-Stop Service ที่ย่อหน้านี้พูดถึง — ทุกจังหวะ
//       การเล่นอยู่ในบัญชีเดียวโดยไม่ต้องสลับเว็บ)
//   3 → ContentBox3ThreeCyberCut as="h2" (ย่อหน้าเดียวแบ่งลงสามคอลัมน์ตามลำดับ
//       ประโยคเดิม: คัดค่ายเกรด A → คัดเกมตัวท็อปที่จ่ายโปร่งใส → ตัดเกมไร้คุณภาพ
//       ออกทั้งหมด) แล้วต่อด้วย ProviderGrid ซึ่งกางโลโก้ค่ายที่ย่อหน้าเดียวกัน
//       เอ่ยชื่อไว้
//   4 → ContentBoxTwoFloatingBadge as="h2" (ย่อหน้าเดียวแบ่งสองครึ่ง: จัดหมวดหมู่
//       หน้าเว็บเป็นระบบ → ค้นหาเจอในไม่กี่คลิกและสลับฟีลได้ตรงสไตล์)
//   5 → ContentBoxCyberCut as="h2" (ย่อหน้าเดียวเต็มๆ) แล้วต่อด้วย FeatureHighlights
//       (ฟีเจอร์ย่อยสามตัวที่ย่อหน้านี้ระบุชื่อไว้ตรงๆ → h3 สามตัว ซึ่งเป็น h3 ชุด
//       เดียวที่ได้รับอนุญาตบนหน้านี้)
//   6 → ContentBoxSevenThreeNeumorphism as="h2" + slide3 (อาร์ตสไลด์เขียนว่า
//       "อัพเดทระบบใหม่ มาพร้อมระบบสุ่ม ลุ้นรับทองคำแท่งและเครดิตฟรี" ตรงกับย่อหน้า
//       เรื่องอัปเกรดเซิร์ฟเวอร์หลังบ้าน) แล้วต่อด้วย SmoothCarousel กับ
//       GameRankingBoard ซึ่งเป็นล็อบบี้ที่สลับไปมาได้ต่อเนื่องตามที่ย่อหน้านี้พูดถึง
//   7 → ContentBoxTwoNeumorphism as="h2" (ย่อหน้าเดียวแบ่งสองครึ่ง: รองรับ iOS /
//       Android / แท็บเล็ต / คอม → จัดวางปุ่มกับเมนูให้ใช้ง่ายตลอด 24 ชั่วโมง) แล้ว
//       ต่อด้วย LatestWinners3 ซึ่งเป็นหลักฐานว่าระบบออโต้เดินเร็วเท่ากันทั้งวัน
//
// variant รอบนี้หมุนออกจากชุดของแบรนด์ก่อนทั้งตระกูล: ทรง ContentBox เปลี่ยนจากชุด
// Premium นำ มาเป็น CyberCut ×3 + Neumorphism ×3 + FloatingBadge ×1 ส่วน
// Announcement เป็น Announcement2, LatestWinners เป็น LatestWinners3, ProviderGrid
// เป็นตัวเปล่า, ReviewCard เป็น ReviewCardSumo และ Faq เป็น Faq2 — Navbar/Footer/
// ฟอนต์ ถูกสลับไว้แล้วใน MainLayout กับ brandProfile
//
// ContentBoxSevenThree* ทั้งสองตัวปล่อยหัวข้อจาก prop `title` ตัวเดียว ส่วน
// titleleft เป็นป้ายคอลัมน์รูปที่ยังเป็น <p> — ห้ามส่ง titleright เข้าไป เพราะตัว
// Neumorphism จะเพิ่มป้ายซ้อนใต้หัวข้อเดียวกัน
//
// Announcement ส่ง message ตรงๆ เสมอ เพราะ default ของทุก variant ในตระกูลนี้เป็น
// สโลแกนของแบรนด์เก่าคนละเจ้ากัน ข้อความชุดนี้ต้องตรงกับ default ของ Announcement2
// เป๊ะ เพื่อให้ ticker ของหน้าย่อยที่เรียก <Announcement /> เปล่าๆ วิ่งข้อความเดียว
// กับหน้าแรก และห้ามขึ้นต้นด้วย emoji เพราะ marquee render ข้อความซ้ำและ emoji ที่
// ฝังในสตริงถูก mark aria-hidden ไม่ได้
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook คู่กับ slide2/slide3 ซึ่งเป็นสไลด์ที่
// อาร์ตตรงกับหัวข้อ docx ข้อ 2 กับข้อ 6 พอดี — slide1 (คืนยอดเสีย/แนะนำเพื่อน) กับ
// slide4 (ทายแชมป์ฟุตบอลโลก) ไม่มีหัวข้อ docx ไหนรองรับและเพดาน SevenThree เต็มแล้ว
// จึงปล่อยไว้ให้หน้า /promotion ใช้ ส่วน banner ทุกหมายเลข (banner2/3/4) เป็นอาร์ต
// ของแบรนด์ก่อน ห้าม import ที่นี่หรือที่ไหนก็ตาม เพราะรูปที่ import คือรูปที่ถูก
// emit ถึงจะไม่มีใคร render ก็ตาม ส่วน banner1 กับ banner1-mobile เป็นของ MainLayout
// จัดการเอง และรูปในหน้านี้ไม่มีตัวไหนใส่ loading="eager"/fetchpriority="high"
// เพราะ LCP เป็นของ hero ใน MainLayout
//
// widget ที่ไม่ได้มาจาก docx (LoginRtpSection, ReviewCardSumo, แถวปุ่ม
// login/register, FAQ, Navfoot) ใช้ป้ายเป็น <p>/<span> + aria-label บน <section>
// และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้ายทั้งชุด ยกเว้นสี่ตัวที่เป็นภาพประกอบของ
// หัวข้อ docx หนึ่งข้อโดยตรง (ProviderGrid → ข้อ 3, SmoothCarousel กับ
// GameRankingBoard → ข้อ 6, LatestWinners3 → ข้อ 7) ซึ่งวางต่อท้ายบล็อกนั้นๆ
//
// h1 ×1 + h2 ×6 = หัวข้อ docx พอดี บวก h3 ×3 จาก FeatureHighlights ซึ่งเป็นรายการ
// ย่อยของหัวข้อข้อ 5 ตามข้อยกเว้นเดียวที่ playbook อนุญาต — หัว FAQ เป็น <p> ใน
// Faq2.astro คำถามเป็น <span> ใน <summary> และป้ายคอลัมน์ของทุก ContentBox variant
// เป็น <p>
//
// title ใช้บรรทัด Title ของ docx ส่วน description ต่อท้ายด้วย "ฝากถอนออโต้ไวใน 3
// วินาที" ให้ยาว 158 ตัวอักษร เข้ากรอบ 150–160 ของเกทคุณภาพ (บรรทัด Des ดิบของ docx
// ยาว 133 ตัว ซึ่งต่ำกว่ากรอบ) และเป็นสตริงเดียวกับที่ส่งเข้า pageGraph และ MainLayout
const pageTitle = "XONEBET | สล็อตวันสต็อป เกมตัวท็อปครบวงจร ระบบใหม่ไหลลื่น";
const pageDescription =
  "XONEBET สล็อตวันสต็อป เกมตัวท็อปครบวงจร เปิดล็อบบี้เจอของน่าเล่นแบบไม่ต้องไล่หา ฟีเจอร์ใหม่พร้อมลั่น ระบบใหม่ไหลลื่น รองรับทุกอุปกรณ์ ฝากถอนออโต้ไวใน 3 วินาที";

const announcementMessage =
  "XONEBET สล็อตวันสต็อป เกมตัวท็อปครบวงจร ระบบใหม่ไหลลื่น • เว็บตรง API แท้ ยิงสัญญาณตรงจากเซิร์ฟเวอร์หลักนอก ไม่ผ่านเอเย่นต์ ค่า RTP โปร่งใสตามมาตรฐานสากล ไม่มีปรับแต่งเปอร์เซ็นต์การชนะ • ยึดโครงสร้าง One-Stop Service เต็มรูปแบบ รวมคลังเกมทุกค่ายชั้นนำและระบบการเงินไว้ในบัญชีเดียว ไม่ต้องสมัครหลายยูสเซอร์ ไม่ต้องโยกเงินข้ามค่ายให้สับสน • คัดเฉพาะค่ายใหญ่ระดับเกรด A อย่าง PG Soft, Pragmatic Play และ Joker Gaming เน้นเกมตัวท็อปที่โครงสร้างการจ่ายเงินโปร่งใส จังหวะฟรีสปินเข้าไว และอัตราคูณสะสมสูง • จัดหมวดหมู่หน้าเว็บอย่างเป็นระบบ แยกตามประเภทเกม ค่ายดัง และหมวดเกมกระแสมาแรง ค้นหาเกมที่ใช่เจอได้ในไม่กี่คลิก • ฟีเจอร์ใหม่พร้อมลั่นมาครบ ทั้งระบบสุ่มแจกตัวคูณทวีคูณ Multipliers สัญลักษณ์ Wild ซ้อนทับ คอมโบแตกต่อเนื่องแบบ Cascading และโหมด Buy Feature สำหรับสายใจร้อน • อัปเกรดเซิร์ฟเวอร์หลังบ้านประมวลผลความเร็วสูง สลับค่ายเกมและโหลดหน้าอินเทอร์เฟซได้ฉับไว ไร้ปัญหาเกมค้าง กระตุก หรือเด้งหลุดกลางทาง • วางระบบแสดงผลแบบ Responsive 100% รองรับเต็มรูปแบบทั้งมือถือ iOS, Android, แท็บเล็ต และคอมพิวเตอร์ • ฝากถอนออโต้ประมวลผลไวใน 3 วินาที ไม่ติดเทิร์นจุกจิก ถอนออกได้เต็มจำนวนทุกยอด";

// FAQ ห้าข้อเขียนขึ้นใหม่จากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้า
// ไหนมาทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบ
// คำถามที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq2> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน — ห้ามปล่อยให้
// Faq2 ใช้ค่า default ของตัวเอง เพราะ default ของทุก variant ในตระกูลนี้เป็นคำถาม
// ของแบรนด์เก่า
const faqs = [
  {
    q: "XONEBET ต่อเกมมาจากไหน แล้วค่า RTP ถูกปรับแต่งหรือเปล่า",
    a: "XONEBET เป็นเว็บตรง API แท้ ยิงสัญญาณตรงจากเซิร์ฟเวอร์หลักนอกโดยไม่ผ่านเอเย่นต์ ค่า RTP จึงโปร่งใสตามมาตรฐานสากลและไม่มีการปรับแต่งเปอร์เซ็นต์การชนะ ทุกเกมในล็อบบี้รันบนอัตราจ่ายชุดเดียวกับที่ค่ายผู้พัฒนากำหนดไว้",
  },
  {
    q: "ต้องสมัครหลายยูสเซอร์เพื่อเล่นข้ามค่ายไหม",
    a: "ไม่ต้อง เพราะยึดโครงสร้าง One-Stop Service เต็มรูปแบบ เชื่อมคลังเกมจากทุกค่ายชั้นนำและระบบการเงินไว้ในบัญชีเดียว ไม่ต้องสมัครหลายยูสเซอร์และไม่ต้องโยกเงินข้ามค่ายให้สับสน เลือกเล่น สลับเกม และจัดการถอนกำไรได้ทันทีผ่านหน้าแดชบอร์ดเดียว",
  },
  {
    q: "ในล็อบบี้มีค่ายอะไรบ้าง แล้วคัดเกมด้วยเกณฑ์อะไร",
    a: "คัดกรองเฉพาะค่ายใหญ่ระดับเกรด A อย่าง PG Soft, Pragmatic Play และ Joker Gaming เกณฑ์คือโครงสร้างการจ่ายเงินต้องโปร่งใส จังหวะฟรีสปินเข้าไว และมีอัตราคูณสะสมสูง ส่วนเกมไร้คุณภาพถูกตัดออกทั้งหมดเพื่อให้ทุกสปินมีโอกาสทำเงินได้จริงตั้งแต่เปิดล็อบบี้",
  },
  {
    q: "หาเกมที่อยากเล่นยากไหม แล้วมีฟีเจอร์อะไรให้ลุ้นบ้าง",
    a: "หน้าเว็บจัดหมวดหมู่อย่างเป็นระบบ แยกตามประเภทเกม ค่ายดัง และหมวดเกมกระแสมาแรง ค้นหาเกมที่ใช่ได้ในไม่กี่คลิก ส่วนฟีเจอร์มาครบทั้งระบบสุ่มแจกตัวคูณทวีคูณ Multipliers สัญลักษณ์ Wild ซ้อนทับ คอมโบแตกต่อเนื่องแบบ Cascading และโหมด Buy Feature สำหรับสายใจร้อน",
  },
  {
    q: "เล่นบนมือถือได้ไหม แล้วฝากถอนใช้เวลานานแค่ไหน",
    a: "ระบบแสดงผลเป็น Responsive 100% รองรับเต็มรูปแบบทั้งมือถือ iOS, Android, แท็บเล็ต และคอมพิวเตอร์ ปรับสเกลภาพคมชัดเข้ากับทุกหน้าจอ ส่วนการเงินเป็นระบบฝากถอนออโต้ที่ประมวลผลไวใน 3 วินาที ไม่ติดเทิร์นจุกจิก และถอนออกได้เต็มจำนวนทุกยอดตลอด 24 ชั่วโมง",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxNeumorphism as="h1" title="XONEBET สล็อตวันสต็อป เกมตัวท็อปครบวงจร ระบบใหม่ไหลลื่น">
    <p class="text-left text-base leading-relaxed">
      XONEBET เว็บตรง API แท้ ยิงสัญญาณตรงจากเซิร์ฟเวอร์หลักนอก ไม่ผ่านเอเย่นต์ ค่า RTP โปร่งใสตามมาตรฐานสากล ไม่มีปรับแต่งเปอร์เซ็นต์การชนะ รวมเกมสล็อตค่ายใหญ่ครบวงจรไว้ในกระเป๋าเดียว
      มาพร้อมระบบฝากถอนออโต้ประมวลผลไวใน 3 วินาที ไม่ติดเทิร์นจุกจิก ปั่นง่าย ทำกำไรได้จริงและถอนออกได้เต็มจำนวนทุกยอด
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxSevenThreeCyberCut
    as="h2"
    title="XONEBET สล็อตวันสต็อป รวมทุกจังหวะการเล่นไว้ครบแบบไม่ต้องสลับเว็บ"
    titleleft="คืนค่าคอมมิสชั่นสูงสุด นับจากยอดเดิมพันทุกครั้ง">
    <Picture
      slot="left"
      src={imgCommissionRebate}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 767px) 92vw, 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
