---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBox3ThreeCyberCut from "../components/ContentBox3ThreeCyberCut.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners3 from "../components/LatestWinners3.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgAllProviders from "../assets/slide2.png";
import imgBonusCashback from "../assets/slide1.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxNeumorphism as="h1" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   2 → ContentBoxTwoNeumorphism as="h2" (แบ่งย่อหน้าเดียวลง left/right)
//   3 → ContentBox3ThreeCyberCut as="h2" (แบ่งย่อหน้าเดียวลง left/center/right)
//   4 → ContentBoxSevenThreeCyberCut as="h2" + slide2 (แบนเนอร์คืนยอดเสียสล็อต 10%
//       ทุกค่าย ตรงกับหัวข้อเรื่องเกมค่ายดังหลายแนว) แล้วต่อด้วย ProviderGrid ซึ่ง
//       เป็นภาพประกอบของหัวข้อเดียวกัน
//   5 → ContentBoxTwoFloatingBadge as="h2" (แบ่งย่อหน้าเดียวลง left/right) แล้วต่อ
//       ด้วย GameRankingBoard ซึ่งเป็นตัวอย่างของเมนูที่จัดวางให้หยิบใช้คล่อง
//   6 → ContentBoxSevenThreeNeumorphism as="h2" + slide1 (แบนเนอร์เล่นเสียก็ได้คืน
//       รับเลย 5% ตรงกับหัวข้อเรื่องโบนัสรับได้เลย) แล้วต่อด้วย LatestWinners3
//   7 → ContentBoxFloatingBadge as="h2" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//
// variant รอบนี้หมุนทั้งตระกูลจากรอบก่อน: ทรง ContentBox ย้ายจากชุด plain +
// Premium + Special มาเป็นชุด Neumorphism + CyberCut + FloatingBadge ส่วน Navbar
// เป็น NavbarStyle6, Footer เป็น FooterCyber, Announcement เป็น AnnouncementCyber,
// LatestWinners เป็น LatestWinners3 และ Faq เป็น Faq2
//
// Announcement ส่ง message ตรงๆ เสมอ เพราะ default ของทุก variant ในตระกูลนี้เป็น
// สโลแกนของแบรนด์เก่าคนละเจ้ากัน ข้อความชุดนี้ตรงกับ default ของ AnnouncementCyber
// เป๊ะ เพื่อให้ ticker ของหน้าย่อยที่เรียก <Announcement /> เปล่าๆ วิ่งข้อความ
// เดียวกับหน้าแรก และห้ามขึ้นต้นด้วย emoji เพราะ marquee render ข้อความซ้ำและ
// emoji ที่ฝังในสตริงถูก mark aria-hidden ไม่ได้
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook — slide2 คู่กับหัวข้อข้อ 4 และ
// slide1 คู่กับหัวข้อข้อ 6 ส่วน slide3 / slide4 กับ banner ทุกหมายเลขที่ไม่ใช่
// banner1 เป็นอาร์ตค้างของแบรนด์ก่อนๆ ห้าม import ที่ไหนทั้งสิ้น — รูปที่ import
// คือรูปที่ถูก emit ถึงจะไม่มีใคร render ก็ตาม ส่วน banner1 เป็นของ MainLayout
// จัดการเอง และ banner1-mobile ไม่มีอยู่ในรอบนี้
//
// widget ที่ไม่ได้มาจาก docx (LoginRtpSection, ReviewCardSumo2, SmoothCarousel,
// แถวปุ่ม login/register, FAQ, Navfoot) ใช้ป้ายเป็น <p>/<span> + aria-label บน
// <section> และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้ายทั้งชุด ยกเว้นสามตัวที่เป็น
// ภาพประกอบของหัวข้อ docx หนึ่งข้อโดยตรง (ProviderGrid → ข้อ 4,
// GameRankingBoard → ข้อ 5, LatestWinners3 → ข้อ 6) ซึ่งวางต่อท้ายบล็อกนั้นๆ
//
// h1 ×1 + h2 ×6 = หัวข้อ docx พอดี ไม่มีตัวที่แปด — หัว FAQ เป็น <p> ใน Faq2.astro
// คำถามใน Faq เป็น <span> ใน <summary> และป้ายคอลัมน์ของทุก ContentBox variant
// เป็น <p> — docx รอบนี้แบน H1 + H2 ล้วน หน้านี้จึงไม่มี h3 เลย
//
// title ใช้บรรทัด Title ของ docx ตรงๆ (61 ตัวอักษร) ส่วน description ใช้บรรทัด Des
// ของ docx (137 ตัวอักษร ต่ำกว่าเกท 150–160 ของ tools/verify-build.mjs ซึ่งจะทำให้
// build แดง) โดยต่อหางเป็น "ครบจบในเว็บเดียว" ให้ยาว 154 ตัวอักษร ค่าที่ใช้เป็น
// สตริงเดียวกับที่ส่งเข้า pageGraph และตรงกับที่ส่งให้ MainLayout
const pageTitle = "XTOP666 | สล็อตสปีดท็อป โหลดเกมไว ระบบพร้อมบวก โบนัสรับได้เลย";
const pageDescription =
  "XTOP666 สล็อตสปีดท็อป โหลดเกมไวผ่านลิงก์ตรงได้ทันใจ เกมค่ายดังให้เลือกเล่น ระบบพร้อมบวก โบนัสรับได้เลย ใช้งานต่อเนื่องได้ทั้งมือถือและคอม ครบจบในเว็บเดียว";

const announcementMessage =
  "XTOP666 สล็อตสปีดท็อป โหลดเกมไว ระบบพร้อมบวก โบนัสรับได้เลย • เว็บตรงสายสปีดที่ออกแบบมาเพื่อตัดทุกความล่าช้าออกไป ตั้งแต่โหลดเกมรวดเร็วฉับไว ระบบหลังบ้านเสถียรพร้อมบวกทุกสถานการณ์ • ปรับระบบให้ทำงานด้วยความเร็วสูงสุด คลิกเข้าหน้าเว็บแล้วประมวลผลขึ้นแสดงทันที ไม่ต้องนั่งรอหน้าจอโหมดหมุนติ้ว • ลิงก์ตรงทางเข้าไม่ผ่านหน้าเอเย่นต์ ตัดการกรอกข้อมูลซ้ำซ้อนและการยืนยันตัวตนหลายชั้นออก พุ่งตรงเข้าล็อบบี้เกมค่ายดังได้ในคลิกเดียว • คัดเกมค่ายชั้นนำมาหลากสไตล์ ทั้งแฟนตาซีภาพ 3D อลังการ คลาสสิกโบนัสแตกไว และสายสะสมตัวคูณ เลือกได้ตรงจริตทุกคน • วางเมนูฝากถอน คลังเกม ค่ายเกม และหน้ากิจกรรมไว้เป็นระเบียบ กดหยิบใช้งานได้ทันทีไม่ต้องคลิกวนหาหลายชั้น • โบนัสกดรับเองได้ก่อนเข้าตัวเกม ทั้งเครดิตเพิ่มทุนรายวันและสิทธิประโยชน์จากการเติมเงิน เพิ่มรอบสปินและโอกาสพิชิตแจ็คพอตก้อนใหญ่ • มือถือก็ไว คอมก็เต็มจอ ระบบปรับสเกลตามหน้าจอโดยอัตโนมัติ ลื่นไหลระดับเดียวกันในทุกช่องทาง";

// FAQ ห้าข้อเขียนจากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้าไหนมา
// ทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบคำถาม
// ที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน
const faqs = [
  {
    q: "XTOP666 บอกว่าเป็นสล็อตสปีดท็อป วัดความเร็วจากตรงไหน",
    a: "ความเร็วของที่นี่เริ่มนับตั้งแต่คลิกแรก ระบบถูกปรับแต่งให้ทำงานด้วยความเร็วสูงสุด พอเข้าหน้าเว็บก็ประมวลผลและดึงข้อมูลขึ้นมาแสดงผลทันที ไม่ต้องนั่งรอหน้าจอโหมดหมุนติ้ว การเร่งจังหวะตั้งแต่เริ่มต้นแบบนี้ทำให้ผู้เล่นไม่เสียเวลา ไม่เสียอารมณ์ และเข้าถึงหน้าเลือกเกมได้เร็วกว่าระบบทั่วไปหลายเท่า",
  },
  {
    q: "ลิงก์ตรงของ XTOP666 ตัดขั้นตอนอะไรออกไปบ้าง",
    a: "ลิงก์ตรงทางเข้าถูกพัฒนาให้ไม่ต้องผ่านหน้าเว็บเอเย่นต์หรือหน้าเปลี่ยนเส้นทางซับซ้อน จึงตัดขั้นตอนยุ่งยากออกไปได้ทั้งการกรอกข้อมูลซ้ำซ้อน การยืนยันตัวตนหลายชั้น และการรอโหลดหน้าคีย์ข้อมูล ผลคือคุณพุ่งตรงเข้าสู่หน้าล็อบบี้ของเกมค่ายดังระดับโลกได้ในคลิกเดียว โฟกัสอยู่กับเกมโปรดได้ทันที",
  },
  {
    q: "เกมในเว็บมีแนวไหนให้เลือกบ้าง",
    a: "เกมจากค่ายชั้นนำถูกคัดมาแบบพิถีพิถัน ไม่ได้เอาจำนวนเข้าขู่ แต่เน้นให้มีจุดเด่นหลากหลายสไตล์ ทั้งสล็อตแนวแฟนตาซีภาพ 3D อลังการ สล็อตสไตล์คลาสสิกที่เน้นโบนัสแตกไว และสล็อตสายสะสมตัวคูณสุดมันส์ ผู้เล่นทุกคนจึงเลือกเกมที่ตรงกับจริตและสไตล์การเล่นของตัวเองได้อย่างลงตัว",
  },
  {
    q: "หาเมนูฝากถอนหรือคลังเกมยากไหม ต้องคลิกวนหลายชั้นหรือเปล่า",
    a: "อินเทอร์เฟซออกแบบโดยคำนึงถึงผู้ใช้งานเป็นหลัก เมนูสำคัญอย่างปุ่มฝากถอน คลังเกม ค่ายเกม และหน้ากิจกรรมถูกวางตำแหน่งไว้อย่างเป็นระเบียบชัดเจน อยากใช้ฟังก์ชันไหนก็กดหยิบใช้งานได้ทันที ไม่ต้องคลิกวนหาหลายชั้นให้เสียเวลา ช่วยเพิ่มความคล่องตัวให้ลุยทำกำไรได้อย่างแม่นยำ",
  },
  {
    q: "โบนัสต้องรอทีมงานอนุมัติก่อนไหม และเล่นบนมือถือได้เต็มที่หรือเปล่า",
    a: "ระบบโบนัสเปิดให้ผู้เล่นเลือกกดรับสิทธิพิเศษได้เองทันทีก่อนเข้าสู่ตัวเกม ทั้งเครดิตเพิ่มทุนรายวันและสิทธิประโยชน์จากการเติมเงิน ช่วยเสริมสภาพคล่อง เพิ่มรอบการหมุนสปิน และยกระดับโอกาสพิชิตแจ็คพอตก้อนใหญ่ ส่วนการใช้งานครอบคลุมทุกอุปกรณ์ ตัวระบบปรับสเกลตามหน้าจอโดยอัตโนมัติ ทั้งมือถือและคอมจึงลื่นไหลระดับเดียวกัน",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxNeumorphism as="h1" title="XTOP666 สล็อตสปีดท็อป โหลดเกมไว ระบบพร้อมบวก โบนัสรับได้เลย">
    <p class="text-left text-base leading-relaxed">
      ปลดล็อกความสะใจของการปั่นสล็อตที่เน้นความเร็วระดับสปีดท็อปกับ XTOP666 เว็บตรงสายสปีดที่ถูกออกแบบมาเพื่อตัดทุกความล่าช้าออกไป ตั้งแต่การโหลดเกมที่รวดเร็วฉับไว
      ระบบหลังบ้านเสถียรพร้อมบวกทุกสถานการณ์ และโบนัสพิเศษที่พร้อมกดรับไปใช้เพิ่มทุนได้ทันทีโดยไม่มีเงื่อนไขยุ่งยาก ตอบโจทย์สายปั่นยุคใหม่ที่ต้องการความคล่องตัว
      ทำกำไรได้ต่อเนื่องแบบไม่มีสะดุด
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxTwoNeumorphism
    as="h2"
    title="XTOP666 สล็อตสปีดท็อป เร่งจังหวะเข้าเกมให้ไวตั้งแต่คลิกแรก"
    titleleft="ประมวลผลขึ้นทันทีตั้งแต่คลิกแรก"
    titleright="ถึงหน้าเลือกเกมไวกว่าหลายเท่า">
    <p slot="left" class="text-left text-base leading-relaxed">
      หัวใจสำคัญของ XTOP666 คือการปรับแต่งระบบให้ทำงานด้วยความเร็วสูงสุด ตั้งแต่คุณคลิกเข้าหน้าเว็บ ตัวระบบจะทำการประมวลผลและดึงข้อมูลขึ้นมาแสดงผลทันทีโดยไม่ต้องนั่งรอหน้าจอโหมดหมุนติ้ว
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      การเร่งจังหวะความเร็วตั้งแต่เริ่มต้นช่วยให้ผู้เล่นไม่เสียเวลา ไม่เสียอารมณ์ และเข้าสู่หน้าเลือกเกมได้รวดเร็วกว่าระบบทั่วไปหลายเท่า
    </p>
  </ContentBoxTwoNeumorphism>

  <ContentBox3ThreeCyberCut
    as="h2"
    title="ลิงก์ตรงของ XTOP666 ช่วยตัดขั้นตอนไหนบ้าง ก่อนพาเข้าสู่เกมค่ายดัง"
    titleleft="ไม่ผ่านหน้าเอเย่นต์"
    titlecenter="ตัดขั้นตอนซ้ำซ้อน"
    titleright="เข้าล็อบบี้ในคลิกเดียว">
    <p slot="left" class="text-left text-base leading-relaxed">ด้วยการพัฒนาลิงก์ตรงทางเข้าที่ไม่ผ่านหน้าเว็บเอเย่นต์หรือหน้าเปลี่ยนเส้นทางซับซ้อน</p>
    <p slot="center" class="text-left text-base leading-relaxed">
      XTOP666 จึงช่วยตัดขั้นตอนยุ่งยากอย่างการกรอกข้อมูลซ้ำซ้อน การยืนยันตัวตนหลายชั้น หรือการรอโหลดหน้าคีย์ข้อมูลออกไปจนหมด
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      ลิงก์ตรงนี้จะพาคุณพุ่งตรงเข้าสู่หน้าล็อบบี้ของเกมค่ายดังระดับโลกได้ในคลิกเดียว ช่วยรักษาจังหวะและโฟกัสการเล่นของคุณให้อยู่กับเกมโปรดได้ทันที
    </p>
  </ContentBox3ThreeCyberCut>

  <ContentBoxSevenThreeCyberCut
    as="h2"
    title="เกมค่ายดังไม่ได้มาแค่ให้ครบ XTOP666 คัดหลายแนวให้เลือกตามสไตล์"
    titleleft="สล็อต คืนยอดเสีย 10% ทุกค่าย">
    <Picture
      slot="left"
      src={imgAllProviders}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
