---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBox from "../components/ContentBox.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGridPremium.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgWelcomeBonus from "../assets/slide1.png";
import imgPayoutTrust from "../assets/slide4.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxPremium as="h1"
//   2 → ContentBoxSevenThreePremium + slide1 (เปิดยูสใหม่ รับความคุ้มค่าจัดเต็ม)
//   3 → ContentBoxTwoPremium (ส่ง title อย่างเดียว แล้วแบ่งย่อหน้าเดียวลง
//       left/right ที่รอยต่อประโยค — titleleft/titleright เป็น <p> ของ chrome)
//   4 → ContentBox3ThreePremium (ส่ง title อย่างเดียว แบ่งย่อหน้าลง
//       left/center/right)
//   5 → ContentBoxSpecial (สองครึ่ง แบ่งย่อหน้าเดียวลง left/right)
//   6 → ContentBoxSevenThreeFloatingBadge + slide4 (ถอนเงินชัวร์ไม่อั้น)
//   7 → ContentBox as="h2"
//
// SevenThree ใช้ 2 บล็อกเท่านั้น (โควตาเต็ม) และแต่ละตัวส่ง `title` เดียว
// ถ้าส่ง titleleft/titleright ด้วยจะได้หัวข้อเกินจำนวนหัวข้อ docx
//
// docx ของแบรนด์นี้แบนราบ (H1 + H2 ล้วน ไม่มี H3) — variant Premium ที่สลับเข้ามา
// รอบนี้เคย render หัวคอลัมน์เป็น <h3> (ContentBox3ThreePremium) จึงถูกลดเป็น <p>
// แล้วเพิ่ม prop `title` ตัวเดียวไว้รับหัวข้อ docx แทน ส่วน ContentBoxTwoPremium
// เดิมมีแต่ titleleft/titleright ที่ render เป็น <p> ของ chrome รอบนี้มันแบกหัวข้อ
// docx จริงจึงได้ prop `title` + `as` เพิ่ม — วิธีเดียวกับที่ ContentBox/ContentBoxTwo
// ทำไว้แล้ว
//
// slide2/slide3 อยู่ใน SmoothCarousel อย่างเดียว, slide1/slide4 อยู่ใน SevenThree
// อย่างละบล็อก — รูปหนึ่งใบมีบ้านเดียว ไม่ซ้ำกันในหน้าเดียว
// banner2/3/4 กับ banner.png เป็นอาร์ตของแบรนด์ก่อนหน้า (mtime 2026-08-04) จึงไม่
// ถูก import ที่ไหน ส่วน banner1/banner1-mobile เป็น hero ที่ MainLayout จัดการเอง
//
// widget ที่ไม่ได้มาจาก docx (SmoothCarousel, ProviderGrid, GameRankingBoard,
// LatestWinners, LoginRtpSection, ReviewCardSumo2, แถวปุ่ม login/register) ใช้
// หัวข้อเป็น <p>/<span> + aria-label บน <section> จึงวางต่อท้ายหัวข้อ docx ที่มัน
// สังกัดได้โดยลำดับ h2 ไม่เพี้ยน
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx + หัวข้อ FAQ ที่หน้านี้เขียนเอง = 7
// คำถามใน Faq4 เป็น <span> ตามระดับที่ variant นั้น ship มา ไม่ใช่ <h3>

// Title มาจาก docx ตรงตัว ส่วน Des ของ docx นับได้ 149 ตัวอักษร ต่ำกว่าขั้นต่ำ
// 150 ที่ verify-build บังคับอยู่หนึ่งตัว จึงขยายคำท้ายสุดจาก "ระบบออโต้ไวที่สุด"
// เป็น "ระบบฝากถอนออโต้ไวที่สุด" (ถ้อยคำจากหัวข้อที่ 7 ของ docx เอง) ได้ 155 ตัว
// อักษร ไม่ได้เติมข้อความที่ brief ไม่ได้พูดถึง
const pageTitle = "IOK66 สมัครสมาชิกเว็บสล็อตต่างประเทศ แจกหนัก ลิขสิทธิ์แท้ 100%";
const pageDescription = "IOK66 เปิดยูสสมัครสมาชิกเว็บสล็อตต่างประเทศ ลิขสิทธิ์แท้ 100% ส่งตรงจากค่ายแม่ การันตีแจกหนัก แตกง่าย ไม่ล็อคผล ถอนเงินชัวร์ไม่อั้น ระบบฝากถอนออโต้ไวที่สุด";

// default message ของ Announcement ทุก variant คือสโลแกนของแบรนด์เก่าคนละเจ้ากัน
// จึงส่ง message ตรงๆ เสมอ ไม่พึ่ง default แม้รอบนี้ default จะถูกอัปเดตแล้วก็ตาม
const announcementMessage =
  "IOK66 สมัครสมาชิกเว็บสล็อตต่างประเทศ ลิขสิทธิ์แท้ 100% แตกง่าย แจกหนัก • เปิดยูสใหม่ขั้นตอนสั้นกระชับ ไม่ต้องกรอกข้อมูลส่วนตัวให้วุ่นวาย รับสิทธิพิเศษและโปรโมชั่นต้อนรับไปต่อยอดเป็นทุนเดิมพันได้ทันที • ทุกเกมส่งตรงจากค่ายแม่ผ่านระบบ API แท้ที่ดึงจากเซิร์ฟเวอร์หลัก ภาพไม่กระตุก ไม่ค้างช่วงโบนัสไทม์ • ค่า RTP สูงกว่าเว็บทั่วไป ไม่ปรับลดอัตราการชนะ สแกตเตอร์และฟรีสปินมาบ่อย • สุ่มผลด้วยกลไก RNG ที่ตรวจสอบได้และรับรองจากสถาบันอิสระ โปร่งใส 100% ไม่มีแอดมินแทรกแซงผลรางวัล • ถอนได้เต็มจำนวนไม่หักเปอร์เซ็นต์ ไม่ต้องทำเทิร์นโอเวอร์ซ้ำซ้อน • ฝากถอนออโต้เต็มรูปแบบ ไม่ต้องส่งสลิป ไม่ต้องรอแอดมิน จบในไม่กี่วินาที รองรับทุกธนาคารชั้นนำ";

const faqs = [
  {
    q: "สมัครสมาชิก IOK66 ยุ่งยากไหม เปิดยูสใหม่ได้อะไรบ้าง",
    a: "ขั้นตอนการลงทะเบียนถูกออกแบบมาให้สั้น กระชับ ไม่ต้องกรอกข้อมูลส่วนตัวให้วุ่นวาย เมื่อเปิดยูสเซอร์สำเร็จ คุณจะได้รับสิทธิพิเศษและโปรโมชั่นต้อนรับที่สามารถนำไปต่อยอดเป็นทุนในการเดิมพันได้ทันที ทุกข้อเสนอถูกคิดมาเพื่อเพิ่มโอกาสให้ผู้เล่นหน้าใหม่ทำกำไรได้ตั้งแต่ครั้งแรกที่ล็อคอินเข้าสู่ระบบ",
  },
  {
    q: "เกมใน IOK66 เป็นลิขสิทธิ์แท้จริงไหม ภาพจะกระตุกช่วงโบนัสไทม์หรือเปล่า",
    a: "ทุกเกมถูกนำเข้ามาอย่างถูกต้องตามกฎหมายของวงการคาสิโนสากล เราคัดสรรเฉพาะค่ายเกมชั้นนำที่ได้รับการยอมรับระดับโลกมาให้บริการ ทั้งคุณภาพกราฟิก ฟีเจอร์ตัวคูณ และระบบเสียงจัดเต็มทุกอรรถรส เพราะเล่นผ่านเซิร์ฟเวอร์หลักด้วยระบบ API แท้ จึงหมดปัญหาภาพกระตุกหรือเกมค้าง และทุกรอบการเดิมพันแฟร์ได้มาตรฐานสูงสุด",
  },
  {
    q: "ทำไมอัตราการจ่ายรางวัลของ IOK66 ถึงสูงกว่าเว็บอื่น",
    a: "เคล็ดลับที่ทำให้นักปั่นหลายคนเลือกตั้งรกรากอยู่ที่นี่ คือค่า RTP (Return to Player) ที่สูงกว่าเว็บทั่วไป เราไม่มีการปรับลดอัตราการชนะของผู้เล่น ทำให้จังหวะการออกสแกตเตอร์หรือฟรีสปินมาบ่อยและเข้าถึงง่าย ไม่ว่าคุณจะเดินเบทขั้นต่ำหรือปรับเบทหนัก โอกาสคว้าเงินรางวัลหลักหมื่นถึงหลักแสนก็เป็นไปได้จริงทุกช่วงเวลา",
  },
  {
    q: "มีการล็อคยูสเซอร์หรือปรับเรทชนะหลังบ้านหรือไม่",
    a: "ไม่มีครับ ระบบของเราทำงานด้วยกลไกสุ่มผลแบบ RNG (Random Number Generator) ที่ตรวจสอบได้และได้รับการรับรองจากสถาบันอิสระ ทุกยอดการได้เสียเกิดขึ้นจากอัลกอริทึมที่โปร่งใส 100% ไม่มีแอดมินหลังบ้านคอยกดปุ่มแทรกแซงผลรางวัล คุณจึงกอบโกยกำไรได้อย่างสบายใจไร้ข้อกังขา",
  },
  {
    q: "ถอนเงินก้อนใหญ่ได้ไหม ต้องทำเทิร์นโอเวอร์หรือรอแอดมินนานหรือเปล่า",
    a: "เล่นได้เท่าไหร่เราพร้อมโอนให้เต็มจำนวนไม่มีหักเปอร์เซ็นต์ ไม่ว่าจะเป็นยอดแตกหลักร้อยหรือแจ็คพอตแตกล้าน ฐานการเงินที่มั่นคงระดับแนวหน้าของเอเชียรองรับการถอนก้อนใหญ่ได้อย่างไร้ขีดจำกัด ไม่ต้องทำเทิร์นโอเวอร์ซ้ำซ้อน และระบบธุรกรรมเป็นอัตโนมัติเต็มรูปแบบ ไม่ต้องส่งสลิป ไม่ต้องรอแอดมินตอบแชท เงินเข้าบัญชีภายในไม่กี่วินาที",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxPremium as="h1" title="IOK66 สมัครสมาชิกเว็บสล็อตต่างประเทศ ลิขสิทธิ์แท้ 100% แตกง่าย แจกหนัก">
    <p class="text-left text-base leading-relaxed">
      หากคุณกำลังมองหาแหล่งทำเงินที่ไว้ใจได้ การเลือกเล่นกับเว็บตรงจากต่างประเทศคือคำตอบที่ดีที่สุด เพราะมาตรฐานการให้บริการจะสูงกว่าเว็บทั่วไปอย่างชัดเจน ที่ IOK66 เรานำเสนอประสบการณ์ปั่นสล็อตระดับโลกที่ให้คุณลุ้นกำไรได้ง่ายกว่าเดิม
      ด้วยระบบ API แท้ที่ดึงตรงจากเซิร์ฟเวอร์หลัก ทำให้ทุกการหมุนมีโอกาสแตกหนักและรับเงินรางวัลก้อนโตแบบไม่ต้องพึ่งดวงเพียงอย่างเดียว
    </p>
  </ContentBoxPremium>

  <SmoothCarousel />

  <ContentBoxSevenThreePremium title="IOK66 เปิดยูสใหม่รับความคุ้มค่าแบบจัดเต็มทันที">
    <Picture
      slot="left"
      src={imgWelcomeBonus}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น IOK66 ข้อความ ทุกยอดฝาก 500 บาท หมุนวงล้อฟรี และ ฝากครบ 200 บาท ลุ้นกล่องสุ่มฟรี พร้อมโลโก้ iok66 Gaming ภาพพนักงานหญิงชุดสูทดำ วงล้อเสี่ยงโชค กล่องของขวัญ ฉากผ้าม่านแดงและสิงโตหินจีน"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e3b64a]/35 shadow-[0_10px_30px_rgba(227,182,74,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      เริ่มต้นเส้นทางเศรษฐีได้ง่ายๆ เพียงแค่สมัครเข้ามาเป็นครอบครัวเดียวกัน ขั้นตอนการลงทะเบียนถูกออกแบบมาให้สั้น กระชับ ไม่ต้องกรอกข้อมูลส่วนตัวให้วุ่นวาย เมื่อเปิดยูสเซอร์สำเร็จ คุณจะได้รับสิทธิพิเศษและโปรโมชั่นต้อนรับที่สามารถนำไปต่อยอดเป็นทุนในการเดิมพันได้ทันที
      ทุกข้อเสนอถูกคิดมาเพื่อเพิ่มโอกาสให้ผู้เล่นหน้าใหม่สามารถทำกำไรได้ตั้งแต่ครั้งแรกที่ล็อคอินเข้าสู่ระบบ
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxTwoPremium as="h2" title="ส่งตรงจากค่ายแม่ การันตีคุณภาพเกมลิขสิทธิ์แท้ทุกค่าย">
    <p slot="left" class="text-left text-base leading-relaxed">
      หมดปัญหาภาพกระตุกหรือเกมค้างช่วงโบนัสไทม์ เพราะทุกเกมถูกนำเข้ามาอย่างถูกต้องตามกฎหมายของวงการคาสิโนสากล เราคัดสรรเฉพาะค่ายเกมชั้นนำที่ได้รับการยอมรับระดับโลกมาให้บริการ
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      คุณภาพกราฟิก ฟีเจอร์ตัวคูณ และระบบเสียงจัดเต็มทุกอรรถรส ที่สำคัญคือการเล่นผ่านเซิร์ฟเวอร์หลักจะช่วยให้คุณมั่นใจได้ว่าทุกรอบการเดิมพันนั้นแฟร์และได้มาตรฐานสูงสุด
    </p>
  </ContentBoxTwoPremium>

  <ProviderGrid />

  <ContentBox3ThreePremium as="h2" title="ทำไมการเดิมพันกับ IOK66 ถึงมีอัตราการจ่ายรางวัลสูงกว่าที่อื่น">
    <p slot="left" class="text-left text-base leading-relaxed">เคล็ดลับที่ทำให้นักปั่นหลายคนเลือกตั้งรกรากอยู่ที่นี่ คือค่า RTP (Return to Player) ที่สูงกว่าเว็บทั่วไป</p>
    <p slot="center" class="text-left text-base leading-relaxed">เราไม่มีการปรับลดอัตราการชนะของผู้เล่น ทำให้จังหวะการออกสแกตเตอร์หรือฟรีสปินมาบ่อยและเข้าถึงง่าย</p>
    <p slot="right" class="text-left text-base leading-relaxed">ไม่ว่าคุณจะเดินเบทขั้นต่ำหรือปรับเบทหนัก โอกาสที่จะคว้าเงินรางวัลหลักหมื่นถึงหลักแสนก็มีความเป็นไปได้จริงในทุกช่วงเวลา</p>
  </ContentBox3ThreePremium>

  <GameRankingBoard />

  <ContentBoxSpecial as="h2" title="สล็อตเว็บตรง ระบบเดิมพันโปร่งใส ไม่มีการล็อคผลรางวัล">
    <p slot="left" class="text-left text-base leading-relaxed">
      ความกังวลเรื่องการถูกปรับเรทชนะหรือล็อคยูสเซอร์จะหมดไปเมื่อคุณเลือกเล่นกับ IOK66 ระบบของเราทำงานด้วยกลไกสุ่มผลแบบ RNG (Random Number Generator) ที่ตรวจสอบได้และได้รับการรับรองจากสถาบันอิสระ
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      ทุกยอดการได้เสียเกิดขึ้นจากอัลกอริทึมที่โปร่งใส 100% ไม่มีแอดมินหลังบ้านคอยกดปุ่มแทรกแซงผลรางวัล คุณจึงกอบโกยกำไรได้อย่างสบายใจไร้ข้อกังขา
    </p>
  </ContentBoxSpecial>

  <LoginRtpSection />

