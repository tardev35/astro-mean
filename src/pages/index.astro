---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBox3Three from "../components/ContentBox3Three.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners3 from "../components/LatestWinners3.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Faq2 from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgCertified from "../assets/slide1.png";
import imgTestimonial from "../assets/slide2.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxCyberCut as="h1" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   2 → ContentBoxNeumorphism as="h2" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   3 → ContentBoxSevenThreeNeumorphism as="h2" + slide1 (อาร์ตสไลด์เป็นโลโก้หน่วย
//       รับรอง bmm testlabs / MGA / Gambling Commission / Gaming Associates คู่
//       ข้อความ "เกม PG SLOT ผ่านการรับรอง" ซึ่งตรงกับหัวข้อเรื่องลิขสิทธิ์แท้ของจริง)
//       แล้วต่อด้วย ProviderGrid ซึ่งกางค่ายลิขสิทธิ์แท้ที่ย่อหน้าเดียวกันเอ่ยชื่อไว้
//   4 → ContentBox3Three as="h2" (ย่อหน้าเดียวแบ่งลงสามคอลัมน์ตามลำดับประโยคเดิม:
//       สายคอมโบแตกนอก → สายซื้อฟีเจอร์พุ่งชนฟรีสปิน → แนวคลาสสิกตัวคูณหนักและการ
//       สลับค่ายในกระเป๋าเดียว)
//   5 → ContentBoxTwoCyberCut as="h2" (ย่อหน้าเดียวแบ่งสองครึ่งตามลำดับประโยคเดิม:
//       Multipliers / Expanding Wild / Cascading → โหมด Bonus Buy) แล้วต่อด้วย
//       FeatureHighlights ซึ่งกางสี่ฟีเจอร์ที่ย่อหน้านี้ระบุชื่อไว้ตรงๆ → h3 สี่ตัว
//       ซึ่งเป็น h3 ชุดเดียวที่ได้รับอนุญาตบนหน้านี้ คำอธิบายเขียนขยายความใหม่ ไม่ได้
//       ก๊อบประโยคด้านบนซ้ำ
//   6 → ContentBox as="h2" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   7 → ContentBoxSevenThreeCyberCut as="h2" + slide2 (อาร์ตสไลด์เป็นคำชมจากลูกค้า
//       กว่าหมื่นคนคู่ใบรับรอง "การันตี ไม่มีโกง ถอนได้ทุกยอด" ซึ่งเป็นรูปธรรมของ
//       หัวข้อเรื่องระบบเสถียรที่รันต่อเนื่องได้ทั้งวัน)
//
// variant รอบนี้หมุนออกจากชุดของแบรนด์ก่อนทั้งตระกูล: ทรง ContentBox เปลี่ยนจากชุด
// Premium ×3 + FloatingBadge ×2 + Special + 3ThreePremium มาเป็น CyberCut ×2
// (เดี่ยว + สองคอลัมน์) + Neumorphism ×2 (เดี่ยว + เจ็ดสาม) + plain ×1 +
// SevenThreeCyberCut ×1 + 3Three ตัวธรรมดา ส่วน Announcement เป็น Announcement5,
// LatestWinners เป็น LatestWinners3, ProviderGrid เป็นตัวธรรมดา, ReviewCard เป็น
// ReviewCardSumo และ Faq เป็น Faq2 — Navbar/Footer/ฟอนต์ ถูกสลับไว้แล้วใน MainLayout
// กับ brandProfile
//
// ContentBoxSevenThree* ทั้งสองตัวปล่อยหัวข้อจาก prop `title` ตัวเดียว ส่วน
// titleleft เป็นป้ายคอลัมน์รูปที่ยังเป็น <p> — ห้ามส่ง titleright เข้าไป เพราะจะเพิ่ม
// ป้ายซ้อนใต้หัวข้อเดียวกัน
//
// Announcement ส่ง message ตรงๆ เสมอ เพราะ default ของทุก variant ในตระกูลนี้เป็น
// สโลแกนของแบรนด์เก่าคนละเจ้ากัน ข้อความชุดนี้ตรงตัวต่อตัวกับ default ของ
// Announcement5.astro เพื่อให้ ticker ของหน้าย่อยที่เรียก <Announcement /> เปล่าๆ
// วิ่งข้อความเดียวกับหน้าแรก และห้ามขึ้นต้นด้วย emoji เพราะ marquee render ข้อความ
// ซ้ำและ emoji ที่ฝังในสตริงถูก mark aria-hidden ไม่ได้
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook คู่กับ slide1/slide2 ซึ่งเป็นสไลด์ที่
// อาร์ตตรงกับหัวข้อ docx ข้อ 3 กับข้อ 7 พอดี — slide3 (เว็บพนันออนไลน์ที่เดียว
// ครบวงจร) ไม่มีหัวข้อ docx ไหนรองรับและเพดาน SevenThree เต็มแล้ว จึงปล่อยไว้ให้หน้า
// /promotion ใช้ ส่วน slide4 เป็นอาร์ตของแบรนด์ก่อนที่พิมพ์โลโก้ของเขาไว้บนรูป จึงถูก
// ถอด import ออกทั้งหมด และไฟล์ banner ทุกตัว (ทั้งตัวที่มีเลขต่อท้ายและตัวมือถือ)
// ห้าม import ที่นี่หรือที่ไหนก็ตาม เพราะรูปที่ import คือรูปที่ถูก emit ลง dist/
// ถึงจะไม่มีใคร render ก็ตาม — banner1 เป็นของ MainLayout จัดการเอง และรูปในหน้านี้
// ไม่มีตัวไหนใส่ loading="eager"/fetchpriority="high" เพราะ LCP เป็นของ hero ใน
// MainLayout
//
// widget ที่ไม่ได้มาจาก docx (SmoothCarousel, GameRankingBoard, LatestWinners3,
// LoginRtpSection, ReviewCardSumo, แถวปุ่ม login/register, FAQ, Navfoot) ใช้ป้าย
// เป็น <p>/<span> + aria-label บน <section> และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้าย
// ทั้งชุด ยกเว้นสองตัวที่เป็นภาพประกอบของหัวข้อ docx หนึ่งข้อโดยตรง
// (ProviderGrid → ข้อ 3, FeatureHighlights → ข้อ 5) ซึ่งวางต่อท้ายบล็อกนั้นๆ
//
// h1 ×1 + h2 ×6 = หัวข้อ docx พอดี บวก h3 ×4 จาก FeatureHighlights ซึ่งเป็นรายการ
// ย่อยของหัวข้อข้อ 5 ตามข้อยกเว้นเดียวที่ playbook อนุญาต — หัว FAQ เป็น <p> ใน
// Faq2.astro คำถามเป็น <span> ใน <summary> และป้ายคอลัมน์ของทุก ContentBox variant
// เป็น <p>
//
// title กับ description ใช้บรรทัดที่ brief ให้มาตรงๆ ทั้งคู่ ห้ามเติมหรือตัด และเป็น
// สตริงเดียวกับที่ส่งเข้า pageGraph และ MainLayout
const pageTitle = "ROOM89 | สล็อตล็อกเป้าเกมเด็ด ลิขสิทธิ์แท้ของจริง บวกกำไรเพลิน";
const pageDescription = "ROOM89 สล็อตล็อกเป้าเกมเด็ด ลิขสิทธิ์แท้ของจริงยกค่ายมาให้เลือก เกมหลายสไตล์พร้อมฟีเจอร์น่าลอง โบนัสมีให้ตาม บวกกำไรเพลิน ระบบเสถียรตลอดวัน";

const announcementMessage =
  "ROOM89 สล็อตล็อกเป้าเกมเด็ด ลิขสิทธิ์แท้ของจริง บวกกำไรเพลิน • สล็อตเว็บตรงตัวตึง API แท้ ยิงตรงจากเซิร์ฟนอกแบบไม่ผ่านเอเย่นต์ ค่า RTP เป๊ะตามสเปกโรงงาน ไม่มีปรับลดเปอร์เซ็นต์แตก ไม่ล็อกยูส ปั่นยังไงก็มีทรง บวกเท่าไหร่ก็ถอนได้เต็ม • เลิกเสียเวลาสุ่มเล่นเกมขยะ ล็อกเป้าคัดเฉพาะเกมสล็อตตัวเด่นที่มีทรงโบนัสแตกโหดมาไว้บนหน้าล็อบบี้ จัดหมวดหมู่เกมแตกง่ายไว้ให้ชัดๆ อยากปั่นเกมไหนเข้าถึงได้ในคลิกเดียว • ขนทัพค่ายสล็อตตัวแม่ระดับโลกอย่าง PG Soft, Pragmatic Play และ Joker Gaming มาไว้แบบยกค่าย เสิร์ฟเฉพาะเกมลิขสิทธิ์แท้ของจริง กราฟิกภาพคมชัด 3D ลื่นๆ ไม่มีกระตุก อัลกอริทึมการจ่ายเงินโปร่งใส 100% • สายเบื่อง่ายต้องเลิฟ ขนเกมสล็อตมาให้สลับเล่นหลายสไตล์ ทั้งสายคอมโบแตกนอก สายซื้อฟีเจอร์พุ่งชนฟรีสปิน และแนวคลาสสิกตัวคูณหนัก สลับค่ายเล่นได้ยั่วๆ ในกระเป๋าเดียว ไม่ต้องเสียเวลาโยกเงิน • ทุกเกมอัดแน่นด้วยฟีเจอร์ตัวตึง ทั้ง Multipliers ตัวคูณสะสมโหดๆ สัญลักษณ์ Expanding Wild ยืดเต็มรีล ระบบ Cascading แตกต่อเนื่องในสปินเดียว แถมมีโหมด Bonus Buy กดซื้อฟรีสปินลุ้นแจ็คพอตใหญ่ได้ทันที • เติมทุนปั่นได้แบบมีทรง จัดโปรโมชันโบนัสฟรีให้ตามเก็บกันตลอดวัน ทั้งโปรฝากแรกของวันสำหรับสายลุย และระบบคืนยอดเสีย Cash Back ให้เก็บเครดิตกลับมาแก้ตัว เงื่อนไขโปร่งใส ถอนได้จริง ไม่ติดเทิร์นจุกจิก • รันระบบบนเซิร์ฟเวอร์ความเร็วสูง การันตีความลื่นไหลระดับสปีดติดปีก เล่นได้ยาวๆ 24 ชั่วโมง ไม่มีค้าง ไม่มีเด้งหลุดกลางทาง ฝากถอนออโต้ทำรายการเสร็จใน 3 วินาที ถอนปุ๊บเงินเด้งเข้าแอปปั๊บ";

// FAQ ห้าข้อเขียนขึ้นใหม่จากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้า
// ไหนมาทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบ
// คำถามที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq2> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน — ห้ามปล่อยให้
// Faq2 ใช้ค่า default ของตัวเอง เพราะ default ของทุก variant ในตระกูลนี้เป็นคำถาม
// ของแบรนด์เก่า
const faqs = [
  {
    q: "ROOM89 เป็นเว็บตรงจริงไหม ต่างจากเว็บที่ผ่านเอเย่นต์ตรงไหน",
    a: "เป็นเว็บตรงตัวตึงที่ใช้ระบบ API แท้ ยิงสัญญาณตรงจากเซิร์ฟนอกโดยไม่มีเอเย่นต์มาคั่นกลาง ความต่างที่เห็นได้จริงคือค่า RTP เป๊ะตามสเปกโรงงาน ไม่มีการปรับลดเปอร์เซ็นต์แตกระหว่างทาง และไม่มีการล็อกยูสเมื่อผู้เล่นบวกหนัก ปั่นยังไงก็มีทรง บวกเท่าไหร่ก็ถอนได้เต็ม",
  },
  {
    q: "ต้องไล่หาเกมเองไหม หรือมีการคัดเกมมาให้แล้ว",
    a: "ไม่ต้องสุ่มหาเอง เพราะหน้าล็อบบี้ถูกล็อกเป้าคัดเฉพาะเกมสล็อตตัวเด่นที่มีทรงโบนัสแตกโหดมาวางไว้ให้แล้ว พร้อมจัดหมวดหมู่เกมแตกง่ายแยกไว้ชัดเจน อยากปั่นเกมไหนก็เข้าถึงได้ในคลิกเดียวโดยไม่ต้องเลื่อนหาจนนิ้วล็อค เปิดเว็บมาก็กดลั่นสปินได้ทันที",
  },
  {
    q: "มีค่ายอะไรให้เล่นบ้าง แล้วต้องโยกเงินข้ามค่ายไหม",
    a: "ยกค่ายตัวแม่ระดับโลกมาให้เลือกทั้ง PG Soft, Pragmatic Play และ Joker Gaming เสิร์ฟเฉพาะเกมลิขสิทธิ์แท้ของจริง กราฟิกภาพคมชัด 3D ลื่นๆ ไม่มีกระตุก และอัลกอริทึมการจ่ายเงินโปร่งใส 100% ทุกค่ายเล่นผ่านกระเป๋าเดียว สลับค่ายได้ทันทีโดยไม่ต้องเสียเวลาโยกเงิน",
  },
  {
    q: "ฟีเจอร์ Multipliers, Expanding Wild, Cascading และ Bonus Buy คืออะไร",
    a: "Multipliers คือตัวคูณที่สะสมเพิ่มขึ้นระหว่างรอบ Expanding Wild คือสัญลักษณ์ไวลด์ที่ยืดออกจนเต็มรีล Cascading คือระบบที่ตัวเบี้ยชนะหายไปแล้วเติมของใหม่ลงมาให้แตกต่อเนื่องในสปินเดียว ส่วน Bonus Buy คือโหมดที่กดซื้อฟรีสปินเข้าไปลุ้นแจ็คพอตใหญ่ได้ทันทีแบบไม่ต้องนั่งรอ",
  },
  {
    q: "ฝากถอนใช้เวลานานแค่ไหน แล้วมีโบนัสอะไรให้เก็บบ้าง",
    a: "ฝากถอนเป็นระบบออโต้ไฮสปีดที่ทำรายการเสร็จใน 3 วินาที ถอนปุ๊บเงินเด้งเข้าแอปปั๊บ ทำงานเท่ากันตลอด 24 ชั่วโมงบนเซิร์ฟเวอร์ความเร็วสูงที่ไม่ค้างและไม่เด้งหลุดกลางทาง ส่วนโบนัสมีให้ตามเก็บทั้งโปรฝากแรกของวันและระบบคืนยอดเสีย Cash Back กดรับเองได้ผ่านหน้าเว็บ ไม่ติดเทิร์นจุกจิก",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxCyberCut as="h1" title="ROOM89 สล็อตล็อกเป้าเกมเด็ด ลิขสิทธิ์แท้ของจริง บวกกำไรเพลิน">
    <p class="text-left text-base leading-relaxed">
      ROOM89 สล็อตเว็บตรงตัวตึง API แท้ ยิงตรงจากเซิร์ฟนอกแบบไม่ผ่านเอเย่นต์ ค่า RTP เป๊ะตามสเปกโรงงาน ไม่มีปรับลดเปอร์เซ็นต์แตก ไม่ล็อกยูส ปั่นยังไงก็มีทรง
      บวกเท่าไหร่ก็ถอนได้เต็มระบบด้วยโหมดออโต้ไฮสปีดใน 3 วิ ถอนปุ๊บเงินเด้งเข้าแอปปั๊บ สายสปินยุคใหม่บอกเลยว่าต้องโดน
    </p>
  </ContentBoxCyberCut>

