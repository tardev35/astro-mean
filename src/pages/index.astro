---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners2 from "../components/LatestWinners2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Faq4 from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgWhyPlayHere from "../assets/slide4.png";
import imgDepositStreak from "../assets/slide1.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxPremium as="h1" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   2 → ContentBoxSevenThreePremium as="h2" + slide4 (อาร์ตสไลด์เขียนว่า "เล่นที่นี่
//       ดียังไง?" แล้วกางข้อดีเป็นชิปแปดอัน ซึ่งเป็นภาพของย่อหน้านี้ที่พูดถึงการคัด
//       เกมน่าเล่นมาให้แบบไม่ต้องเสียเวลาหา)
//   3 → ContentBox3ThreePremium as="h2" (ย่อหน้าเดียวแบ่งลงสามคอลัมน์ตามลำดับประโยค
//       เดิม: รวมค่ายชั้นนำระดับโลก → ครบทั้ง 3D/ตัวคูณ/ซื้อฟีเจอร์/คลาสสิก →
//       สลับเล่นในกระเป๋าเดียว) แล้วต่อด้วย ProviderGridPremium ซึ่งกางโลโก้ค่ายที่
//       ย่อหน้าเดียวกันเอ่ยชื่อไว้
//   4 → ContentBoxFloatingBadge as="h2" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   5 → ContentBoxSpecial as="h2" (ย่อหน้าเดียวแบ่งสองครึ่ง: ชื่อฟีเจอร์ทั้งสามตัว →
//       ผลของมันต่อจังหวะการสปิน) แล้วต่อด้วย FeatureHighlights (ฟีเจอร์ย่อยสามตัวที่
//       ย่อหน้านี้ระบุชื่อไว้ตรงๆ → h3 สามตัว ซึ่งเป็น h3 ชุดเดียวที่ได้รับอนุญาตบน
//       หน้านี้)
//   6 → ContentBoxSevenThreeFloatingBadge as="h2" + slide1 (อาร์ตสไลด์เป็นโปรฝากประจำ
//       ที่กางสิทธิ์รับโบนัสเป็นขั้นๆ ตรงกับย่อหน้าเรื่องเปิดระบบรับโบนัสฟรีอัตโนมัติ)
//   7 → ContentBoxTwoPremium as="h2" (ย่อหน้าเดียวแบ่งสองครึ่ง: โครงสร้างหลังบ้าน
//       เชื่อมตรงกับเซิร์ฟเวอร์หลักและคลังเกม A-List → โปรเพิ่มทุนกับฝากถอนออโต้)
//
// variant รอบนี้หมุนออกจากชุดของแบรนด์ก่อนทั้งตระกูล: ทรง ContentBox เปลี่ยนจากชุด
// Neumorphism + CyberCut + TwoFloatingBadge มาเป็น Premium ×4 + Special ×1 +
// FloatingBadge ×2 ส่วน Announcement เป็น Announcement5, LatestWinners เป็น
// LatestWinners2, ProviderGrid เป็น ProviderGridPremium, ReviewCard เป็น
// ReviewCardSumo2 และ Faq เป็น Faq4 — Navbar/Footer/ฟอนต์ ถูกสลับไว้แล้วใน
// MainLayout กับ brandProfile
//
// ContentBoxSevenThree* ทั้งสองตัวปล่อยหัวข้อจาก prop `title` ตัวเดียว ส่วน
// titleleft เป็นป้ายคอลัมน์รูปที่ยังเป็น <p> — ห้ามส่ง titleright เข้าไป เพราะจะเพิ่ม
// ป้ายซ้อนใต้หัวข้อเดียวกัน
//
// Announcement ส่ง message ตรงๆ เสมอ เพราะ default ของทุก variant ในตระกูลนี้เป็น
// สโลแกนของแบรนด์เก่าคนละเจ้ากัน ข้อความชุดนี้ต้องตรงกับ default ของ Announcement5
// เป๊ะ เพื่อให้ ticker ของหน้าย่อยที่เรียก <Announcement /> เปล่าๆ วิ่งข้อความเดียว
// กับหน้าแรก และห้ามขึ้นต้นด้วย emoji เพราะ marquee render ข้อความซ้ำและ emoji ที่
// ฝังในสตริงถูก mark aria-hidden ไม่ได้
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook คู่กับ slide4/slide1 ซึ่งเป็นสไลด์ที่
// อาร์ตตรงกับหัวข้อ docx ข้อ 2 กับข้อ 6 พอดี — slide2 (สะสมยอดเทิร์น) กับ slide3
// (กงล้อลุ้นโชค) ไม่มีหัวข้อ docx ไหนรองรับและเพดาน SevenThree เต็มแล้ว จึงปล่อยไว้
// ให้หน้า /promotion ใช้ ส่วน banner ทุกหมายเลข (banner2/3/4) เป็นอาร์ตของแบรนด์ก่อน
// ห้าม import ที่นี่หรือที่ไหนก็ตาม เพราะรูปที่ import คือรูปที่ถูก emit ถึงจะไม่มีใคร
// render ก็ตาม ส่วน banner1 กับ banner1-mobile เป็นของ MainLayout จัดการเอง และรูปใน
// หน้านี้ไม่มีตัวไหนใส่ loading="eager"/fetchpriority="high" เพราะ LCP เป็นของ hero
// ใน MainLayout
//
// widget ที่ไม่ได้มาจาก docx (SmoothCarousel, GameRankingBoard, LatestWinners2,
// LoginRtpSection, ReviewCardSumo2, แถวปุ่ม login/register, FAQ, Navfoot) ใช้ป้าย
// เป็น <p>/<span> + aria-label บน <section> และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้าย
// ทั้งชุด ยกเว้นสองตัวที่เป็นภาพประกอบของหัวข้อ docx หนึ่งข้อโดยตรง
// (ProviderGridPremium → ข้อ 3, FeatureHighlights → ข้อ 5) ซึ่งวางต่อท้ายบล็อกนั้นๆ
//
// h1 ×1 + h2 ×6 = หัวข้อ docx พอดี บวก h3 ×3 จาก FeatureHighlights ซึ่งเป็นรายการ
// ย่อยของหัวข้อข้อ 5 ตามข้อยกเว้นเดียวที่ playbook อนุญาต — หัว FAQ เป็น <p> ใน
// Faq4.astro คำถามเป็น <span> ใน <summary> และป้ายคอลัมน์ของทุก ContentBox variant
// เป็น <p>
//
// title ใช้บรรทัด Title ของ docx ตรงๆ ส่วน description ต่อท้ายบรรทัด Des ของ docx
// ด้วย "เว็บตรง API แท้" ให้ยาว 156 ตัวอักษร เข้ากรอบ 150–160 ของเกทคุณภาพ (บรรทัด
// Des ดิบของ docx ยาว 140 ตัว ซึ่งต่ำกว่ากรอบ) และเป็นสตริงเดียวกับที่ส่งเข้า
// pageGraph และ MainLayout
const pageTitle = "HAPPYSUPERWIN | สล็อตรวมตัวจี๊ด เกมดังคัดมาดี โบนัสฟรีรับเลย";
const pageDescription = "HAPPYSUPERWIN สล็อตรวมตัวจี๊ด เกมดังคัดมาดีจากค่ายชั้นนำ เติมเกมใหม่ให้ตามต่อเนื่อง ฟีเจอร์ครบหลายสไตล์ โบนัสฟรีรับเลย พร้อมฝากถอนออโต้ทันใจ เว็บตรง API แท้";

const announcementMessage =
  "HAPPYSUPERWIN สล็อตรวมตัวจี๊ด เกมดังคัดมาดี โบนัสฟรีรับเลย • เว็บตรง API แท้ ยิงตรงจากเซิร์ฟนอก ค่า RTP มาตรฐานสากล ไม่มีปรับลดอัตราแตก ถอนเงินออกได้เต็มยอด ไร้เงื่อนไขจุกจิก • คัดเกมน่าเล่นมาให้แบบไม่ต้องเสียเวลาหา กรองเฉพาะเกมที่จ่ายรางวัลสูงและโบนัสแตกบ่อยที่สุดมาไว้ในหน้าแรก เบทเริ่มต้นเบาๆ แต่ลุ้นแจ็คพอตก้อนโตได้ทันที • รวมค่ายเกมชั้นนำระดับโลก PG Soft, Pragmatic Play และ Joker Gaming ครบทั้งสล็อต 3D ภาพสวย ตัวคูณทวีคูณหนัก สายซื้อฟีเจอร์ฟรีสปิน และคลาสสิกแตกไว • ของใหม่ไม่ปล่อยให้รอนาน เติมเกมเข้าล็อบบี้ทันทีที่ค่ายปล่อยไฟล์ออกจากสตูดิโอ ทดลองเล่นฟีเจอร์เด็ดและอ่านจังหวะโบนัสได้ก่อนใคร • ฟีเจอร์ครบหลายสไตล์ ทั้งระบบ Cascading คอมโบสัญลักษณ์แตกต่อเนื่อง Multiplier สุ่มแจกตัวคูณหนัก และสัญลักษณ์ Wild ซ้อนทับ • โบนัสฟรีรับเลย กดรับสิทธิ์เพิ่มทุนสปิน เครดิตฟรี และคืนยอดเสีย Cash Back ผ่านหน้าแดชบอร์ดได้เองทันที ไม่ต้องรอแอดมิน • ฝากถอนออโต้ทำรายการเสร็จใน 3 วินาที ปั่นทำกำไรได้โปร่งใส จบครบทุกความต้องการในเว็บเดียว";

// FAQ ห้าข้อเขียนขึ้นใหม่จากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้า
// ไหนมาทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบ
// คำถามที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq4> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน — ห้ามปล่อยให้
// Faq4 ใช้ค่า default ของตัวเอง เพราะ default ของทุก variant ในตระกูลนี้เป็นคำถาม
// ของแบรนด์เก่า
const faqs = [
  {
    q: "HAPPYSUPERWIN ต่อเกมมาจากไหน แล้วค่า RTP ถูกปรับลดหรือเปล่า",
    a: "HAPPYSUPERWIN เป็นเว็บตรง API แท้ ยิงสัญญาณตรงจากเซิร์ฟเวอร์นอกโดยไม่ผ่านเอเย่นต์ ค่า RTP จึงเป็นมาตรฐานสากลและไม่มีการปรับลดอัตราแตกในเกมไหนเลย ทุกเกมในล็อบบี้ผ่านการทดสอบระบบหลังบ้านว่าจ่ายจริงตามอัลกอริทึมมาตรฐานสากลก่อนเปิดให้เข้าเล่น",
  },
  {
    q: "ต้องเสียเวลาไล่หาเกมเองไหม แล้วเบทเริ่มต้นเท่าไหร่",
    a: "ไม่ต้องไล่หาเอง เพราะคัดกรองเฉพาะเกมสล็อตที่มีอัตราการจ่ายรางวัลสูงและโบนัสแตกบ่อยที่สุดมาไว้ในหน้าแรกให้แล้ว ไม่ต้องเสียเวลาลองสุ่มเล่นเกมไร้คุณภาพ เบทเริ่มต้นเบาๆ ก็มีสิทธิ์ลุ้นแจ็คพอตก้อนโตได้ทันทีตั้งแต่สปินแรก",
  },
  {
    q: "ในล็อบบี้มีค่ายอะไรบ้าง แล้วเกมแนวไหนให้เลือก",
    a: "รวมค่ายเกมชั้นนำระดับโลกอย่าง PG Soft, Pragmatic Play, Joker Gaming และอีกมากมายไว้ในที่เดียว ครบทั้งสล็อต 3D ภาพสวย ตัวคูณทวีคูณหนัก สล็อตสายซื้อฟีเจอร์ฟรีสปิน และสล็อตคลาสสิกแตกไว สลับเล่นได้หลายแนวในกระเป๋าเดียวโดยไม่ต้องเสียเวลาโยกเงิน",
  },
  {
    q: "เกมใหม่เข้าบ่อยแค่ไหน แล้วมีฟีเจอร์อะไรให้ลุ้นบ้าง",
    a: "อัปเดตคลังเกมใหม่ทันทีที่ค่ายผู้พัฒนาปล่อยไฟล์เกมออกจากสตูดิโอ ได้ทดลองเล่นฟีเจอร์เด็ดและอ่านจังหวะโบนัสก่อนใครแบบไม่ตกเทรนด์ ส่วนฟีเจอร์มาครบหลายสไตล์ ทั้งระบบ Cascading คอมโบสัญลักษณ์แตกต่อเนื่อง Multiplier สุ่มแจกตัวคูณหนัก และสัญลักษณ์ Wild ซ้อนทับ",
  },
  {
    q: "รับโบนัสฟรีต้องทักแอดมินไหม แล้วฝากถอนใช้เวลานานแค่ไหน",
    a: "ไม่ต้องรอแอดมิน เพราะเปิดระบบรับโบนัสฟรีแบบอัตโนมัติ เลือกกดรับสิทธิ์เพิ่มทุนสปิน เครดิตฟรี หรือคืนยอดเสีย Cash Back ผ่านหน้าแดชบอร์ดได้เองทันที ส่วนระบบฝากถอนออโต้ไฮสปีดทำรายการเสร็จใน 3 วินาที ถอนเงินออกได้เต็มยอด ไร้เงื่อนไขจุกจิก",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxPremium as="h1" title="HAPPYSUPERWIN สล็อตรวมตัวจี๊ด เกมดังคัดมาดี โบนัสฟรีรับเลย">
    <p class="text-left text-base leading-relaxed">
      HAPPYSUPERWIN เว็บตรง API แท้ ยิงตรงจากเซิร์ฟนอก ค่า RTP มาตรฐานสากล ไม่มีปรับลดอัตราแตก คัดเฉพาะสล็อตตัวจี๊ดแตกง่ายจากค่ายใหญ่ มาพร้อมแจกโบนัสฟรีรับเองได้ทันที และระบบฝากถอนออโต้ 3 วินาที
      ปั่นทำกำไรได้โปร่งใส ถอนเงินออกได้เต็มยอด ไร้เงื่อนไขจุกจิก
    </p>
  </ContentBoxPremium>

  <ContentBoxSevenThreePremium as="h2" title="HAPPYSUPERWIN สล็อตรวมตัวจี๊ด คัดเกมน่าเล่นมาให้แบบไม่ต้องเสียเวลาหา" titleleft="เล่นที่นี่ ดียังไง?">
    <Picture
      slot="left"
      src={imgWhyPlayHere}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 767px) 92vw, 386px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่นของ HAPPYSUPERWIN พื้นทอง หัวเรื่องเขียนว่า เล่นที่นี่ ดียังไง? มีตัวการ์ตูนแมวยืนอยู่ด้านหนึ่ง ล้อมด้วยป้ายข้อดีแปดอัน ได้แก่ คืนยอดเสีย 20,000 ทุกสัปดาห์ ระบบ AUTO เพียง 3 วินาที สะดวก รวดเร็ว ตลอด 24HR. การเงินมั่นคงปลอดภัย เปิดมานานกว่า 6 ปี โปรโมชั่นสุดปัง เอาใจลูกค้า ฝากเงินขั้นต่ำ ไม่ติดเงื่อนไขยอดฝาก ฝากแล้วไม่ต้องถอนได้ทันที เล่นเท่าไหร่เราก็จ่าย ได้แสนถอนแสน ได้ล้านถอนล้าน และ เว็บใหญ่ไม่ผ่านเอเย่นต์ 100% ลูกค้าที่สมัครตรงเข้าเว็บใหญ่เท่านั้น"
      class="mx-auto h-auto w-full rounded-2xl border border-[#8a1f9e]/45 shadow-[0_10px_30px_rgba(225,28,204,0.28)]"
