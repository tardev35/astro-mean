---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBox3ThreeNeumorphism from "../components/ContentBox3ThreeNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinnersPremium from "../components/LatestWinnersPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Faq3 from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide1.png";
import imgTrueMoney from "../assets/slide3.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxCyberCut as="h1" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   2 → ContentBoxTwoPremium as="h2" (ย่อหน้าเดียวแบ่งสองครึ่งตามลำดับประโยคเดิม:
//       วางโครงสร้างหลังบ้านให้เสถียรและเคลียร์ขั้นตอนยุ่งยาก → ประมวลผลแม่นยำ
//       คำนวณเรียลไทม์ เปิดฟอร์มความพร้อมให้กดลุยต่อ)
//   3 → ContentBox3ThreeNeumorphism as="h2" (ย่อหน้าเดียวแบ่งลงสามคอลัมน์ตามลำดับ
//       ประโยคเดิม ตามชื่อสามแนวเกมที่ย่อหน้านั้นเอ่ยไว้ตรงๆ: สล็อตวิดีโอ 3D →
//       สล็อตตัวคูณสะสม → สายซื้อฟีเจอร์ฟรีสปิน) แล้วต่อด้วย ProviderGridPremium
//       ซึ่งกางรายชื่อค่ายที่ย่อหน้าเดียวกันระบุไว้ (PG Soft / Pragmatic Play /
//       Joker Gaming)
//   4 → ContentBox as="h2" ตัวธรรมดา (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   5 → ContentBoxNeumorphism as="h2" (ย่อหน้าเดียวเต็มๆ) แล้วต่อด้วย
//       FeatureHighlights ซึ่งกางสามลูกเล่นแจกโบนัสที่ย่อหน้าเดียวกันระบุชื่อไว้
//       ตรงๆ (Multiplier / Expanding Wild / Cascading) → h3 สามตัว ซึ่งเป็น h3
//       ชุดเดียวที่ได้รับอนุญาตบนหน้านี้ คำอธิบายเขียนขยายความใหม่ ไม่ได้ก๊อบประโยค
//       ด้านบนซ้ำ
//   6 → ContentBoxSevenThree as="h2" + slide1 (อาร์ตสไลด์เขียนว่า รับยอดเสีย 5%
//       ทุกวัน ซึ่งเป็นรูปธรรมของหัวข้อเรื่องโปรมีของที่มีสิทธิ์คืนยอดเสีย Cash Back
//       ทุกวัน)
//   7 → ContentBoxSevenThreeCyberCut as="h2" + slide3 (อาร์ตสไลด์เขียนว่า รองรับ
//       TrueMoney Wallet ซึ่งตรงกับหัวข้อเรื่องออโต้ไฮสปีดที่ฝากถอนผ่าน Gateway ตรง
//       รองรับทั้งธนาคารและ TrueMoney Wallet)
//
// variant รอบนี้หมุนออกจากชุดของแบรนด์ก่อนทั้งตระกูล: ทรง ContentBox เปลี่ยนจาก
// Premium + FloatingBadge + SevenThreePremium + TwoNeumorphism + SevenThreeHuay +
// 3ThreeHuay + Special มาเป็น CyberCut + TwoPremium + 3ThreeNeumorphism + plain +
// Neumorphism + SevenThree + SevenThreeCyberCut ส่วน Announcement เป็น
// AnnouncementPremium, LatestWinners เป็น LatestWinnersPremium, กริดค่ายเกมเป็น
// ProviderGridPremium (ค่ายสล็อต ไม่ใช่ตลาดหวย) และ Faq เป็น Faq3 —
// Navbar/Footer/ฟอนต์ ถูกสลับไว้แล้วใน MainLayout กับ brandProfile
//
// ContentBoxSevenThree ปล่อยหัวข้อผ่าน rightHeading (= titleright ?? title) จึงส่ง
// title ตัวเดียวเข้าไป ส่วน titleleft เป็นป้ายคอลัมน์รูปที่เป็น <p> — ห้ามส่งทั้ง
// title และ titleright พร้อมกัน เพราะจะได้หัวข้อเกินมาหนึ่งตัวที่ไม่มี docx รองรับ
//
// Announcement ส่ง message ตรงๆ เสมอ เพราะ default ของทุก variant ในตระกูลนี้เป็น
// สโลแกนของแบรนด์เก่าคนละเจ้ากัน ข้อความชุดนี้ตรงตัวต่อตัวกับ default ของ
// AnnouncementPremium.astro เพื่อให้ ticker ของหน้าย่อยที่เรียก <Announcement />
// เปล่าๆ วิ่งข้อความเดียวกับหน้าแรก และห้ามขึ้นต้นด้วย emoji เพราะ marquee render
// ข้อความซ้ำและ emoji ที่ฝังในสตริงถูก mark aria-hidden ไม่ได้
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook คู่กับ slide1/slide3 ซึ่งเป็นสไลด์ที่
// อาร์ตตรงกับหัวข้อ docx ข้อ 6 กับข้อ 7 พอดี — slide2 (ระบบแนะนำเพื่อนรับค่า
// คอมมิชชั่น) กับ slide4 เป็นอาร์ตโปรโมชัน ไม่มีหัวข้อ docx ไหนรองรับและเพดาน
// SevenThree เต็มแล้ว จึงไม่ถูกใช้ที่นี่ ส่วนไฟล์ banner ทุกตัว (ทั้งตัวที่มีเลข
// ต่อท้ายและตัวมือถือ) ห้าม import ที่นี่หรือที่ไหนก็ตาม เพราะรูปที่ import คือรูปที่
// ถูก emit ลง dist/ ถึงจะไม่มีใคร render ก็ตาม — banner1 เป็นของ MainLayout จัดการ
// เอง และรูปในหน้านี้ไม่มีตัวไหนใส่ loading="eager"/fetchpriority="high" เพราะ LCP
// เป็นของ hero ใน MainLayout
//
// widget ที่ไม่ได้มาจาก docx (GameRankingBoard, LatestWinnersPremium,
// LoginRtpSection, ReviewCardSumo2, แถวปุ่ม login/register, Faq3, Navfoot) ใช้ป้าย
// เป็น <p>/<span> + aria-label บน <section> และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้าย
// ทั้งชุด ยกเว้นสองตัวที่เป็นภาพประกอบของหัวข้อ docx หนึ่งข้อโดยตรง
// (ProviderGridPremium → ข้อ 3, FeatureHighlights → ข้อ 5) ซึ่งวางต่อท้ายบล็อกนั้นๆ
//
// h1 ×1 + h2 ×6 = หัวข้อ docx พอดี บวก h3 ×3 จาก FeatureHighlights ซึ่งเป็นรายการ
// ย่อยของหัวข้อข้อ 5 ตามข้อยกเว้นเดียวที่ playbook อนุญาต — หัว FAQ เป็น <p> ใน
// Faq3.astro คำถามเป็น <span> ใน <summary> ชื่อกริดค่ายใน ProviderGridPremium.astro
// เป็น <p> และป้ายคอลัมน์ของทุก ContentBox variant เป็น <p>
//
// title กับ description ใช้บรรทัดที่ brief ให้มาตรงๆ ทั้งคู่ ห้ามเติมหรือตัด และเป็น
// สตริงเดียวกับที่ส่งเข้า pageGraph และ MainLayout
const pageTitle = "JAICHUA | สล็อตจ่ายชัวร์ไม่ต้องเดา เกมดังเข้าฟีล ออโต้ไวไม่เสียจังหวะ";
const pageDescription = "JAICHUA สล็อตจ่ายชัวร์ไม่ต้องเดา เกมดังเข้าฟีลมีให้เลือกหลายสไตล์ ของใหม่น่าลองเติมมาเรื่อย ๆ โบนัสมีจังหวะ โปรมีของ พร้อมออโต้ไวไม่เสียจังหวะ";

const announcementMessage =
  "JAICHUA สล็อตจ่ายชัวร์ไม่ต้องเดา เกมดังเข้าฟีล ออโต้ไวไม่เสียจังหวะ • เว็บตรง API แท้ ยิงตรงจากคลังเกมหลัก ไม่ผ่านเอเย่นต์ ค่า RTP ตรงตามสเปกโรงงาน ชนะเท่าไหร่ถอนได้เท่านั้น ไม่มีหมกเม็ด ไม่ล็อกยูส • วางโครงสร้างระบบหลังบ้านให้เสถียรระดับสูงสุด ประมวลผลแม่นยำ ไร้ปัญหาเกมค้างหรือสลีปหลุด ทุกยอดชนะคำนวณเงินให้แบบเรียลไทม์ • ขนทัพค่ายเกมชั้นนำระดับโลกมาครบครัน ทั้ง PG Soft, Pragmatic Play และ Joker Gaming ครบทั้งสล็อตวิดีโอ 3D สล็อตตัวคูณสะสมโหด และสายซื้อฟีเจอร์ฟรีสปิน สลับเล่นได้ผ่านกระเป๋าเดียว • อัปเดตรายชื่อเกมใหม่เข้าคลังต่อเนื่องทันทีที่ค่ายผู้พัฒนาปล่อยตัวเกมออกมา คัดเฉพาะตัวเด็ดแตกง่ายมาเติมคลังให้ค้นหาต่อได้ไม่รู้จบ • ลูกเล่นแจกโบนัสอัดแน่นทุกเกม ทั้งระบบสุ่มแจกตัวคูณ Multiplier สัญลักษณ์ Expanding Wild ขยายเต็มจอ และคอมโบแตกต่อเนื่อง Cascading • โปรมีของให้กดรับเองผ่านหน้าแดชบอร์ด ทั้งโบนัสต้อนรับสมาชิกใหม่ โปรเติมเงินฝากแรกของวัน และสิทธิ์คืนยอดเสีย Cash Back ทุกวัน เงื่อนไขโปร่งใส ไม่ติดเทิร์นโอเวอร์มหาโหด • ฝาก-ถอนผ่าน Gateway ตรง รองรับทั้งธนาคารและ TrueMoney Wallet ทำรายการเสร็จใน 3 วินาที ไม่ต้องส่งสลิป ไม่ต้องผ่านแอดมิน";

// FAQ ห้าข้อเขียนขึ้นใหม่จากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้า
// ไหนมาทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบ
// คำถามที่สายปั่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq3> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน — ห้ามปล่อยให้
// Faq3 ใช้ค่า default ของตัวเอง เพราะ default เป็นลิสต์ว่างโดยตั้งใจ
const faqs = [
  {
    q: "JAICHUA เป็นเว็บตรงจริงไหม แล้วค่า RTP ตรงตามสเปกหรือเปล่า",
    a: "เป็นสล็อตเว็บตรงที่เชื่อมต่อ API แท้ ยิงตรงจากคลังเกมหลักโดยไม่ผ่านเอเย่นต์ ค่า RTP จึงตรงตามสเปกโรงงานที่ค่ายผู้พัฒนากำหนดไว้จริง ไม่มีการปรับลดเปอร์เซ็นต์การชนะระหว่างทาง การันตีอัตราการจ่ายเงินรางวัลตามมาตรฐานสากล ชนะเท่าไหร่ถอนได้เท่านั้น ไม่มีหมกเม็ดและไม่ล็อกยูส",
  },
  {
    q: "มีค่ายเกมอะไรบ้าง แล้วต้องโยกเงินข้ามค่ายไหม",
    a: "ขนทัพค่ายเกมชั้นนำระดับโลกมาไว้แบบครบครัน ทั้ง PG Soft, Pragmatic Play และ Joker Gaming เสิร์ฟเกมดังหลากแนวทั้งสล็อตวิดีโอ 3D ภาพสวย สล็อตตัวคูณสะสมโหด และสล็อตสายซื้อฟีเจอร์ฟรีสปิน สลับเปลี่ยนอารมณ์การเดิมพันข้ามค่ายได้ทันทีผ่านกระเป๋าเดียว ไม่ต้องโยกเงินและไม่ต้องสลับแอป",
  },
  {
    q: "เกมใหม่เข้าคลังบ่อยแค่ไหน หรือมีแต่เกมเดิมวนไปมา",
    a: "ล็อบบี้ไม่หยุดอยู่แค่เกมเดิม ระบบอัปเดตรายชื่อเกมใหม่เข้าคลังอย่างต่อเนื่องทันทีที่ค่ายผู้พัฒนาปล่อยตัวเกมออกมา คัดเฉพาะตัวเด็ดแตกง่ายมาเติม สมาชิกจึงได้ทดลองฟีเจอร์สดใหม่ อ่านจังหวะโบนัส และสัมผัสประสบการณ์เดิมพันใหม่ๆ ก่อนใคร มีตัวเลือกให้ค้นหาต่อได้ไม่รู้จบ",
  },
  {
    q: "ลูกเล่นแจกโบนัสในเกมมีอะไรบ้าง",
    a: "แต่ละรอบมีอะไรน่าลุ้นมากกว่าแค่หน้าสปิน ทั้งระบบสุ่มแจกตัวคูณ Multiplier ที่ยิ่งหมุนยิ่งคูณหนัก สัญลักษณ์ Expanding Wild ที่ขยายเต็มจอ และคอมโบแตกต่อเนื่อง Cascading ที่ลากผลลัพธ์ได้หลายชั้นในตาเดียว ส่วนโปรก็มีของจริงให้กดรับเองผ่านหน้าแดชบอร์ด ทั้งโบนัสต้อนรับ โปรฝากแรกของวัน และคืนยอดเสีย Cash Back ทุกวัน",
  },
  {
    q: "ฝากถอนใช้เวลานานไหม รองรับช่องทางอะไรบ้าง",
    a: "ระบบการเงินขับเคลื่อนด้วยออโต้ไฮสปีดผ่าน Gateway ตรง รองรับทั้งบัญชีธนาคารและ TrueMoney Wallet ทำรายการเสร็จภายใน 3 วินาที ยอดเงินอัปเดตเข้าเกมทันทีและถอนเข้าบัญชีได้ทันที ไม่ต้องส่งสลิปและไม่ต้องรอแอดมินตรวจ เงื่อนไขโปรก็โปร่งใส ไม่ติดเทิร์นโอเวอร์มหาโหด",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxCyberCut as="h1" title="JAICHUA สล็อตจ่ายชัวร์ไม่ต้องเดา เกมดังเข้าฟีล ออโต้ไวไม่เสียจังหวะ">
    <p class="text-left text-base leading-relaxed">
      JAICHUA สล็อตเว็บตรง API แท้ ยิงตรงจากคลังเกมหลัก ไม่ผ่านเอเย่นต์ การันตีอัตราการจ่ายเงินรางวัลตามมาตรฐานสากล ค่า RTP ตรงตามสเปกโรงงาน ชนะเท่าไหร่ถอนได้เท่านั้น ไม่มีหมกเม็ด ไม่ล็อกยูส
      ปั่นได้สบายใจด้วยระบบฝากถอนออโต้ไฮสปีด ทำรายการไวใน 3 วินาที จ่ายจริงจ่ายไว สมชื่อจ่ายชัวร์แบบไม่ต้องเดา
    </p>
  </ContentBoxCyberCut>

  <ContentBoxTwoPremium
    as="h2"
    title="JAICHUA สล็อตจ่ายชัวร์ไม่ต้องเดา เปิดฟอร์มความพร้อมให้ทุกจังหวะไปต่อได้คล่อง"
    titleleft="โครงสร้างหลังบ้านเสถียรระดับสูงสุด"
    titleright="ประมวลผลแม่นยำ คำนวณแบบเรียลไทม์">
    <p slot="left" class="text-left text-base leading-relaxed">
      วางโครงสร้างระบบหลังบ้านให้มีความเสถียรระดับสูงสุด JAICHUA สล็อตจ่ายชัวร์ไม่ต้องเดา เคลียร์ทุกขั้นตอนยุ่งยากออกทั้งหมด ให้ผู้เล่นเข้าถึงการทำกำไรได้รวดเร็วทันใจ
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
