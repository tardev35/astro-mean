---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBox3ThreeCyberCut from "../components/ContentBox3ThreeCyberCut.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners4 from "../components/LatestWinners4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq4 from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgProviders from "../assets/slide3.png";
import imgCashback from "../assets/slide1.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   0 → ContentBoxPremium as="h1"
//   1 → ContentBoxTwoCyberCut as="h2" (แบ่งย่อหน้าเดียวลง left/right) แล้วต่อด้วย
//       GameRankingBoard ซึ่งเป็นภาพประกอบของหัวข้อนี้โดยตรง (เกมฮิตตัวตึงมาแรง)
//   2 → ContentBoxSevenThreeCyberCut as="h2" + slide3 แล้วต่อด้วย ProviderGrid
//       ซึ่งเป็นภาพประกอบของหัวข้อนี้โดยตรง (ค่ายดังที่รวมไว้ในล็อบบี้เดียว)
//   3 → ContentBoxNeumorphism as="h2"
//   4 → ContentBoxSevenThreeNeumorphism as="h2" + slide1 (คืนยอดเสีย 5% ทุกสัปดาห์)
//   5 → ContentBox3ThreeCyberCut as="h2" (แบ่งย่อหน้าเดียวลง left/center/right)
//   6 → ContentBoxFloatingBadge as="h2"
//
// variant รอบนี้หมุนทั้งตระกูลจาก GGPLUS88 (CyberCut + SevenThreePremium + Special
// + TwoPremium + SevenThree + 3ThreePremium + ContentBox) มาเป็น Premium +
// TwoCyberCut + SevenThreeCyberCut + Neumorphism + SevenThreeNeumorphism +
// 3ThreeCyberCut + FloatingBadge ส่วน Navbar ย้ายจาก NavbarStyle10 มาเป็น
// NavbarStyle6, Footer จาก FooterStyle3 มาเป็น FooterStyle2, Announcement จาก
// Announcement3 มาเป็น Announcement5, LatestWinners จาก LatestWinners2 มาเป็น
// LatestWinners4 และ Faq จาก Faq3 มาเป็น Faq4
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook — slide3 (หญิงสาวชุดส้มถือไพ่เอซคู่
// ข้อความ รวมทุกค่ายเดิมพัน ไม่มีขั้นต่ำ) คู่กับหัวข้อข้อ 2 เรื่องค่ายดังครบเครื่อง
// และ slide1 (คืนยอดเสีย 5% ทุกสัปดาห์ พร้อมกระปุกออมสินทอง) คู่กับหัวข้อข้อ 4
// เรื่องโบนัสพร้อมทุกวัน ส่วน slide2 ถูกใช้ในกริดของหน้า /promotion เท่านั้น
//
// slide4 (22 ส.ค.) กับ banner.png และ banner2/3/4 เป็นอาร์ตค้างของแบรนด์ก่อนๆ ทั้งชุด
// จึงห้าม import ที่นี่ทั้งสิ้น — รูปที่ import คือรูปที่ถูก emit ถึงจะไม่มีใคร render
// ก็ตาม ส่วน banner1 กับ banner1-mobile เป็นของ MainLayout จัดการเอง
//
// widget ที่ไม่ได้มาจาก docx (LatestWinners4, LoginRtpSection, ReviewCardSumo2,
// SmoothCarousel, แถวปุ่ม login/register, FAQ) ใช้ป้ายเป็น <p>/<span> + aria-label
// บน <section> และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้ายทั้งชุด ยกเว้น GameRankingBoard
// กับ ProviderGrid ที่เป็นภาพประกอบของหัวข้อ docx ข้อ 1 และ 2 โดยตรง จึงวางต่อท้าย
// บล็อกนั้นๆ ไม่มีตัวไหนคั่นระหว่างหัวข้อ docx สองข้อโดยไม่มีเหตุผล
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx พอดี ไม่มีตัวที่เจ็ด — หัว FAQ เป็น <p> ใน
// Faq4.astro (ชื่อ section ย้ายไป aria-label) คำถามใน Faq เป็น <span> ใน <summary>
// ไม่ใช่ h3 และป้ายคอลัมน์ของ TwoCyberCut / SevenThreeCyberCut /
// SevenThreeNeumorphism / 3ThreeCyberCut เป็น <p> — docx รอบนี้แบน H1 + H2 ล้วน
// หน้านี้จึงไม่มี h3 เลย
//
// title ใช้บรรทัด Title ของ docx ตรงๆ (64 ตัวอักษร) ส่วน description ใช้บรรทัด Des
// ของ docx โดยต่อหางเป็น "ถอนได้จริง" ให้ยาว 155 ตัวอักษร — ข้อความดิบของ docx อยู่ที่
// 149 ตัวอักษร ต่ำกว่าเกท 150–160 ของ tools/verify-build.mjs ซึ่งจะทำให้ build แดง
// ค่าที่ใช้เป็นสตริงเดียวกับที่ส่งเข้า pageGraph และตรงกับ default ของ MainLayout
const pageTitle = "VIREL168 | สล็อตเว็บตรงเกมฮิต ค่ายดังครบเครื่อง โบนัสพร้อมทุกวัน";
const pageDescription =
  "VIREL168 สล็อตเว็บตรงเกมฮิต ค่ายดังครบเครื่อง เปิดมาเจอทั้งตัวท็อปและเกมน่าค้น โบนัสพร้อมทุกวัน จัดหมวดเลือกง่าย สลับค่ายคล่อง โอนไวเข้าบัญชีเลย ถอนได้จริง";

// default message ของ Announcement ทุก variant คือสโลแกนของแบรนด์เก่าคนละเจ้ากัน
// จึงส่ง message ตรงๆ เสมอ ไม่พึ่ง default และห้ามขึ้นต้นด้วย emoji เพราะ marquee
// render ข้อความซ้ำและ emoji ที่ฝังในสตริงถูก mark aria-hidden ไม่ได้ — ข้อความชุดนี้
// ตรงกับ default ของ Announcement5 เป๊ะ เพื่อให้ ticker ของหน้าย่อยที่เรียก
// <Announcement /> เปล่าๆ วิ่งข้อความเดียวกับหน้าแรก
const announcementMessage =
  "VIREL168 สล็อตเว็บตรงเกมฮิต ค่ายดังครบเครื่อง โบนัสพร้อมทุกวัน • เว็บตรงที่รวมเกมสล็อตแตกง่ายติดเทรนด์จากทุกค่ายชั้นนำมาไว้ในที่เดียว พร้อมระบบที่ลื่นไหลไร้ปัญหากระตุก ทำกำไรได้โปร่งใส ถอนเงินได้จริงทุกยอด • ไลน์อัปเกมฮิตระดับตัวตึงที่กำลังเป็นกระแสในหมู่สายปั่น ทั้งธีมผจญภัยสุดอลังการและแนวแอ็กชันที่มีฟีเจอร์ตัวคูณสะสมแบบทวีคูณ • รวมค่ายเกมยักษ์ใหญ่ระดับโลกไว้ในล็อบบี้เดียว เปิดเข้ามาครั้งเดียวเลือกเล่นได้ตามความชอบ ไม่ต้องเสียเวลาโยกเว็บไปมาเพื่อตามหาเกมค่ายโปรด • เกมนอกกระแสหลายตัวซ่อนลูกเล่นไว้ ทั้งฟรีสปินที่ออกง่ายเกินคาดและสัญลักษณ์พิเศษที่เปลี่ยนรางวัลธรรมดาให้กลายเป็นแจ็คพอตก้อนโต • โปรโมชันต้อนรับ โบนัสเติมเงินรายวัน และกิจกรรมพิเศษตามเทศกาล เพิ่มทุนให้ปั่นสล็อตได้นานขึ้นและลุ้นรางวัลใหญ่บ่อยขึ้น • จัดวางหมวดหมู่เกมเป็นระเบียบ แบ่งตามค่ายและสไตล์การเล่นชัดเจน สลับค่ายได้ทันทีเพียงไม่กี่คลิก ระบบตอบสนองไวไม่ต้องรอโหลดนาน • ระบบการเงินออโต้กดถอนเองได้ทันทีผ่านหน้าเว็บ ยอดเงินเข้าบัญชีแม่นยำภายในไม่กี่วินาที ไม่ต้องส่งสลิปยืนยันหรือรอแอดมินอนุมัติ";

// FAQ ห้าข้อเขียนจากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้าไหนมา
// ทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบคำถาม
// ที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq4> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน
const faqs = [
  {
    q: "VIREL168 เป็นสล็อตเว็บตรงจริงไหม เล่นแล้วถอนได้ทุกยอดหรือเปล่า",
    a: "เป็นเว็บตรงที่รวบรวมเกมสล็อตแตกง่ายติดเทรนด์จากทุกค่ายชั้นนำมาไว้ในที่เดียว ระบบทำงานลื่นไหลไร้ปัญหากระตุก บรรยากาศการทำกำไรโปร่งใสตรวจสอบได้ และถอนเงินได้จริงทุกยอด ไม่ว่าจะทำกำไรก้อนเล็กหรือก้อนใหญ่ก็กดถอนผ่านหน้าเว็บได้ด้วยตัวเองตั้งแต่ครั้งแรกที่เข้ามาใช้งาน",
  },
  {
    q: "เกมฮิตที่กำลังมาแรงในตอนนี้มีแนวไหนบ้าง ควรเก็บเข้าลิสต์ตัวไหนดี",
    a: "ไลน์อัปเกมฮิตระดับตัวตึงที่กำลังเป็นกระแสในหมู่สายปั่นมีทั้งเกมสล็อตธีมผจญภัยสุดอลังการและเกมแนวแอ็กชันที่มีฟีเจอร์ตัวคูณสะสมแบบทวีคูณ ทุกเกมล้วนผ่านการคัดสรรมาแล้วว่ามีอัตราการจ่ายเงินรางวัลที่ดีเยี่ยม ลุ้นรอบแจ็คพอตง่าย และให้ความสนุกแบบไม่มีเบื่อ",
  },
  {
    q: "รวมค่ายเกมไว้กี่ค่าย ต้องสมัครหลายเว็บเพื่อเล่นค่ายโปรดไหม",
    a: "ไม่ต้องเลย จุดเด่นคือการรวมค่ายเกมยักษ์ใหญ่ระดับโลกมาไว้ในล็อบบี้เดียว ทั้งค่ายที่ขึ้นชื่อเรื่องภาพสวยสมจริงและค่ายที่เน้นจังหวะโบนัสระเบิดไว เปิดเข้ามาเพียงครั้งเดียวก็เลือกเล่นได้ตามความชอบ ไม่ต้องเสียเวลาโยกเว็บไปมาเพื่อตามหาเกมค่ายโปรดอีกต่อไป",
  },
  {
    q: "โบนัสและโปรโมชันมีให้รับบ่อยแค่ไหน แต่ละช่วงมีอะไรใหม่บ้าง",
    a: "มีโบนัสและสิทธิประโยชน์สุดคุ้มเตรียมไว้ต้อนรับอยู่เสมอ ทั้งโปรโมชันต้อนรับ โบนัสเติมเงินรายวัน และกิจกรรมพิเศษตามเทศกาล ทั้งหมดออกแบบมาเพื่อช่วยเพิ่มทุนให้นำไปปั่นสล็อตได้นานขึ้น เพิ่มโอกาสพิชิตรางวัลใหญ่ และทำให้การเข้าเล่นแต่ละวันมีสีสันน่าติดตามอยู่ตลอด",
  },
  {
    q: "ถอนเงินต้องส่งสลิปยืนยันหรือรอแอดมินอนุมัติไหม ใช้เวลานานแค่ไหน",
    a: "ไม่ต้องส่งสลิปยืนยันและไม่ต้องรอแอดมินอนุมัติ ระบบการเงินเป็นออโต้ที่เชื่อมโยงตั้งแต่ขั้นตอนการเข้าเล่นจนถึงขั้นตอนการถอนเงิน เมื่อทำกำไรได้ตามเป้าก็กดถอนผ่านหน้าเว็บได้ด้วยตัวเองทันที ยอดเงินจะถูกโอนเข้าบัญชีอย่างแม่นยำและรวดเร็วภายในไม่กี่วินาที",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxPremium as="h1" title="VIREL168 สล็อตเว็บตรงเกมฮิต ค่ายดังครบเครื่อง โบนัสพร้อมทุกวัน">
    <p class="text-left text-base leading-relaxed">
      ถ้าคุณกำลังมองหาเว็บสล็อตที่รวมความบันเทิงไว้อย่างลงตัว VIREL168 คือเว็บตรงที่ไม่ควรพลาด ที่นี่รวบรวมเกมสล็อตแตกง่ายติดเทรนด์จากทุกค่ายชั้นนำมาไว้ในที่เดียว
      พร้อมอัปเดตระบบการทำงานให้ลื่นไหล ไร้ปัญหากระตุก และการันตีจังหวะการแจกโบนัสแบบจัดเต็มทุกวัน ให้ผู้เล่นได้สัมผัสบรรยากาศการทำกำไรที่โปร่งใส ถอนเงินได้จริงทุกยอด
      และสร้างความมั่นใจในทุกสปินตั้งแต่ครั้งแรกที่เข้ามาใช้งาน
    </p>
  </ContentBoxPremium>

  <ContentBoxTwoCyberCut
    as="h2"
    title="VIREL168 สล็อตเว็บตรงเกมฮิต มีตัวไหนมาแรงจนควรเก็บเข้าลิสต์บ้าง?"
    titleleft="ไลน์อัปเกมฮิตระดับตัวตึง"
    titleright="คัดมาแล้วว่าจ่ายดี ลุ้นแจ็คพอตง่าย">
    <p slot="left" class="text-left text-base leading-relaxed">
      เมื่อก้าวเข้ามาที่ VIREL168 คุณจะได้พบกับไลน์อัปเกมฮิตระดับตัวตึงที่กำลังเป็นกระแสในหมู่สายปั่น ไม่ว่าจะเป็นเกมสล็อตธีมผจญภัยสุดอลังการ
      หรือเกมแนวแอ็กชันที่มีฟีเจอร์ตัวคูณสะสมแบบทวีคูณ
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      ทุกเกมล้วนผ่านการคัดสรรมาแล้วว่ามีอัตราการจ่ายเงินรางวัลที่ดีเยี่ยม ลุ้นรอบแจ็คพอตง่าย และให้ความสนุกแบบไม่มีเบื่อ เป็นลิสต์เกมเด็ดที่สายปั่นตัวจริงควรเซฟไว้ในใจ
    </p>
  </ContentBoxTwoCyberCut>

  <GameRankingBoard />

  <ContentBoxSevenThreeCyberCut
    as="h2"
    title="ค่ายดังครบเครื่องที่ VIREL168 รวมไว้ เปิดครั้งเดียวเจอเกมได้หลายสไตล์"
    titleleft="รวมทุกค่ายไว้ในล็อบบี้เดียว">
    <Picture
      slot="left"
      src={imgProviders}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 767px) 92vw, 340px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
