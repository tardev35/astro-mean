---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ContentBox3ThreeFloatingBadge from "../components/ContentBox3ThreeFloatingBadge.astro";
import ContentBox3Three from "../components/ContentBox3Three.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import LatestWinnersCyber from "../components/LatestWinnersCyber.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Faq3 from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgMonthlyBonus from "../assets/slide2.png";
import imgWelcomeBonus from "../assets/slide1.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxFloatingBadge as="h1" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   2 → ContentBoxTwo as="h2" (ย่อหน้าเดียวแบ่งลง left/right ตามลำดับประโยคเดิม
//       ไม่ตัดและไม่ย่อ: ฝั่งดีลเลอร์แจกไพ่จริง → ฝั่งมุมกล้องกับสัญญาณ)
//   3 → ContentBox3ThreeFloatingBadge as="h2" (ย่อหน้าเดียวแบ่งลงสามคอลัมน์ตาม
//       จังหวะประโยค: รายชื่อค่าย → รายชื่อโต๊ะ → ช่วงงบเบทของห้อง) แล้วต่อด้วย
//       ProviderGrid ซึ่งกางรายชื่อค่ายที่ย่อหน้าเดียวกันพูดถึง
//   4 → ContentBox3Three as="h2" (ย่อหน้าเดียวแบ่งลงสามคอลัมน์: สลับโต๊ะในยูส
//       เดียว → กระเป๋าเงินเดียว → ไม่ต้องโยกเงินข้ามค่าย) แล้วต่อด้วย
//       GameRankingBoard กับ SmoothCarousel ซึ่งกางหมวดโต๊ะสดให้เห็นในหน้าเดียว
//   5 → ContentBoxSevenThree as="h2" + slide2 (แบนเนอร์ Monthly Extra Bonus ซึ่ง
//       เป็นภาพของสิทธิ์รายเดือนที่มาจากฐานการเงินที่ย่อหน้านี้พูดถึง) แล้วต่อด้วย
//       LatestWinnersCyber ซึ่งเป็นหลักฐานของประโยค "พร้อมจ่ายทุกยอดชนะทันที"
//   6 → ContentBoxSevenThreeFloatingBadge as="h2" + slide1 (แบนเนอร์โปรโมชั่น
//       ต้อนรับสมาชิกใหม่ ตรงกับหัวข้อเรื่องลิสต์โปรที่สมาชิกไม่ควรมองข้าม)
//   7 → ContentBoxSpecial as="h2" (ย่อหน้าเดียวแบ่งลงสองครึ่ง: ฝั่งฝาก → ฝั่งถอน)
//
// variant รอบนี้หมุนทั้งตระกูลจากสองรอบก่อน (แบรนด์ชื่อนี้เคยเปิดจากเทมเพลตนี้มา
// แล้วหนึ่งครั้ง): ทรง ContentBox เป็นชุด FloatingBadge นำ + ตัวเปล่า + Special
// ส่วน Navbar เป็น NavbarStyle9, Footer เป็น FooterStyle2, Announcement เป็น
// Announcement5, LatestWinners เป็น LatestWinnersCyber, ProviderGrid เป็นตัวเปล่า
// และ Faq เป็น Faq3
//
// ContentBoxSevenThree ปล่อยหัวข้อจาก prop `title` ตัวเดียวในคอลัมน์ฝั่ง 7 ส่วน
// ส่วน titleleft/titleright เป็นป้ายคอลัมน์ที่ยังเป็น <p> ทั้งคู่
//
// Announcement ส่ง message ตรงๆ เสมอ เพราะ default ของทุก variant ในตระกูลนี้เป็น
// สโลแกนของแบรนด์เก่าคนละเจ้ากัน ข้อความชุดนี้ตรงกับ default ของ Announcement5
// เป๊ะ เพื่อให้ ticker ของหน้าย่อยที่เรียก <Announcement /> เปล่าๆ วิ่งข้อความเดียว
// กับหน้าแรก และห้ามขึ้นต้นด้วย emoji เพราะ marquee render ข้อความซ้ำและ emoji ที่
// ฝังในสตริงถูก mark aria-hidden ไม่ได้
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook คู่กับ slide1/slide2 ซึ่งเป็นสไลด์
// ของแบรนด์นี้จริงทั้งสองใบ — slide3/slide4 ไปอยู่หน้าโปรโมชั่น ส่วน banner ทุก
// หมายเลข (banner2/3/4 กับ banner.png) เป็นอาร์ตของแบรนด์ก่อนที่มีชื่อและโดเมนของ
// เขาพิมพ์อยู่บนรูป ห้าม import ที่นี่หรือที่ไหนก็ตาม เพราะรูปที่ import คือรูปที่
// ถูก emit ถึงจะไม่มีใคร render ก็ตาม ส่วน banner1 กับ banner1-mobile เป็นของ
// MainLayout จัดการเอง
//
// widget ที่ไม่ได้มาจาก docx (LoginRtpSection, ReviewCardSumo2, แถวปุ่ม
// login/register, FAQ, Navfoot) ใช้ป้ายเป็น <p>/<span> + aria-label บน <section>
// และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้ายทั้งชุด ยกเว้นสี่ตัวที่เป็นภาพประกอบของ
// หัวข้อ docx หนึ่งข้อโดยตรง (ProviderGrid → ข้อ 3, GameRankingBoard กับ
// SmoothCarousel → ข้อ 4, LatestWinnersCyber → ข้อ 5) ซึ่งวางต่อท้ายบล็อกนั้นๆ
//
// h1 ×1 + h2 ×6 = หัวข้อ docx พอดี ไม่มีตัวที่แปด — หัว FAQ เป็น <p> ใน Faq3.astro
// คำถามใน Faq3 เป็น <span> ใน <summary> และป้ายคอลัมน์ของทุก ContentBox variant
// เป็น <p> — docx รอบนี้แบน H1 + H2 ล้วน หน้านี้จึงไม่มี h3 เลย
//
// title ใช้บรรทัด Title ของ docx ตรงๆ ส่วน description ใช้บรรทัด Des ของ docx เป็น
// ฐานแล้วต่อท้ายด้วยข้อเท็จจริงจาก docx อีกวรรคเดียว ("เครดิตเข้าใน 3 วิ") เพราะ
// บรรทัด Des ดิบยาว 138 ตัวอักษร ซึ่งต่ำกว่าเพดานล่าง 150 ตัวของเกทคุณภาพ ทั้งสอง
// ค่าเป็นสตริงเดียวกับที่ส่งเข้า pageGraph และตรงกับที่ส่งให้ MainLayout
const pageTitle = "PAY69 | คาสิโนฟลอร์ใหญ่ โต๊ะสดค่ายดัง เว็บใหญ่ทุนหนาพร้อมแปย์";
const pageDescription = "PAY69 คาสิโนฟลอร์ใหญ่ รวมโต๊ะสดค่ายดังระดับพรีเมียม พร้อมเกมหลายหมวดให้สลับฟีล เว็บใหญ่ทุนหนาพร้อมเพย์ สิทธิพิเศษมีทุกวัน ฝากถอนออโต้ทันใจ เครดิตเข้าใน 3 วิ";

const announcementMessage =
  "PAY69 คาสิโนฟลอร์ใหญ่ โต๊ะสดค่ายดัง เว็บใหญ่ทุนหนาพร้อมเปย์ • คาสิโนสดเว็บตรง API แท้ ยิงสัญญาณสดระดับ Ultra HD ส่งตรงจากฟลอร์คาสิโนจริงในต่างประเทศ ไม่ผ่านเอเย่นต์ เว็บใหญ่เงินทุนหนา การันตีความมั่นคงทางการเงินระดับสากล ถอนหลักแสนหลักล้านจ่ายครบเต็มจำนวน ไม่ล็อคยูส ไม่ปรับอัตราแพ้ชนะ • จำลองบรรยากาศคาสิโนระดับโลกมาไว้บนหน้าจอ ดีลเลอร์แจกไพ่จริงแบบเรียลไทม์ ไร้การตัดต่อหรือใช้คลิปวน มุมกล้องหลากหลายมองเห็นทุกมิติการแทง สัญญาณเสถียรไม่มีอาการกระตุก • รวมค่ายคาสิโนชั้นนำระดับโลกไว้ครบครันทั้ง Evolution Gaming, SA Gaming, Sexy Baccarat และ Pragmatic Play Live มีทั้งบาคาร่าคลาสสิก บาคาร่าสายฟ้า รูเล็ต เสือมังกร และไฮโล เลือกห้องเล่นได้ตั้งแต่หลักสิบไปจนถึงโต๊ะระดับ High Roller • สลับจากโต๊ะบาคาร่าไปเดิมพันรูเล็ต วงล้อเสี่ยงโชค หรือเกมโชว์สดได้ทันทีในยูสเซอร์เดียว ระบบกระเป๋าเงินเดียวยืดหยุ่นสูงสุด ไม่ต้องโยกเงินข้ามค่ายให้เสียเวลา • ฐานการเงินแข็งแกร่งระดับเว็บใหญ่ พร้อมจ่ายทุกยอดชนะทันที รองรับช่องทางการเงินครบครันทั้งธนาคารชั้นนำทั่วไทยและ TrueMoney Wallet เก็บข้อมูลสมาชิกเป็นความลับขั้นสุด • สิทธิพิเศษอัปเดตใหม่ทุกวัน ทั้งโบนัสต้อนรับคาสิโนสด โปรโมชันฝากแรกของวัน คืนยอดเสียรับ Cash Back และคอมมิชชันการชวนเพื่อน เงื่อนไขโปร่งใส ไม่ติดเทิร์นโอเวอร์มหาโหด กดรับเองได้ทันทีผ่านหน้าแดชบอร์ด • ฝากถอนออโต้ประมวลผลผ่าน Gateway ตรง ฝากเงินปุ๊บเครดิตเข้าเกมใน 3 วินาที กดถอนเข้าบัญชีได้ด้วยตัวเอง ไม่ต้องส่งสลิปยืนยัน ไม่ต้องรอแอดมินอนุมัติ";

// FAQ ห้าข้อเขียนขึ้นใหม่จากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้า
// ไหนมาทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบ
// คำถามที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq3> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน
const faqs = [
  {
    q: "PAY69 เป็นคาสิโนสดเว็บตรงจริงไหม แล้วภาพที่เห็นเป็นการถ่ายทอดสดจริงหรือคลิปวน",
    a: "เป็นคาสิโนสดเว็บตรง API แท้ที่ยิงสัญญาณสดระดับ Ultra HD ส่งตรงจากฟลอร์คาสิโนจริงในต่างประเทศ ไม่ผ่านเอเย่นต์คนกลาง ทุกโต๊ะเป็นดีลเลอร์แจกไพ่จริงแบบเรียลไทม์ ไม่มีการตัดต่อและไม่ใช้คลิปวน มีมุมกล้องให้เลือกหลายมุมจึงมองเห็นทุกมิติการแทง สัญญาณเสถียรไม่มีอาการกระตุก และไม่มีการล็อคยูสหรือปรับอัตราแพ้ชนะ",
  },
  {
    q: "มีค่ายคาสิโนสดอะไรบ้าง แล้วมีโต๊ะแบบไหนให้เลือกเล่น",
    a: "รวมค่ายคาสิโนชั้นนำระดับโลกไว้ครบครัน ทั้ง Evolution Gaming, SA Gaming, Sexy Baccarat และ Pragmatic Play Live มีโต๊ะสดให้เลือกเล่นเพียบ ทั้งบาคาร่าคลาสสิก บาคาร่าสายฟ้า รูเล็ต เสือมังกร และไฮโล รวมถึงวงล้อเสี่ยงโชคและเกมโชว์สด เลือกห้องเล่นได้ตามงบเบทตั้งแต่หลักสิบไปจนถึงโต๊ะระดับ High Roller",
  },
  {
    q: "อยากสลับจากบาคาร่าไปเล่นเกมโต๊ะอื่น ต้องโยกเงินข้ามค่ายไหม",
    a: "ไม่ต้องโยกเลย ทุกโต๊ะอยู่ในยูสเซอร์เดียวและใช้ระบบกระเป๋าเงินเดียว เปลี่ยนบรรยากาศการเดิมพันได้ทันทีโดยไม่ต้องย้ายเว็บ อยากสลับจากโต๊ะบาคาร่าไปเดิมพันรูเล็ต วงล้อเสี่ยงโชค หรือเกมโชว์สดก็กดเข้าได้เลย ทำให้บริหารเงินทุนได้ยืดหยุ่นและไม่เสียเวลารอระหว่างเปลี่ยนโต๊ะ",
  },
  {
    q: "ถอนยอดใหญ่ได้จริงไหม แล้วรองรับช่องทางการเงินอะไรบ้าง",
    a: "ฐานการเงินแข็งแกร่งระดับเว็บใหญ่และพร้อมจ่ายทุกยอดชนะทันที ไม่ว่าจะบวกหลักหมื่นหรือหลักล้านก็ถอนออกได้เต็มจำนวน รองรับช่องทางการเงินครบครันทั้งธนาคารชั้นนำทั่วไทยและระบบ TrueMoney Wallet ระบบการเงินวางไว้แน่นหนาและปลอดภัย พร้อมเก็บข้อมูลสมาชิกเป็นความลับขั้นสุด",
  },
  {
    q: "โปรโมชั่นมีอะไรให้เก็บบ้าง ต้องทักแอดมินก่อนไหม แล้วฝากถอนใช้เวลานานแค่ไหน",
    a: "สิทธิพิเศษอัปเดตใหม่ทุกวัน ทั้งโบนัสต้อนรับคาสิโนสด โปรโมชันฝากแรกของวัน คืนยอดเสียรับ Cash Back ทุกวัน และคอมมิชชันการชวนเพื่อน เงื่อนไขโปร่งใสและไม่ติดเทิร์นโอเวอร์มหาโหด กดรับเองได้ทันทีผ่านหน้าแดชบอร์ดโดยไม่ต้องรอแอดมิน ส่วนการเงินเป็นออโต้ผ่าน Gateway ตรง ฝากแล้วเครดิตเข้าเกมใน 3 วินาที และกดถอนเข้าบัญชีได้ด้วยตัวเองโดยไม่ต้องส่งสลิปยืนยัน",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxFloatingBadge as="h1" title="PAY69 คาสิโนฟลอร์ใหญ่ โต๊ะสดค่ายดัง เว็บใหญ่ทุนหนาพร้อมเปย์">
    <p class="text-left text-base leading-relaxed">
      PAY69 คาสิโนสดเว็บตรง API แท้ ยิงสัญญาณสดระดับ Ultra HD ส่งตรงจากฟลอร์คาสิโนจริงในต่างประเทศ ไม่ผ่านเอเย่นต์ เว็บใหญ่เงินทุนหนา การันตีความมั่นคงทางการเงินระดับสากล
      ถอนหลักแสนหลักล้านจ่ายครบเต็มจำนวน ไม่ล็อคยูส ไม่ปรับอัตราแพ้ชนะ พร้อมรองรับทุกยอดเดิมพันด้วยระบบมาตรฐานสูงสุด
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxTwo
    as="h2"
    title="PAY69 คาสิโนฟลอร์ใหญ่ เปิดประสบการณ์โต๊ะสดแบบเต็มอารมณ์คาสิโน"
    titleleft="ดีลเลอร์แจกไพ่จริงแบบเรียลไทม์"
    titleright="มุมกล้องครบทุกมิติ สัญญาณเสถียร"
    iconleft="🎥"
    iconright="📡">
    <p slot="left" class="text-left text-base leading-relaxed">
