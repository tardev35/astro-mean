---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBox3ThreeNeumorphism from "../components/ContentBox3ThreeNeumorphism.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBox3ThreeFloatingBadge from "../components/ContentBox3ThreeFloatingBadge.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinnersPremium from "../components/LatestWinnersPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgNextGen from "../assets/slide1.png";
import imgPayment from "../assets/slide4.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxFloatingBadge as="h1" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   2 → ContentBoxTwoCyberCut as="h2" (แบ่งย่อหน้าเดียวลง intro/left/right)
//   3 → ContentBox3ThreeNeumorphism as="h2" (แบ่งย่อหน้าเดียวลง left/center/right)
//       แล้วต่อด้วย ProviderGrid ซึ่งเป็นภาพประกอบของหัวข้อนี้โดยตรง (เกมลิขสิทธิ์
//       แท้หลายค่าย ทั้งตัวฮิตและตัวน่าลอง)
//   4 → ContentBoxNeumorphism as="h2" แล้วต่อด้วย GameRankingBoard ซึ่งเป็นภาพ
//       ประกอบของหัวข้อนี้โดยตรง (ตัวฮิตไม่ตกเจน เกมใหม่ไม่หลุดลิสต์)
//   5 → ContentBoxSevenThreeCyberCut as="h2" + slide1 (ก้าวสู่มิติใหม่ สล็อตยุค 5G
//       สัมผัสความเร็ว แรง — ตรงกับหัวข้อเรื่องระบบอัปเดตใหม่ที่เข้าไวกว่าเดิม)
//   6 → ContentBox3ThreeFloatingBadge as="h2" (แบ่งย่อหน้าเดียวลง left/center/right)
//   7 → ContentBoxSevenThreeNeumorphism as="h2" + slide4 (ฝาก-ถอน แบบ PAYMENT
//       ไม่ใช้บัญชีม้า — ตรงกับหัวข้อเรื่องฝากถอนออโต้พอดี) แล้วต่อด้วย
//       LatestWinnersPremium ซึ่งเป็นฟีดถอนเงินจริงของหัวข้อเดียวกัน
//
// variant รอบนี้หมุนทั้งตระกูลจากรอบก่อน: ทรง ContentBox เปลี่ยนเป็น FloatingBadge
// + TwoCyberCut + 3ThreeNeumorphism + Neumorphism + SevenThreeCyberCut +
// 3ThreeFloatingBadge + SevenThreeNeumorphism ส่วน Navbar เป็น NavbarCyber,
// Footer เป็น FooterCyber, Announcement เป็น AnnouncementCyber,
// LatestWinners เป็น LatestWinnersPremium และ Faq เป็น Faq3
//
// Announcement ส่ง message ตรงๆ เสมอ เพราะ default ของทุก variant ในตระกูลนี้เป็น
// สโลแกนของแบรนด์เก่าคนละเจ้ากัน ข้อความชุดนี้ตรงกับ default ของ AnnouncementCyber
// เป๊ะ เพื่อให้ ticker ของหน้าย่อยที่เรียก <Announcement /> เปล่าๆ วิ่งข้อความ
// เดียวกับหน้าแรก และห้ามขึ้นต้นด้วย emoji เพราะ marquee render ข้อความซ้ำและ
// emoji ที่ฝังในสตริงถูก mark aria-hidden ไม่ได้
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook — slide1 คู่กับหัวข้อข้อ 5 และ
// slide4 คู่กับหัวข้อข้อ 7 ส่วน slide2 (คืนยอดเสีย 5%) กับ slide3 (โปรขาประจำ
// ฝากครบ 3 วัน) ไม่ถูกวางบนหน้าแรกโดยตั้งใจ — มันอยู่ใน SmoothCarousel กับกริดของ
// หน้า /promotion ซึ่งเป็นที่ของมัน
//
// banner.png / banner2 / banner3 / banner4 เป็นอาร์ตค้างของแบรนด์ก่อนๆ ห้าม import
// ที่นี่ทั้งสิ้น — รูปที่ import คือรูปที่ถูก emit ถึงจะไม่มีใคร render ก็ตาม ส่วน
// banner1 เป็นของ MainLayout จัดการเอง และ banner1-mobile ไม่มีอยู่แล้วในรอบนี้
//
// widget ที่ไม่ได้มาจาก docx (LoginRtpSection, ReviewCardSumo2, SmoothCarousel,
// แถวปุ่ม login/register, FAQ, Navfoot) ใช้ป้ายเป็น <p>/<span> + aria-label บน
// <section> และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้ายทั้งชุด ยกเว้นสามตัวที่เป็น
// ภาพประกอบของหัวข้อ docx หนึ่งข้อโดยตรง (ProviderGrid → ข้อ 3,
// GameRankingBoard → ข้อ 4, LatestWinnersPremium → ข้อ 7) ซึ่งวางต่อท้ายบล็อกนั้นๆ
// ไม่มีตัวไหนคั่นระหว่างหัวข้อ docx สองข้อโดยไม่มีเหตุผล
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx พอดี ไม่มีตัวที่เจ็ด — หัว FAQ เป็น <p> ใน
// Faq3.astro (ชื่อ section ย้ายไป aria-label) คำถามใน Faq เป็น <span> ใน <summary>
// ไม่ใช่ h3 และป้ายคอลัมน์ของ TwoCyberCut / 3ThreeNeumorphism /
// SevenThreeCyberCut / 3ThreeFloatingBadge / SevenThreeNeumorphism เป็น <p> —
// docx รอบนี้แบน H1 + H2 ล้วน หน้านี้จึงไม่มี h3 เลย
//
// title ใช้บรรทัด Title ของ docx ตรงๆ (61 ตัวอักษร) ส่วน description ใช้บรรทัด Des
// ของ docx (141 ตัวอักษร ต่ำกว่าเกท 150–160 ของ tools/verify-build.mjs ซึ่งจะทำให้
// build แดง) โดยต่อหางเป็น "เล่นลื่นไม่สะดุด" ให้ยาว 158 ตัวอักษร ค่าที่ใช้เป็น
// สตริงเดียวกับที่ส่งเข้า pageGraph และตรงกับที่ส่งให้ MainLayout
const pageTitle = "GEN4 | สล็อตเจนใหม่มีของ เกมลิขสิทธิ์แท้มาเต็ม ระบบอัปเดตใหม่";
const pageDescription =
  "GEN4 สล็อตเจนใหม่มีของ เกมลิขสิทธิ์แท้มาเต็มหลายค่าย ตัวฮิตไม่ตกเจน เกมใหม่ไม่หลุดลิสต์ ระบบอัปเดตใหม่ เข้าไวกว่าเดิม ฝากถอนออโต้ไม่ต้องรอนาน เล่นลื่นไม่สะดุด";

const announcementMessage =
  "GEN4 สล็อตเจนใหม่มีของ เกมลิขสิทธิ์แท้มาเต็ม ระบบอัปเดตใหม่ • แพลตฟอร์มสล็อตระดับเนกซ์เจนที่ขนความบันเทิงมาแบบจัดเต็ม ศูนย์รวมเกมลิขสิทธิ์แท้ส่งตรงจากค่ายชั้นนำระดับโลก • คลังเกมขนาดใหญ่ออกแบบมาเพื่อนักเดิมพันยุคปัจจุบันโดยเฉพาะ ทั้งสายกราฟิก 3D สุดอลังการ และสายกลไกเกมแปลกใหม่ที่มีอัตราคูณโบนัสสูง • ล็อบบี้รวมทั้งเกมฮิตระดับตำนานที่แจ็คพอตแตกง่าย และเกมตัวน่าลองนอกกระแสที่มีฟีเจอร์เด็ดซ่อนอยู่ • ทีมงานอัปเดตไลน์อัปเกมใหม่เข้าระบบต่อเนื่อง ค่ายดังเปิดตัวเกมไหนคุณจะได้ทดลองเล่นเป็นกลุ่มแรกๆ เสมอ • อัปเกรดเซิร์ฟเวอร์และซอฟต์แวร์หลังบ้านใหม่ทั้งหมด โหลดหน้าเว็บและหน้าเกมฉับไวขึ้นชัดเจน ไม่หน่วง ไม่กระตุก • คลิกเลือกเกมในล็อบบี้แล้วพุ่งตรงเข้าหน้าสปินได้ในไม่กี่วินาที ตัดขั้นตอนเปลี่ยนผ่านที่ยุ่งยากออกทั้งหมด • ฝากถอนออโต้ตลอด 24 ชั่วโมง เสร็จในไม่กี่วินาที ยอดเข้าบัญชีทันที ไม่ต้องส่งสลิป ไม่ต้องรอแอดมินอนุมัติ";

// FAQ ห้าข้อเขียนจากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้าไหนมา
// ทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบคำถาม
// ที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน
const faqs = [
  {
    q: "GEN4 เป็นสล็อตเจนใหม่ตรงไหน ต่างจากเว็บทั่วไปอย่างไร",
    a: "ที่นี่เป็นแพลตฟอร์มสล็อตระดับเนกซ์เจนที่รวมสามอย่างเข้าด้วยกัน คือคลังเกมลิขสิทธิ์แท้จากค่ายชั้นนำระดับโลก โครงสร้างระบบอัปเดตใหม่ล่าสุดที่ประมวลผลได้รวดเร็ว เสถียร และปลอดภัยในทุกการใช้งาน และอัตราการจ่ายเงินรางวัลที่ได้มาตรฐานยุติธรรม 100% คลังเกมยังถูกออกแบบมาเพื่อรองรับความต้องการของนักเดิมพันยุคปัจจุบันโดยเฉพาะ จึงเลือกเล่นได้แบบไม่ตกเทรนด์",
  },
  {
    q: "เกมในเว็บเป็นลิขสิทธิ์แท้จริงไหม มีค่ายอะไรบ้าง",
    a: "GEN4 จับมือกับค่ายเกมสล็อตยักษ์ใหญ่ทั่วโลกเพื่อนำเสนอลิขสิทธิ์แท้ที่ไม่ผ่านการดัดแปลงโปรแกรมใดๆ ล็อบบี้ถูกจัดให้รวบรวมทั้งเกมฮิตระดับตำนานที่ขึ้นชื่อเรื่องแจ็คพอตแตกง่าย และเกมตัวน่าลองนอกกระแสที่มีฟีเจอร์เด็ดซ่อนอยู่ ผู้เล่นจึงกระจายความเสี่ยงและสลับเปลี่ยนบรรยากาศการทำกำไรได้อย่างอิสระในที่เดียว",
  },
  {
    q: "เกมใหม่เข้าระบบบ่อยแค่ไหน จะได้เล่นก่อนคนอื่นหรือเปล่า",
    a: "มีทีมงานคอยอัปเดตไลน์อัปเกมสล็อตใหม่เข้าสู่ระบบอย่างต่อเนื่อง ค่ายดังเปิดตัวเกมไหน หรือมีกระแสเกมสล็อตตัวไหนกำลังมาแรง สมาชิกจะได้สัมผัสและทดลองเล่นเป็นกลุ่มแรกๆ เสมอ หน้าเกมจึงมีความสดใหม่อยู่ตลอดเวลา และเพิ่มตัวเลือกทำเงินใหม่ๆ ให้ตามต่อได้แบบไม่มีคำว่าหลุดลิสต์",
  },
  {
    q: "ระบบอัปเดตใหม่ช่วยให้เข้าเล่นไวขึ้นอย่างไร",
    a: "จุดเปลี่ยนสำคัญคือการอัปเกรดเซิร์ฟเวอร์และซอฟต์แวร์หลังบ้านใหม่ทั้งหมด ช่วยลดระยะเวลาโหลดหน้าเว็บและหน้าเกมให้ฉับไวขึ้นอย่างเห็นได้ชัด การเปลี่ยนค่ายเกม สลับเมนู หรือกดเลือกโหมดต่างๆ ทำได้ลื่นไหล รองรับการใช้งานพร้อมกันของสมาชิกจำนวนมากได้สบายๆ โดยไม่มีอาการหน่วงหรือกระตุกมาทำลายจังหวะสำคัญ",
  },
  {
    q: "ฝากถอนใช้เวลานานไหม ต้องส่งสลิปหรือรอแอดมินอนุมัติหรือเปล่า",
    a: "ระบบฝากถอนออโต้สุดไฮสปีดพร้อมจัดการธุรกรรมทางการเงินให้ตลอด 24 ชั่วโมง ดำเนินการเสร็จสรรพผ่านหน้าเว็บในไม่กี่วินาที ยอดเงินอัปเดตตรงเป๊ะเข้าสู่บัญชีทันทีโดยไม่ต้องส่งสลิปยืนยัน และไม่ต้องเสียเวลานั่งรอแอดมินกดอนุมัติ จึงบริหารจัดการเงินทุนและถอนกำไรออกไปใช้ได้อย่างสบายใจตั้งแต่ต้นจนจบ",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxFloatingBadge as="h1" title="GEN4 สล็อตเจนใหม่มีของ เกมลิขสิทธิ์แท้มาเต็ม ระบบอัปเดตใหม่">
    <p class="text-left text-base leading-relaxed">
      เปิดมิติใหม่ของการเล่นสล็อตออนไลน์ยุคใหม่ไปกับ GEN4 แพลตฟอร์มสล็อตระดับเนกซ์เจนที่ขนความบันเทิงมาแบบจัดเต็ม ที่นี่โดดเด่นด้วยการเป็นศูนย์รวมเกมลิขสิทธิ์แท้ส่งตรงจากค่ายชั้นนำระดับโลก
      มาพร้อมโครงสร้างระบบอัปเดตใหม่ล่าสุดที่ประมวลผลได้อย่างรวดเร็ว เสถียร และปลอดภัยในทุกการใช้งาน ให้สายปั่นได้สัมผัสการทำกำไรที่ลื่นไหล ไม่มีสะดุด
      ควบคู่ไปกับอัตราการจ่ายเงินรางวัลที่ได้มาตรฐานยุติธรรม 100%
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxTwoCyberCut
    as="h2"
    title="GEN4 สล็อตเจนใหม่มีของ เปิดคลังเกมให้เลือกแบบไม่ตกยุค"
    titleleft="เลือกได้ทั้งสาย 3D และสายตัวคูณ"
    titleright="ปั่นแล้วตื่นตาตื่นใจอยู่เสมอ">
    <p class="text-left text-base leading-relaxed">
      ความสมกับเป็นสล็อตเจนใหม่ของ GEN4 เริ่มต้นที่คลังเกมสล็อตขนาดใหญ่ซึ่งถูกออกแบบมาเพื่อรองรับความต้องการของนักเดิมพันยุคปัจจุบันโดยเฉพาะ
    </p>
    <p slot="left" class="text-left text-base leading-relaxed">
      ไม่ว่าคุณจะเป็นสายชอบงานภาพกราฟิก 3D สุดอลังการ หรือชอบกลไกเกมแปลกใหม่ที่มีอัตราคูณโบนัสสูง ที่นี่ก็มีตัวเลือกให้ค้นหาและเข้าเล่นได้แบบไม่มีตกเทรนด์
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">ช่วยเปิดโลกการปั่นสล็อตให้ตื่นตาตื่นใจและน่าติดตามอยู่เสมอ</p>
  </ContentBoxTwoCyberCut>

  <ContentBox3ThreeNeumorphism
    as="h2"
    title="เกมลิขสิทธิ์แท้หลายค่ายใน GEN4 รวมทั้งตัวฮิตและตัวน่าลอง"
    titleleft="จับมือค่ายยักษ์ใหญ่ทั่วโลก"
    titlecenter="ตัวฮิตกับตัวน่าลองอยู่ล็อบบี้เดียวกัน"
    titleright="กระจายความเสี่ยงได้อิสระ">
    <p slot="left" class="text-left text-base leading-relaxed">
