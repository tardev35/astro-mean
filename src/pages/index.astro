---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinnersPremium from "../components/LatestWinnersPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Faq4 from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgNewMemberBonus from "../assets/slide1.png";
import imgMysteryBoxCredit from "../assets/slide4.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxPremium as="h1" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   2 → ContentBox3ThreePremium as="h2" (ย่อหน้าเดียวแบ่งลงสามคอลัมน์ตามลำดับ
//       ประโยคเดิม: กวาดเกม A-List จากค่ายยักษ์ใหญ่ → คัดกรองการจ่ายกับกราฟิก →
//       ทุกเบทอยู่บนระบบมาตรฐานสากล) แล้วต่อด้วย ProviderGridPremium ซึ่งกางโลโก้
//       ค่ายที่ย่อหน้าเดียวกันเอ่ยชื่อไว้
//   3 → ContentBoxTwoPremium as="h2" (ย่อหน้าเดียวแบ่งสองครึ่ง: เกมกระแสติดชาร์ต →
//       เกมนอกกระแสอัตราคูณโหด)
//   4 → ContentBoxSevenThreePremium as="h2" + slide1 (อาร์ตสไลด์เป็นแผ่นป้ายทอง
//       เขียนว่า "สมาชิกใหม่ รับโบนัส 30% สูงสุด 1,000 บาท" ตรงกับโบนัสสมทบทุน
//       ฝากแรกในย่อหน้านี้)
//   5 → ContentBoxSpecial as="h2" (ย่อหน้าเดียวแบ่งสองครึ่งลงสองการ์ดไอคอน) แล้ว
//       ต่อด้วย FeatureHighlights (ฟีเจอร์ย่อยสามตัวที่ย่อหน้านี้ระบุชื่อไว้ตรงๆ →
//       h3 สามตัว ซึ่งเป็น h3 ชุดเดียวที่ได้รับอนุญาตบนหน้านี้)
//   6 → ContentBoxTwo as="h2" (ย่อหน้าเดียวแบ่งสองครึ่ง: เกมใหม่ขึ้นแถวหน้า →
//       เช็กอัตราจ่าย/ทดลองเล่นก่อนขึ้นสปิน) แล้วต่อด้วย SmoothCarousel กับ
//       GameRankingBoard ซึ่งเป็นล็อบบี้ที่ย่อหน้านี้พูดถึงในรูปที่มองเห็นได้
//   7 → ContentBoxSevenThree as="h2" + slide4 (อาร์ตสไลด์เขียนว่า "เปิดกล่องสุ่ม
//       ลุ้นรับเครดิตฟรี สูงสุดถึง 1,000" ซึ่งเป็นสิทธิ์ที่กดรับแล้วถอนผ่านระบบ
//       ออโต้ในย่อหน้านี้) แล้วต่อด้วย LatestWinnersPremium ซึ่งเป็นหลักฐานของ
//       ประโยคเรื่องถอนเสร็จในไม่กี่วินาที
//
// variant รอบนี้หมุนออกจากชุดของแบรนด์ก่อนทั้งตระกูล: ทรง ContentBox เปลี่ยนจากชุด
// FloatingBadge/CyberCut/Neumorphism นำ มาเป็นชุด Premium นำ (Premium ×4) + Special
// + ตัวเปล่า ×2 ส่วน Announcement เป็น Announcement5, LatestWinners เป็น
// LatestWinnersPremium, ProviderGrid เป็น ProviderGridPremium, ReviewCard เป็น
// ReviewCardSumo2 และ Faq เป็น Faq4 — Navbar/Footer/ฟอนต์ ถูกสลับไว้แล้วใน
// MainLayout กับ brandProfile
//
// ContentBoxSevenThree* ทั้งสองตัวปล่อยหัวข้อจาก prop `title` ตัวเดียว ส่วน
// titleleft เป็นป้ายคอลัมน์รูปที่ยังเป็น <p> — ห้ามส่ง titleright เข้าไป เพราะตัว
// เปล่าจะสลับไปใช้ titleright เป็นหัวข้อแทน title และตัว Premium จะเพิ่มป้ายซ้อน
// ใต้หัวข้อเดียวกัน
//
// Announcement ส่ง message ตรงๆ เสมอ เพราะ default ของทุก variant ในตระกูลนี้เป็น
// สโลแกนของแบรนด์เก่าคนละเจ้ากัน ข้อความชุดนี้ต้องตรงกับ default ของ Announcement5
// เป๊ะ เพื่อให้ ticker ของหน้าย่อยที่เรียก <Announcement /> เปล่าๆ วิ่งข้อความเดียว
// กับหน้าแรก และห้ามขึ้นต้นด้วย emoji เพราะ marquee render ข้อความซ้ำและ emoji ที่
// ฝังในสตริงถูก mark aria-hidden ไม่ได้
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook คู่กับ slide1/slide4 ซึ่งเป็นสไลด์ที่
// อาร์ตตรงกับหัวข้อ docx ข้อ 4 กับข้อ 7 พอดี — slide2 (ฝากแรกของวัน) กับ slide3
// (ลูกค้าไม้ใหญ่) ไม่มีหัวข้อ docx ไหนรองรับและเพดาน SevenThree เต็มแล้ว จึงปล่อย
// ไว้ให้หน้า /promotion ใช้ ส่วน banner ทุกหมายเลข (banner2/3/4) เป็นอาร์ตของแบรนด์
// ก่อน ห้าม import ที่นี่หรือที่ไหนก็ตาม เพราะรูปที่ import คือรูปที่ถูก emit ถึงจะ
// ไม่มีใคร render ก็ตาม ส่วน banner1 กับ banner1-mobile เป็นของ MainLayout จัดการ
// เอง และรูปในหน้านี้ไม่มีตัวไหนใส่ loading="eager"/fetchpriority="high" เพราะ LCP
// เป็นของ hero ใน MainLayout
//
// widget ที่ไม่ได้มาจาก docx (LoginRtpSection, ReviewCardSumo2, แถวปุ่ม
// login/register, FAQ, Navfoot) ใช้ป้ายเป็น <p>/<span> + aria-label บน <section>
// และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้ายทั้งชุด ยกเว้นสี่ตัวที่เป็นภาพประกอบของ
// หัวข้อ docx หนึ่งข้อโดยตรง (ProviderGridPremium → ข้อ 2, SmoothCarousel กับ
// GameRankingBoard → ข้อ 6, LatestWinnersPremium → ข้อ 7) ซึ่งวางต่อท้ายบล็อกนั้นๆ
//
// h1 ×1 + h2 ×6 = หัวข้อ docx พอดี บวก h3 ×3 จาก FeatureHighlights ซึ่งเป็นรายการ
// ย่อยของหัวข้อข้อ 5 ตามข้อยกเว้นเดียวที่ playbook อนุญาต — หัว FAQ เป็น <p> ใน
// Faq4.astro คำถามเป็น <span> ใน <summary> และป้ายคอลัมน์ของทุก ContentBox variant
// เป็น <p>
//
// title ใช้บรรทัด Title ของ docx ส่วน description ต่อท้ายด้วย "ไม่ติดล็อคยูส" ให้ยาว
// 156 ตัวอักษร เข้ากรอบ 150–160 ของเกทคุณภาพ (บรรทัด Des ดิบของ docx ยาว 142 ตัว
// ซึ่งต่ำกว่ากรอบ) และเป็นสตริงเดียวกับที่ส่งเข้า pageGraph และ MainLayout
const pageTitle = "DEED888 | สล็อตเกมแท้ตัวท็อป จัดโปรฮิตมาเป็นชุด ฟีเจอร์ใหม่น่าลอง";
const pageDescription =
  "DEED888 สล็อตเกมแท้ตัวท็อป รวมทั้งเกมกระแสและตัวใหม่จากค่ายดัง จัดโปรฮิตมาเป็นชุด ฟีเจอร์ใหม่น่าลอง ล็อบบี้อัปเดตต่อเนื่อง พร้อมฝากถอนออโต้ทันใจ ไม่ติดล็อคยูส";

const announcementMessage =
  "DEED888 สล็อตเกมแท้ตัวท็อป จัดโปรฮิตมาเป็นชุด ฟีเจอร์ใหม่น่าลอง • เชื่อมต่อสัญญาณ API ตรงจากสตูดิโอผู้พัฒนาสล็อตระดับโลก ไม่ผ่านเอเย่นต์ ค่า RTP เป็นมาตรฐานยุติธรรมตามสเปกโรงงาน ไม่มีการปรับแต่งเปอร์เซ็นต์แพ้ชนะ • คัดของเด่นจากค่ายดังมาไว้แบบไม่หลุดกระแส กวาดเฉพาะเกมระดับ A-List จาก PG Soft, Pragmatic Play และ Joker Gaming • เกมกระแสมีครบ ตัวใหม่ก็พร้อมมา ทั้งเกมติดอันดับชาร์ตและเกมนอกกระแสอัตราคูณโหด ดึงสัญญาณเกมเข้าใหม่ให้กดสปินทันที • จัดโปรฮิตมาเป็นชุด ทั้งโบนัสสมทบทุนฝากแรก สิทธิ์คืนยอดเสีย Cash Back รายวัน และเครดิตพิเศษเฉพาะช่วงเวลา เงื่อนไขโปร่งใส ถอนได้จริง ไม่ติดล็อคยูส • ฟีเจอร์ใหม่น่าลองมาครบ ทั้งตัวคูณทวีคูณ Multiplier Drops สัญลักษณ์ขยายเต็มรีล Expanding Wilds และโหมดซื้อฟรีสปินแบบทันใจ • ล็อบบี้อัปเดตต่อเนื่อง เกมใหม่และค่ายมาแรงขึ้นแถวหน้าทันทีที่เปิดตัว เช็กอัตราจ่ายและทดลองเล่นฟรีได้ก่อนใคร • พร้อมฝากถอนออโต้ทันใจ ประมวลผลผ่าน Gateway ตรง เสร็จในไม่กี่วินาที ไม่ต้องแนบสลิป ไม่ต้องรอคิวอนุมัติจากแอดมิน";

// FAQ ห้าข้อเขียนขึ้นใหม่จากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้า
// ไหนมาทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบ
// คำถามที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq4> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน — ห้ามปล่อยให้
// Faq4 ใช้ค่า default ของตัวเอง เพราะ default ของทุก variant ในตระกูลนี้เป็นคำถาม
// ของแบรนด์เก่า
const faqs = [
  {
    q: "DEED888 ต่อเกมมาจากไหน แล้วค่า RTP ถูกปรับแต่งหรือเปล่า",
    a: "DEED888 เชื่อมต่อสัญญาณ API ตรงจากสตูดิโอผู้พัฒนาสล็อตระดับโลกโดยไม่ผ่านเอเย่นต์ ค่า RTP จึงเป็นมาตรฐานยุติธรรมตามสเปกโรงงาน ไม่มีการปรับแต่งเปอร์เซ็นต์แพ้ชนะ ทั้งหมดรันบนเซิร์ฟเวอร์เสถียรสูงที่รองรับการเดิมพันได้ทุกระดับ",
  },
  {
    q: "คลังเกมมีค่ายอะไรบ้าง แล้วคัดเกมด้วยเกณฑ์อะไร",
    a: "กวาดเฉพาะเกมระดับ A-List จากค่ายยักษ์ใหญ่อย่าง PG Soft, Pragmatic Play และ Joker Gaming เข้าสู่ระบบ เกณฑ์การคัดคือโครงสร้างการจ่ายรางวัลต้องโปร่งใส โบนัสแตกง่าย และกราฟิกต้องประมวลผลคมชัด ลื่นไหลไม่มีสะดุด ทุกเบทที่กดสปินจึงอยู่บนระบบมาตรฐานสากลของจริง",
  },
  {
    q: "ถ้าเล่นเกมเดิมจนเบื่อ มีเกมใหม่เข้ามาให้เลือกต่อไหม",
    a: "ระบบขยายทางเลือกให้สายสล็อตอย่างต่อเนื่อง ทั้งเกมกระแสติดอันดับชาร์ตและเกมนอกกระแสอัตราคูณโหด พร้อมดึงสัญญาณเกมเข้าใหม่เข้ามาให้กดสปินทันที หน้าล็อบบี้ยังดันรายชื่อเกมใหม่และค่ายมาแรงขึ้นแถวหน้าทันทีที่เปิดตัว จึงไม่มีปัญหาคลังเกมตัน",
  },
  {
    q: "โปรโมชันมีอะไรบ้าง แล้วติดเงื่อนไขล็อกยูสหรือเปล่า",
    a: "โปรจัดมาเป็นชุด ทั้งโบนัสสมทบทุนฝากแรก สิทธิ์คืนยอดเสีย Cash Back รายวัน และเครดิตพิเศษเฉพาะช่วงเวลา ทุกโปรโมชันกำหนดเงื่อนไขโปร่งใส ถอนได้จริง ไม่ติดล็อคยูส จึงนำไปขยายรอบสปินเพื่อลุ้นรางวัลใหญ่ได้ยาวนานขึ้น",
  },
  {
    q: "ฝากถอนใช้เวลานานไหม ต้องแนบสลิปหรือรอแอดมินอนุมัติหรือเปล่า",
    a: "ระบบฝากถอนออโต้ไฮสปีดประมวลผลผ่าน Gateway ตรง ทำรายการเสร็จสิ้นในไม่กี่วินาที ยอดเงินอัปเดตเข้าคลังเกมทันทีโดยไม่ต้องแนบสลิปและไม่ต้องรอคิวอนุมัติจากแอดมิน ทุกจังหวะตั้งแต่เติมทุนจนถึงถอนกำไรเข้าบัญชีจึงลื่นไหลไร้รอยต่อ",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxPremium as="h1" title="DEED888 สล็อตเกมแท้ตัวท็อป จัดโปรฮิตมาเป็นชุด ฟีเจอร์ใหม่น่าลอง">
    <p class="text-left text-base leading-relaxed">
      DEED888 เชื่อมต่อสัญญาณ API ตรงจากสตูดิโอผู้พัฒนาสล็อตระดับโลก ชูจุดเด่นด้วยค่า RTP มาตรฐานยุติธรรมตามสเปกโรงงาน ไม่ผ่านเอเย่นต์ ไม่มีการปรับแต่งเปอร์เซ็นต์แพ้ชนะ
      รันบนเซิร์ฟเวอร์เสถียรสูงที่รองรับการเดิมพันทุกระดับ พร้อมไลน์อัปโปรโมชันสุดคุ้มและระบบทำรายการออโต้ที่ประมวลผลไวในไม่กี่วินาที
    </p>
  </ContentBoxPremium>

  <ContentBox3ThreePremium
    as="h2"
    title="DEED888 สล็อตเกมแท้ตัวท็อป คัดของเด่นจากค่ายดังมาไว้แบบไม่หลุดกระแส"
    titleleft="กวาดเกม A-List จากค่ายยักษ์ใหญ่"
    titlecenter="คัดกรองการจ่ายและกราฟิกทุกเกม"
    titleright="ทุกเบทอยู่บนมาตรฐานสากล">
    <p slot="left" class="text-left text-base leading-relaxed">
      DEED888 สล็อตเกมแท้ตัวท็อป กวาดเฉพาะเกมระดับ A-List จากค่ายยักษ์ใหญ่อย่าง PG Soft, Pragmatic Play และ Joker Gaming เข้าสู่ระบบ
    </p>
    <p slot="center" class="text-left text-base leading-relaxed">คัดกรองตัวเกมที่มีโครงสร้างการจ่ายรางวัลโปร่งใส โบนัสแตกง่าย และกราฟิกประมวลผลคมชัด ลื่นไหลไม่มีสะดุด</p>
    <p slot="right" class="text-left text-base leading-relaxed">มั่นใจได้ว่าทุกเบทที่กดสปินคือการลุยบนระบบมาตรฐานสากลของจริง</p>
  </ContentBox3ThreePremium>

  <ProviderGridPremium />

