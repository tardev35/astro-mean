---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBox3ThreeNeumorphism from "../components/ContentBox3ThreeNeumorphism.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import LatestWinnersPremium from "../components/LatestWinnersPremium.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Faq2 from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide2.png";
import imgRankingTiers from "../assets/slide1.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxPremium as="h1" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   2 → ContentBoxTwoPremium as="h2" (ย่อหน้าเดียวแบ่งลง left/right ตามลำดับประโยค
//       เดิม ไม่ตัดและไม่ย่อ)
//   3 → ContentBox3ThreePremium as="h2" (ย่อหน้าเดียวแบ่งลงสามคอลัมน์ตามจังหวะ
//       ประโยค: ยกทัพค่ายยักษ์ใหญ่ → ครบทุกสไตล์ทั้ง 3D และสตรีตสไตล์ → กระเป๋า
//       เดียวสลับได้อิสระ) แล้วต่อด้วย ProviderGridPremium ซึ่งกางรายชื่อค่ายที่
//       ย่อหน้าเดียวกันพูดถึง
//   4 → ContentBoxSevenThreePremium as="h2" + slide2 (แบนเนอร์คืนยอดเสีย 12%
//       ซึ่งเป็นภาพของสิทธิ์ Cash Back ที่ย่อหน้านี้พูดถึงตรงๆ) แล้วต่อด้วย
//       LatestWinnersPremium ซึ่งเป็นหลักฐานของประโยค "กดรับเองได้ทันที"
//   5 → ContentBoxSevenThreeNeumorphism as="h2" + slide1 (แบนเนอร์ระบบ RANKING
//       ลำดับขั้น ยิ่งฝากยิ่งอัพเวส ตรงกับหัวข้อเรื่องเกมตัวเด่นที่มีทรงโบนัสแตกดี
//       แบบมีทิศทาง ไม่ใช่หมุนไปเรื่อยๆ) แล้วต่อด้วย GameRankingBoard และ
//       SmoothCarousel ซึ่งกางเกมตัวเด่นให้เห็นในหน้าเดียว
//   6 → ContentBox3ThreeNeumorphism as="h2" (ย่อหน้าเดียวแบ่งลงสามคอลัมน์ตามชื่อ
//       ฟีเจอร์: Multipliers → Cascading กับ Wild ขยาย → Buy Feature)
//   7 → ContentBoxTwoNeumorphism as="h2" (ย่อหน้าเดียวแบ่งลงสองคอลัมน์: ฝั่งฝาก →
//       ฝั่งถอน)
//
// variant รอบนี้หมุนทั้งตระกูลจากรอบก่อน: ทรง ContentBox ย้ายจากชุด CyberCut นำ มา
// เป็นชุด Premium นำแล้วต่อด้วย Neumorphism ส่วน Navbar เป็น NavbarPremium, Footer
// เป็น FooterPremium, Announcement เป็น AnnouncementPremium, LatestWinners เป็น
// LatestWinnersPremium, ProviderGrid เป็น ProviderGridPremium และ Faq เป็น Faq2
//
// ContentBoxSevenThreePremium ปล่อยหัวข้อจาก `titleright ?? title` ตัวเดียว จึงส่ง
// แค่ `title` เข้าไป (ไม่ส่ง titleright) ไม่งั้นหัวข้อ docx จะถูกป้ายคอลัมน์แทนที่
//
// Announcement ส่ง message ตรงๆ เสมอ เพราะ default ของทุก variant ในตระกูลนี้เป็น
// สโลแกนของแบรนด์เก่าคนละเจ้ากัน ข้อความชุดนี้ตรงกับ default ของ AnnouncementPremium
// เป๊ะ เพื่อให้ ticker ของหน้าย่อยที่เรียก <Announcement /> เปล่าๆ วิ่งข้อความเดียว
// กับหน้าแรก และห้ามขึ้นต้นด้วย emoji เพราะ marquee render ข้อความซ้ำและ emoji ที่
// ฝังในสตริงถูก mark aria-hidden ไม่ได้
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook คู่กับ slide1/slide2 ซึ่งเป็นสไลด์
// ของแบรนด์นี้จริงทั้งสองใบ — slide3/slide4 กับ banner ทุกหมายเลขเป็นอาร์ตของแบรนด์
// ก่อนที่มีชื่อและโดเมนของเขาพิมพ์อยู่บนรูป ห้าม import ที่นี่หรือที่ไหนก็ตาม เพราะ
// รูปที่ import คือรูปที่ถูก emit ถึงจะไม่มีใคร render ก็ตาม ส่วน banner1 เป็นของ
// MainLayout จัดการเอง
//
// widget ที่ไม่ได้มาจาก docx (LoginRtpSection, ReviewCardSumo2, แถวปุ่ม
// login/register, FAQ, Navfoot) ใช้ป้ายเป็น <p>/<span> + aria-label บน <section>
// และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้ายทั้งชุด ยกเว้นสี่ตัวที่เป็นภาพประกอบของ
// หัวข้อ docx หนึ่งข้อโดยตรง (ProviderGridPremium → ข้อ 3, LatestWinnersPremium →
// ข้อ 4, GameRankingBoard กับ SmoothCarousel → ข้อ 5) ซึ่งวางต่อท้ายบล็อกนั้นๆ
//
// h1 ×1 + h2 ×6 = หัวข้อ docx พอดี ไม่มีตัวที่แปด — หัว FAQ เป็น <p> ใน Faq2.astro
// คำถามใน Faq2 เป็น <span> ใน <summary> และป้ายคอลัมน์ของทุก ContentBox variant
// เป็น <p> — docx รอบนี้แบน H1 + H2 ล้วน หน้านี้จึงไม่มี h3 เลย
//
// title ใช้บรรทัด Title ของ docx ตรงๆ ส่วน description ใช้บรรทัด Des ตรงๆ ทั้งสองค่า
// เป็นสตริงเดียวกับที่ส่งเข้า pageGraph ตรงกับที่ส่งให้ MainLayout และตรงกับ default
// ที่ MainLayout ตั้งไว้เป๊ะ
const pageTitle = "TITANWIN168 | สล็อตรวมทัพเกมดัง เกมคัดเกรด ระบบออโต้ทันใจไว 3 วิ";
const pageDescription =
  "TITANWIN168 เว็บตรง API แท้ สล็อตรวมทัพเกมดัง เกมคัดเกรดจากค่ายชั้นนำแน่น โปรโมชั่นใหม่พร้อมชนทุกเวลา โบนัสแตกดีมีทรงให้ลุ้น ฟีเจอร์ครบ พร้อมออโต้ทันใจไว 3 วิ";

const announcementMessage =
  "TITANWIN168 สล็อตรวมทัพเกมดัง เกมคัดเกรด ระบบออโต้ทันใจไว 3 วิ • เว็บตรง API แท้ ยิงสัญญาณตรงจากเซิร์ฟเวอร์หลัก ไม่ผ่านเอเย่นต์ คัดสรรเกมสล็อตแตกง่าย อัตราจ่าย RTP ยุติธรรมตรงตามสเปกโรงงาน ไร้ประวัติการล็อกยูส ถอนเงินออกได้เต็มจำนวนทุกยอด • รวบรวมคลังเกมคัดเกรดคุณภาพสูงไว้ครบครัน ไม่เอาเกมระบบล้าหลังหรืออัตราจ่ายต่ำมาเปิดให้บริการ ทุกเกมสปินสนุก กราฟิกคมชัด จ่ายรางวัลตามอัลกอริทึมมาตรฐานสากล • ยกทัพค่ายเกมยักษ์ใหญ่ระดับโลกมาประชันแบบจัดเต็ม ทั้ง PG Soft Pragmatic Play Joker Gaming และค่ายชั้นนำอีกมากมาย ครบทุกสไตล์ทั้งสล็อตภาพสวย 3D และสตรีตสไตล์เน้นคูณหนัก สลับเล่นอิสระกระเป๋าเดียวไม่ต้องโยกเงิน • อัปเดตโปรโมชั่นใหม่พร้อมชนทุกช่วงเวลา ทั้งโบนัสต้อนรับสมาชิกใหม่ โปรฝากแรกของวัน และสิทธิ์รับเครดิตคืนยอดเสีย Cash Back เงื่อนไขโปร่งใส ไม่ติดเทิร์นโอเวอร์มหาโหด กดรับเองได้ทันที • คัดเฉพาะเกมตัวเด่นที่มีทรงโบนัสแตกดี จังหวะเข้ารอบฟรีสปินไว โครงสร้างการแจกรางวัลน่าสนใจ ให้ลุ้นกำไรก้อนโตแบบมีทิศทาง • ฟีเจอร์ครบมือทั้ง Multipliers ตัวคูณสะสมทวีคูณ ระบบ Cascading สัญลักษณ์แตกต่อเนื่อง รีลขยาย Wild ซ้อนทับ และโหมด Buy Feature ซื้อฟรีสปิน • ระบบการเงินฝากถอนออโต้ทันใจไว 3 วิ ประมวลผลผ่าน Gateway ตรง ฝากเงินปุ๊บยอดเข้าเกมปั๊บ ไม่ต้องส่งสลิป ไม่ต้องรอคิวอนุมัติ ถอนกำไรเด้งเข้าบัญชีธนาคารหรือวอลเล็ททันที";

// FAQ ห้าข้อเขียนขึ้นใหม่จากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้า
// ไหนมาทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบ
// คำถามที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq2> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน
const faqs = [
  {
    q: "TITANWIN168 เป็นเว็บตรงจริงไหม แล้วอัตราจ่าย RTP เชื่อถือได้แค่ไหน",
    a: "เป็นเว็บตรง API แท้ที่ยิงสัญญาณตรงจากเซิร์ฟเวอร์หลัก ไม่ผ่านเอเย่นต์คนกลาง อัตราจ่าย RTP จึงยุติธรรมตรงตามสเปกโรงงานของค่ายผู้พัฒนา ไม่มีการดัดแปลงค่าใดๆ ทุกเกมในคลังผ่านการคัดกรองระบบหลังบ้านมาแล้วว่าจ่ายรางวัลตามอัลกอริทึมมาตรฐานสากล และไม่มีประวัติการล็อกยูส ถอนเงินออกได้เต็มจำนวนทุกยอดโดยไม่มีเงื่อนไขยุ่งยาก",
  },
  {
    q: "ในคลังมีค่ายเกมอะไรบ้าง แล้วต้องโยกเงินข้ามค่ายหรือเปล่า",
    a: "รวมตัวเด่นจากค่ายยักษ์ใหญ่ระดับโลกไว้ครบ ทั้ง PG Soft, Pragmatic Play, Joker Gaming และค่ายชั้นนำอีกมากมาย เลือกได้ครบทุกสไตล์ ทั้งสล็อตสายภาพสวย 3D และสล็อตสตรีตสไตล์ที่เน้นคูณหนัก จุดสำคัญคือใช้กระเป๋าเดียวจบ อยากสลับไปปั่นค่ายไหนก็กดเปลี่ยนได้อิสระทันที ไม่ต้องโยกเงินไปมาให้เสียจังหวะ",
  },
  {
    q: "โปรโมชั่นมีอะไรให้เก็บบ้าง ต้องทักแอดมินก่อนไหม แล้วติดเทิร์นโอเวอร์หนักหรือเปล่า",
    a: "สิทธิ์หลักที่อัปเดตพร้อมชนทุกช่วงเวลามีทั้งโบนัสต้อนรับสมาชิกใหม่ โปรฝากแรกของวัน และสิทธิ์รับเครดิตคืนยอดเสีย Cash Back ที่เอาไปเพิ่มทุนสปินต่อได้ยาวขึ้น ทุกรายการกดรับเองได้ทันทีจากหน้าโปรโมชั่นโดยไม่ต้องรอแอดมินกดให้ เงื่อนไขเขียนไว้โปร่งใสและไม่ติดเทิร์นโอเวอร์มหาโหด",
  },
  {
    q: "อยากได้เกมที่โบนัสแตกดี ควรดูจากอะไร แล้วในเกมมีฟีเจอร์อะไรให้ลองบ้าง",
    a: "ดูที่ทรงโบนัสกับจังหวะเข้ารอบฟรีสปินเป็นหลัก เพราะเกมที่คัดมาเน้นตัวที่เข้ารอบฟรีสปินไวและมีโครงสร้างการแจกรางวัลชัดเจน ให้ลุ้นกำไรแบบมีทิศทางแทนการหมุนวงล้อไปเรื่อยๆ ส่วนลูกเล่นในตัวเกมมีให้ลองครบมือ ทั้ง Multipliers ตัวคูณสะสมแบบทวีคูณ ระบบ Cascading สัญลักษณ์แตกต่อเนื่อง รีลขยาย Wild ซ้อนทับ และโหมด Buy Feature สำหรับคนที่อยากซื้อฟรีสปินเข้าลุ้นโบนัสก้อนใหญ่ทันที",
  },
  {
    q: "ฝากถอนใช้เวลานานแค่ไหน ต้องส่งสลิปหรือรอคิวอนุมัติไหม",
    a: "ระบบการเงินเป็นออโต้ทันใจไว 3 วิ ประมวลผลผ่าน Gateway ตรง ฝากเงินปุ๊บยอดเข้าเกมปั๊บ พอปั่นได้กำไรก็กดถอนแล้วเด้งเข้าบัญชีธนาคารหรือวอลเล็ททันที ไม่ต้องส่งสลิปให้แอดมินยืนยัน ไม่ต้องรอคิวอนุมัติ และไม่มีขั้นตอนคั่นกลางให้เสียจังหวะการเล่น",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxPremium as="h1" title="TITANWIN168 สล็อตรวมทัพเกมดัง เกมคัดเกรด ระบบออโต้ทันใจไว 3 วิ">
    <p class="text-left text-base leading-relaxed">
      TITANWIN168 เว็บตรง API แท้ ยิงสัญญาณตรงจากเซิร์ฟเวอร์หลัก ไม่ผ่านเอเย่นต์ คัดสรรเกมสล็อตแตกง่าย อัตราจ่าย RTP ยุติธรรมตรงตามสเปกโรงงาน ชูจุดเด่นด้วยระบบฝากถอนออโต้ทันใจไว 3 วิ ปั่นง่าย
      ไร้ประวัติการล็อกยูส ถอนเงินออกได้เต็มจำนวนทุกยอดโดยไม่มีเงื่อนไขยุ่งยาก
    </p>
  </ContentBoxPremium>

  <ContentBoxTwoPremium as="h2" title="TITANWIN168 สล็อตรวมทัพเกมดัง เปิดคลังเกมคัดเกรดจากค่ายชั้นนำ" titleleft="คัดเกรดก่อนเปิดให้บริการ" titleright="สปินสนุก จ่ายตามมาตรฐานสากล">
    <p slot="left" class="text-left text-base leading-relaxed">TITANWIN168 สล็อตรวมทัพเกมดัง รวบรวมคลังเกมคัดเกรดคุณภาพสูงไว้อย่างครบครัน ไม่เอาเกมระบบล้าหลังหรืออัตราจ่ายต่ำมาเปิดให้บริการ</p>
    <p slot="right" class="text-left text-base leading-relaxed">
      ทุกเกมผ่านการคัดกรองระบบหลังบ้านมาแล้วว่าสปินสนุก กราฟิกคมชัด และจ่ายรางวัลตามอัลกอริทึมมาตรฐานสากล ให้คุณลุยทำกำไรได้ด้วยความมั่นใจทุกครั้งที่กดเข้าเล่น
    </p>
  </ContentBoxTwoPremium>

  <ContentBox3ThreePremium
    as="h2"
    title="ค่ายชั้นนำยกตัวไหนมาชน? TITANWIN168 คัดเกมเด่นไว้ให้เลือกหลายแนว"
    titleleft="ค่ายยักษ์ใหญ่ระดับโลกมาประชัน"
    titlecenter="ครบทุกสไตล์ทั้ง 3D และสตรีตสไตล์"
