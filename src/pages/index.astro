---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners from "../components/LatestWinners2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Faq from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide2.png";
import imgDepositBonus from "../assets/slide1.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxPremium as="h1" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   2 → ContentBox3ThreePremium as="h2" (ย่อหน้าเดียวแบ่งลงสามคอลัมน์ตามลำดับประโยค
//       เดิม: ดีไซน์เว็บและคลังเกมเข้าถึงง่าย → รองรับทั้งสายงบน้อย สายเบทใหญ่ และ
//       สายตามล่าแจ็คพอต → จ่ายแฟร์ลุ้นแตกตั้งแต่สปินแรก)
//   3 → ContentBoxTwoCyberCut as="h2" (ย่อหน้าเดียวแบ่งสองครึ่งตามลำดับประโยคเดิม:
//       รวมค่ายใหญ่ระดับโลกครบหมด → สลับแนวได้ทันทีผ่านกระเป๋าเดียว) แล้วต่อด้วย
//       ProviderGrid ซึ่งกางโลโก้ค่ายที่ย่อหน้าเดียวกันระบุไว้ตรงๆ สามค่ายพอดี
//       (PG Soft / Pragmatic Play / Joker Gaming)
//   4 → ContentBoxSpecial as="h2" (ย่อหน้าเดียวแบ่งสองครึ่งตามลำดับประโยคเดิม)
//   5 → ContentBox as="h2" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว) แล้วต่อด้วย
//       FeatureHighlights ซึ่งกางสี่ฟีเจอร์ที่ย่อหน้าเดียวกันเอ่ยชื่อไว้ตรงๆ
//       (Multipliers / Expanding Wild / Cascading / Bonus Buy) → h3 สี่ตัว ซึ่งเป็น
//       h3 ชุดเดียวที่ได้รับอนุญาตบนหน้านี้ คำอธิบายเขียนขยายความใหม่ ไม่ได้ก๊อบ
//       ประโยคด้านบนซ้ำ
//   6 → ContentBoxSevenThreePremium as="h2" + slide2 (อาร์ต "คืนยอดเสีย 5% ทุกวัน
//       สูงสุด 50,000 บาท" ตรงกับสิทธิ์คืนยอดเสีย Cash Back ทุกวันในย่อหน้าเดียวกัน)
//   7 → ContentBoxSevenThreeNeumorphism as="h2" + slide1 (อาร์ตโบนัสฝากต่อเนื่อง
//       ประจำเดือน คู่กับหัวข้อระบบฝากถอนออโต้ที่จบใน 3 วินาที)
//
// variant รอบนี้หมุนออกจากชุดของแบรนด์ก่อนทั้งตระกูล: ทรง ContentBox เปลี่ยนจาก
// CyberCut + TwoPremium + 3ThreeCyberCut + SevenThree + SevenThreeCyberCut +
// Neumorphism + TwoNeumorphism มาเป็น Premium + 3ThreePremium + TwoCyberCut +
// Special + ContentBox ตัวฐาน + SevenThreePremium + SevenThreeNeumorphism
// ส่วน Announcement เป็น Announcement3, LatestWinners เป็น LatestWinners2,
// กริดค่ายเกมเป็น ProviderGrid ตัวฐาน และ Faq เป็น Faq3 — Navbar/Footer/ฟอนต์ ถูก
// สลับไว้แล้วใน MainLayout กับ brandProfile
// การ์ดรีวิวคง ReviewCardSumo2 ไว้ เพราะ ReviewCardSumo ตัวพี่เป็นไฟล์ที่ยังไม่ผ่าน
// การกวาดเรื่องระดับหัวข้อ/aria ที่ repo แก้ไปแล้ว การหมุนไปใช้จะเป็นการรื้องานเดิม
// กลับมา GameRankingBoard เป็นสมาชิกตัวเดียวของตระกูลตัวเอง จึงถูกใช้ซ้ำโดยไม่มี
// ตัวหมุน
//
// ContentBoxSevenThree* ปล่อยหัวข้อผ่าน `title` ตัวเดียว ส่วน titleleft เป็นป้าย
// คอลัมน์รูปที่เป็น <p> — ห้ามส่ง titleright เพิ่ม เพราะจะได้ป้ายเกินมาโดยไม่มี
// ต้นทางใน docx
//
// Announcement ส่ง message ตรงๆ เสมอ เพราะ default ของทุก variant ในตระกูลนี้เป็น
// สโลแกนของแบรนด์เก่าคนละเจ้ากัน ข้อความชุดนี้ตรงตัวต่อตัวกับ default ของ
// Announcement3.astro เพื่อให้ ticker ของหน้าย่อยที่เรียก <Announcement /> เปล่าๆ
// วิ่งข้อความเดียวกับหน้าแรก และห้ามขึ้นต้นด้วย emoji เพราะ marquee render ข้อความ
// ซ้ำและ emoji ที่ฝังในสตริงถูก mark aria-hidden ไม่ได้
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook คู่กับ slide2/slide1 ซึ่งเป็นสไลด์ที่
// อาร์ตตรงกับหัวข้อ docx ข้อ 6 กับข้อ 7 — slide3 (โปรวันเกิด) กับ slide4 (เซียนกัน
// เซียน) ถูกปล่อยไม่ใช้ที่นี่โดยตั้งใจ เพราะเพดาน SevenThree เต็มแล้ว และทั้งคู่ไป
// โผล่ในกริดของหน้า /promotion แทน ส่วนไฟล์ banner ทุกตัว (ทั้งตัวที่มีเลขต่อท้าย
// และตัวมือถือ) ห้าม import ที่นี่ เพราะรูปที่ import คือรูปที่ถูก emit ลง dist/
// ถึงจะไม่มีใคร render ก็ตาม — banner1 เป็นของ MainLayout จัดการเอง และรูปในหน้านี้
// ไม่มีตัวไหนใส่ loading="eager"/fetchpriority="high" เพราะ LCP เป็นของ hero ใน
// MainLayout
//
// widget ที่ไม่ได้มาจาก docx (GameRankingBoard, LatestWinners, LoginRtpSection,
// ReviewCardSumo2, แถวปุ่ม login/register, Faq, Navfoot) ใช้ป้ายเป็น <p>/<span> +
// aria-label บน <section> และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้ายทั้งชุด ยกเว้นสองตัว
// ที่เป็นภาพประกอบของหัวข้อ docx หนึ่งข้อโดยตรง (ProviderGrid → ข้อ 3,
// FeatureHighlights → ข้อ 5) ซึ่งวางต่อท้ายบล็อกนั้นๆ
//
// h1 ×1 + h2 ×6 = หัวข้อ docx พอดี บวก h3 ×4 จาก FeatureHighlights ซึ่งเป็นรายการ
// ย่อยของหัวข้อข้อ 5 ตามข้อยกเว้นเดียวที่ playbook อนุญาต — หัว FAQ เป็น <p> ใน
// Faq3.astro คำถามเป็น <span> ใน <summary> ชื่อกริดค่ายใน ProviderGrid.astro เป็น
// <p> และป้ายคอลัมน์ของทุก ContentBox variant เป็น <p>
//
// title กับ description ใช้บรรทัดที่ brief ให้มาตรงๆ ทั้งคู่ ห้ามเติมหรือตัด และเป็น
// สตริงเดียวกับที่ส่งเข้า pageGraph และ MainLayout
const pageTitle = "9KPLUS | สล็อตพลัสความมันส์ ระบบลั่น ตัวเด็ดหลายฟีล โปรใหม่ไฟแรง";
const pageDescription = "9KPLUS สล็อตพลัสความมันส์ เกมไหนมีฟีลจัดมาให้ครบ ตัวเด็ดพร้อมชน ของใหม่พร้อมแจม ฟีเจอร์มีลูกเล่น โปรใหม่ไฟแรง ระบบลั่นพร้อมออโต้ไปต่อได้คล่อง";

const announcementMessage =
  "9KPLUS สล็อตพลัสความมันส์ ระบบลั่น ตัวเด็ดหลายฟีล โปรใหม่ไฟแรง • สล็อตเว็บตรง API แท้ ยิงตรงจากเซิร์ฟนอก ลื่นไหลทุกการสปิน ปรับระบบมาแบบตรงสเปกโรงงาน ค่า RTP ยุติธรรม ไม่ล็อกยูส ไม่ปรับเปอร์เซ็นต์ชนะ ฝากถอนออโต้ไฮสปีดทำรายการไวใน 3 วินาที บวกเท่าไหร่ก็ถอนได้เต็มทุกบาท • ดีไซน์หน้าเว็บและคลังเกมให้เข้าถึงง่าย ขนเกมสล็อตหลากหลายรูปแบบมาจัดวางให้อย่างลงตัว สายปั่นงบน้อยเน้นปั้นทุน สายลุยเบทใหญ่ หรือสายตามล่าแจ็คพอต ระบบพร้อมรองรับทุกสไตล์การเล่น จัดจังหวะการจ่ายเงินที่แฟร์ๆ ให้ลุ้นโบนัสแตกได้ตั้งแต่วินาทีแรกที่เริ่มสปิน • รวมค่ายใหญ่ระดับโลกไว้ครบหมดทั้ง PG Soft, Pragmatic Play และ Joker Gaming จัดเต็มเกมตัวเด็ดกระแสแรงมาให้เลือกเล่นแบบไม่ขาดสาย สลับจากสล็อตแนวเทพเจ้าไปสายกินหรือสายแอ็กชันได้ทันทีผ่านกระเป๋าเดียว ไม่ต้องเสียเวลาโยกเงินข้ามค่ายให้สะดุด • อัปเดตคลังเกมใหม่เข้ามาเติมระบบอย่างต่อเนื่องทันทีที่ค่ายผู้พัฒนาปล่อยตัวเกมสดใหม่ออกมา สมาชิกได้ลองเล่นฟีเจอร์ใหม่ก่อนใคร ได้เช็กจังหวะแจกโบนัสก่อนใคร ปั่นได้ยาวๆ ไม่มีคำว่าตกเทรนด์ • ฟีเจอร์ยุคใหม่มาครบ ทั้งระบบสุ่มแจกตัวคูณทวีคูณ Multipliers สัญลักษณ์ Expanding Wild ยืดเต็มรีล คอมโบแตกต่อเนื่องแบบ Cascading และโหมด Bonus Buy ให้กดซื้อฟรีสปินเข้าไปลุ้นรอบแจ็คพอตใหญ่ได้ทันที • โปรใหม่ไฟแรงปล่อยออกมาต่อเนื่อง ทั้งโบนัสต้อนรับสมาชิกใหม่ โปรเติมเงินฝากแรกของวัน และสิทธิ์คืนยอดเสีย Cash Back ทุกวัน กดรับเองได้เลยผ่านหน้าเว็บ เงื่อนไขชัดเจน ถอนกำไรได้จริง ไม่ติดเทิร์นโอเวอร์มหาโหด • รันทุกธุรกรรมด้วยระบบออโต้ไฮสปีด ไม่ต้องแนบสลิป ไม่ต้องคอยแอดมินอนุมัติ ทำรายการฝากถอนเงินเสร็จใน 3 วินาทีผ่าน Gateway ตรง ยอดเงินอัปเดตเข้าคลังเกมและบัญชีธนาคารฉับไว";

// FAQ ห้าข้อเขียนขึ้นใหม่จากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้า
// ไหนมาทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบ
// คำถามที่สายปั่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน — ห้ามปล่อยให้
// Faq ใช้ค่า default ของตัวเอง เพราะ default เป็นลิสต์ว่างโดยตั้งใจ
const faqs = [
  {
    q: "9KPLUS เป็นเว็บตรงจริงไหม แล้วค่า RTP ถูกปรับหรือเปล่า",
    a: "เป็นสล็อตเว็บตรงที่เชื่อมต่อ API แท้ ยิงตรงจากเซิร์ฟนอก ปรับระบบมาแบบตรงสเปกโรงงานผู้พัฒนา ค่า RTP จึงยุติธรรมตามที่ค่ายตั้งไว้จริง ไม่ล็อกยูสและไม่ปรับเปอร์เซ็นต์ชนะระหว่างทาง บวกเท่าไหร่ก็ถอนได้เต็มทุกบาท ทุกการสปินลื่นไหลตั้งแต่กดหมุนรอบแรก",
  },
  {
    q: "เล่นงบน้อยกับเล่นเบทใหญ่ ใช้ล็อบบี้เดียวกันได้ไหม",
    a: "ได้ทั้งหมด เพราะดีไซน์หน้าเว็บและคลังเกมถูกจัดวางให้เข้าถึงง่าย ขนเกมสล็อตหลากหลายรูปแบบมาเรียงไว้อย่างลงตัว ไม่ว่าจะเป็นสายปั่นงบน้อยเน้นปั้นทุน สายลุยเบทใหญ่ หรือสายตามล่าแจ็คพอต ระบบก็รองรับทุกสไตล์การเล่น และจัดจังหวะการจ่ายเงินแบบแฟร์ๆ ให้ลุ้นโบนัสแตกได้ตั้งแต่วินาทีแรก",
  },
  {
    q: "มีค่ายเกมอะไรบ้าง แล้วสลับข้ามค่ายต้องโยกเงินไหม",
    a: "รวมค่ายใหญ่ระดับโลกไว้ครบหมดทั้ง PG Soft, Pragmatic Play และ Joker Gaming พร้อมเกมตัวเด็ดกระแสแรงให้เลือกเล่นแบบไม่ขาดสาย อยากเปลี่ยนอารมณ์จากสล็อตแนวเทพเจ้าไปลองแนวสายกินหรือแนวแอ็กชัน ก็สลับเล่นได้ทันทีผ่านกระเป๋าเดียว ไม่ต้องเสียเวลาโยกเงินข้ามค่ายให้สะดุด",
  },
  {
    q: "ฟีเจอร์ในเกมมีอะไรให้ลุ้น แล้วมีเกมใหม่เข้ามาบ่อยแค่ไหน",
    a: "ฟีเจอร์ยุคใหม่มาครบ ทั้งระบบสุ่มแจกตัวคูณทวีคูณ Multipliers สัญลักษณ์ Expanding Wild ที่ยืดเต็มรีล คอมโบแตกต่อเนื่องแบบ Cascading และโหมด Bonus Buy ที่กดซื้อฟรีสปินเข้าไปลุ้นรอบแจ็คพอตใหญ่ได้ทันที ส่วนคลังเกมก็อัปเดตของใหม่เข้ามาเติมต่อเนื่องทันทีที่ค่ายผู้พัฒนาปล่อยตัวเกมออกมา",
  },
  {
    q: "ฝากถอนนานไหม ต้องแนบสลิปให้แอดมินหรือเปล่า",
    a: "ไม่ต้องแนบสลิปและไม่ต้องคอยแอดมินอนุมัติ ทุกธุรกรรมรันด้วยระบบออโต้ไฮสปีดผ่าน Gateway ตรง ทำรายการฝากถอนเสร็จภายใน 3 วินาที ยอดเงินอัปเดตเข้าคลังเกมและบัญชีธนาคารฉับไว ส่วนโปรใหม่ไฟแรงทั้งโบนัสต้อนรับ ฝากแรกของวัน และคืนยอดเสีย Cash Back ทุกวัน ก็กดรับเองได้เลยผ่านหน้าเว็บ",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxPremium as="h1" title="9KPLUS สล็อตพลัสความมันส์ ระบบลั่น ตัวเด็ดหลายฟีล โปรใหม่ไฟแรง">
    <p class="text-left text-base leading-relaxed text-[#ffe3ee]">
      9KPLUS สล็อตเว็บตรง API แท้ ยิงตรงจากเซิร์ฟนอก ลื่นไหลทุกการสปิน ปรับระบบมาแบบตรงสเปกโรงงาน ค่า RTP ยุติธรรม ไม่ล็อกยูส ไม่ปรับเปอร์เซ็นต์ชนะ มาพร้อมระบบฝากถอนออโต้ระดับไฮสปีด ทำรายการไวใน 3
