---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBox3Three from "../components/ContentBox3Three.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGridPremium.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgLicence from "../assets/slide3.png";
import imgGames from "../assets/slide2.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxPremium as="h1"
//   2 → ContentBoxTwo (ส่ง title อย่างเดียว แล้วแบ่งย่อหน้าเดียวลง left/right
//       ที่รอยต่อประโยค — titleleft/titleright เป็น <p> ของ chrome ห้ามใช้)
//   3 → ContentBoxSevenThreePremium + slide3 (เว็บตรง ลิขสิทธิ์แท้ มีใบรับรอง)
//   4 → ContentBox3Three (ส่ง title อย่างเดียว แบ่งย่อหน้าลง left/center/right)
//   5 → ContentBoxSpecial (แบ่งย่อหน้าลง left/right)
//   6 → ContentBoxSevenThreeCyberCut + slide2 (รองรับเกมมากมาย แตกง่าย)
//   7 → ContentBox as="h2"
//
// SevenThree ใช้ 2 บล็อกเท่านั้น (โควตาเต็ม) และแต่ละตัวส่งหัวข้อเดียว
// (title ของ Premium ซึ่ง map ไปคอลัมน์ขวา / titleright ของ CyberCut)
// ถ้าส่งทั้งซ้ายและขวาจะได้ h2 เกินจำนวนหัวข้อ docx
//
// docx ของแบรนด์นี้แบนราบ (H1 + H2 ล้วน ไม่มี H3) — ContentBox3Three เดิม
// render titleleft/titlecenter/titleright เป็น <h3>/<h2> คอลัมน์ละตัว จึงถูก
// ลดเป็น <p> แล้วเพิ่ม prop `title` ตัวเดียวไว้รับหัวข้อ docx แทน
// เช่นเดียวกับ ContentBoxTwo ที่เพิ่ม `title` เป็นหัวข้อเดียวของบล็อก
//
// slide1/slide4 อยู่ใน SmoothCarousel อย่างเดียว, slide3/slide2 อยู่ใน
// SevenThree อย่างละบล็อก — รูปหนึ่งใบมีบ้านเดียว ไม่ซ้ำกันในหน้าเดียว
// banner2/3/4 เป็นอาร์ตของแบรนด์ก่อนหน้า จึงไม่ถูก import ที่ไหนในหน้านี้
//
// widget ที่ไม่ได้มาจาก docx (ProviderGrid, GameRankingBoard, SmoothCarousel,
// LoginRtpSection, LatestWinners, ReviewCardSumo2, แถวปุ่ม login/register)
// ใช้หัวข้อเป็น <p>/<span> + aria-label บน <section> จึงวางต่อท้ายหัวข้อ docx
// ที่มันสังกัดได้โดยลำดับ H2 ไม่เพี้ยน
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx + หัวข้อ FAQ ที่หน้านี้เขียนเอง = 7
// คำถามใน Faq4 เป็น <span> ตามระดับเดิมที่ variant นั้น ship มา ไม่ใช่ <h3>

const pageTitle = "JUDTEM168 ทางเข้าเว็บสล็อตอันดับ 1 ระบบฝากถอนออโต้ ปลอดภัย";

// Meta description ยาว 154 ตัวอักษร — verify-build บังคับช่วง 150–160 ตัวอักษร
const pageDescription =
  "JUDTEM168 อัปเดตทางเข้าเว็บสล็อตอันดับ 1 แตกง่าย จ่ายจริง สนุกไร้ขีดจำกัดกับระบบฝากถอนออโต้ ไม่มีขั้นต่ำ ปลอดภัย มั่นคง 100% ถอนได้ไม่อั้น ไม่ล็อคยูสเซอร์";

// AnnouncementPremium มี default message ของตัวเอง แต่ default ของ Announcement
// ทุก variant คือสโลแกนของแบรนด์เก่าคนละเจ้ากัน จึงส่ง message ตรงๆ เสมอ
const announcementMessage =
  "JUDTEM168 ทางเข้าเว็บสล็อตอันดับ 1 แตกง่าย ฝากถอนออโต้ ปลอดภัย 100% • เซิร์ฟเวอร์หลักและลิงก์สำรองพร้อมใช้งานตลอด 24 ชั่วโมง เข้าเล่นลื่นไหลทั้ง iOS Android และคอมพิวเตอร์ ภาพและเสียงคมชัดระดับ Full HD • เกมสล็อตลิขสิทธิ์แท้นำเข้าตรงจากค่ายดัง อัตราการชนะสูงกว่าเว็บทั่วไป จ่ายเต็มจำนวนไม่หักค่าธรรมเนียม • ฝากถอนออโต้ด้วยระบบ AI ประมวลผลไม่เกิน 3 วินาที ทุนน้อยแค่ 1 บาทก็ปั่นได้ • ถอนได้ไม่อั้น ไม่จำกัดจำนวนครั้งต่อวัน การันตีเว็บตรง API แท้ 100% ไม่ล็อคยูสเซอร์";

const faqs = [
  {
    q: "ทางเข้าเล่นสล็อตออนไลน์ของ JUDTEM168 เสถียรแค่ไหน",
    a: "ปัญหาเว็บปลิว ลิงก์เสีย หรือเข้าเล่นไม่ได้ในช่วงเวลาโบนัสไทม์จะหมดไป เพราะทีมงานพัฒนาระบบเซิร์ฟเวอร์หลักและลิงก์สำรองให้พร้อมใช้งานตลอด 24 ชั่วโมง ไม่ว่าจะใช้มือถือระบบ iOS, Android หรือคอมพิวเตอร์ ก็กดเข้าเกมได้ลื่นไหล ไม่มีสะดุด ภาพและเสียงคมชัดระดับ Full HD",
  },
  {
    q: "เล่นได้ยอดใหญ่ JUDTEM168 จ่ายเงินจริงทุกยอดหรือไม่",
    a: "สิ่งที่ทำให้นักเดิมพันมืออาชีพไว้วางใจคือความโปร่งใสในเรื่องของการจ่ายเงิน เรานำเข้าเกมสล็อตลิขสิทธิ์แท้จากค่ายดังโดยตรง อัตราการชนะ (RTP) สูงกว่าเว็บทั่วไป เล่นได้หลักหมื่นหรือทะลุหลักล้านก็พร้อมโอนจ่ายเต็มจำนวน ไม่มีการหักเปอร์เซ็นต์หรือค่าธรรมเนียมใดๆ",
  },
  {
    q: "ระบบฝากถอนออโต้มีขั้นต่ำไหม ใช้เวลาทำรายการนานเท่าไร",
    a: "ลืมการส่งสลิปและรอคิวแอดมินไปได้เลย ระบบการเงินใช้เทคโนโลยี AI จัดการทั้งหมด คุณกดทำรายการฝากหรือถอนได้ด้วยตัวเอง ใช้เวลาประมวลผลไม่เกิน 3 วินาที และให้อิสระทางการเงินขั้นสุด ทุนน้อยแค่ 1 บาทก็ฝากเข้ามาปั่นสล็อตได้สบายๆ ไม่มีขั้นต่ำ",
  },
  {
    q: "JUDTEM168 มั่นคงพอให้ถอนเงินได้ไม่อั้นจริงหรือเปล่า",
    a: "ความกังวลเรื่องเว็บปิดหนีหรือถอนเงินไม่ออกจะไม่เกิดขึ้นที่นี่ เพราะเรามีฐานการเงินที่แข็งแกร่งและเงินทุนหมุนเวียนมหาศาล รองรับธุรกรรมของสมาชิกนับแสนคนต่อวัน กดถอนได้ไม่อั้น ไม่จำกัดจำนวนครั้งต่อวัน ระบบรักษาความปลอดภัยเทียบเท่าแอปพลิเคชันธนาคารชั้นนำ",
  },
  {
    q: "เข้าสู่ระบบอย่างไร และการันตีไม่ล็อคยูสเซอร์จริงไหม",
    a: "เพียงคลิกที่ปุ่มเข้าสู่ระบบหน้าเว็บไซต์ กรอกเบอร์โทรศัพท์และรหัสผ่านที่ตั้งไว้ ก็เข้าสู่หน้าล็อบบี้เกมได้ทันที ใครยังไม่มีบัญชีกดสมัครสมาชิกฟรีผ่านระบบออโต้ได้เลย และเราให้บริการแบบเว็บตรง API แท้ 100% ระบบสุ่มรางวัลยุติธรรม หมดปัญหาการล็อคยูสเซอร์",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxPremium as="h1" title="JUDTEM168 ทางเข้าเว็บสล็อตอันดับ 1 แตกง่าย ฝากถอนออโต้ ปลอดภัย 100%">
    <p class="text-left text-base leading-relaxed">
      หากคุณกำลังมองหาแหล่งทำเงินที่เชื่อถือได้และตอบโจทย์ทุกความต้องการของสายปั่นสล็อต ไม่ต้องไปหาที่ไหนไกล เพราะที่นี่คือศูนย์รวมเกมสล็อตแตกหนักที่ออกแบบมาเพื่อนักพนันตัวจริงโดยเฉพาะ
      เราแก้ปัญหาเว็บอืด ถอนช้า หรือเล่นแล้วโดนล็อคยูสทิ้งไปจนหมด สัมผัสความลื่นไหลของระบบที่ทันสมัยที่สุด พร้อมทำกำไรได้ทันทีตั้งแต่สปินแรก
    </p>
  </ContentBoxPremium>

  <ContentBoxTwo title="JUDTEM168 อัปเดตช่องทางเข้าเล่นสล็อตออนไลน์ที่เสถียรที่สุด">
    <p slot="left" class="text-left text-base leading-relaxed">
      ปัญหาเว็บปลิว ลิงก์เสีย หรือเข้าเล่นไม่ได้ในช่วงเวลาโบนัสไทม์จะหมดไป ทีมงานของเราได้พัฒนาระบบเซิร์ฟเวอร์หลักและลิงก์สำรองให้พร้อมใช้งานตลอด 24 ชั่วโมง
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      ไม่ว่าคุณจะใช้มือถือระบบ iOS, Android หรือคอมพิวเตอร์ ก็สามารถกดเข้าเกมได้ลื่นไหล ไม่มีสะดุด ภาพและเสียงคมชัดระดับ Full HD ให้คุณไม่พลาดทุกจังหวะการทำแจ็คพอตแตก
    </p>
  </ContentBoxTwo>

  <SmoothCarousel />

  <ContentBoxSevenThreePremium title="สัมผัสประสบการณ์เดิมพันกับเว็บสล็อตอันดับ 1 ที่จ่ายเงินจริงทุกยอด">
    <Picture
      slot="left"
      src={imgLicence}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์ JUDTEM168 เว็บตรง ลิขสิทธิ์แท้ มีใบรับรอง ครองใจนักเดิมพัน พร้อมภาพอัศวินชุดเกราะชูถ้วยรางวัลทองคำ มาสคอตสุนัขสีทองสวมป้าย JT และแถบการันตีเว็บลิขสิทธิ์แท้ ปลอดภัย 100%"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e4a434]/35 shadow-[0_10px_30px_rgba(250,196,44,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      สิ่งที่ทำให้นักเดิมพันมืออาชีพไว้วางใจเลือกเล่นกับ JUDTEM168 คือความโปร่งใสในเรื่องของการจ่ายเงิน เรานำเข้าเกมสล็อตลิขสิทธิ์แท้จากค่ายดังโดยตรง อัตราการชนะ (RTP) สูงกว่าเว็บทั่วไป
      เล่นได้หลักหมื่นหรือทะลุหลักล้าน เราก็พร้อมโอนจ่ายเต็มจำนวน ไม่มีการหักเปอร์เซ็นต์หรือหักค่าธรรมเนียมใดๆ ทั้งสิ้น ยอดเข้ากระเป๋าเน้นๆ ทุกบิล
    </p>
  </ContentBoxSevenThreePremium>

  <ProviderGrid />

  <ContentBox3Three title="ทำกำไรต่อเนื่องบน JUDTEM168 ผ่านระบบฝากถอนออโต้ไม่มีขั้นต่ำ">
    <p slot="left" class="text-left text-base leading-relaxed">
      ลืมการทำรายการผ่านแอดมินที่ต้องส่งสลิปและรอคิวนานๆ ไปได้เลย ระบบการเงินของเราใช้เทคโนโลยี AI เข้ามาจัดการทั้งหมด
    </p>
    <p slot="center" class="text-left text-base leading-relaxed">
      คุณสามารถกดทำรายการฝากหรือถอนได้ด้วยตัวเอง ใช้เวลาประมวลผลไม่เกิน 3 วินาที ที่สำคัญคือให้อิสระทางการเงินขั้นสุด
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      ทุนน้อยแค่ 1 บาทก็ฝากเข้ามาปั่นสล็อตได้สบายๆ เปิดโอกาสให้ทุกคนเข้าถึงความรวยได้เท่าเทียมกัน
    </p>
  </ContentBox3Three>

  <ContentBoxSpecial title="มาตรฐานความมั่นคงทางการเงินระดับสากล ปลอดภัย ถอนได้ไม่อั้น">
    <p slot="left" class="text-left text-base leading-relaxed">
      ความกังวลเรื่องเว็บปิดหนีหรือถอนเงินไม่ออกจะไม่เกิดขึ้นที่นี่ เพราะ JUDTEM168 มีฐานการเงินที่แข็งแกร่งและมีเงินทุนหมุนเวียนมหาศาล รองรับการทำธุรกรรมของสมาชิกนับแสนคนต่อวัน
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      คุณสามารถกดถอนเงินได้ไม่อั้น ไม่จำกัดจำนวนครั้งต่อวัน เล่นได้เท่าไหร่ถอนออกไปใช้ได้เลยทันที ระบบรักษาความปลอดภัยเทียบเท่าแอปพลิเคชันธนาคารชั้นนำ ข้อมูลส่วนตัวไม่มีรั่วไหลแน่นอน
    </p>
  </ContentBoxSpecial>

  <LatestWinners />

  <ContentBoxSevenThreeCyberCut titleright="เล่นเกมสนุกอิสระไร้ขีดจำกัด การันตีไม่ล็อคยูสเซอร์ต้องที่ JUDTEM168">
    <Picture
      slot="left"
      src={imgGames}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์ JUDTEM168 รองรับเกมมากมาย แตกง่าย พร้อมภาพนักรบโรมันสวมชุดเกราะทองยืนคู่กับเสือ และแถบการันตีมีใบรับรองจากหน่วยงานสากล บริการตลอด 24 ชั่วโมง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e4a434]/35 shadow-[0_10px_30px_rgba(204,132,37,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      หลายคนเคยเจอปัญหาเล่นแรกๆ แตกดี พอได้กำไรเยอะกลับสปินไม่เข้าอีกเลย นั่นคืออาการของเว็บที่ปรับเรทอัตราแพ้ชนะ แต่สำหรับที่นี่เราให้บริการแบบเว็บตรง API แท้ 100%
      ระบบสุ่มรางวัลทำงานอย่างยุติธรรมตามมาตรฐานสากล หมดปัญหาการล็อคยูสเซอร์ หรือปรับลดเปอร์เซ็นต์การแตกของโบนัส ทุกการหมุนของคุณมีโอกาสลุ้นรางวัลใหญ่ก้อนโตอย่างแท้จริง
    </p>
  </ContentBoxSevenThreeCyberCut>

  <GameRankingBoard />

  <ContentBox as="h2" title="วิธีเข้าสู่ระบบเพื่อเริ่มต้นกอบโกยเงินรางวัลเข้ากระเป๋าทุกวัน">
    <p class="text-left text-base leading-relaxed">
