---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBox3ThreeCyberCut from "../components/ContentBox3ThreeCyberCut.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBox from "../components/ContentBox.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners2 from "../components/LatestWinners2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq3 from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgFreeBonus500 from "../assets/slide1.png";
import imgCashback5 from "../assets/slide2.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxFloatingBadge as="h1"
//   2 → ContentBox3ThreeCyberCut as="h2" (แบ่งย่อหน้าเดียวลง left/center/right)
//   3 → ContentBoxTwoNeumorphism as="h2" แล้วต่อด้วย GameRankingBoard และ
//       ProviderGrid ซึ่งเป็นภาพประกอบของหัวข้อนี้โดยตรง (ไลน์อัปเกมและค่าย)
//   4 → ContentBoxSevenThreePremium as="h2" + slide1
//   5 → ContentBoxSevenThree as="h2" + slide2
//   6 → ContentBoxSpecial as="h2"
//   7 → ContentBox as="h2" (การ์ดกลางที่ terms/privacy ใช้ร่วม)
//
// variant รอบนี้หมุนทั้งตระกูลจากแบรนด์ก่อนหน้า (PABO88 ใช้ Premium +
// SevenThreeCyberCut + 3ThreePremium + SevenThreeNeumorphism + CyberCut + plain +
// Neumorphism) มาเป็น FloatingBadge + 3ThreeCyberCut + TwoNeumorphism +
// SevenThreePremium + SevenThree + Special + plain ส่วน Navbar ย้ายจาก
// NavbarStyle10 มาเป็น NavbarStyle11, Footer จาก Footer.astro มาเป็น
// FooterPremium, Announcement จาก Announcement6 มาเป็น AnnouncementPremium,
// LatestWinners จาก LatestWinners.astro มาเป็น LatestWinners2, Faq จาก Faq.astro
// มาเป็น Faq3 และโครงสองคอลัมน์ที่ LoginRtpSection ใช้ย้ายจาก
// ContentBoxTwoCyberCut มาเป็น ContentBoxTwoPremium
//
// plain ContentBox ซ้ำจากรอบก่อนโดยบังคับ — terms.astro กับ privacy.astro ตรึงไว้
// ที่ไฟล์นี้ถาวร มันจึงเป็น always-live ไม่ว่าจะหมุน variant อย่างไร
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook — slide1 (รับฟรีโบนัส สูงสุด 500.-
// เพียงทำการฝากในช่วงเวลา 20:00-22:00) คู่กับหัวข้อข้อ 4 ซึ่งเป็นเรื่องโบนัสและ
// สิทธิพิเศษตรงๆ และ slide2 (คืนยอดเสียทุกวัน 5% ถอนได้ทันที ไม่มีเทิร์น) คู่กับ
// หัวข้อข้อ 5 เรื่องเว็บทุนหนาจ่ายจริง เพราะ "ถอนได้ทันที ไม่มีเทิร์น" บนรูปคือ
// ภาพของการรับยอดแบบไม่เล่นแง่
//
// slide3 กับ slide4 เป็นอาร์ตของโปรโมชันอื่นที่หน้า /promotion ถือไว้ ส่วน
// banner.png กับ banner2/3/4 เป็นอาร์ตค้างของแบรนด์ก่อนๆ ทั้งชุด จึงห้าม import
// ที่นี่ทั้งสิ้น — รูปที่ import คือรูปที่ถูก emit ถึงจะไม่มีใคร render ก็ตาม
// ส่วน banner1 กับ banner1-mobile เป็น hero ที่ MainLayout จัดการเอง รอบนี้จึง
// ไม่มีรูปประกอบใน ContentBox เดี่ยว
//
// widget ที่ไม่ได้มาจาก docx (LatestWinners2, LoginRtpSection, ReviewCardSumo2,
// SmoothCarousel, แถวปุ่ม login/register, FAQ) ใช้ป้ายเป็น <p>/<span> + aria-label
// บน <section> และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้ายทั้งชุด ยกเว้น GameRankingBoard
// กับ ProviderGrid ที่เป็นภาพประกอบของหัวข้อ docx ข้อ 3 โดยตรง จึงวางต่อท้ายบล็อก
// นั้น ไม่มีตัวไหนคั่นระหว่างหัวข้อ docx สองข้อ
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx พอดี ไม่มีตัวที่เจ็ด — หัว FAQ ถูกลดเป็น <p>
// ใน Faq3.astro (ชื่อ section ย้ายไป aria-label) คำถามใน Faq เป็น <span> ใน
// <summary> ไม่ใช่ h3 บรรทัดหัวของ LatestWinners2 เป็น <p> และป้ายคอลัมน์ของ
// ContentBox3ThreeCyberCut / ContentBoxTwoNeumorphism / SevenThree ทั้งสองตัว /
// ContentBoxTwoPremium เป็น <p> — docx รอบนี้แบน H1 + H2 ล้วน หน้านี้จึงไม่มี h3 เลย
//
// title กับ description ใช้บรรทัด Title/Des ของ docx ตรงๆ (60 / 156 ตัวอักษร
// อยู่ในเกท 150–160 ของ verify-build แล้ว) และ description เป็นสตริงเดียวกับที่
// ส่งเข้า pageGraph
const pageTitle = "UOK789 | สล็อตออนไลน์ค่ายแท้ โบนัสจัดหนัก เว็บทุนหนาจ่ายจริง";
const pageDescription =
  "UOK789 สล็อตออนไลน์ค่ายแท้ เชื่อมเกมตรงผ่าน API ตัวเด็ดเข้าไม่พัก โบนัสจัดหนัก เว็บทุนหนาจ่ายจริง ไม่ล็อกยูส ฝากถอนออโต้ พร้อมระบบการเงินที่ทำงานเป็นขั้นตอน";

// default message ของ Announcement ทุก variant คือสโลแกนของแบรนด์เก่าคนละเจ้ากัน
// จึงส่ง message ตรงๆ เสมอ ไม่พึ่ง default และห้ามขึ้นต้นด้วย emoji เพราะ marquee
// render ข้อความซ้ำและ emoji ที่ฝังในสตริงถูก mark aria-hidden ไม่ได้ — ข้อความชุดนี้
// ตรงกับ default ของ AnnouncementPremium เป๊ะ เพื่อให้ ticker ของหน้าย่อยที่เรียก
// <Announcement /> เปล่าๆ วิ่งข้อความเดียวกับหน้าแรก
const announcementMessage =
  "UOK789 สล็อตออนไลน์ค่ายแท้ โบนัสจัดหนัก เว็บทุนหนาจ่ายจริง • เชื่อมตรงกับเซิร์ฟเวอร์หลักของค่ายเกมผ่าน API ไม่ผ่านเอเย่นต์หรือคนกลาง ไม่ดัดแปลงโปรแกรมและไม่ล็อกผล • ล็อบบี้อัปเดตเกมสล็อตใหม่เข้ามาต่อเนื่อง ทั้งเกมฮิตติดลมบนและเกมนอกกระแสฟีเจอร์เด็ดที่พร้อมแตกหนัก • โปรโมชันเติมเงินรายวัน เครดิตพิเศษต้อนรับสมาชิกใหม่ และกิจกรรมคืนยอดเสียที่แจกให้อย่างต่อเนื่อง • ถอนหลักร้อยหรือหลักแสนก็อนุมัติเต็มจำนวน ไร้ประวัติการเบี้ยว ยอดไม่ค้าง ไม่มีเงื่อนไขจุกจิกมาประวิงเวลา • ไม่ล็อกยูส ปรับเบทขึ้นลง ซื้อฟีเจอร์ หรือสลับหลายค่ายในวันเดียวได้เต็มสไตล์ • ฝากถอนออโต้เสร็จในไม่กี่วินาที ไม่ต้องส่งสลิปให้แอดมินตรวจสอบ ตลอด 24 ชั่วโมง";

// FAQ ห้าข้อเขียนจากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้าไหนมา
// ทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบคำถาม
// ที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq3> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน
const faqs = [
  {
    q: "UOK789 เชื่อมเกมกับค่ายอย่างไร ต่างจากเว็บที่ผ่านเอเย่นต์ตรงไหน",
    a: "ตัวระบบเชื่อมต่อตรงกับเซิร์ฟเวอร์หลักของค่ายเกมผ่าน API โดยไม่ผ่านเอเย่นต์หรือคนกลาง จึงไม่มีการดัดแปลงโปรแกรม ไม่มีการปรับลดเปอร์เซ็นต์ชนะ และไม่มีการล็อกผลใดๆ ทุกสปินลื่นไหลไร้ปัญหากระตุก และให้ผลการออกรางวัลที่แม่นยำตามมาตรฐานสากล",
  },
  {
    q: "ล็อบบี้เกมสล็อตของ UOK789 อัปเดตเกมใหม่บ่อยแค่ไหน",
    a: "ล็อบบี้มีการอัปเดตเกมสล็อตใหม่เข้ามาอย่างต่อเนื่องไม่ขาดสาย ทั้งเกมฮิตติดลมบนที่ใครๆ ก็ปั่น และเกมนอกกระแสฟีเจอร์เด็ดที่พร้อมแตกหนัก เลือกสลับเปลี่ยนเล่นได้ไม่มีซ้ำ ทำให้การทำกำไรมีตัวเลือกหลากหลายและสดใหม่อยู่ตลอดเวลา",
  },
  {
    q: "โบนัสและสิทธิพิเศษของ UOK789 มีแบบไหนให้เลือกบ้าง",
    a: "สิทธิพิเศษถูกคิดมาเพื่อซัพพอร์ตสมาชิกทุกระดับ ทั้งโปรโมชันเติมเงินรายวัน เครดิตพิเศษต้อนรับสมาชิกใหม่ และกิจกรรมคืนยอดเสียที่แจกให้อย่างต่อเนื่อง ทั้งหมดช่วยเพิ่มทุนในการปั่นให้หมุนลุ้นรอบแจ็คพอตได้นานยิ่งขึ้นโดยไม่ต้องใช้ทุนเยอะ",
  },
  {
    q: "ถอนยอดใหญ่หลักแสนกับ UOK789 ได้เต็มจำนวนจริงไหม",
    a: "ไม่ว่าจะทำกำไรถอนหลักร้อยหรือสปินแตกโบนัสใหญ่หลักแสน ทางเว็บก็พร้อมอนุมัติและโอนเงินออกให้เต็มจำนวน ไร้ประวัติการเบี้ยว ยอดไม่ค้าง และไม่มีการอ้างเงื่อนไขจุกจิกมาประวิงเวลา จึงมั่นใจได้ว่าจะได้รับเงินรางวัลครบถ้วนทุกบาททุกสตางค์",
  },
  {
    q: "ฝากถอนกับ UOK789 ต้องส่งสลิปให้แอดมินไหม และมีการล็อกยูสหรือเปล่า",
    a: "ทุกรายการฝากและถอนดำเนินการผ่านระบบอัตโนมัติภายในเวลาไม่กี่วินาที ไม่ต้องส่งสลิปให้แอดมินตรวจสอบและไม่ต้องนั่งรอ ทำรายการได้ตลอด 24 ชั่วโมง ส่วนการเล่นก็ไม่ล็อกยูส จะปรับเบทขึ้นลง ซื้อฟีเจอร์ หรือสลับหลายค่ายในวันเดียวก็ทำได้เต็มสไตล์",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxFloatingBadge as="h1" title="UOK789 สล็อตออนไลน์ค่ายแท้ โบนัสจัดหนัก เว็บทุนหนาจ่ายจริง">
    <p class="text-left text-base leading-relaxed">
      ถ้าคุณกำลังมองหาความชัวร์ในการเล่นสล็อตออนไลน์ บอกเลยว่า UOK789 สล็อตออนไลน์ค่ายแท้ โบนัสจัดหนัก เว็บทุนหนาจ่ายจริง คือตัวเลือกที่ตอบโจทย์สายปั่นได้ตรงจุดที่สุด
      ที่นี่โดดเด่นด้วยการเป็นศูนย์รวมเกมลิขสิทธิ์แท้ที่พร้อมแจกแจ็คพอตก้อนโตตลอดวัน ประกอบกับฐานการเงินที่มั่นคงปลอดภัยระดับสากล ไม่ว่าจะเล่นได้ยอดเล็กหรือโบนัสแตกหลักแสน
      ก็ถอนเงินออกไปใช้ได้จริงแบบไม่ต้องนั่งลุ้น ให้คุณได้สัมผัสความสนุกของการสปินแบบไร้กังวลตั้งแต่วินาทีแรก
    </p>
  </ContentBoxFloatingBadge>

  <ContentBox3ThreeCyberCut
    as="h2"
    title="UOK789 สล็อตออนไลน์ค่ายแท้ เชื่อมตรงผ่าน API ต่างจากเกมทั่วไปตรงไหน?"
    titleleft="เสถียรและจ่ายเป็นธรรม"
    titlecenter="เชื่อมตรงไม่ผ่านคนกลาง"
    titleright="ทุกสปินลื่นไหล">
    <p slot="left" class="text-left text-base leading-relaxed">
      เหตุผลที่ทำให้ UOK789 สล็อตออนไลน์ค่ายแท้ เชื่อมตรงผ่าน API ต่างจากเกมทั่วไปตรงไหน? คำตอบอยู่ที่ความเสถียรและอัตราการจ่ายที่เป็นธรรมขั้นสุด
    </p>
    <p slot="center" class="text-left text-base leading-relaxed">
      เนื่องจากตัวระบบเชื่อมต่อตรงกับเซิร์ฟเวอร์หลักของค่ายเกมโดยไม่ผ่านเอเย่นต์หรือคนกลาง ทำให้ไม่มีการดัดแปลงโปรแกรม การปรับลดเปอร์เซ็นต์ชนะ หรือการล็อกผลใดๆ
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">ทุกสปินจึงลื่นไหล ไร้ปัญหากระตุก และให้ผลการออกรางวัลที่แม่นยำตามมาตรฐานสากล 100%</p>
  </ContentBox3ThreeCyberCut>

  <ContentBoxTwoNeumorphism
    as="h2"
    title="ตัวเด็ดเข้าไม่พัก เปิดลิสต์ UOK789 เจอทั้งเกมกระแสและตัวใหม่ให้น่าตาม"
    titleleft="ล็อบบี้อัปเดตไม่ขาดสาย"
    titleright="ทั้งเกมกระแสและตัวใหม่">
    <p slot="left" class="text-left text-base leading-relaxed">
      ความน่าตื่นเต้นอีกอย่างคือไลน์อัปเกมที่จัดมาให้แบบ ตัวเด็ดเข้าไม่พัก เปิดลิสต์ UOK789 เจอทั้งเกมกระแสและตัวใหม่ให้น่าตาม กันแบบไม่ขาดสาย
      ล็อบบี้ของที่นี่มีการอัปเดตเกมสล็อตใหม่ๆ เข้ามาอย่างต่อเนื่อง
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      ไม่ว่าจะเป็นเกมฮิตติดลมบนที่ใครๆ ก็ปั่น หรือเกมนอกกระแสฟีเจอร์เด็ดที่พร้อมแตกหนัก ก็มีให้เลือกสลับเปลี่ยนเล่นได้ไม่มีซ้ำ
      ช่วยให้การทำกำไรของคุณมีตัวเลือกหลากหลายและสดใหม่อยู่ตลอดเวลา
    </p>
  </ContentBoxTwoNeumorphism>

  <GameRankingBoard />

  <ProviderGrid />

  <ContentBoxSevenThreePremium as="h2" title="โบนัสจัดหนักมีจังหวะไหนน่าสนใจ สิทธิพิเศษที่เพิ่มความคุ้มให้มากกว่าเดิม" titleleft="รับฟรีโบนัส สูงสุด 500.-">
    <Picture
      slot="left"
      src={imgFreeBonus500}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 767px) 92vw, 340px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
