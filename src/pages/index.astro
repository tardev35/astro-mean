---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import LatestWinners3 from "../components/LatestWinners3.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Faq2 from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgWelcomeBonus from "../assets/slide1.png";
import imgLuckyWheel from "../assets/slide3.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxPremium as="h1" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   2 → ContentBoxNeumorphism as="h2" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   3 → ContentBoxSevenThree as="h2" + slide1 (แบนเนอร์ต้อนรับสมาชิกใหม่ที่ระบุบน
//       รูปว่าเล่นได้เฉพาะสล็อตและกีฬา ตรงกับหัวข้อคลังเกมสล็อตลิขสิทธิ์แท้) แล้วต่อ
//       ด้วย ProviderGridPremium ซึ่งกางชื่อค่ายที่ย่อหน้าเดียวกันเอ่ยถึง
//   4 → ContentBox3ThreePremium as="h2" (ย่อหน้าเดียวแบ่งลงสามคอลัมน์ตามจังหวะ
//       ประโยคเดิม: ล็อบบี้จัดหมวดหมู่ → รายชื่อแนวสล็อต → กระเป๋าเดียวไม่ต้องโยกเงิน)
//       แล้วต่อด้วย GameRankingBoard กับ SmoothCarousel ซึ่งกางหมวดเกมในล็อบบี้ให้
//       เห็นครบในหน้าเดียว
//   5 → ContentBoxCyberCut as="h2" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   6 → ContentBoxSpecial as="h2" (ย่อหน้าเดียวแบ่งลงสองครึ่งตามลำดับประโยคเดิม:
//       ฝั่งการแสดงผลทุกอุปกรณ์ → ฝั่งตำแหน่งปุ่มกดบนมือถือ)
//   7 → ContentBoxSevenThreePremium as="h2" + slide3 (แบนเนอร์กงล้อนำโชคที่แจก
//       ชิ้นส่วนเพชร "ทุกชม." ตรงกับหัวข้อเปิดบริการตลอด 24 ชั่วโมง) แล้วต่อด้วย
//       LatestWinners3 ซึ่งเป็นหลักฐานของประโยคเรื่องระบบฝากถอนที่ทำงานเท่ากันทั้งวัน
//
// variant รอบนี้หมุนออกจากชุดของแบรนด์ก่อนทั้งตระกูล: ทรง ContentBox เปลี่ยนจากชุด
// FloatingBadge นำ มาเป็น Premium + Neumorphism + CyberCut + ตัวเปล่า + Special
// (ไม่มี FloatingBadge เลยรอบนี้) ส่วน Announcement เป็น AnnouncementPremium,
// LatestWinners เป็น LatestWinners3, ProviderGrid เป็น ProviderGridPremium และ Faq
// เป็น Faq2 — Navbar/Footer/ฟอนต์ ถูกสลับไว้แล้วใน MainLayout กับ brandProfile
//
// ContentBoxSevenThreePremium ปล่อยหัวข้อจาก rightHeading = titleright ?? title
// จึงส่งมาแค่ `title` ตัวเดียว ถ้าส่ง titleright มาด้วยหัวข้อ docx จะถูกแทนที่เงียบๆ
// ส่วน titleleft ของทั้งสอง SevenThree เป็นป้ายคอลัมน์รูปที่ยังเป็น <p>
//
// Announcement ส่ง message ตรงๆ เสมอ เพราะ default ของทุก variant ในตระกูลนี้เป็น
// สโลแกนของแบรนด์เก่าคนละเจ้ากัน ข้อความชุดนี้ตรงกับ default ของ AnnouncementPremium
// เป๊ะ เพื่อให้ ticker ของหน้าย่อยที่เรียก <Announcement /> เปล่าๆ วิ่งข้อความเดียว
// กับหน้าแรก และห้ามขึ้นต้นด้วย emoji เพราะ marquee render ข้อความซ้ำและ emoji ที่
// ฝังในสตริงถูก mark aria-hidden ไม่ได้
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook คู่กับ slide1/slide3 ซึ่งเป็นสไลด์ของ
// แบรนด์นี้จริงทั้งสองใบ — slide2 (แนะนำเพื่อน) ไม่มีหัวข้อ docx ไหนรองรับจึงปล่อยไว้
// ไม่ใช้ ส่วน slide4 กับ banner ทุกหมายเลข (banner.png, banner2/3/4) เป็นอาร์ตของ
// แบรนด์ก่อนที่มีชื่อของเขาพิมพ์อยู่บนรูป ห้าม import ที่นี่หรือที่ไหนก็ตาม เพราะรูปที่
// import คือรูปที่ถูก emit ถึงจะไม่มีใคร render ก็ตาม ส่วน banner1 กับ banner1-mobile
// เป็นของ MainLayout จัดการเอง
//
// widget ที่ไม่ได้มาจาก docx (LoginRtpSection, ReviewCardSumo2, แถวปุ่ม
// login/register, FAQ, Navfoot) ใช้ป้ายเป็น <p>/<span> + aria-label บน <section>
// และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้ายทั้งชุด ยกเว้นสี่ตัวที่เป็นภาพประกอบของ
// หัวข้อ docx หนึ่งข้อโดยตรง (ProviderGridPremium → ข้อ 3, GameRankingBoard กับ
// SmoothCarousel → ข้อ 4, LatestWinners3 → ข้อ 7) ซึ่งวางต่อท้ายบล็อกนั้นๆ
//
// h1 ×1 + h2 ×6 = หัวข้อ docx พอดี ไม่มีตัวที่แปด — หัว FAQ เป็น <p> ใน Faq2.astro
// คำถามใน Faq2 เป็น <span> ใน <summary> และป้ายคอลัมน์ของทุก ContentBox variant
// เป็น <p> — docx รอบนี้แบน H1 + H2 ล้วน หน้านี้จึงไม่มี h3 เลย
//
// title ใช้บรรทัด Title ของ docx ตรงๆ ส่วน description ใช้บรรทัด Des ของ docx เป็น
// ฐานแล้วต่อท้ายด้วยข้อเท็จจริงจาก docx อีกวรรคเดียว ("ฝากถอนออโต้ไว") เพราะบรรทัด
// Des ดิบยาว 142 ตัวอักษร ซึ่งต่ำกว่าเพดานล่าง 150 ตัวของเกทคุณภาพ — ค่าที่ใช้จริง
// ยาว 156 ตัวอักษร และเป็นสตริงเดียวกับที่ส่งเข้า pageGraph และ MainLayout
const pageTitle = "PHOENIX168 | สล็อตสปีดติดปีก เกมฮิตลิขสิทธิ์แท้ ออโต้ไวไม่ต้องรอ";
const pageDescription = "PHOENIX168 สล็อตสปีดติดปีก เกมฮิตลิขสิทธิ์แท้หลายค่าย ตัวท็อปมีครบ ระบบเล่นลื่นไม่มีสะดุด พร้อมรองรับทุกอุปกรณ์ ปั่นเพลินได้ทั้งวัน 24 ชั่วโมง ฝากถอนออโต้ไว";

const announcementMessage =
  "PHOENIX168 สล็อตสปีดติดปีก เกมฮิตลิขสิทธิ์แท้ ออโต้ไวไม่ต้องรอ • เว็บตรงสล็อตสายสปีดที่ตั้งใจทำระบบออกมาให้คนเล่นใช้งานได้จริงแบบไม่มีสะดุด ยิงตรง API แท้จากค่ายใหญ่ เซิร์ฟนอกมาตรฐานสากล เล่นแล้วโบนัสแตกตามอัตราจ่ายจริง ไม่มีดัดแปลงเปอร์เซ็นต์ชนะ ปั่นได้เท่าไหร่ถอนออกได้ครบเต็มจำนวนทันที • กดเข้าหน้าเว็บปุ๊บก็พร้อมลุยปั๊บ ปรับจูนระบบหลังบ้านมาให้โหลดไวกว่าเว็บทั่วไปหลายเท่า ตัดขั้นตอนยุ่งยากออกทั้งหมด พุ่งตรงจากหน้าแรกเข้าสู่ตัวเกมได้ในคลิกเดียว ไม่พลาดจังหวะสำคัญในการทำกำไร • ขนเกมสล็อตลิขสิทธิ์แท้จากค่ายดังอย่าง PG Soft, Pragmatic Play, Joker Gaming และค่ายชั้นนำอื่นๆ มาไว้ให้เลือกแบบแน่นๆ คัดมาเฉพาะตัวที่แตกง่าย มีฟีเจอร์ตัวคูณหนัก ฟรีสปินเข้าไว อัตราการจ่ายเงินรางวัลยุติธรรม • หน้าล็อบบี้จัดวางหมวดหมู่เกมไว้อย่างเป็นระเบียบ ทั้งสล็อตสายภาพสวย 3D สล็อตสตรีตนำโชค และสล็อตสายซื้อฟีเจอร์พุ่งชนโบนัส เลือกได้ทันทีในกระเป๋าเดียว ไม่ต้องย้ายเว็บ ไม่ต้องโยกเงินให้วุ่นวาย • สลับค่ายสลับเกมได้ทันทีโดยไม่ต้องรอโหลดหน้าคีย์ข้อมูลใหม่ ตัวเกมประมวลผลสมูธ กราฟิกแสดงผลคมชัด ไม่มีอาการกระตุกหรือหลุดออกจากเกมให้เสียจังหวะ • ปรับสเกลหน้าจอให้อัตโนมัติแบบสมบูรณ์แบบ รองรับทั้งมือถือ iOS, Android, แท็บเล็ต และคอมพิวเตอร์ แสดงผลคมชัด ลื่นไหล เสถียรเท่ากันทุกช่องทาง ปุ่มกดวางในตำแหน่งที่ใช้นิ้วโป้งกดง่าย • ไม่มีปิดปรับปรุงระบบแบบไม่แจ้งล่วงหน้า เซิร์ฟเวอร์เสถียรสูงพร้อมเปิดให้บริการตลอด 24 ชั่วโมง จังหวะโบนัสและระบบฝากถอนทำงานด้วยความเร็วสูงสุดเท่ากันตลอดวัน ฝากถอนออโต้ไฮสปีดเสร็จในไม่กี่วินาที ไม่ต้องส่งสลิป ไม่ต้องคอยแอดมินอนุมัติ";

// FAQ ห้าข้อเขียนขึ้นใหม่จากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้า
// ไหนมาทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบ
// คำถามที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq2> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน
const faqs = [
  {
    q: "PHOENIX168 เป็นเว็บตรงจริงไหม แล้วอัตราจ่ายถูกดัดแปลงหรือเปล่า",
    a: "เป็นเว็บตรงสล็อตสายสปีดที่ยิงตรง API แท้จากค่ายใหญ่ วางเซิร์ฟนอกมาตรฐานสากล เล่นแล้วโบนัสแตกตามอัตราจ่ายจริงของแต่ละเกม ไม่มีการดัดแปลงเปอร์เซ็นต์ชนะ ระบบทั้งชุดตั้งใจทำออกมาให้คนเล่นใช้งานได้จริงแบบไม่มีสะดุด ปั่นได้เท่าไหร่ก็ถอนออกได้ครบเต็มจำนวนทันที",
  },
  {
    q: "มีค่ายเกมอะไรบ้าง แล้วเกมที่เอามาลงคัดจากอะไร",
    a: "ขนเกมสล็อตลิขสิทธิ์แท้จากค่ายดังอย่าง PG Soft, Pragmatic Play, Joker Gaming และค่ายชั้นนำอื่นๆ มาไว้ให้เลือกแบบแน่นๆ คัดมาเฉพาะตัวที่แตกง่าย มีฟีเจอร์ตัวคูณหนัก ฟรีสปินเข้าไว และมีอัตราการจ่ายเงินรางวัลที่ยุติธรรม เพื่อให้ทุกการหมุนมีโอกาสลุ้นแจ็คพอตก้อนโตได้จริง",
  },
  {
    q: "อยากเล่นหลายแนวต้องสมัครหลายเว็บไหม แล้วต้องโยกเงินข้ามค่ายหรือเปล่า",
    a: "ไม่ต้องเสียเวลาสมัครหลายเว็บ เพราะหน้าล็อบบี้จัดวางหมวดหมู่เกมไว้อย่างเป็นระเบียบ รวบรวมทั้งสล็อตสายภาพสวย 3D สล็อตสตรีตนำโชค และสล็อตสายซื้อฟีเจอร์พุ่งชนโบนัสไว้ที่เดียว อยากเล่นแนวไหนก็กดเลือกได้ทันทีในกระเป๋าเดียว ไม่ต้องย้ายเว็บ ไม่ต้องโยกเงินให้วุ่นวาย",
  },
  {
    q: "เล่นบนมือถือกับคอมต่างกันไหม แล้วสลับเกมแล้วต้องรอโหลดใหม่หรือเปล่า",
    a: "ปรับสเกลหน้าจอให้อัตโนมัติแบบสมบูรณ์แบบ ทั้งมือถือ iOS, Android, แท็บเล็ต และคอมพิวเตอร์ แสดงผลคมชัด ลื่นไหล และเสถียรเท่ากันทุกช่องทาง ปุ่มกดวางในตำแหน่งที่ใช้นิ้วโป้งกดง่าย ส่วนการสลับค่ายสลับเกมทำได้ทันทีโดยไม่ต้องรอโหลดหน้าคีย์ข้อมูลใหม่ ไม่มีอาการกระตุกหรือหลุดออกจากเกม",
  },
  {
    q: "เข้าเล่นได้ช่วงไหนบ้าง แล้วฝากถอนต้องส่งสลิปรอแอดมินไหม",
    a: "เซิร์ฟเวอร์เสถียรสูงพร้อมเปิดให้บริการตลอด 24 ชั่วโมง ไม่มีปิดปรับปรุงระบบแบบไม่แจ้งล่วงหน้า จะเป็นสายปั่นช่วงพักเที่ยงหรือสายลุยดึกๆ จังหวะโบนัสและระบบฝากถอนก็ทำงานด้วยความเร็วสูงสุดเท่ากันตลอดวัน ฝากถอนผ่านระบบออโต้ไฮสปีดเสร็จในไม่กี่วินาที ไม่ต้องส่งสลิป ไม่ต้องคอยแอดมินอนุมัติ",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxPremium as="h1" title="PHOENIX168 สล็อตสปีดติดปีก เกมฮิตลิขสิทธิ์แท้ ออโต้ไวไม่ต้องรอ">
    <p class="text-left text-base leading-relaxed">
      PHOENIX168 เว็บตรงสล็อตสายสปีดที่ตั้งใจทำระบบออกมาให้คนเล่นใช้งานได้จริงแบบไม่มีสะดุด ยิงตรง API แท้จากค่ายใหญ่ เซิร์ฟนอกมาตรฐานสากล เล่นแล้วโบนัสแตกตามอัตราจ่ายจริง ไม่มีดัดแปลงเปอร์เซ็นต์ชนะ
      ฝากถอนผ่านระบบออโต้ไฮสปีด ทำรายการเสร็จในไม่กี่วินาที ไม่ต้องส่งสลิป ไม่ต้องคอยแอดมินอนุมัติ ปั่นได้เท่าไหร่ถอนออกได้ครบเต็มจำนวนทันที
    </p>
  </ContentBoxPremium>

  <ContentBoxNeumorphism as="h2" title="PHOENIX168 สล็อตสปีดติดปีก เปิดเกมไวพร้อมพาความสนุกทะยานตั้งแต่หน้าแรก">
    <p class="text-left text-base leading-relaxed">
