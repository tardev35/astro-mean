---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgClassicGames from "../assets/slide1.png";
import imgWeeklyCashback from "../assets/slide3.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxPremium as="h1"
//   2 → ContentBoxSevenThreePremium as="h2" + slide1 (เกมคลาสสิกในตำนาน)
//   3 → ContentBoxTwoFloatingBadge as="h2" (แบ่งย่อหน้าเดียวลง left/right ที่
//       รอยต่อประโยค)
//   4 → ContentBox3ThreePremium as="h2" (แบ่งย่อหน้าลง left/center/right)
//   5 → ContentBoxSpecial as="h2" (แบ่งย่อหน้าลง left/right)
//   6 → ContentBoxSevenThree as="h2" + slide3 (คืนยอดเสียทุกสัปดาห์)
//   7 → ContentBoxFloatingBadge as="h2"
//
// variant รอบนี้เปลี่ยนทั้งตระกูลจากแบรนด์ก่อนหน้า: Premium + FloatingBadge +
// Special + plain แทนชุด CyberCut + Neumorphism + plain
//
// SevenThree ใช้สองบล็อกพอดี ซึ่งเป็นเพดานของ playbook — slide1 คู่กับหัวข้อ
// "เกมแน่นค่ายครบเครื่อง" (รูปพิมพ์ว่าเกมคลาสสิกเล่นง่ายได้จริง) และ slide3 คู่กับ
// หัวข้อโบนัส (รูปพิมพ์ว่าคืนยอดเสียทุกสัปดาห์) ส่วน slide2/slide4 เป็นของ
// SmoothCarousel จึงไม่ถูก import ที่นี่ ไม่ให้รูปใบเดียวกันโผล่สองที่ในหน้าเดียว
//
// banner1/banner1-mobile เป็น hero ที่ MainLayout จัดการเอง ส่วน banner.png กับ
// banner2/3/4 เป็นอาร์ตของแบรนด์เก่า (mtime 2026-08-04) จึงไม่ถูก import ที่ไหน
//
// widget ที่ไม่ได้มาจาก docx (SmoothCarousel, ProviderGrid, GameRankingBoard,
// LoginRtpSection, LatestWinners, ReviewCardSumo2, แถวปุ่ม login/register) ใช้
// ป้ายเป็น <p>/<span> + aria-label บน <section> จึงวางต่อท้ายหัวข้อ docx ที่มัน
// สังกัดได้โดยลำดับ h2 ไม่เพี้ยน
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx + หัวข้อ FAQ ที่หน้านี้เขียนเอง = 7
// คำถามใน Faq3 เป็น <h3> ใต้ h2 ของ section ตามที่ variant นั้น ship มา

// Title/Des มาจาก docx ตรงตัว แล้วต่อให้อยู่ในช่วง 150–160 ตัวอักษรที่
// verify-build บังคับ
const pageTitle = "249UP | เว็บสล็อตฟอร์มตึง เกมแน่นค่ายครบเครื่อง โบนัสมาไม่มีแผ่ว";
const pageDescription =
  "249UP เว็บสล็อตฟอร์มตึง เกมแน่นค่ายครบเครื่อง โบนัสมาไม่มีแผ่ว เข้าเมนูไว สลับค่ายคล่อง ฟีเจอร์มีของ ล็อบบี้ไม่จำเจ พร้อมระบบโอนไวเข้าบัญชีเลย ไม่ต้องรอ";

// default message ของ Announcement ทุก variant คือสโลแกนของแบรนด์เก่าคนละเจ้ากัน
// จึงส่ง message ตรงๆ เสมอ ไม่พึ่ง default
const announcementMessage =
  "249UP เว็บสล็อตฟอร์มตึง เกมแน่นค่ายครบเครื่อง โบนัสมาไม่มีแผ่ว • รวมค่ายเกมชั้นนำไว้ครบครัน คัดเฉพาะเกมที่ขึ้นชื่อเรื่องภาพสวย แตกง่าย และมีเอกลักษณ์เฉพาะตัว • เข้าเมนูไว สลับค่ายคล่อง เมนูจัดหมวดหมู่เป็นระเบียบ เปลี่ยนแนวการเล่นได้ทันทีโดยไม่ต้องผ่านหลายขั้นตอน • ฟีเจอร์มีของทั้งระบบคูณเงินรางวัล ซื้อฟรีสปิน และตัวคูณแบบสุ่มที่โผล่มาถูกจังหวะ • ล็อบบี้อัปเดตเกมใหม่อยู่เสมอ มีทั้งเกมฮิตระดับตำนานและเกมนอกกระแสที่แจ็คพอตดีรอให้ค้นพบ • โปรโมชันและโบนัสเติมให้สม่ำเสมอตั้งแต่ก้าวแรกที่สมัครจนถึงการเล่นรายวัน • ฝากถอนออโต้ด้วยตัวเอง เงินเข้าบัญชีตรงเป๊ะในเวลาอันสั้น ไม่ต้องรอทีมงานอนุมัติ";

const faqs = [
  {
    q: "249UP มีค่ายเกมให้เลือกเล่นครบแค่ไหน",
    a: "พอกดเข้ามาหน้าเว็บ 249UP คุณจะเห็นเลยว่ารวมเอาค่ายเกมชั้นนำมารวมไว้แบบครบครัน คัดมาเฉพาะเกมที่ขึ้นชื่อเรื่องภาพสวย แตกง่าย และมีเอกลักษณ์เฉพาะตัว ทำให้การเปิดหน้าเกมแต่ละครั้งเต็มไปด้วยตัวเลือกน่าเล่นทั้งนั้น ไม่ต้องมานั่งสุ่มเสี่ยงกับเกมไร้คุณภาพ เพราะทุกค่ายตระเตรียมมาให้ผู้เล่นได้สัมผัสความมันส์กันอย่างเต็มที่",
  },
  {
    q: "อยากสลับค่ายเปลี่ยนแนวเกมบ่อยๆ ต้องเสียเวลาหาเกมนานไหม",
    a: "การจัดวางระบบของ 249UP ออกแบบมาเพื่อให้ใช้งานง่ายและรวดเร็วสุดๆ คุณสามารถสลับค่ายเกมเปลี่ยนบรรยากาศได้ทันทีที่ต้องการ เมนูจัดหมวดหมู่อย่างเป็นระเบียบ อยากเปลี่ยนแนวจากสล็อตสายลุยไปเล่นแนวสบายตา ก็ทำได้ทันทีโดยไม่ต้องผ่านหลายขั้นตอน ประหยัดเวลาค้นหา ให้คุณเอาเวลาไปโฟกัสกับการปั่นทำกำไรได้แบบต่อเนื่อง",
  },
  {
    q: "ฟีเจอร์ในเกมของ 249UP มีอะไรบ้างที่ช่วยเพิ่มจังหวะลุ้น",
    a: "การเล่นสล็อตที่ 249UP จะไม่น่าเบื่ออีกต่อไป เพราะตัวเกมมีฟีเจอร์เด็ดๆ คอยช่วยเพิ่มความตื่นเต้นตลอดเวลา ไม่ว่าจะเป็นระบบคูณเงินรางวัล ฟีเจอร์ซื้อฟรีสปิน หรือตัวคูณแบบสุ่มที่โผล่มาถูกจังหวะ เพิ่มมิติการลุ้นมากกว่าแค่การนั่งมองวงล้อหมุนเฉยๆ ยิ่งปั่นยิ่งลุ้นสนุกจนหยุดไม่ได้แน่นอน",
  },
  {
    q: "เข้ามาเล่นบ่อยๆ จะเจอแต่เกมเดิมจนเบื่อหรือเปล่า",
    a: "ล็อบบี้เกมของ 249UP มีการอัปเดตบรรยากาศและรายการเกมใหม่อยู่เสมอ นอกจากจะมีเกมฮิตระดับตำนานที่ทุกคนต้องเล่นติดไว้แล้ว ยังมีเกมใหม่ๆ นอกกระแสที่แจ็คพอตดีรอให้คุณเข้าไปค้นพบอยู่อีกเพียบ ไม่ว่าจะเข้ามาเล่นช่วงไหนก็มีอะไรใหม่ๆ ให้ลองสัมผัส ไม่เจอปัญหาความจำเจจนไม่อยากเล่นแน่นอน",
  },
  {
    q: "ฝากถอนกับ 249UP ต้องรอทีมงานอนุมัตินานไหม",
    a: "เล่นได้เท่าไหร่ก็ถอนออกมาใช้ได้ทันทีด้วยระบบการเงินของ 249UP ที่เน้นความรวดเร็วและแม่นยำ ทุกรายการฝากถอนทำได้ด้วยตัวเองแบบออโต้ เงินเข้าบัญชีตรงเป๊ะในเวลาอันสั้น ไม่ต้องนั่งรอทีมงานอนุมัตินานให้เสียอารมณ์ ให้คุณมั่นใจได้เต็มร้อยในเรื่องความปลอดภัย เล่นได้เท่าไหร่จ่ายเต็มจำนวนแบบไร้กังวล",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxPremium as="h1" title="249UP เว็บสล็อตฟอร์มตึง เกมแน่นค่ายครบเครื่อง โบนัสมาไม่มีแผ่ว">
    <p class="text-left text-base leading-relaxed">
      อยากเล่นสล็อตแบบไม่ต้องเสียอารมณ์กับเว็บเดิมๆ ต้องจัดที่ 249UP เว็บสล็อตที่กำลังถูกพูดถึงมากที่สุดในตอนนี้ ด้วยความตึงของระบบและค่ายเกมที่ขนมาให้เลือกเล่นแบบอัดแน่น
      ไม่ว่าจะเป็นสายปั่นเพื่อความสนุกหรือสายล่าแตกหนัก ที่นี่ตอบโจทย์ได้หมดด้วยจังหวะการเล่นที่ลื่นไหล พร้อมแจกโบนัสกันแบบไม่พัก เล่นได้เพลินๆ ไม่มีดรอป
      ใครได้ลองเข้ามาปั่นแล้วบอกเลยว่าต้องกลับมาซ้ำแน่นอน
    </p>
  </ContentBoxPremium>

  <SmoothCarousel />

  <ContentBoxSevenThreePremium as="h2" title="249UP เว็บสล็อตฟอร์มตึง เกมแน่นค่ายครบเครื่อง เปิดมาทีมีแต่ตัวน่าเล่น">
    <Picture
      slot="left"
      src={imgClassicGames}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์เกมของ 249UP ข้อความ เกมส์คลาสสิคในตำนาน เป่า ยิง ฉุบ เล่นง่ายได้จริง! พร้อมไอคอนเหรียญทองสามเหรียญเป็นรูปมือค้อน กรรไกร และกระดาษ ภาพหญิงสาวชุดดำยืนข้างวงล้อรูเล็ตและกองเหรียญทอง มีโลโก้ 249UP กับไลน์ไอดี @249UP บนพื้นดำลายทอง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#f5b626]/35 shadow-[0_10px_30px_rgba(245,182,38,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      พอกดเข้ามาหน้าเว็บ 249UP คุณจะเห็นเลยว่ารวมเอาค่ายเกมชั้นนำมารวมไว้แบบครบครัน คัดมาเฉพาะเกมที่ขึ้นชื่อเรื่องภาพสวย แตกง่าย และมีเอกลักษณ์เฉพาะตัว
      ทำให้การเปิดหน้าเกมแต่ละครั้งเต็มไปด้วยตัวเลือกน่าเล่นทั้งนั้น ไม่ต้องมานั่งสุ่มเสี่ยงกับเกมไร้คุณภาพ เพราะทุกค่ายตระเตรียมมาให้ผู้เล่นได้สัมผัสความมันส์กันอย่างเต็มที่
    </p>
  </ContentBoxSevenThreePremium>

  <ProviderGrid />

  <ContentBoxTwoFloatingBadge as="h2" title="เข้าเมนูไว สลับค่ายคล่อง จะเปลี่ยนฟีลกี่รอบก็ไม่ต้องเสียเวลาหาเกม">
    <p slot="left" class="text-left text-base leading-relaxed">
      การจัดวางระบบของ 249UP ออกแบบมาเพื่อให้ใช้งานง่ายและรวดเร็วสุดๆ คุณสามารถสลับค่ายเกมเปลี่ยนบรรยากาศได้ทันทีที่ต้องการ เมนูจัดหมวดหมู่อย่างเป็นระเบียบ
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      อยากเปลี่ยนแนวจากสล็อตสายลุยไปเล่นแนวสบายตา ก็ทำได้ทันทีโดยไม่ต้องผ่านหลายขั้นตอน ประหยัดเวลาค้นหา ให้คุณเอาเวลาไปโฟกัสกับการปั่นทำกำไรได้แบบต่อเนื่อง
    </p>
  </ContentBoxTwoFloatingBadge>

  <LoginRtpSection />

  <ContentBox3ThreePremium as="h2" title="ฟีเจอร์มีของใน 249UP คัดลูกเล่นเด็ดมาเพิ่มจังหวะสนุกให้มากกว่าแค่หมุน">
    <p slot="left" class="text-left text-base leading-relaxed">การเล่นสล็อตที่ 249UP จะไม่น่าเบื่ออีกต่อไป เพราะตัวเกมมีฟีเจอร์เด็ดๆ คอยช่วยเพิ่มความตื่นเต้นตลอดเวลา</p>
    <p slot="center" class="text-left text-base leading-relaxed">ไม่ว่าจะเป็นระบบคูณเงินรางวัล ฟีเจอร์ซื้อฟรีสปิน หรือตัวคูณแบบสุ่มที่โผล่มาถูกจังหวะ</p>
    <p slot="right" class="text-left text-base leading-relaxed">เพิ่มมิติการลุ้นมากกว่าแค่การนั่งมองวงล้อหมุนเฉยๆ ยิ่งปั่นยิ่งลุ้นสนุกจนหยุดไม่ได้แน่นอน</p>
  </ContentBox3ThreePremium>

  <ContentBoxSpecial as="h2" title="ล็อบบี้ไม่จำเจ เกมฮิตมี เกมน่าลองก็มา พร้อมตัวเลือกใหม่ให้ค้นต่อเรื่อย ๆ">
    <p slot="left" class="text-left text-base leading-relaxed">
      ล็อบบี้เกมของ 249UP มีการอัปเดตบรรยากาศและรายการเกมใหม่อยู่เสมอ นอกจากจะมีเกมฮิตระดับตำนานที่ทุกคนต้องเล่นติดไว้แล้ว ยังมีเกมใหม่ๆ นอกกระแสที่แจ็คพอตดีรอให้คุณเข้าไปค้นพบอยู่อีกเพียบ
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      ไม่ว่าจะเข้ามาเล่นช่วงไหนก็มีอะไรใหม่ๆ ให้ลองสัมผัส ไม่เจอปัญหาความจำเจจนไม่อยากเล่นแน่นอน
    </p>
  </ContentBoxSpecial>

  <GameRankingBoard />

  <ContentBoxSevenThree as="h2" title="โบนัสมาไม่มีแผ่ว เพราะ 249UP เติมความคุ้มให้มีอะไรน่าตามตลอดการเล่น">
    <Picture
      slot="left"
      src={imgWeeklyCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่นของ 249UP ข้อความ เล่นเสีย ไม่ต้องเสียใจ คืนยอดเสีย ทุกสัปดาห์ สูงสุด 5,000,000 บาท ภาพหญิงสาวชุดราตรีสีทองยืนข้างกองทองคำแท่ง มีโลโก้ 249UP กับไลน์ไอดี @249UP บนพื้นดำลายทอง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#f5b626]/35 shadow-[0_10px_30px_rgba(245,182,38,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      เรื่องความคุ้มค่า 249UP พร้อมซัพพอร์ตผู้เล่นในทุกระดับด้วยโปรโมชันและโบนัสที่เติมให้อย่างสม่ำเสมอ ตั้งแต่ก้าวแรกที่สมัครเข้ามาจนถึงการเล่นรายวัน
