---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBox3ThreeNeumorphism from "../components/ContentBox3ThreeNeumorphism.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBox from "../components/ContentBox.astro";
import ProviderGrid from "../components/ProviderGridPremium.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgDailyCashback from "../assets/slide4.png";
import imgNewMemberBonus from "../assets/slide1.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxNeumorphism as="h1"
//   2 → ContentBoxCyberCut as="h2"
//   3 → ContentBox3ThreeNeumorphism as="h2" (แบ่งย่อหน้าเดียวลง left/center/right ที่รอยต่อประโยค)
//   4 → ContentBoxSevenThreeNeumorphism as="h2" + slide4 (คืนยอดเสีย 5% ทุกวัน)
//   5 → ContentBoxSevenThree as="h2" + slide1 (โปรสมาชิกใหม่ ฝากรับเพิ่มทันที 100%)
//   6 → ContentBoxTwoCyberCut as="h2" (แบ่งย่อหน้าเดียวลง left/right)
//   7 → ContentBox as="h2" (การ์ดกลางที่ terms/privacy ใช้ร่วม)
//
// variant รอบนี้หมุนทั้งตระกูลจากแบรนด์ก่อนหน้า (BOOST168 ใช้ Premium ×3 +
// SevenThreeCyberCut + TwoFloatingBadge + Special + plain) มาเป็น Neumorphism ×3 +
// CyberCut ×2 + plain ×2 ส่วน Navbar ย้ายจาก NavbarStyle7 มาเป็น NavbarPremium,
// Footer จาก FooterStyle3 มาเป็น FooterPremiumSumo, Announcement จาก Announcement3
// มาเป็น AnnouncementPremium, LatestWinners จาก LatestWinners2 มาเป็น
// LatestWinners4, Faq จาก Faq2 มาเป็น Faq3 และ ProviderGrid จากตัวธรรมดามาเป็น
// ProviderGridPremium
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook — slide4 (คืนยอดเสีย 5% ทุกวัน) คู่
// กับหัวข้อแจ็คพอตแตกทุกวันที่พูดเรื่องโอกาสทำกำไรที่เปิดกว้าง และ slide1 (โปร
// สมาชิกใหม่ ฝากรับเพิ่มทันที 100%) คู่กับหัวข้อโปรมีให้ตามหลายจังหวะ ส่วน slide2
// (แนะนำเพื่อน) กับ slide3 (สะสมเพชร) ไม่ถูก import ในไฟล์นี้ — ทั้งคู่ยังขึ้นใน
// SmoothCarousel และหน้า /promotion อยู่ เช่นเดียวกับ banner.png และ banner2/3/4
// ที่เป็นอาร์ตค้างของแบรนด์ก่อนๆ ซึ่งห้ามแตะ — รูปที่ import คือรูปที่ถูก emit
// ถึงจะไม่มีใคร render ก็ตาม
//
// banner1 เป็น hero ที่ MainLayout จัดการเอง รอบนี้จึงไม่มีรูปประกอบใน ContentBox
// เดี่ยว
//
// widget ที่ไม่ได้มาจาก docx (ProviderGrid, GameRankingBoard, LatestWinners,
// LoginRtpSection, ReviewCardSumo2, SmoothCarousel, แถวปุ่ม login/register, FAQ)
// ใช้ป้ายเป็น <p>/<span> + aria-label บน <section> และถูกวางต่อท้ายหัวข้อ docx
// ข้อสุดท้ายทั้งชุด จึงไม่มีตัวไหนคั่นระหว่างหัวข้อ docx สองข้อเลย
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx + หัวข้อ FAQ ที่หน้านี้ส่งเป็น prop = 7
// คำถามใน Faq3 เป็น <span> ใน <summary> ไม่ใช่ h3 และป้ายคอลัมน์ของ
// ContentBox3ThreeNeumorphism / ContentBoxSevenThree* / ContentBoxTwoCyberCut
// เป็น <p> — docx รอบนี้แบน H1 + H2 ล้วน หน้านี้จึงไม่มี h3 เลย
const pageTitle = "AURORA688 | เว็บสล็อตฟีลดี รวมเกมฮิตติดแสง แจ็คพอตแตกทุกวัน";
// คำอธิบายยาว 160 ตัวอักษร อยู่ในเกท 150–160 ของ verify-build พอดี ใช้ตรงๆ ไม่ต้อง
// ขยายหรือตัด และเป็นสตริงเดียวกับที่ส่งเข้า pageGraph
const pageDescription = "AURORA688 เว็บสล็อตฟีลดี อัดเกมกว่า 1,000+ รวมเกมฮิตติดแสงและตัวน่าลอง แจ็คพอตแตกทุกวัน โปรมีให้ตามหลายจังหวะ ระบบออโต้ฝากถอนพร้อมรับทุกช่วงเวลา ตลอด 24 ชั่วโมง";

// default message ของ Announcement ทุก variant คือสโลแกนของแบรนด์เก่าคนละเจ้ากัน
// จึงส่ง message ตรงๆ เสมอ ไม่พึ่ง default และห้ามขึ้นต้นด้วย emoji เพราะ marquee
// render ข้อความซ้ำและ emoji ที่ฝังในสตริงถูก mark aria-hidden ไม่ได้
const announcementMessage =
  "AURORA688 เว็บสล็อตฟีลดี รวมเกมฮิตติดแสง แจ็คพอตแตกทุกวัน • เปิดคลังเกมสล็อตชั้นนำกว่า 1,000+ เกมจากค่ายยักษ์ใหญ่ทั่วโลก ครบทั้งแนวแฟนตาซีตระการตา แอ็กชันสุดมันส์ และสตรีทสุดเท่ • ล็อบบี้จัดวางเป็นระเบียบ วางเกมฮิตติดแสงระดับตำนานไว้ข้างเกมใหม่มาแรงนอกกระแสที่ซ่อนโบนัสเด็ดเอาไว้เพียบ • แจ็คพอตและรอบโบนัสกระจายอยู่ในทุกเกมในคลัง ไม่ได้มีแค่ในเกมยอดนิยม ทุกวันคือโอกาสใหม่ที่พร้อมสุ่มแจกโบนัส • โปรมีให้ตามหลายจังหวะ ทั้งสิทธิประโยชน์ต้อนรับสมาชิกใหม่ โบนัสเติมเงินประจำวัน และเครดิตพิเศษตามเทศกาล • ระบบออโต้พร้อมรับทุกช่วงเวลา ฝากถอนเองได้ภายในไม่กี่วินาที ไม่ต้องส่งสลิปยืนยัน ไม่ต้องรอแอดมินอนุมัติ • จาก 1,000+ เกมถึงระบบออโต้ AURORA688 รวมทุกฟีลไว้ให้จบในที่เดียวตลอด 24 ชั่วโมง";

// FAQ ห้าข้อเขียนจากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้าไหนมา
// ทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบคำถาม
// ที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน
const faqs = [
  {
    q: "AURORA688 มีเกมให้เลือกมากแค่ไหน และมาจากค่ายไหนบ้าง",
    a: "คลังเกมสล็อตเปิดไว้มากกว่า 1,000+ เกมจากค่ายยักษ์ใหญ่ทั่วโลก ครอบคลุมทั้งแนวแฟนตาซีตระการตา แอ็กชันสุดมันส์ และแนวสตรีทสุดเท่ ทุกเกมผ่านการคัดมาแล้วว่าภาพสวย กราฟิกอลังการ และอัตราการจ่ายรางวัลคุ้มค่า ผู้เล่นจึงค้นหาเกมที่ใช่และสลับฟีลการเล่นได้ทุกวันโดยไม่ต้องทนเล่นเกมเดิมจนเบื่อ",
  },
  {
    q: "ในหน้าล็อบบี้ของ AURORA688 มีเกมแบบไหนซ่อนอยู่บ้าง",
    a: "หน้าล็อบบี้จัดวางเกมไว้อย่างเป็นระเบียบและลงตัว มีทั้งเกมฮิตติดแสงระดับตำนานที่ทุกคนต้องรู้จัก วางอยู่ข้างเกมใหม่มาแรงน่าลองนอกกระแสที่ซ่อนโบนัสเด็ดๆ เอาไว้เพียบ อยากลองค้นหาฟีเจอร์แปลกใหม่หรือจะไปปั่นเกมตัวตึงทำเงินก็เลือกได้ทันใจในหน้าเดียว ไม่ต้องไล่หาข้ามหลายหน้าจอ",
  },
  {
    q: "แจ็คพอตของที่นี่มีเฉพาะในเกมยอดนิยมหรือเปล่า",
    a: "ไม่ใช่เลย รอบโบนัสและแจ็คพอตไม่ได้ซ่อนอยู่แค่ในเกมยอดนิยม แต่กระจายอยู่ในทุกๆ เกมในคลัง ไม่ว่าจะเลือกหมุนเกมไหนก็มีจังหวะให้ได้ลุ้นรางวัลใหญ่อยู่เสมอ ทุกวันจึงเป็นโอกาสใหม่ที่พร้อมสุ่มแจกโบนัสให้ผู้เล่นได้รับความฟินกลับไปแบบจัดเต็ม",
  },
  {
    q: "โปรโมชันและกิจกรรมของ AURORA688 มีให้กดรับตอนไหนบ้าง",
    a: "โปรมีให้ตามหลายจังหวะจนการเล่นไม่น่าเบื่อ ทั้งสิทธิประโยชน์ต้อนรับสมาชิกใหม่ โบนัสเติมเงินประจำวัน และเครดิตพิเศษตามเทศกาล ทุกรายการถูกดีไซน์มาเพื่อเพิ่มทุนให้ปั่นสนุกขึ้น ยืดเวลาความเพลิดเพลิน และเพิ่มโอกาสพิชิตโบนัสได้คุ้มค่ากว่าเดิม ควรอ่านเงื่อนไขของแต่ละสิทธิ์ก่อนกดรับทุกครั้ง",
  },
  {
    q: "ฝากถอนกับระบบออโต้ต้องส่งสลิปหรือรอแอดมินอนุมัติไหม",
    a: "ไม่ต้องทั้งสองอย่าง ระบบออโต้พร้อมให้บริการตลอด 24 ชั่วโมง จะทำรายการฝากเงินเพื่อเข้าลุยต่อ หรือกดถอนกำไรก้อนโตเข้าบัญชี ทุกขั้นตอนทำได้ด้วยตัวเองง่ายๆ ภายในไม่กี่วินาที ไม่ต้องส่งสลิปยืนยันและไม่ต้องรอแอดมินอนุมัติให้เสียเวลา จัดการได้คล่องตัวจนเอาเวลาไปโฟกัสกับการปั่นสล็อตได้เต็มที่",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxNeumorphism as="h1" title="AURORA688 เว็บสล็อตฟีลดี รวมเกมฮิตติดแสง แจ็คพอตแตกทุกวัน">
    <p class="text-left text-base leading-relaxed">
      ถ้าคุณอยากเปลี่ยนบรรยากาศการเล่นสล็อตเดิมๆ ให้กลายเป็นความฟินทุกครั้งที่กดหมุน ต้องมาลองสัมผัสที่ AURORA688 เว็บสล็อตฟีลดีที่รวมทุกความสนุกเอาไว้แบบจัดเต็ม
      โดดเด่นด้วยการคัดสรรเกมฮิตติดแสงกระแสแรง มอบประสบการณ์ปั่นสล็อตที่ลื่นไหล เพลิดเพลิน และเต็มไปด้วยโอกาสลุ้นแจ็คพอตแตกหนักทุกวัน ไม่ว่าจะเป็นสายเล่นชิลๆ เพลินตา หรือสายล่ารางวัลใหญ่
      ที่นี่พร้อมเปิดประตูต้อนรับทุกคนเข้าสู่อาณาจักรความมันส์แบบไม่มีขีดจำกัด
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxCyberCut as="h2" title="AURORA688 เว็บสล็อตฟีลดี เปิดคลังเกมกว่า 1,000+ ตัวเลือกให้ค้นแบบจุใจ">
    <p class="text-left text-base leading-relaxed">
      เรื่องความหลากหลายต้องยกให้ AURORA688 ยืนหนึ่ง เพราะเปิดคลังเกมสล็อตชั้นนำมาให้เลือกสรรมากกว่า 1,000+ เกมจากค่ายยักษ์ใหญ่ทั่วโลก ไม่ว่าจะเป็นแนวแฟนตาซีตระการตา แอ็กชันสุดมันส์ หรือแนวสตรีทสุดเท่
      ทุกเกมถูกคัดมาแล้วว่าภาพสวย กราฟิกอลังการ และที่สำคัญคืออัตราการจ่ายรางวัลคุ้มค่า ให้ผู้เล่นได้ค้นหาเกมที่ใช่ สลับฟีลการเล่นได้ทุกวันแบบไม่มีคำว่าจำเจ
    </p>
  </ContentBoxCyberCut>

  <ContentBox3ThreeNeumorphism
    as="h2"
    title="เกมฮิตติดแสงชนตัวน่าลอง มีอะไรซ่อนอยู่ในล็อบบี้ AURORA688 บ้าง?"
    titleleft="ล็อบบี้ที่จัดวางมาอย่างลงตัว"
    titlecenter="ตำนานชนของใหม่นอกกระแส"
    titleright="เลือกได้ทันใจในหน้าเดียว">
    <p slot="left" class="text-left text-base leading-relaxed">เมื่อก้าวเข้ามาในหน้าล็อบบี้ของ AURORA688 คุณจะได้พบกับพื้นที่ที่จัดวางเกมไว้อย่างเป็นระเบียบและลงตัว</p>
    <p slot="center" class="text-left text-base leading-relaxed">มีทั้งเกมฮิตติดแสงระดับตำนานที่ทุกคนต้องรู้จัก โคจรมาพบกับเกมใหม่มาแรงน่าลองนอกกระแสที่ซ่อนโบนัสเด็ดๆ เอาไว้เพียบ</p>
    <p slot="right" class="text-left text-base leading-relaxed">
      การรวมตัวกันของเกมหลากสไตล์ตรงนี้ช่วยให้ผู้เล่นมีตัวเลือกที่หลากหลาย อยากลองค้นหาฟีเจอร์แปลกใหม่ หรือจะไปปั่นเกมตัวตึงทำเงินก็เลือกได้ทันใจในหน้าเดียว
    </p>
  </ContentBox3ThreeNeumorphism>

  <ContentBoxSevenThreeNeumorphism as="h2" title="แจ็คพอตแตกทุกวัน เปิดอีกมุมความน่าตามที่ไม่ได้มีแค่เกมยอดนิยม" titleleft="คืนยอดเสีย 5% ทุกวัน">
    <Picture
      slot="left"
      src={imgDailyCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 767px) 92vw, 340px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่นพื้นดำทอง ตัวอักษรใหญ่เขียนว่า คืนยอดเสีย 5% ทุกวัน คืนให้ทุกวันไม่มีขั้นต่ำ ถอนได้จริง พร้อมไอคอนสี่ข้อ รับคืนอัตโนมัติทุกวัน 00.00 น. มั่นคงปลอดภัยเชื่อถือได้ 100% ถอนได้จริงไม่มีขั้นต่ำ และเล่นได้ทุกเกมทั้งสล็อตบอลคาสิโน ซ้ายมือเป็นหญิงสาวชุดดำ ล้อมด้วยเหรียญทอง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e2c443]/40 shadow-[0_10px_30px_rgba(226,196,67,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
