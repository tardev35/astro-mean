---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBox3ThreeCyberCut from "../components/ContentBox3ThreeCyberCut.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgLobby from "../assets/slide2.png";
import imgDailyBonus from "../assets/slide1.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxCyberCut as="h1"
//   2 → ContentBoxTwoNeumorphism as="h2" (แบ่งย่อหน้าเดียวลง left/right ที่รอยต่อประโยค)
//   3 → ContentBoxNeumorphism as="h2"
//   4 → ContentBoxSevenThreeCyberCut as="h2" + slide2 (ถอนได้หลักล้าน)
//   5 → ContentBox3ThreeCyberCut as="h2" (แบ่งย่อหน้าลง left/center/right)
//   6 → ContentBoxSevenThreeNeumorphism as="h2" + slide1 (โปรฝากรายวันรับโบนัส 20%)
//   7 → ContentBox as="h2" (การ์ดคอลัมน์เดียวแบบเรียบ สองย่อหน้าห่อใน div เดียว
//       ตามกติกาหนึ่ง element ต่อหนึ่ง slot)
//
// variant รอบนี้เปลี่ยนทั้งตระกูลจากแบรนด์ก่อนหน้า (MACAUBET ใช้ Premium +
// FloatingBadge + Special + 3ThreePremium) มาเป็น CyberCut + Neumorphism + plain
// ส่วน Faq ย้ายจาก Faq4 มาเป็น Faq2
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook — slide2 คู่กับหัวข้อรวมเกมดัง
// ค่ายเด็ดเต็มล็อบบี้ ส่วน slide1 คู่กับหัวข้อฝาก-ถอน 3 วิ ที่เหลือ slide3/slide4
// เป็นของ SmoothCarousel แต่ละใบมีบ้านเดียวบนหน้าเว็บ ส่วน banner.png กับ
// banner2/3/4 เป็นอาร์ตค้างของแบรนด์ก่อนๆ จึงไม่ถูก import ที่ไหน — รูปที่ import
// คือรูปที่ถูก emit ถึงจะไม่มีใคร render ก็ตาม
//
// banner1 เป็น hero ที่ MainLayout จัดการเอง รอบนี้จึงไม่มีรูปประกอบใน ContentBox
// เดี่ยว
//
// widget ที่ไม่ได้มาจาก docx (ProviderGrid, GameRankingBoard, LoginRtpSection,
// SmoothCarousel, LatestWinners, ReviewCardSumo2, แถวปุ่ม login/register) ใช้ป้าย
// เป็น <p>/<span> + aria-label บน <section> จึงวางต่อท้ายหัวข้อ docx ที่มันสังกัด
// ได้โดยลำดับ h2 ไม่เพี้ยน — GameRankingBoard ต่อจากหัวข้อฟีเจอร์ดุครบเครื่อง,
// ProviderGrid ต่อจากหัวข้อรวมเกมดังค่ายเด็ด, LoginRtpSection ต่อจากหัวข้อระบบใหม่
// ทำอะไรได้ไวขึ้น, LatestWinners ต่อจากหัวข้อฝาก-ถอน 3 วิ, ReviewCardSumo2 ต่อจาก
// หัวข้อสรุป แล้วปิดท้ายด้วย SmoothCarousel + แถวปุ่ม + FAQ
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx + หัวข้อ FAQ ที่หน้านี้เขียนเอง = 7
// คำถามใน Faq2 เป็น <span> ใน <summary> ไม่ใช่ h3 — docx รอบนี้แบน H1+H2 ล้วน
// หน้านี้จึงไม่มี h3 เลย

// Title กับ Des มาจาก docx ตรงตัว แก้คำสะกดผิดใน docx สองจุดแล้ว:
// เร็วแรว → เร็วแรง, ค่านเด็ด → ค่ายเด็ด
//
// Des ของ docx ยาว 145 ตัวอักษร ต่ำกว่าช่วง 150–160 ที่ verify-build บังคับ
// (นับ "ตัวอักษร" ไม่ใช่ไบต์ — ไทยตัวละ 3 ไบต์ wc -c จึงอ่านเกินจริงสามเท่า)
// จึงเติมสองคำที่มาจากเนื้อ docx เองคือ "ครบ" กับ "ออโต้" ได้ 153 ตัวอักษร
const pageTitle = "DRACO65 | สล็อตเว็บตรงไฟลุก ฟีเจอร์ดุครบเครื่อง ฝาก-ถอน 3 วิ";
const pageDescription =
  "DRACO65 สล็อตเว็บตรงไฟลุก ระบบอัปเดตใหม่เร็วแรงกว่าเดิม ฟีเจอร์ดุครบเครื่อง รวมเกมดังค่ายเด็ดยอดฮิตมาให้ครบ พร้อมฝาก-ถอนออโต้ 3 วิ ไม่ต้องรอให้เสียจังหวะ";

// default message ของ Announcement ทุก variant คือสโลแกนของแบรนด์เก่าคนละเจ้ากัน
// จึงส่ง message ตรงๆ เสมอ ไม่พึ่ง default และห้ามขึ้นต้นด้วย emoji
const announcementMessage =
  "DRACO65 สล็อตเว็บตรงไฟลุก ฟีเจอร์ดุครบเครื่อง ฝาก-ถอน 3 วิ ปั่นได้แบบไม่มีจังหวะให้อารมณ์ค้าง • อัปเดตระบบใหม่ล่าสุด เสถียรและตอบสนองไวกว่าที่เคย หน้าเว็บโหลดฉับไว กราฟิกไหลลื่นไม่มีกระตุก • ฟีเจอร์แตกหนักครบครัน ทั้งฟรีสปินออกบ่อย ตัวคูณรางวัลระเบิดแจ็คพอต และสัญลักษณ์พิเศษเข้ารอบโบนัสง่ายกว่าเดิม • ล็อบบี้อัดแน่นด้วยค่ายชั้นนำระดับโลก คัดเฉพาะเกมตัวตึง เกมฮิตติดเทรนด์ และเกมแตกดี กดเลือกลุยต่อได้ทันที • ระบบเบื้องหลังเชื่อมเซิร์ฟเวอร์หลักโดยตรง สลับค่ายเกมไว ตัดยอดแม่นยำ ไม่ต้องเจอกดสปินแล้วค้าง • ฝาก-ถอนออโต้ไฮสปีดจัดการยอดเสร็จภายใน 3 วิ ทำเองได้ ไม่ต้องรอแอดมินอนุมัติ เงินเข้าตรงเป๊ะทุกบาททุกสตางค์ • เกมถึง ฟีเจอร์ดุ ระบบแรง ครบเครื่องสำหรับสายสล็อตยุคใหม่ ลองเข้ามาปั่นแล้วจะอยากบอกต่อเพื่อน";

// FAQ ห้าข้อเขียนจากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้าไหนมา
// ทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบคำถาม
// ที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน
const faqs = [
  {
    q: "ระบบใหม่ของ DRACO65 ต่างจากของเดิมตรงไหน",
    a: "ระบบถูกยกเครื่องใหม่ทั้งชุดให้มีความเสถียรและตอบสนองได้ไวกว่าที่เคย หน้าเว็บโหลดรวดเร็วฉับไว กราฟิกสีสันสดใสไหลลื่นไม่มีกระตุกตั้งแต่คลิกแรก และไม่ว่าจะเข้าใช้งานผ่านมือถือหรือคอมพิวเตอร์ก็พร้อมลุยได้อย่างราบรื่นเหมือนกัน",
  },
  {
    q: "ฟีเจอร์ในเกมของ DRACO65 มีอะไรช่วยเพิ่มโอกาสทำกำไรบ้าง",
    a: "แต่ละเกมรวมลูกเล่นซัพพอร์ตการทำกำไรไว้ครบครัน ทั้งโหมดฟรีสปินที่ออกบ่อย ตัวคูณรางวัลที่พร้อมระเบิดแจ็คพอตอย่างต่อเนื่อง และสัญลักษณ์พิเศษที่ช่วยให้เข้าถึงรอบโบนัสได้ง่ายกว่าเดิม ทุกจังหวะการหมุนจึงมีโอกาสเปลี่ยนเบทเบาๆ ให้เป็นกำไรก้อนใหญ่",
  },
  {
    q: "ในล็อบบี้ของ DRACO65 มีเกมจากค่ายไหนให้เลือกบ้าง",
    a: "ล็อบบี้อัดแน่นไปด้วยค่ายชั้นนำระดับโลก คัดมาเฉพาะเกมตัวตึง เกมฮิตติดเทรนด์ และเกมแตกดีที่ไม่ควรพลาด ไม่ว่าจะชอบสไตล์ไหนหรือคอนเซปต์ไหนก็มีตัวเลือกให้สลับสับเปลี่ยนเล่นได้ไม่มีเบื่อ อยากเปลี่ยนฟีลเมื่อไหร่ก็กดเลือกเกมใหม่แล้วลุยต่อได้ทันที",
  },
  {
    q: "ฝาก-ถอนกับ DRACO65 ใช้เวลานานไหม ต้องรอแอดมินอนุมัติหรือเปล่า",
    a: "ระบบฝาก-ถอนออโต้ไฮสปีดจัดการยอดเงินเสร็จสรรพภายใน 3 วินาที ทำได้ง่ายๆ ด้วยตัวเอง ไร้ขั้นตอนซับซ้อน และไม่ต้องรอแอดมินอนุมัติ ไม่ว่าจะเป็นการเติมทุนเพื่อลุยต่อหรือถอนกำไรก้อนโตเข้าบัญชี เงินก็เข้าตรงเป๊ะทุกบาททุกสตางค์",
  },
  {
    q: "กดสปินแล้วค้างหรือต้องรีโหลดหน้าเว็บบ่อยไหม",
    a: "ระบบเบื้องหลังถูกพัฒนาให้ประมวลผลได้อย่างฉับไว ทั้งการสลับเปลี่ยนค่ายเกม การตัดยอดเงินที่แม่นยำ และการเชื่อมต่อเซิร์ฟเวอร์หลักโดยตรง ผู้เล่นจึงปั่นเกมต่อกันได้อย่างลื่นไหล ไม่ต้องเจอปัญหากดสปินแล้วค้าง หรือคอยรีโหลดหน้าเว็บใหม่ให้เสียเวลา",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxCyberCut as="h1" title="DRACO65 สล็อตเว็บตรงไฟลุก ฟีเจอร์ดุครบเครื่อง ฝาก-ถอน 3 วิ">
    <p class="text-left text-base leading-relaxed">
      พร้อมหรือยังที่จะสัมผัสความเดือดระดับปะทุกับ DRACO65 เว็บสล็อตตรงสายลุยที่จัดเต็มความมันส์แบบไม่มีออมมือ ยุคนี้การเล่นสล็อตต้องเร็ว ต้องแรง และต้องลุ้นสนุกทุกวินาที
      ที่นี่เลยรวมเอาความเพียบพร้อมในทุกมิติมาเสิร์ฟให้ถึงมือ ทั้งระบบการประมวลผลที่ไวฟ้าผ่า ฟีเจอร์ตัวช่วยแตกหนักที่ดุดันเกินใคร และระบบการเงินที่รวดเร็วทันใจ ปั่นแล้วฟีลดี
      ลุ้นรางวัลใหญ่ได้แบบต่อเนื่อง ไม่มีจังหวะให้อารมณ์ค้างแน่นอน
    </p>
  </ContentBoxCyberCut>

  <ContentBoxTwoNeumorphism as="h2" title="DRACO65 สล็อตเว็บตรงไฟลุก เปิดระบบอัปเดตใหม่ที่เร็วแรงกว่าเดิม">
    <p slot="left" class="text-left text-base leading-relaxed">
      ยกระดับความตื่นเต้นขึ้นไปอีกขั้นกับการอัปเดตระบบใหม่ล่าสุดของ DRACO65 ที่ถูกยกเครื่องให้มีความเสถียรและตอบสนองได้ไวกว่าที่เคย หน้าเว็บโหลดรวดเร็วฉับไว กราฟิกสีสันสดใสไหลลื่นไม่มีกระตุก
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      ให้ผู้เล่นได้สัมผัสบรรยากาศความสนุกสุดเอ็กซ์คลูซีฟตั้งแต่คลิกแรก ไม่ว่าจะเข้าใช้งานผ่านอุปกรณ์ไหนก็พร้อมลุยได้อย่างราบรื่น สมกับเป็นเว็บตรงสล็อตไฟลุกแห่งยุคอย่างแท้จริง
    </p>
  </ContentBoxTwoNeumorphism>

  <ContentBoxNeumorphism as="h2" title="ฟีเจอร์ดุครบเครื่อง ลูกเล่นเด็ดพร้อมเติมไฟให้ทุกจังหวะการสปิน">
    <p class="text-left text-base leading-relaxed">
      จุดเด่นที่ทำให้เหล่านักปั่นต้องยกนิ้วให้ DRACO65 คือความดุดันของฟีเจอร์ในแต่ละเกม ที่รวมเอาลูกเล่นซัพพอร์ตการทำกำไรมาให้แบบครบครัน ทั้งโหมดฟรีสปินออกบ่อย
      ตัวคูณรางวัลที่พร้อมระเบิดแจ็คพอตอย่างต่อเนื่อง และสัญลักษณ์พิเศษที่ช่วยให้เข้าถึงรอบโบนัสได้ง่ายกว่าเดิม ทุกจังหวะในการหมุนจึงเต็มไปด้วยความลุ้นระทึก เพิ่มโอกาสเปลี่ยนเบทเบาๆ
      ให้กลายเป็นกำไรก้อนใหญ่ได้เสมอ
    </p>
  </ContentBoxNeumorphism>

  <GameRankingBoard />

  <ContentBoxSevenThreeCyberCut as="h2" title="รวมเกมดังค่ายเด็ด DRACO65 ตัวฮิตตัวท็อปพร้อมให้เลือกเต็มล็อบบี้">
    <Picture
      slot="left"
      src={imgLobby}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น DRACO65 ข้อความ ครบจบในเจ้าเดียว การดีดจากค่ายเกมโดยตรงทุนหนากล้าจ่าย ถอนได้หลักล้าน พร้อมบรรทัดเกมสล็อต บาคาร่า คาสิโน ไฮโล หวย กีฬา ด้านบนเป็นโลโก้ DRACO 65 ตัวอักษรโครเมียมคู่กับป้าย truemoney ด้านซ้ายเป็นหญิงสาวชุดเขียวกับลูกเต๋าสีเขียว ด้านขวาเป็นมือถือที่เปิดล็อบบี้เกมสล็อตและวงล้อรูเล็ต บนพื้นเขียวเข้มลายสัญลักษณ์ไพ่"
      class="mx-auto h-auto w-full rounded-2xl border border-[#22c55e]/35 shadow-[0_10px_30px_rgba(34,197,94,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      เปิดเข้ามาในหน้าล็อบบี้ของ DRACO65 คุณจะได้พบกับอาณาจักรเกมสล็อตที่อัดแน่นไปด้วยค่ายชั้นนำระดับโลก คัดมาเฉพาะเกมตัวตึง เกมฮิตติดเทรนด์ และเกมแตกดีที่ไม่ควรพลาด ไม่ว่าจะชอบสไตล์ไหน คอนเซปต์ไหน
      ที่นี่ก็มีตัวเลือกให้สลับสับเปลี่ยนเล่นกันได้อย่างไม่มีเบื่อ อยากเปลี่ยนฟีลเมื่อไหร่ก็แค่กดเลือกเกมใหม่ ลุยต่อได้ทันทีโดยไม่ต้องเสียเวลาค้นหานาน
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ProviderGrid />

  <ContentBox3ThreeCyberCut
    as="h2"
    title="ระบบใหม่ของ DRACO65 ทำอะไรได้ไวขึ้น ถึงเล่นต่อได้แบบไม่สะดุดฟีล?"
    titleleft="ระบบเบื้องหลังฉับไว"
    titlecenter="ปั่นต่อได้ลื่นไหล"
    titleright="รักษาจังหวะทำกำไร">
    <p slot="left" class="text-left text-base leading-relaxed">
