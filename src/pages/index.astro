---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement6.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners from "../components/LatestWinners.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgFirstDepositBonus from "../assets/slide2.png";
import imgDailyCashback from "../assets/slide1.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxPremium as="h1"
//   2 → ContentBoxSevenThreeCyberCut as="h2" + slide2 แล้วต่อด้วย GameRankingBoard
//       และ ProviderGrid
//   3 → ContentBox3ThreePremium as="h2" (แบ่งย่อหน้าเดียวลง left/center/right)
//   4 → ContentBoxSevenThreeNeumorphism as="h2" + slide1
//   5 → ContentBoxCyberCut as="h2"
//   6 → ContentBox as="h2" (การ์ดกลางที่ terms/privacy ใช้ร่วม)
//   7 → ContentBoxNeumorphism as="h2"
//
// variant รอบนี้หมุนทั้งตระกูลจากแบรนด์ก่อนหน้า (LUCKYBKK ใช้ FloatingBadge ×3 +
// SevenThree ธรรมดา ×2 + plain ×1 + Special ×1) มาเป็น Premium + SevenThreeCyberCut
// + 3ThreePremium + SevenThreeNeumorphism + CyberCut + plain + Neumorphism ส่วน
// Navbar ย้ายจาก NavbarStyle9 มาเป็น NavbarStyle10, Footer จาก FooterStyle3 มาเป็น
// Footer.astro, Announcement จาก Announcement5 มาเป็น Announcement6, LatestWinners
// จาก LatestWinners3 มาเป็น LatestWinners.astro, Faq จาก Faq4 มาเป็น Faq.astro และ
// โครงสองคอลัมน์ที่ LoginRtpSection ใช้ย้ายจาก ContentBoxTwoPremium มาเป็น
// ContentBoxTwoCyberCut
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook — slide2 (ฝากแรก รับโบนัส 100% พร้อม
// แถบโลโก้ค่าย PG / Pragmatic Play / Joker / Relax / Habanero / Play'n GO) คู่กับ
// หัวข้อข้อ 2 "จับทุกตัวน่าเล่นมาไว้ครบจบในเว็บเดียว" เพราะแถบค่ายบนรูปคือภาพของ
// การคัดค่ายมาไว้ครบ และ slide1 (คืนยอดเสีย ทุกวัน 30%) คู่กับหัวข้อข้อ 4
// "โปรถึงโบนัสแรง" ซึ่งเป็นเรื่องโปรโมชันคืนยอดเสียตรงๆ
//
// slide3 กับ slide4 เป็นอาร์ตของแบรนด์ก่อนหน้า และ banner.png กับ banner2/3/4 เป็น
// อาร์ตค้างของแบรนด์ก่อนๆ ทั้งชุด จึงห้าม import ที่ไหนทั้งสิ้น — รูปที่ import คือ
// รูปที่ถูก emit ถึงจะไม่มีใคร render ก็ตาม ส่วน banner1 เป็น hero ที่ MainLayout
// จัดการเอง รอบนี้จึงไม่มีรูปประกอบใน ContentBox เดี่ยว
//
// widget ที่ไม่ได้มาจาก docx (LatestWinners, LoginRtpSection, ReviewCardSumo2,
// SmoothCarousel, แถวปุ่ม login/register, FAQ) ใช้ป้ายเป็น <p>/<span> + aria-label
// บน <section> และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้ายทั้งชุด ยกเว้น GameRankingBoard
// กับ ProviderGrid ที่เป็นภาพประกอบของหัวข้อ docx ข้อ 2 โดยตรง (เกมและค่ายที่คัดมา)
// จึงวางต่อท้ายบล็อกนั้น ไม่มีตัวไหนคั่นระหว่างหัวข้อ docx สองข้อ
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx พอดี ไม่มีตัวที่เจ็ด — หัว FAQ ถูกลดเป็น <p>
// ใน Faq.astro (ชื่อ section ย้ายไป aria-label) คำถามใน Faq เป็น <span> ใน <summary>
// ไม่ใช่ h3 บรรทัดหัวของ LatestWinners เป็น <p> และป้ายคอลัมน์ของ
// ContentBox3ThreePremium / SevenThree ทั้งสองตัว / ContentBoxTwoCyberCut เป็น <p>
// — docx รอบนี้แบน H1 + H2 ล้วน หน้านี้จึงไม่มี h3 เลย
const pageTitle = "PABO88 | เว็บสล็อตคัดของดี เกมเด็ดเกินเรื่อง โปรถึงโบนัสแรง ถอนไว";
// บรรทัด Des ของ docx ยาว 145 ตัวอักษร ต่ำกว่าเกท 150–160 ของ verify-build จึงขยาย
// วรรคที่สองจาก "มาให้ครบในเว็บเดียว" เป็น "รวมตัวเด็ดแตกง่ายไว้ครบในเว็บเดียว" ตาม
// คำในย่อหน้าแรกของ docx เอง ได้ 157 ตัวอักษร ทุกวรรคอื่นคงคำเดิมของ docx ไว้ และ
// เป็นสตริงเดียวกับที่ส่งเข้า pageGraph
const pageDescription = "PABO88 เว็บสล็อตคัดของดี รวมตัวเด็ดแตกง่ายไว้ครบในเว็บเดียว เกมเด็ดเกินเรื่อง โปรถึงโบนัสแรง ฟีเจอร์พร้อมเซอร์ไพรส์ ระบบออโต้คล่อง ถอนไวไม่ค้างฟีลตลอดทั้งวัน";

// default message ของ Announcement ทุก variant คือสโลแกนของแบรนด์เก่าคนละเจ้ากัน
// จึงส่ง message ตรงๆ เสมอ ไม่พึ่ง default และห้ามขึ้นต้นด้วย emoji เพราะ marquee
// render ข้อความซ้ำและ emoji ที่ฝังในสตริงถูก mark aria-hidden ไม่ได้ — ข้อความชุดนี้
// ตรงกับ default ของ Announcement6 เป๊ะ เพื่อให้ ticker ของหน้าย่อยที่เรียก
// <Announcement /> เปล่าๆ วิ่งข้อความเดียวกับหน้าแรก
const announcementMessage =
  "PABO88 เว็บสล็อตคัดของดี เกมเด็ดเกินเรื่อง โปรถึงโบนัสแรง ถอนไว • คัดเฉพาะเกมสล็อตคุณภาพสูง อัตราการจ่ายยุติธรรม ธีมน่าสนใจ มารวมไว้ครบจบในเว็บเดียว • งานภาพระดับ HD กราฟิกสีสันสดใส เอฟเฟกต์อลังการ พร้อมอัตราคูณโบนัสก้อนโตที่สุ่มแจกต่อเนื่อง • โบนัสต้อนรับสมาชิกใหม่ สิทธิพิเศษเพิ่มทุนรายวัน และเครดิตคืนยอดเสีย • ฟรีสปินออกบ่อย สัญลักษณ์พิเศษ และตัวคูณสะสมแบบทวีคูณ • ระบบออโต้เต็มรูปแบบ เข้าสู่ระบบ เลือกค่ายเกม และฝากเงินเองได้ในไม่กี่คลิก • ถอนออโต้โอนไว ยอดเข้าตรงเป๊ะ ไม่ต้องรอแอดมินอนุมัติ ตลอด 24 ชั่วโมง";

// FAQ ห้าข้อเขียนจากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้าไหนมา
// ทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบคำถาม
// ที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน
const faqs = [
  {
    q: "PABO88 คัดเกมสล็อตเข้าเว็บด้วยเกณฑ์อะไรบ้าง",
    a: "ทุกเกมถูกคัดกรองมาก่อนเข้าเว็บด้วยสามเกณฑ์ คือคุณภาพของตัวเกม อัตราการจ่ายที่ยุติธรรม และธีมเกมที่น่าสนใจพอจะเล่นได้ยาวๆ ในลิสต์จึงมีทั้งเกมฮิตติดเทรนด์ ค่ายใหญ่นอกกระแส และเกมคลาสสิกที่โบนัสแตกหนัก ผู้เล่นไม่ต้องเสียเวลาโยกเว็บไปมาเพื่อหาเกมโปรดอีกต่อไป",
  },
  {
    q: "โปรโมชันของ PABO88 มีแบบไหนให้เลือกบ้าง",
    a: "โปรโมชันถูกคิดมาเพื่อผู้เล่นทุกระดับ ทั้งโบนัสต้อนรับสมาชิกใหม่ สิทธิพิเศษเพิ่มทุนรายวัน และเครดิตคืนยอดเสีย ทุกกิจกรรมช่วยเติมทุนให้นำไปปั่นสล็อตลุ้นรางวัลได้ยาวนานขึ้น เพิ่มโอกาสเข้าถึงรอบแจ็คพอตใหญ่โดยไม่ต้องแบกรับความเสี่ยงสูงกว่าที่ตั้งใจไว้",
  },
  {
    q: "ในเกมมีฟีเจอร์อะไรที่ช่วยเพิ่มจังหวะทำเงินบ้าง",
    a: "นอกจากตัวเกมที่แตกง่ายแล้ว ยังมีโหมดฟรีสปินที่ออกบ่อยเกินคาด สัญลักษณ์พิเศษที่พร้อมเปลี่ยนเป็นเงินรางวัลใหญ่ และระบบตัวคูณสะสมแบบทวีคูณ ลูกเล่นเหล่านี้ทำให้แต่ละสปินมีความน่าลุ้นและไม่น่าเบื่อ แม้จะนั่งเล่นต่อเนื่องเป็นเวลานานก็ยังมีเซอร์ไพรส์ให้เจอ",
  },
  {
    q: "ฝากเงินกับ PABO88 ต้องแจ้งแอดมินหรือรอยืนยันไหม",
    a: "ระบบหลังบ้านเป็นออโต้เต็มรูปแบบ ตัดขั้นตอนซับซ้อนออกทั้งหมด ผู้เล่นเข้าสู่ระบบ เลือกค่ายเกม และทำรายการฝากเงินได้เองภายในไม่กี่คลิก ไม่ต้องแจ้งสลิปหรือรอใครยืนยัน หน้าเว็บโหลดฉับไวและตอบสนองทันใจ จังหวะการเล่นจึงลื่นไหลต่อเนื่องโดยไม่ขาดช่วง",
  },
  {
    q: "ถอนเงินใช้เวลานานไหม และถอนได้ช่วงไหนบ้าง",
    a: "ระบบถอนเงินเป็นออโต้ที่โอนไว ยอดเข้าตรงเป๊ะโดยไม่ต้องนั่งคอยแอดมินอนุมัติ เปิดให้ทำรายการได้ตลอด 24 ชั่วโมง ไม่ว่าจะเล่นได้กำไรหลักร้อยหรือหลักแสนก็กดถอนออกมาใช้ได้ทันที จบรายการไวไม่ค้างฟีล และไม่มีเงื่อนไขซ่อนให้ต้องมานั่งตีความทีหลัง",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxPremium as="h1" title="PABO88 เว็บสล็อตคัดของดี เกมเด็ดเกินเรื่อง โปรถึงโบนัสแรง ถอนไว">
    <p class="text-left text-base leading-relaxed">
      เปิดมิติใหม่ของการปั่นสล็อตที่เน้นคุณภาพเน้นๆ กับ PABO88 เว็บสล็อตที่คัดสรรเฉพาะตัวเด็ดแตกง่ายมาให้เล่นแบบไม่เสียเวลา ที่นี่ตอบโจทย์ความสนุกของสายล่ารางวัลด้วยไลน์อัปเกมระดับพรีเมียม
      จัดเต็มโปรโมชันสุดคุ้มที่อัปดีกรีความแรงของโบนัสอย่างต่อเนื่อง พร้อมระบบฝากถอนออโต้สุดฉับไว ทำรายการได้อย่างลื่นไหลไร้สะดุด ถอนเงินออกได้จริงแบบทันใจในทุกช่วงเวลา
    </p>
  </ContentBoxPremium>

  <ContentBoxSevenThreeCyberCut as="h2" title="PABO88 เว็บสล็อตคัดของดี จับทุกตัวน่าเล่นมาไว้ครบจบในเว็บเดียว" titleleft="ฝากแรก รับโบนัส 100%">
    <Picture
      slot="left"
      src={imgFirstDepositBonus}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 767px) 92vw, 340px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่นพื้นม่วงนีออนของ PABO88 เขียนตัวใหญ่ว่า ฝากแรก รับโบนัส 100% ภาพหญิงสาวชุดม่วงติดหูแมวถือไพ่เอซโพดำ ข้างกล่องของขวัญและหีบสมบัติที่มีเหรียญทองล้นออกมา มีตู้สล็อตเลข 777 ติดมงกุฎอยู่ด้านหลัง และแถบโลโก้ค่ายเกม PG, Pragmatic Play, Joker, Relax Gaming, Habanero และ Play'n GO เรียงอยู่ตลอดขอบล่าง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#bf3cfa]/40 shadow-[0_10px_30px_rgba(191,60,250,0.3)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      ไม่ต้องเสียเวลาโยกเว็บไปมาเพื่อหาเกมโปรด เพราะ PABO88 ได้ทำการคัดกรองเฉพาะเกมสล็อตที่มีคุณภาพสูง อัตราการจ่ายยุติธรรม และมีธีมเกมที่น่าสนใจมารวบรวมไว้ในที่เดียว ทั้งเกมฮิตติดเทรนด์
      ค่ายใหญ่นอกกระแส หรือเกมคลาสสิกโบนัสแตกหนัก ทุกเกมผ่านการเลือกสรรมาแล้วอย่างดีเพื่อให้ผู้เล่นได้สัมผัสความสนุกและทำกำไรได้จริงตั้งแต่สปินแรก
    </p>
  </ContentBoxSevenThreeCyberCut>

  <GameRankingBoard />

  <ProviderGrid />

  <ContentBox3ThreePremium
    as="h2"
    title="เกมเด็ดเกินเรื่องตรงไหน? เปิดลิสต์ PABO88 แล้วดูว่ามีอะไรน่าตามบ้าง"
    titleleft="งานภาพระดับ HD"
    titlecenter="อัตราคูณโบนัสก้อนโต"
    titleright="ตื่นเต้นทุกรอบวงล้อ">
    <p slot="left" class="text-left text-base leading-relaxed">
      คำว่าเกมเด็ดเกินเรื่องของ PABO88 สัมผัสได้ทันทีตั้งแต่เปิดหน้าล็อบบี้ เพราะแต่ละเกมอัดแน่นไปด้วยงานภาพระดับ HD กราฟิกสีสันสดใส และเอฟเฟกต์สุดอลังการ
    </p>
    <p slot="center" class="text-left text-base leading-relaxed">ที่สำคัญคือมีรูปแบบการจ่ายเงินที่หลากหลาย พร้อมอัตราคูณโบนัสก้อนโตที่สุ่มแจกอย่างต่อเนื่อง</p>
    <p slot="right" class="text-left text-base leading-relaxed">ทำให้การหมุนวงล้อในแต่ละรอบไม่ได้มีแค่ความเพลิดเพลิน แต่ยังเต็มไปด้วยความตื่นเต้นตระการตาตลอดการเล่น</p>
  </ContentBox3ThreePremium>

  <ContentBoxSevenThreeNeumorphism as="h2" title="โปรถึงโบนัสแรง เพิ่มจังหวะความคุ้มให้ทุกช่วงมีอะไรให้ลุ้นต่อ" titleleft="คืนยอดเสีย ทุกวัน 30%">
    <Picture
      slot="left"
      src={imgDailyCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 767px) 92vw, 340px"
      decoding="async"
      formats={["avif", "webp"]}
