---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement2.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBox3Three from "../components/ContentBox3Three.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgCashback from "../assets/slide1.png";
import imgDepositStreak from "../assets/slide4.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxCyberCut as="h1"
//   2 → ContentBoxTwo as="h2" (แบ่งย่อหน้าเดียวลง left/right ที่รอยต่อประโยค)
//   3 → ContentBoxSevenThreeCyberCut as="h2" + slide1 (คืนยอดเสียทุกวัน 5%)
//   4 → ContentBoxSevenThreeNeumorphism as="h2" + slide4 (ฝากต่อเนื่องครบ 10 วัน)
//   5 → ContentBox3Three as="h2" (แบ่งย่อหน้าลง left/center/right)
//   6 → ContentBoxNeumorphism as="h2" (การ์ดผิวนูนคอลัมน์เดียว)
//   7 → ContentBox as="h2" (การ์ดคอลัมน์เดียวแบบเรียบ)
//
// variant รอบนี้เปลี่ยนทั้งตระกูลจากแบรนด์ก่อนหน้า (TANGTEM168 ใช้ Premium +
// FloatingBadge + Special + plain) มาเป็น CyberCut + Neumorphism + Two + 3Three
// + plain ส่วน Faq ย้ายจาก Faq3 มาเป็น Faq และ LatestWinners จาก 3 มาเป็น 4
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook — slide1 (คืนยอดเสียทุกวัน 5%) คู่
// กับหัวข้อหมุนกงล้อพารวยลุ้นแจ็คพอต และ slide4 (ฝากต่อเนื่อง + มั่นคงปลอดภัย
// 100% + รองรับทุกธนาคาร) คู่กับหัวข้อระบบฝากถอนออโต้ ที่เหลือ slide2/slide3 เป็น
// ของ SmoothCarousel แต่ละใบมีบ้านเดียวบนหน้าเว็บ ส่วน banner.png กับ banner2/3/4
// เป็นอาร์ตค้างของแบรนด์ก่อนๆ จึงไม่ถูก import ที่ไหน — รูปที่ import คือรูปที่ถูก
// emit ถึงจะไม่มีใคร render ก็ตาม
//
// banner1 เป็น hero ที่ MainLayout จัดการเอง รอบนี้จึงไม่มีรูปประกอบใน ContentBox
// เดี่ยว
//
// widget ที่ไม่ได้มาจาก docx (GameRankingBoard, ProviderGrid, LatestWinners,
// LoginRtpSection, ReviewCardSumo2, SmoothCarousel, แถวปุ่ม login/register) ใช้
// ป้ายเป็น <p>/<span> + aria-label บน <section> จึงวางต่อท้ายหัวข้อ docx ที่มัน
// สังกัดได้โดยลำดับ h2 ไม่เพี้ยน — GameRankingBoard ต่อจากหัวข้อเว็บตรงไม่ล็อคยูส,
// LatestWinners ต่อจากหัวข้อหมุนกงล้อลุ้นแจ็คพอต, LoginRtpSection ต่อจากหัวข้อ
// ระบบฝากถอนออโต้, ProviderGrid ต่อจากหัวข้อเกมทุกค่ายดัง แล้วปิดท้ายด้วย
// ReviewCardSumo2 + SmoothCarousel + แถวปุ่ม + FAQ
//
// h2 ที่ขึ้นหน้าเว็บ = 6 หัวข้อ docx + หัวข้อ FAQ ที่หน้านี้เขียนเอง = 7
// คำถามใน Faq เป็น <span> ใน <summary> ไม่ใช่ h3 และ titleleft/titlecenter/
// titleright ของ ContentBox3Three กับ titleleft/titleright ของ SevenThree ทั้งสอง
// เป็น <p> — docx รอบนี้แบน H1+H2 ล้วน หน้านี้จึงไม่มี h3 เลย
const pageTitle = "กงล้อ88 เว็บตรงสล็อตแตกหนัก กงล้อพารวย ลุ้นแจ็คพอตทุกวัน";
const pageDescription = "กงล้อ88 สล็อตเว็บตรงแตกหนัก จัดเต็มทุกค่าย หมุนกงล้อพารวยลุ้นแจ็คพอตแตกทุกวัน ระบบออโต้ฝากถอนไว ไม่ต้องส่งสลิป จ่ายจริงถอนไม่อั้น สายปั่นห้ามพลาด สมัครเลย!";

// default message ของ Announcement ทุก variant คือสโลแกนของแบรนด์เก่าคนละเจ้ากัน
// จึงส่ง message ตรงๆ เสมอ ไม่พึ่ง default และห้ามขึ้นต้นด้วย emoji
const announcementMessage =
  "กงล้อ88 สล็อตเว็บตรงแตกหนัก จัดเต็มทุกค่าย หมุนกงล้อพารวยลุ้นแจ็คพอตแตกทุกวัน • เว็บแท้ไม่ผ่านเอเย่นต์ ไม่มีการล็อคยูสหรือปรับลดอัตราการชนะ ทุกการหมุนโปร่งใส 100% เล่นได้เท่าไหร่ก็รับกำไรไปเต็มๆ ไม่มีการหักเปอร์เซ็นต์ย้อนหลัง • ฟีเจอร์พิเศษแจกโบนัสแบบไม่อั้น แค่เข้ามาล็อกอินและร่วมสนุกกับเกมโปรด ก็มีสิทธิ์ลุ้นรับรางวัลใหญ่จากกิจกรรมเสี่ยงทายได้ทุกวัน • ระบบธุรกรรมการเงินแบบออโต้เต็มรูปแบบ ฝากถอนเองได้ผ่านหน้าเว็บ ไม่ต้องทักแอดมินหรือส่งสลิป เงินเข้าบัญชีไวภายในไม่กี่วินาที รองรับทุกธนาคารชั้นนำและทรูวอเลท • คัดสรรเกมครบจบในที่เดียว ทั้ง PG Slot, Joker Gaming, Pragmatic Play และค่ายชั้นนำระดับโลกอีกเพียบ ภาพสวยคมชัด ไหลลื่นไม่มีกระตุก โบนัสเข้าลึก ฟรีสปินออกบ่อย • ฐานการเงินมั่นคงระดับเอเชีย กล้าการันตีจ่ายจริงทุกบิล ไม่มีเงื่อนไขจุกจิก ไม่มีการอั้นถอนหรือแบ่งจ่าย • สมัครสมาชิกใช้เวลาไม่ถึง 1 นาที กรอกข้อมูลไม่กี่ขั้นตอนก็รับยูสเซอร์เข้าเล่นได้ทันที พร้อมโปรโมชั่นต้อนรับสมาชิกใหม่อีกเพียบ";

// FAQ ห้าข้อเขียนจากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้าไหนมา
// ทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบคำถาม
// ที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน
const faqs = [
  {
    q: "กงล้อ88 เป็นเว็บแท้ไม่ผ่านเอเย่นต์จริงหรือไม่",
    a: "เป็นเว็บแท้ไม่ผ่านเอเย่นต์ ซึ่งหมายความว่าทุกเกมที่เข้าเล่นจะไม่มีการล็อคยูสหรือปรับลดอัตราการชนะ (RTP) เด็ดขาด ทุกการหมุนจึงโปร่งใส 100% เล่นได้เท่าไหร่ก็รับกำไรไปเต็มๆ ไม่มีการหักเปอร์เซ็นต์ย้อนหลัง เหมาะกับคนที่ต้องการปั้นบวกแบบระยะยาวโดยไม่ต้องกังวลเรื่องโดนโกง",
  },
  {
    q: "หมุนกงล้อลุ้นรางวัลของ กงล้อ88 ต้องทำอย่างไรถึงมีสิทธิ์",
    a: "เพียงแค่เข้ามาล็อกอินและร่วมสนุกกับเกมโปรดก็มีสิทธิ์ลุ้นรับรางวัลใหญ่จากกิจกรรมเสี่ยงทายได้ทุกวัน ฟีเจอร์พิเศษของที่นี่พร้อมแจกโบนัสแบบไม่อั้น และแจ็คพอตแตกง่ายแตกบ่อย จนหลายคนพลิกวิกฤตเป็นโอกาส หอบเงินหมื่นเงินแสนกลับบ้านได้ในชั่วข้ามคืน",
  },
  {
    q: "ฝากถอนกับ กงล้อ88 ต้องทักแอดมินหรือส่งสลิปไหม",
    a: "ไม่ต้องเลย เพราะระบบธุรกรรมการเงินเป็นแบบออโต้เต็มรูปแบบ ผู้เล่นทำรายการฝากและถอนเงินได้ด้วยตัวเองผ่านหน้าเว็บ ไม่ต้องทักหาแอดมินหรือส่งสลิปให้วุ่นวาย เงินเข้าบัญชีไวภายในไม่กี่วินาที รองรับทุกธนาคารชั้นนำและทรูวอเลท จึงลุยต่อยอดกำไรได้แบบไม่มีสะดุด",
  },
  {
    q: "กงล้อ88 มีเกมจากค่ายไหนให้เลือกเล่นบ้าง",
    a: "คัดสรรมาให้ครบจบในที่เดียว ทั้ง PG Slot, Joker Gaming, Pragmatic Play และค่ายชั้นนำระดับโลกอีกเพียบ ทุกเกมภาพสวยคมชัด ไหลลื่นไม่มีกระตุก และคัดมาเฉพาะเกมที่โบนัสเข้าลึก ฟรีสปินออกบ่อย เพื่อให้สมาชิกทุกคนสนุกกับการทำเงินได้แบบไม่มีเบื่อ",
  },
  {
    q: "ถ้าชนะเงินก้อนใหญ่ กงล้อ88 มีการอั้นถอนหรือแบ่งจ่ายหรือไม่",
    a: "เล่นได้หลักร้อยหรือหลักล้านก็ไม่ต้องหวั่น เพราะมีฐานการเงินที่มั่นคงระดับเอเชีย กล้าการันตีจ่ายจริงทุกบิล ไม่มีเงื่อนไขจุกจิก ไม่มีการอั้นถอนหรือแบ่งจ่าย สามารถเบิกเงินรางวัลทั้งหมดออกไปใช้สอยได้ทันทีตามต้องการ",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxCyberCut as="h1" title="กงล้อ88 สล็อตเว็บตรงแตกหนัก จัดเต็มทุกค่าย หมุนกงล้อพารวยลุ้นแจ็คพอตทุกวัน">
    <p class="text-left text-base leading-relaxed">
      หากคุณคือสายปั่นตัวจริงที่กำลังตามหาแหล่งทำเงินที่ไว้ใจได้ ไม่ต้องไปหาที่ไหนไกล เพราะที่นี่คือศูนย์รวมเกมสล็อตคุณภาพที่กล้าการันตีอัตราการจ่ายรางวัลสูงกว่าใคร
      ไม่ว่าจะทุนน้อยหรือทุนหนาก็มีสิทธิ์สัมผัสเงินรางวัลก้อนโตได้จริง ด้วยระบบที่ออกแบบมาให้ผู้เล่นได้เปรียบที่สุด พร้อมฟีเจอร์เด็ดที่จะมาเปลี่ยนทุกการสปินของคุณให้กลายเป็นกำไรแบบทะลุเป้า
    </p>
  </ContentBoxCyberCut>

  <ContentBoxTwo as="h2" title="ทำไม กงล้อ88 ถึงเป็น สล็อตเว็บตรง ที่สายปั่นเลือกเล่นทำกำไร">
    <p slot="left" class="text-left text-base leading-relaxed">
      เหตุผลหลักที่เซียนสล็อตต่างเทใจให้ กงล้อ88 คือการเป็นเว็บแท้ไม่ผ่านเอเย่นต์ ซึ่งหมายความว่าทุกเกมที่คุณเข้าเล่นจะไม่มีการล็อคยูสหรือปรับลดอัตราการชนะ (RTP) เด็ดขาด
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      ทุกการหมุนคือความโปร่งใส 100% เล่นได้เท่าไหร่ก็รับกำไรไปเต็มๆ ไม่มีการหักเปอร์เซ็นต์ย้อนหลัง นี่คือสวรรค์ของนักลงทุนที่ต้องการปั้นบวกแบบระยะยาวโดยไม่ต้องกังวลเรื่องโดนโกง
    </p>
  </ContentBoxTwo>

  <GameRankingBoard />

  <ContentBoxSevenThreeCyberCut as="h2" title="หมุนกงล้อพารวย ลุ้นแจ็คพอตแตกทุกวันไปกับ กงล้อ88">
    <Picture
      slot="left"
      src={imgCashback}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 767px) 92vw, 345px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น กงล้อ88 ข้อความ คืนยอดเสีย ทุกวัน 5% ด้านซ้ายเป็นพรีเซนเตอร์หญิงชุดเดรสสีทองยืนถือกล่องของขวัญผูกโบว์ทอง มุมบนซ้ายเป็นโลโก้ กงล้อ88 ตัวอักษรทองบนโล่ทรงจีน พื้นหลังสีดำน้ำตาลเข้มมีเปลวไฟทองและกงล้อเสี่ยงโชคเรืองแสง แถบล่างเรียงโลโก้ธนาคาร แอปสโตร์ กูเกิลเพลย์ และทรูมันนี่วอลเล็ท"
      class="mx-auto h-auto w-full rounded-2xl border border-[#ffcc4b]/40 shadow-[0_10px_30px_rgba(255,204,75,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      ไฮไลท์เด็ดที่ทำให้หลายคนติดใจคือฟีเจอร์พิเศษที่พร้อมแจกโบนัสให้คุณแบบไม่อั้น เพียงแค่เข้ามาล็อกอินและร่วมสนุกกับเกมโปรด ก็มีสิทธิ์ลุ้นรับรางวัลใหญ่จากกิจกรรมเสี่ยงทายได้ทุกวัน
      แจ็คพอตของที่นี่แตกง่าย แตกบ่อย จนหลายคนสามารถพลิกวิกฤตเป็นโอกาส หอบเงินหมื่นเงินแสนกลับบ้านได้ในชั่วข้ามคืน
    </p>
  </ContentBoxSevenThreeCyberCut>

  <LatestWinners />

  <ContentBoxSevenThreeNeumorphism as="h2" title="ระบบฝากถอนออโต้รวดเร็วทันใจ ทำรายการไวไม่ต้องรอนาน">
    <Picture
      slot="left"
      src={imgDepositStreak}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 480, 600]}
      sizes="(max-width: 767px) 92vw, 381px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น กงล้อ88 ข้อความ ฝากต่อเนื่อง พร้อมสี่บรรทัด ฝาก 100 ครบ 10 วัน รับ 100, ฝาก 300 ครบ 10 วัน รับ 300, ฝาก 500 ครบ 10 วัน รับ 500 และ ฝาก 1000 ครบ 10 วัน รับ 1000 ด้านซ้ายเป็นมังกรทองพ่นไฟ มุมบนซ้ายเป็นโลโก้ กงล้อ88 ตัวอักษรทองบนโล่ทรงจีน แถบล่างเขียนว่า มั่นคงปลอดภัย 100% บริการตลอด 24 ชม. ทำรายการไม่เกิน 1 นาที และ รองรับทุกธนาคาร บนพื้นดำน้ำตาลเข้มกับเปลวไฟทอง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#ffcc4b]/40 shadow-[0_10px_30px_rgba(255,204,75,0.25)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed">
      เรื่องเงินๆ ทองๆ เป็นสิ่งที่รอไม่ได้ กงล้อ88 จึงพัฒนาระบบธุรกรรมการเงินให้เป็นแบบออโต้เต็มรูปแบบ คุณสามารถทำรายการฝากและถอนเงินได้ด้วยตัวเองผ่านหน้าเว็บโดยไม่ต้องทักหาแอดมินหรือส่งสลิปให้วุ่นวาย
