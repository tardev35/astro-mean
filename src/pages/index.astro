---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBox3ThreeNeumorphism from "../components/ContentBox3ThreeNeumorphism.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinnersPremium from "../components/LatestWinnersPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Faq3 from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgTopSlots from "../assets/slide3.png";
import imgCashBack from "../assets/slide1.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxNeumorphism as="h1" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   2 → ContentBoxCyberCut as="h2" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   3 → ContentBox3ThreeNeumorphism as="h2" (ย่อหน้าเดียวแบ่งลงสามคอลัมน์ตามลำดับ
//       ประโยคเดิม: ขนทัพค่ายระดับท็อป → คัดเฉพาะเกมตัวเด่น → ไม่ต้องเลื่อนหาเอง)
//       แล้วต่อด้วย ProviderGrid ซึ่งกางโลโก้ค่ายที่ย่อหน้าเดียวกันเอ่ยชื่อไว้
//   4 → ContentBoxSevenThreeCyberCut as="h2" + slide3 (อาร์ตสไลด์เป็นวงล้อแห่ง
//       โชคลาภทองบนดำ ตรงกับย่อหน้าเรื่องคลังสล็อตตัวท็อปที่ลุ้นรางวัลใหญ่ได้ทุกสปิน)
//       แล้วต่อด้วย FeatureHighlights (ฟีเจอร์ย่อยสามตัวที่ย่อหน้านี้ระบุชื่อไว้ตรงๆ
//       → h3 สามตัว ซึ่งเป็น h3 ชุดเดียวที่ได้รับอนุญาตบนหน้านี้)
//   5 → ContentBoxTwoNeumorphism as="h2" (ย่อหน้าเดียวแบ่งสองครึ่ง: สัญญาณไลฟ์
//       Ultra HD → โต๊ะที่เปิดให้เล่นกับกระเป๋าเงินเดียว)
//   6 → ContentBoxSevenThreeNeumorphism as="h2" + slide1 (อาร์ตสไลด์เป็น CASH BACK
//       คืน 5% ยอดเสีย ตรงกับประโยค Cash Back คืนยอดเสียทุกวันในย่อหน้านี้เป๊ะ)
//   7 → ContentBox as="h2" (ย่อหน้าเดียวเต็มๆ เรื่องระบบออโต้ 3 วินาที)
//
// variant รอบนี้หมุนออกจากชุดของแบรนด์ก่อนทั้งตระกูล: ทรง ContentBox เปลี่ยนจากชุด
// Premium ×4 + FloatingBadge ×2 + Special ×1 มาเป็น Neumorphism ×4 + CyberCut ×2 +
// ContentBox ตัวธรรมดา ×1 ส่วน Announcement เป็น AnnouncementPremium, LatestWinners
// เป็น LatestWinnersPremium, ProviderGrid เป็นตัวธรรมดา, ReviewCard เป็น
// ReviewCardSumo และ Faq เป็น Faq3 — Navbar/Footer/ฟอนต์ ถูกสลับไว้แล้วใน
// MainLayout กับ brandProfile
//
// ContentBoxSevenThree* ทั้งสองตัวปล่อยหัวข้อจาก prop `title` ตัวเดียว ส่วน
// titleleft เป็นป้ายคอลัมน์รูปที่ยังเป็น <p> — ห้ามส่ง titleright เข้าไป เพราะจะเพิ่ม
// ป้ายซ้อนใต้หัวข้อเดียวกัน
//
// Announcement ส่ง message ตรงๆ เสมอ เพราะ default ของทุก variant ในตระกูลนี้เป็น
// สโลแกนของแบรนด์เก่าคนละเจ้ากัน ข้อความชุดนี้ต้องตรงกับ default ของ
// AnnouncementPremium เป๊ะ เพื่อให้ ticker ของหน้าย่อยที่เรียก <Announcement />
// เปล่าๆ วิ่งข้อความเดียวกับหน้าแรก และห้ามขึ้นต้นด้วย emoji เพราะ marquee render
// ข้อความซ้ำและ emoji ที่ฝังในสตริงถูก mark aria-hidden ไม่ได้
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook คู่กับ slide3/slide1 ซึ่งเป็นสไลด์ที่
// อาร์ตตรงกับหัวข้อ docx ข้อ 4 กับข้อ 6 พอดี — slide2 (สมาชิกใหม่ ฝาก 100 รับ 200)
// กับ slide4 (แนะนำเพื่อน รับค่าคอม) ไม่มีหัวข้อ docx ไหนรองรับและเพดาน SevenThree
// เต็มแล้ว จึงปล่อยไว้ให้หน้า /promotion ใช้ ส่วน banner ทุกหมายเลข (banner2/3/4)
// เป็นอาร์ตของแบรนด์ก่อน ห้าม import ที่นี่หรือที่ไหนก็ตาม เพราะรูปที่ import คือรูป
// ที่ถูก emit ถึงจะไม่มีใคร render ก็ตาม ส่วน banner1 กับ banner1-mobile เป็นของ
// MainLayout จัดการเอง และรูปในหน้านี้ไม่มีตัวไหนใส่ loading="eager"/
// fetchpriority="high" เพราะ LCP เป็นของ hero ใน MainLayout
//
// widget ที่ไม่ได้มาจาก docx (SmoothCarousel, GameRankingBoard, LatestWinnersPremium,
// LoginRtpSection, ReviewCardSumo, แถวปุ่ม login/register, FAQ, Navfoot) ใช้ป้าย
// เป็น <p>/<span> + aria-label บน <section> และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้าย
// ทั้งชุด ยกเว้นสองตัวที่เป็นภาพประกอบของหัวข้อ docx หนึ่งข้อโดยตรง
// (ProviderGrid → ข้อ 3, FeatureHighlights → ข้อ 4) ซึ่งวางต่อท้ายบล็อกนั้นๆ
//
// h1 ×1 + h2 ×6 = หัวข้อ docx พอดี บวก h3 ×3 จาก FeatureHighlights ซึ่งเป็นรายการ
// ย่อยของหัวข้อข้อ 4 ตามข้อยกเว้นเดียวที่ playbook อนุญาต — หัว FAQ เป็น <p> ใน
// Faq3.astro คำถามเป็น <span> ใน <summary> และป้ายคอลัมน์ของทุก ContentBox variant
// เป็น <p>
//
// title ใช้บรรทัด Title ของ docx ตรงๆ ส่วน description ต่อท้ายบรรทัด Des ของ docx
// ด้วย "เว็บตรง API แท้ ถอนเต็มจำนวน" ให้ยาว 158 ตัวอักษร เข้ากรอบ 150–160 ของเกท
// คุณภาพ (บรรทัด Des ดิบของ docx ยาว 129 ตัว ซึ่งต่ำกว่ากรอบ) และเป็นสตริงเดียวกับ
// ที่ส่งเข้า pageGraph และ MainLayout
const pageTitle = "QUEEN189 | คาสิโนมงลงทุกสปิน เกมเด็ดของดีมีครบ โปรแน่นต้องลอง";
const pageDescription = "QUEEN189 คาสิโนมงลงทุกสปิน คัดเกมเด็ดของดีมีครบจากค่ายชั้นนำ สล็อตตัวท็อปและโต๊ะสดพร้อมลุย โปรแน่นต้องลอง ระบบออโต้ลั่นไวไม่รอนาน เว็บตรง API แท้ ถอนเต็มจำนวน";

const announcementMessage =
  "QUEEN189 คาสิโนมงลงทุกสปิน เกมเด็ดของดีมีครบ โปรแน่นต้องลอง • เว็บตรง API แท้ ยิงตรงจากเซิร์ฟนอก ปั่นง่ายแตกจริงด้วยค่า RTP มาตรฐานสากล ไร้การดัดแปลงระบบ ไม่ผ่านเอเย่นต์ ไม่ล็อกยูส • ยกระดับความปังด้วยเกมคัดเกรด รวมเฉพาะสล็อตแตกง่ายและคาสิโนสดอัตราจ่ายสูงไว้ในที่เดียว ไม่เอาเกมล้าหลังหรือเปอร์เซ็นต์แตกต่ำมาลงคลัง ทุกเกมผ่านการทดสอบอัลกอริทึมว่าแจกโบนัสตรงตามมาตรฐานโรงงาน • ขนทัพค่ายระดับท็อปของโลกอย่าง PG Soft, Pragmatic Play, SA Gaming และ Evolution มาไว้แบบครบมือ เน้นเกมตัวเด่นที่โครงสร้างการจ่ายเงินโปร่งใส ฟีเจอร์แตกโหด และสัญญาณไลฟ์สดความคมชัดสูง • สล็อตตัวท็อปอัดแน่นด้วยระบบ Multipliers ตัวคูณสะสม โหมดซื้อฟรีสปิน และคอมโบแตกต่อเนื่อง Cascading สปินลื่น กราฟิกสมูธ ไม่มีกระตุก เบทเริ่มต้นเบา ๆ แต่พร้อมแตกรางวัลใหญ่ • โต๊ะสดพร้อมลุย เชื่อมสัญญาณไลฟ์ระดับ Ultra HD ส่งตรงจากคาสิโนจริง ทั้งบาคาร่า รูเล็ต ไฮโล และเสือมังกร ร่วมกับดีลเลอร์มืออาชีพแบบเรียลไทม์ ผ่านกระเป๋าเงินเดียวไม่ต้องโยกเครดิต • โปรแน่นต้องลอง ทั้งโบนัสต้อนรับเพิ่มทุนสปิน โปรฝากแรกของวัน และระบบคืนยอดเสีย Cash Back ทุกวัน เงื่อนไขชัดเจน โปร่งใส ไม่ติดเทิร์นโอเวอร์มหาโหด • ระบบออโต้ลั่นไวไม่รอนาน ทำรายการเสร็จสรรพใน 3 วินาที ตัดขั้นตอนรอแอดมินอนุมัติและการส่งสลิปออกทั้งหมด ถอนยอดไหนก็เงินเข้าเต็มจำนวนทันที";

// FAQ ห้าข้อเขียนขึ้นใหม่จากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้า
// ไหนมาทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบ
// คำถามที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq3> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน — ห้ามปล่อยให้
// Faq3 ใช้ค่า default ของตัวเอง เพราะ default ของทุก variant ในตระกูลนี้เป็นคำถาม
// ของแบรนด์เก่า
const faqs = [
  {
    q: "QUEEN189 ต่อเกมมาจากไหน แล้วค่า RTP ถูกดัดแปลงหรือเปล่า",
    a: "QUEEN189 เป็นเว็บตรง API แท้ ยิงสัญญาณตรงจากเซิร์ฟเวอร์นอกโดยไม่ผ่านเอเย่นต์และไม่ล็อกยูส ค่า RTP จึงเป็นมาตรฐานสากลไร้การดัดแปลงระบบ ทุกเกมในคลังผ่านการทดสอบอัลกอริทึมว่าแจกโบนัสตรงตามมาตรฐานโรงงานก่อนเปิดให้เข้าเล่น",
  },
  {
    q: "ในฟลอร์มีค่ายอะไรบ้าง แล้วต้องไล่หาเกมเองไหม",
    a: "ขนทัพค่ายระดับท็อปของโลกมาไว้ครบมือ ทั้ง PG Soft, Pragmatic Play, SA Gaming และ Evolution โดยคัดเฉพาะเกมตัวเด่นที่โครงสร้างการจ่ายเงินโปร่งใส ฟีเจอร์แตกโหด และสัญญาณไลฟ์สดความคมชัดสูง จึงไม่ต้องเสียเวลาเลื่อนหาหรือลองผิดลองถูกเองให้เสียทุน",
  },
  {
    q: "สล็อตตัวท็อปมีฟีเจอร์อะไรให้ลุ้น แล้วเบทเริ่มต้นต้องหนักไหม",
    a: "คลังสล็อตอัดแน่นด้วยระบบ Multipliers ตัวคูณสะสม โหมดซื้อฟรีสปิน และคอมโบแตกต่อเนื่อง Cascading สปินลื่น กราฟิกสมูธ ไม่มีกระตุก เบทเริ่มต้นเบา ๆ ก็เข้าเล่นได้และยังพร้อมแตกรางวัลใหญ่ในตาเดียวกัน",
  },
  {
    q: "อยากเล่นโต๊ะสดต้องย้ายเว็บหรือโยกเครดิตไหม",
    a: "สลับจากหน้าสปินมาโต๊ะสดได้ทันทีโดยไม่ต้องย้ายเว็บ สัญญาณไลฟ์สดเป็นระดับ Ultra HD ส่งตรงจากคาสิโนจริง มีทั้งบาคาร่า รูเล็ต ไฮโล และเสือมังกร ร่วมกับดีลเลอร์มืออาชีพแบบเรียลไทม์ ทั้งหมดใช้กระเป๋าเงินเดียวไม่ต้องเสียเวลาโยกเครดิต",
  },
  {
    q: "รับโปรต้องส่งสลิปไหม แล้วฝากถอนใช้เวลานานแค่ไหน",
    a: "ไม่ต้องส่งสลิปและไม่ต้องรอแอดมินอนุมัติ สิทธิ์ทั้งโบนัสต้อนรับ โปรฝากแรกของวัน และ Cash Back คืนยอดเสียทุกวัน กดรับเองได้จากหน้าแดชบอร์ด เงื่อนไขชัดเจนไม่ติดเทิร์นโอเวอร์มหาโหด ส่วนระบบออโต้ทำรายการเสร็จสรรพใน 3 วินาที ถอนยอดไหนก็เงินเข้าเต็มจำนวน",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxNeumorphism as="h1" title="QUEEN189 คาสิโนมงลงทุกสปิน เกมเด็ดของดีมีครบ โปรแน่นต้องลอง">
    <p class="text-left text-base leading-relaxed">
      QUEEN189 เว็บตรง API แท้ ยิงตรงจากเซิร์ฟนอก ปั่นง่ายแตกจริงด้วยค่า RTP มาตรฐานสากล ไร้การดัดแปลงระบบ ไม่ผ่านเอเย่นต์ ไม่ล็อกยูส รวบรวมเกมสล็อตตัวฮิตและโต๊ะสดจากค่ายใหญ่ระดับโลก
      พร้อมระบบฝากถอนออโต้ประมวลผลฉับไวใน 3 วินาที การันตีสภาพคล่องทางการเงิน ถอนยอดไหนก็เงินเข้าเต็มจำนวนทันที
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxCyberCut as="h2" title="QUEEN189 คาสิโนมงลงทุกสปิน เปิดลิสต์เกมเด็ดของดีที่คัดมาแล้วว่าน่าจับตา">
    <p class="text-left text-base leading-relaxed">
      ยกระดับความปังด้วยเกมคัดเกรดบน QUEEN189 ที่รวมเอาเฉพาะเกมสล็อตแตกง่ายและคาสิโนสดอัตราจ่ายสูงมาไว้ในที่เดียว ไม่เอาเกมล้าหลังหรือเปอร์เซ็นต์แตกต่ำมาลงคลัง
      ทุกเกมผ่านการทดสอบอัลกอริทึมว่าแจกโบนัสตรงตามมาตรฐานโรงงาน ให้คุณลุ้นรับรางวัลใหญ่ระดับมงลงได้ทุกสปิน
    </p>
  </ContentBoxCyberCut>

  <ContentBox3ThreeNeumorphism
    as="h2"
    title="ค่ายชั้นนำส่งอะไรลงฟลอร์ QUEEN189 รวมตัวเด่นไว้ให้เลือกแบบไม่ต้องไล่หา"
    titleleft="ค่ายระดับท็อปของโลกครบมือ"
    titlecenter="คัดเฉพาะเกมตัวเด่นของแต่ละค่าย"
    titleright="ไม่ต้องเลื่อนหาเองให้เสียทุน">
    <p slot="left" class="text-left text-base leading-relaxed">ขนทัพค่ายเกมระดับท็อปของโลกอย่าง PG Soft, Pragmatic Play, SA Gaming และ Evolution มาไว้แบบครบมือ</p>
