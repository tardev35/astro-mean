---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners3 from "../components/LatestWinners3.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Faq2 from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgLicensed from "../assets/slide1.png";
import imgAutoWithdraw from "../assets/slide3.png";

// โครงหน้า: หัวข้อ docx 7 ข้อ (H1 ×1 + H2 ×6) เรียงตาม document order เป๊ะ
//   1 → ContentBoxPremium as="h1" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   2 → ContentBoxFloatingBadge as="h2" (ย่อหน้าเดียวเต็มๆ ใน slot เดียว)
//   3 → ContentBoxSevenThreePremium as="h2" + slide1 (อาร์ตสไลด์เขียนว่า "เว็บตรง
//       ลิขสิทธิ์แท้ / ฝาก-ถอน AUTO / ระบบเกมดีสุดใน ASIA" ตรงกับย่อหน้าเรื่องเกม
//       ลิขสิทธิ์แท้จากค่ายยักษ์ใหญ่) แล้วต่อด้วย ProviderGridPremium ซึ่งกางโลโก้
//       ค่ายที่ย่อหน้าเดียวกันเอ่ยชื่อไว้ (PG Soft, Pragmatic Play, Joker Gaming)
//   4 → ContentBox3ThreePremium as="h2" (ย่อหน้าเดียวแบ่งลงสามคอลัมน์ตามลำดับ
//       ประโยคเดิม: มีหมวดหมู่ครบทุกสไตล์ → ลิสต์สี่หมวด → กระเป๋าเดียวไม่ต้องโยกเงิน)
//   5 → ContentBoxSpecial as="h2" (ย่อหน้าเดียวแบ่งสองครึ่ง: Multiplier/Cascading/
//       รีลขยาย Wild → Bonus Buy และผลลัพธ์) แล้วต่อด้วย FeatureHighlights ซึ่งกาง
//       ลูกเล่นสี่ตัวที่ย่อหน้านี้ระบุชื่อไว้ตรงๆ → h3 สี่ตัว ซึ่งเป็น h3 ชุดเดียวที่
//       ได้รับอนุญาตบนหน้านี้ คำอธิบายเขียนขยายความใหม่ ไม่ได้ก๊อบประโยคด้านบนซ้ำ
//   6 → ContentBoxTwoPremium as="h2" (ย่อหน้าเดียวแบ่งสองครึ่ง: เติมข้อเสนอใหม่
//       ต่อเนื่อง → Cash Back และเงื่อนไขที่กดรับเองได้)
//   7 → ContentBoxSevenThreeFloatingBadge as="h2" + slide3 (อาร์ตสไลด์เขียนว่า
//       "สล็อตเว็บตรง ไม่ผ่านเอเยนต์ / จ่ายเต็ม เท่าไหร่ก็ถอนได้ / ฝาก-ถอน AUTO
//       ภายใน 3 วินาที" ตรงกับย่อหน้าเรื่องระบบออโต้ฝากถอนเป๊ะ)
//
// variant รอบนี้หมุนออกจากชุดของแบรนด์ก่อนทั้งตระกูล: ทรง ContentBox เปลี่ยนจากชุด
// Neumorphism ×4 + CyberCut ×2 + ContentBox ตัวธรรมดา มาเป็น Premium ×3 +
// FloatingBadge ×2 + 3ThreePremium + Special ส่วน Announcement เป็น Announcement3,
// LatestWinners เป็น LatestWinners3, ProviderGrid เป็น ProviderGridPremium,
// ReviewCard เป็น ReviewCardSumo2 และ Faq เป็น Faq2 — Navbar/Footer/ฟอนต์ ถูกสลับ
// ไว้แล้วใน MainLayout กับ brandProfile หน้านี้จึงไม่ใช้ ContentBox ตัวธรรมดาเลย
// รอบนี้ (มันยังถูกใช้อยู่ที่ terms/privacy)
//
// ContentBoxSevenThree* ทั้งสองตัวปล่อยหัวข้อจาก prop `title` ตัวเดียว ส่วน
// titleleft เป็นป้ายคอลัมน์รูปที่ยังเป็น <p> — ห้ามส่ง titleright เข้าไป เพราะจะเพิ่ม
// ป้ายซ้อนใต้หัวข้อเดียวกัน
//
// Announcement ส่ง message ตรงๆ เสมอ เพราะ default ของทุก variant ในตระกูลนี้เป็น
// สโลแกนของแบรนด์เก่าคนละเจ้ากัน ข้อความชุดนี้ก๊อบมาจาก default ของ
// Announcement3.astro แบบตัวต่อตัว เพื่อให้ ticker ของหน้าย่อยที่เรียก
// <Announcement /> เปล่าๆ วิ่งข้อความเดียวกับหน้าแรก และห้ามขึ้นต้นด้วย emoji เพราะ
// marquee render ข้อความซ้ำและ emoji ที่ฝังในสตริงถูก mark aria-hidden ไม่ได้
//
// SevenThree ใช้สองบล็อกพอดีเพดานของ playbook คู่กับ slide1/slide3 ซึ่งเป็นสไลด์ที่
// อาร์ตตรงกับหัวข้อ docx ข้อ 3 กับข้อ 7 พอดี — slide2 (แนะนำเพื่อน รับค่าคอมมิชชั่น
// 3% / คืนยอดเสียด้วยระบบ Auto) ไม่มีหัวข้อ docx ไหนรองรับและเพดาน SevenThree
// เต็มแล้ว จึงปล่อยไว้ให้หน้า /promotion ใช้ ส่วนสไลด์ใบที่สี่กับไฟล์ banner ทุกตัว
// ที่ไม่ใช่ banner1 (ทั้งตัวเปล่าและตัวที่มีเลขต่อท้ายตั้งแต่สองขึ้นไป) เป็นอาร์ตของ
// แบรนด์ก่อน ห้าม import ที่นี่หรือที่ไหนก็ตาม เพราะรูปที่ import คือรูปที่ถูก emit
// ลง dist/ ถึงจะไม่มีใคร render ก็ตาม ส่วน banner1
// กับ banner1-mobile เป็นของ MainLayout จัดการเอง และรูปในหน้านี้ไม่มีตัวไหนใส่
// loading="eager"/fetchpriority="high" เพราะ LCP เป็นของ hero ใน MainLayout
//
// widget ที่ไม่ได้มาจาก docx (SmoothCarousel, GameRankingBoard, LatestWinners3,
// LoginRtpSection, ReviewCardSumo2, แถวปุ่ม login/register, FAQ, Navfoot) ใช้ป้าย
// เป็น <p>/<span> + aria-label บน <section> และถูกวางต่อท้ายหัวข้อ docx ข้อสุดท้าย
// ทั้งชุด ยกเว้นสองตัวที่เป็นภาพประกอบของหัวข้อ docx หนึ่งข้อโดยตรง
// (ProviderGridPremium → ข้อ 3, FeatureHighlights → ข้อ 5) ซึ่งวางต่อท้ายบล็อกนั้นๆ
//
// h1 ×1 + h2 ×6 = หัวข้อ docx พอดี บวก h3 ×4 จาก FeatureHighlights ซึ่งเป็นรายการ
// ย่อยของหัวข้อข้อ 5 ตามข้อยกเว้นเดียวที่ playbook อนุญาต — หัว FAQ เป็น <p> ใน
// Faq2.astro คำถามเป็น <span> ใน <summary> และป้ายคอลัมน์ของทุก ContentBox variant
// เป็น <p>
//
// title ใช้บรรทัด Title ของ docx ตรงๆ ส่วน description ต่อท้ายบรรทัด Des ของ docx
// ด้วย "ถอนเต็มจำนวนทันที" ให้ยาว 156 ตัวอักษร เข้ากรอบ 150–160 ของเกทคุณภาพ
// (บรรทัด Des ดิบของ docx ยาว 138 ตัว ซึ่งต่ำกว่ากรอบ) และเป็นสตริงเดียวกับที่ส่ง
// เข้า pageGraph และ MainLayout ซึ่งตั้งค่าเดียวกันนี้ไว้เป็น default อยู่แล้ว
const pageTitle = "ROSTY59 | สล็อตเว็บตรงฟอร์มแรง เกมแท้จัดเต็ม ฟีเจอร์ใหม่พร้อมลั่น";
const pageDescription = "ROSTY59 สล็อตเว็บตรงฟอร์มแรง เกมแท้จัดเต็มจากค่ายดัง มีหลายหมวดให้เลือก ฟีเจอร์ใหม่พร้อมลั่น โปรอัปเดตต่อเนื่อง ระบบเสถียรพร้อมออโต้ฝากถอน ถอนเต็มจำนวนทันที";

const announcementMessage =
  "ROSTY59 สล็อตเว็บตรงฟอร์มแรง เกมแท้จัดเต็ม ฟีเจอร์ใหม่พร้อมลั่น • สัญญาณ API แท้ เชื่อมตรงเซิร์ฟนอก ไม่ผ่านเอเย่นต์ ค่า RTP ตรงตามมาตรฐานสากลจากค่ายแม่ ไม่มีปรับลดเปอร์เซ็นต์ชนะ ไร้ประวัติล็อกยูส • ระบบหลังบ้านวางมาให้เน้นความเร็วระดับสูง โหลดหน้าเกมไว ไร้ป๊อปอัปและองค์ประกอบรกตา ทุกการกดสปินลื่นไหล ไม่ค้างไม่เด้งหลุดแม้ช่วงผู้เล่นเข้าพร้อมกันหนาแน่น • คัดเฉพาะเกมสล็อตลิขสิทธิ์แท้จาก PG Soft, Pragmatic Play, Joker Gaming และค่ายชั้นนำระดับโลก จัดคลังเป็นหมวดหมู่ ค้นหาง่ายด้วยฟิลเตอร์ค่ายและประเภทเกม • หมวดหมู่ครบทุกสไตล์ ทั้งสล็อตวิดีโอ 3D ภาพสวย สล็อตคลาสสิกไลน์จ่ายเข้าใจง่าย สล็อตตัวคูณหนัก และสายซื้อฟีเจอร์พุ่งชนโบนัส เปลี่ยนสไตล์ได้ผ่านกระเป๋าเดียวไม่ต้องโยกเงินข้ามค่าย • ฟีเจอร์ใหม่พร้อมลั่นทุกเกม ทั้ง Multiplier สะสมตัวคูณทวีคูณ Cascading สัญลักษณ์แตกต่อเนื่องในสปินเดียว รีลขยาย Wild ซ้อนทับ และโหมด Bonus Buy เลือกซื้อฟรีสปินพุ่งเข้าลุ้นแจ็คพอต • โปรอัปเดตต่อเนื่อง ทั้งโบนัสต้อนรับเพิ่มทุนสปิน โปรโมชันฝากแรกของวัน และสิทธิ์คืนยอดเสีย Cash Back คำนวณตรงไปตรงมา กดรับเองผ่านหน้าเว็บ ไม่ติดเทิร์นโอเวอร์ซับซ้อน • ระบบฝากถอนออโต้ไฮสปีดเสร็จใน 3 วินาทีผ่าน Gateway ตรง รองรับทั้งธนาคารชั้นนำและวอลเล็ท ไม่ต้องส่งสลิป ไม่ต้องรอคิวอนุมัติ ถอนปุ๊บเงินวิ่งเข้าบัญชีทันใจ";

// FAQ ห้าข้อเขียนขึ้นใหม่จากข้อเท็จจริงในเนื้อ docx ทั้งเจ็ดย่อหน้า ไม่ได้ก๊อบย่อหน้า
// ไหนมาทั้งดุ้น เพราะเนื้อ docx ถูกใช้เต็มๆ ไปแล้วในบล็อกด้านบน — ตรงนี้เป็นการตอบ
// คำถามที่ผู้เล่นถามจริงด้วยข้อเท็จจริงชุดเดียวกัน และอาร์เรย์เดียวกันถูกส่งให้ทั้ง
// <Faq2> และ pageGraph เพื่อไม่ให้ FAQPage กับหน้าจริงหลุดออกจากกัน — ห้ามปล่อยให้
// Faq2 ใช้ค่า default ของตัวเอง เพราะ default ของทุก variant ในตระกูลนี้เป็นคำถาม
// ของแบรนด์เก่า
const faqs = [
  {
    q: "ROSTY59 ต่อเกมมาจากไหน แล้วค่า RTP ถูกปรับลดหรือเปล่า",
    a: "ROSTY59 เป็นสล็อตเว็บตรงที่ใช้สัญญาณ API แท้เชื่อมตรงกับเซิร์ฟเวอร์นอกโดยไม่ผ่านเอเย่นต์ ค่า RTP จึงตรงตามมาตรฐานสากลที่ค่ายแม่กำหนดมา ไม่มีการปรับลดเปอร์เซ็นต์ชนะระหว่างทาง และไม่มีประวัติล็อกยูสให้ต้องกังวลตอนกำลังทำกำไร",
  },
  {
    q: "เล่นช่วงคนเยอะแล้วเกมจะค้างหรือเด้งหลุดไหม",
    a: "สถาปัตยกรรมหลังบ้านถูกวางมาให้เน้นความเร็วระดับสูง หน้าเกมจึงโหลดไวและไม่มีป๊อปอัปหรือองค์ประกอบรกตามาถ่วง การประมวลผลระหว่างเซิร์ฟเวอร์ค่ายเกมกับการจัดการบัญชีเชื่อมกันแบบไร้รอยต่อ ทุกการกดสปินจึงลื่นไหลแม้ในช่วงที่มีผู้เล่นเข้าใช้งานพร้อมกันจำนวนมาก",
  },
  {
    q: "ในคลังมีค่ายอะไรบ้าง แล้วต้องไล่หาเกมเองไหม",
    a: "คัดเฉพาะเกมสล็อตลิขสิทธิ์แท้จากค่ายยักษ์ใหญ่อย่าง PG Soft, Pragmatic Play, Joker Gaming และค่ายชั้นนำระดับโลกอีกหลายเจ้า คลังเกมถูกจัดเรียงเป็นหมวดหมู่และมีฟิลเตอร์ค่ายกับประเภทเกมให้กรอง จึงพุ่งตรงเข้าเกมที่ต้องการได้ทันทีโดยไม่ต้องเลื่อนหาเอง",
  },
  {
    q: "อยากเปลี่ยนแนวเกมกลางคัน ต้องโยกเงินข้ามค่ายไหม",
    a: "ไม่ต้องโยกเลย ทุกหมวดใช้ระบบกระเป๋าเดียวร่วมกัน สลับจากสล็อตวิดีโอ 3D ไปสล็อตคลาสสิกไลน์จ่าย สล็อตตัวคูณหนัก หรือสายซื้อฟีเจอร์พุ่งชนโบนัสได้ตลอดเวลา ลูกเล่นอย่าง Multiplier, Cascading, รีลขยาย Wild และ Bonus Buy ก็เปิดให้ใช้ตามที่แต่ละเกมรองรับ",
  },
  {
    q: "รับโปรต้องส่งสลิปไหม แล้วฝากถอนใช้เวลานานแค่ไหน",
    a: "ไม่ต้องส่งสลิปและไม่ต้องรอคิวอนุมัติจากแอดมิน สิทธิ์ทั้งโบนัสต้อนรับ โปรโมชันฝากแรกของวัน และคืนยอดเสีย Cash Back กดรับเองได้จากหน้าเว็บ เงื่อนไขชัดเจนไม่ติดเทิร์นโอเวอร์ซับซ้อน ส่วนระบบออโต้ทำรายการเสร็จใน 3 วินาทีผ่าน Gateway ตรง ถอนยอดไหนก็เงินเข้าเต็มจำนวน",
  },
];

// หน้าแรกไม่ส่ง breadcrumb — เส้นทางเริ่มที่หน้านี้อยู่แล้ว ส่วน URL ทุกตัวใน graph
// มาจาก abs() ข้างใน pageGraph ห้ามพิมพ์โดเมนหรือประกอบ URL ด้วย + ที่นี่
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxPremium as="h1" title="ROSTY59 สล็อตเว็บตรงฟอร์มแรง เกมแท้จัดเต็ม ฟีเจอร์ใหม่พร้อมลั่น">
    <p class="text-left text-base leading-relaxed">
      ROSTY59 สล็อตเว็บตรงสัญญาณ API แท้ เชื่อมตรงเซิร์ฟนอก ไม่ผ่านเอเย่นต์ ค่า RTP ตรงตามมาตรฐานสากลจากค่ายแม่ ไม่มีปรับลดเปอร์เซ็นต์ชนะ ไร้ประวัติล็อกยูส มาพร้อมระบบฝากถอนออโต้ 3 วินาที
      ดำเนินการผ่าน Gateway ตรง ถอนยอดไหนก็เงินเข้าเต็มจำนวนทันที ปั่นสบายใจบนโครงสร้างเว็บที่เสถียรและเร็วที่สุด
    </p>
  </ContentBoxPremium>

  <ContentBoxFloatingBadge as="h2" title="ROSTY59 สล็อตเว็บตรงฟอร์มแรง จุดเด่นที่ทำให้ระบบและเกมไปด้วยกันได้คล่อง">
    <p class="text-left text-base leading-relaxed">
