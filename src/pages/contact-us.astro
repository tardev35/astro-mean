---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

// This page is a BUTTON PAGE, not an article: title, LINE image, address block,
// button row — and nothing else. No section heading, no explanatory paragraph.
// The docx gives it a Title and a Meta and never a body; every paragraph that
// has ever appeared here was invented by a rebrand and pushed the buttons
// further down. h2 and h3 here must both stay 0.
//
// The <h1> names what the page IS ("ติดต่อทีมงาน SETH88"), not what an article
// on it would argue. A title that previews a body reads as a broken promise
// once the body is (correctly) absent.
//
// The address block is read from lib/brandProfile — never retype the lines, and
// never let any of it reach the JSON-LD. It is visible text only. It also
// carries NO brand hex on purpose (border-white/15, bg-black/20, opacity over
// the inherited text colour): that is what stops the previous brand's colour
// being left behind here on the next launch.
//
// SETH88: ticker หมุนมาเป็น Announcement5 และกล่องหน้าย่อยใช้ ContentBox ตาม
// สเปกรอบนี้ (เรียก <Announcement /> เปล่าๆ เพราะ default message ของ variant
// นี้เป็นข้อความของแบรนด์นี้แล้ว และตรงกับหน้าแรก)
//
// พาเลตต์รอบนี้เป็น "ทองคำอียิปต์บนดำอมน้ำตาลของหินวิหาร" ไม่มีแกนสีน้ำเงินเหลือ
// อยู่เลย ปุ่มสมัครสมาชิกซึ่งเป็นปุ่มหลักไล่สีทองสว่าง #f7d774 / #e0a92b / #a9711a
// ขอบ #f7d774 เนื้อความ #0c0703 · ปุ่มเข้าสู่ระบบเป็นปุ่มรองจึงไล่สีบรอนซ์เข้ม
// #6b4210 / #2a1a0d ขอบ #f7d774 เนื้อความ #fdf3d4
// เขียว LINE คงเดิมเพราะเป็นสีแบรนด์ของ LINE ไม่ใช่สีของเว็บนี้
//
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count reads ~3x
// too long and will send you rewriting a description that was fine). This one
// measures 155.
const pageDescription = "ช่องทางติดต่อทีมงาน SETH88 สล็อตเว็บตรงเกมคัด ทักแอดมินผ่าน LINE Official สอบถามวิธีเข้าเกม แจ้งปัญหาฝากถอนออโต้ หรือขอรับสิทธิ์โปรโมชันที่เปิดอยู่ในรอบนี้";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน SETH88",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName:
      "SETH88 สล็อตเว็บตรงเกมคัด เกมลิขสิทธิ์แน่น ออโต้ทันใจ ปลอดภัยชัวร์ ยิงตรงจากเซิร์ฟเวอร์หลักด้วยระบบ API แท้ ไม่ผ่านเอเย่นต์ ค่า RTP มาตรฐานสากลจากค่ายแม่ ไม่มีปรับลดอัตราแตก ไม่ล็อกยูส รวมเกมคัดเกรดคุณภาพระดับ A-List ไว้ในกระเป๋าเดียว คลังเกมลิขสิทธิ์แท้ส่งตรงจากค่ายยักษ์ใหญ่ระดับโลกทั้ง PG Soft, Pragmatic Play และ Joker Gaming อัดแน่นลูกเล่นทั้งตัวคูณสะสม Multiplier สัญลักษณ์ Expanding Wild ขยายเต็มรีล และโหมดซื้อฟรีสปินพุ่งตรงเข้าลุ้นโบนัส พร้อมสิทธิประโยชน์ที่กดรับเองได้ผ่านหน้าแดชบอร์ด ทั้งโบนัสต้อนรับสมาชิกใหม่ โปรเติมเงินฝากแรกของวัน และสิทธิ์คืนยอดเสีย Cash Back ทุกวัน เงื่อนไขชัดเจน ไม่ติดเทิร์นโอเวอร์มหาโหด ฝากถอนด้วยระบบออโต้ไฮสปีดผ่าน Gateway ตรง รองรับทั้งสถาบันการเงินชั้นนำและ TrueMoney Wallet ทำรายการเสร็จใน 3 วินาที ไม่ต้องส่งสลิปยืนยัน ถอนกำไรได้ครบเต็มจำนวนทุกบาท ปลอดภัยชัวร์ 100% ด้วยการเข้ารหัส SSL",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="ติดต่อ SETH88 | ศูนย์บริการสมาชิกสล็อตเว็บตรง ทักแอดมินผ่าน LINE" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน SETH88" as="h1">
    <div>
      <Picture
        src={imgLine}
        alt="หญิงสาวผมยาวสีน้ำตาลยิ้ม สวมชุดเลื่อมสีชมพูคอวีและต่างหูระย้า ยืนกอดอกอยู่หลังแถบสีขาวที่มีไอคอน LINE สีเขียวและคำว่า Support ช่องทางแชตกับทีมงาน SETH88"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 495px) calc(100vw - 6rem), 400px"
        class="mx-auto h-auto w-full max-w-[400px] object-contain drop-shadow-[0_10px_30px_rgba(224,169,43,0.35)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={60}
      />
      {
        BRAND_ADDRESS.lines.length > 0 && (
          <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 rounded-xl border border-white/15 bg-black/20 p-4 text-left text-sm leading-relaxed not-italic opacity-90">
            <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
              <span aria-hidden="true" class="text-sm">
                📍
              </span>
              {BRAND_ADDRESS.label}
            </p>
            {BRAND_ADDRESS.lines.map((line) => (
              <span class="block">{line}</span>
            ))}
            {BRAND_ADDRESS.email && (
              <a
                href={`mailto:${BRAND_ADDRESS.email}`}
                class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                <span aria-hidden="true" class="text-sm">
                  ✉️
                </span>
                {BRAND_ADDRESS.email}
              </a>
            )}
          </address>
        )
      }

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก SETH88"
          class="flex items-center justify-center rounded-lg border border-[#f7d774]/70 bg-gradient-to-r from-[#f7d774] via-[#e0a92b] to-[#a9711a] px-8 py-3 font-extrabold text-[#0c0703] shadow-[0_10px_30px_rgba(224,169,43,0.4)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(247,215,116,0.5)]">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ SETH88"
          class="flex items-center justify-center rounded-lg border border-[#f7d774]/60 bg-gradient-to-r from-[#6b4210] to-[#2a1a0d] px-8 py-3 font-bold text-[#fdf3d4] shadow-[0_4px_14px_rgba(107,66,16,0.45)] transition-transform hover:scale-105 hover:border-[#fdf3d4] hover:shadow-[0_10px_30px_rgba(247,215,116,0.5)]">
          เข้าสู่ระบบ
        </a>

        <a
          href="/line"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="ติดต่อทีมงานผ่าน Line Official"
          class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
          ติดต่อผ่าน Line Official
        </a>
      </div>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
