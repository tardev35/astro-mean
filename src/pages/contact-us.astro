---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

// This page is a BUTTON PAGE, not an article: title, LINE image, address block,
// button row — and nothing else. No section heading, no explanatory paragraph.
// The docx gives it a Title and a Meta and never a body; every paragraph that
// has ever appeared here was invented by a rebrand and pushed the buttons
// further down.
//
// The address block is read from lib/brandProfile — never retype the lines, and
// never let any of it reach the JSON-LD. It is visible text only.
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count reads ~3x
// too long and will send you rewriting a description that was fine). This one
// measures 153.
const pageDescription =
  "ช่องทางติดต่อทีมงาน MACAUBET สล็อตฟอร์มใหญ่ ฟีลมาเก๊าเต็มหน้าสปิน ทักผ่าน LINE Official สอบถามเรื่องสมัครสมาชิก เข้าสู่ระบบ โปรโมชั่น และสถานะฝากถอนออโต้";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน MACAUBET",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "MACAUBET สล็อตฟอร์มใหญ่ ยกฟีลมาเก๊ามาไว้หน้าสปิน ระบบตรงโอนไวออโต้ภายใน 3 วิ เกมดังมีครบ โต๊ะสดมีพร้อม เมนูใช้ง่าย การันตีเล่นง่ายได้กำไรจริง",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="ติดต่อเรา MACAUBET แจ้งปัญหาสมัครสมาชิกและฝากถอนออโต้ ผ่าน LINE" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน MACAUBET" as="h1">
    <div>
      <Picture
        src={imgLine}
        alt="พนักงานหญิงยิ้มในชุดเลื่อมสีชมพู ยืนอยู่เหนือปุ่ม LINE Support สีเขียว ช่องทางแชตกับทีมงาน MACAUBET"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 495px) calc(100vw - 6rem), 400px"
        class="mx-auto h-auto w-full max-w-[400px] object-contain drop-shadow-[0_10px_30px_rgba(89,203,19,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={60}
      />
      {
        BRAND_ADDRESS.lines.length > 0 && (
          <address
            aria-label={BRAND_ADDRESS.label}
            class="mt-8 mb-8 border-l-4 border-[#3b9b0d] pl-6 text-left text-base leading-relaxed text-[#e9f9dc] not-italic">
            <p class="mb-1 font-bold text-[#8ef04a]">{BRAND_ADDRESS.label}</p>
            {BRAND_ADDRESS.lines.map((line) => (
              <span class="block">{line}</span>
            ))}
            {BRAND_ADDRESS.email && (
              <span class="mt-3 block">
                <span aria-hidden="true" class="mr-2">✉️</span>
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#8ef04a] underline decoration-current/40 underline-offset-4">
                  {BRAND_ADDRESS.email}
                </a>
              </span>
            )}
          </address>
        )
      }

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก MACAUBET"
          class="flex items-center justify-center rounded-lg border border-[#f6c445]/60 bg-gradient-to-r from-[#dcffc0] via-[#8ef04a] to-[#59cb13] px-8 py-3 font-bold text-[#041b06] shadow-[0_10px_30px_rgba(89,203,19,0.35)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(142,240,74,0.45)]">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ MACAUBET"
          class="flex items-center justify-center rounded-lg border border-[#3b9b0d]/50 bg-gradient-to-r from-[#0a2c0d] to-[#020b01] px-8 py-3 font-extrabold text-[#8ef04a] shadow-[0_4px_14px_rgba(59,155,13,0.25)] transition-transform hover:scale-105 hover:shadow-[0_10px_30px_rgba(59,155,13,0.4)]">
          เข้าสู่ระบบ
        </a>

        <a
          href="/line"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="ติดต่อทีมงานผ่าน Line Official"
          class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
          ติดต่อผ่าน Line Official
        </a>
      </div>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
