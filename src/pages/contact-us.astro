---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

// This page is a BUTTON PAGE, not an article: title, LINE image, address block,
// button row — and nothing else. No section heading, no explanatory paragraph.
// The docx gives it a Title and a Meta and never a body; every paragraph that
// has ever appeared here was invented by a rebrand and pushed the buttons
// further down.
//
// The address block is read from lib/brandProfile — never retype the lines, and
// never let any of it reach the JSON-LD. It is visible text only. It also
// carries NO brand hex on purpose (border-white/15, bg-black/20, opacity over
// the inherited text colour): that is what stops the previous brand's colour
// being left behind here on the next launch.
//
// ASHTON168: AnnouncementCyber → AnnouncementPremium ตามการหมุน variant รอบนี้
// (เรียก Announcement แบบ bare เพราะ default message ของ variant นี้เป็นข้อความ
// ของแบรนด์นี้แล้ว) ส่วนกล่องยังเป็น ContentBoxPremium ตามที่ SKILL.md ปักไว้ให้
// หน้าย่อยทุกหน้าใช้ร่วมกัน
// ปุ่มย้ายมาเป็นทองคำคู่โครมเงินของรอบนี้ — ปุ่มหลักไล่ทอง #ffe9a3 / #f5c518 /
// #7a5405 ตัวอักษรเข้ม #080502 ปุ่มรองเป็นผิวยกขึ้น #160e03 ขอบ #c8941a
// เนื้อความ #f0e6d2 hover เป็น #7a5405 คู่ตัวอักษร #ffe9a3
// เขียว LINE คงเดิมเพราะเป็นสีแบรนด์ของ LINE ไม่ใช่สีของเว็บนี้
//
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count reads ~3x
// too long and will send you rewriting a description that was fine). This one
// measures 157.
const pageDescription = "ช่องทางติดต่อ ASHTON168 แอดมินดูแลตลอด 24 ชม. สอบถามการใช้งาน แจ้งปัญหาฝากถอน หรือขอรับสิทธิ์โบนัสได้เลย ทักผ่าน LINE Official ได้ทันที ตอบไว ไม่ต้องรอคิวนาน";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน ASHTON168",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "ASHTON168 สล็อตระบบแน่น เกมพร้อมรันจากค่ายชั้นนำ จัดหมวดตัวฮิตให้เลือกง่าย ออโต้ไวทันใจ โปรคุ้มสุด ๆ เติมโบนัสและสิทธิพิเศษให้ตามได้ทุกวัน",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="ติดต่อ ASHTON168 | ศูนย์บริการลูกค้า สอบถาม-แจ้งปัญหาได้ 24 ชั่วโมง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน ASHTON168" as="h1">
    <div>
      <Picture
        src={imgLine}
        alt="พนักงานหญิงยิ้มในชุดเลื่อมสีชมพู ยืนอยู่เหนือปุ่ม LINE Support สีเขียว ช่องทางแชตกับทีมงาน ASHTON168"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 495px) calc(100vw - 6rem), 400px"
        class="mx-auto h-auto w-full max-w-[400px] object-contain drop-shadow-[0_10px_30px_rgba(245,197,24,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={60}
      />
      {
        BRAND_ADDRESS.lines.length > 0 && (
          <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 rounded-xl border border-white/15 bg-black/20 p-4 text-left text-sm leading-relaxed not-italic opacity-90">
            <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
              <span aria-hidden="true" class="text-sm">
                📍
              </span>
              {BRAND_ADDRESS.label}
            </p>
            {BRAND_ADDRESS.lines.map((line) => (
              <span class="block">{line}</span>
            ))}
            {BRAND_ADDRESS.email && (
              <a
                href={`mailto:${BRAND_ADDRESS.email}`}
                class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                <span aria-hidden="true" class="text-sm">
                  ✉️
                </span>
                {BRAND_ADDRESS.email}
              </a>
            )}
          </address>
        )
      }

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก ASHTON168"
          class="flex items-center justify-center rounded-lg border border-[#ffe9a3]/60 bg-gradient-to-r from-[#ffe9a3] via-[#f5c518] to-[#7a5405] px-8 py-3 font-extrabold text-[#080502] shadow-[0_10px_30px_rgba(245,197,24,0.4)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(226,229,233,0.45)]">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ ASHTON168"
          class="flex items-center justify-center rounded-lg border border-[#c8941a]/60 bg-[#160e03] px-8 py-3 font-bold text-[#f0e6d2] shadow-[0_4px_14px_rgba(200,148,26,0.35)] transition-transform hover:scale-105 hover:bg-[#7a5405] hover:text-[#ffe9a3] hover:shadow-[0_10px_30px_rgba(245,197,24,0.4)]">
          เข้าสู่ระบบ
        </a>

        <a
          href="/line"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="ติดต่อทีมงานผ่าน Line Official"
          class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
          ติดต่อผ่าน Line Official
        </a>
      </div>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
