---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

// This page is a BUTTON PAGE, not an article: title, LINE image, address block,
// button row — and nothing else. No section heading, no explanatory paragraph.
// The docx gives it a Title and a Meta and never a body; every paragraph that
// has ever appeared here was invented by a rebrand and pushed the buttons
// further down. h2 and h3 here must both stay 0.
//
// The <h1> names what the page IS ("ติดต่อทีมงาน CK1968"), not what an article
// on it would argue. A title that previews a body reads as a broken promise
// once the body is (correctly) absent.
//
// The address block is read from lib/brandProfile — never retype the lines, and
// never let any of it reach the JSON-LD. It is visible text only. It also
// carries NO brand hex on purpose (border-white/15, bg-black/20, opacity over
// the inherited text colour): that is what stops the previous brand's colour
// being left behind here on the next launch.
//
// CK1968: ticker หมุนมาเป็น Announcement3 และกล่องหน้าย่อยใช้ ContentBox ตาม
// สเปกรอบนี้ (เรียก <Announcement /> เปล่าๆ เพราะ default message ของ variant
// นี้เป็นข้อความของแบรนด์นี้แล้ว และตรงกับหน้าแรก)
//
// พาเลตต์รอบนี้เป็น "ทองคำ + แดงเลือดหมู บนดำอมน้ำตาล" และแดงเป็นสีที่สองจริง
// ไม่ใช่เงาของทอง ปุ่มสมัครสมาชิกไล่สีทอง #ffefc4 / #f0a80c / #a76806 ขอบ
// #ffd45c ตัวอักษรผิวเข้ม #090302 · ปุ่มเข้าสู่ระบบไล่สีแดง #d4090f / #8c0206
// ขอบ #ff4b52 เนื้อความ #ffefc4
// เขียว LINE คงเดิมเพราะเป็นสีแบรนด์ของ LINE ไม่ใช่สีของเว็บนี้
//
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count reads ~3x
// too long and will send you rewriting a description that was fine). This one
// measures 154.
const pageDescription =
  "ช่องทางติดต่อทีมงาน CK1968 สล็อตเว็บตรงแบรนด์แท้ 100% ทักแอดมินผ่าน LINE Official เพื่อสอบถามการเข้าเล่น แจ้งปัญหาฝากถอนออโต้ หรือขอรับสิทธิ์โปรโมชั่นใหม่";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน CK1968",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName:
      "CK1968 สล็อตเว็บตรง แบรนด์แท้ 100% ที่นักปั่นไว้วางใจ ผู้ให้บริการลิขสิทธิ์แท้ที่ส่งตรงเกมจากค่ายดังทั่วโลก นำเข้าระบบ API แท้จากเซิร์ฟเวอร์หลักของค่ายเกมโดยตรง อัตราการแตก RTP เป็นมาตรฐานสากล ไม่มีการแอบปรับลดเปอร์เซ็นต์การชนะ ไม่มีการล็อคยูสเซอร์เมื่อเล่นได้กำไรก้อนโต พร้อมระบบ AI จัดการธุรกรรมการเงินอัตโนมัติเต็มรูปแบบ ฝากถอนไม่มีขั้นต่ำ และโอนจ่ายจริงเต็มจำนวนทุกบิลโดยไม่หักค่าธรรมเนียม",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="ติดต่อ CK1968 | ศูนย์บริการสมาชิกสล็อตเว็บตรงแบรนด์แท้ ทักแอดมินผ่าน LINE" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน CK1968" as="h1">
    <div>
      <Picture
        src={imgLine}
        alt="หญิงสาวผมยาวสีน้ำตาลยิ้ม สวมชุดเลื่อมสีชมพูคอวีและต่างหูระย้า ยืนกอดอกอยู่หลังแถบสีขาวที่มีไอคอน LINE สีเขียวและคำว่า Support ช่องทางแชตกับทีมงาน CK1968"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 495px) calc(100vw - 6rem), 400px"
        class="mx-auto h-auto w-full max-w-[400px] object-contain drop-shadow-[0_10px_30px_rgba(240,168,12,0.35)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={60}
      />
      {
        BRAND_ADDRESS.lines.length > 0 && (
          <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 rounded-xl border border-white/15 bg-black/20 p-4 text-left text-sm leading-relaxed not-italic opacity-90">
            <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
              <span aria-hidden="true" class="text-sm">
                📍
              </span>
              {BRAND_ADDRESS.label}
            </p>
            {BRAND_ADDRESS.lines.map((line) => (
              <span class="block">{line}</span>
            ))}
            {BRAND_ADDRESS.email && (
              <a
                href={`mailto:${BRAND_ADDRESS.email}`}
                class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                <span aria-hidden="true" class="text-sm">
                  ✉️
                </span>
                {BRAND_ADDRESS.email}
              </a>
            )}
          </address>
        )
      }

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก CK1968"
          class="flex items-center justify-center rounded-lg border border-[#ffd45c]/70 bg-gradient-to-r from-[#ffefc4] via-[#f0a80c] to-[#a76806] px-8 py-3 font-extrabold text-[#090302] shadow-[0_10px_30px_rgba(240,168,12,0.35)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,212,92,0.5)]">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ CK1968"
          class="flex items-center justify-center rounded-lg border border-[#ff4b52]/60 bg-gradient-to-r from-[#d4090f] to-[#8c0206] px-8 py-3 font-bold text-[#ffefc4] shadow-[0_4px_14px_rgba(140,2,6,0.45)] transition-transform hover:scale-105 hover:border-[#ffd45c] hover:shadow-[0_10px_30px_rgba(212,9,15,0.5)]">
          เข้าสู่ระบบ
        </a>

        <a
          href="/line"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="ติดต่อทีมงานผ่าน Line Official"
          class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
          ติดต่อผ่าน Line Official
        </a>
      </div>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
