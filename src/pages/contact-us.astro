---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

// This page is a BUTTON PAGE, not an article: title, LINE image, address block,
// button row — and nothing else. No section heading, no explanatory paragraph.
// The docx gives it a Title and a Meta and never a body; every paragraph that
// has ever appeared here was invented by a rebrand and pushed the buttons
// further down. h2 and h3 here must both stay 0.
//
// The <h1> names what the page IS ("ติดต่อทีมงาน VIPSAND356"), not what an
// article on it would argue. A title that previews a body reads as a broken
// promise once the body is (correctly) absent.
//
// The address block is read from lib/brandProfile — never retype the lines, and
// never let any of it reach the JSON-LD. It is visible text only. It also
// carries NO brand hex on purpose (border-white/15, bg-black/20, opacity over
// the inherited text colour): that is what stops the previous brand's colour
// being left behind here on the next launch.
//
// VIPSAND356: ticker หมุนมาเป็น AnnouncementCyber และกล่องหน้าย่อยใช้ ContentBox
// ตามสเปกรอบนี้ (เรียก <Announcement /> เปล่าๆ เพราะ default message ของ variant
// นี้เป็นข้อความของแบรนด์นี้แล้ว และตรงกับหน้าแรก)
//
// พาเลตต์รอบนี้เป็น "อะซูร์คู่ทองส้มบนกรมท่าเข้ม" วอลเปเปอร์ของเว็บเป็นฟ้าสว่าง
// การ์ดจึงเป็นกระจกกรมท่าลอยอยู่บนพื้นฟ้า ปุ่มสมัครสมาชิกซึ่งเป็นปุ่มหลักไล่สีทอง
// สว่าง #fcde61 / #eba554 / #c07c20 ขอบ #fcde61 เนื้อความ #061c33 · ปุ่มเข้าสู่ระบบ
// เป็นปุ่มรองจึงไล่สีฟ้าเข้ม #1465a8 / #0b3f70 ขอบ #5dbcfe เนื้อความ #eaf6ff
// เขียว LINE คงเดิมเพราะเป็นสีแบรนด์ของ LINE ไม่ใช่สีของเว็บนี้
//
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count reads ~3x
// too long and will send you rewriting a description that was fine). This one
// measures 156.
const pageDescription = "ช่องทางติดต่อทีมงาน VIPSAND356 สล็อตของพรีเมียม ทักแอดมินผ่าน LINE Official ตลอด 24 ชั่วโมง สอบถามวิธีเข้าเกม แจ้งปัญหาฝากถอนออโต้ หรือขอรับสิทธิ์โปรที่เปิด";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน VIPSAND356",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName:
      "VIPSAND356 สล็อตของพรีเมียม คัดเกมเด็ดมาเต็ม บริการระดับ VIP เว็บตรงสล็อตพรีเมียม API แท้ ยิงตรงจากคลังเกมหลักสากล ไม่ผ่านเอเย่นต์ ค่า RTP ตรงตามสเปกโรงงานผู้พัฒนา ไร้การดัดแปลงระบบ ไม่ล็อกยูส คัดเฉพาะเกมเกรด A-List ที่จ่ายรางวัลโปร่งใสและโบนัสแจ็คพอตแตกง่ายมาจัดหมวดหมู่ไว้ในล็อบบี้เดียว ขนทัพค่ายเกมชั้นนำระดับโลกทั้ง PG Soft, Pragmatic Play, Joker Gaming และอีกมากมาย ครบทุกแนวทั้งสล็อตวิดีโอ 3D สล็อตคลาสสิกตัวคูณหนัก และสล็อตสายซื้อฟรีสปิน อัดแน่นฟีเจอร์ยุคใหม่ทั้ง Multiplier สะสมตัวคูณทวีคูณ Expanding Wild ยืดเต็มรีล คอมโบแตกต่อเนื่อง Cascading และโหมด Bonus Buy พร้อมโปรน่าตามที่กดรับเองผ่านหน้าเว็บได้เรื่อยๆ ทั้งโบนัสต้อนรับสมาชิกใหม่ โปรฝากแรกของวัน และคืนยอดเสีย Cash Back ทุกวัน เงื่อนไขชัดเจน ไม่ติดเทิร์นโอเวอร์ซับซ้อน ฝากถอนด้วยระบบออโต้ไฮสปีดผ่าน Gateway ตรงเสร็จใน 3 วินาที รองรับทุกช่องทางการเงิน ไม่ต้องส่งสลิป การันตีถอนได้เต็มทุกยอด ดูแลโดยทีมงานแอดมินมืออาชีพสแตนด์บายตลอด 24 ชั่วโมง",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="ติดต่อ VIPSAND356 | ศูนย์บริการสมาชิกสล็อตของพรีเมียม ทักแอดมินผ่าน LINE" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน VIPSAND356" as="h1">
    <div>
      <Picture
        src={imgLine}
        alt="หญิงสาวผมยาวสีน้ำตาลยิ้ม สวมชุดเลื่อมสีชมพูคอวีและต่างหูระย้า ยืนกอดอกอยู่หลังแถบสีขาวที่มีไอคอน LINE สีเขียวและคำว่า Support ช่องทางแชตกับทีมงาน VIPSAND356"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 495px) calc(100vw - 6rem), 400px"
        class="mx-auto h-auto w-full max-w-[400px] object-contain drop-shadow-[0_10px_30px_rgba(235,165,84,0.35)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
      {
        BRAND_ADDRESS.lines.length > 0 && (
          <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 rounded-xl border border-white/15 bg-black/20 p-4 text-left text-sm leading-relaxed not-italic opacity-90">
            <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
              <span aria-hidden="true" class="text-sm">
                📍
              </span>
              {BRAND_ADDRESS.label}
            </p>
            {BRAND_ADDRESS.lines.map((line) => (
              <span class="block">{line}</span>
            ))}
            {BRAND_ADDRESS.email && (
              <a
                href={`mailto:${BRAND_ADDRESS.email}`}
                class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                <span aria-hidden="true" class="text-sm">
                  ✉️
                </span>
                {BRAND_ADDRESS.email}
              </a>
            )}
          </address>
        )
      }

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก VIPSAND356"
          class="flex items-center justify-center rounded-lg border border-[#fcde61]/70 bg-gradient-to-r from-[#fcde61] via-[#eba554] to-[#c07c20] px-8 py-3 font-extrabold text-[#061c33] shadow-[0_10px_30px_rgba(235,165,84,0.4)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(252,222,97,0.5)]">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ VIPSAND356"
          class="flex items-center justify-center rounded-lg border border-[#5dbcfe]/60 bg-gradient-to-r from-[#1465a8] to-[#0b3f70] px-8 py-3 font-bold text-[#eaf6ff] shadow-[0_4px_14px_rgba(11,63,112,0.45)] transition-transform hover:scale-105 hover:border-[#eaf6ff] hover:shadow-[0_10px_30px_rgba(93,188,254,0.5)]">
          เข้าสู่ระบบ
        </a>

        <a
          href="/line"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="ติดต่อทีมงานผ่าน Line Official"
          class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
          ติดต่อผ่าน Line Official
        </a>
      </div>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
