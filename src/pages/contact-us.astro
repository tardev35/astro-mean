---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";

// One string, used three times: MainLayout's <meta name="description">, the
// WebPage node's description, and nothing else. Keeping it in a const is what
// stops the meta tag and the structured data from drifting apart — they used to
// be two hand-typed variants of the same sentence, and the JSON-LD copy was the
// one nobody reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count
// reads ~3x too long and will send you rewriting a description that was fine).
const pageDescription =
  "ช่องทางติดต่อทีมงาน KUMI99 ผ่าน LINE Official สำหรับปัญหาสมัครสมาชิก เข้าสู่ระบบ โบนัส และสถานะฝากถอนออโต้ พร้อมข้อมูลที่ควรเตรียมให้ครบก่อนแจ้งเรื่องกับแอดมิน";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน KUMI99 ผ่าน LINE Official",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "KUMI99 สล็อตออนไลน์ตัวท็อป เกมใหม่มาแรง ฝากถอนไวภายใน 3 วิ",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="ติดต่อเรา KUMI99 แจ้งปัญหาสมัครสมาชิก ฝากถอนออโต้ และโบนัส ผ่าน LINE" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน KUMI99" as="h1">
    <div>
      <h2 class="mb-6 text-2xl leading-normal font-bold text-[#fcda3d]">ติดปัญหาสมัครสมาชิก เข้าสู่ระบบ โบนัส หรือสถานะฝากถอน ทักทีมงาน KUMI99 ทางไหน</h2>

      <Picture
        src={imgLine}
        alt="พนักงานหญิงยิ้มในชุดเลื่อมสีชมพู ยืนอยู่เหนือปุ่ม LINE Support สีเขียว ช่องทางแชตกับทีมงาน KUMI99"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 495px) calc(100vw - 6rem), 400px"
        class="mx-auto h-auto w-full max-w-[400px] object-contain drop-shadow-[0_10px_30px_rgba(252,218,61,0.16)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={60}
      />

      <p class="my-5 text-left text-base leading-relaxed">
        ช่องทางหลักของ <strong class="text-[#ffe98a]">KUMI99</strong> คือ LINE Official ที่แสดงอยู่บนหน้าเว็บ ใช้ได้ตั้งแต่ขั้นตอนสมัครสมาชิกที่ใช้เบอร์โทรศัพท์และรหัสผ่านเป็นข้อมูลหลัก
        ไปจนถึงการเข้าสู่ระบบด้วยเบอร์โทร การกู้คืนรหัสผ่านเมื่อเข้าบัญชีไม่ได้ การหาเกมสล็อตจากค่ายที่เพิ่งอัปเดตเข้ามาใหม่ การกดรับโบนัสและคืนยอดเสีย
        รวมถึงการตรวจสถานะรายการฝากถอนออโต้ที่ส่งไปแล้ว
        ระบบฝากถอนไวภายใน 3 วิ ของที่นี่ทำงานอัตโนมัติทั้งขาเข้าและขาออก ถ้ายอดยังไม่เปลี่ยนหรือรายการยังไม่ขึ้นสถานะ ให้ทักมาพร้อมเวลาทำรายการและภาพหน้าจอแทนการกดซ้ำ
        เพราะรายการซ้ำใช้เวลาตรวจย้อนหลังนานกว่าการรอรอบเดิมเสียอีก
      </p>

      <h2 class="mt-8 mb-6 text-2xl leading-normal font-bold text-[#fcda3d]">ควรเตรียมข้อมูลอะไรก่อนแจ้งเรื่อง และอะไรที่ห้ามส่งให้ใครเด็ดขาด</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        ก่อนทักเข้ามา ควรเตรียมเบอร์โทรศัพท์ที่ใช้สมัคร เวลาที่ทำรายการ ชื่อบัญชีธนาคารและยอดเงินที่โอน ถ้าเป็นเรื่องเกมให้ระบุค่ายและชื่อเกม ยอดเดิมพันต่อรอบ และเวลาที่กด
        ถ้าเป็นเรื่องโปรโมชั่นให้ระบุชื่อโปรที่กดรับและยอดฝากที่ใช้รับสิทธิ์ เพราะยอดขั้นต่ำ จำนวนเทิร์น เกมที่ร่วมรายการ และเพดานถอนของแต่ละโปรไม่เท่ากัน
        แนบภาพหน้าจอที่เกี่ยวข้องมาด้วย ข้อมูลครบตั้งแต่ข้อความแรกช่วยได้มากกว่าการเล่าเป็นตอน ๆ
        KUMI99 มีทีมงานดูแลผู้เล่นตลอดเวลาและจ่ายเต็มทุกยอดตามเงื่อนไขที่ประกาศไว้ เรื่องที่ทักเข้ามาส่วนใหญ่จึงเป็นการเช็กสถานะรายการหรือถามเงื่อนไขโบนัส มากกว่าการตามเงินที่หายไป
        ที่สำคัญคือไม่ควรส่งรหัสผ่านหรือ OTP ให้ผู้อื่นไม่ว่ากรณีใด ทีมงานไม่มีความจำเป็นต้องขอสองอย่างนี้ ต่อให้อีกฝั่งพิมพ์มาสุภาพแค่ไหน รหัสชุดนี้ก็ไม่ได้มีไว้แบ่งปัน
        หากลืมรหัสควรใช้เมนูกู้คืนจากระบบโดยตรง และควรติดต่อผ่านช่องทางที่แสดงบนเว็บไซต์จริงเท่านั้น ไม่ใช่ลิงก์ที่เด้งมาจากข้อความส่วนตัว
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก KUMI99"
          class="flex items-center justify-center rounded-lg border border-[#fcda3d]/60 bg-gradient-to-b from-[#ffe98a] via-[#fcda3d] to-[#a9760d] px-8 py-3 font-bold text-[#2a1400] shadow-[0_10px_30px_rgba(252,218,61,0.16)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(252,218,61,0.28)]">
          สมัครสมาชิก
        </a>

        <a
          href="/login"
          aria-label="เข้าสู่ระบบ KUMI99"
          class="flex items-center justify-center rounded-lg border border-[#c77dff]/60 bg-[#1a0b2e] px-8 py-3 font-extrabold text-[#ffe98a] shadow-[0_4px_14px_rgba(199,125,255,0.22)] transition-transform hover:scale-105 hover:bg-[#2c014b]">
          เข้าสู่ระบบ
        </a>

        <a
          href="/line"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="ติดต่อทีมงานผ่าน Line Official"
          class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
          ติดต่อผ่าน Line Official
        </a>
      </div>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
