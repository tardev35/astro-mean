---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";

// Named for the promotion each banner ACTUALLY shows, not for its file number.
// A previous brand's copy on this page described a completely different set of
// offers while rendering these same four images — the text and the artwork
// disagreed on every card. Reading the banner is the only way to write this
// page. The ZEED321 drop (2026-08-05) reads:
//   slide1 = ทุกยอดฝาก 10% รับโบนัสสูงสุด 500 บาท
//   slide2 = เสีย 5 ฟรี 1 คืนยอดเสียสูงสุด 300 บาท เทิร์น 10 เท่า ถอนสูงสุด 1,000
//   slide3 = แนะนำเพื่อน รับ BONUS 10% ไม่จำกัดจำนวนเพื่อน
//   slide4 = ฝากครั้งแรกของวัน 50→60 / 100→130 / 300→390 / 500→600 / 1,000→1,200
import proDeposit10 from "../assets/slide1.png";
import proFirstOfDay from "../assets/slide4.png";
import proCashback from "../assets/slide2.png";
import proReferral from "../assets/slide3.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 158.
const pageDescription = "รวมโปรโมชั่น ZEED321 เว็บสล็อตสายมันส์ ทุกยอดฝากรับโบนัส 10% สูงสุด 500 บาท เสีย 5 ฟรี 1 คืนยอดเสียสูงสุด 300 บาท และแนะนำเพื่อนรับ 10% พร้อมเงื่อนไขก่อนกดรับ";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น ZEED321 ฝากรับ 10% เสีย 5 ฟรี 1 และแนะนำเพื่อนรับ 10%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: proDeposit10.src,
});

// Drawn one-up on phones inside the box's own padding (px-4 + p-8 = 6rem) and
// two-up from sm: upward inside the same padding plus a 2rem gap (8rem total).
const imageSizes = "(max-width: 639px) calc(100vw - 6rem), (max-width: 1456px) calc((100vw - 8rem) / 2), 600px";

const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#ff2f28]/35 object-contain shadow-[0_10px_30px_rgba(255,47,40,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff2f28]/70 hover:shadow-[0_15px_40px_rgba(255,47,40,0.32)]";
---

<MainLayout title="โปรโมชั่น ZEED321 ฝากรับ 10% เสีย 5 ฟรี 1 และแนะนำเพื่อนรับ 10%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น ZEED321" as="h1">
    <div>
      <h2 class="mb-4 text-2xl leading-normal font-bold text-[#f5c542]">โปรโมชั่น ZEED321 ต้องอ่านเงื่อนไขตรงไหนก่อนกดรับ</h2>

      <p class="mb-5 text-left text-base leading-relaxed">
        <strong class="text-[#ffe08a]">ZEED321</strong> เป็นเว็บสล็อตสายมันส์ที่รวมเกมครบมือจากค่ายแท้ไว้ในบัญชีเดียว โปรโมชั่นที่หน้าเว็บเปิดให้กดรับจึงผูกอยู่กับยอดฝากจริงและเกมที่ร่วมรายการ ไม่ได้ลอยอยู่เดี่ยว
        ๆ ในหน้าโปร ตัวเลขใหญ่บนแบนเนอร์บอกได้แค่ว่ามีอะไรให้ ส่วนบรรทัดเล็กใต้ตัวเลขคือคนที่ตัดสินว่าเราได้จริงเท่าไร ก่อนกดรับจึงควรไล่ให้ครบทั้งห้าข้อ คือยอดที่ใช้คำนวณ เปอร์เซ็นต์ที่ได้รับจริง จำนวนเทิร์น
        เกมที่ร่วมรายการ และเพดานถอน เพราะโปรแต่ละรายการกำหนดเงื่อนไขไม่เหมือนกัน การเลือกจากเปอร์เซ็นต์ที่สูงที่สุดเพียงอย่างเดียวจึงไม่ใช่วิธีที่ปลอดภัยที่สุด
      </p>

      <p class="mb-8 text-left text-base leading-relaxed">
        รายการที่เห็นบนหน้าโปรของ ZEED321 รอบนี้มีสี่ก้อนที่ใช้เงื่อนไขคนละชุดกัน คือทุกยอดฝากรับโบนัส 10% สูงสุด 500 บาท และโบนัสฝากครั้งแรกของวันที่ระบุขั้นบันไดไว้ตั้งแต่ฝาก 50 รับ 60 ไปจนถึงฝาก
        1,000 รับ 1,200 ซึ่งก้อนหลังระบุบนแบนเนอร์ว่าต้องทำยอด 2 เท่า ถอนได้สูงสุด 20 เท่า และเฉพาะสล็อตเท่านั้น ถัดมาคือเสีย 5 ฟรี 1 ที่คืนยอดเสียให้สูงสุด 300 บาท เทิร์น 10 เท่า ถอนสูงสุด 1,000 บาท
        และแนะนำเพื่อนที่รับโบนัส 10% แบบไม่จำกัดจำนวนเพื่อน ตัวเลขเหล่านี้ควรใช้เป็นข้อมูลตั้งต้นแล้วตรวจจากหน้าโปรจริงอีกครั้งก่อนกด เพราะช่วงเวลาของสิทธิ์ ค่ายเกมที่ยกเว้น
        และการรับซ้อนกับรายการอื่นเป็นรายละเอียดที่เปลี่ยนได้ตามรอบ ถ้าแผนของเราคือหมุนตามงบแล้วปิดจบ การไม่รับสิทธิ์เลยก็เป็นทางเลือกที่สมเหตุสมผล เพราะโบนัสที่ติดเทิร์นไม่ได้แปลว่าเงินอยู่ในมือแล้ว
      </p>

      <h2 class="mt-10 mb-4 text-2xl leading-normal font-bold text-[#f5c542]">รายการโปรโมชั่นทั้งหมดที่ ZEED321 เปิดให้รับ</h2>

      <p class="mb-8 text-left text-base leading-relaxed">
        แบนเนอร์ด้านล่างคือรายการจริงที่เปิดให้รับอยู่ในรอบนี้ อ่านเงื่อนไขใต้ภาพให้ตรงกับสิ่งที่ตัวเองเล่นอยู่ก่อนตัดสินใจ เพราะสองรายการแรกเป็นโบนัสที่คิดจากยอดฝาก
        ส่วนคืนยอดเสียกับโบนัสแนะนำเพื่อนเป็นคนละก้อนที่คิดจากยอดคนละแบบ และมีเพดานถอนกับจำนวนเทิร์นของตัวเองแยกกัน
      </p>

      <div class="grid w-full grid-cols-1 gap-8 sm:grid-cols-2">
        <figure class="m-0">
          <Picture
            src={proDeposit10}
            alt="แบนเนอร์โปรโมชั่น ZEED321 ทุกยอดฝาก 10% รับโบนัสสูงสุด 500 บาท ตัวเลขทองบนกรอบแดงดำ พร้อมหญิงสาวชุดแดงถือไพ่ในบรรยากาศคาสิโน"
            loading="lazy"
            fetchpriority="low"
            widths={[300, 450, 600]}
            sizes={imageSizes}
            class={imageClass}
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={80}
          />
          <figcaption class="mt-3 text-left text-base leading-relaxed">
            <strong class="text-[#ffe08a]">ทุกยอดฝาก 10% รับโบนัสสูงสุด 500 บาท</strong> คิดจากยอดฝากของรอบนั้น ๆ ไม่ใช่ยอดคงเหลือในกระเป๋า และมีเพดานโบนัสที่ 500 บาทตามที่ระบุบนแบนเนอร์ ฝากเกินกว่านั้นโบนัสจะไม่เพิ่มตาม
          </figcaption>
        </figure>

        <figure class="m-0">
          <Picture
            src={proFirstOfDay}
            alt="แบนเนอร์โปรโมชั่น ZEED321 ฝากครั้งแรกของวัน ฝาก 50 รับ 60 ฝาก 100 รับ 130 ฝาก 300 รับ 390 ฝาก 500 รับ 600 และฝาก 1,000 รับ 1,200 ทำยอด 2 เท่า ถอนได้สูงสุด 20 เท่า"
            loading="lazy"
            fetchpriority="low"
            widths={[300, 450, 600]}
            sizes={imageSizes}
            class={imageClass}
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={80}
          />
          <figcaption class="mt-3 text-left text-base leading-relaxed">
            <strong class="text-[#ffe08a]">ฝากครั้งแรกของวัน รับตามขั้นบันได</strong> ใช้ได้กับบิลแรกของวันเท่านั้น แบนเนอร์ระบุว่าต้องทำยอด 2 เท่า ถอนได้สูงสุด 20 เท่า ห้ามรับโบนัสซื้อสปิน และนับเฉพาะเกมสล็อต
          </figcaption>
        </figure>

        <figure class="m-0">
          <Picture
            src={proCashback}
            alt="แบนเนอร์โปรโมชั่น ZEED321 เสีย 5 ฟรี 1 ใจดีคืนยอดเสียสูงสุด 300 บาท เทิร์น 10 เท่า ถอนสูงสุด 1,000 บาท เฉพาะเกมสล็อตเท่านั้น"
            loading="lazy"
            fetchpriority="low"
            widths={[300, 450, 600]}
            sizes={imageSizes}
            class={imageClass}
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={80}
          />
          <figcaption class="mt-3 text-left text-base leading-relaxed">
            <strong class="text-[#ffe08a]">เสีย 5 ฟรี 1 คืนยอดเสียสูงสุด 300 บาท</strong> คิดจากยอดเสียสุทธิ ไม่ใช่ยอดฝาก จึงเป็นรายการเดียวในหน้านี้ที่ไม่ต้องกดรับตอนเติมเงิน เงื่อนไขบนแบนเนอร์คือเทิร์น
            10 เท่า ถอนสูงสุด 1,000 บาท
          </figcaption>
        </figure>

        <figure class="m-0">
          <Picture
            src={proReferral}
            alt="แบนเนอร์โปรโมชั่น ZEED321 แนะนำเพื่อน ชวนเพื่อนเล่นกับเรารับทันที BONUS 10% ยิ่งชวนมากยิ่งได้มาก ไม่จำกัดจำนวนเพื่อน"
            loading="lazy"
            fetchpriority="low"
            widths={[300, 450, 600]}
            sizes={imageSizes}
            class={imageClass}
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={80}
          />
          <figcaption class="mt-3 text-left text-base leading-relaxed">
            <strong class="text-[#ffe08a]">แนะนำเพื่อน รับโบนัส 10% ไม่จำกัดจำนวนเพื่อน</strong> คิดจากเพื่อนที่สมัครผ่านลิงก์ของเราแล้วเข้าเล่นจริง แบนเนอร์ระบุว่ายิ่งชวนมากยิ่งได้มาก จึงเป็นก้อนที่โตตามจำนวนคน
            ไม่ได้โตตามยอดฝากของเราเอง
          </figcaption>
        </figure>
      </div>

      <h2 class="mt-12 mb-4 text-2xl leading-normal font-bold text-[#f5c542]">รับโปรแล้วต้องตรวจเทิร์นและยอดถอนอย่างไร</h2>

      <p class="mb-5 text-left text-base leading-relaxed">
        หลังกดรับสิทธิ์ควรเปิดหน้าประวัติรายการดูว่ายอดโบนัสเข้าครบ เทิร์นเดินถูกเกม และยอดคงเหลือตรงกับที่ระบบแสดง เพราะโบนัสฝากครั้งแรกของวันและรายการคืนยอดเสียระบุไว้ว่านับเฉพาะเกมสล็อต
        การหมุนในหมวดอื่นระหว่างที่เทิร์นยังไม่ครบจึงอาจไม่ถูกนับ อีกจุดที่คนอ่านข้ามบ่อยคือฐานที่ใช้คำนวณของแต่ละรายการ โบนัส 10% คิดจากยอดฝาก ส่วนเสีย 5 ฟรี 1 คิดจากยอดเสียสุทธิ
        และโบนัสแนะนำเพื่อนคิดจากเพื่อนที่เข้าเล่นจริง ทั้งสามตัวเลขจึงเทียบกันตรง ๆ ไม่ได้ และควรอ่านเงื่อนไขของแต่ละรายการแยกกันก่อนวางแผนหมุน
      </p>

      <p class="mb-8 text-left text-base leading-relaxed">
        ด้านการเงิน ZEED321 ใช้ระบบออโต้ที่แม่นยำ ผู้เล่นทำรายการเองได้ตลอดเวลาโดยไม่ต้องส่งสลิปให้แอดมินตรวจ ยอดเงินอัปเดตเข้ากระเป๋าตามสถานะระบบในช่วงนั้น
        ทำให้กลับไปลุ้นจังหวะต่อไปได้ต่อเนื่องแบบไม่มีสะดุด ก่อนทำรายการควรตรวจชื่อบัญชี ยอดเงิน และประวัติรายการให้ครบ หากยอดยังไม่เปลี่ยนไม่ควรกดซ้ำทันที
        เพราะนิ้วที่กดสองรอบไม่ได้ทำให้ธนาคารขยันขึ้น และควรกรอกข้อมูลเฉพาะบนโดเมนที่ตรวจแล้วและเชื่อมต่อแบบ HTTPS เท่านั้น ไม่ใช่ลิงก์ที่ส่งต่อกันมาในแชตพร้อมคำโฆษณา
      </p>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#f5c542]/60 bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#a97a10] px-10 py-3.5 text-lg font-black text-[#2a0605] shadow-[0_10px_30px_rgba(245,197,66,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,197,66,0.32)]">
          สมัครสมาชิก ZEED321
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
