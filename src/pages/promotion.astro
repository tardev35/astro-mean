---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";

// This page is an IMAGE page, not an article: the ContentBox title (the single
// <h1>), ONE short intro paragraph, the promo image grid, one CTA. Nothing
// else. The slides already print their own offer in large type, so prose below
// them re-types what the visitor can already read, in smaller letters. The docx
// gives this page a Title and a Meta and never a body.
//
// Named for the promotion each banner ACTUALLY shows, not for its file number.
// The DRACO65 drop (mtime 2026-08-15) is FOUR slides:
//   slide1 = โปรฝากรายวันสล็อต รับโบนัส 20% · ฝากครั้งแรกรับโบนัสทันที 20%
//   slide2 = ครบจบในเจ้าเดียว ถอนได้หลักล้าน · ดีดจากค่ายเกมโดยตรง ทุนหนากล้าจ่าย
//   slide3 = เล่นเสียรับคืนยอดเสีย คืนไม่จำกัด 5%
//   slide4 = สร้างรายได้แนะนำเพื่อน รับค่าคอม 5%
// The mapping between file number and promotion changes with every asset drop,
// so these imports follow the ARTWORK — that is the whole reason the variables
// are named after the promotion instead of after the file.
//
// banner.png / banner2-4.png (mtime 2026-08-04) are leftovers from an older
// brand and must never be imported here: an imported image is an emitted image
// even when nothing renders it. Only what is printed on each banner may be
// stated on this page.
import proDailyBonus20 from "../assets/slide1.png";
import proWithdrawMillion from "../assets/slide2.png";
import proCashback5 from "../assets/slide3.png";
import proReferral5 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 155.
const pageDescription =
  "รวมโปรโมชั่นของ DRACO65 สล็อตเว็บตรงไฟลุก ทั้งโบนัสฝากรายวัน 20% คืนยอดเสีย 5% และค่าคอมแนะนำเพื่อน 5% ดูเงื่อนไขของแต่ละรายการก่อนกดรับสิทธิ์ได้จากหน้านี้";

const pageTitle = "โปรโมชั่น DRACO65 โบนัสฝากรายวัน 20% คืนยอดเสีย 5% และค่าคอมแนะนำเพื่อน 5%";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: proDailyBonus20.src,
});

// Drawn one-up on phones inside the box's own padding (px-4 + p-8 = 6rem), then
// two-up from sm: inside that same padding plus one 2rem grid gap.
// ContentBoxPremium widens its padding at md: (p-8 → p-10) and caps at
// max-w-[1400px], so the column stops growing at 644px once the viewport passes
// 1432px.
const imageSizes =
  "(max-width: 639px) calc(100vw - 6rem), (max-width: 767px) calc((100vw - 8rem) / 2), (max-width: 1431px) calc((100vw - 9rem) / 2), 644px";

const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#22c55e]/35 object-contain shadow-[0_10px_30px_rgba(34,197,94,0.25)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e2e8e4]/70 hover:shadow-[0_15px_40px_rgba(74,222,128,0.45)]";

// Capped at 600 because that is the intrinsic width of every slide*.png in this
// drop — the column is drawn up to 644px, but asking for 644 only upscales a
// 600px source into a bigger file with no extra detail.
const imageWidths = [320, 440, 600];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น DRACO65" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed">
        แบนเนอร์ด้านล่างคือสิทธิ์ที่ <strong class="text-[#4ade80]">DRACO65</strong> เปิดให้รับอยู่ในรอบนี้ทั้งหมด ทั้งโบนัสฝากรายวัน ยอดถอนหลักล้าน สิทธิ์คืนยอดเสีย
        และค่าคอมจากการแนะนำเพื่อน แต่ละรายการคิดจากฐานคนละชุดและมีรอบเวลาของตัวเอง เงื่อนไขการทำยอด หมวดเกมที่ร่วมรายการ และยอดถอนสูงสุดต่อครั้งก็ไม่เหมือนกัน
        จึงควรอ่านรายละเอียดของรายการที่จะรับอีกครั้งก่อนกด
      </p>

      <div class="grid w-full grid-cols-1 gap-8 sm:grid-cols-2">
        <Picture
          src={proDailyBonus20}
          alt="แบนเนอร์โปรโมชั่น DRACO65 โปรฝากรายวันสล็อต รับโบนัส 20% ฝากเงินครั้งแรกรับโบนัสทันที 20%"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={proWithdrawMillion}
          alt="แบนเนอร์โปรโมชั่น DRACO65 ครบจบในเจ้าเดียว ถอนได้หลักล้าน การดีดจากค่ายเกมโดยตรง ทุนหนากล้าจ่าย"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={proCashback5}
          alt="แบนเนอร์โปรโมชั่น DRACO65 เล่นเสียรับคืนยอดเสีย คืนไม่จำกัด 5%"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={proReferral5}
          alt="แบนเนอร์โปรโมชั่น DRACO65 สร้างรายได้แนะนำเพื่อน รับค่าคอม 5%"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#e2e8e4]/60 bg-gradient-to-r from-[#4ade80] via-[#22c55e] to-[#14532d] px-10 py-3.5 text-lg font-black text-[#04150a] shadow-[0_10px_30px_rgba(34,197,94,0.4)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(74,222,128,0.45)]">
          สมัครสมาชิก DRACO65
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
