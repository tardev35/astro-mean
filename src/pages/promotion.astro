---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxFloatingBadge.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// This page is an IMAGE page, not an article: the ContentBox title (the single
// <h1>), ONE short intro paragraph, the promo image grid, one CTA. Nothing
// else — no <h2>, no section paragraphs. The slides already print their own
// offer in large type, so prose below them re-types what the visitor can
// already read, in smaller letters. The docx gives this page a Title and a
// Meta and never a body.
//
// Named for what each banner ACTUALLY prints, not for its file number.
// The LUCKYBKK drop (2026-08-21) is THREE usable slides, all 600x216:
//   slide1 = ฝากเพียง 200 บาท รับสิทธิ์สุดคุ้ม / เปิดกล่องสมบัติลุ้นสูงสุด 500 เพชร
//   slide2 = คืนยอดเสีย 8% ทุกวัน / ค่าคอมมิชชั่น 5% ทุกวัน ทุกยอดฝากเล่น
//   slide3 = รายได้แนะนำเพื่อน รับสูงสุด 2.5%
// The mapping between file number and artwork changes with every asset drop,
// so these imports follow the ARTWORK — that is the whole reason the variables
// are named after what is printed instead of after the file.
//
// slide4.png is a PINK leftover from the previous brand ("ฝากต่อเนื่องวันละ 188
// บาท") and is deliberately NOT imported: an imported image is an emitted image
// even when nothing renders it. Same for banner2/3/4.png. banner1-mobile.*
// belongs to MainLayout's hero <picture> alone. Only what is printed on each
// banner may be stated on this page.
import promoDeposit200 from "../assets/slide1.png";
import promoCashback8 from "../assets/slide2.png";
import promoReferral25 from "../assets/slide3.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 154.
const pageDescription = "รวมโปรโมชั่น LUCKYBKK ครบในหน้าเดียว ฝากเพียง 200 บาทรับสิทธิ์เปิดกล่องสมบัติ คืนยอดเสีย 8% ทุกวัน ค่าคอมมิชชั่น 5% ทุกวัน และรายได้แนะนำเพื่อนสูงสุด 2.5%";

const pageTitle = "โปรโมชั่น LUCKYBKK | ฝาก 200 รับสิทธิ์ คืนยอดเสีย 8% แนะนำเพื่อน 2.5%";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "โปรโมชั่น LUCKYBKK รวมสิทธิพิเศษที่กดรับได้ครบทุกจังหวะเดิมพัน";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoDeposit200.src,
});

// Drawn one-up on phones inside the box's own padding (px-4 + p-8 = 6rem), then
// two-up from sm: inside that same padding plus one 2rem grid gap.
// ContentBoxFloatingBadge keeps p-8 at every width and caps at max-w-[1400px],
// so the card stops growing once the viewport passes 1432px and the column
// settles at 652px.
const imageSizes = "(max-width: 639px) calc(100vw - 6rem), (max-width: 1431px) calc((100vw - 8rem) / 2), 652px";

// ขอบทองแบรนด์ตัดกับงานอาร์ตพื้นน้ำเงินเข้ม แล้วเรืองทองอ่อนขึ้นตอน hover
const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#f0b323]/35 object-contain shadow-[0_10px_30px_rgba(63,157,251,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffdf7e]/70 hover:shadow-[0_15px_40px_rgba(240,179,35,0.45)]";

// Capped at 600 because that is the intrinsic width of every slide*.png in this
// drop — the column is drawn up to 652px, so nothing above 600 buys detail.
const imageWidths = [320, 440, 600];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed">
        แบนเนอร์ด้านล่างคือสิทธิ์ที่ <strong class="text-[#ffdf7e]">LUCKYBKK</strong> เปิดให้สมาชิกกดรับอยู่ในรอบนี้ทั้งหมด รายละเอียดของแต่ละรายการพิมพ์อยู่บนแบนเนอร์ของตัวเองครบแล้ว
        ทั้งยอดฝากที่ต้องทำ จำนวนครั้งที่ต้องเดิมพัน เปอร์เซ็นต์ที่ได้คืน และรอบเวลาการรับสิทธิ์ แต่ละรายการคิดจากยอดคนละชุด จึงควรอ่านแบนเนอร์ของรายการที่จะรับอีกครั้งก่อนกด
        ทุกสิทธิ์กดรับเองได้ผ่านระบบออโต้บนหน้าเว็บตลอด 24 ชั่วโมง จบได้ในไม่กี่ขั้นตอนโดยไม่ต้องส่งสลิปและไม่ต้องรอแอดมินอนุมัติ
      </p>

      <div class="grid w-full grid-cols-1 gap-8 sm:grid-cols-2">
        <Picture
          src={promoDeposit200}
          alt="แบนเนอร์โปรโมชั่นพื้นน้ำเงินเข้มมีโคมไฟจีนและเหรียญทองลอยรอบโลโก้ LUCKYBKK ข้อความใหญ่เขียนว่า ฝากเพียง 200 บาท รับสิทธิ์สุดคุ้ม กลางภาพเป็นหีบสมบัติเปิดออกมาเป็นเพชรสีน้ำเงินข้างหญิงสาวชุดจีนสีน้ำเงิน มีป้ายเขียนว่า รับเลย 30 เพชร เดิมพันครบ 3 ครั้ง สะสมเพิ่มทุกยอด 1 แสน เปิดกล่องสมบัติลุ้นรับสูงสุด 500 เพชร และแถบล่างเขียนว่า ฝากครั้งเดียวได้ร่วมหลายกิจกรรม"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback8}
          alt="แบนเนอร์โปรโมชั่นพื้นน้ำเงินเข้มใต้ลำแสงสปอตไลต์ มีโลโก้ LUCKYBKK ชิปคาสิโนและเหรียญทองลอยอยู่ ข้อความใหญ่สองบรรทัดเขียนว่า คืนยอดเสีย 8% ทุกวัน และ ค่าคอมมิชชั่น 5% ทุกวัน โดยมีบรรทัดสรุปด้านล่างว่า ทุกยอดฝากเล่น ด้านขวาเป็นหญิงสาวชุดจีนสีน้ำเงินยืนข้างหีบสมบัติที่เต็มไปด้วยเพชรสีน้ำเงินและกล่องของขวัญ"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral25}
          alt="แบนเนอร์โปรโมชั่นพื้นน้ำเงินเข้มประดับโคมไฟจีนและก้อนทอง มีโลโก้ LUCKYBKK อยู่ด้านบน ข้อความใหญ่เขียนว่า รายได้แนะนำเพื่อน และบรรทัดในกรอบทองเขียนว่า รับสูงสุด 2.5% ด้านขวาเป็นหญิงสาวชุดจีนสีน้ำเงินยืนพนมมือข้างหีบสมบัติที่มีเพชรสีน้ำเงินล้นออกมา"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#f0b323]/50 bg-gradient-to-r from-[#ffdf7e] via-[#f0b323] to-[#9a6c05] px-10 py-3.5 text-lg font-black text-[#030b28] shadow-[0_10px_30px_rgba(240,179,35,0.4)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(63,157,251,0.45)]">
          สมัครสมาชิก LUCKYBKK
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
