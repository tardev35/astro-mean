---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// Named for the promotion each banner ACTUALLY shows, not for its file number.
// A previous brand's copy on this page described a completely different set of
// offers while rendering these same four images — the text and the artwork
// disagreed on every card. Reading the banner is the only way to write this
// page. The NEKOATK drop (2026-08-05) reads:
//   slide1 = สมาชิกใหม่ รับโบนัส 100%
//   slide2 = คืนค่าคอม 0.5%
//   slide3 = แนะนำเพื่อน 0.8%
//   slide4 = คืนยอดเสีย 5% ทุกวันอาทิตย์
// Only the headline offer is printed on each banner — no turnover figure and no
// withdrawal cap appears on any of the four, so this page must not state one.
import proWelcome from "../assets/slide1.png";
import proCommission from "../assets/slide2.png";
import proReferral from "../assets/slide3.png";
import proCashback from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 159.
const pageDescription = "รวมโปรโมชั่น NEKOATK สล็อตตรงไม่ผ่านเอเย่นต์ สมาชิกใหม่รับโบนัส 100% คืนค่าคอม 0.5% แนะนำเพื่อน 0.8% และคืนยอดเสีย 5% ทุกวันอาทิตย์ อ่านเงื่อนไขให้ครบก่อนกดรับ";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น NEKOATK สมาชิกใหม่ 100% คืนค่าคอม 0.5% และคืนยอดเสีย 5%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: proWelcome.src,
});

// Drawn one-up on phones inside the box's own padding (px-4 + p-8 = 6rem) and
// two-up from sm: upward inside the same padding plus a 2rem gap (8rem total).
const imageSizes = "(max-width: 639px) calc(100vw - 6rem), (max-width: 1456px) calc((100vw - 8rem) / 2), 600px";

const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#fb0660]/35 object-contain shadow-[0_10px_30px_rgba(251,6,96,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fb0660]/70 hover:shadow-[0_15px_40px_rgba(251,6,96,0.32)]";

const headingClass = "bg-gradient-to-r from-[#ffb457] via-[#fd841b] to-[#fb0660] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="โปรโมชั่น NEKOATK สมาชิกใหม่รับ 100% คืนค่าคอม 0.5% คืนยอดเสีย 5%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น NEKOATK" as="h1">
    <div>
      <h2 class={`mb-4 ${headingClass}`}>โปรโมชั่น NEKOATK ต้องอ่านเงื่อนไขตรงไหนก่อนกดรับ</h2>

      <p class="mb-5 text-left text-base leading-relaxed">
        <strong class="text-[#ffb457]">NEKOATK</strong> เป็นสล็อตเว็บตรงที่ส่งตรงจากเซิร์ฟเวอร์หลัก ไม่ผ่านเอเย่นต์หรือคนกลางใด ๆ ทุกเกมในเว็บนำเข้าผ่าน API ลิขสิทธิ์แท้จากค่ายผู้พัฒนาโดยตรง
        โปรโมชั่นที่เปิดให้กดรับจึงผูกอยู่กับยอดจริงในบัญชีของเราและเกมที่ร่วมรายการ ไม่ได้ลอยอยู่เดี่ยว ๆ ในหน้าโปร ตัวเลขใหญ่บนแบนเนอร์บอกได้แค่ว่ามีอะไรให้ ส่วนบรรทัดเล็กใต้ตัวเลขคือคนที่ตัดสินว่าเราได้จริงเท่าไร
        ก่อนกดรับจึงควรไล่ให้ครบทั้งห้าข้อ คือยอดที่ใช้คำนวณ เปอร์เซ็นต์ที่ได้รับจริง จำนวนเทิร์นโอเวอร์ เกมที่ร่วมรายการ และรอบเวลาที่สิทธิ์นั้นเปิดให้รับ เพราะโปรแต่ละรายการกำหนดเงื่อนไขไม่เหมือนกัน
        การเลือกจากเปอร์เซ็นต์ที่สูงที่สุดเพียงอย่างเดียวจึงไม่ใช่วิธีที่ปลอดภัยที่สุด
      </p>

      <p class="mb-8 text-left text-base leading-relaxed">
        รายการที่เห็นบนหน้าโปรของ NEKOATK รอบนี้มีสี่ก้อนที่คิดจากฐานคนละชุดกัน คือโบนัสสมาชิกใหม่ 100% ที่คิดจากยอดฝากแรกของบัญชี คืนค่าคอม 0.5% ที่คิดจากยอดเดิมพันสะสมไม่ว่าผลจะออกทางไหน
        โบนัสแนะนำเพื่อน 0.8% ที่คิดจากยอดของเพื่อนที่สมัครผ่านลิงก์ของเราแล้วเข้าเล่นจริง และคืนยอดเสีย 5% ที่สรุปให้ทุกวันอาทิตย์จากยอดเสียสุทธิของสัปดาห์นั้น จุดเด่นของชุดนี้คือเงื่อนไขเทิร์นโอเวอร์ต่ำ
        ไม่จุกจิก จึงเอาไปต่อยอดทำกำไรได้จริงแทนที่จะเป็นตัวเลขที่ติดอยู่ในระบบเฉย ๆ ตัวเลขเหล่านี้ควรใช้เป็นข้อมูลตั้งต้นแล้วตรวจจากหน้าโปรจริงอีกครั้งก่อนกด เพราะช่วงเวลาของสิทธิ์ ค่ายเกมที่ยกเว้น
        และการรับซ้อนกับรายการอื่นเป็นรายละเอียดที่เปลี่ยนได้ตามรอบ ถ้าแผนของเราคือหมุนตามงบแล้วปิดจบ การไม่รับสิทธิ์เลยก็เป็นทางเลือกที่สมเหตุสมผล เพราะโบนัสที่ยังติดเทิร์นไม่ได้แปลว่าเงินอยู่ในมือแล้ว
      </p>

      <h2 class={`mt-10 mb-4 ${headingClass}`}>รายการโปรโมชั่นทั้งหมดที่ NEKOATK เปิดให้รับ</h2>

      <p class="mb-8 text-left text-base leading-relaxed">
        แบนเนอร์ด้านล่างคือรายการจริงที่เปิดให้รับอยู่ในรอบนี้ อ่านคำอธิบายใต้ภาพให้ตรงกับสิ่งที่ตัวเองเล่นอยู่ก่อนตัดสินใจ เพราะสองรายการแรกคิดจากยอดที่เราเดินเองคือยอดฝากกับยอดเดิมพันสะสม
        ส่วนแนะนำเพื่อนกับคืนยอดเสียเป็นคนละก้อนที่คิดจากคนอื่นและจากผลของทั้งสัปดาห์ รอบการจ่ายจึงไม่ตรงกัน
      </p>

      <div class="grid w-full grid-cols-1 gap-8 sm:grid-cols-2">
        <figure class="m-0">
          <Picture
            src={proWelcome}
            alt="แบนเนอร์โปรโมชั่น NEKOATK สมาชิกใหม่ รับโบนัส 100% ตัวเลขใหญ่บนพื้นชมพูทอง พร้อมแมวกวักมาเนกิเนโกะชุดกิโมโนลายหัวใจกำลังยกอุ้งเท้า"
            loading="lazy"
            fetchpriority="low"
            widths={[300, 450, 600]}
            sizes={imageSizes}
            class={imageClass}
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={80}
          />
          <figcaption class="mt-3 text-left text-base leading-relaxed">
            <strong class="text-[#ffb457]">สมาชิกใหม่ รับโบนัส 100%</strong> คิดจากยอดฝากแรกหลังเปิดบัญชี ไม่ใช่ยอดคงเหลือในกระเป๋า เป็นก้อนที่รับได้ครั้งเดียวต่อหนึ่งบัญชี จึงควรเลือกจำนวนเงินฝากให้พอดีกับที่ตั้งใจหมุนจริงตั้งแต่บิลแรก
          </figcaption>
        </figure>

        <figure class="m-0">
          <Picture
            src={proCommission}
            alt="แบนเนอร์โปรโมชั่น NEKOATK คืนค่าคอม 0.5% บนพื้นชมพูทอง พร้อมหญิงสาวชุดทองยืนคู่มังกรเขียว ถือแผงเกมสล็อตท่ามกลางเหรียญทองที่ปลิวรอบตัว"
            loading="lazy"
            fetchpriority="low"
            widths={[300, 450, 600]}
            sizes={imageSizes}
            class={imageClass}
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={80}
          />
          <figcaption class="mt-3 text-left text-base leading-relaxed">
            <strong class="text-[#ffb457]">คืนค่าคอม 0.5%</strong> คิดจากยอดเดิมพันสะสม ไม่ได้ดูว่ารอบนั้นได้หรือเสีย จึงเป็นก้อนเดียวในหน้านี้ที่โตตามจำนวนรอบที่หมุน คนที่เล่นยาวด้วยเดิมพันต่อรอบเท่าเดิมจะเห็นผลจากรายการนี้ชัดที่สุด
          </figcaption>
        </figure>

        <figure class="m-0">
          <Picture
            src={proReferral}
            alt="แบนเนอร์โปรโมชั่น NEKOATK แนะนำเพื่อน 0.8% บนพื้นชมพูทอง พร้อมแมวขาวสวมชุดจีนกอดหัวใจสีทองไว้กลางอก มีเหรียญทองลอยอยู่รอบ ๆ"
            loading="lazy"
            fetchpriority="low"
            widths={[300, 450, 600]}
            sizes={imageSizes}
            class={imageClass}
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={80}
          />
          <figcaption class="mt-3 text-left text-base leading-relaxed">
            <strong class="text-[#ffb457]">แนะนำเพื่อน 0.8%</strong> คิดจากยอดของเพื่อนที่สมัครผ่านลิงก์ของเราแล้วเข้าเล่นจริง จึงเป็นก้อนที่โตตามจำนวนคน ไม่ได้โตตามยอดฝากของเราเอง และเดินต่อได้เรื่อย ๆ แม้วันไหนเราไม่ได้หมุนเอง
          </figcaption>
        </figure>

        <figure class="m-0">
          <Picture
            src={proCashback}
            alt="แบนเนอร์โปรโมชั่น NEKOATK คืนยอดเสีย 5% ทุกวันอาทิตย์ บนพื้นชมพูทอง พร้อมแมวขาวสวมชุดเกราะสีดำแดงยื่นเหรียญทองออกมา"
            loading="lazy"
            fetchpriority="low"
            widths={[300, 450, 600]}
            sizes={imageSizes}
            class={imageClass}
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={80}
          />
          <figcaption class="mt-3 text-left text-base leading-relaxed">
            <strong class="text-[#ffb457]">คืนยอดเสีย 5% ทุกวันอาทิตย์</strong> คิดจากยอดเสียสุทธิของทั้งสัปดาห์ ไม่ใช่ยอดฝาก จึงเป็นรายการเดียวที่ไม่ต้องกดรับตอนเติมเงิน แต่ต้องดูรอบสรุปให้ตรงวัน เพราะยอดของสัปดาห์ถัดไปเริ่มนับใหม่
          </figcaption>
        </figure>
      </div>

      <h2 class={`mt-12 mb-4 ${headingClass}`}>รับโปรแล้วต้องตรวจเทิร์นและยอดถอนอย่างไร</h2>

      <p class="mb-5 text-left text-base leading-relaxed">
        หลังกดรับสิทธิ์ควรเปิดหน้าประวัติรายการดูว่ายอดโบนัสเข้าครบ เทิร์นเดินถูกเกม และยอดคงเหลือตรงกับที่ระบบแสดง เพราะบางรายการนับเฉพาะเกมสล็อตที่ร่วมโปร การหมุนในหมวดอื่นระหว่างที่เทิร์นยังไม่ครบจึงอาจไม่ถูกนับ
        อีกจุดที่คนอ่านข้ามบ่อยคือฐานที่ใช้คำนวณของแต่ละรายการ โบนัสสมาชิกใหม่คิดจากยอดฝากแรก คืนค่าคอมคิดจากยอดเดิมพันสะสม โบนัสแนะนำเพื่อนคิดจากยอดของเพื่อน และคืนยอดเสียคิดจากยอดเสียสุทธิรายสัปดาห์
        ทั้งสี่ตัวเลขจึงเทียบกันตรง ๆ ไม่ได้ และควรอ่านเงื่อนไขของแต่ละรายการแยกกันก่อนวางแผนหมุน
      </p>

      <p class="mb-8 text-left text-base leading-relaxed">
        ด้านการเงิน NEKOATK ใช้ระบบออโต้ที่ทำรายการได้ด้วยตัวเองตลอดเวลา ไม่ต้องทักหาแอดมินและไม่ต้องรอคิวตรวจสลิป กดถอนแล้วยอดเด้งเข้าแอปธนาคารตามสถานะระบบในช่วงนั้น จ่ายเต็มทุกบิลโดยไม่หักเปอร์เซ็นต์
        และไม่มีการอั้นยอดถอนต่อวัน ต่อให้ปั่นแตกหนักทะลุหลักแสนหลักล้านก็โอนให้ตามยอดจริง ก่อนทำรายการควรตรวจชื่อบัญชี ยอดเงิน และประวัติรายการให้ครบ หากยอดยังไม่เปลี่ยนไม่ควรกดซ้ำทันที
        เพราะนิ้วที่กดสองรอบไม่ได้ทำให้ธนาคารขยันขึ้น และควรกรอกข้อมูลเฉพาะบนโดเมนที่ตรวจแล้วและเชื่อมต่อแบบ HTTPS เท่านั้น ไม่ใช่ลิงก์ที่ส่งต่อกันมาในแชตพร้อมคำโฆษณา
      </p>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#fd841b]/60 bg-gradient-to-r from-[#ffb457] via-[#fd841b] to-[#fb0660] px-10 py-3.5 text-lg font-black text-[#2a0210] shadow-[0_10px_30px_rgba(253,132,27,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(253,132,27,0.32)]">
          สมัครสมาชิก NEKOATK
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
