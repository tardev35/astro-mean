---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";

// XTOP666: ticker หมุนมาเป็น AnnouncementCyber และกล่องหน้าย่อยหมุนมาเป็น
// ContentBoxCyberCut ตามสเปกรอบนี้ เรียก <Announcement /> เปล่า ๆ เพราะ default
// message ของ variant นี้ถูกตั้งเป็นข้อความของแบรนด์นี้แล้ว
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// This page is an IMAGE page, not an article: the ContentBox title (the single
// <h1>), ONE short intro paragraph, the promo image grid, one CTA. Nothing
// else — no <h2>, no section paragraphs. The slides already print their own
// offer in large type, so prose below them re-types what the visitor can
// already read, in smaller letters. The docx gives this page a Title and a
// Meta and never a body.
//
// Named for what each banner ACTUALLY prints, not for its file number.
// The XTOP666 drop (2026-08-29) is two 600x200 red-and-black promo strips:
//   slide1 = เล่นเสีย ก็ได้คืน / รับเลย 5% / เดือนละ 2รอบ
//   slide2 = สล็อต คืนยอดเสีย / 10% ทุกค่าย
// The mapping between file number and artwork changes with every asset drop,
// so these imports follow the ARTWORK — that is the whole reason the variables
// are named after what is printed instead of after the file.
//
// slide3.png and slide4.png are deliberately NOT imported: both are PREVIOUS
// brands' artwork (this round's drop is slide1 + slide2 only). The slide3
// import was removed here on 2026-08-29 — an imported image is an emitted
// image even when nothing renders it, so leaving it in ships another brand's
// banner into dist/ on every build. banner1.png belongs to MainLayout's hero
// <picture> alone, and banner.png / banner2-4.png are stale art from earlier
// brands. Only what is printed on each banner may be stated here.
import promoLossbackTwice from "../assets/slide1.png";
import promoSlotCashback from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 157. It states what the
// page holds — the offers the slides themselves print — and stops.
const pageDescription =
  "รวมโปรโมชั่น XTOP666 สล็อตคืนยอดเสีย 10% ครบทุกค่าย และสิทธิ์เล่นเสียก็ได้คืนรับเลย 5% เดือนละ 2 รอบ กดรับเองได้จากหน้าเว็บก่อนเข้าเกม ไม่ต้องรอแอดมินอนุมัติ";

const pageTitle = "โปรโมชั่น XTOP666 | คืนยอดเสีย 10% ทุกค่าย รับเพิ่ม 5% เดือนละ 2 รอบ";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "โปรโมชั่น XTOP666 รวมสิทธิ์ที่เปิดให้สมาชิกกดรับในรอบนี้";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoLossbackTwice.src,
});

// Recomputed for ContentBoxCyberCut, which this round's variant rotation put
// under every sub-page. Unlike the box used last round it does NOT step its
// padding at md:, so the padding total is a flat 6rem (px-4 = 2rem + p-8 =
// 4rem) at every width. Drawn one-up on phones inside that padding, then
// two-up from sm: inside the same padding plus one 2rem grid gap. The card
// caps at max-w-7xl (1280px), so once the viewport passes 1312px the column
// settles at 592px.
const imageSizes = "(max-width: 639px) calc(100vw - 6rem), (max-width: 1311px) calc((100vw - 8rem) / 2), 592px";

// ขอบส้มไฟของแบรนด์ล้อกับตัวอักษรบนสไลด์ แล้วเรืองแดงขึ้นตอน hover
const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#fc5b03]/35 object-contain shadow-[0_10px_30px_rgba(252,91,3,0.32)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffc9a3]/70 hover:shadow-[0_15px_40px_rgba(225,18,18,0.45)]";

// Capped at 600 because that is the intrinsic width of every slide*.png in this
// drop — the column is drawn up to 592px, so nothing above 600 buys detail.
const imageWidths = [300, 450, 600];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed">
        แบนเนอร์ด้านล่างคือสิทธิ์ที่ <strong class="text-[#ffc9a3]">XTOP666</strong> เปิดให้สมาชิกกดรับอยู่ในรอบนี้ ทั้งเปอร์เซ็นต์ที่ได้คืน เพดานสูงสุด และรอบเวลาของแต่ละรายการพิมพ์อยู่บนแบนเนอร์ของตัวเองแล้ว
        แต่ละรายการคิดจากยอดคนละชุดและมีเงื่อนไขของตัวเอง จึงควรอ่านแบนเนอร์ของรายการที่จะรับอีกครั้งก่อนกด ทุกสิทธิ์เลือกกดรับเองได้จากหน้าเว็บก่อนเข้าเกม จบในไม่กี่วินาทีโดยไม่ต้องรอแอดมินอนุมัติ
      </p>

      <div class="grid w-full grid-cols-1 gap-8 sm:grid-cols-2">
        <Picture
          src={promoLossbackTwice}
          alt="แบนเนอร์โปรโมชั่นพื้นดำแดง พิมพ์ข้อความ เล่นเสีย ก็ได้คืน รับเลย 5% เดือนละ 2รอบ มีไพ่โพดำ ลูกเต๋า และชิปคาสิโนสีแดงกระจายอยู่รอบภาพ ด้านขวาเป็นหญิงสาวสวมชุดเกาะอกสีแดง"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoSlotCashback}
          alt="แบนเนอร์โปรโมชั่นพื้นดำแดง พิมพ์ข้อความ สล็อต คืนยอดเสีย 10% ทุกค่าย มีไพ่เอซโพดำและชิปคาสิโนสีแดงวางซ้อนกัน ด้านขวาเป็นหญิงสาวสวมชุดสีแดง"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#ffc9a3]/60 bg-gradient-to-r from-[#ffc9a3] via-[#fc5b03] to-[#a33200] px-10 py-3.5 text-lg font-black text-[#0a0403] shadow-[0_10px_30px_rgba(252,91,3,0.4)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(225,18,18,0.5)]">
          สมัครสมาชิก XTOP666
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
