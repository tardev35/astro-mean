---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// This page is an IMAGE page, not an article: the ContentBox title (the single
// <h1>), ONE short intro paragraph, the promo image grid, one CTA. Nothing
// else. The slides already print their own offer in large type, so prose below
// them re-types what the visitor can already read, in smaller letters. The docx
// gives this page a Title and a Meta and never a body.
//
// Named for the promotion each banner ACTUALLY shows, not for its file number.
// The LONGSAP168 drop (2026-08-11) reads:
//   slide1 = แนะนำเพื่อน รับไปเลย สูงสุด 0.7% — ยิ่งชวนมาก ยิ่งได้มาก
//   slide2 = คาสิโนชั้นนำ ครบจบทุกค่าย ในเว็บเดียว
//   slide3 = คืนยอดเสีย รับไปเลยสูงสุด 5% ของทุกสัปดาห์ — สูงสุด 500,000 บาท
//   slide4 = ฝาก-ถอน ระบบออโต้ ภายใน 2 วินาที — ทำรายการเอง ไม่ต้องพึ่งแอดมิน
// Only what is printed on each banner may be stated here. Every other
// promo/banner file in src/assets (banner2/3/4, banner.png) is a previous
// brand's leftover and must not be pulled in.
import proRefer from "../assets/slide1.png";
import proCasino from "../assets/slide2.png";
import proCashback from "../assets/slide3.png";
import proAuto from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 155.
const pageDescription =
  "รวมโปรโมชั่น LONGSAP168 ทั้งแนะนำเพื่อนรับสูงสุด 0.7% คืนยอดเสียสูงสุด 5% ทุกสัปดาห์ และฝากถอนออโต้ภายใน 2 วินาที อ่านเงื่อนไขของแต่ละรายการก่อนกดรับสิทธิ์";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น LONGSAP168 แนะนำเพื่อนรับสูงสุด 0.7% และคืนยอดเสียสูงสุด 5%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: proRefer.src,
});

// Drawn one-up on phones inside the box's own padding (px-4 + p-8 = 6rem),
// two-up from sm: inside that padding plus one 2rem gap, capped by the card's
// own max-width once the viewport passes it.
const imageSizes = "(max-width: 639px) calc(100vw - 6rem), (max-width: 1456px) calc((100vw - 8rem) / 2), 646px";

const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#f2b024]/35 object-contain shadow-[0_10px_30px_rgba(242,176,36,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffd76a]/70 hover:shadow-[0_15px_40px_rgba(255,215,106,0.45)]";
---

<MainLayout title="โปรโมชั่น LONGSAP168 แนะนำเพื่อนรับสูงสุด 0.7% คืนยอดเสียสูงสุด 5%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น LONGSAP168" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#f6e4c8]">
        แบนเนอร์ด้านล่างคือโปรโมชั่นที่ <strong class="text-[#f2b024]">LONGSAP168</strong> เปิดให้รับอยู่ในรอบนี้ทั้งหมด ทั้งแนะนำเพื่อนรับสูงสุด 0.7% คืนยอดเสียสูงสุด 5%
        ทุกสัปดาห์ และระบบฝากถอนออโต้ภายใน 2 วินาที แต่ละรายการคิดจากฐานคนละชุดและมีรอบเวลาของตัวเอง เงื่อนไขเทิร์นโอเวอร์ หมวดเกมที่ร่วมรายการ และเพดานของแต่ละโปรก็ไม่เหมือนกัน
        จึงควรอ่านรายละเอียดของรายการที่จะรับอีกครั้งก่อนกด
      </p>

      <div class="grid w-full grid-cols-1 gap-8 sm:grid-cols-2">
        <Picture
          src={proRefer}
          alt="แบนเนอร์โปรโมชั่น LONGSAP168 แนะนำเพื่อน รับไปเลยสูงสุด 0.7% ยิ่งชวนมาก ยิ่งได้มาก ตัวอักษรทองบนพื้นดำแดง มีเหรียญทองลอยและผังสายแนะนำเพื่อนที่แสดงอัตรา 0.5% กับ 0.1%"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={proCasino}
          alt="แบนเนอร์โปรโมชั่น LONGSAP168 คาสิโนชั้นนำ ครบจบทุกค่าย ในเว็บเดียว มีดีลเลอร์สาวผมชมพูชุดแดงถือชิปคาสิโน โลโก้ค่ายเกมหลายค่าย และมือถือที่แสดงห้องโต๊ะสดเรียงกันหลายห้อง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={proCashback}
          alt="แบนเนอร์โปรโมชั่น LONGSAP168 คืนยอดเสีย รับไปเลยสูงสุด 5% ของทุกสัปดาห์ สูงสุด 500,000 บาท ตัวอักษรทองบนพื้นแดงดำ มีผู้หญิงเสื้อกล้ามสีดำและเหรียญทองลอยอยู่รอบตัว"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={proAuto}
          alt="แบนเนอร์โปรโมชั่น LONGSAP168 ฝาก-ถอน ระบบออโต้ ภายใน 2 วินาที ทำรายการเอง ไม่ต้องพึ่งแอดมิน มีผู้หญิงชุดสีทอง เหรียญเงินลอยรอบตัว และแถวไอคอนธนาคารกับทรูมันนี่วอลเล็ท"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#ffd76a]/60 bg-gradient-to-r from-[#ffd76a] via-[#f2b024] to-[#a86a0c] px-10 py-3.5 text-lg font-black text-[#0a0402] shadow-[0_10px_30px_rgba(242,176,36,0.35)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,215,106,0.45)]">
          สมัครสมาชิก LONGSAP168
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
