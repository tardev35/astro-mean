---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// BLACKJACK789: ticker หมุนมาเป็น Announcement5 ส่วนกล่องหน้าย่อยยังเป็น ContentBox
// (การ์ดถาวรของหน้าย่อย) เรียก <Announcement /> เปล่า ๆ เพราะ default message ของ
// variant นี้ถูกตั้งให้ตรงกับข้อความที่หน้าแรกส่งเข้าไป ticker จึงเหมือนกันทั้งเว็บ
// สีย้ายจากทองอำพันออกส้มคู่โครเมียมเงินของแบรนด์ก่อน มาเป็นทองแอนทีคอมน้ำผึ้ง
// คู่กราไฟต์บนดำสนิท — ทอง #fdf1ce / #f2cf70 / #d3aa4b / #b8862c / #5c4113
// คู่กราไฟต์ #cfd6e0 บนพื้น #050403 ขอบ #3a2a11
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// This page is an IMAGE page, not an article: the ContentBox title (the page's
// single h1), ONE short intro paragraph, the promo image grid, one CTA. Nothing
// else — no second-level headings, no section paragraphs. The artwork already
// prints its own offer in large type, so prose below it re-types what the
// visitor can already read, in smaller letters. The docx gives this page no
// body at all; the seven article sections a previous rebrand invented here, and
// every rebrand since faithfully rewrote, were removed on 2026-09-07.
// Final inventory for this page is h1 ×1, and no headings below it.
//
// ตัวแปรตั้งชื่อตามข้อความที่พิมพ์อยู่บนอาร์ตจริง ไม่ได้ตั้งตามเลขท้ายชื่อไฟล์
// ดรอปวันที่ 2026-09-09 ให้สไลด์มาสี่ใบ และลงกริดครบทั้งสี่ใบ:
//   ใบที่ 1 = โปรสมัครใหม่ รับ 100% · ทุกยอดฝาก ถอนไม่อั้น
//   ใบที่ 2 = ฝากรับเพิ่ม 10% · รับได้ไม่จำกัด · เล่นเพียง 1 เทิร์น ถอนได้ไม่อั้น
//   ใบที่ 3 = ฝาก 100 รับ 200 · ทำ 2,000 ถอนได้ 200
//   ใบที่ 4 = ฝาก 300 รับ 700 · ทำ 6,000 ถอนได้ 700
// ทั้งสี่ไฟล์เป็นอาร์ตทรงจัตุรัส 600x600 เท่ากันหมด กริดจึงเรียงลงตัวไม่มีช่องเตี้ยช่องสูง
// (ถ้าดรอปหน้าเปลี่ยนสัดส่วนอีก ให้ไล่เช็ก imageSizes กับ widthLadder ใหม่)
//
// ไฟล์ banner ของแบรนด์ก่อนที่ยังค้างอยู่ใน src/assets ห้าม import ที่นี่เด็ดขาด —
// รูปที่ import แล้วคือรูปที่ถูก emit ลง dist เสมอ ต่อให้ไม่มีใคร render ส่วนไฟล์
// hero ของรอบนี้เป็นของ MainLayout จัดการเองเท่านั้น
//
// alt เขียนจากสิ่งที่วาดอยู่บนภาพจริง ทั้งข้อความที่พิมพ์บนอาร์ตและฉาก — ทั้งสี่ไฟล์
// เปิดดูแล้วถอดองค์ประกอบมาเขียนตามนั้น
import promoWelcome100 from "../assets/slide1.png";
import promoTopup10 from "../assets/slide2.png";
import promoDeposit100 from "../assets/slide3.png";
import promoDeposit300 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 159. It states what the
// page holds — the offers the promo artwork itself prints — and stops.
const pageDescription =
  "รวมโปรโมชั่น BLACKJACK789 ทั้งโปรสมัครใหม่รับ 100% ฝากรับเพิ่ม 10% ฝาก 100 รับ 200 และฝาก 300 รับ 700 เงื่อนไขพิมพ์อยู่บนภาพครบ กดรับเองได้ ถอนออโต้ใน 3 วินาที";

const pageTitle = "โปรโมชั่น BLACKJACK789 | สมัครใหม่รับ 100% ฝากรับเพิ่ม 10% ถอนไม่อั้น";

// หัวข้อระดับ h1 ของหน้า แยกจากค่า title เพราะ title มีขีดคั่นแบรนด์อยู่
const pageHeading = "โปรโมชั่น BLACKJACK789 รวมสิทธิ์และข้อเสนอที่เปิดให้กดรับอยู่ในรอบนี้";

const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoWelcome100.src,
});

// One column on phones, two from sm: up, gap-6 (1.5rem) between the cells.
//
// sizes describes how wide each cell is DRAWN, not how wide a file to fetch.
// ContentBox wraps the grid in px-4 (2rem) + p-8 (4rem, stepping to p-10 =
// 5rem at md:), and the card caps at max-w-[1400px]:
//   < 640px  : คอลัมน์เดียวเต็มกรอบ px-4 + p-8       → 100vw - 6rem
//   640–767  : 2 คอลัมน์ + gap-6 ยังเป็น p-8         → (100vw - 7.5rem) / 2
//   768–1431 : 2 คอลัมน์ + gap-6 ขยับเป็น p-10       → (100vw - 8.5rem) / 2
//   ≥ 1432px : การ์ดชนเพดาน 1400px                   → (1400 - 5rem - 1.5rem) / 2 = 648px
const imageSizes =
  "(max-width: 639px) calc(100vw - 6rem), (max-width: 767px) calc((100vw - 7.5rem) / 2), (max-width: 1431px) calc((100vw - 8.5rem) / 2), 648px";

// ขอบทองเข้มล้อกับกรอบทองบนแบนเนอร์ แล้วสว่างขึ้นเป็นทองหลักตอน hover
const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#3a2a11]/70 object-contain shadow-[0_10px_30px_rgba(92,65,19,0.4)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#d3aa4b]/70 hover:shadow-[0_15px_40px_rgba(211,170,75,0.45)]";

// A cell is drawn up to 648px, but the ladder is clamped to each file's own
// intrinsic width (600px for all four promo images here) so a sharp upscale never
// becomes a source and never ships more bytes than the file held.
const widthLadder = (img: { width: number }) => {
  const steps = [384, 576, 648].filter((w) => w < img.width);
  return [...steps, Math.min(img.width, 648)];
};

const promos = [
  {
    src: promoWelcome100,
    alt: "แบนเนอร์โปรโมชั่นทรงจัตุรัส ฉากไฟลุกโชนสีส้มบนพื้นมืด มุมซ้ายบนเป็นโลโก้โพดำทอง BLACKJACK789 ตัวอักษรทองเรียงลงมาว่า โปรสมัครใหม่ รับ 100% และบรรทัดล่างว่า ทุกยอดฝาก ถอนไม่อั้น ด้านหน้าเป็นชายหนุ่มสวมเสื้อคลุมมีฮู้ดสีเขียวเข้มที่อกเรืองแสงสีเขียว อัศวินสวมเกราะกระโดดฟันดาบกลางอากาศ และลิงยักษ์ขนน้ำตาลสองตัวกำลังคำราม มีเหรียญทองปลิวเต็มภาพ",
  },
  {
    src: promoTopup10,
    alt: "แบนเนอร์โปรโมชั่นทรงจัตุรัส ฉากร้านเบอร์เกอร์ริมถนนยามค่ำที่มีป้ายไฟนีออนสีชมพูฟ้า ตัวอักษรขาวทองด้านบนเขียนว่า ฝากรับเพิ่ม พร้อมเลข 10% ตัวใหญ่ มุมล่างขวาเขียนว่า รับได้ไม่จำกัด และ เล่นเพียง 1 เทิร์น ถอนได้ไม่อั้น กลางภาพเป็นพนักงานสาวยิ้มแย้มสวมหมวกแก๊ปสีชมพูและผ้ากันเปื้อนลายทางแดงขาว ยกถาดเบอร์เกอร์สองมือ ป้ายร้านมีโลโก้ PG อยู่มุมขวา มุมซ้ายบนเป็นโลโก้โพดำทอง BLACKJACK789",
  },
  {
    src: promoDeposit100,
    alt: "แบนเนอร์โปรโมชั่นทรงจัตุรัส กลางภาพเป็นแผ่นป้ายกระดาษสีครีมขอบโค้งผูกริบบิ้นสีส้มไว้ด้านบน พิมพ์ข้อความว่า ฝาก 100 รับ 200 และบรรทัดล่างว่า ทำ 2,000 ถอนได้ 200 ฉากหลังเป็นถ้ำสมบัติลายสลักทองพร้อมลูกโป่งและกระดาษหลากสี ด้านซ้ายเป็นคาวเกิร์ลสวมหมวกปีกกว้างถือปืนลูกโม่ข้างหีบสมบัติ ตรงกลางเป็นกระต่ายขาวสวมหมวกแดงยืนบนสเกตบอร์ด ด้านขวาเป็นนักร้องร็อกสวมแจ็กเก็ตหนังดำถือกีตาร์ไฟฟ้าสีแดงหน้าไมโครโฟน มุมขวาล่างเป็นโลโก้วงกลม PG Pocket Games Soft",
  },
  {
    src: promoDeposit300,
    alt: "แบนเนอร์โปรโมชั่นทรงจัตุรัส กลางภาพเป็นแผ่นป้ายกระดาษสีครีมผูกริบบิ้นสีส้มไว้ด้านบน พิมพ์ข้อความว่า ฝาก 300 รับ 700 และบรรทัดล่างว่า ทำ 6,000 ถอนได้ 700 ใต้ป้ายเป็นมือสองข้างคลี่แผนที่ขุมทรัพย์บนกระดาษเก่า ฉากหลังเป็นผนังหินในถ้ำพร้อมลูกโป่งและกระดาษหลากสี ด้านซ้ายเป็นแมวกวักสีขาวคอกระพรวนทองข้างหีบสมบัติที่ล้นด้วยเหรียญทองและอัญมณี ด้านขวาเป็นหญิงสาวในชุดเกาะอกสีแดงกำลังขยิบตาและกลุ่มนกการ์ตูนสีแดงเหลือง มุมซ้ายบนเป็นโลโก้ PG Pocket Games Soft มุมขวาบนเป็นโลโก้โพดำทอง BLACKJACK789",
  },
];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed">
        แบนเนอร์ด้านล่างคือโปรโมชั่นที่ <strong class="text-[#f2cf70]">BLACKJACK789</strong> เปิดให้กดรับอยู่ในรอบนี้ ทั้งโบนัสต้อนรับสำหรับสมาชิกใหม่ โปรฝากรับเพิ่ม และรายการฝากเท่านี้รับเท่านั้นแบบระบุยอดชัดเจน
        อัตราที่ได้รับและเงื่อนไขเทิร์นของแต่ละรายการพิมพ์อยู่บนภาพครบแล้ว จึงควรอ่านใบที่จะรับอีกครั้งก่อนกด เพราะแต่ละใบคิดคนละเงื่อนไขกัน
        ทุกสิทธิ์เลือกกดรับเองได้จากหน้าแดชบอร์ดเดียว คำนวณตรงไปตรงมา ไม่ต้องส่งสลิป ไม่ต้องรอแอดมินอนุมัติ และไม่ติดเทิร์นโอเวอร์มหาโหด
        เมื่อกดถอน ระบบออโต้ผ่าน Gateway ตรงจะทำรายการเสร็จภายใน 3 วินาที เงินเข้าบัญชีเต็มจำนวนตามยอดที่กด
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          promos.map((promo) => (
            <Picture
              src={promo.src}
              alt={promo.alt}
              loading="lazy"
              fetchpriority="low"
              widths={widthLadder(promo.src)}
              sizes={imageSizes}
              class={imageClass}
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={80}
            />
          ))
        }
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#f2cf70]/60 bg-gradient-to-r from-[#fdf1ce] via-[#d3aa4b] to-[#8c6623] px-10 py-3.5 text-xl font-black text-[#050403] shadow-[0_10px_30px_rgba(211,170,75,0.4)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(242,207,112,0.5)]">
          สมัครสมาชิก BLACKJACK789
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
