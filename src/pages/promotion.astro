---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";

// AURA456: ticker หมุนมาเป็น AnnouncementCyber และกล่องหน้าย่อยใช้ ContentBox
// ตามสเปกรอบนี้ เรียก <Announcement /> เปล่า ๆ เพราะ default message ของ
// variant นี้ถูกตั้งเป็นข้อความของแบรนด์นี้แล้ว
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// This page is an IMAGE page, not an article: the ContentBox title (the single
// <h1>), ONE short intro paragraph, the promo image, one CTA. Nothing else —
// no <h2>, no section paragraphs. The artwork already prints its own offer in
// large type, so prose below it re-types what the visitor can already read, in
// smaller letters. The docx gives this page a Title and a Meta and never a body.
//
// Named for what the banner ACTUALLY prints, not for its file number.
// This drop supplies ONE promo image: slide1 = the RANKING tier ladder
// (Spark → Pulse → Nova → Prism → Radiant → Eclipse, ยิ่งฝากยิ่งอัพเลเวล,
// รีเซ็ตทุก 2 เดือน), 600x229, a wide neon banner rather than a square poster.
//
// slide2/3/4.png are the PREVIOUS brand's artwork (dated a day before this
// drop) — gold-on-black posters carrying another brand's logo and domain as
// pixels — so they are not imported here. Neither are banner.png / banner2-4:
// an imported image is an EMITTED image even when nothing renders it, so a
// dead import ships another brand's bytes on every deploy. banner1 /
// banner1-mobile belong to MainLayout's hero <picture> alone.
//
// Only what is printed on the banner may be stated in its alt.
import promoRanking from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 158. It states what the
// page holds — the offers the banner itself prints — and stops.
const pageDescription =
  "รวมโปรโมชั่น AURA456 ทั้งระบบแรงกิ้งลำดับขั้น ยิ่งฝากยิ่งอัพเลเวล รีเซ็ตทุก 2 เดือน โบนัสต้อนรับสมาชิกใหม่ โปรเพิ่มทุนฝากแรกของวัน และระบบคืนยอดเสีย Cash Back";

const pageTitle = "โปรโมชั่น AURA456 | แรงกิ้งลำดับขั้น โบนัสต้อนรับ โปรฝากแรกของวัน Cash Back";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "โปรโมชั่น AURA456 รวมสิทธิ์และระบบลำดับขั้นที่เปิดให้สมาชิกกดรับ";

const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoRanking.src,
});

// One image, so no grid — a grid-cols-1 sm:grid-cols-2 grid holding a single
// card reads as a layout that lost half its content. It is one centred column
// capped at max-w-3xl (768px) instead.
//
// sizes describes how wide the picture is DRAWN, not how wide a file to fetch.
// ContentBox wraps it in px-4 (2rem) + p-8 (4rem, stepping to p-10 = 5rem at
// md:), and the card caps at max-w-[1400px]:
//   < 768px  : คอลัมน์เดียวในกรอบ px-4 + p-8            → 100vw - 6rem
//   768–879  : กรอบ px-4 + p-10 ยังแคบกว่าเพดาน 768px    → 100vw - 7rem
//   ≥ 880px  : ภาพชนเพดาน max-w-3xl                      → 768px
const imageSizes = "(max-width: 767px) calc(100vw - 6rem), (max-width: 879px) calc(100vw - 7rem), 768px";

// ขอบม่วงนีออนของแบรนด์ล้อกับพื้นครามบนแบนเนอร์ แล้วสว่างขึ้นเป็นบานเย็นตอน hover
const imageClass =
  "mx-auto h-auto w-full max-w-3xl rounded-xl border border-[#8b3cf7]/40 object-contain shadow-[0_10px_30px_rgba(139,60,247,0.32)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff7fd4]/70 hover:shadow-[0_15px_40px_rgba(200,29,142,0.45)]";

// The column is drawn up to 768px, but the ladder is clamped to the file's own
// intrinsic width (600px here) so a sharp upscale never becomes a source and
// never ships more bytes than the file held.
const widthLadder = (img: { width: number }) => {
  const steps = [384, 576, 768].filter((w) => w < img.width);
  return [...steps, Math.min(img.width, 768)];
};

const promoAlt =
  "แบนเนอร์โปรโมชั่นนีออนแนวนอนบนพื้นครามเกือบดำ มุมซ้ายบนเป็นโลโก้ AURA456 พร้อมบรรทัดใต้โลโก้เขียนว่า CYBER MYSTIC CASINO กลางภาพเป็นคำว่า RANKING ตัวอักษรนีออนขนาดใหญ่ ถัดลงมาเป็นข้อความ ลำดับขั้น ยิ่งฝาก ยิ่งอัพเลเวล เพื่อรับโบนัสในการเล่น และ รีเซ็ตทุก 2 เดือน ด้านล่างเป็นแถวป้ายทรงข้าวหลามตัดเรืองแสงหกอันเรียงกัน กำกับว่า Spark จุดประกาย, Pulse พลังชีพจร, Nova ออร่าพุ่ง, Prism พลังหลากมิติ, Radiant เปล่งประกาย และ Eclipse ขั้นสูงสุด ผู้ครองเงาออร่า";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed">
        แบนเนอร์ด้านล่างคือสิทธิ์ที่ <strong class="text-[#ff2fb0]">AURA456</strong> เปิดให้สมาชิกกดรับอยู่ในรอบนี้ ทั้งระบบลำดับขั้นที่อัพเลเวลตามยอดฝากและรีเซ็ตทุก 2 เดือน โบนัสต้อนรับสมาชิกใหม่ โปรเพิ่มทุนสำหรับยอดฝากแรกของวัน และระบบคืนยอดเสีย Cash Back
        ชื่อของแต่ละขั้น เงื่อนไขของแต่ละสิทธิ์ และรอบเวลาที่ใช้คำนวณ พิมพ์อยู่บนแบนเนอร์ครบแล้ว จึงควรอ่านรายการที่จะรับอีกครั้งก่อนกด ทุกรายการเลือกกดรับเองได้จากหน้าเว็บก่อนเข้าเกม จบในไม่กี่วินาทีด้วยระบบออโต้ ไม่ต้องส่งสลิปและไม่ต้องรอแอดมินอนุมัติ
      </p>

      <Picture
        src={promoRanking}
        alt={promoAlt}
        loading="lazy"
        fetchpriority="low"
        widths={widthLadder(promoRanking)}
        sizes={imageSizes}
        class={imageClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#d8f2ff]/40 bg-gradient-to-r from-[#ffc9ee] via-[#ff2fb0] to-[#4a179e] px-10 py-3.5 text-lg font-black text-[#0b0528] shadow-[0_10px_30px_rgba(255,47,176,0.4)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(200,29,142,0.5)]">
          สมัครสมาชิก AURA456
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
