---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

// 9KPLUS: ticker หมุนมาเป็น Announcement3 ส่วนกล่องหน้าย่อยยังเป็น ContentBox
// (การ์ดถาวรของหน้าย่อย) เรียก <Announcement /> เปล่า ๆ เพราะ default message ของ
// variant นี้ถูกตั้งให้ตรงกับข้อความที่หน้าแรกส่งเข้าไป ticker จึงเหมือนกันทั้งเว็บ
// สีย้ายจากฟ้าอะซูร์คู่ทองส้มบนกรมท่าเข้มของแบรนด์ก่อน มาเป็นนีออนคริมสัน-ชมพูจัด
// บนผิวเกือบดำ — คริมสัน #f5003e / #ff4a74 / #b3022c คู่ชมพู #ff4fa3 / #7c1040
// บนผิว #120309 / #1f0611 เนื้อความ #ffe3ee
// วอลเปเปอร์รอบนี้เกือบดำ การ์ดจึงเป็นแผ่นเข้มลอยอยู่บนลายวงจรสีเลือดหมู
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// This page is an IMAGE page, not an article: the ContentBox title (the page's
// single h1), ONE short intro paragraph, the promo image grid, one CTA. Nothing
// else — no second-level headings, no section paragraphs. The artwork already
// prints its own message in large type, so prose below it re-types what the
// visitor can already read, in smaller letters. The brief gives this page no
// body at all. Final inventory for this page is h1 ×1, and no headings below it.
//
// ดรอปรอบนี้มีสไลด์ครบสี่ใบ (ลงวันที่เดียวกับ logo/banner1 ของแบรนด์นี้) กริดจึงลง
// ได้ครบทั้งสี่ ตั้งชื่อตัวแปรตามสิทธิ์ที่พิมพ์อยู่บนอาร์ตจริง:
//   slide1 = ขาใหญ่ ใจถึง! ฝากต่อเนื่องประจำเดือน ฝาก 20,000 ขึ้นไป รับโบนัสสูงสุด 30,000
//   slide2 = คืนยอดเสีย 5% ทุกวัน สูงสุด 50,000 บาท
//   slide3 = Happy Birthday เดือนเกิดรับของขวัญวันเกิด สูงสุด 20,000 บาท
//   slide4 = เซียนชนเซียน 1 แต้ม รับโบนัส 30% สูงสุด 5,000 บาท
// slide1 กับ slide2 ถูกใช้บนหน้าแรกด้วย (SevenThree สองบล็อก) การนำมาวางซ้ำในกริด
// ของหน้านี้ไม่ทำให้ไฟล์ถูก emit เพิ่ม เพราะเป็น asset เดียวกัน
//
// ไฟล์ banner ของแบรนด์ก่อนที่ยังค้างอยู่ใน src/assets ห้าม import ที่นี่เด็ดขาด
// ส่วนไฟล์ hero ของรอบนี้เป็นของ MainLayout จัดการเองเท่านั้น
//
// alt เขียนจากสิ่งที่วาดอยู่บนภาพจริง ทั้งข้อความไทยที่พิมพ์บนอาร์ตและฉาก — อาร์ต
// รอบนี้เป็นแบนเนอร์แนวนอน 600×250 ทั้งสี่ใบ ไม่ใช่ภาพจัตุรัสเหมือนดรอปก่อน
import promoMonthlyDeposit from "../assets/slide1.png";
import promoCashback from "../assets/slide2.png";
import promoBirthday from "../assets/slide3.png";
import promoDuel from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 158. It says what the page
// is for in one sentence and stops — it is not a table of contents.
const pageDescription = "รวมโปรโมชั่น 9KPLUS สล็อตเว็บตรง ทั้งโบนัสฝากต่อเนื่องประจำเดือน คืนยอดเสีย 5% ทุกวัน ของขวัญเดือนเกิด และโบนัสเซียนชนเซียน พร้อมเงื่อนไขรับสิทธิ์บนภาพแต่ละใบ";

const pageTitle = "โปรโมชั่น 9KPLUS | คืนยอดเสีย 5% ทุกวัน ฝากต่อเนื่องประจำเดือน และของขวัญเดือนเกิด";

// หัวข้อระดับ h1 ของหน้า แยกจากค่า title เพราะ title มีขีดคั่นแบรนด์อยู่
const pageHeading = "โปรโมชั่น 9KPLUS รวมสิทธิ์และโบนัสไฟแรงที่เปิดให้สมาชิกกดรับในรอบนี้";

const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoMonthlyDeposit.src,
});

// One column on phones, two from sm: up, gap-6 (1.5rem) between the cells.
//
// sizes describes how wide each cell is DRAWN, not how wide a file to fetch.
// ContentBox wraps the grid in px-4 (2rem) + p-8 (4rem, stepping to p-10 =
// 5rem at md:), and the card caps at max-w-[1400px]:
//   < 640px  : คอลัมน์เดียวเต็มกรอบ px-4 + p-8       → 100vw - 6rem
//   640–767  : 2 คอลัมน์ + gap-6 ยังเป็น p-8         → (100vw - 7.5rem) / 2
//   768–1431 : 2 คอลัมน์ + gap-6 ขยับเป็น p-10       → (100vw - 8.5rem) / 2
//   ≥ 1432px : การ์ดชนเพดาน 1400px                   → (1400 - 5rem - 1.5rem) / 2 = 648px
const imageSizes = "(max-width: 639px) calc(100vw - 6rem), (max-width: 767px) calc((100vw - 7.5rem) / 2), (max-width: 1431px) calc((100vw - 8.5rem) / 2), 648px";

// ขอบคริมสันล้อกับกรอบของการ์ด แล้วสว่างขึ้นเป็นชมพูจัดตอน hover
const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#f5003e]/80 object-contain shadow-[0_10px_30px_rgba(245,0,62,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff4fa3]/70 hover:shadow-[0_15px_40px_rgba(255,79,163,0.3)]";

// A cell is drawn up to 648px, but the ladder is clamped to each file's own
// intrinsic width (600px for all four promo images here) so a sharp upscale never
// becomes a source and never ships more bytes than the file held.
const widthLadder = (img: { width: number }) => {
  const steps = [384, 576, 648].filter((w) => w < img.width);
  return [...steps, Math.min(img.width, 648)];
};

const promos = [
  {
    src: promoMonthlyDeposit,
    alt: "ภาพโปรโมชั่นแนวนอนพื้นสีแดงเลือดหมู ชายสูงวัยเคราขาวสวมหมวกปานามาสีขาว สูทหนังสีน้ำตาลและแว่นกันแดดดำ ยืนยิ้มท่ามกลางธนบัตรที่ปลิวอยู่รอบตัว ตัวอักษรบนภาพเขียนว่า ขาใหญ่ ใจถึง! ฝากต่อเนื่องประจำเดือน ฝาก 20,000 ขึ้นไป รับโบนัสสูงสุด 30,000 และมีป้ายเงื่อนไขเรียงทางขวาว่า ฝาก 3 วัน รับ 1,200 ฝาก 7 วัน รับ 5,600 ฝาก 15 วัน รับ 12,000 และ ฝาก 30 วัน รับ 30,000",
  },
  {
    src: promoCashback,
    alt: "ภาพโปรโมชั่นแนวนอนพื้นสีแดงสด เสือการ์ตูนสวมแว่นกันแดดดำกอดเสาแดงทองและถือซองอั่งเปาสีแดง มีสัญลักษณ์ดอลลาร์สีทองลอยอยู่ทางขวา ตัวอักษรบนภาพเขียนว่า คืนยอดเสีย 5% ทุกวัน สูงสุด 50,000 บาท",
  },
  {
    src: promoBirthday,
    alt: "ภาพโปรโมชั่นแนวนอนพื้นสีม่วงแดง เค้กวันเกิดแต่งครีมชมพูปักเทียนสามเล่มอยู่ทางซ้าย หญิงสาวเสื้อไหมพรมสีชมพูยิ้มพร้อมชี้มือและถือลูกโป่งฟอยล์รูปหัวใจสีชมพูอยู่ทางขวา มีริบบิ้นทองปลิวเป็นฉากหลัง ตัวอักษรบนภาพเขียนว่า Happy Birthday เดือนเกิดรับของขวัญวันเกิด สูงสุด 20,000 บาท",
  },
  {
    src: promoDuel,
    alt: "ภาพโปรโมชั่นแนวนอนพื้นสีแดงเข้ม ชายหนุ่มสวมสูทเบอร์กันดีกับหูกระต่ายยืนอยู่หลังโต๊ะเดิมพัน มีกองชิปคาสิโนสีแดงดำขาวและไพ่เอซโพดำกับเอซโพแดงวางอยู่ด้านหน้า ตัวอักษรบนภาพเขียนว่า เซียนชนเซียน 1 แต้ม รับโบนัส 30% สูงสุด 5,000 บาท",
  },
];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed">
        ภาพด้านล่างคือโปรโมชั่นที่ 9KPLUS เปิดให้สมาชิกกดรับอยู่ในรอบนี้ ทั้งโบนัสฝากต่อเนื่องประจำเดือน คืนยอดเสียรายวัน ของขวัญเดือนเกิด และโบนัสเซียนชนเซียน
        รายละเอียดพิมพ์อยู่บนภาพครบแล้ว ทั้งยอดฝากขั้นต่ำ เปอร์เซ็นต์ที่ได้รับ และเพดานโบนัสสูงสุด จึงควรอ่านใบที่จะร่วมอีกครั้งก่อนกดรับ เพราะแต่ละใบคิดคนละเงื่อนไขกัน
        ทุกรายการกดรับเองได้ผ่านหน้าเว็บ เงื่อนไขชัดเจน ถอนกำไรได้จริง ไม่ติดเทิร์นโอเวอร์มหาโหด
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          promos.map((promo) => (
            <Picture
              src={promo.src}
              alt={promo.alt}
              loading="lazy"
              fetchpriority="low"
              widths={widthLadder(promo.src)}
              sizes={imageSizes}
              class={imageClass}
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={80}
            />
          ))
        }
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#ff4a74]/70 bg-gradient-to-r from-[#f5003e] via-[#ff4fa3] to-[#b3022c] px-10 py-3.5 text-xl font-black text-[#ffe3ee] shadow-[0_10px_30px_rgba(245,0,62,0.35)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,79,163,0.3)]">
          สมัครสมาชิก 9KPLUS
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
