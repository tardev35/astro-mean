---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";

// This page is an IMAGE page, not an article: the ContentBox title (the single
// <h1>), ONE short intro paragraph, the promo image grid, one CTA. Nothing
// else — no <h2>, no second section. The slides already print their own offer
// in large type, so prose below them re-types what the visitor can already
// read, in smaller letters. The docx gives this page a Title and a Meta and
// never a body.
//
// Named for the promotion each banner ACTUALLY shows, not for its file number.
// The กงล้อ88 drop (mtime 2026-08-16) is FOUR slides:
//   slide1 = คืนยอดเสียทุกวัน 5%
//   slide2 = แนะนำเพื่อนรับ 10%
//   slide3 = ขาใหญ่ ฝากต่อเนื่องประจำเดือน · ฝาก 20,000 ขึ้นไป รับโบนัสสูงสุด 30,000
//   slide4 = ฝากต่อเนื่อง · ฝาก 100 ครบ 10 วันรับ 100 ถึง ฝาก 1,000 รับ 1,000
// The mapping between file number and promotion changes with every asset drop,
// so these imports follow the ARTWORK — that is the whole reason the variables
// are named after the promotion instead of after the file.
//
// banner.png / banner2-4.png (mtime 2026-08-04) are leftovers from an older
// brand and must never be imported here: an imported image is an emitted image
// even when nothing renders it. Only what is printed on each banner may be
// stated on this page.
import proCashbackDaily from "../assets/slide1.png";
import proReferFriend from "../assets/slide2.png";
import proHighRollerMonthly from "../assets/slide3.png";
import proDepositStreak from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 159.
const pageDescription =
  "รวมโปรโมชั่น กงล้อ88 เว็บตรงสล็อตแตกหนัก ทั้งคืนยอดเสียทุกวัน 5% แนะนำเพื่อนรับ 10% โปรขาใหญ่ และฝากต่อเนื่องครบ 10 วันรับโบนัสเพิ่ม เงื่อนไขต่างกันแต่ละรายการ";

const pageTitle = "โปรโมชั่น กงล้อ88 คืนยอดเสียทุกวัน 5% แนะนำเพื่อนรับ 10% และโปรฝากต่อเนื่อง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: proCashbackDaily.src,
});

// Drawn one-up on phones inside the box's own padding (px-4 + p-8 = 6rem), then
// two-up from sm: inside that same padding plus one 2rem grid gap.
// ContentBoxCyberCut keeps p-8 at every breakpoint and caps at max-w-7xl
// (1280px), so the column stops growing at 592px once the viewport passes
// 1312px.
const imageSizes = "(max-width: 639px) calc(100vw - 6rem), (max-width: 1311px) calc((100vw - 8rem) / 2), 592px";

const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#ffcc4b]/35 object-contain shadow-[0_10px_30px_rgba(255,204,75,0.25)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffe974]/70 hover:shadow-[0_15px_40px_rgba(255,106,19,0.45)]";

// Capped at 600 because that is the intrinsic width of every slide*.png in this
// drop — the column is drawn up to 592px, so nothing above 600 buys detail.
const imageWidths = [320, 440, 600];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น กงล้อ88" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed">
        แบนเนอร์ด้านล่างคือสิทธิ์ที่ <strong class="text-[#ffcc4b]">กงล้อ88</strong> เปิดให้รับอยู่ในรอบนี้ทั้งหมด ทั้งเครดิตคืนยอดเสียรายวัน ค่าแนะนำเพื่อน โปรขาใหญ่ที่คิดจากยอดฝากสะสมประจำเดือน
        และโบนัสฝากต่อเนื่องครบสิบวัน แต่ละรายการคิดจากยอดฝากคนละชุด มีเพดานโบนัส เงื่อนไขทำยอด และรอบการรับสิทธิ์เป็นของตัวเอง
        จึงควรอ่านรายละเอียดบนแบนเนอร์ของรายการที่จะรับอีกครั้งก่อนกด
      </p>

      <div class="grid w-full grid-cols-1 gap-8 sm:grid-cols-2">
        <Picture
          src={proCashbackDaily}
          alt="แบนเนอร์โปรโมชั่นคืนยอดเสียทุกวัน 5% ของ กงล้อ88 พร้อมพรีเซนเตอร์หญิงชุดเลื่อมสีทองถือกล่องของขวัญ"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={proReferFriend}
          alt="แบนเนอร์โปรโมชั่นแนะนำเพื่อนรับ 10% ของ กงล้อ88 พร้อมพรีเซนเตอร์หญิงชุดเลื่อมสีทองถือโทรศัพท์มือถือ"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={proHighRollerMonthly}
          alt="แบนเนอร์โปรโมชั่นขาใหญ่ ฝากต่อเนื่องประจำเดือน ฝาก 20,000 ขึ้นไป รับโบนัสสูงสุด 30,000 พร้อมตารางฝากครบ 3 วันรับ 1,200 ไปจนถึงฝากครบ 30 วันรับ 30,000"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={proDepositStreak}
          alt="แบนเนอร์โปรโมชั่นฝากต่อเนื่อง ฝาก 100 ครบ 10 วันรับ 100 ไล่ขึ้นไปจนถึงฝาก 1,000 ครบ 10 วันรับ 1,000 พร้อมภาพมังกรทองพ่นไฟ"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#ffe974]/60 bg-gradient-to-r from-[#ffe974] via-[#ffcc4b] to-[#eb9a1d] px-10 py-3.5 text-lg font-black text-[#1e1105] shadow-[0_10px_30px_rgba(255,204,75,0.4)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,106,19,0.45)]">
          สมัครสมาชิก กงล้อ88
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
