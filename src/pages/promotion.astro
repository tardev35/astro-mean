---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// This page is an IMAGE page, not an article: the ContentBox title (the single
// <h1>), ONE short intro paragraph, the promo image grid, one CTA. Nothing
// else. The slides already print their own offer in large type, so prose below
// them re-types what the visitor can already read, in smaller letters. The docx
// gives this page a Title and a Meta and never a body.
//
// Named for the promotion each banner ACTUALLY shows, not for its file number.
// The MACAUBET drop (mtime 2026-08-14 07:21) is four slides carrying four
// distinct offers:
//   slide1 = สล็อตเว็บตรง เว็บลิขสิทธิ์แท้ · คืนยอดเสียสูงสุด 5 %
//   slide2 = โบนัสมาแล้ว ฝากประจำครบ 7 วัน · รับเครดิตฟรีไปเลย
//   slide3 = แจกหนักจัดเต็ม สุ่มแจกของรางวัลสุดพรีเมียม · รายละเอียดคลิก
//   slide4 = สุขสันต์วันเกิด ยอดฝากครบกำหนด · รับเลย 500 เครดิต
// The mapping between file number and promotion changes with every asset drop,
// so these imports follow the ARTWORK — that is the whole reason the variables
// are named after the promotion instead of after the file.
//
// banner.png and banner2/3/4.png are older leftovers (mtime 2026-08-04) and may
// not be pulled in here. Only what is printed on each banner may be stated on
// this page.
import proCashback from "../assets/slide1.png";
import proDeposit7Days from "../assets/slide2.png";
import proPrizeGiveaway from "../assets/slide3.png";
import proBirthday from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 159.
const pageDescription =
  "รวมโปรโมชั่นของ MACAUBET ในรอบนี้ ทั้งคืนยอดเสียสูงสุด 5% โบนัสฝากประจำครบ 7 วัน สุ่มแจกของรางวัลพรีเมียม และเครดิตวันเกิด ดูเงื่อนไขแต่ละรายการก่อนกดรับสิทธิ์";

const pageTitle = "โปรโมชั่น MACAUBET คืนยอดเสีย โบนัสฝากประจำ แจกของรางวัล และเครดิตวันเกิด";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: proCashback.src,
});

// Drawn one-up on phones inside the box's own padding (px-4 + p-8 = 6rem), then
// two-up from sm: inside that same padding plus one 2rem grid gap.
// ContentBoxPremium widens its padding at md: (p-8 → p-10) and caps at
// max-w-[1400px], so the column stops growing at 644px once the viewport passes
// 1432px.
const imageSizes =
  "(max-width: 639px) calc(100vw - 6rem), (max-width: 767px) calc((100vw - 8rem) / 2), (max-width: 1431px) calc((100vw - 9rem) / 2), 644px";

const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#59cb13]/35 object-contain shadow-[0_10px_30px_rgba(89,203,19,0.25)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f6c445]/70 hover:shadow-[0_15px_40px_rgba(142,240,74,0.45)]";

// Capped at 600 because that is the intrinsic width of every slide*.png in this
// drop — the column is drawn up to 644px, but asking for 644 only upscales a
// 600px source into a bigger file with no extra detail.
const imageWidths = [320, 440, 600];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น MACAUBET" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed">
        แบนเนอร์ด้านล่างคือสิทธิ์ที่ <strong class="text-[#8ef04a]">MACAUBET</strong> เปิดให้รับอยู่ในรอบนี้ทั้งหมด ทั้งเครดิตคืนยอดเสียสูงสุด 5% โบนัสของสมาชิกที่ฝากประจำครบ 7 วัน
        กิจกรรมสุ่มแจกของรางวัลสุดพรีเมียม และเครดิตวันเกิดสำหรับยอดฝากที่ครบกำหนด แต่ละรายการคิดจากฐานคนละชุดและมีรอบเวลาของตัวเอง เงื่อนไขเทิร์นโอเวอร์ หมวดเกมที่ร่วมรายการ
        และยอดขั้นต่ำต่อครั้งก็ไม่เหมือนกัน จึงควรอ่านรายละเอียดของรายการที่จะรับอีกครั้งก่อนกด
      </p>

      <div class="grid w-full grid-cols-1 gap-8 sm:grid-cols-2">
        <Picture
          src={proCashback}
          alt="แบนเนอร์โปรโมชั่น MACAUBET สล็อตเว็บตรง เว็บลิขสิทธิ์แท้ คืนยอดเสียสูงสุด 5 % มีหญิงสาวชุดเลื่อมสีเขียวถือไพ่โพดำคลี่เป็นพัด ข้างวงล้อรูเล็ตและชิปคาสิโนสีเขียวบนพื้นเขียวเข้ม"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={proDeposit7Days}
          alt="แบนเนอร์โปรโมชั่น MACAUBET โบนัสมาแล้ว ฝากประจำครบ 7 วัน รับเครดิตฟรีไปเลย มีหญิงสาวชุดสูทสีเขียวชูการ์ด FREE CREDIT ยืนข้างวงล้อสล็อตนีออนเขียวบนพื้นเขียวเข้ม"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={proPrizeGiveaway}
          alt="แบนเนอร์โปรโมชั่น MACAUBET แจกหนักจัดเต็ม สุ่มแจกของรางวัลสุดพรีเมียม รายละเอียดคลิก มีหญิงสาวชุดสูทดำยืนข้างกองทองและกล่องของขวัญ มีโทรศัพท์มือถือและลำโพงเป็นของรางวัล"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={proBirthday}
          alt="แบนเนอร์โปรโมชั่น MACAUBET สุขสันต์วันเกิด ยอดฝากครบกำหนด รับเลย 500 เครดิต มีเค้กวันเกิดสามชั้นลายคาสิโนสีเขียวทองประดับมงกุฎ และหญิงสาวชุดขาวถือกล่องของขวัญใต้ธงราว"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#f6c445]/60 bg-gradient-to-r from-[#8ef04a] via-[#59cb13] to-[#2c7a08] px-10 py-3.5 text-lg font-black text-[#041b06] shadow-[0_10px_30px_rgba(89,203,19,0.4)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(142,240,74,0.45)]">
          สมัครสมาชิก MACAUBET
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
