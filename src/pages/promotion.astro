---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// This page is an IMAGE page, not an article: the ContentBox title (the single
// <h1>), ONE short intro paragraph, the promo image grid, one CTA. Nothing
// else — no <h2>, no section paragraphs. The slides already print their own
// offer in large type, so prose below them re-types what the visitor can
// already read, in smaller letters. The docx gives this page a Title and a
// Meta and never a body.
//
// Named for what each banner ACTUALLY prints, not for its file number.
// The AURORA688 drop (mtime 2026-08-19) is FOUR usable slides, all 600 wide:
//   slide1 = โปรสมาชิกใหม่ ฝากรับเพิ่มทันที 100%
//   slide2 = แนะนำเพื่อน รับค่าคอมมิชชั่น 10% ตลอดชีพ
//   slide3 = สะสมเพชร รับแลกรางวัล
//   slide4 = คืนยอดเสีย 5% ทุกวัน
// The mapping between file number and artwork changes with every asset drop,
// so these imports follow the ARTWORK — that is the whole reason the variables
// are named after what is printed instead of after the file.
//
// banner2/3/4.png are leftovers from an older brand and must never be imported
// here: an imported image is an emitted image even when nothing renders it.
// banner1-mobile.* belongs to MainLayout's hero <picture> alone. Only what is
// printed on each banner may be stated on this page.
import promoNewMember from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import promoDiamond from "../assets/slide3.png";
import promoCashback from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 154.
const pageDescription = "รวมโปรโมชั่น AURORA688 ครบทุกสิทธิ์ในหน้าเดียว ทั้งโบนัสต้อนรับสมาชิกใหม่ เติมเงินรายวัน คืนยอดเสีย และแนะนำเพื่อน กดรับเองผ่านระบบออโต้ได้ตลอด 24 ชั่วโมง";

const pageTitle = "โปรโมชั่น AURORA688 | รวมโบนัสและสิทธิพิเศษครบทุกจังหวะ";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "โปรโมชั่น AURORA688 รวมโบนัสและสิทธิพิเศษครบทุกจังหวะ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoNewMember.src,
});

// Drawn one-up on phones inside the box's own padding (px-4 + p-8 = 6rem), then
// two-up from sm: inside that same padding plus one 2rem grid gap.
// ContentBoxNeumorphism stays at p-8 on every breakpoint and caps at
// max-w-[1400px], so the column stops growing at 652px once the viewport
// passes 1432px.
const imageSizes = "(max-width: 639px) calc(100vw - 6rem), (max-width: 1431px) calc((100vw - 8rem) / 2), 652px";

// ขอบเงินโครเมียมตัดกับงานอาร์ตที่เป็นดำทอง แล้วเรืองทองแบรนด์ตอน hover
const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#c3cddb]/35 object-contain shadow-[0_10px_30px_rgba(195,205,219,0.25)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e2c443]/70 hover:shadow-[0_15px_40px_rgba(226,196,67,0.45)]";

// Capped at 600 because that is the intrinsic width of every slide*.png in this
// drop — the column is drawn up to 652px, so nothing above 600 buys detail.
const imageWidths = [320, 440, 600];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed">
        แบนเนอร์ด้านล่างคือสิทธิ์ที่ <strong class="text-[#ffe9a3]">AURORA688</strong> เปิดให้สมาชิกกดรับอยู่ในรอบนี้ทั้งหมด รายละเอียดของแต่ละรายการพิมพ์อยู่บนแบนเนอร์ของตัวเองครบแล้ว
        แต่ละรายการคิดจากยอดคนละชุด มีเพดาน เงื่อนไขทำยอด และรอบเวลาการรับสิทธิ์เป็นของตัวเอง จึงควรอ่านแบนเนอร์ของรายการที่จะรับอีกครั้งก่อนกด
        ทุกสิทธิ์กดรับเองได้ผ่านระบบออโต้บนหน้าเว็บตลอด 24 ชั่วโมง จบได้ในไม่กี่คลิกโดยไม่ต้องส่งสลิปและไม่ต้องรอแอดมิน
      </p>

      <div class="grid w-full grid-cols-1 gap-8 sm:grid-cols-2">
        <Picture
          src={promoNewMember}
          alt="แบนเนอร์โปรโมชั่นพื้นดำทอง เขียนว่า โปรสมาชิกใหม่ ฝากรับเพิ่มทันที 100% มีตราสัญลักษณ์ สมาชิกใหม่รับสิทธิพิเศษ เฉพาะคุณเท่านั้น ไอคอนสี่ข้อ ฝากครั้งแรกรับเพิ่มทันที 100% ระบบปลอดภัยขั้นสูงเชื่อถือได้ 100% ฝาก-ถอนออโต้ 24 ชั่วโมงภายใน 30 วินาที และบริการลูกค้าตลอด 24 ชั่วโมง ซ้ายมือเป็นหญิงสาวชุดดำ ล้อมด้วยเหรียญทองและหีบสมบัติ"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoReferral}
          alt="แบนเนอร์โปรโมชั่นพื้นดำทอง เขียนว่า แนะนำเพื่อน รับค่าคอมมิชชั่น 10% ตลอดชีพ พร้อมไอคอนสี่ข้อ แนะนำง่ายเพียงส่งลิงก์ รับทันทีไม่มีขั้นต่ำ ตลอดชีพไม่มีวันหมดอายุ และมั่นคงปลอดภัยจ่ายจริงตรงเวลา ซ้ายมือเป็นหญิงสาวชุดดำกำลังชี้นิ้ว"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoDiamond}
          alt="แบนเนอร์โปรโมชั่นพื้นดำทอง เขียนว่า สะสมเพชร รับแลกรางวัล ยิ่งสะสมมากยิ่งได้มาก แสดงตัวอย่างรางวัลตั้งแต่ 500 เพชรแลกของที่ระลึก ไปจนถึง 20,000 เพชรแลกรางวัล 2,000 บาท พร้อมขั้นตอนสามข้อ เล่นเกมทำกิจกรรมรับเพชร สะสมเพชรให้ครบตามที่กำหนด แล้วแลกรางวัลได้ทันที"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoCashback}
          alt="แบนเนอร์โปรโมชั่นพื้นดำทอง ตัวอักษรใหญ่เขียนว่า คืนยอดเสีย 5% ทุกวัน คืนให้ทุกวันไม่มีขั้นต่ำ ถอนได้จริง พร้อมไอคอนสี่ข้อ รับคืนอัตโนมัติทุกวัน 00.00 น. มั่นคงปลอดภัยเชื่อถือได้ 100% ถอนได้จริงไม่มีขั้นต่ำ และเล่นได้ทุกเกมทั้งสล็อตบอลคาสิโน ซ้ายมือเป็นหญิงสาวชุดดำ ล้อมด้วยเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#c3cddb]/50 bg-gradient-to-r from-[#ffe9a3] via-[#e2c443] to-[#7d5714] px-10 py-3.5 text-lg font-black text-[#0a0806] shadow-[0_10px_30px_rgba(226,196,67,0.4)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(195,205,219,0.45)]">
          สมัครสมาชิก AURORA688
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
