---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// This page is an IMAGE page, not an article: the ContentBox title (the single
// <h1>), ONE short intro paragraph, the promo image grid, one CTA. Nothing
// else. The slides already print their own offer in large type, so prose below
// them re-types what the visitor can already read, in smaller letters. The docx
// gives this page a Title and a Meta and never a body. The FAST369 run inherited
// three <h2> sections and seven paragraphs from an earlier rebrand — deleted.
//
// Named for the promotion each banner ACTUALLY shows, not for its file number.
// The FAST369 drop (mtime 2026-08-13 06:03) is THREE slides, not four:
//   slide1 = สมัครสมาชิกใหม่ รับ 50% สูงสุดถึง 500 บาท
//   slide2 = คืนยอดเสีย 5% รับได้ทุกวัน ถอนได้สูงสุด 20 เท่า
//   slide3 = แนะนำเพื่อน รับค่าคอม 1% ยิ่งชวนมาก ยิ่งได้มาก
// The mapping between file number and promotion changes with every asset drop,
// so these imports follow the ARTWORK — that is the whole reason the variables
// are named after the promotion instead of after the file.
//
// slide4.png (mtime 2026-08-12) belongs to the PREVIOUS brand and its import was
// removed with this rebrand; banner.png and banner2/3/4 are older leftovers.
// None of them may be pulled in here. Only what is printed on each banner may be
// stated on this page.
import proWelcome from "../assets/slide1.png";
import proCashback from "../assets/slide2.png";
import proReferral from "../assets/slide3.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 156.
const pageDescription =
  "รวมโปรโมชั่น FAST369 ทั้งโบนัสสมาชิกใหม่ 50% สูงสุด 500 บาท คืนยอดเสีย 5% รับได้ทุกวัน และค่าคอมแนะนำเพื่อน 1% ดูเงื่อนไขของแต่ละรายการให้ครบก่อนกดรับสิทธิ์";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น FAST369 โบนัสสมาชิกใหม่ คืนยอดเสียรายวัน และค่าคอมแนะนำเพื่อน",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: proWelcome.src,
});

// Drawn one-up on phones inside the box's own padding (px-4 + p-8 = 6rem), then
// two-up from sm: inside that same padding plus one 2rem grid gap. ContentBoxCyberCut
// keeps p-8 at every breakpoint (no md:p-10) and caps at max-w-7xl, so the column
// stops growing at 592px once the viewport passes 1312px.
const imageSizes = "(max-width: 639px) calc(100vw - 6rem), (max-width: 1311px) calc((100vw - 8rem) / 2), 592px";

const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#e40613]/35 object-contain shadow-[0_10px_30px_rgba(228,6,19,0.25)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffc531]/70 hover:shadow-[0_15px_40px_rgba(255,197,49,0.45)]";

// Capped at 500 because that is the intrinsic width of every slide*.png in this
// drop — the column is drawn up to 592px, but asking for 592 only upscales a
// 500px source into a bigger file with no extra detail.
const imageWidths = [320, 400, 500];
---

<MainLayout title="โปรโมชั่น FAST369 โบนัสสมาชิกใหม่ คืนยอดเสียรายวัน และค่าคอมแนะนำเพื่อน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น FAST369" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed">
        แบนเนอร์ด้านล่างคือโปรโมชั่นที่ <strong class="text-[#ffc531]">FAST369</strong> เปิดให้รับอยู่ในรอบนี้ทั้งหมด ทั้งโบนัสสมาชิกใหม่ การคืนยอดเสียรายวัน
        และค่าคอมจากการแนะนำเพื่อน แต่ละรายการคิดจากฐานคนละชุดและมีรอบเวลาของตัวเอง เงื่อนไขเทิร์นโอเวอร์ หมวดเกมที่ร่วมรายการ และเพดานถอนของแต่ละโปรก็ไม่เหมือนกัน
        จึงควรอ่านรายละเอียดของรายการที่จะรับอีกครั้งก่อนกด
      </p>

      <div class="grid w-full grid-cols-1 gap-8 sm:grid-cols-2">
        <Picture
          src={proWelcome}
          alt="แบนเนอร์โปรโมชั่น FAST369 สมัครสมาชิกใหม่ รับ 50% สูงสุดถึง 500 บาท มีหญิงสาวชุดแดงถือไพ่ มังกรทอง และกองเหรียญทองบนพื้นสีแดง"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={proCashback}
          alt="แบนเนอร์โปรโมชั่น FAST369 คืนยอดเสีย 5% รับได้ทุกวัน ถอนได้สูงสุด 20 เท่า มีหญิงสาวชุดแดงประดับ ลูกเต๋าแดงคู่ ไพ่ ชิป และวงล้อบนพื้นสีแดง"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={proReferral}
          alt="แบนเนอร์โปรโมชั่น FAST369 แนะนำเพื่อน รับค่าคอม 1% ยิ่งชวนมาก ยิ่งได้มาก มีหญิงสาวสองคนชุดแดง กล่องของขวัญ และเหรียญทองบนพื้นสีแดง"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#ffc531]/60 bg-gradient-to-r from-[#ff3b2f] via-[#e40613] to-[#8f0206] px-10 py-3.5 text-lg font-black text-[#ffe27a] shadow-[0_10px_30px_rgba(228,6,19,0.4)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,197,49,0.45)]">
          สมัครสมาชิก FAST369
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
