---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";

import { Picture } from "astro:assets";

// This page is an IMAGE page, not an article: the ContentBox title (the single
// <h1>), ONE short intro paragraph, the promo image grid, one CTA. Nothing
// else — no <h2>, no section paragraphs. The slides already print their own
// offer in large type, so prose below them re-types what the visitor can
// already read, in smaller letters. The docx gives this page a Title and a
// Meta and never a body.
//
// Named for what each banner ACTUALLY prints, not for its file number.
// The PABO88 drop (2026-08-22) is TWO usable slides, both 600x600:
//   slide1 = คืนยอดเสีย ทุกวัน 30%
//   slide2 = ฝากแรก รับโบนัส 100%
// The mapping between file number and artwork changes with every asset drop,
// so these imports follow the ARTWORK — that is the whole reason the variables
// are named after what is printed instead of after the file.
//
// slide3.png (2026-08-21) and slide4.png (2026-08-21) predate this drop: they
// are the PREVIOUS brand's artwork and are deliberately NOT imported. An
// imported image is an emitted image even when nothing renders it, so the
// import line alone would ship another brand's art into dist/. Same for
// banner2/3/4.png. banner1-mobile.* belongs to MainLayout's hero <picture>
// alone. Only what is printed on each banner may be stated on this page.
import promoCashback30 from "../assets/slide1.png";
import promoFirstDeposit100 from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 152.
const pageDescription =
  "รวมโปรโมชั่น PABO88 ครบในหน้าเดียว คืนยอดเสียทุกวัน 30% และฝากแรกรับโบนัส 100% เงื่อนไขของแต่ละสิทธิ์พิมพ์อยู่บนแบนเนอร์ กดรับเองผ่านระบบออโต้ได้ตลอดวัน";

const pageTitle = "โปรโมชั่น PABO88 | คืนยอดเสียทุกวัน 30% ฝากแรกรับโบนัส 100%";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "โปรโมชั่น PABO88 รวมสิทธิ์คืนยอดเสียและโบนัสฝากแรกไว้ครบในหน้าเดียว";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback30.src,
});

// Drawn one-up on phones inside the box's own padding (px-4 + p-8 = 6rem), then
// two-up from sm: inside that same padding plus one 2rem grid gap — and from
// md: ContentBoxPremium grows its padding to p-10, so the sm and md steps are
// not the same number. The card caps at max-w-[1400px], so it stops growing
// once the viewport passes 1432px and the column settles at 644px.
const imageSizes =
  "(max-width: 639px) calc(100vw - 6rem), (max-width: 767px) calc((100vw - 8rem) / 2), (max-width: 1431px) calc((100vw - 9rem) / 2), 644px";

// ขอบทองแบรนด์ตัดกับงานอาร์ตพื้นม่วงนีออน แล้วเรืองทองอ่อนขึ้นตอน hover
const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#f5c518]/35 object-contain shadow-[0_10px_30px_rgba(191,60,250,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffe9a3]/70 hover:shadow-[0_15px_40px_rgba(245,197,24,0.45)]";

// Capped at 600 because that is the intrinsic width of every slide*.png in this
// drop — the column is drawn up to 644px, so nothing above 600 buys detail.
const imageWidths = [320, 440, 600];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed">
        แบนเนอร์ด้านล่างคือสิทธิ์ที่ <strong class="text-[#ffe9a3]">PABO88</strong> เปิดให้สมาชิกกดรับอยู่ในรอบนี้ทั้งหมด รายละเอียดของแต่ละรายการพิมพ์อยู่บนแบนเนอร์ของตัวเองครบแล้ว
        ทั้งเปอร์เซ็นต์ที่ได้รับ ยอดฝากที่ต้องทำ และรอบเวลาการรับสิทธิ์ แต่ละรายการคิดจากยอดคนละชุด จึงควรอ่านแบนเนอร์ของรายการที่จะรับอีกครั้งก่อนกด
        ทุกสิทธิ์กดรับเองได้ผ่านระบบออโต้บนหน้าเว็บตลอด 24 ชั่วโมง จบได้ในไม่กี่คลิกโดยไม่ต้องส่งสลิปและไม่ต้องรอแอดมินอนุมัติ
      </p>

      <div class="grid w-full grid-cols-1 gap-8 sm:grid-cols-2">
        <Picture
          src={promoCashback30}
          alt="แบนเนอร์โปรโมชั่นพื้นม่วงนีออนมีเหรียญทองและชิปคาสิโนลอยรอบภาพ ข้อความใหญ่เขียนว่า คืนยอดเสีย ทุกวัน 30% ด้านซ้ายเป็นหญิงสาวสวมที่คาดผมหูกระต่ายชุดม่วงยืนข้างตู้สล็อต 777 ด้านขวาเป็นฉลามใส่แว่นกันแดดสวมสร้อยทองข้างหีบสมบัติที่มีเหรียญทองล้นออกมา และมีป้ายโล่ด้านล่างเขียนว่า เล่นสนุก มั่นใจ ปลอดภัย 100%"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoFirstDeposit100}
          alt="แบนเนอร์โปรโมชั่นพื้นม่วงนีออน ข้อความใหญ่สามบรรทัดเขียนว่า ฝากแรก รับโบนัส 100% ด้านขวาบนเป็นตู้สล็อตเลข 77 สวมมงกุฎทอง ด้านซ้ายเป็นหญิงสาวชุดม่วงติดหูแมวถือไพ่เอซโพดำ ตรงกลางล่างเป็นกล่องของขวัญและหีบสมบัติที่มีเหรียญทองล้นออกมา ปิดท้ายด้วยแถบโลโก้ค่ายเกม PG Pragmatic Play Joker Relax Gaming Habanero และ Play'n GO"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#f5c518]/50 bg-gradient-to-r from-[#ffe9a3] via-[#f5c518] to-[#8f6205] px-10 py-3.5 text-lg font-black text-[#0a0118] shadow-[0_10px_30px_rgba(245,197,24,0.4)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(191,60,250,0.45)]">
          สมัครสมาชิก PABO88
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
