---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// DEED888: ticker หมุนมาเป็น Announcement5 และกล่องหน้าย่อยใช้ ContentBox
// ตามสเปกรอบนี้ เรียก <Announcement /> เปล่า ๆ เพราะ default message ของ variant
// นี้ถูกตั้งให้ตรงกับข้อความที่หน้าแรกส่งเข้าไป ticker จึงเหมือนกันทั้งเว็บ
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// This page is an IMAGE page, not an article: the ContentBox title (the single
// <h1>), ONE short intro paragraph, the promo image grid, one CTA. Nothing else
// — no <h2>, no section paragraphs. The artwork already prints its own offer in
// large type, so prose below it re-types what the visitor can already read, in
// smaller letters. The docx gives this page no body at all.
//
// Named for what each banner ACTUALLY prints, not for its file number. This
// drop has FOUR slides (2026-09-04) and all four run in the grid:
//   slide1 = สมาชิกใหม่ รับโบนัส 30% · สูงสุด 1,000 บาท · เล่นได้เฉพาะสล็อต
//   slide2 = ฝากแรกของวัน รับโบนัสสูงสุด 20%
//   slide3 = ลูกค้าไม้ใหญ่ รับโบนัส 10%
//   slide4 = เปิดกล่องสุ่ม ลุ้นรับเครดิตฟรี สูงสุดถึง 1,000
// ทุกไฟล์เป็นโปสเตอร์จัตุรัส 600x600 เท่ากันหมด กริดจึงเรียงลงตัวไม่มีช่องเตี้ยช่องสูง
//
// banner.png / banner2-4.png ไม่ถูก import ที่นี่: เป็นอาร์ตของแบรนด์ก่อน
// (ลงวันที่ 2026-08-04 และ 2026-08-18 คนละดรอปกับชุดนี้) และรูปที่ import แล้ว
// คือรูปที่ถูก emit ลง dist เสมอ ต่อให้ไม่มีใคร render
// ส่วน banner1 เป็นของ <picture> hero ใน MainLayout เท่านั้น
//
// Only what is printed on the banner may be stated in its alt — ทั้งสี่ไฟล์
// ถอดข้อความและองค์ประกอบบนภาพมาเขียน alt ตามอาร์ตดรอปวันที่ 2026-09-04
import promoNewMember from "../assets/slide1.png";
import promoFirstDeposit from "../assets/slide2.png";
import promoBigCustomer from "../assets/slide3.png";
import promoMysteryBox from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 155. It states what the
// page holds — the offers the banners themselves print — and stops.
const pageDescription =
  "รวมโปรโมชั่นสล็อต DEED888 ทั้งโบนัสสมาชิกใหม่ 30% สูงสุด 1,000 บาท ฝากแรกของวันรับเพิ่ม 20% ลูกค้าไม้ใหญ่รับ 10% และกล่องสุ่มลุ้นเครดิตฟรี เลือกกดรับได้เอง";

const pageTitle = "โปรโมชั่น DEED888 | โบนัสสมาชิกใหม่ 30% ฝากแรกของวัน และกล่องสุ่มเครดิตฟรี";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "โปรโมชั่น DEED888 จัดโปรฮิตมาเป็นชุดให้เลือกกดรับตามจังหวะที่ต้องการ";

const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoNewMember.src,
});

// One column on phones, two from sm: up, gap-6 (1.5rem) between the cells.
//
// sizes describes how wide each cell is DRAWN, not how wide a file to fetch.
// ContentBox wraps the grid in px-4 (2rem) + p-8 (4rem, stepping to p-10 =
// 5rem at md:), and the card caps at max-w-[1400px]:
//   < 640px  : คอลัมน์เดียวเต็มกรอบ px-4 + p-8       → 100vw - 6rem
//   640–767  : 2 คอลัมน์ + gap-6 ยังเป็น p-8         → (100vw - 7.5rem) / 2
//   768–1431 : 2 คอลัมน์ + gap-6 ขยับเป็น p-10       → (100vw - 8.5rem) / 2
//   ≥ 1432px : การ์ดชนเพดาน 1400px                   → (1400 - 5rem - 1.5rem) / 2 = 648px
const imageSizes =
  "(max-width: 639px) calc(100vw - 6rem), (max-width: 767px) calc((100vw - 7.5rem) / 2), (max-width: 1431px) calc((100vw - 8.5rem) / 2), 648px";

// ขอบส้มเพลิงของแบรนด์ล้อกับกรอบทองบนแบนเนอร์ แล้วสว่างขึ้นตอน hover
const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#93300a]/45 object-contain shadow-[0_10px_30px_rgba(107,34,5,0.32)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e95b0b]/70 hover:shadow-[0_15px_40px_rgba(233,91,11,0.45)]";

// A cell is drawn up to 648px, but the ladder is clamped to each file's own
// intrinsic width (600px for all four posters here) so a sharp upscale never
// becomes a source and never ships more bytes than the file held.
const widthLadder = (img: { width: number }) => {
  const steps = [384, 576, 648].filter((w) => w < img.width);
  return [...steps, Math.min(img.width, 648)];
};

const promos = [
  {
    src: promoNewMember,
    alt: "แบนเนอร์โปรโมชั่นแผงสีทองขอบมน กลางภาพเขียนว่า สมาชิกใหม่ รับโบนัส 30% ใต้ลงมาเขียนว่า สูงสุด 1,000 บาท และ เล่นได้เฉพาะสล็อต มุมซ้ายบนเป็นตัวการ์ตูนเลพริคอนหมวกเขียวนั่งข้างหม้อทองคำ มุมขวาบนเป็นเทวรูปพระพิฆเนศสีทอง มุมขวาล่างเป็นตัวการ์ตูนลาสวมเสื้อแจ็กเก็ตแดงยกนิ้วโป้งให้ รอบภาพมีแท่งทองและเหรียญทองกองอยู่",
  },
  {
    src: promoFirstDeposit,
    alt: "แบนเนอร์โปรโมชั่นแผงสีทองขอบมน กลางภาพเขียนว่า ฝากแรกของวัน รับโบนัสสูงสุด 20% มุมซ้ายบนเป็นตัวการ์ตูนเลพริคอนหมวกเขียว ด้านขวาเป็นชายยิ้มสวมแจ็กเก็ตสีเข้มถือกระป๋องสเปรย์ มุมขวาล่างเป็นจระเข้การ์ตูนสีเขียว รอบภาพมีแท่งทองและเหรียญทองกองอยู่",
  },
  {
    src: promoBigCustomer,
    alt: "แบนเนอร์โปรโมชั่นแผงสีทองขอบมน กลางภาพเขียนว่า ลูกค้าไม้ใหญ่ รับโบนัส 10% มุมซ้ายบนเป็นตัวการ์ตูนเลพริคอนหมวกเขียว ด้านขวาเป็นชายสวมเสื้อแข่งสีเหลืองของ PG ชูมือเชียร์ ถัดมาเป็นหญิงสาวนั่งเอนอยู่ในแก้วค็อกเทลใบใหญ่สีม่วง รอบภาพมีแท่งทองและเหรียญทองกองอยู่",
  },
  {
    src: promoMysteryBox,
    alt: "แบนเนอร์โปรโมชั่นแผงสีทองขอบมน กลางภาพเขียนว่า เปิดกล่องสุ่ม ลุ้นรับเครดิตฟรี สูงสุดถึง 1,000 มุมซ้ายบนเป็นตัวการ์ตูนเลพริคอนหมวกเขียว ด้านขวาเป็นหญิงสาวสวมเสื้อสีชมพูถือถ้วยรางวัลสีทอง มุมขวาล่างเป็นกล่องของขวัญสีขาวผูกริบบิ้นแดง รอบภาพมีแท่งทองและเหรียญทองกองอยู่",
  },
];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed">
        แบนเนอร์ด้านล่างคือโปรฮิตที่ <strong class="text-[#f4940c]">DEED888</strong> จัดมาเป็นชุดให้เลือกกดรับในรอบนี้ อัตราที่ได้รับและเงื่อนไขของแต่ละรายการพิมพ์อยู่บนภาพครบแล้ว
        แต่ละโปรมีเงื่อนไขของตัวเอง จึงควรอ่านรายการที่จะรับอีกครั้งก่อนกด ทุกสิทธิ์เลือกกดรับเองได้จากหน้าแดชบอร์ด ถอนได้จริง ไม่ติดล็อคยูส และไม่ต้องรอแอดมินอนุมัติ
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          promos.map((promo) => (
            <Picture
              src={promo.src}
              alt={promo.alt}
              loading="lazy"
              fetchpriority="low"
              widths={widthLadder(promo.src)}
              sizes={imageSizes}
              class={imageClass}
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={80}
            />
          ))
        }
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#ffcf6b]/50 bg-gradient-to-r from-[#ffcf6b] via-[#f4940c] to-[#e95b0b] px-10 py-3.5 text-lg font-black text-[#150401] shadow-[0_10px_30px_rgba(233,91,11,0.4)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(233,91,11,0.5)]">
          สมัครสมาชิก DEED888
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
