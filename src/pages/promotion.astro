---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

// This page is an IMAGE page, not an article: the ContentBox title (the single
// <h1>), ONE short intro paragraph, the promo image grid, one CTA. Nothing
// else — no <h2>, no second section. The slides already print their own offer
// in large type, so prose below them re-types what the visitor can already
// read, in smaller letters. The docx gives this page a Title and a Meta and
// never a body.
//
// Named for what each banner ACTUALLY prints, not for its file number.
// The MONACO89 drop (mtime 2026-08-18) is THREE usable slides:
//   slide1 = เว็บไซต์สล็อต API แท้ · ไม่ผ่านเอเย่นต์ · ส่งตรงจากเซิร์ฟหลัก
//   slide2 = เว็บตรง ไม่มีขั้นต่ำ · ทรูวอเลท · บริการ 24 ชม.
//   slide3 = อันดับ 1 ในทุกๆ เรื่องของการเดิมพัน · ฝาก-ถอน ออโต้ · จ่ายตรงทุกยอด
// slide4.png is STALE artwork left over from the PREVIOUS brand — it still
// prints that brand's logo and LINE id, so it must not be imported here or
// rendered anywhere. The file stays on disk as inventory; only the import is gone.
// The mapping between file number and artwork changes with every asset drop,
// so these imports follow the ARTWORK — that is the whole reason the variables
// are named after what is printed instead of after the file.
//
// banner.png / banner2-4.png (mtime 2026-08-04) are leftovers from an older
// brand and must never be imported here: an imported image is an emitted image
// even when nothing renders it. banner1-mobile.* belongs to MainLayout's hero
// <picture> alone. Only what is printed on each banner may be stated on this page.
import promoApiDirect from "../assets/slide1.png";
import promoWebtrong from "../assets/slide2.png";
import promoRankOne from "../assets/slide3.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 153.
const pageDescription =
  "รวมโปรโมชั่น MONACO89 สล็อตพรีเมียมระบบตรง API แท้ ดูสิทธิ์ที่เปิดให้สมาชิกรับอยู่ในรอบนี้ได้จากแบนเนอร์ในหน้าเดียว เงื่อนไขรับสิทธิ์ต่างกันในแต่ละรายการ";

const pageTitle = "โปรโมชั่น MONACO89 สล็อตพรีเมียมระบบตรง API แท้ โบนัสแตกบ่อย ไม่ล็อกยูส";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoApiDirect.src,
});

// Drawn one-up on phones inside the box's own padding (px-4 + p-8 = 6rem), then
// two-up from sm: inside that same padding plus one 2rem grid gap.
// ContentBoxPremium goes p-8 → md:p-10 and caps at max-w-[1400px], so the
// column stops growing at 644px once the viewport passes 1432px.
const imageSizes =
  "(max-width: 639px) calc(100vw - 6rem), (max-width: 767px) calc((100vw - 8rem) / 2), (max-width: 1431px) calc((100vw - 9rem) / 2), 644px";

const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#ef8f22]/35 object-contain shadow-[0_10px_30px_rgba(239,143,34,0.25)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffd77a]/70 hover:shadow-[0_15px_40px_rgba(209,32,26,0.45)]";

// Capped at 600 because that is the intrinsic width of every slide*.png in this
// drop — the column is drawn up to 644px, so nothing above 600 buys detail.
const imageWidths = [320, 440, 600];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น MONACO89" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed">
        แบนเนอร์ด้านล่างคือสิทธิ์ที่ <strong class="text-[#ef8f22]">MONACO89</strong> เปิดให้สมาชิกสล็อตรับอยู่ในรอบนี้ทั้งหมด ทั้งเบทขั้นต่ำเพียง 1 บาท ระบบฝากถอนออโต้ที่จ่ายตรงทุกยอด
        และช่องทางทรูวอลเล็ทกับธนาคารที่รองรับ แต่ละรายการคิดจากยอดคนละชุด มีเพดานเครดิต เงื่อนไขทำยอด และรอบเวลาการรับสิทธิ์เป็นของตัวเอง
        จึงควรอ่านรายละเอียดบนแบนเนอร์ของรายการที่จะรับอีกครั้งก่อนกด
      </p>

      <div class="grid w-full grid-cols-1 gap-8 sm:grid-cols-2">
        <Picture
          src={promoApiDirect}
          alt="แบนเนอร์ MONACO89 ข้อความเว็บไซต์สล็อต API แท้ ไม่ผ่านเอเย่นต์ ส่งตรงจากเซิร์ฟหลัก ระบุปลอดภัยมั่นใจ 100% เบทขั้นต่ำเพียง 1 บาท ถอนรวดเร็วภายใน 10 วินาที และบริการ 24 ชม. พร้อมหญิงสาวชุดราตรีสีทองสามคนถือช่อดอกไม้ทองท่ามกลางเหรียญทองปลิว และแถบโลโก้ธนาคารกับแอปสโตร์ด้านล่าง"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoWebtrong}
          alt="แบนเนอร์ MONACO89 ข้อความเว็บตรง ไม่ผ่านเอเย่นต์ ไม่มีขั้นต่ำ รับทรูวอเลท บริการ 24 ชม. และหมวดเดิมพัน บอล หวย มวย เกม คาสิโน พร้อมมาสคอตวัวกระทิงสีทองสวมแว่นกันแดด กองเหรียญทอง และเส้นขอบฟ้าเมืองยามค่ำคืนเป็นฉากหลัง"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoRankOne}
          alt="แบนเนอร์ MONACO89 ข้อความอันดับ 1 ในทุกๆ เรื่องของการเดิมพัน เราเป็นเว็บตรง ฝาก-ถอน ออโต้ จ่ายตรงทุกยอด และแอดมินพร้อมบริการ 24 ชม. พร้อมมาสคอตกระต่ายขาวสวมแจ็กเก็ตทองกับหมวกแก๊ปยกนิ้วโป้ง ข้างตู้สล็อตเลข 777 และกองเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#ffd77a]/60 bg-gradient-to-r from-[#ffd77a] via-[#ef8f22] to-[#a44516] px-10 py-3.5 text-lg font-black text-[#1a0d03] shadow-[0_10px_30px_rgba(239,143,34,0.4)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(209,32,26,0.45)]">
          สมัครสมาชิก MONACO89
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
