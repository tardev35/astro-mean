---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// This page is an IMAGE page, not an article: the ContentBox title (the single
// <h1>), ONE short intro paragraph, the promo image grid, one CTA. Nothing
// else — no <h2>, no section paragraphs. The slides already print their own
// offer in large type, so prose below them re-types what the visitor can
// already read, in smaller letters. The docx gives this page a Title and a
// Meta and never a body.
//
// Named for what each banner ACTUALLY prints, not for its file number.
// The UOK789 drop (2026-08-22) is FOUR slides, all 600x600 — but only THREE
// distinct offers:
//   slide1 = รับฟรีโบนัส สูงสุด 500.- (ฝากช่วง 20:00-22:00)
//   slide2 = คืนยอดเสียทุกวัน 5% ถอนได้ทันที ไม่มีเทิร์น
//   slide3 = งานอาร์ตชุดเดียวกับ slide1 (โบนัส 500.- ซ้ำ) — ไม่ import
//   slide4 = เล่นเสีย มีคืน ครบ 5 บิล แลกเครดิตฟรีสูงสุด 300 บาท
// The mapping between file number and artwork changes with every asset drop,
// so these imports follow the ARTWORK — that is the whole reason the variables
// are named after what is printed instead of after the file.
//
// slide3.png is deliberately NOT imported: it is the same picture as slide1, so
// importing it would both emit a second copy of one artwork into dist/ and show
// the visitor the same offer twice in the grid. An imported image is an emitted
// image even when nothing renders it. Same for banner2/3/4.png, which predate
// this drop. banner1-mobile.* belongs to MainLayout's hero <picture> alone.
// Only what is printed on each banner may be stated on this page.
import promoFreeBonus500 from "../assets/slide1.png";
import promoDailyCashback5 from "../assets/slide2.png";
import promoLossRebate300 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 155.
const pageDescription =
  "รวมโปรโมชั่น UOK789 ครบในหน้าเดียว รับฟรีโบนัสสูงสุด 500 บาท คืนยอดเสียทุกวัน 5% ถอนได้ไม่มีเทิร์น และเล่นเสียครบ 5 บิลแลกเครดิตฟรี เงื่อนไขพิมพ์บนแบนเนอร์";

const pageTitle = "โปรโมชั่น UOK789 | รับฟรีโบนัส 500 คืนยอดเสียทุกวัน 5%";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "โปรโมชั่น UOK789 รวมโบนัสฟรีและสิทธิ์คืนยอดเสียไว้ครบในหน้าเดียว";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoFreeBonus500.src,
});

// Drawn one-up on phones inside the box's own padding (px-4 + p-8 = 6rem), then
// two-up from sm: inside that same padding plus one 2rem grid gap — and from
// md: ContentBoxPremium grows its padding to p-10, so the sm and md steps are
// not the same number. The card caps at max-w-[1400px], so it stops growing
// once the viewport passes 1432px and the column settles at 644px.
const imageSizes =
  "(max-width: 639px) calc(100vw - 6rem), (max-width: 767px) calc((100vw - 8rem) / 2), (max-width: 1431px) calc((100vw - 9rem) / 2), 644px";

// ขอบทองแบรนด์ตัดกับงานอาร์ตพื้นเขียวมรกต แล้วเรืองทองอ่อนขึ้นตอน hover
const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#f6c945]/35 object-contain shadow-[0_10px_30px_rgba(47,196,79,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fdf3c9]/70 hover:shadow-[0_15px_40px_rgba(246,201,69,0.45)]";

// Capped at 600 because that is the intrinsic width of every slide*.png in this
// drop — the column is drawn up to 644px, so nothing above 600 buys detail.
const imageWidths = [320, 440, 600];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed">
        แบนเนอร์ด้านล่างคือสิทธิ์ที่ <strong class="text-[#fdf3c9]">UOK789</strong> เปิดให้สมาชิกกดรับอยู่ในรอบนี้ทั้งหมด รายละเอียดของแต่ละรายการพิมพ์อยู่บนแบนเนอร์ของตัวเองครบแล้ว
        ทั้งจำนวนเครดิตที่ได้รับ ยอดที่ต้องทำ รอบเวลาการรับสิทธิ์ และเงื่อนไขการถอน แต่ละรายการคิดจากยอดคนละชุด จึงควรอ่านแบนเนอร์ของรายการที่จะรับอีกครั้งก่อนกด
        ทุกสิทธิ์กดรับเองได้ผ่านระบบออโต้บนหน้าเว็บตลอด 24 ชั่วโมง จบได้ในไม่กี่คลิกโดยไม่ต้องส่งสลิปและไม่ต้องรอแอดมินอนุมัติ
      </p>

      <div class="grid w-full grid-cols-1 gap-8 sm:grid-cols-2">
        <Picture
          src={promoFreeBonus500}
          alt="แบนเนอร์โปรโมชั่นพื้นเขียวมรกตเข้มมีริบบิ้นทองปลิวทั่วภาพ ข้อความทองตัวใหญ่เขียนว่า รับฟรีโบนัส สูงสุด 500.- เพียงทำการฝากในช่วงเวลา 20:00-22:00 ด้านขวาเป็นหญิงสาวผมยาวสวมแจ็กเก็ตหนังเงาสีเขียวเข้ม แถบล่างเป็นโลโก้ UOK789 สีทอง คำว่า คาสิโนออนไลน์จาก USA โลโก้ค่ายเกมและช่องทางชำระเงิน พร้อมป้าย TrueMoney Wallet"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoDailyCashback5}
          alt="แบนเนอร์โปรโมชั่นพื้นเขียวมรกตเข้มมีริบบิ้นทองปลิว ข้อความเขียนว่า คืนยอดเสียทุกวัน ตามด้วยเลข 5% ตัวทองขนาดใหญ่กลางภาพ และบรรทัดล่างว่า ถอนได้ทันที ไม่มีเทิร์น ด้านขวาเป็นหญิงสาวสวมแจ็กเก็ตหนังเงาสีเขียวเข้ม แถบล่างเป็นโลโก้ UOK789 สีทอง คำว่า คาสิโนออนไลน์จาก USA โลโก้ค่ายเกมและช่องทางชำระเงิน พร้อมป้าย TrueMoney Wallet"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoLossRebate300}
          alt="แบนเนอร์โปรโมชั่นพื้นเขียวมรกตเข้มมีไพ่โพดำและริบบิ้นทองลอยรอบภาพ ข้อความเขียนว่า เล่นเสีย มีคืน เมื่อเล่นเสียครบ 5บิล นำมาแลกเครดิตฟรี สูงสุด 300 บาท และบรรทัดล่างในกรอบว่า ทำเทิร์น 10 เท่า ถอนได้สูงสุด 1,000.- ด้านซ้ายเป็นหญิงสาวสวมแจ็กเก็ตหนังเงาสีเขียวเข้มถือไพ่ในมือ แถบล่างเป็นโลโก้ UOK789 สีทอง คำว่า คาสิโนออนไลน์จาก USA โลโก้ค่ายเกมและช่องทางชำระเงิน พร้อมป้าย TrueMoney Wallet"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#f6c945]/50 bg-gradient-to-r from-[#fdf3c9] via-[#f6c945] to-[#8a6a1c] px-10 py-3.5 text-lg font-black text-[#04140a] shadow-[0_10px_30px_rgba(246,201,69,0.4)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(47,196,79,0.45)]">
          สมัครสมาชิก UOK789
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
