---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// Named for the promotion each banner ACTUALLY shows, not for its file number.
// A previous brand's copy on this page described a completely different set of
// offers while rendering these same four images — the text and the artwork
// disagreed on every card. Reading the banner is the only way to write this
// page. The 9UFA drop (2026-08-07) reads:
//   slide1 = แนะนำเพื่อน รับโบนัสสูงสุด 5000 บาท (+ ตารางขั้นบันไดจากยอดฝาก
//            สะสม 30 วัน: 10→5, 100→50, 1000→100, 10000→500, 100000→1000,
//            1000000→5000 เท่ากันทั้งผู้แนะนำและผู้ถูกแนะนำ)
//   slide2 = กิจกรรมวงล้อมหาโชค ลัคกี้สปิน ลุ้น iPhone รุ่นล่าสุด
//   slide3 = วันศุกร์ฝาก 100 รับ 99 / วันเสาร์ฝาก 100 รับ 199
//   slide4 = เชิญเพื่อนมาเล่น รับโบนัสส่วนลดเงินคืน 1.6%
// Apart from slide1's table, only the headline offer is printed on each banner
// — no turnover figure and no withdrawal cap appears on any of the four, so
// this page must not state one. banner2/3/4.png are the PREVIOUS brand's files
// and must not be pulled in here.
import proReferral5000 from "../assets/slide1.png";
import proLuckySpin from "../assets/slide2.png";
import proWeekend from "../assets/slide3.png";
import proInviteCashback from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 156.
const pageDescription =
  "รวมโปรโมชั่น 9UFA เว็บสล็อตยอดนิยม แนะนำเพื่อนรับสูงสุด 5000 บาท กิจกรรมวงล้อลัคกี้สปินลุ้น iPhone และโปรวันศุกร์เสาร์ ฝาก 100 รับ 199 อ่านเงื่อนไขก่อนกดรับ";

const announcement =
  "โปรโมชั่น 9UFA รอบนี้ สมัครสมาชิกใหม่รับทุนเล่นฟรี 199 บาททันที ไม่ต้องแชร์ • แนะนำเพื่อนรับโบนัสสูงสุด 5000 บาท • กิจกรรมวงล้อมหาโชค ลัคกี้สปิน ลุ้น iPhone รุ่นล่าสุด • วันศุกร์ฝาก 100 รับ 99 วันเสาร์ฝาก 100 รับ 199 • เทิร์นโอเวอร์ต่ำ ถอนได้จริง ไม่มีอั้นยอดถอนต่อวัน";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น 9UFA แนะนำเพื่อน 5000 บาท วงล้อลัคกี้สปิน และโปรวันศุกร์เสาร์",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: proReferral5000.src,
});

// Drawn one-up on phones inside the box's own padding (px-4 + p-8 = 6rem) and
// two-up from sm: upward inside the same padding plus a 2rem gap (8rem total).
const imageSizes = "(max-width: 639px) calc(100vw - 6rem), (max-width: 1456px) calc((100vw - 8rem) / 2), 600px";

const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#0a5df1]/35 object-contain shadow-[0_10px_30px_rgba(10,93,241,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#0a5df1]/70 hover:shadow-[0_15px_40px_rgba(1,203,246,0.32)]";

const headingClass = "bg-gradient-to-r from-[#0743a8] via-[#0a5df1] to-[#01cbf6] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="โปรโมชั่น 9UFA แนะนำเพื่อนรับ 5000 ลัคกี้สปินลุ้น iPhone ฝาก 100 รับ 199" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBox title="โปรโมชั่น 9UFA" as="h1">
    <div>
      <h2 class={`mb-4 ${headingClass}`}>โปรโมชั่น 9UFA ต้องอ่านเงื่อนไขตรงไหนก่อนกดรับ</h2>

      <p class="mb-5 text-left text-base leading-relaxed text-[#0b3a63]">
        <strong class="text-[#0743a8]">9UFA</strong> เป็นเว็บสล็อตยอดนิยมที่ดึงสัญญาณเกมตรงผ่าน API ลิขสิทธิ์แท้จากค่ายผู้พัฒนา ไม่ผ่านคนกลาง
        โปรโมชั่นที่เปิดให้กดรับจึงผูกอยู่กับยอดจริงในบัญชีของเราและเกมที่ร่วมรายการ ไม่ได้ลอยอยู่เดี่ยว ๆ ในหน้าโปร ตัวเลขใหญ่บนแบนเนอร์บอกได้แค่ว่ามีอะไรให้ ส่วนบรรทัดเล็กใต้ตัวเลขคือคนที่ตัดสินว่าเราได้จริงเท่าไร
        ก่อนกดรับจึงควรไล่ให้ครบทั้งห้าข้อ คือยอดที่ใช้คำนวณ จำนวนที่ได้รับจริง เงื่อนไขเทิร์นโอเวอร์ เกมที่ร่วมรายการ และรอบเวลาที่สิทธิ์นั้นเปิดให้รับ เพราะโปรแต่ละรายการกำหนดเงื่อนไขไม่เหมือนกัน
        การเลือกจากตัวเลขที่สูงที่สุดเพียงอย่างเดียวจึงไม่ใช่วิธีที่ปลอดภัยที่สุด
      </p>

      <p class="mb-8 text-left text-base leading-relaxed text-[#0b3a63]">
        จุดตั้งต้นของสมาชิกใหม่ที่นี่คือทุนเล่นฟรี 199 บาทที่ปรับเข้ากระเป๋าเครดิตทันทีหลังสมัครและยืนยันตัวตนผ่านระบบ ไม่ต้องแคปรูปลงกลุ่ม ไม่ต้องส่งต่อให้เพื่อนในไลน์ และไม่ต้องทักแชตยืนยันกับใคร
        ส่วนรายการที่เห็นบนหน้าโปรรอบนี้มีสี่ก้อนที่คิดจากฐานคนละชุดกัน คือแนะนำเพื่อนรับโบนัสสูงสุด 5000 บาทที่คิดเป็นขั้นบันไดจากยอดฝากสะสมของเพื่อน กิจกรรมวงล้อมหาโชคลัคกี้สปินที่ลุ้นของรางวัลเป็น iPhone รุ่นล่าสุด
        โปรตามวันที่แยกเงื่อนไขวันศุกร์กับวันเสาร์ออกจากกัน และโบนัสส่วนลดเงินคืน 1.6% สำหรับคนที่ชวนเพื่อนเข้ามาเล่น จุดเด่นของชุดนี้คือเงื่อนไขเทิร์นโอเวอร์ที่ตั้งไว้ต่ำ ไม่จุกจิก
        จึงเอาไปต่อยอดทำกำไรได้จริงแทนที่จะเป็นตัวเลขที่ติดอยู่ในระบบเฉย ๆ ตัวเลขเหล่านี้ควรใช้เป็นข้อมูลตั้งต้นแล้วตรวจจากหน้าโปรจริงอีกครั้งก่อนกด เพราะช่วงเวลาของสิทธิ์ ค่ายเกมที่ยกเว้น
        และการรับซ้อนกับรายการอื่นเป็นรายละเอียดที่เปลี่ยนได้ตามรอบ ถ้าแผนของเราคือหมุนตามงบแล้วปิดจบ การไม่รับสิทธิ์เลยก็เป็นทางเลือกที่สมเหตุสมผล เพราะโบนัสที่ยังติดเทิร์นไม่ได้แปลว่าเงินอยู่ในมือแล้ว
      </p>

      <h2 class={`mt-10 mb-4 ${headingClass}`}>รายการโปรโมชั่นทั้งหมดที่ 9UFA เปิดให้รับ</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#0b3a63]">
        แบนเนอร์ด้านล่างคือรายการจริงที่เปิดให้รับอยู่ในรอบนี้ อ่านคำอธิบายใต้ภาพให้ตรงกับสิ่งที่ตัวเองเล่นอยู่ก่อนตัดสินใจ เพราะสองรายการที่เกี่ยวกับการชวนเพื่อนคิดจากคนอื่นและจ่ายคนละแบบกัน
        ส่วนโปรตามวันกับกิจกรรมวงล้อผูกอยู่กับรอบเวลา ไม่ใช่ยอดสะสม รอบการรับสิทธิ์จึงไม่ตรงกันสักรายการ
      </p>

      <div class="grid w-full grid-cols-1 gap-8 sm:grid-cols-2">
        <figure class="m-0">
          <Picture
            src={proReferral5000}
            alt="แบนเนอร์โปรโมชั่น 9UFA แนะนำเพื่อน รับโบนัสสูงสุด 5000 บาท พร้อมตารางยอดฝากสะสม 30 วันเทียบโบนัสผู้แนะนำและผู้ถูกแนะนำ บนพื้นฟ้าขาว มีเด็กหญิงชุดฟ้าสวมมงกุฎเกล็ดหิมะสองคนอยู่ในกรอบวงกลม ลูกศรฟ้า และกล่องของขวัญ"
            loading="lazy"
            fetchpriority="low"
            widths={[300, 450, 600]}
            sizes={imageSizes}
            class={imageClass}
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={80}
          />
          <figcaption class="mt-3 text-left text-base leading-relaxed text-[#0b3a63]">
            <strong class="text-[#0743a8]">แนะนำเพื่อน รับโบนัสสูงสุด 5000 บาท</strong> คิดเป็นขั้นบันไดจากยอดฝากสะสม 30 วันของเพื่อนที่สมัครผ่านลิงก์ของเรา ตั้งแต่ยอด 10 ได้ 5 บาท ไล่ขึ้นไปจนยอด 1000000 ได้ 5000 บาท
            และตารางบนแบนเนอร์ให้ทั้งฝั่งผู้แนะนำและผู้ถูกแนะนำเท่ากันทุกขั้น ก้อนนี้จึงโตตามยอดของเพื่อน ไม่ได้โตตามยอดฝากของเราเอง
          </figcaption>
        </figure>

        <figure class="m-0">
          <Picture
            src={proLuckySpin}
            alt="แบนเนอร์โปรโมชั่น 9UFA กิจกรรมวงล้อมหาโชค ลัคกี้สปิน ลุ้น iPhone รุ่นล่าสุด บนพื้นฟ้าขาว มีเด็กหญิงชุดฟ้าสวมมงกุฎเกล็ดหิมะถือโทรศัพท์ยืนอยู่หน้าวงล้อสีฟ้าสลับขาว ท่ามกลางเหรียญทองที่ปลิวลงมา"
            loading="lazy"
            fetchpriority="low"
            widths={[300, 450, 600]}
            sizes={imageSizes}
            class={imageClass}
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={80}
          />
          <figcaption class="mt-3 text-left text-base leading-relaxed text-[#0b3a63]">
            <strong class="text-[#0743a8]">กิจกรรมวงล้อมหาโชค ลัคกี้สปิน</strong> เป็นรายการเดียวในชุดนี้ที่ของรางวัลไม่ใช่เครดิต แต่เป็น iPhone รุ่นล่าสุด แบนเนอร์พิมพ์ไว้แค่ชื่อกิจกรรมกับของรางวัล
            เงื่อนไขการได้สิทธิ์หมุนและรอบจับรางวัลจึงต้องเปิดดูจากหน้ากิจกรรมจริงอีกครั้ง ไม่ควรเดาจากตัวเลขบนภาพ
          </figcaption>
        </figure>

        <figure class="m-0">
          <Picture
            src={proWeekend}
            alt="แบนเนอร์โปรโมชั่น 9UFA วันศุกร์ฝาก 100 รับ 99 และวันเสาร์ฝาก 100 รับ 199 บนพื้นฟ้าขาว มีเด็กหญิงชุดฟ้าสวมมงกุฎเกล็ดหิมะถือไม้กายสิทธิ์ยืนข้างกล่องของขวัญใบใหญ่และแถบสายรุ้ง"
            loading="lazy"
            fetchpriority="low"
            widths={[300, 450, 600]}
            sizes={imageSizes}
            class={imageClass}
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={80}
          />
          <figcaption class="mt-3 text-left text-base leading-relaxed text-[#0b3a63]">
            <strong class="text-[#0743a8]">วันศุกร์ฝาก 100 รับ 99 วันเสาร์ฝาก 100 รับ 199</strong> เป็นโปรที่ผูกกับวันในสัปดาห์ ไม่ใช่ยอดสะสม ทั้งสองวันใช้ยอดฝากเท่ากันแต่ได้รับไม่เท่ากัน
            คนที่วางแผนเติมเงินไว้อยู่แล้วจึงได้ประโยชน์จากการเลือกวันมากกว่าการเพิ่มยอดฝาก และถ้าพลาดรอบของสัปดาห์นี้ก็ต้องรอรอบถัดไป
          </figcaption>
        </figure>

        <figure class="m-0">
          <Picture
            src={proInviteCashback}
            alt="แบนเนอร์โปรโมชั่น 9UFA เชิญเพื่อนมาเล่น รับโบนัสส่วนลดเงินคืน 1.6% บนพื้นฟ้าขาว มีเด็กหญิงชุดฟ้าสวมมงกุฎเกล็ดหิมะสองคนถือลูกโป่งโลโก้ 9UFA ยืนข้างไอคอนเพิ่มเพื่อนสีฟ้า"
            loading="lazy"
            fetchpriority="low"
            widths={[300, 450, 600]}
            sizes={imageSizes}
            class={imageClass}
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={80}
          />
          <figcaption class="mt-3 text-left text-base leading-relaxed text-[#0b3a63]">
            <strong class="text-[#0743a8]">เชิญเพื่อนมาเล่น รับโบนัสส่วนลดเงินคืน 1.6%</strong> เป็นก้อนที่คิดเป็นเปอร์เซ็นต์ต่อเนื่อง ไม่ใช่ขั้นบันไดแบบรายการแรก จึงเดินไปเรื่อย ๆ ตามการเล่นของเพื่อนที่ชวนมา
            ต่างจากโบนัสก้อนเดียวจบ และเป็นรายการที่ยังเดินต่อได้แม้วันไหนเราไม่ได้หมุนเอง
          </figcaption>
        </figure>
      </div>

      <h2 class={`mt-12 mb-4 ${headingClass}`}>รับโปรแล้วต้องตรวจเทิร์นและยอดถอนอย่างไร</h2>

      <p class="mb-5 text-left text-base leading-relaxed text-[#0b3a63]">
        หลังกดรับสิทธิ์ควรเปิดหน้าประวัติรายการดูว่ายอดโบนัสเข้าครบ เทิร์นเดินถูกเกม และยอดคงเหลือตรงกับที่ระบบแสดง เพราะบางรายการนับเฉพาะเกมสล็อตที่ร่วมโปร การหมุนในหมวดอื่นระหว่างที่เทิร์นยังไม่ครบจึงอาจไม่ถูกนับ
        อีกจุดที่คนอ่านข้ามบ่อยคือฐานที่ใช้คำนวณของแต่ละรายการ ทุนเล่นฟรี 199 ผูกกับการสมัครและยืนยันตัวตน โบนัสแนะนำเพื่อนคิดจากยอดฝากสะสมของเพื่อน โปรวันศุกร์และวันเสาร์คิดจากยอดฝากในวันนั้น
        ส่วนส่วนลดเงินคืน 1.6% คิดจากยอดของคนที่เราชวนมา ทั้งสี่ตัวเลขจึงเทียบกันตรง ๆ ไม่ได้ และควรอ่านเงื่อนไขของแต่ละรายการแยกกันก่อนวางแผนหมุน
      </p>

      <p class="mb-8 text-left text-base leading-relaxed text-[#0b3a63]">
        ด้านการเงิน 9UFA ใช้ระบบออโต้เต็มรูปแบบที่ทำรายการได้ด้วยตัวเองตลอดเวลา ไม่ต้องทักหาแอดมินและไม่ต้องรอคิวตรวจสลิป กดถอนแล้วยอดเด้งเข้าแอปธนาคารตามสถานะระบบในช่วงนั้น จ่ายเต็มทุกบิลโดยไม่หักเปอร์เซ็นต์
        และไม่มีการอั้นยอดถอนต่อวัน เงื่อนไขการทำเทิร์นก็ตั้งไว้ต่ำ ไม่ใช่ 20-30 เท่าแบบที่หลายเว็บใช้ เล่นให้ได้ยอดตามที่กำหนดแล้วกดถอนเข้าบัญชีได้เลย ก่อนทำรายการควรตรวจชื่อบัญชี ยอดเงิน และประวัติรายการให้ครบ
        หากยอดยังไม่เปลี่ยนไม่ควรกดซ้ำทันที เพราะนิ้วที่กดสองรอบไม่ได้ทำให้ธนาคารขยันขึ้น และควรกรอกข้อมูลเฉพาะบนโดเมนที่ตรวจแล้วและเชื่อมต่อแบบ HTTPS เท่านั้น ไม่ใช่ลิงก์ที่ส่งต่อกันมาในแชตพร้อมคำโฆษณา
      </p>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
