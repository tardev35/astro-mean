---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// This page is an IMAGE page, not an article: the ContentBox title (the single
// <h1>), ONE short intro paragraph, the promo image grid, one CTA. Nothing
// else — no <h2>, no section paragraphs. The slides already print their own
// offer in large type, so prose below them re-types what the visitor can
// already read, in smaller letters. The docx gives this page a Title and a
// Meta and never a body.
//
// Named for what each banner ACTUALLY prints, not for its file number.
// The PROFIT55 drop (2026-08-25) is two 600x143 slides, one offer each:
//   slide1 = คืนยอดเสีย 5% ทุกสัปดาห์
//   slide2 = หารายได้เสริมง่ายๆ ผ่าน ลิงค์รับทรัพย์ สูงสุด 2.5 เปอร์เซนต์
// The mapping between file number and artwork changes with every asset drop,
// so these imports follow the ARTWORK — that is the whole reason the variables
// are named after what is printed instead of after the file.
//
// slide3.png and slide4.png are deliberately NOT imported: both are left over
// from previous brands (slide3 is a red Fortune Tiger banner, slide4 has the
// UOK789 wordmark printed inside the artwork itself) and an imported image is
// an emitted image even when nothing renders it — importing either would put
// another brand's logo on this client's CDN. Same for banner.png and
// banner2/3/4.png. banner1.png / banner1-mobile.png belong to MainLayout's
// hero <picture> alone.
// Two images in the grid is the correct result this round; nothing is missing.
// Only what is printed on each banner may be stated on this page.
import promoCashback from "../assets/slide1.png";
import promoAffiliate from "../assets/slide2.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 160.
const pageDescription = "โปรโมชั่น PROFIT55 รวมไว้ครบในหน้าเดียว คืนยอดเสีย 5% ทุกสัปดาห์ และหารายได้เสริมผ่านลิงค์รับทรัพย์สูงสุด 2.5 เปอร์เซนต์ กดรับเองผ่านระบบออโต้ได้ตลอด 24 ชั่วโมง";

const pageTitle = "โปรโมชั่น PROFIT55 | คืนยอดเสีย 5% ทุกสัปดาห์ และลิงค์รับทรัพย์ 2.5%";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "โปรโมชั่น PROFIT55 รวมสิทธิ์ที่เปิดให้สมาชิกกดรับในรอบนี้";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// Drawn one-up on phones inside the box's own padding (px-4 + p-8 = 6rem), then
// two-up from sm: inside that same padding plus one 2rem grid gap. Unlike the
// CyberCut box the Premium box steps its padding up at md: (p-8 → p-10), so
// there is a third stop. The card caps at max-w-[1400px], so once the viewport
// passes 1432px it stops growing and the column settles at 644px.
const imageSizes = "(max-width: 639px) calc(100vw - 6rem), (max-width: 767px) calc((100vw - 8rem) / 2), (max-width: 1431px) calc((100vw - 9rem) / 2), 644px";

// ขอบทองแบรนด์ล้อกับงานอาร์ตพื้นทองของสไลด์ แล้วเรืองเงินโครเมียมขึ้นตอน hover
const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#e3ac22]/35 object-contain shadow-[0_10px_30px_rgba(227,172,34,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffe9a8]/70 hover:shadow-[0_15px_40px_rgba(207,216,226,0.45)]";

// Capped at 600 because that is the intrinsic width of every slide*.png in this
// drop — the column is drawn up to 644px, so nothing above 600 buys detail.
const imageWidths = [320, 440, 600];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed">
        แบนเนอร์ด้านล่างคือสิทธิ์ที่ <strong class="text-[#ffe9a8]">PROFIT55</strong> เปิดให้สมาชิกกดรับอยู่ในรอบนี้ทั้งหมด เปอร์เซ็นต์ที่ได้รับและรอบการคิดยอดของแต่ละรายการพิมพ์อยู่บนแบนเนอร์ของตัวเองแล้ว
        แต่ละรายการคิดจากยอดคนละชุดและมีเงื่อนไขของตัวเอง จึงควรอ่านแบนเนอร์ของรายการที่จะรับอีกครั้งก่อนกด ทุกสิทธิ์กดรับเองได้ผ่านระบบฝากถอนออโต้บนหน้าเว็บตลอด 24 ชั่วโมง จบได้ในไม่กี่ขั้นตอนโดยไม่ต้องส่งสลิปยืนยันและไม่ต้องรอคิวแอดมินอนุมัติ
      </p>

      <div class="grid w-full grid-cols-1 gap-8 sm:grid-cols-2">
        <Picture
          src={promoCashback}
          alt="แบนเนอร์โปรโมชั่นพื้นทอง มีตัวละครคาวบอยถือมือถือที่เปิดโลโก้ PG SLOT ยืนข้างวงล้อรูเล็ต ไพ่โพดำ และกองเหรียญทอง ข้อความเขียนว่า คืนยอดเสีย 5% ทุกสัปดาห์ พร้อมโลโก้ PROFIT55 สีโครเมียมและทอง"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={promoAffiliate}
          alt="แบนเนอร์โปรโมชั่นพื้นทอง มีฟาโรห์อียิปต์ยืนข้างตู้สล็อตลายพีระมิด ไพ่โพดำ และกองเหรียญทอง ข้อความเขียนว่า หารายได้เสริมง่ายๆ ผ่าน ลิงค์รับทรัพย์ สูงสุด 2.5 เปอร์เซนต์ พร้อมโลโก้ PROFIT55 สีโครเมียมและทอง"
          loading="lazy"
          fetchpriority="low"
          widths={imageWidths}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#eef3f8]/60 bg-gradient-to-r from-[#eef3f8] via-[#cfd8e2] to-[#8b96a4] px-10 py-3.5 text-lg font-black text-[#0a0702] shadow-[0_10px_30px_rgba(207,216,226,0.4)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(227,172,34,0.45)]">
          สมัครสมาชิก PROFIT55
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
