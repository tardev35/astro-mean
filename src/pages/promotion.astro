---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// PHOENIX168: ticker หมุนมาเป็น AnnouncementPremium และกล่องหน้าย่อยใช้ ContentBox
// ตามสเปกรอบนี้ เรียก <Announcement /> เปล่า ๆ เพราะ default message ของ variant
// นี้เป็นข้อความของแบรนด์นี้แล้ว ticker จึงเหมือนกันทั้งเว็บ
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// This page is an IMAGE page, not an article: the ContentBox title (the single
// <h1>), ONE short intro paragraph, the promo image grid, one CTA. Nothing else
// — no <h2>, no section paragraphs. The artwork already prints its own offer in
// large type, so prose below it re-types what the visitor can already read, in
// smaller letters. The docx gives this page a Title and a Meta and never a body.
//
// Named for what each banner ACTUALLY prints, not for its file number. This
// drop has THREE slides (2026-09-02) and all three run in the grid:
//   slide1 = ต้อนรับสมาชิกใหม่ ฝากแรก 500 รับโบนัส 300
//   slide2 = แนะนำเพื่อน รับโบนัสสูงสุด 20,000 บาทต่อวัน
//   slide3 = กงล้อนำโชค รับฟรีชิ้นส่วนเพชรทุกชม. ลุ้นรางวัลมูลค่ากว่า 500,000
// ทุกไฟล์เป็นโปสเตอร์ 600x251 เท่ากันหมด กริดจึงเรียงลงตัวไม่มีช่องเตี้ยช่องสูง
//
// slide4.png / banner.png / banner2-4.png ไม่ถูก import ที่นี่: เป็นอาร์ตของ
// แบรนด์ก่อน (slide4 ลงวันที่ 2026-09-01 คนละดรอปกับชุดนี้) และรูปที่ import
// แล้วคือรูปที่ถูก emit ลง dist เสมอ ต่อให้ไม่มีใคร render
// ส่วน banner1 เป็นของ <picture> hero ใน MainLayout เท่านั้น
//
// Only what is printed on the banner may be stated in its alt — ทั้งสามไฟล์
// เปิดดูด้วยตาแล้วเมื่อ 2026-09-02 แล้วถอดข้อความบนภาพมาเขียน alt
import promoWelcome from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import promoWheel from "../assets/slide3.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 158. It states what the
// page holds — the offers the banners themselves print — and stops.
const pageDescription =
  "รวมโปรโมชั่นสล็อต PHOENIX168 ทั้งโบนัสต้อนรับสมาชิกใหม่ ฝากแรก 500 รับโบนัส 300 โบนัสแนะนำเพื่อนสูงสุด 20,000 ต่อวัน และกงล้อนำโชคลุ้นรางวัลมูลค่ากว่า 500,000";

const pageTitle = "โปรโมชั่น PHOENIX168 | โบนัสต้อนรับสมาชิกใหม่ แนะนำเพื่อน และกงล้อนำโชค";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "โปรโมชั่น PHOENIX168 รวมสิทธิพิเศษสายสปีดที่กดรับเองได้ทันที";

const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoWelcome.src,
});

// One column on phones, two from sm: up, gap-6 (1.5rem) between the cells.
//
// sizes describes how wide each cell is DRAWN, not how wide a file to fetch.
// ContentBox wraps the grid in px-4 (2rem) + p-8 (4rem, stepping to p-10 =
// 5rem at md:), and the card caps at max-w-[1400px]:
//   < 640px  : คอลัมน์เดียวเต็มกรอบ px-4 + p-8       → 100vw - 6rem
//   640–767  : 2 คอลัมน์ + gap-6 ยังเป็น p-8         → (100vw - 7.5rem) / 2
//   768–1431 : 2 คอลัมน์ + gap-6 ขยับเป็น p-10       → (100vw - 8.5rem) / 2
//   ≥ 1432px : การ์ดชนเพดาน 1400px                   → (1400 - 5rem - 1.5rem) / 2 = 648px
const imageSizes =
  "(max-width: 639px) calc(100vw - 6rem), (max-width: 767px) calc((100vw - 7.5rem) / 2), (max-width: 1431px) calc((100vw - 8.5rem) / 2), 648px";

// ขอบส้มไฟของแบรนด์ล้อกับเปลวไฟบนแบนเนอร์ แล้วสว่างขึ้นตอน hover
const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#c04a12]/45 object-contain shadow-[0_10px_30px_rgba(122,36,8,0.32)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff5a1e]/70 hover:shadow-[0_15px_40px_rgba(255,90,30,0.45)]";

// A cell is drawn up to 648px, but the ladder is clamped to each file's own
// intrinsic width (600px for all three posters here) so a sharp upscale never
// becomes a source and never ships more bytes than the file held.
const widthLadder = (img: { width: number }) => {
  const steps = [384, 576, 648].filter((w) => w < img.width);
  return [...steps, Math.min(img.width, 648)];
};

const promos = [
  {
    src: promoWelcome,
    alt: "แบนเนอร์โปรโมชั่นพื้นแดงไล่ทองมีเหรียญทองและไพ่โพดำปลิวอยู่รอบภาพ ด้านซ้ายเป็นหญิงสาวผมยาวสวมชุดเกาะอกสีแดงเข้ม ข้อความกลางภาพเขียนว่า ต้อนรับสมาชิกใหม่ ถัดลงมาเป็นกล่องสองใบเขียนว่า ฝากแรก 500 และ รับโบนัส 300 แถบล่างสุดเขียนว่า เล่นได้เฉพาะสล็อตและกีฬาเท่านั้น",
  },
  {
    src: promoReferral,
    alt: "แบนเนอร์โปรโมชั่นพื้นแดงไล่ทองมีเหรียญทองและไพ่โพดำปลิวอยู่รอบภาพ ด้านซ้ายเป็นหญิงสาวผมยาวสวมชุดเกาะอกสีแดงเข้ม ข้อความกลางภาพเขียนว่า แนะนำเพื่อน รับโบนัสสูงสุด และบรรทัดล่างเป็นตัวเลขทองขนาดใหญ่เขียนว่า 20,000 บาท ต่อวัน",
  },
  {
    src: promoWheel,
    alt: "แบนเนอร์กิจกรรมพื้นแดงไล่ทองมีเพชรสีฟ้าและเหรียญทองกระจายทั่วภาพ ด้านซ้ายเป็นวงล้อเสี่ยงโชคและหญิงสาวสวมชุดสีแดง ข้อความกลางภาพเขียนว่า กงล้อนำโชค รับฟรีชิ้นส่วนเพชรทุกชม. บรรทัดถัดมาเขียนว่า สะสมหมุนกงล้อลุ้นรับของรางวัล และตัวเลขทองใหญ่สุดเขียนว่า มูลค่ากว่า 500,000.-",
  },
];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed">
        แบนเนอร์ด้านล่างคือสิทธิพิเศษที่ <strong class="text-[#ff5a1e]">PHOENIX168</strong> เปิดให้สมาชิกกดรับอยู่ในรอบนี้ ทั้งโบนัสต้อนรับสมาชิกใหม่ โบนัสจากการแนะนำเพื่อน และกิจกรรมกงล้อนำโชคที่สะสมชิ้นส่วนได้ทุกชั่วโมง
        ยอดที่รับได้ เงื่อนไขของแต่ละขั้น และช่วงเวลาที่ร่วมได้ พิมพ์อยู่บนแบนเนอร์ครบแล้ว จึงควรอ่านรายการที่จะรับอีกครั้งก่อนกด ทุกรายการกดรับเองได้จากหน้าแดชบอร์ดก่อนเริ่มสปิน เงื่อนไขโปร่งใส ไม่ติดเทิร์นโอเวอร์มหาโหด และไม่ต้องรอแอดมินอนุมัติ
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          promos.map((promo) => (
            <Picture
              src={promo.src}
              alt={promo.alt}
              loading="lazy"
              fetchpriority="low"
              widths={widthLadder(promo.src)}
              sizes={imageSizes}
              class={imageClass}
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={80}
            />
          ))
        }
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#ffe2c4]/40 bg-gradient-to-r from-[#ffe2c4] via-[#ff5a1e] to-[#7a2408] px-10 py-3.5 text-lg font-black text-[#0a0402] shadow-[0_10px_30px_rgba(255,90,30,0.4)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,90,30,0.5)]">
          สมัครสมาชิก PHOENIX168
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
