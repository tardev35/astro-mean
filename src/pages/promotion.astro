---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// JAICHUA: ticker หมุนมาเป็น AnnouncementPremium ส่วนกล่องหน้าย่อยยังเป็น ContentBox
// (การ์ดถาวรของหน้าย่อย) เรียก <Announcement /> เปล่า ๆ เพราะ default message ของ
// variant นี้ถูกตั้งให้ตรงกับข้อความที่หน้าแรกส่งเข้าไป ticker จึงเหมือนกันทั้งเว็บ
// สีย้ายจากน้ำเงินธงชาติคู่แดงบนกรมท่าเข้มของแบรนด์ก่อน มาเป็นทองคำคู่น้ำเงินรอยัล
// บนกรมท่าเกือบดำ — ทอง #fbeec9 / #f6d67e / #d8a83f / #a97722 / #6d4a12 คู่น้ำเงิน
// #cfe0fb / #5b8ede / #2f5fb0 / #16336b บนผิว #040915 / #0a1226 เนื้อความ #dce6f8
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// This page is an IMAGE page, not an article: the ContentBox title (the page's
// single h1), ONE short intro paragraph, the promo image grid, one CTA. Nothing
// else — no second-level headings, no section paragraphs. The artwork already
// prints its own message in large type, so prose below it re-types what the
// visitor can already read, in smaller letters. The docx gives this page no
// body at all. Final inventory for this page is h1 ×1, and no headings below it.
//
// ดรอปรอบนี้มีสไลด์สี่ใบ แต่กริดลงได้แค่สามใบ ตั้งชื่อตัวแปรตามสิ่งที่พิมพ์บนอาร์ตจริง:
//   slide1 = รับยอดเสีย 5% ทุกวัน
//   slide2 = ระบบสร้างรายได้ แนะนำเพื่อน รับค่าคอมมิชชั่น
//   slide3 = รองรับ TrueMoney Wallet
// slide4 (ทุกยอดฝาก 500 ขึ้นไป รับสิทธิ์หมุนวงล้อ) ถูกตัดออกทั้ง import และกริด
// เพราะอาร์ตใบนั้นมีลายน้ำโลโก้ของแบรนด์อื่นอยู่มุมซ้ายบน — ห้ามส่งขึ้นเว็บนี้
// และ import คือการ emit ปล่อยบรรทัด import ค้างไว้ก็เท่ากับอัปโหลดไฟล์นั้นอยู่ดี
//
// ไฟล์ banner ของแบรนด์ก่อนที่ยังค้างอยู่ใน src/assets ห้าม import ที่นี่เด็ดขาด
// ส่วนไฟล์ hero ของรอบนี้เป็นของ MainLayout จัดการเองเท่านั้น
//
// alt เขียนจากสิ่งที่วาดอยู่บนภาพจริง ทั้งข้อความที่พิมพ์บนอาร์ตและฉาก — เปิดดูทั้ง
// สามไฟล์แล้วถอดองค์ประกอบมาเขียนตามนั้น
import promoCashback from "../assets/slide1.png";
import promoReferral from "../assets/slide2.png";
import promoTrueMoney from "../assets/slide3.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 158. It says what the page
// is for in one sentence and stops — it is not a table of contents.
const pageDescription = "รวมโปรโมชั่น JAICHUA สล็อตเว็บตรง ที่เปิดให้สมาชิกกดรับเองผ่านแดชบอร์ด ทั้งโบนัสต้อนรับสมาชิกใหม่ โปรเติมเงินฝากแรกของวัน และสิทธิ์คืนยอดเสีย Cash Back ทุกวัน";

const pageTitle = "โปรโมชั่น JAICHUA | โบนัสต้อนรับสมาชิกใหม่ โปรฝากแรกของวัน และ Cash Back ทุกวัน";

// หัวข้อระดับ h1 ของหน้า แยกจากค่า title เพราะ title มีขีดคั่นแบรนด์อยู่
const pageHeading = "โปรโมชั่น JAICHUA รวมสิทธิ์และโบนัสที่กดรับเองได้ผ่านหน้าแดชบอร์ด";

const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// One column on phones, two from sm: up, gap-6 (1.5rem) between the cells.
//
// sizes describes how wide each cell is DRAWN, not how wide a file to fetch.
// ContentBox wraps the grid in px-4 (2rem) + p-8 (4rem, stepping to p-10 =
// 5rem at md:), and the card caps at max-w-[1400px]:
//   < 640px  : คอลัมน์เดียวเต็มกรอบ px-4 + p-8       → 100vw - 6rem
//   640–767  : 2 คอลัมน์ + gap-6 ยังเป็น p-8         → (100vw - 7.5rem) / 2
//   768–1431 : 2 คอลัมน์ + gap-6 ขยับเป็น p-10       → (100vw - 8.5rem) / 2
//   ≥ 1432px : การ์ดชนเพดาน 1400px                   → (1400 - 5rem - 1.5rem) / 2 = 648px
const imageSizes = "(max-width: 639px) calc(100vw - 6rem), (max-width: 767px) calc((100vw - 7.5rem) / 2), (max-width: 1431px) calc((100vw - 8.5rem) / 2), 648px";

// ขอบทองเข้มล้อกับกรอบของการ์ด แล้วสว่างขึ้นเป็นทองอ่อนตอน hover
const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#a97722]/80 object-contain shadow-[0_10px_30px_rgba(22,39,78,0.45)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f6d67e]/70 hover:shadow-[0_15px_40px_rgba(216,168,63,0.45)]";

// A cell is drawn up to 648px, but the ladder is clamped to each file's own
// intrinsic width (600px for all three promo images here) so a sharp upscale never
// becomes a source and never ships more bytes than the file held.
const widthLadder = (img: { width: number }) => {
  const steps = [384, 576, 648].filter((w) => w < img.width);
  return [...steps, Math.min(img.width, 648)];
};

const promos = [
  {
    src: promoCashback,
    alt: "แบนเนอร์แนวนอนพื้นน้ำเงินไล่เฉดสว่างกลางภาพ ตัวอักษรขนาดใหญ่สีขาวเขียนว่า รับยอดเสีย บรรทัดถัดมาเป็นเลข 5% สีทองคู่กับคำว่า ทุกวัน ฝั่งขวาเป็นหญิงสาวผมยาวสวมชุดสีน้ำเงินยิ้มพลางถือพัดธนบัตรไว้ข้างหน้า ด้านล่างเป็นตู้สล็อตที่หน้าปัดขึ้นเลข 777 รอบภาพมีสัญลักษณ์ดอลลาร์สีทอง ลูกเต๋าและชิปคาสิโนสีฟ้าลอยอยู่",
  },
  {
    src: promoReferral,
    alt: "แบนเนอร์แนวนอนพื้นน้ำเงินเข้มไล่เฉด ตัวอักษรสีขาวเขียนว่า ระบบสร้างรายได้ ใต้ลงมาเป็นตัวอักษรสีทองสองบรรทัดว่า แนะนำเพื่อน และ รับค่าคอมมิชชั่น ฝั่งขวาเป็นหญิงสาวผมยาวสวมชุดสีฟ้ายืนอยู่ข้างตู้สล็อตที่มีเหรียญทองล้นออกมาจากหน้าปัด รอบภาพมีสัญลักษณ์ดอลลาร์สีทองและเหรียญเงินปลิวอยู่",
  },
  {
    src: promoTrueMoney,
    alt: "แบนเนอร์แนวนอนพื้นน้ำเงินเข้ม ตัวอักษรสีขาวเขียนว่า รองรับ ใต้ลงมาเป็นตัวอักษรสีทองสองบรรทัดว่า TrueMoney Wallet ฝั่งขวาเป็นโทรศัพท์มือถือที่เปิดหน้าแอป TrueMoney Wallet โดยมีตัวการ์ตูนโจ๊กเกอร์ แมวดำสวมหมวกโจรสลัด และหมาชิบะสีเหลืองในถุงเหรียญยืนอยู่หน้าจอ มุมซ้ายล่างเป็นโลโก้ TrueMoney Wallet คู่กับป้าย Available on the App Store",
  },
];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed">
        ภาพด้านล่างคือโปรโมชั่นที่ JAICHUA เปิดให้สมาชิกกดรับเองผ่านหน้าแดชบอร์ดอยู่ในรอบนี้ ทั้งสิทธิ์คืนยอดเสีย Cash Back ทุกวัน ระบบแนะนำเพื่อนที่จ่ายค่าคอมมิชชั่นให้ต่อเนื่อง
        และช่องทางเติมเงินที่รองรับ TrueMoney Wallet เต็มรูปแบบ รายละเอียดของแต่ละรายการ พิมพ์อยู่บนภาพครบแล้ว จึงควรอ่านใบที่จะรับอีกครั้งก่อนกด เพราะแต่ละใบคิดคนละเงื่อนไขกัน
        ทุกสิทธิ์เลือกรับเองได้จากหน้าเว็บโดยตรง เงื่อนไขโปร่งใส ไม่ติดเทิร์นโอเวอร์มหาโหด และฝากถอนเป็นงานของระบบออโต้ที่ทำรายการเสร็จภายใน 3 วินาที ไม่ต้องส่งสลิปและไม่ต้องรอแอดมิน
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          promos.map((promo) => (
            <Picture
              src={promo.src}
              alt={promo.alt}
              loading="lazy"
              fetchpriority="low"
              widths={widthLadder(promo.src)}
              sizes={imageSizes}
              class={imageClass}
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={80}
            />
          ))
        }
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#f6d67e]/60 bg-gradient-to-r from-[#f6d67e] via-[#d8a83f] to-[#a97722] px-10 py-3.5 text-xl font-black text-[#040915] shadow-[0_10px_30px_rgba(216,168,63,0.4)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(246,214,126,0.5)]">
          สมัครสมาชิก JAICHUA
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
