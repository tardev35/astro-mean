---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// QUEEN189: ticker หมุนมาเป็น AnnouncementPremium ส่วนกล่องหน้าย่อยยังเป็น ContentBox
// (การ์ดถาวรของหน้าย่อย) เรียก <Announcement /> เปล่า ๆ เพราะ default message ของ
// variant นี้ถูกตั้งให้ตรงกับข้อความที่หน้าแรกส่งเข้าไป ticker จึงเหมือนกันทั้งเว็บ
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// This page is an IMAGE page, not an article: the ContentBox title (the single
// <h1>), ONE short intro paragraph, the promo image grid, one CTA. Nothing else
// — no <h2>, no section paragraphs. The artwork already prints its own offer in
// large type, so prose below it re-types what the visitor can already read, in
// smaller letters. The docx gives this page no body at all.
//
// Named for what each banner ACTUALLY prints, not for its file number. This
// drop has FOUR slides (2026-09-07) and all four run in the grid:
//   slide1 = คืน 5% ยอดเสีย · รับได้ทุกวันที่ 1 และ 15
//   slide2 = สมาชิกใหม่ ฝาก 100 รับ 200
//   slide3 = วงล้อแห่งโชคลาภ ลุ้นรับเงินโบนัส รับได้ทุกวัน
//   slide4 = แนะนำเพื่อน รับค่าคอมสูงถึง 1.25%
// ทั้งสี่ไฟล์เป็นแบนเนอร์แนวนอน 600x252 เท่ากันหมด กริดจึงเรียงลงตัวไม่มีช่องเตี้ยช่องสูง
// (ถ้าดรอปหน้าเปลี่ยนสัดส่วนอีก ให้ไล่เช็ก imageSizes กับ widthLadder ใหม่)
//
// banner.png / banner2-4.png ไม่ถูก import ที่นี่: เป็นอาร์ตของแบรนด์ก่อน
// (ลงวันที่ 2026-08-04 และ 2026-08-18 คนละดรอปกับชุดนี้) และรูปที่ import แล้ว
// คือรูปที่ถูก emit ลง dist เสมอ ต่อให้ไม่มีใคร render
// ส่วน banner1 / banner1-mobile เป็นของ <picture> hero ใน MainLayout เท่านั้น
//
// Only what is printed on the banner may be stated in its alt — ทั้งสี่ไฟล์
// ถอดข้อความและองค์ประกอบบนภาพมาเขียน alt ตามอาร์ตดรอปวันที่ 2026-09-07
import promoCashback from "../assets/slide1.png";
import promoWelcome from "../assets/slide2.png";
import promoLuckyWheel from "../assets/slide3.png";
import promoReferral from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 154. It states what the
// page holds — the offers the banners themselves print — and stops.
const pageDescription =
  "รวมโปรโมชั่น QUEEN189 คาสิโนมงลงทุกสปิน ทั้งคืนยอดเสีย 5% ทุกวันที่ 1 และ 15 สมาชิกใหม่ฝาก 100 รับ 200 วงล้อแห่งโชคลาภทุกวัน และแนะนำเพื่อนรับค่าคอม 1.25%";

const pageTitle = "โปรโมชั่น QUEEN189 | คืนยอดเสีย สมาชิกใหม่ วงล้อโชคลาภ และแนะนำเพื่อน";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "โปรโมชั่น QUEEN189 รวมโบนัสและกิจกรรมลุ้นรางวัลไว้ให้เลือกกดรับ";

const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// One column on phones, two from sm: up, gap-6 (1.5rem) between the cells.
//
// sizes describes how wide each cell is DRAWN, not how wide a file to fetch.
// ContentBox wraps the grid in px-4 (2rem) + p-8 (4rem, stepping to p-10 =
// 5rem at md:), and the card caps at max-w-[1400px]:
//   < 640px  : คอลัมน์เดียวเต็มกรอบ px-4 + p-8       → 100vw - 6rem
//   640–767  : 2 คอลัมน์ + gap-6 ยังเป็น p-8         → (100vw - 7.5rem) / 2
//   768–1431 : 2 คอลัมน์ + gap-6 ขยับเป็น p-10       → (100vw - 8.5rem) / 2
//   ≥ 1432px : การ์ดชนเพดาน 1400px                   → (1400 - 5rem - 1.5rem) / 2 = 648px
const imageSizes =
  "(max-width: 639px) calc(100vw - 6rem), (max-width: 767px) calc((100vw - 7.5rem) / 2), (max-width: 1431px) calc((100vw - 8.5rem) / 2), 648px";

// ขอบสำริดเข้มล้อกับกรอบทองบนแบนเนอร์ แล้วสว่างขึ้นเป็นทองหลักตอน hover
const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#7a5615]/45 object-contain shadow-[0_10px_30px_rgba(122,86,21,0.32)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e4bb53]/70 hover:shadow-[0_15px_40px_rgba(228,187,83,0.45)]";

// A cell is drawn up to 648px, but the ladder is clamped to each file's own
// intrinsic width (600px for all four banners here) so a sharp upscale never
// becomes a source and never ships more bytes than the file held.
const widthLadder = (img: { width: number }) => {
  const steps = [384, 576, 648].filter((w) => w < img.width);
  return [...steps, Math.min(img.width, 648)];
};

const promos = [
  {
    src: promoCashback,
    alt: "แบนเนอร์โปรโมชั่นแนวนอนพื้นดำ ตัวอักษรทองคำขนาดใหญ่เขียนว่า คืน 5% ยอดเสีย และบรรทัดล่างเขียนว่า รับได้ทุกวันที่ 1 และ 15 ด้านซ้ายเป็นหญิงสาวผมยาวในชุดราตรีสีทองระยิบ ยืนถือป้ายสี่เหลี่ยมสีดำที่มีคำว่า CASH BACK พร้อมลูกศรโค้ง ฉากหลังเป็นก้อนเพชรสีทอง เหรียญทองปลิว และประกายแสง",
  },
  {
    src: promoWelcome,
    alt: "แบนเนอร์โปรโมชั่นแนวนอนพื้นดำ ตัวอักษรทองคำขนาดใหญ่เขียนว่า สมาชิกใหม่ ฝาก 100 รับ 200 ด้านซ้ายเป็นหญิงสาวผมยาวในชุดราตรีสีทองปาดไหล่ ยิ้มพร้อมชูพัดธนบัตรอยู่ในมือ ล้อมด้วยก้อนเพชรสีทอง เหรียญทองปลิว และประกายแสง",
  },
  {
    src: promoLuckyWheel,
    alt: "แบนเนอร์โปรโมชั่นแนวนอนพื้นดำ ตัวอักษรทองคำขนาดใหญ่เขียนว่า วงล้อแห่งโชคลาภ ลุ้นรับเงินโบนัส รับได้ทุกวัน ด้านซ้ายเป็นหญิงสาวผมยาวในชุดราตรีสีทองยืนอยู่หน้าวงล้อหมุนลายทองสลับดำ ข้างกันเป็นกองเหรียญทองซ้อนสูงและประกายแสงทั่วภาพ",
  },
  {
    src: promoReferral,
    alt: "แบนเนอร์โปรโมชั่นแนวนอนพื้นดำ ตัวอักษรทองคำขนาดใหญ่เขียนว่า แนะนำเพื่อน รับค่าคอมสูงถึง 1.25% ด้านซ้ายเป็นหญิงสาวสองคนในชุดราตรีสีทองยืนเคียงกัน คนหนึ่งชูพัดธนบัตร ถัดมาเป็นกองเหรียญทองซ้อนสูงและประกายแสง",
  },
];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed">
        แบนเนอร์ด้านล่างคือโปรโมชั่นที่ <strong class="text-[#fceb83]">QUEEN189</strong> เปิดให้กดรับอยู่ในรอบนี้ ทั้งสิทธิ์คืนยอดเสีย โบนัสต้อนรับสมาชิกใหม่ วงล้อลุ้นรางวัล และค่าคอมจากการแนะนำเพื่อน
        อัตราที่ได้รับและกำหนดวันของแต่ละรายการพิมพ์อยู่บนภาพครบแล้ว แต่ละรายการมีเงื่อนไขของตัวเอง จึงควรอ่านใบที่จะรับอีกครั้งก่อนกด
        ทุกสิทธิ์เลือกกดรับเองได้จากหน้าเดียว ไม่ต้องรอแอดมินอนุมัติ ไม่ต้องส่งสลิป ไม่ติดเทิร์นโอเวอร์มหาโหด และถอนออกได้เต็มจำนวน
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          promos.map((promo) => (
            <Picture
              src={promo.src}
              alt={promo.alt}
              loading="lazy"
              fetchpriority="low"
              widths={widthLadder(promo.src)}
              sizes={imageSizes}
              class={imageClass}
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={80}
            />
          ))
        }
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#fceb83]/60 bg-gradient-to-r from-[#fdf3d2] via-[#e4bb53] to-[#c38d29] px-10 py-3.5 text-xl font-black text-[#0b0704] shadow-[0_10px_30px_rgba(228,187,83,0.4)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(252,235,131,0.5)]">
          สมัครสมาชิก QUEEN189
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
