---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";

// Named for the promotion each banner ACTUALLY shows, not for its file number.
// A previous brand's copy on this page described a completely different set of
// offers while rendering these same four images — the text and the artwork
// disagreed on every card. Reading the banner is the only way to write this
// page. The PODK888 drop (2026-08-08) reads:
//   slide1 = อัตราการจ่าย หวย สูงสุดในไทย (ตาราง 3 ตัวบน/โต๊ด/หน้า/ท้าย,
//            2 ตัวบน/ล่าง, วิ่งบน/วิ่งล่าง)
//   slide2 = CASH BACK คืนยอดเสีย ทุกวันจันทร์ — คาสิโน 5% ยิงปลา 5%
//            สล็อต 5% กีฬา 3%
//   slide3 = สร้างรายได้ จากการแนะนำเพื่อน ยิ่งชวนมาก ค่าตอบแทนยิ่งมากกว่าเดิม
//   slide4 = กิจกรรม วงล้อนำโชค แต้มสะสมเพชร จากยอดฝากและยอดเสียต่อวัน
// Apart from slide1's payout table and slide2's cashback percentages, only the
// headline offer is printed on each banner — no turnover figure and no
// withdrawal cap appears on any of the four, so this page must not state one.
// banner2/3/4.png are the PREVIOUS brand's files and must not be pulled in here.
import proCashbackMonday from "../assets/slide2.png";
import proLuckyWheel from "../assets/slide4.png";
import proReferral from "../assets/slide3.png";
import proHuayPayout from "../assets/slide1.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 156.
const pageDescription =
  "รวมโปรโมชั่น PODK888 เว็บตรงเกมครบทุกสาย ทั้งคืนยอดเสียทุกวันจันทร์ กิจกรรมวงล้อนำโชคสะสมเพชร ระบบแนะนำเพื่อน และอัตราการจ่ายหวยสูงสุด อ่านเงื่อนไขก่อนกดรับ";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น PODK888 คืนยอดเสียทุกวันจันทร์ วงล้อนำโชค และแนะนำเพื่อน",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: proCashbackMonday.src,
});

// Drawn one-up on phones inside the box's own padding (px-4 + p-8 = 6rem) and
// two-up from sm: upward inside the same padding plus a 2rem gap (8rem total).
const imageSizes = "(max-width: 639px) calc(100vw - 6rem), (max-width: 1456px) calc((100vw - 8rem) / 2), 600px";

const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#f670b7]/35 object-contain shadow-[0_10px_30px_rgba(246,112,183,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f670b7]/70 hover:shadow-[0_15px_40px_rgba(2,219,253,0.32)]";

const headingClass = "bg-gradient-to-r from-[#f670b7] via-[#e01e83] to-[#02dbfd] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="โปรโมชั่น PODK888 คืนยอดเสียทุกวันจันทร์ วงล้อนำโชค แนะนำเพื่อน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น PODK888" as="h1">
    <div>
      <h2 class={`mb-4 ${headingClass}`}>โปรโมชั่น PODK888 ต้องอ่านเงื่อนไขตรงไหนก่อนกดรับ</h2>

      <p class="mb-5 text-left text-base leading-relaxed text-[#f3d7e7]">
        <strong class="text-[#f670b7]">PODK888</strong> เป็นเว็บตรงที่รวมเกมไว้ครบทุกสายในแพลตฟอร์มเดียว ทั้งสล็อต บาคาร่า และคาสิโนสดจากค่ายแท้ที่คัดมาแล้ว
        โปรโมชั่นที่เปิดให้กดรับจึงผูกอยู่กับยอดจริงในบัญชีของเราและหมวดเกมที่ร่วมรายการ ไม่ได้ลอยอยู่เดี่ยว ๆ ในหน้าโปร ตัวเลขใหญ่บนแบนเนอร์บอกได้แค่ว่ามีอะไรให้ ส่วนบรรทัดเล็กใต้ตัวเลขคือคนที่ตัดสินว่าเราได้จริงเท่าไร
        ก่อนกดรับจึงควรไล่ให้ครบทั้งห้าข้อ คือยอดที่ใช้คำนวณ จำนวนที่ได้รับจริง เงื่อนไขเทิร์นโอเวอร์ หมวดเกมที่ร่วมรายการ และรอบเวลาที่สิทธิ์นั้นเปิดให้รับ เพราะโปรแต่ละรายการกำหนดเงื่อนไขไม่เหมือนกัน
        การเลือกจากตัวเลขที่สูงที่สุดเพียงอย่างเดียวจึงไม่ใช่วิธีที่ปลอดภัยที่สุด
      </p>

      <p class="mb-8 text-left text-base leading-relaxed text-[#f3d7e7]">
        รายการที่เห็นบนหน้าโปรรอบนี้มีสี่ก้อนที่คิดจากฐานคนละชุดกัน คือคืนยอดเสียทุกวันจันทร์ที่แยกเปอร์เซ็นต์ตามหมวดเกม กิจกรรมวงล้อนำโชคที่สะสมแต้มเป็นเพชรจากยอดฝากและยอดเสียต่อวัน
        ระบบแนะนำเพื่อนที่จ่ายค่าตอบแทนเพิ่มขึ้นตามจำนวนคนที่ชวนเข้ามา และอัตราการจ่ายหวยที่พิมพ์ตารางไว้ครบทุกประเภทบนแบนเนอร์ สี่ก้อนนี้ไม่ได้แข่งกันเอง แต่คิดจากพฤติกรรมการเล่นคนละแบบ
        คนที่หมุนสล็อตเป็นหลักกับคนที่นั่งโต๊ะคาสิโนสดจึงได้ประโยชน์จากคนละรายการกัน ตัวเลขเหล่านี้ควรใช้เป็นข้อมูลตั้งต้นแล้วตรวจจากหน้าโปรจริงอีกครั้งก่อนกด เพราะช่วงเวลาของสิทธิ์ ค่ายเกมที่ยกเว้น
        และการรับซ้อนกับรายการอื่นเป็นรายละเอียดที่เปลี่ยนได้ตามรอบ ถ้าแผนของเราคือหมุนตามงบแล้วปิดจบ การไม่รับสิทธิ์เลยก็เป็นทางเลือกที่สมเหตุสมผล เพราะโบนัสที่ยังติดเทิร์นไม่ได้แปลว่าเงินอยู่ในมือแล้ว
      </p>

      <h2 class={`mt-10 mb-4 ${headingClass}`}>รายการโปรโมชั่นทั้งหมดที่ PODK888 เปิดให้รับ</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#f3d7e7]">
        แบนเนอร์ด้านล่างคือรายการจริงที่เปิดให้รับอยู่ในรอบนี้ อ่านคำอธิบายใต้ภาพให้ตรงกับสิ่งที่ตัวเองเล่นอยู่ก่อนตัดสินใจ เพราะสองรายการแรกคิดจากยอดของเราเองแต่คนละฐาน
        ส่วนระบบแนะนำเพื่อนคิดจากคนอื่น และตารางอัตราจ่ายหวยไม่ใช่โบนัสที่ต้องกดรับแต่เป็นเรตที่ใช้คำนวณเงินรางวัล รอบการรับสิทธิ์จึงไม่ตรงกันสักรายการ
      </p>

      <div class="grid w-full grid-cols-1 gap-8 sm:grid-cols-2">
        <figure class="m-0">
          <Picture
            src={proCashbackMonday}
            alt="แบนเนอร์โปรโมชั่น PODK888 คืนยอดเสีย ทุกวันจันทร์ ป้ายริบบิ้นสีทองคำว่า CASH BACK บนพื้นคลื่นสีม่วงชมพู พร้อมไอคอนไพ่ ปลา สล็อต และลูกฟุตบอล กำกับอัตราคืนยอดคาสิโน 5% ยิงปลา 5% สล็อต 5% และกีฬา 3%"
            loading="lazy"
            fetchpriority="low"
            widths={[300, 450, 600]}
            sizes={imageSizes}
            class={imageClass}
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={80}
          />
          <figcaption class="mt-3 text-left text-base leading-relaxed text-[#f3d7e7]">
            <strong class="text-[#f670b7]">คืนยอดเสีย ทุกวันจันทร์</strong> เป็นรายการเดียวในชุดนี้ที่ยิ่งเสียยิ่งได้คืน และแยกเปอร์เซ็นต์ตามหมวดเกมชัดเจน คือคาสิโน 5% ยิงปลา 5% สล็อต 5% และกีฬา 3%
            ก้อนนี้จึงคิดจากยอดเสียสะสมของสัปดาห์ที่ผ่านมา ไม่ใช่ยอดฝาก คนที่เล่นกระจายหลายหมวดควรดูว่ายอดของตัวเองไปหนักอยู่หมวดไหน เพราะอัตราคืนของกีฬาต่ำกว่าอีกสามหมวด
          </figcaption>
        </figure>

        <figure class="m-0">
          <Picture
            src={proLuckyWheel}
            alt="แบนเนอร์โปรโมชั่น PODK888 กิจกรรมวงล้อนำโชค แต้มสะสมเพชรจากยอดฝากและยอดเสียต่อวัน บนพื้นคลื่นสีม่วงชมพู มีวงล้อรางวัลที่ช่องเป็นทองแท่ง เหรียญทอง และปึกธนบัตร พร้อมตารางขั้นยอดฝากและยอดเสียที่แลกเป็นเพชร"
            loading="lazy"
            fetchpriority="low"
            widths={[300, 450, 600]}
            sizes={imageSizes}
            class={imageClass}
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={80}
          />
          <figcaption class="mt-3 text-left text-base leading-relaxed text-[#f3d7e7]">
            <strong class="text-[#f670b7]">กิจกรรมวงล้อนำโชค สะสมแต้มเพชร</strong> ไม่ได้จ่ายเป็นเครดิตทันที แต่ให้สะสมเพชรจากทั้งยอดฝากและยอดเสียในแต่ละวัน แล้วเอาเพชรไปหมุนวงล้อลุ้นของรางวัล
            เป็นรายการที่เดินสะสมได้ทุกวันแม้ไม่ได้ฝากก้อนใหญ่ ขั้นการแลกเพชรและรอบหมุนพิมพ์ไว้บนแบนเนอร์แล้ว แต่ควรเปิดดูจากหน้ากิจกรรมจริงอีกครั้ง ไม่ควรเดาจากตัวเลขบนภาพ
          </figcaption>
        </figure>

        <figure class="m-0">
          <Picture
            src={proReferral}
            alt="แบนเนอร์โปรโมชั่น PODK888 สร้างรายได้จากการแนะนำเพื่อน ระบบแนะนำเพื่อน ยิ่งชวนมาก ค่าตอบแทนยิ่งมากกว่าเดิม บนพื้นคลื่นสีม่วงชมพู มีโทรศัพท์มือถือแสดงหน้าลิงก์แนะนำเพื่อนพร้อมคิวอาร์โค้ดและเหรียญทองกองอยู่รอบ ๆ"
            loading="lazy"
            fetchpriority="low"
            widths={[300, 450, 600]}
            sizes={imageSizes}
            class={imageClass}
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={80}
          />
          <figcaption class="mt-3 text-left text-base leading-relaxed text-[#f3d7e7]">
            <strong class="text-[#f670b7]">สร้างรายได้จากการแนะนำเพื่อน</strong> เป็นก้อนเดียวที่ไม่ได้คิดจากยอดของเราเอง แต่คิดจากคนที่สมัครผ่านลิงก์ของเรา แบนเนอร์ระบุไว้ว่ายิ่งชวนมาก ค่าตอบแทนยิ่งมากกว่าเดิม
            จึงเป็นรายการที่ยังเดินต่อได้แม้วันไหนเราไม่ได้หมุนเอง ต่างจากโบนัสก้อนเดียวจบ และเป็นก้อนที่ต้องดูจากหน้าระบบแนะนำเพื่อนในบัญชีว่ายอดของเพื่อนเดินถึงขั้นไหนแล้ว
          </figcaption>
        </figure>

        <figure class="m-0">
          <Picture
            src={proHuayPayout}
            alt="แบนเนอร์ PODK888 อัตราการจ่ายหวยสูงสุดในไทย บนพื้นคลื่นสีม่วงชมพู มีตารางอัตราจ่ายบาทละ 3 ตัวบน 900 3 ตัวโต๊ด 120 3 ตัวหน้า 450 3 ตัวท้าย 450 2 ตัวบน 100 2 ตัวล่าง 100 วิ่งบน 3 และวิ่งล่าง 4 พร้อมลูกบอลเลขรางวัล"
            loading="lazy"
            fetchpriority="low"
            widths={[300, 450, 600]}
            sizes={imageSizes}
            class={imageClass}
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={80}
          />
          <figcaption class="mt-3 text-left text-base leading-relaxed text-[#f3d7e7]">
            <strong class="text-[#f670b7]">อัตราการจ่ายหวยสูงสุดในไทย</strong> ต่างจากอีกสามรายการตรงที่ไม่ใช่โบนัสให้กดรับ แต่เป็นเรตที่ใช้คูณเงินรางวัล ตารางบนแบนเนอร์ให้ครบทุกประเภทตั้งแต่ 3 ตัวบนไปจนถึงวิ่งล่าง
            ตัวเลขชุดนี้จึงอ่านเป็นบาทละ ไม่ใช่เปอร์เซ็นต์คืนยอด และควรเทียบกับเรตที่แสดงในหน้าแทงจริงก่อนวางบิลทุกครั้ง
          </figcaption>
        </figure>
      </div>

      <h2 class={`mt-12 mb-4 ${headingClass}`}>รับโปรแล้วต้องตรวจเทิร์นและยอดถอนอย่างไร</h2>

      <p class="mb-5 text-left text-base leading-relaxed text-[#f3d7e7]">
        หลังกดรับสิทธิ์ควรเปิดหน้าประวัติรายการดูว่ายอดโบนัสเข้าครบ เทิร์นเดินถูกหมวดเกม และยอดคงเหลือตรงกับที่ระบบแสดง เพราะบางรายการนับเฉพาะหมวดที่ร่วมโปร การเล่นในหมวดอื่นระหว่างที่เทิร์นยังไม่ครบจึงอาจไม่ถูกนับ
        อีกจุดที่คนอ่านข้ามบ่อยคือฐานที่ใช้คำนวณของแต่ละรายการ คืนยอดเสียคิดจากยอดเสียสะสมและแยกเปอร์เซ็นต์ตามหมวด แต้มเพชรของวงล้อคิดจากยอดฝากและยอดเสียต่อวัน ค่าตอบแทนแนะนำเพื่อนคิดจากยอดของคนที่เราชวนมา
        ส่วนอัตราจ่ายหวยคิดเป็นบาทละจากเงินที่แทงลงไป ทั้งสี่ตัวเลขจึงเทียบกันตรง ๆ ไม่ได้ และควรอ่านเงื่อนไขของแต่ละรายการแยกกันก่อนวางแผนเล่น
      </p>

      <p class="mb-8 text-left text-base leading-relaxed text-[#f3d7e7]">
        ด้านการเงิน PODK888 อัปเกรดเป็นระบบออโต้แบบใหม่ที่ทำรายการได้ด้วยตัวเองตลอดเวลา ไม่ต้องทักหาแอดมินและไม่ต้องรอคิวตรวจสลิป กดปุ๊บเงินเด้งปั๊บตามสถานะระบบในช่วงนั้น
        ไม่ว่าจะยอดหลักร้อยหรือหลักล้านก็ปลอดภัยทุกยอดและข้อมูลไม่รั่วไหล เว็บเปิดให้บริการมาโดยไม่มีประวัติโกงหรือบิดยอด และมีทีมงานสแตนด์บายดูแลตั้งแต่ตอนสมัครไปจนถึงตอนกดถอนเข้าบัญชี
        ก่อนทำรายการควรตรวจชื่อบัญชี ยอดเงิน และประวัติรายการให้ครบ หากยอดยังไม่เปลี่ยนไม่ควรกดซ้ำทันที เพราะนิ้วที่กดสองรอบไม่ได้ทำให้ธนาคารขยันขึ้น และควรกรอกข้อมูลเฉพาะบนโดเมนที่ตรวจแล้วและเชื่อมต่อแบบ HTTPS เท่านั้น
        ไม่ใช่ลิงก์ที่ส่งต่อกันมาในแชตพร้อมคำโฆษณา
      </p>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#f670b7]/60 bg-gradient-to-r from-[#f670b7] to-[#02dbfd] px-10 py-3.5 text-lg font-black text-[#12060f] shadow-[0_10px_30px_rgba(246,112,183,0.35)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(2,219,253,0.45)]">
          สมัครสมาชิก PODK888
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
