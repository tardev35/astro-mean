---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";

// XONEBET: ticker หมุนมาเป็น Announcement2 และกล่องหน้าย่อยใช้ ContentBox
// ตามสเปกรอบนี้ เรียก <Announcement /> เปล่า ๆ เพราะ default message ของ variant
// นี้ถูกตั้งให้ตรงกับข้อความที่หน้าแรกส่งเข้าไป ticker จึงเหมือนกันทั้งเว็บ
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// This page is an IMAGE page, not an article: the ContentBox title (the single
// <h1>), ONE short intro paragraph, the promo image grid, one CTA. Nothing else
// — no <h2>, no section paragraphs. The artwork already prints its own offer in
// large type, so prose below it re-types what the visitor can already read, in
// smaller letters. The docx gives this page no body at all.
//
// Named for what each banner ACTUALLY prints, not for its file number. This
// drop has FOUR slides (2026-09-04) and all four run in the grid:
//   slide1 = สุดพิเศษ!! เราคืนกำไรให้ลูกค้า · คืนยอดเสีย 10% · แนะนำเพื่อน 100%
//   slide2 = คืนค่าคอมมิสชั่นสูงสุด · สล็อตคืนสูงถึง 2% · บาคาร่าคืนสูงถึง +1%
//   slide3 = อัพเดทระบบใหม่ ระบบสุ่ม ลุ้นทองคำแท่งและเครดิตฟรี · ฝาก 200฿ รับสูงสุด 500฿
//   slide4 = ทายแชมป์ฟุตบอลโลก FIFA WORLD CUP 2026 · รางวัลใหญ่ 300,000
// ทั้งสี่ไฟล์เป็นแบนเนอร์แนวนอน 600x125 เท่ากันหมด กริดจึงเรียงลงตัวไม่มีช่องเตี้ยช่องสูง
// (ดรอปก่อนหน้าเป็นโปสเตอร์จัตุรัส — ถ้าเปลี่ยนสัดส่วนอีก ให้ไล่เช็ก imageSizes ใหม่)
//
// banner.png / banner2-4.png ไม่ถูก import ที่นี่: เป็นอาร์ตของแบรนด์ก่อน
// (ลงวันที่ 2026-08-04 และ 2026-08-18 คนละดรอปกับชุดนี้) และรูปที่ import แล้ว
// คือรูปที่ถูก emit ลง dist เสมอ ต่อให้ไม่มีใคร render
// ส่วน banner1 เป็นของ <picture> hero ใน MainLayout เท่านั้น
//
// Only what is printed on the banner may be stated in its alt — ทั้งสี่ไฟล์
// ถอดข้อความและองค์ประกอบบนภาพมาเขียน alt ตามอาร์ตดรอปวันที่ 2026-09-04
import promoCashback from "../assets/slide1.png";
import promoCommission from "../assets/slide2.png";
import promoRandomReward from "../assets/slide3.png";
import promoWorldCup from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 156. It states what the
// page holds — the offers the banners themselves print — and stops.
const pageDescription =
  "รวมโปรโมชั่นสล็อต XONEBET ทั้งคืนยอดเสีย 10% แนะนำเพื่อน 100% คืนค่าคอมมิสชั่นสล็อตสูงถึง 2% บาคาร่า 1% และกิจกรรมลุ้นทองคำแท่งกับเครดิตฟรี เลือกกดรับได้เอง";

const pageTitle = "โปรโมชั่น XONEBET | คืนยอดเสีย แนะนำเพื่อน คืนค่าคอมมิสชั่น และกิจกรรมลุ้นรางวัล";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "โปรโมชั่น XONEBET รวมสิทธิ์คืนกำไรและกิจกรรมลุ้นรางวัลไว้ให้เลือกกดรับ";

const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: promoCashback.src,
});

// One column on phones, two from sm: up, gap-6 (1.5rem) between the cells.
//
// sizes describes how wide each cell is DRAWN, not how wide a file to fetch.
// ContentBox wraps the grid in px-4 (2rem) + p-8 (4rem, stepping to p-10 =
// 5rem at md:), and the card caps at max-w-[1400px]:
//   < 640px  : คอลัมน์เดียวเต็มกรอบ px-4 + p-8       → 100vw - 6rem
//   640–767  : 2 คอลัมน์ + gap-6 ยังเป็น p-8         → (100vw - 7.5rem) / 2
//   768–1431 : 2 คอลัมน์ + gap-6 ขยับเป็น p-10       → (100vw - 8.5rem) / 2
//   ≥ 1432px : การ์ดชนเพดาน 1400px                   → (1400 - 5rem - 1.5rem) / 2 = 648px
const imageSizes =
  "(max-width: 639px) calc(100vw - 6rem), (max-width: 767px) calc((100vw - 7.5rem) / 2), (max-width: 1431px) calc((100vw - 8.5rem) / 2), 648px";

// ขอบทองหลอมของแบรนด์ล้อกับกรอบทองบนแบนเนอร์ แล้วสว่างขึ้นตอน hover
const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#a87c02]/45 object-contain shadow-[0_10px_30px_rgba(92,67,1,0.32)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ebb101]/70 hover:shadow-[0_15px_40px_rgba(235,177,1,0.45)]";

// A cell is drawn up to 648px, but the ladder is clamped to each file's own
// intrinsic width (600px for all four banners here) so a sharp upscale never
// becomes a source and never ships more bytes than the file held.
const widthLadder = (img: { width: number }) => {
  const steps = [384, 576, 648].filter((w) => w < img.width);
  return [...steps, Math.min(img.width, 648)];
};

const promos = [
  {
    src: promoCashback,
    alt: "แบนเนอร์โปรโมชั่นแนวนอนพื้นดำทอง ซ้ายมือเป็นโลโก้ XONE.BET ตัว X สีทองพร้อมคำว่า SLOT & CASINO ONLINE ตั้งอยู่กลางแสงระเบิดสีแดงทองและกองเหรียญทอง ข้อความบนภาพเขียนว่า สุดพิเศษ!! เราคืนกำไรให้ลูกค้า คืนยอดเสีย 10% และ แนะนำเพื่อน 100% ขวามือเป็นตัวการ์ตูนพนักงานเสิร์ฟหญิงสวมชุดลายทางแดงขาวและหมวกแดง ยกถาดอาหารไว้ข้างไหล่",
  },
  {
    src: promoCommission,
    alt: "แบนเนอร์โปรโมชั่นแนวนอนพื้นดำทอง กลางภาพเป็นโลโก้ XONE.BET สีทอง ข้อความบนภาพเขียนว่า คืนค่าคอมมิสชั่นสูงสุด นับจากยอดเดิมพันทุกครั้ง สล็อตคืนสูงถึง 2% และ บาคาร่าคืนสูงถึง +1% ซ้ายมือเป็นตัวการ์ตูนโครงกระดูกมาริอาชิสวมหมวกซอมเบรโรกำลังดีดกีตาร์ ขวามือเป็นกระต่ายการ์ตูนใส่แว่นกันแดดกับเสื้อแจ็กเก็ตม่วงยืนอยู่บนสเก็ตบอร์ด",
  },
  {
    src: promoRandomReward,
    alt: "แบนเนอร์โปรโมชั่นแนวนอนพื้นดำทอง กลางภาพเป็นโลโก้ XONE.BET สีทองขนาบด้วยกล่องของขวัญสีทองสองกล่อง ข้อความบนภาพเขียนว่า อัพเดทระบบใหม่ มาพร้อมระบบสุ่ม ลุ้นรับทองคำแท่งและเครดิตฟรี ลูกค้าฝากมาเพียง 200฿ และ รับรางวัลสูงสุดถึง 500฿ ซ้ายมือเป็นนักเชิดสิงโตถือหัวมังกรจีนสีเขียวทอง ขวามือเป็นตัวการ์ตูนหัวฟักทองแจ็กโอแลนเทิร์นยืนคู่กับวัวสีน้ำตาล",
  },
  {
    src: promoWorldCup,
    alt: "แบนเนอร์โปรโมชั่นแนวนอนพื้นดำทอง ซ้ายมือเป็นภาพนักฟุตบอลทีมชาติหลายคนยืนเรียงกันข้างถ้วยรางวัลฟุตบอลโลกสีทอง มีธงชาติของทีมต่าง ๆ เรียงอยู่ด้านข้าง กลางภาพเป็นโลโก้ XONE.BET สีทอง ข้อความบนภาพเขียนว่า ทายแชมป์ฟุตบอลโลก FIFA WORLD CUP 2026 รางวัลเงินสดพร้อมรางวัลใหญ่ 300,000 และบรรทัดล่างเขียนว่า ระยะเวลารับ 12 มิถุนายน 2026 ประกาศผล 10 กรกฎาคม 2026 เวลา 23:59 น. มุมขวาล่างมีลูกฟุตบอลกลิ้งอยู่",
  },
];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed">
        แบนเนอร์ด้านล่างคือโปรโมชั่นที่ <strong class="text-[#e9e9e9]">XONEBET</strong> เปิดให้กดรับอยู่ในรอบนี้ อัตราที่ได้รับและกำหนดเวลาของแต่ละรายการพิมพ์อยู่บนภาพครบแล้ว
        แต่ละรายการมีเงื่อนไขของตัวเอง จึงควรอ่านใบที่จะรับอีกครั้งก่อนกด ทุกสิทธิ์เลือกกดรับเองได้จากแดชบอร์ดเดียว ไม่ติดเทิร์นจุกจิก และถอนออกได้เต็มจำนวน
      </p>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          promos.map((promo) => (
            <Picture
              src={promo.src}
              alt={promo.alt}
              loading="lazy"
              fetchpriority="low"
              widths={widthLadder(promo.src)}
              sizes={imageSizes}
              class={imageClass}
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={80}
            />
          ))
        }
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#c4c4c4]/50 bg-gradient-to-r from-[#fee505] via-[#ebb101] to-[#a87c02] px-10 py-3.5 text-lg font-black text-[#0a0803] shadow-[0_10px_30px_rgba(235,177,1,0.4)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(235,177,1,0.5)]">
          สมัครสมาชิก XONEBET
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
