---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

// This page is an IMAGE page, not an article: the ContentBox title (the single
// <h1>), ONE short intro paragraph, the promo image grid, one CTA. Nothing
// else. The slides already print their own offer in large type, so prose below
// them re-types what the visitor can already read, in smaller letters. The docx
// gives this page a Title and a Meta and never a body.
//
// Named for the promotion each banner ACTUALLY shows, not for its file number.
// The JUDTEM168 drop (2026-08-10) reads:
//   slide1 = ชวนเพื่อน รับรายได้ ไม่จำกัด
//   slide2 = รองรับเกมมากมาย แตกง่าย! ที่ Judtem168
//   slide3 = เว็บตรง ลิขสิทธิ์แท้ มีใบรับรอง ครองใจนักเดิมพัน
//   slide4 = คืนยอดเสีย สูงสุด 7%
// Only what is printed on each banner may be stated here. Every other
// promo/banner file in src/assets (banner2/3/4, banner.png) is a previous
// brand's leftover and must not be pulled in.
import proRefer from "../assets/slide1.png";
import proGames from "../assets/slide2.png";
import proLicensed from "../assets/slide3.png";
import proCashback from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. 150–160 CHARACTERS (Thai is 3 bytes/char, so a
// byte count reads ~3x too long). This one measures 158.
const pageDescription =
  "รวมโปรโมชั่น JUDTEM168 สล็อตเว็บตรงลิขสิทธิ์แท้ ทั้งชวนเพื่อนรับรายได้ไม่จำกัด คืนยอดเสียสูงสุด 7% และเกมแตกง่ายจากค่ายดัง อ่านเงื่อนไขของแต่ละรายการก่อนกดรับ";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น JUDTEM168 ชวนเพื่อนรับรายได้ไม่จำกัด และคืนยอดเสียสูงสุด 7%",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: proRefer.src,
});

// Drawn one-up on phones inside the box's own padding (px-4 + p-8 = 6rem),
// two-up from sm: inside that padding plus one 2rem gap, capped by the card's
// own max-width once the viewport passes it.
const imageSizes = "(max-width: 639px) calc(100vw - 6rem), (max-width: 1456px) calc((100vw - 8rem) / 2), 646px";

const imageClass =
  "mx-auto h-auto w-full rounded-xl border border-[#e4a434]/35 object-contain shadow-[0_10px_30px_rgba(250,196,44,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fac42c]/70 hover:shadow-[0_15px_40px_rgba(254,235,51,0.32)]";
---

<MainLayout title="โปรโมชั่น JUDTEM168 ชวนเพื่อนรับรายได้ไม่จำกัด คืนยอดเสียสูงสุด 7%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น JUDTEM168" as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#f3e3c4]">
        แบนเนอร์ด้านล่างคือโปรโมชั่นที่ <strong class="text-[#fac42c]">JUDTEM168</strong> เปิดให้รับอยู่ในรอบนี้ทั้งหมด ทั้งชวนเพื่อนรับรายได้ไม่จำกัด คืนยอดเสียสูงสุด 7%
        และเกมลิขสิทธิ์แท้จากค่ายดังที่รองรับไว้ครบทุกแนว แต่ละรายการคิดจากฐานคนละชุดและมีรอบเวลาของตัวเอง จึงควรเลือกให้ตรงกับสไตล์การเล่นและงบที่ตั้งใจใช้ในวันนั้น
        มากกว่าเลือกจากตัวเลขที่ดูสูงที่สุด เงื่อนไขเทิร์นโอเวอร์ หมวดเกมที่ร่วมรายการ และเพดานของแต่ละโปรไม่เหมือนกัน ควรอ่านรายละเอียดของรายการที่จะรับอีกครั้งก่อนกด
      </p>

      <div class="grid w-full grid-cols-1 gap-8 sm:grid-cols-2">
        <Picture
          src={proRefer}
          alt="แบนเนอร์โปรโมชั่น JUDTEM168 ชวนเพื่อน รับรายได้ ไม่จำกัด ตัวอักษรทองบนพื้นแดง มีผู้หญิงชุดแดงถือทองคำแท่งและมาสคอตกระต่ายถือโทรศัพท์ พร้อมแถบรับรองเว็บลิขสิทธิ์แท้และโลโก้ JT168 ด้านล่าง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={proGames}
          alt="แบนเนอร์โปรโมชั่น JUDTEM168 รองรับเกมมากมาย แตกง่าย ที่ Judtem168 มีนักรบโรมันสวมเกราะทองยืนคู่กับเสือ พร้อมแถบรับรองเว็บลิขสิทธิ์แท้และโลโก้ JT168 ด้านล่าง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={proLicensed}
          alt="แบนเนอร์โปรโมชั่น JUDTEM168 เว็บตรง ลิขสิทธิ์แท้ มีใบรับรอง ครองใจนักเดิมพัน มีอัศวินชูถ้วยรางวัลทองคำและมาสคอตสุนัขสีทอง JT พร้อมแถบรับรองเว็บลิขสิทธิ์แท้และโลโก้ JT168 ด้านล่าง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={proCashback}
          alt="แบนเนอร์โปรโมชั่น JUDTEM168 คืนยอดเสีย สูงสุด 7% มีเลพริคอนชุดเขียวนั่งข้างหม้อเหรียญทองที่ล้นออกมา พร้อมแถบรับรองเว็บลิขสิทธิ์แท้และโลโก้ JT168 ด้านล่าง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes={imageSizes}
          class={imageClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#feeb33]/60 bg-gradient-to-r from-[#feeb33] via-[#fac42c] to-[#cc8425] px-10 py-3.5 text-lg font-black text-[#1a1003] shadow-[0_10px_30px_rgba(250,196,44,0.35)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(254,235,51,0.45)]">
          สมัครสมาชิก JUDTEM168
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
