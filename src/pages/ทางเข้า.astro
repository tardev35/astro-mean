---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// This page is a BUTTON page, not an article: the ContentBox title (the single
// <h1>) and the two-column login/register grid, nothing else. The docx never
// gave it a body — any heading or paragraph here was invented by an old rebrand.
//
// PROFIT55: ContentBoxCyberCut → ContentBoxPremium และ Announcement5 →
// AnnouncementPremium ตามการหมุน variant รอบนี้ (เรียก Announcement แบบ bare
// เพราะ default message ของ variant นี้เป็นข้อความของแบรนด์นี้แล้ว)
// ปุ่มย้ายจากแดงส้มคู่ทองของ MONEY777 มาเป็นทองคู่เงินโครเมียมของรอบนี้ —
// แดงเดิมกลายเป็นทอง #e3ac22 / #8a6410 / #2a1d05 ไฮไลต์ #ffe9a8 เนื้อความ
// #f3e6c4 ส่วนทองเดิมกลายเป็นเงิน #eef3f8 / #cfd8e2 / #8b96a4 บนผิว #0a0702
//
// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 157.
const pageDescription = "ทางเข้า PROFIT55 เว็บหลัก อัปเดตลิงก์ล่าสุดสำหรับเข้าสู่ระบบและสมัครสมาชิก เข้าเล่นคาสิโนสด สล็อต และกีฬาได้ลื่นทุกอุปกรณ์ ยูสเซอร์เดียวจบ ฝากถอนออโต้ 24 ชม.";

const graph = pageGraph(Astro, {
  name: "ทางเข้า PROFIT55 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า PROFIT55 เว็บหลัก | ลิงก์เข้าเล่นอัปเดตล่าสุด" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า PROFIT55 เว็บหลัก" as="h1">
    <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ PROFIT55"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#cfd8e2]/60 bg-[#161004] px-6 py-4 shadow-[0_10px_30px_rgba(207,216,226,0.3)] transition-all duration-300 hover:scale-105 hover:border-[#eef3f8] hover:bg-[#2a1d05] hover:shadow-[0_15px_40px_rgba(238,243,248,0.4)]">
          <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-[#cfd8e2]/18 to-transparent"></div>

          <svg class="relative z-10 h-9 w-9 text-[#f3e6c4]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-[#f3e6c4]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก PROFIT55"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffe9a8]/60 bg-gradient-to-r from-[#ffe9a8] via-[#e3ac22] to-[#a97d12] px-6 py-4 shadow-[0_10px_30px_rgba(227,172,34,0.35)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,233,168,0.45)]">
          <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/25 to-transparent"></div>

          <svg class="relative z-10 h-9 w-9 text-[#0a0702]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-[#0a0702]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
