---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 152.
const pageDescription =
  "ทางเข้า PODK888 เว็บตรงเกมครบทุกสาย พร้อมวิธีตรวจ 4 จุดคือชื่อเว็บไซต์ การเชื่อมต่อ HTTPS โลโก้ และปลายทางของปุ่มเข้าสู่ระบบ ก่อนกรอกเบอร์โทรและรหัสผ่าน";

const graph = pageGraph(Astro, {
  name: "ทางเข้า PODK888 ต้องตรวจ 4 จุดก่อนล็อกอิน",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});

const headingClass = "bg-gradient-to-r from-[#f670b7] via-[#e01e83] to-[#02dbfd] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="ทางเข้า PODK888 ตรวจชื่อเว็บไซต์และ HTTPS ก่อนล็อกอิน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า PODK888 ต้องตรวจ 4 จุดก่อนล็อกอิน" as="h1">
    <div>
      <h2 class={`mb-6 ${headingClass}`}>ตรวจชื่อเว็บไซต์ HTTPS โลโก้ และปลายทางปุ่มเข้าสู่ระบบ</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f3d7e7]">
        ชื่อ PODK888 ถูกพูดถึงมากขึ้นเรื่อย ๆ เพราะเป็นเว็บตรงที่รวมเกมไว้ครบทุกสาย ทั้งสล็อต บาคาร่า และคาสิโนสดจากค่ายแท้ในแพลตฟอร์มเดียว ผลค้นหาจึงมีทั้งเว็บหลัก บัญชีโซเชียล และหน้ารวมลิงก์ปะปนกัน
        ก่อนล็อกอินจึงควรตรวจให้ครบ 4 จุด คือชื่อเว็บไซต์ทุกตัวอักษร การเชื่อมต่อว่าเป็น HTTPS โลโก้ที่แสดงบนหน้า และปลายทางของปุ่มเข้าสู่ระบบว่าพาไปที่ใด โดยเฉพาะลิงก์ที่เด้งเปลี่ยนหน้าหลายรอบก่อนพามาถึงหน้ากรอกข้อมูล
        ชื่อคล้ายกันและโลโก้คล้ายกันไม่ได้ยืนยันว่าเป็นเว็บเดียวกัน จากนั้นดูว่าเมนูเข้าสู่ระบบ สมัครสมาชิก สล็อตทุกค่าย คาสิโนสด โปรโมชั่น ฝากถอนออโต้ และช่องทางติดต่ออยู่ครบตามปกติหรือเปล่า
        เพราะหน้าเลียนแบบมักลอกภาพได้เหมือนแต่ตกหล่นบางเมนู หรือรีบพาไปหน้ากรอกข้อมูลตั้งแต่คลิกแรก หากเว็บเปลี่ยนชื่อกะทันหัน ขอรหัส OTP ผ่านแชต หรือบังคับให้ติดตั้งไฟล์ที่ไม่รู้จัก
        ควรหยุดก่อนทำรายการ ใช้เวลาเช็กเพิ่ม 10 วินาที ยังดีกว่าใช้ครึ่งวันตามหาว่าบัญชีหายไปพร้อมลิงก์ไหน
      </p>

      <h2 class={`mb-6 ${headingClass}`}>เข้าระบบแล้วใช้อะไรได้บ้าง และควรหยุดทำรายการตอนไหน</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#f3d7e7]">
        เมื่อเข้าระบบแล้ว บัญชีเดียวเปิดใช้ได้ครบทุกสายในกระเป๋าเดียว อยากปั่นสล็อตเพลิน ๆ หรือเปลี่ยนฟีลไปลุ้นไพ่ในโต๊ะคาสิโนสดก็สลับได้ทันที ไม่ต้องจำหลายรหัสและไม่ต้องโยกเงินไปมาระหว่างเว็บ
        ฝั่งคาสิโนสดคัดมาเฉพาะค่ายแท้ระดับโลก ภาพคมชัดไม่มีสะดุด ดีลเลอร์ไลฟ์สดพร้อมลั่นตลอด และจัดหมวดหมู่เกมเด่นไว้ให้แล้วจึงไม่ต้องเสียเวลางมหาเอง ส่วนฝั่งสล็อตเป็นจุดที่คนพูดถึงกันปากต่อปาก
        ว่าอัตราการจ่ายไม่ธรรมดา เข้าฟีเจอร์รัว ๆ แตกโหดกันเต็มหน้ากระดาน เวลาเลือกเกมควรดูจากเดิมพันเริ่มต้นต่อรอบ ฟีเจอร์โบนัส ความผันผวน และรูปแบบการจ่ายมากกว่าดูหน้าปกเกม
        ด้านการเงิน ระบบใหม่ของ PODK888 ทำรายการฝากถอนได้ด้วยตัวเองตลอดเวลา กดปุ๊บเงินเด้งปั๊บ ไม่ว่าจะยอดหลักร้อยหรือหลักล้านก็ปลอดภัยทุกยอด ข้อมูลไม่รั่วไหล และเปิดให้บริการมาโดยไม่มีประวัติโกงหรือบิดยอด
        ก่อนกดยืนยันควรตรวจชื่อบัญชี ยอดเงิน และประวัติรายการให้ตรงกัน หากยอดยังไม่เปลี่ยนไม่ควรกดซ้ำทันที เพราะระบบอาจกำลังประมวลผลอยู่ และหลังทำรายการควรเก็บเลขรายการหรือภาพหน้าจอไว้ตรวจสอบภายหลัง
        เบอร์โทรศัพท์เป็นข้อมูลสำคัญของบัญชี จึงควรกรอกเฉพาะบนโดเมนที่ตรวจแล้ว และไม่ส่งรหัสผ่านหรือ OTP ให้บุคคลอื่นผ่านแชต หากลืมรหัสควรใช้เมนูกู้คืนจากระบบโดยตรง
        ทีมงานที่สแตนด์บายดูแลอยู่จริงไม่จำเป็นต้องยืมรหัสเราไปลองล็อกอินแทน และถ้าไม่แน่ใจว่าลิงก์
        <strong class="text-[#f670b7]">ทางเข้า PODK888</strong> หรือลิงก์สมัครสมาชิกใดคือของจริง เราเตรียมลิงก์ที่ถูกต้องไว้ให้แล้วที่ปุ่มด้านล่างนี้
      </p>

      <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
        <div class="flex flex-col items-center justify-center gap-4">
          <a
            href="/login"
            aria-label="เข้าสู่ระบบ PODK888"
            class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f670b7]/50 bg-[#1a0a1f] px-6 py-4 shadow-[0_10px_30px_rgba(246,112,183,0.25)] transition-all duration-300 hover:scale-105 hover:border-[#f670b7] hover:bg-[#2a0f2e] hover:shadow-[0_15px_40px_rgba(2,219,253,0.35)]">
            <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-[#f670b7]/15 to-transparent"></div>

            <svg class="relative z-10 h-9 w-9 text-[#02dbfd]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
            </svg>

            <span class="relative z-10 text-3xl font-bold tracking-wide text-[#f670b7]">เข้าสู่ระบบ</span>
          </a>
        </div>

        <div class="flex flex-col items-center justify-center gap-4">
          <a
            href="/register"
            aria-label="สมัครสมาชิก PODK888"
            class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f670b7]/60 bg-gradient-to-r from-[#f670b7] to-[#02dbfd] px-6 py-4 shadow-[0_10px_30px_rgba(246,112,183,0.3)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(2,219,253,0.45)]">
            <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/30 to-transparent"></div>

            <svg class="relative z-10 h-9 w-9 text-[#12060f]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
            </svg>

            <span class="relative z-10 text-3xl font-bold tracking-wide text-[#12060f]">สมัครสมาชิก</span>
          </a>
        </div>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
