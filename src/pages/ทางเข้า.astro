---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// This page is a BUTTON page, not an article: the ContentBox title (the single
// <h1>) and the two-column login/register grid, nothing else. The docx never
// gave it a body — any heading or paragraph here was invented by an old rebrand.
//
// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 153.
const pageDescription =
  "ทางเข้า MACAUBET เว็บหลัก สล็อตฟอร์มใหญ่ ฟีลมาเก๊ามาไว้หน้าสปิน โอนไวออโต้ กดเข้าสู่ระบบสำหรับสมาชิกเดิม หรือสมัครสมาชิกใหม่ได้จากหน้านี้ เปิดตลอด 24 ชม.";

const graph = pageGraph(Astro, {
  name: "ทางเข้า MACAUBET เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า MACAUBET เว็บหลัก เข้าสู่ระบบและสมัครสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า MACAUBET เว็บหลัก" as="h1">
    <div>
      <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
        <div class="flex flex-col items-center justify-center gap-4">
          <a
            href="/login"
            aria-label="เข้าสู่ระบบ MACAUBET"
            class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#3b9b0d]/50 bg-[#020b01] px-6 py-4 shadow-[0_10px_30px_rgba(59,155,13,0.22)] transition-all duration-300 hover:scale-105 hover:border-[#8ef04a] hover:bg-[#0a2c0d] hover:shadow-[0_15px_40px_rgba(59,155,13,0.4)]">
            <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-[#59cb13]/18 to-transparent"></div>

            <svg class="relative z-10 h-9 w-9 text-[#8ef04a]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
            </svg>

            <span class="relative z-10 text-3xl font-bold tracking-wide text-[#8ef04a]">เข้าสู่ระบบ</span>
          </a>
        </div>

        <div class="flex flex-col items-center justify-center gap-4">
          <a
            href="/register"
            aria-label="สมัครสมาชิก MACAUBET"
            class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f6c445]/60 bg-gradient-to-r from-[#dcffc0] via-[#8ef04a] to-[#59cb13] px-6 py-4 shadow-[0_10px_30px_rgba(89,203,19,0.35)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(142,240,74,0.45)]">
            <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/25 to-transparent"></div>

            <svg class="relative z-10 h-9 w-9 text-[#041b06]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
            </svg>

            <span class="relative z-10 text-3xl font-bold tracking-wide text-[#041b06]">สมัครสมาชิก</span>
          </a>
        </div>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
