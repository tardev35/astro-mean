---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// This page is a BUTTON page, not an article: the ContentBox title (the single
// <h1>) and the two-column login/register grid, nothing else. The docx never
// gave it a body — any heading or paragraph here was invented by an old rebrand.
//
// VIREL168: ContentBoxCyberCut → ContentBoxPremium และ Announcement3 →
// Announcement5 ตามการหมุน variant รอบนี้ (เรียก Announcement แบบ bare เพราะ
// default message ของ variant นี้เป็นข้อความของแบรนด์นี้แล้ว)
// ปุ่มย้ายจากม่วงคู่มาเจนต้าของแบรนด์ก่อนมาเป็นทองคู่เงินโครเมียมของรอบนี้ —
// ปุ่มเข้าสู่ระบบเป็นผิวเข้ม #1b0d02 / #2e1a04 ขอบ #e2a52d เนื้อความ #f4e7cd
// ส่วนปุ่มสมัครสมาชิกเป็นทอง #ffeec2 / #faca4c / #855a14 ตัวอักษรเข้ม #0a0501
//
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 152.
const pageDescription = "ทางเข้า VIREL168 เว็บหลัก ลิงก์ตรงอัปเดตใหม่ ไม่ผ่านเอเย่นต์ กดเข้าสู่ระบบหรือสมัครสมาชิกได้ทันที เล่นสล็อตทุกค่ายบนมือถือ ฝากถอนออโต้ ระบบเสถียร 24 ชม.";

const graph = pageGraph(Astro, {
  name: "ทางเข้า VIREL168 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า VIREL168 | เล่นสล็อตเว็บตรง ระบบออโต้ ปลอดภัย 100%" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า VIREL168 เว็บหลัก" as="h1">
    <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ VIREL168"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e2a52d]/60 bg-[#1b0d02] px-6 py-4 shadow-[0_10px_30px_rgba(250,202,76,0.35)] transition-all duration-300 hover:scale-105 hover:border-[#ffeec2] hover:bg-[#2e1a04] hover:shadow-[0_15px_40px_rgba(226,165,45,0.4)]">
          <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-[#e2a52d]/25 to-transparent"></div>

          <svg class="relative z-10 h-9 w-9 text-[#f4e7cd]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-[#f4e7cd]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก VIREL168"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffeec2]/60 bg-gradient-to-r from-[#ffeec2] via-[#faca4c] to-[#855a14] px-6 py-4 shadow-[0_10px_30px_rgba(250,202,76,0.4)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(226,165,45,0.45)]">
          <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/25 to-transparent"></div>

          <svg class="relative z-10 h-9 w-9 text-[#0a0501]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-[#0a0501]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
