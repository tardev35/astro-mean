---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// This page is a BUTTON page, not an article: the ContentBox title (the single
// <h1>) and the two-column login/register grid, nothing else. The brief never
// gave it a body — any heading or paragraph here was invented by an old rebrand.
// h2 and h3 counts on this page must both stay 0.
//
// The <h1> names what the page IS ("ทางเข้า 9KPLUS เว็บหลัก"). Do not give it
// a title that previews an article; there is no article and there never was.
//
// 9KPLUS: ticker หมุนมาเป็น Announcement3 และกล่องหน้าย่อยใช้ ContentBox
// (เรียก <Announcement /> เปล่าๆ เพื่อใช้ default message ของ variant ซึ่งเป็น
// ข้อความของแบรนด์นี้แล้ว และตรงกับหน้าแรก)
//
// พาเลตต์รอบนี้เป็น "นีออนคริมสันคู่ชมพูจัดบนผิวเกือบดำ" วอลเปเปอร์เป็นลายวงจร
// สีเลือดหมูบนพื้นเกือบดำ ปุ่มสมัครสมาชิกซึ่งเป็นปุ่มหลักไล่สีคริมสันสด #f5003e /
// #ff4fa3 / #b3022c ขอบ #ff4a74 ส่วนปุ่มเข้าสู่ระบบเป็นปุ่มรองจึงไล่สีชมพูเข้ม
// #7c1040 / #4d012c ขอบ #ff4fa3 เนื้อความทั้งคู่เป็น #ffe3ee — คู่สีนี้ให้คอนทราสต์
// พอสำหรับตัวอักษรสีชมพูซีดบนพื้นเข้ม ขณะที่การไล่สีคริมสันจัดทั้งสองปุ่มจะทำให้
// แยกปุ่มหลักไม่ออก
//
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 158.
const pageDescription = "ทางเข้า 9KPLUS เว็บหลัก ลิงก์ตรงล่าสุดไม่ผ่านเอเย่นต์ กดเข้าสู่ระบบหรือสมัครสมาชิกได้ทันทีจากหน้านี้ สล็อตเว็บตรง API แท้ ยิงตรงจากเซิร์ฟนอก ลื่นไหลทุกการสปิน";

const graph = pageGraph(Astro, {
  name: "ทางเข้า 9KPLUS เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า 9KPLUS | เว็บหลักลิงก์ตรง สล็อตเว็บตรง API แท้ ไม่ผ่านเอเย่นต์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า 9KPLUS เว็บหลัก" as="h1">
    <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ 9KPLUS"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ff4fa3]/60 bg-gradient-to-r from-[#7c1040] to-[#4d012c] px-6 py-4 shadow-[0_10px_30px_rgba(245,0,62,0.35)] transition-all duration-300 hover:scale-105 hover:border-[#ffd8e7] hover:shadow-[0_15px_40px_rgba(255,79,163,0.3)]">
          <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-[#ff4fa3]/30 to-transparent"></div>

          <svg class="relative z-10 h-9 w-9 text-[#ffe3ee]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-[#ffe3ee]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก 9KPLUS"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ff4a74]/70 bg-gradient-to-r from-[#f5003e] via-[#ff4fa3] to-[#b3022c] px-6 py-4 shadow-[0_10px_30px_rgba(245,0,62,0.35)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,79,163,0.3)]">
          <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-[#ffd8e7]/40 to-transparent"></div>

          <svg class="relative z-10 h-9 w-9 text-[#ffe3ee]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-[#ffe3ee]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
