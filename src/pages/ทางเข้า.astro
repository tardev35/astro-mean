---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// This page is a BUTTON page, not an article: the ContentBox title (the single
// <h1>) and the two-column login/register grid, nothing else. The docx never
// gave it a body — any heading or paragraph here was invented by an old rebrand.
// h2 and h3 counts on this page must both stay 0.
//
// GUESS168: Announcement3 → AnnouncementPremium และกล่องหน้าย่อยจาก
// ContentBoxPremium → ContentBox ตามการหมุน variant รอบนี้ (เรียก
// <Announcement /> เปล่าๆ เพื่อใช้ default message ของ variant ซึ่งเป็นข้อความ
// ของแบรนด์นี้แล้ว)
//
// ปุ่มรอบนี้เป็นชุดทองบนดำ — ปุ่มเข้าสู่ระบบเป็นผิว #231005 ขอบ #ffe680
// เนื้อความ #ffd54a hover เป็น #33180a ส่วนปุ่มสมัครสมาชิกไล่ทอง
// #ffe680 / #fecc02 / #a35800 ตัวอักษรดำอมน้ำตาล #231005
//
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 156.
const pageDescription =
  "ทางเข้า GUESS168 เว็บหลัก ลิงก์ตรงอัปเดตใหม่ ไม่ผ่านเอเย่นต์ กดเข้าสู่ระบบหรือสมัครสมาชิกได้ทันที สล็อตคัดเกรดเกมลิขสิทธิ์แน่น ฝากถอนออโต้ เล่นได้ทุกอุปกรณ์";

const graph = pageGraph(Astro, {
  name: "ทางเข้า GUESS168 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า GUESS168 | สล็อตคัดเกรด เกมลิขสิทธิ์แน่น ฝากถอนออโต้ทันใจ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า GUESS168 เว็บหลัก" as="h1">
    <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ GUESS168"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffe680]/60 bg-[#231005] px-6 py-4 shadow-[0_10px_30px_rgba(197,138,0,0.35)] transition-all duration-300 hover:scale-105 hover:border-[#ffd54a] hover:bg-[#33180a] hover:shadow-[0_15px_40px_rgba(254,156,1,0.45)]">
          <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-[#fe9c01]/25 to-transparent"></div>

          <svg class="relative z-10 h-9 w-9 text-[#ffd54a]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-[#ffd54a]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก GUESS168"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffe680]/60 bg-gradient-to-r from-[#ffe680] via-[#fecc02] to-[#a35800] px-6 py-4 shadow-[0_10px_30px_rgba(254,204,2,0.4)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(254,204,2,0.5)]">
          <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/25 to-transparent"></div>

          <svg class="relative z-10 h-9 w-9 text-[#231005]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-[#231005]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
