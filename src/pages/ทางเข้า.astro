---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// This page is a BUTTON page, not an article: the ContentBox title (the single
// <h1>) and the two-column login/register grid, nothing else. The docx never
// gave it a body — any heading or paragraph here was invented by an old rebrand.
//
// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 158.
const pageDescription =
  "ทางเข้า LONGSAP168 เว็บหลัก เว็บสล็อตครบมือ เกมดังค่ายจัดเต็ม โต๊ะสดจัดหนัก ระบบออโต้เสถียร 24 ชั่วโมง กดเข้าสู่ระบบสำหรับสมาชิกเดิม หรือสมัครสมาชิกใหม่ได้เลย";

const graph = pageGraph(Astro, {
  name: "ทางเข้า LONGSAP168 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า LONGSAP168 เว็บหลัก เข้าสู่ระบบและสมัครสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า LONGSAP168 เว็บหลัก" as="h1">
    <div>
      <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
        <div class="flex flex-col items-center justify-center gap-4">
          <a
            href="/login"
            aria-label="เข้าสู่ระบบ LONGSAP168"
            class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f2b024]/50 bg-[#170806] px-6 py-4 shadow-[0_10px_30px_rgba(242,176,36,0.25)] transition-all duration-300 hover:scale-105 hover:border-[#ffd76a] hover:bg-[#24100c] hover:shadow-[0_15px_40px_rgba(216,31,38,0.35)]">
            <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-[#f2b024]/15 to-transparent"></div>

            <svg class="relative z-10 h-9 w-9 text-[#f2b024]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
            </svg>

            <span class="relative z-10 text-3xl font-bold tracking-wide text-[#ffd76a]">เข้าสู่ระบบ</span>
          </a>
        </div>

        <div class="flex flex-col items-center justify-center gap-4">
          <a
            href="/register"
            aria-label="สมัครสมาชิก LONGSAP168"
            class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffd76a]/60 bg-gradient-to-r from-[#ffd76a] via-[#f2b024] to-[#a86a0c] px-6 py-4 shadow-[0_10px_30px_rgba(242,176,36,0.3)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,215,106,0.45)]">
            <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/30 to-transparent"></div>

            <svg class="relative z-10 h-9 w-9 text-[#0a0402]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
            </svg>

            <span class="relative z-10 text-3xl font-bold tracking-wide text-[#0a0402]">สมัครสมาชิก</span>
          </a>
        </div>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
