---
import { fontStack, usesGoogleFonts } from "../lib/brandProfile";

// NEVER edit targetUrl — it is this brand's affiliate destination, carried over
// as-is from the page this one replaced.
const targetUrl = "https://yoalink.com/znmz";

// This page has its own <head> and does not import global.css, so it gets
// neither the @theme fallback for --font-sans nor the self-hosted Kanit
// @font-face. Both have to be supplied here or the page renders in the browser
// default while the rest of the site does not — hence the @font-face rules in
// the first <style> block below.
//
// Those rules are gated on !usesGoogleFonts, and the gate is the point of the
// whole BRAND_FONT rotation: /fonts/kanit-v17-latin_thai-*.woff2 is the SAME
// path on every Kanit brand in the portfolio, which is a sharper cross-brand
// match than anything visual on the page. brandProfile drops the Kanit
// preloads for a Google Sans brand for exactly this reason; emitting the
// @font-face here anyway would put the shared paths back on two pages and
// undo half of it. Nothing is lost when they drop — Google Sans covers Thai, so
// it paints this page on its own on a google-sans brand. JAICHUA runs KANIT, so
// this round the Kanit @font-face rules DO render and the CDN query below takes
// the Oswald-only branch. The flag flips every rebrand, so keep BOTH branches
// correct — the next Google Sans brand needs the other one.
//
// Oswald is the face the two display headings use and it is not self-hosted, so
// it stays in the CDN query on both branches.
//
// The Kanit branch deliberately does NOT ask Google for Kanit: the site
// self-hosts it, so a third-party request there would be for weights nothing
// here draws, in a query string byte-identical on every Kanit brand in the
// portfolio — the shared signature BRAND_FONT exists to break up.
const fontHref = usesGoogleFonts
  ? "https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Oswald:wght@700&display=swap"
  : "https://fonts.googleapis.com/css2?family=Oswald:wght@700&display=swap";

// Palette note for the second <style> block: JAICHUA is a GOLD-ON-NAVY brand
// with a REAL SECOND COLOUR — the mark is three-dimensional gold lettering
// (จ่ายชัวร์888 over JAI CHUA) with a gold compass-star and two Chinese coin
// ornaments, all sitting on a deep royal-navy shield. So navy is a colour OF the
// mark, not merely the paper it is printed on, and this page has to show both or
// it reads as a flat gold page.
// The gold ramp is #fbeec9 → #f6d67e → #d8a83f → #a97722 and the royal-blue trio
// is #cfe0fb → #2f5fb0 → #16336b, over the surface stack (#040915 page /
// rgba(10,18,38) navy panel / #132244 raised, rgba(22,39,78) borders) with
// #dce6f8 body text and #a9b7d4 captions. #f6d67e is THE brand colour — the one
// that carries the borders and the loader's outer ring; #2f5fb0 is the second,
// and it is what the inner ring is drawn in: that ring is the one place on this
// page where the two-colour mark is legible at a glance.
//
// Every custom property below is NAMED FOR THE COLOUR IT HOLDS, which previous
// brands stopped doing: this block once declared a `--brand-gold` on brands with
// no gold in them and a `--brand-red` on a gold one, and a later round shipped a
// `--gold-light` that held the brand's SECOND accent, not its primary — so the
// next editor reused it by name and got the wrong role. Rename with the value,
// and re-check the role when the palette changes shape. (This round the primary
// moved from flag blue back to gold and the second colour from flag red to royal
// blue, so the previous `--blue-*` ramp became `--gold-*` and the `--red-*` trio
// became `--blue-*` rather than keeping names that no longer describe what they
// hold — a `--blue-primary` holding a gold is exactly the trap this rule exists
// to stop.)
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
---

<html lang="th" style={`--font-sans: ${fontStack};`}>
  <head>
    <meta charset="utf-8" />
    <title>สมัครสมาชิก JAICHUA | เปิดยูสเดียวเล่นสล็อตได้ครบทุกค่าย</title>
    <meta
      name="description"
      content="สมัครสมาชิก JAICHUA ฟรีไม่มีค่าธรรมเนียม ระบบจะพาไปหน้าสมัครของเว็บหลักอัตโนมัติ เปิดยูสเดียวเล่นสล็อตได้ครบทุกค่าย ค่า RTP ตรงสเปกโรงงาน ฝากถอนออโต้ใน 3 วินาที"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {
      /* This page exists only to forward; there is nothing here worth ranking,
        and its source carries the affiliate URL — the one host every brand in
        the group has in common. Keeping it out of the index means that link is
        not sitting in a page Google has stored. Astro's own /line redirect page
        ships noindex for the same reason. */
    }
    <meta name="robots" content="noindex, follow" />

    <meta http-equiv="refresh" content={`1.5;url=${targetUrl}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />

    {
      !usesGoogleFonts && (
        <style>
          {`@font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-regular.woff2") format("woff2");
      }
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-700.woff2") format("woff2");
      }`}
        </style>
      )
    }

    <style>
      :root {
        --page-bg: #040915;
        --panel-bg: rgba(10, 18, 38, 0.92);
        --gold-pale: #fbeec9;
        --gold-light: #f6d67e;
        --gold-primary: #d8a83f;
        --gold-deep: #a97722;
        --navy-deep: #16274e;
        --blue-pale: #cfe0fb;
        --blue-royal: #2f5fb0;
        --blue-deep: #16336b;
        --surface-raised: #132244;
        --border-gold: #a97722;
        --text-body: #dce6f8;
        --text-muted: #a9b7d4;
      }

      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--text-body);

        background: radial-gradient(circle at 50% 10%, rgba(216, 168, 63, 0.18) 0%, transparent 55%), radial-gradient(circle at 50% 92%, rgba(47, 95, 176, 0.16) 0%, transparent 55%), var(--page-bg);
        display: flex;
        min-height: 100vh;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      .premium-loading-container {
        width: 90%;
        max-width: 450px;
        padding: 3.5rem;
        background: var(--panel-bg);
        border: 1px solid rgba(22, 39, 78, 0.75);
        border-radius: 2rem;
        box-shadow:
          0 1rem 3rem rgba(2, 4, 12, 0.7),
          0 0 2rem rgba(216, 168, 63, 0.18);
        text-align: center;
        backdrop-filter: blur(10px);
      }

      .brand-identity {
        font-family: "Oswald", sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        background: linear-gradient(180deg, var(--gold-pale) 0%, var(--gold-light) 35%, var(--gold-primary) 70%, var(--gold-deep) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        letter-spacing: 0.3em;
        margin-bottom: 2rem;
        filter: drop-shadow(0 1px 2px rgba(22, 39, 78, 0.6));
      }

      .sophisticated-loader {
        position: relative;
        width: 100px;
        height: 100px;
        margin: 0 auto 3.5rem auto;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .orb {
        width: 40px;
        height: 40px;
        background: radial-gradient(circle, var(--gold-pale) 0%, var(--gold-light) 45%, var(--navy-deep) 100%);
        border-radius: 50%;
        box-shadow: 0 0 2rem rgba(216, 168, 63, 0.4);
        animation: pulse 2s ease-in-out infinite;
      }

      .ring {
        position: absolute;
        border-radius: 50%;
        border: 3px solid rgba(22, 39, 78, 0.55);
        animation: spin linear infinite;
      }

      .ring-1 {
        width: 100%;
        height: 100%;
        border-top-color: var(--gold-light);
        animation-duration: 4s;
      }

      .ring-2 {
        width: 80%;
        height: 80%;
        border-bottom-color: var(--blue-royal);
        animation-duration: 6s;
        animation-direction: reverse;
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      @keyframes pulse {
        0%,
        100% {
          transform: scale(1);
          box-shadow: 0 0 2rem rgba(216, 168, 63, 0.4);
        }
        50% {
          transform: scale(1.15);
          box-shadow: 0 0 3rem rgba(251, 238, 201, 0.42);
        }
      }

      .status-text .h1 {
        font-family: "Oswald", sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-body);
        text-shadow: 0 1px 1px var(--surface-raised);
        margin: 0;
      }
      .status-text .p {
        font-size: 0.875rem;
        color: var(--text-muted);
        line-height: 1.6;
        margin: 1rem 0 0 0;
      }
    </style>
  </head>
  <body>
    <div class="premium-loading-container">
      <div class="brand-identity">JAICHUA</div>

      <div class="sophisticated-loader">
        <div class="orb"></div>
        <div class="ring ring-1"></div>
        <div class="ring ring-2"></div>
      </div>

      <div class="status-text">
        <h1 class="h1">CREATING SECURE ACCOUNT SESSION...</h1>
        <p class="p">กำลังพาไปหน้าสมัครสมาชิก JAICHUA ด้วยเบอร์โทรศัพท์ <span aria-hidden="true">🔒</span></p>
      </div>
    </div>

    <script define:vars={{ targetUrl }}>
      setTimeout(() => {
        window.location.replace(targetUrl);
      }, 3000);
    </script>
  </body>
</html>
