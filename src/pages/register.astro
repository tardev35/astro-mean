---
import { fontStack, usesGoogleFonts } from "../lib/brandProfile";

// NEVER edit targetUrl — it is this brand's affiliate destination, carried over
// as-is from the page this one replaced.
const targetUrl = "https://yoalink.com/znmz";

// This page has its own <head> and does not import global.css, so it gets
// neither the @theme fallback for --font-sans nor the self-hosted Kanit
// @font-face. Both have to be supplied here or the page renders in the browser
// default while the rest of the site does not — hence the @font-face rules in
// the first <style> block below.
//
// Those rules are gated on !usesGoogleFonts, and the gate is the point of the
// whole BRAND_FONT rotation: /fonts/kanit-v17-latin_thai-*.woff2 is the SAME
// path on every Kanit brand in the portfolio, which is a sharper cross-brand
// match than anything visual on the page. brandProfile drops the Kanit
// preloads for a Google Sans brand for exactly this reason; emitting the
// @font-face here anyway would put the shared paths back on two pages and
// undo half of it. Nothing is lost when they drop — Google Sans covers Thai, so
// it paints this page on its own on a google-sans brand. 9KPLUS runs GOOGLE
// SANS, so this round the Kanit @font-face rules do NOT render and the CDN
// query below takes the Google Sans + Oswald branch. The flag flips every
// rebrand, so keep BOTH branches correct — the next Kanit brand needs the other.
//
// Oswald is the face the two display headings use and it is not self-hosted, so
// it stays in the CDN query on both branches.
//
// The Kanit branch deliberately does NOT ask Google for Kanit: the site
// self-hosts it, so a third-party request there would be for weights nothing
// here draws, in a query string byte-identical on every Kanit brand in the
// portfolio — the shared signature BRAND_FONT exists to break up.
const fontHref = usesGoogleFonts
  ? "https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Oswald:wght@700&display=swap"
  : "https://fonts.googleapis.com/css2?family=Oswald:wght@700&display=swap";

// Palette note for the second <style> block: 9KPLUS is a NEON CRIMSON brand
// with a REAL SECOND COLOUR — the round mark puts a vivid crimson 9K over PLUS
// on a black disc inside a crimson ring, and the banner around it is lit in hot
// magenta-pink. So hot pink is a colour OF the artwork, not a tint of the red,
// and this page has to show both or it reads as a flat red page.
// The pink ramp is #ffd8e7 → #ff4a74 → #ff4fa3 → #f5003e → #b3022c → #7c1040,
// over the near-black surface stack (#120309 page / rgba(31,6,17) glass panel /
// #1f0611 raised, rgba(179,2,44) borders) with #ffe3ee body text and #f0b9cd
// captions, plus #4d012c as the deep magenta the orb falls off into.
// #f5003e is THE brand colour — the one that carries the loader's outer ring;
// #ff4fa3 is the second, and it is what the inner ring is drawn in: that ring
// is the one place on this page where the two-colour artwork is legible at a
// glance.
//
// This page keeps a DARK surface, which this round matches the site's near-black
// wallpaper rather than contrasting with it. It is still a standalone forwarder
// with its own <head>, no wallpaper and no chrome — a single glass panel
// floating on nothing — so it takes the same raised card surface the ContentBox
// cards take, not the page background.
//
// Every custom property below is NAMED FOR THE COLOUR IT HOLDS, which previous
// brands stopped doing: this block once declared a `--brand-gold` on brands with
// no gold in them and a `--brand-red` on a gold one, and a later round shipped a
// `--gold-light` that held the brand's SECOND accent, not its primary — so the
// next editor reused it by name and got the wrong role. Rename with the value,
// and re-check the role when the palette changes shape. (This round the whole
// azure ramp and the gold trio are gone, replaced by `--pink-*`/`--crimson-*`;
// there is NO gold and NO blue anywhere in this brand, and a `--gold-light`
// holding a pale pink is exactly the trap this rule exists to stop. Every
// property declared below is used — no dead names left behind to be reused by
// someone reading the list rather than the values.)
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
---

<html lang="th" style={`--font-sans: ${fontStack};`}>
  <head>
    <meta charset="utf-8" />
    <title>สมัครสมาชิก 9KPLUS | เปิดยูสเดียวเล่นตัวเด็ดได้ครบทุกค่าย</title>
    <meta
      name="description"
      content="สมัครสมาชิก 9KPLUS ฟรีไม่มีค่าธรรมเนียม ระบบจะพาไปหน้าสมัครของเว็บหลักอัตโนมัติ เปิดยูสเดียวเล่นตัวเด็ดครบทุกค่าย ค่า RTP ยุติธรรม ฝากถอนออโต้ 3 วินาที"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {
      /* This page exists only to forward; there is nothing here worth ranking,
        and its source carries the affiliate URL — the one host every brand in
        the group has in common. Keeping it out of the index means that link is
        not sitting in a page Google has stored. Astro's own /line redirect page
        ships noindex for the same reason. */
    }
    <meta name="robots" content="noindex, follow" />

    <meta http-equiv="refresh" content={`1.5;url=${targetUrl}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />

    {
      !usesGoogleFonts && (
        <style>
          {`@font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-regular.woff2") format("woff2");
      }
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-700.woff2") format("woff2");
      }`}
        </style>
      )
    }

    <style>
      :root {
        --page-bg: #120309;
        --panel-bg: rgba(31, 6, 17, 0.92);
        --pink-pale: #ffd8e7;
        --pink-light: #ff4a74;
        --pink-hot: #ff4fa3;
        --crimson-primary: #f5003e;
        --magenta-deepest: #4d012c;
        --surface-raised: #1f0611;
        --text-body: #ffe3ee;
        --text-muted: #f0b9cd;
      }

      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--text-body);

        background: radial-gradient(circle at 50% 10%, rgba(245, 0, 62, 0.22) 0%, transparent 55%), radial-gradient(circle at 50% 92%, rgba(255, 79, 163, 0.18) 0%, transparent 55%), var(--page-bg);
        display: flex;
        min-height: 100vh;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      .premium-loading-container {
        width: 90%;
        max-width: 450px;
        padding: 3.5rem;
        background: var(--panel-bg);
        border: 1px solid rgba(179, 2, 44, 0.75);
        border-radius: 2rem;
        box-shadow:
          0 1rem 3rem rgba(18, 3, 9, 0.7),
          0 0 2rem rgba(245, 0, 62, 0.22);
        text-align: center;
        backdrop-filter: blur(10px);
      }

      .brand-identity {
        font-family: "Oswald", sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        background: linear-gradient(180deg, var(--pink-pale) 0%, var(--pink-light) 35%, var(--pink-hot) 70%, var(--crimson-primary) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        letter-spacing: 0.3em;
        margin-bottom: 2rem;
        filter: drop-shadow(0 1px 2px rgba(124, 16, 64, 0.6));
      }

      .sophisticated-loader {
        position: relative;
        width: 100px;
        height: 100px;
        margin: 0 auto 3.5rem auto;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .orb {
        width: 40px;
        height: 40px;
        background: radial-gradient(circle, var(--pink-pale) 0%, var(--pink-hot) 45%, var(--magenta-deepest) 100%);
        border-radius: 50%;
        box-shadow: 0 0 2rem rgba(245, 0, 62, 0.4);
        animation: pulse 2s ease-in-out infinite;
      }

      .ring {
        position: absolute;
        border-radius: 50%;
        border: 3px solid rgba(179, 2, 44, 0.55);
        animation: spin linear infinite;
      }

      .ring-1 {
        width: 100%;
        height: 100%;
        border-top-color: var(--crimson-primary);
        animation-duration: 4s;
      }

      .ring-2 {
        width: 80%;
        height: 80%;
        border-bottom-color: var(--pink-hot);
        animation-duration: 6s;
        animation-direction: reverse;
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      @keyframes pulse {
        0%,
        100% {
          transform: scale(1);
          box-shadow: 0 0 2rem rgba(245, 0, 62, 0.4);
        }
        50% {
          transform: scale(1.15);
          box-shadow: 0 0 3rem rgba(255, 79, 163, 0.42);
        }
      }

      .status-text .h1 {
        font-family: "Oswald", sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--pink-pale);
        text-shadow: 0 1px 1px var(--surface-raised);
        margin: 0;
      }
      .status-text .p {
        font-size: 0.875rem;
        color: var(--text-muted);
        line-height: 1.6;
        margin: 1rem 0 0 0;
      }
    </style>
  </head>
  <body>
    <div class="premium-loading-container">
      <div class="brand-identity">9KPLUS</div>

      <div class="sophisticated-loader">
        <div class="orb"></div>
        <div class="ring ring-1"></div>
        <div class="ring ring-2"></div>
      </div>

      <div class="status-text">
        <h1 class="h1">CREATING SECURE ACCOUNT SESSION...</h1>
        <p class="p">กำลังพาไปหน้าสมัครสมาชิก 9KPLUS ด้วยเบอร์โทรศัพท์ <span aria-hidden="true">🔒</span></p>
      </div>
    </div>

    <script define:vars={{ targetUrl }}>
      setTimeout(() => {
        window.location.replace(targetUrl);
      }, 3000);
    </script>
  </body>
</html>
