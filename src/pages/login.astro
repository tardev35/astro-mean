---
import { fontStack, usesGoogleFonts } from "../lib/brandProfile";

// NEVER edit targetUrl — it is this brand's affiliate destination, carried over
// as-is from the page this one replaced.
const targetUrl = "https://tinyurl.com/bp4sd4b4";

// This page has its own <head> and does not import global.css, so it gets
// neither the @theme fallback for --font-sans nor the self-hosted Kanit
// @font-face. Both have to be supplied here or the page renders in the browser
// default while the rest of the site does not — hence the @font-face rules in
// the first <style> block below.
//
// Oswald is the only face left that needs a CDN: the two display headings use
// it and it is not self-hosted.
//
// The old value asked Google for "Kanit:wght@300;400;600" even though the site
// self-hosts Kanit: a third-party request for weights nothing here draws (300
// and 600 are used zero times), and a query string byte-identical on every
// Kanit brand in the portfolio — the shared signature BRAND_FONT exists to
// break up.
const fontHref = usesGoogleFonts
  ? "https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Oswald:wght@700&display=swap"
  : "https://fonts.googleapis.com/css2?family=Oswald:wght@700&display=swap";
---

<html lang="th" style={`--font-sans: ${fontStack};`}>
  <head>
    <meta charset="utf-8" />
    <title>เข้าสู่ระบบ PABO88 | ทางเข้าเว็บสล็อตคัดของดี ถอนไวไม่ค้างฟีล</title>
    <meta
      name="description"
      content="เข้าสู่ระบบ PABO88 สำหรับสมาชิกเดิม ระบบจะพาไปหน้าล็อกอินของเว็บหลักให้อัตโนมัติ เข้าปั่นสล็อตคัดของดี เกมเด็ดเกินเรื่อง โปรถึงโบนัสแรง ระบบออโต้คล่อง ถอนไว"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* This page exists only to forward; there is nothing here worth ranking,
        and its source carries the affiliate URL — the one host every brand in
        the group has in common. Keeping it out of the index means that link is
        not sitting in a page Google has stored. Astro's own /line redirect page
        ships noindex for the same reason. */}
    <meta name="robots" content="noindex, follow" />

    <meta http-equiv="refresh" content={`1.5;url=${targetUrl}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />

    <style>
      /* Self-hosted Kanit. This page has its own <head> and does not import
         global.css, so the @font-face rules there never reach it — which is why
         it used to pull Kanit from Google instead. Only the weights this page
         actually draws are declared. PABO88 runs BRAND_FONT = "google-sans", so
         these two rules are dormant this round — leave them in place either
         way, the flag flips every rebrand. */
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-regular.woff2") format("woff2");
      }
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-700.woff2") format("woff2");
      }
    </style>

    <style>
      /* PABO88 is a neon-purple / gold brand: VIOLET is the identity hue (the
         wordmark, the glow on the banner and the slide artwork) with GOLD as
         the second accent (the coins, the treasure chest, the 88), on a
         near-black purple background. The outgoing brand here was royal blue
         primary with gold second on a near-black navy — the blue is gone
         entirely and the gold moved a shade cooler.

         Every variable below is NAMED FOR THE COLOUR IT HOLDS, which previous
         brands stopped doing: this block once declared `--brand-gold` on brands
         with no gold in them and `--brand-red` on a gold one, so the next editor
         reused it by name and shipped the wrong hue. Rename with the value. */
      :root {
        --page-bg: #0a0118;
        --panel-bg: rgba(22, 3, 51, 0.92);
        --brand-purple: #bf3cfa;
        --brand-purple-pale: #e3b8ff;
        --brand-purple-deep: #4a0b8f;
        --brand-gold: #f5c518;
        --edge-dark: #20064a;
        --text-body: #ece0ff;
        --text-muted: #b79ad6;
      }

      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--text-body);

        background:
          radial-gradient(circle at 50% 10%, rgba(191, 60, 250, 0.28) 0%, transparent 55%),
          radial-gradient(circle at 50% 92%, rgba(245, 197, 24, 0.22) 0%, transparent 55%), var(--page-bg);
        display: flex;
        min-height: 100vh;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      .premium-loading-container {
        width: 90%;
        max-width: 450px;
        padding: 3.5rem;
        background: var(--panel-bg);
        border: 1px solid rgba(191, 60, 250, 0.38);
        border-radius: 2rem;
        box-shadow:
          0 1rem 3rem rgba(10, 1, 24, 0.6),
          0 0 2rem rgba(191, 60, 250, 0.25);
        text-align: center;
        backdrop-filter: blur(10px);
      }

      .brand-identity {
        font-family: "Oswald", sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        background: linear-gradient(180deg, var(--brand-purple-pale) 0%, var(--brand-purple) 40%, var(--brand-purple-deep) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        letter-spacing: 0.3em;
        margin-bottom: 2rem;
        filter: drop-shadow(0 1px 2px rgba(191, 60, 250, 0.45));
      }

      .sophisticated-loader {
        position: relative;
        width: 100px;
        height: 100px;
        margin: 0 auto 3.5rem auto;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .orb {
        width: 40px;
        height: 40px;
        background: radial-gradient(circle, var(--brand-purple-pale) 0%, var(--brand-purple) 45%, var(--brand-purple-deep) 100%);
        border-radius: 50%;
        box-shadow: 0 0 2rem rgba(191, 60, 250, 0.45);
        animation: pulse 2s ease-in-out infinite;
      }

      .ring {
        position: absolute;
        border-radius: 50%;
        border: 3px solid rgba(191, 60, 250, 0.22);
        animation: spin linear infinite;
      }

      .ring-1 {
        width: 100%;
        height: 100%;
        border-top-color: var(--brand-purple-pale);
        animation-duration: 4s;
      }

      .ring-2 {
        width: 80%;
        height: 80%;
        border-bottom-color: var(--brand-gold);
        animation-duration: 6s;
        animation-direction: reverse;
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      @keyframes pulse {
        0%,
        100% {
          transform: scale(1);
          box-shadow: 0 0 2rem rgba(191, 60, 250, 0.45);
        }
        50% {
          transform: scale(1.15);
          box-shadow: 0 0 3rem rgba(227, 184, 255, 0.45);
        }
      }

      .status-text .h1 {
        font-family: "Oswald", sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-body);
        text-shadow: 0 1px 1px var(--edge-dark);
        margin: 0;
      }
      .status-text .p {
        font-size: 0.875rem;
        color: var(--text-muted);
        line-height: 1.6;
        margin: 1rem 0 0 0;
      }
    </style>
  </head>
  <body>
    <div class="premium-loading-container">
      <div class="brand-identity">PABO88</div>

      <div class="sophisticated-loader">
        <div class="orb"></div>
        <div class="ring ring-1"></div>
        <div class="ring ring-2"></div>
      </div>

      <div class="status-text">
        <h1 class="h1">AUTHENTICATING SECURE ACCESS...</h1>
        <p class="p">กำลังพาไปหน้าเข้าสู่ระบบ PABO88 ด้วยเบอร์โทรศัพท์ <span aria-hidden="true">🔒</span></p>
      </div>
    </div>

    <script define:vars={{ targetUrl }}>
      setTimeout(() => {
        window.location.replace(targetUrl);
      }, 3000);
    </script>
  </body>
</html>
