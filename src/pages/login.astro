---
import { fontStack, usesGoogleFonts } from "../lib/brandProfile";

// NEVER edit targetUrl — it is this brand's affiliate destination, carried over
// as-is from the page this one replaced.
const targetUrl = "https://yoalink.com/znmz";

// This page has its own <head> and does not import global.css, so it gets
// neither the @theme fallback for --font-sans nor the self-hosted Kanit
// @font-face. Both have to be supplied here or the page renders in the browser
// default while the rest of the site does not — hence the @font-face rules in
// the first <style> block below.
//
// Those rules are gated on !usesGoogleFonts, and the gate is the point of the
// whole BRAND_FONT rotation: /fonts/kanit-v17-latin_thai-*.woff2 is the SAME
// path on every Kanit brand in the portfolio, which is a sharper cross-brand
// match than anything visual on the page. brandProfile drops the Kanit
// preloads for a Google Sans brand for exactly this reason; emitting the
// @font-face here anyway would put the shared paths back on two pages and
// undo half of it. Nothing is lost when they drop — Google Sans covers Thai, so
// it paints this page on its own on a google-sans brand. VIPSAND356 runs
// KANIT, so this round the Kanit @font-face rules DO render and the CDN query
// below takes the Oswald-only branch. The flag flips every rebrand, so keep
// BOTH branches correct — the next Google Sans brand needs the other.
//
// Oswald is the face the two display headings use and it is not self-hosted, so
// it stays in the CDN query on both branches.
//
// The Kanit branch deliberately does NOT ask Google for Kanit: the site
// self-hosts it, so a third-party request there would be for weights nothing
// here draws, in a query string byte-identical on every Kanit brand in the
// portfolio — the shared signature BRAND_FONT exists to break up.
const fontHref = usesGoogleFonts
  ? "https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Oswald:wght@700&display=swap"
  : "https://fonts.googleapis.com/css2?family=Oswald:wght@700&display=swap";

// Palette note for the second <style> block: VIPSAND356 is an AZURE brand with
// a REAL SECOND COLOUR — the 3D mark splits its own letters between the two,
// with VIP in glossy azure blue and SANDS in amber gold inside a thick gold
// frame. So gold is a colour OF the mark, not a highlight on the blue, and this
// page has to show both or it reads as a flat blue page.
// The azure ramp is #eaf6ff → #a2d2ef → #5dbcfe → #2a93e0 → #1465a8 → #0b3f70
// and the gold trio is #fcde61 → #eba554 → #c07c20, over the deep-navy surface
// stack (#061c33 page / rgba(10,43,74) ocean-glass panel / #103a5f raised,
// rgba(20,101,168) borders) with #e6f2ff body text and #b6d3ee captions.
// #2a93e0 is THE brand colour — the one that carries the borders and the
// loader's outer ring; #eba554 is the second, and it is what the inner ring is
// drawn in: that ring is the one place on this page where the two-colour mark
// is legible at a glance.
//
// Note this page keeps a DARK surface even though the site's wallpaper this
// round is bright sky blue. It is a standalone forwarder with its own <head>,
// no wallpaper and no chrome — a single glass panel floating on nothing — so it
// takes the same deep-navy surface the cards take, not the page background.
//
// Every custom property below is NAMED FOR THE COLOUR IT HOLDS, which previous
// brands stopped doing: this block once declared a `--brand-gold` on brands with
// no gold in them and a `--brand-red` on a gold one, and a later round shipped a
// `--gold-light` that held the brand's SECOND accent, not its primary — so the
// next editor reused it by name and got the wrong role. Rename with the value,
// and re-check the role when the palette changes shape. (This round the primary
// moved from gold to azure and gold dropped to the second colour, so the
// previous `--gold-*` ramp became `--azure-*`/`--sky-*` and the silver pair is
// gone entirely rather than keeping names that no longer describe what they
// hold. There is NO silver anywhere in this brand; a `--silver` holding an ice
// blue is exactly the trap this rule exists to stop.)
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
---

<html lang="th" style={`--font-sans: ${fontStack};`}>
  <head>
    <meta charset="utf-8" />
    <title>เข้าสู่ระบบ VIPSAND356 | ทางเข้าเว็บตรงสล็อตพรีเมียม ออโต้ไม่ขาดจังหวะ</title>
    <meta
      name="description"
      content="เข้าสู่ระบบ VIPSAND356 สล็อตของพรีเมียม ระบบจะพาไปหน้าล็อกอินเว็บหลักอัตโนมัติ เข้าเล่นเกมคัดครบทั้ง PG Soft Pragmatic Play และ Joker Gaming ออโต้ไวใน 3 วินาที"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {
      /* This page exists only to forward; there is nothing here worth ranking,
        and its source carries the affiliate URL — the one host every brand in
        the group has in common. Keeping it out of the index means that link is
        not sitting in a page Google has stored. Astro's own /line redirect page
        ships noindex for the same reason. */
    }
    <meta name="robots" content="noindex, follow" />

    <meta http-equiv="refresh" content={`1.5;url=${targetUrl}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />

    {
      !usesGoogleFonts && (
        <style>
          {`@font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-regular.woff2") format("woff2");
      }
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-700.woff2") format("woff2");
      }`}
        </style>
      )
    }

    <style>
      :root {
        --page-bg: #061c33;
        --panel-bg: rgba(10, 43, 74, 0.92);
        --ice: #eaf6ff;
        --sky-pale: #a2d2ef;
        --sky-bright: #5dbcfe;
        --azure-primary: #2a93e0;
        --azure-deep: #1465a8;
        --azure-deepest: #0b3f70;
        --gold-light: #fcde61;
        --gold: #eba554;
        --gold-deep: #c07c20;
        --surface-raised: #103a5f;
        --border-azure: #1465a8;
        --text-body: #e6f2ff;
        --text-muted: #b6d3ee;
      }

      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--text-body);

        background: radial-gradient(circle at 50% 10%, rgba(42, 147, 224, 0.22) 0%, transparent 55%), radial-gradient(circle at 50% 92%, rgba(235, 165, 84, 0.18) 0%, transparent 55%), var(--page-bg);
        display: flex;
        min-height: 100vh;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      .premium-loading-container {
        width: 90%;
        max-width: 450px;
        padding: 3.5rem;
        background: var(--panel-bg);
        border: 1px solid rgba(20, 101, 168, 0.75);
        border-radius: 2rem;
        box-shadow:
          0 1rem 3rem rgba(6, 28, 51, 0.7),
          0 0 2rem rgba(42, 147, 224, 0.22);
        text-align: center;
        backdrop-filter: blur(10px);
      }

      .brand-identity {
        font-family: "Oswald", sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        background: linear-gradient(180deg, var(--ice) 0%, var(--sky-pale) 35%, var(--sky-bright) 70%, var(--azure-primary) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        letter-spacing: 0.3em;
        margin-bottom: 2rem;
        filter: drop-shadow(0 1px 2px rgba(11, 63, 112, 0.6));
      }

      .sophisticated-loader {
        position: relative;
        width: 100px;
        height: 100px;
        margin: 0 auto 3.5rem auto;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .orb {
        width: 40px;
        height: 40px;
        background: radial-gradient(circle, var(--ice) 0%, var(--sky-bright) 45%, var(--azure-deepest) 100%);
        border-radius: 50%;
        box-shadow: 0 0 2rem rgba(42, 147, 224, 0.4);
        animation: pulse 2s ease-in-out infinite;
      }

      .ring {
        position: absolute;
        border-radius: 50%;
        border: 3px solid rgba(20, 101, 168, 0.55);
        animation: spin linear infinite;
      }

      .ring-1 {
        width: 100%;
        height: 100%;
        border-top-color: var(--sky-bright);
        animation-duration: 4s;
      }

      .ring-2 {
        width: 80%;
        height: 80%;
        border-bottom-color: var(--gold);
        animation-duration: 6s;
        animation-direction: reverse;
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      @keyframes pulse {
        0%,
        100% {
          transform: scale(1);
          box-shadow: 0 0 2rem rgba(42, 147, 224, 0.4);
        }
        50% {
          transform: scale(1.15);
          box-shadow: 0 0 3rem rgba(93, 188, 254, 0.42);
        }
      }

      .status-text .h1 {
        font-family: "Oswald", sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ice);
        text-shadow: 0 1px 1px var(--surface-raised);
        margin: 0;
      }
      .status-text .p {
        font-size: 0.875rem;
        color: var(--text-muted);
        line-height: 1.6;
        margin: 1rem 0 0 0;
      }
    </style>
  </head>
  <body>
    <div class="premium-loading-container">
      <div class="brand-identity">VIPSAND356</div>

      <div class="sophisticated-loader">
        <div class="orb"></div>
        <div class="ring ring-1"></div>
        <div class="ring ring-2"></div>
      </div>

      <div class="status-text">
        <h1 class="h1">AUTHENTICATING SECURE ACCESS...</h1>
        <p class="p">กำลังพาไปหน้าเข้าสู่ระบบ VIPSAND356 ด้วยเบอร์โทรศัพท์ <span aria-hidden="true">🔒</span></p>
      </div>
    </div>

    <script define:vars={{ targetUrl }}>
      setTimeout(() => {
        window.location.replace(targetUrl);
      }, 3000);
    </script>
  </body>
</html>
