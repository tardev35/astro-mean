---
import { fontStack, usesGoogleFonts } from "../lib/brandProfile";

// NEVER edit targetUrl — it is this brand's affiliate destination, carried over
// as-is from the page this one replaced.
const targetUrl = "https://yoalink.com/znmz";

// This page has its own <head> and does not import global.css, so it gets
// neither the @theme fallback for --font-sans nor the self-hosted Kanit
// @font-face. Both have to be supplied here or the page renders in the browser
// default while the rest of the site does not — hence the @font-face rules in
// the first <style> block below. GEN4 runs BRAND_FONT = "kanit", so those rules
// ARE this page's typeface this round rather than a dormant fallback; leave them
// in place either way, the flag flips every rebrand.
//
// Oswald is the only face left that needs a CDN: the two display headings use
// it and it is not self-hosted.
//
// The old value asked Google for "Kanit:wght@300;400;600" even though the site
// self-hosts Kanit: a third-party request for weights nothing here draws (300
// and 600 are used zero times), and a query string byte-identical on every
// Kanit brand in the portfolio — the shared signature BRAND_FONT exists to
// break up.
const fontHref = usesGoogleFonts
  ? "https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Oswald:wght@700&display=swap"
  : "https://fonts.googleapis.com/css2?family=Oswald:wght@700&display=swap";

// Palette note for the second <style> block: GEN4 is an ELECTRIC-BLUE brand
// (#0071d5 / #01a3f3 / #6fd2ff / #00408a) with RED (#e8241c) as the second
// accent — the "4" in the logo — used sparingly, on a near-black navy surface
// (#050b1a / #0b1b3a) with #d7e7ff body text. The outgoing brand was flame
// orange plus gold on a near-black charcoal.
//
// Every custom property below is NAMED FOR THE COLOUR IT HOLDS, which previous
// brands stopped doing: this block once declared `--brand-gold` on brands with
// no gold in them and `--brand-red` on a gold one, so the next editor reused it
// by name and shipped the wrong hue. Rename with the value.
---

<html lang="th" style={`--font-sans: ${fontStack};`}>
  <head>
    <meta charset="utf-8" />
    <title>เข้าสู่ระบบ GEN4 | ทางเข้าสล็อตเจนใหม่ เกมลิขสิทธิ์แท้ ระบบอัปเดตใหม่</title>
    <meta name="description" content="เข้าสู่ระบบ GEN4 สำหรับสมาชิก ระบบจะพาไปหน้าล็อกอินของเว็บหลักอัตโนมัติ เข้าเล่นสล็อตเจนใหม่ผ่านลิงก์ตรง เกมลิขสิทธิ์แท้ ระบบอัปเดตใหม่ เข้าไวทุกอุปกรณ์" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {
      /* This page exists only to forward; there is nothing here worth ranking,
        and its source carries the affiliate URL — the one host every brand in
        the group has in common. Keeping it out of the index means that link is
        not sitting in a page Google has stored. Astro's own /line redirect page
        ships noindex for the same reason. */
    }
    <meta name="robots" content="noindex, follow" />

    <meta http-equiv="refresh" content={`1.5;url=${targetUrl}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />

    <style>
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-regular.woff2") format("woff2");
      }
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-700.woff2") format("woff2");
      }
    </style>

    <style>
      :root {
        --page-bg: #050b1a;
        --panel-bg: rgba(11, 27, 58, 0.92);
        --brand-blue: #0071d5;
        --brand-blue-bright: #01a3f3;
        --brand-blue-light: #6fd2ff;
        --brand-blue-deep: #00408a;
        --brand-red: #e8241c;
        --border-navy: #102a5c;
        --text-body: #d7e7ff;
        --text-muted: #a9ddff;
      }

      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--text-body);

        background: radial-gradient(circle at 50% 10%, rgba(0, 113, 213, 0.28) 0%, transparent 55%), radial-gradient(circle at 50% 92%, rgba(232, 36, 28, 0.18) 0%, transparent 55%), var(--page-bg);
        display: flex;
        min-height: 100vh;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      .premium-loading-container {
        width: 90%;
        max-width: 450px;
        padding: 3.5rem;
        background: var(--panel-bg);
        border: 1px solid rgba(1, 163, 243, 0.38);
        border-radius: 2rem;
        box-shadow:
          0 1rem 3rem rgba(5, 11, 26, 0.6),
          0 0 2rem rgba(0, 113, 213, 0.25);
        text-align: center;
        backdrop-filter: blur(10px);
      }

      .brand-identity {
        font-family: "Oswald", sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        background: linear-gradient(180deg, var(--brand-blue-light) 0%, var(--brand-blue-bright) 40%, var(--brand-blue-deep) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        letter-spacing: 0.3em;
        margin-bottom: 2rem;
        filter: drop-shadow(0 1px 2px rgba(0, 113, 213, 0.45));
      }

      .sophisticated-loader {
        position: relative;
        width: 100px;
        height: 100px;
        margin: 0 auto 3.5rem auto;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .orb {
        width: 40px;
        height: 40px;
        background: radial-gradient(circle, var(--brand-blue-light) 0%, var(--brand-blue-bright) 45%, var(--brand-blue-deep) 100%);
        border-radius: 50%;
        box-shadow: 0 0 2rem rgba(0, 113, 213, 0.45);
        animation: pulse 2s ease-in-out infinite;
      }

      .ring {
        position: absolute;
        border-radius: 50%;
        border: 3px solid rgba(0, 113, 213, 0.22);
        animation: spin linear infinite;
      }

      .ring-1 {
        width: 100%;
        height: 100%;
        border-top-color: var(--brand-blue-bright);
        animation-duration: 4s;
      }

      .ring-2 {
        width: 80%;
        height: 80%;
        border-bottom-color: var(--brand-red);
        animation-duration: 6s;
        animation-direction: reverse;
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      @keyframes pulse {
        0%,
        100% {
          transform: scale(1);
          box-shadow: 0 0 2rem rgba(0, 113, 213, 0.45);
        }
        50% {
          transform: scale(1.15);
          box-shadow: 0 0 3rem rgba(1, 163, 243, 0.45);
        }
      }

      .status-text .h1 {
        font-family: "Oswald", sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-body);
        text-shadow: 0 1px 1px var(--border-navy);
        margin: 0;
      }
      .status-text .p {
        font-size: 0.875rem;
        color: var(--text-muted);
        line-height: 1.6;
        margin: 1rem 0 0 0;
      }
    </style>
  </head>
  <body>
    <div class="premium-loading-container">
      <div class="brand-identity">GEN4</div>

      <div class="sophisticated-loader">
        <div class="orb"></div>
        <div class="ring ring-1"></div>
        <div class="ring ring-2"></div>
      </div>

      <div class="status-text">
        <h1 class="h1">AUTHENTICATING SECURE ACCESS...</h1>
        <p class="p">กำลังพาไปหน้าเข้าสู่ระบบ GEN4 ด้วยเบอร์โทรศัพท์ <span aria-hidden="true">🔒</span></p>
      </div>
    </div>

    <script define:vars={{ targetUrl }}>
      setTimeout(() => {
        window.location.replace(targetUrl);
      }, 3000);
    </script>
  </body>
</html>
