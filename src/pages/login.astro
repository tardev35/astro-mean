---
import { fontStack, usesGoogleFonts } from "../lib/brandProfile";

// NEVER edit targetUrl — it is this brand's affiliate destination, carried over
// as-is from the page this one replaced.
const targetUrl = "https://yoalink.com/znmz";

// This page has its own <head> and does not import global.css, so it gets
// neither the @theme fallback for --font-sans nor the self-hosted Kanit
// @font-face. Both have to be supplied here or the page renders in the browser
// default while the rest of the site does not — hence the @font-face rules in
// the first <style> block below. AURA456 runs BRAND_FONT = "kanit", so this
// round the typeface comes from those self-hosted rules and the CDN <link> only
// carries Oswald; leave both branches in place either way, the flag flips every
// rebrand.
//
// Oswald is the face the two display headings use and it is not self-hosted, so
// it stays in the CDN query on both branches.
//
// The old value asked Google for "Kanit:wght@300;400;600" even though the site
// self-hosts Kanit: a third-party request for weights nothing here draws (300
// and 600 are used zero times), and a query string byte-identical on every
// Kanit brand in the portfolio — the shared signature BRAND_FONT exists to
// break up.
const fontHref = usesGoogleFonts
  ? "https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Oswald:wght@700&display=swap"
  : "https://fonts.googleapis.com/css2?family=Oswald:wght@700&display=swap";

// Palette note for the second <style> block: AURA456 is a NEON CYBER-MYSTIC
// casino brand — hot neon magenta (#ff2fb0 / #ff7fd4 / #ffc9ee) as the primary
// hue PAIRED WITH ELECTRIC BLUE (#d8f2ff / #7fd0ff / #3ba9ff) as the second
// accent, with violet (#8b3cf7 / #c81d8e / #4a179e) on the borders and glows,
// over a near-black indigo surface (#0b0528 / #120a33 / #1c1046) with #d8d3f0
// body text. There is NO gold and NO platinum in this brand.
//
// Every custom property below is NAMED FOR THE COLOUR IT HOLDS, which previous
// brands stopped doing: this block once declared a `--brand-gold` on brands with
// no gold in them and a `--brand-red` on a gold one, so the next editor reused
// it by name and shipped the wrong hue. Rename with the value. The `--gold-*`
// and `--platinum-*` properties this file used to carry are gone for that
// reason — neither colour exists in this brand.
---

<html lang="th" style={`--font-sans: ${fontStack};`}>
  <head>
    <meta charset="utf-8" />
    <title>เข้าสู่ระบบ AURA456 | ทางเข้าเว็บตรงสล็อตคัดเกรด ฝากถอนออโต้</title>
    <meta
      name="description"
      content="เข้าสู่ระบบ AURA456 สำหรับสมาชิก ระบบจะพาไปหน้าล็อกอินของเว็บหลักอัตโนมัติ เข้าเล่นสล็อตเว็บตรงคัดเกรด API แท้ 100% ผ่านลิงก์ตรง ฝากถอนออโต้ไม่ต้องรอแอดมิน"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {
      /* This page exists only to forward; there is nothing here worth ranking,
        and its source carries the affiliate URL — the one host every brand in
        the group has in common. Keeping it out of the index means that link is
        not sitting in a page Google has stored. Astro's own /line redirect page
        ships noindex for the same reason. */
    }
    <meta name="robots" content="noindex, follow" />

    <meta http-equiv="refresh" content={`1.5;url=${targetUrl}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />

    <style>
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-regular.woff2") format("woff2");
      }
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-700.woff2") format("woff2");
      }
    </style>

    <style>
      :root {
        --page-bg: #0b0528;
        --panel-bg: rgba(18, 10, 51, 0.92);
        --pink-pale: #ffc9ee;
        --pink-light: #ff7fd4;
        --pink-primary: #ff2fb0;
        --magenta-deep: #c81d8e;
        --violet-deep: #4a179e;
        --cyan-pale: #d8f2ff;
        --cyan-light: #7fd0ff;
        --surface-raised: #1c1046;
        --text-body: #d8d3f0;
        --text-muted: #9b93c4;
      }

      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--text-body);

        background: radial-gradient(circle at 50% 10%, rgba(139, 60, 247, 0.32) 0%, transparent 55%), radial-gradient(circle at 50% 92%, rgba(59, 169, 255, 0.14) 0%, transparent 55%), var(--page-bg);
        display: flex;
        min-height: 100vh;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      .premium-loading-container {
        width: 90%;
        max-width: 450px;
        padding: 3.5rem;
        background: var(--panel-bg);
        border: 1px solid rgba(139, 60, 247, 0.42);
        border-radius: 2rem;
        box-shadow:
          0 1rem 3rem rgba(3, 1, 14, 0.6),
          0 0 2rem rgba(139, 60, 247, 0.28);
        text-align: center;
        backdrop-filter: blur(10px);
      }

      .brand-identity {
        font-family: "Oswald", sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        background: linear-gradient(180deg, var(--cyan-pale) 0%, var(--pink-light) 45%, var(--magenta-deep) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        letter-spacing: 0.3em;
        margin-bottom: 2rem;
        filter: drop-shadow(0 1px 2px rgba(139, 60, 247, 0.5));
      }

      .sophisticated-loader {
        position: relative;
        width: 100px;
        height: 100px;
        margin: 0 auto 3.5rem auto;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .orb {
        width: 40px;
        height: 40px;
        background: radial-gradient(circle, var(--pink-pale) 0%, var(--pink-primary) 45%, var(--violet-deep) 100%);
        border-radius: 50%;
        box-shadow: 0 0 2rem rgba(139, 60, 247, 0.5);
        animation: pulse 2s ease-in-out infinite;
      }

      .ring {
        position: absolute;
        border-radius: 50%;
        border: 3px solid rgba(139, 60, 247, 0.24);
        animation: spin linear infinite;
      }

      .ring-1 {
        width: 100%;
        height: 100%;
        border-top-color: var(--pink-primary);
        animation-duration: 4s;
      }

      .ring-2 {
        width: 80%;
        height: 80%;
        border-bottom-color: var(--cyan-light);
        animation-duration: 6s;
        animation-direction: reverse;
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      @keyframes pulse {
        0%,
        100% {
          transform: scale(1);
          box-shadow: 0 0 2rem rgba(139, 60, 247, 0.5);
        }
        50% {
          transform: scale(1.15);
          box-shadow: 0 0 3rem rgba(255, 47, 176, 0.42);
        }
      }

      .status-text .h1 {
        font-family: "Oswald", sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-body);
        text-shadow: 0 1px 1px var(--surface-raised);
        margin: 0;
      }
      .status-text .p {
        font-size: 0.875rem;
        color: var(--text-muted);
        line-height: 1.6;
        margin: 1rem 0 0 0;
      }
    </style>
  </head>
  <body>
    <div class="premium-loading-container">
      <div class="brand-identity">AURA456</div>

      <div class="sophisticated-loader">
        <div class="orb"></div>
        <div class="ring ring-1"></div>
        <div class="ring ring-2"></div>
      </div>

      <div class="status-text">
        <h1 class="h1">AUTHENTICATING SECURE ACCESS...</h1>
        <p class="p">กำลังพาไปหน้าเข้าสู่ระบบ AURA456 ด้วยเบอร์โทรศัพท์ <span aria-hidden="true">🔒</span></p>
      </div>
    </div>

    <script define:vars={{ targetUrl }}>
      setTimeout(() => {
        window.location.replace(targetUrl);
      }, 3000);
    </script>
  </body>
</html>
