---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxFloatingBadge.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

// One list, two consumers: the gallery below and the ItemList in the JSON-LD.
// They used to be two hand-kept arrays that had to stay in the same order, and
// the name shown to a reader could drift from the name handed to a crawler.
// The card shows the artwork only — the provider name is chrome, so it lives in
// the link's aria-label, never in a heading tag.
//
// alt describes the picture, not the brand: the artwork is the same on every
// rebrand, so an alt that names the site rots the moment the site is renamed.
const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่ายเกม AskmeSlot โลโก้โพดำสีเหลืองข้างตัวการ์ตูนเด็กชายหมวกแดงบนถนนหมู่บ้านกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์รวมเกมยอดนิยม Popular Game พร้อมตัวการ์ตูนกระต่ายและแมว กองชิปและเหรียญทอง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่ายเกม SlotXO โลโก้ตู้สล็อตและเหรียญทองข้างภาพนักรบโรมันสวมมงกุฎใบลอเรลหน้าโคลอสเซียม" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่ายเกม Skywind Group โลโก้วงกลมสี่สีข้างแมวกวักญี่ปุ่นสีขาวท่ามกลางดอกซากุระและถุงทอง" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่ายเกม PG Soft โลโก้พิกเซลตัวอักษร PG ข้างตัวละครหญิงนักรบสวมเครื่องประดับทองและหมวกขนนกสีสด" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET ตัวอักษรสีน้ำเงินข้างตัวการ์ตูนถือลูกอมบนพื้นหลังโทนสว่าง" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์ค่ายเกม Sexy Slot ตัวอักษรสีชมพูข้างภาพตัวละครหญิงในชุดรัดรูปสีน้ำเงินและสัญลักษณ์รูปหัวใจ" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรสีทองข้างตัวละครนางเงือกผมแดงถือหอยสังข์ใต้ทะเลพร้อมปลาการ์ตูน" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม Ask Me Bet ตัวอักษรสีทองข้างไพ่ ลูกเต๋า และกองชิปคาสิโนบนโต๊ะเดิมพัน" },
  { name: "New Game", src: image10, alt: "แบนเนอร์เกมออกใหม่ New Game พร้อมตัวการ์ตูนฟักทองและโครงกระดูก" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรขาวทองข้างนักรบโรมันสวมหมวกขนนกและสิงโตคำรามในสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming โลโก้ตัวอักษร AFB บนพื้นหลังไฟนีออนโทนเข้ม" },
];

// The URL each entry resolves to is schema.ts's problem, not this file's — an
// older version pasted a hand-built page URL onto all 12 and got the trailing
// slash and the Thai encoding wrong on every one of them.
const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

// 150–160 CHARACTERS (Thai is 3 bytes per character, so a byte count reads
// about three times too long and will send you rewriting a fine description).
// This one measures 153.
const pageDescription = "ทดลองเล่น LUCKYBKK เปิดดูล็อบบี้ค่ายเกมและโต๊ะเดิมพันสดทั้งบาคาร่า รูเล็ต เสือมังกร ไฮโล ให้คุ้นหน้าเกมและจังหวะวางเดิมพันก่อนลงเงินจริง ระบบลื่นไม่หน่วง";

const pageTitle = "ทดลองเล่น LUCKYBKK | เปิดดูโต๊ะเกมสดและค่ายเกมก่อนลงเดิมพันจริง";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "ทดลองเล่น LUCKYBKK เปิดดูค่ายเกมและโต๊ะเดิมพันสดก่อนลงเงินจริง";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ค่ายเกมและโต๊ะเดิมพันสดที่คัดไว้ในล็อบบี้ของ LUCKYBKK",
      alternateName: "LUCKYBKK โหมดเปิดดูค่ายเกมและโต๊ะสดบนมือถือก่อนเดิมพันด้วยเครดิตจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});

// ชุดไล่สีเดียวกับที่ ContentBoxFloatingBadge ใช้กับหัวข้อของตัวเอง — ทองไล่เข้าหาน้ำเงินรอยัล
const headingClass = "bg-gradient-to-r from-[#ffdf7e] via-[#f0b323] to-[#3f9dfb] bg-clip-text text-2xl leading-normal font-bold text-transparent";

// sizes บอกว่าภาพถูก "วาด" กว้างเท่าไหร่ ไม่ใช่อยากได้ไฟล์กว้างเท่าไหร่
// กริดเป็น grid-cols-2 จนถึง md: แล้วค่อยเป็น 4 คอลัมน์ ส่วน ContentBoxFloatingBadge
// มี px-4 + p-8 (รวม 6rem) เท่ากันทุกความกว้าง เพดานการ์ดอยู่ที่ max-w-[1400px]
//   < 768px : 2 คอลัมน์ + gap-5 หนึ่งช่อง  → (100vw - 7.25rem) / 2
//   ≥ 768px : 4 คอลัมน์ + gap-5 สามช่อง   → (100vw - 9.75rem) / 4
//   ≥ 1432px: การ์ดชนเพดาน 1400px         → (1400 - 4rem - 3.75rem) / 4 = 319px
const galleryImageSizes = "(max-width: 767px) calc((100vw - 7.25rem) / 2), (max-width: 1431px) calc((100vw - 9.75rem) / 4), 319px";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <h2 class={`mb-6 ${headingClass}`}>หน้านี้ของ LUCKYBKK มีไว้ทำอะไร และควรดูอะไรก่อนเลือกโต๊ะ</h2>

      <p class="mb-8 text-left text-base leading-relaxed">
        LUCKYBKK คัดค่ายเกมชั้นนำที่มีสตูดิโอถ่ายทอดสดของตัวเองมารวมไว้ในล็อบบี้เดียว ครบทั้งบาคาร่า รูเล็ต เสือมังกร และไฮโล พร้อมห้องเดิมพันให้เลือกตั้งแต่เบทเริ่มต้นสบายๆ ไปจนถึงห้องระดับ High Roller สำหรับสายลุยหนัก
        หน้านี้มีไว้ให้เปิดดูก่อนว่าแต่ละค่ายเสิร์ฟอะไร หน้าโต๊ะจริงหน้าตาเป็นแบบไหน ช่องวางเดิมพันแบ่งไว้อย่างไร เวลานับถอยหลังก่อนปิดรับเดิมพันยาวเท่าไร และสถิติย้อนหลังของโต๊ะแสดงอยู่ตรงไหนของจอ
        โดยยังไม่ต้องเติมเครดิตจริงและไม่มีการได้เสียเกิดขึ้นแม้แต่บาทเดียว สิ่งที่ควรดูจริงคือเบทขั้นต่ำและเบทสูงสุดของแต่ละห้อง รูปแบบการจ่ายของแต่ละช่อง และจังหวะของเกมว่าเร็วหรือช้าพอดีกับที่เราถนัดหรือเปล่า
        มากกว่าดูว่าโต๊ะไหนภาพสวยที่สุด งานภาพคมชัดระดับ HD กับเสียงจากสตูดิโอช่วยให้เล่นเพลินขึ้นจริง แต่ไม่ได้ช่วยเจรจากับไพ่ใบที่กำลังจะเปิดเป็นการส่วนตัว ถือเป็นการอ่านคู่มือก่อนขับ ซึ่งน่าเบื่อกว่าการลองขับเลยอยู่แล้ว
        แต่ค่าซ่อมมันถูกกว่ากันเยอะ
      </p>

      <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[200, 400, 600]}
                sizes={galleryImageSizes}
                class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(63,157,251,0.35)] transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href="/register"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ LUCKYBKK`}
                class="absolute inset-0 flex items-center justify-center bg-[#030b28]/72 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-full border border-[#f0b323]/70 bg-gradient-to-r from-[#ffdf7e] to-[#f0b323] px-6 py-2 font-bold text-[#030b28] shadow-[0_10px_30px_rgba(240,179,35,0.45)] transition-transform hover:scale-110">
                  เล่นเลย
                </span>
              </a>
            </div>
          ))
        }
      </div>

      <h2 class={`mt-8 mb-6 ${headingClass}`}>การเปิดดูก่อนเล่นบอกอะไรได้ และบอกอะไรไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed">
        การเปิดดูก่อนบอกได้ว่าเกมทำงานอย่างไร ปุ่มเลือกชิปกับปุ่มยืนยันเดิมพันอยู่ตรงไหน วางแล้วกดยกเลิกทันหรือไม่ ผลแต่ละตาถูกบันทึกลงตารางสถิติแบบใด และหนึ่งรอบใช้เวลาเท่าไรตั้งแต่เปิดรับเดิมพันจนดีลเลอร์ประกาศผล
        แต่สิ่งที่มันบอกไม่ได้เลยคือผลของตาถัดไป เพราะเกมสดทุกเกมตัดสินจากไพ่ที่แจกจริงและลูกที่หมุนจริงในสตูดิโอ ณ วินาทีนั้น แต่ละตาจึงเป็นอิสระจากกันเสมอ ไม่ว่าตารางย้อนหลังจะออกมาเป็นลายอะไรก็ตาม
        สถิติย้อนหลังที่โต๊ะแสดงไว้มีประโยชน์จริงในแง่การวางแผนงบและจังหวะเข้าออก และเราตั้งใจแสดงมันให้ชัดด้วยเหตุผลนั้น
        แต่มันไม่ใช่หลักฐานว่าโต๊ะนั้นกำลังอารมณ์ดีรอเราอยู่ หน้านี้มีไว้ศึกษาระบบ ไม่ใช่ไว้ดูดวงผ่านหน้าจอ
      </p>

      <p class="mb-4 text-left text-base leading-relaxed">
        อีกเรื่องที่ควรเผื่อใจคือเกมสดต่างจากเกมที่ระบบสุ่มผลเองตรงที่ไม่ได้มีเครดิตทดลองให้กดครบทุกโต๊ะ บางค่ายเปิดให้เข้าไปดูบรรยากาศในห้องได้อย่างเดียวโดยยังไม่ให้วางเดิมพัน จึงควรเปิดรายละเอียดของห้องนั้นดูก่อนเลือก
        และยอดที่วางระหว่างทดลองไม่นับเป็นยอดของบัญชีหรือของโปรโมชันใด ถ้าห้องที่อยากลองยังไม่เปิดให้ดูฟรี ให้ถือว่าวันนี้โชคไม่ดี ไม่ใช่สัญญาณลับที่ระบบส่งมาให้เราคนเดียว
        อีกอย่างที่การเปิดดูตามไม่ทันคือโต๊ะที่เพิ่งเปิดใหม่ เพราะทีมงานของ LUCKYBKK ขยันเพิ่มค่ายและห้องเดิมพันใหม่เข้าระบบให้สมาชิกได้ลองก่อนใครอยู่เสมอ บางห้องจึงเปิดรับเดิมพันจริงก่อนแล้วค่อยมีข้อมูลประกอบตามมาทีหลัง
        ข้อดีคือระบบหลังบ้านที่นี่ประมวลผลฉับไว กดสลับโต๊ะหรือสลับค่ายได้ลื่นไม่หน่วงและไม่ต้องนั่งรอโหลดหน้าเว็บ การไล่เปิดดูหลายห้องรวดเดียวจึงเสียเวลาน้อยกว่าที่คิด ใช้จังหวะนั้นสำรวจให้ครบก่อนตัดสินใจลงเงินจริงจะคุ้มกว่า
      </p>

      <h2 class={`mt-8 mb-6 ${headingClass}`}>จากการเปิดดูไปเดิมพันจริงบน LUCKYBKK ควรเช็กอะไรก่อน</h2>

      <p class="mb-2 text-left text-base leading-relaxed">
        ถ้าจะขยับจากการเปิดดูไปเดิมพันด้วยเครดิตจริง เรื่องที่ควรดูก่อนคือบัญชี งบต่อตา และลิงก์ที่ใช้เข้าเว็บ ด้านบัญชี ระบบตรงของที่นี่ไม่ผ่านเอเย่นต์และตัดขั้นตอนที่ไม่จำเป็นออกจนสมัครจบได้ในไม่กี่ขั้นตอน
        ผูกเบอร์มือถือกับบัญชีธนาคารหรือทรูวอลเล็ทให้เรียบร้อย ก็ได้ยูสเซอร์เดียวไว้เข้าได้ทุกค่ายในล็อบบี้โดยไม่ต้องเปลี่ยนยูสเซอร์หรือโยกเงินข้ามกระเป๋าให้เสียจังหวะกลางเกม
        ควรเตรียมเบอร์โทรที่ใช้งานจริงและรับข้อความได้ ตั้งรหัสผ่านที่เดายากและไม่ใช้ซ้ำกับบัญชีอื่น แล้วตรวจชื่อบัญชีธนาคารกับข้อมูลสมาชิกให้ตรงกันก่อนยืนยัน เพราะระบบการเงินอ่านชื่อบัญชีเป็นหลัก
        สมัครเร็วเป็นเรื่องดี แต่กรอกผิดแล้วตามแก้ทีหลัง ความเร็วก็หายหมด ด้านงบ ควรตั้งยอดต่อตาให้พอดีกับทุนที่ตั้งใจใช้ในวันนั้น แล้วดูเบทขั้นต่ำของห้องกับยอดขั้นต่ำบนหน้าฝากแยกกันอีกครั้ง
        เพราะสองตัวเลขนั้นเป็นคนละเรื่องกัน ข้อดีคือระบบการเงินที่นี่เป็นออโต้ที่ทำรายการเองได้ในไม่กี่ขั้นตอน ยอดอัปเดตไวและโอนเข้าบัญชีโดยตรง เติมทุนหรือถอนกำไรตอนตีสองตีสามจึงไม่ต้องส่งสลิปและไม่ต้องรอแอดมินอนุมัติ
        ส่วนเรื่องโบนัส แต่ละรายการมีเงื่อนไขและรอบเวลาของตัวเอง จึงควรอ่านเพดานกับเงื่อนไขของสิทธิ์ที่จะกดรับให้จบก่อนกด สุดท้ายควรเข้าใช้งานผ่านทางเข้าจริงของ LUCKYBKK ที่ตรวจชื่อเว็บไซต์แล้วและเชื่อมต่อแบบ HTTPS เท่านั้น
        ไม่ใช่ลิงก์ที่ส่งต่อกันมาในแชตพร้อมคำโฆษณา เพราะลิงก์แบบนั้นมักพาไปเจออะไรจริง แค่ไม่ใช่ในทางที่เราหวัง
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
