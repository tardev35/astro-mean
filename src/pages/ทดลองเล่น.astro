---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

// One list, two consumers: the gallery below and the ItemList in the JSON-LD.
// They used to be two hand-kept arrays that had to stay in the same order, and
// the name shown to a reader could drift from the name handed to a crawler.
// The card shows the artwork only — the provider name is chrome, so it lives in
// the link's aria-label, never in a heading tag.
//
// alt describes the picture, not the brand: the artwork is the same on every
// rebrand, so an alt that names the site rots the moment the site is renamed.
const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่ายเกม AskmeSlot โลโก้โพดำสีเหลืองข้างตัวการ์ตูนเด็กชายหมวกแดงบนถนนหมู่บ้านกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์รวมเกมยอดนิยม Popular Game พร้อมตัวการ์ตูนกระต่ายและแมว กองชิปและเหรียญทอง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่ายเกม SlotXO โลโก้ตู้สล็อตและเหรียญทองข้างภาพนักรบโรมันสวมมงกุฎใบลอเรลหน้าโคลอสเซียม" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่ายเกม Skywind Group โลโก้วงกลมสี่สีข้างแมวกวักญี่ปุ่นสีขาวท่ามกลางดอกซากุระและถุงทอง" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่ายเกม PG Soft โลโก้พิกเซลตัวอักษร PG ข้างตัวละครหญิงนักรบสวมเครื่องประดับทองและหมวกขนนกสีสด" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET พร้อมตัวละครการ์ตูนถือลูกอม" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์ค่ายเกม Sexy Slot ตัวอักษรสีชมพูม่วงข้างภาพตัวละครหญิงในชุดรัดรูปสีน้ำเงินและสัญลักษณ์รูปหัวใจ" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรสีทองข้างตัวละครนางเงือกผมแดงถือหอยสังข์ใต้ทะเลพร้อมปลาการ์ตูน" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม Ask Me Bet พร้อมสัญลักษณ์เกมคาสิโน" },
  { name: "New Game", src: image10, alt: "แบนเนอร์เกมออกใหม่ New Game พร้อมตัวการ์ตูนฟักทองและโครงกระดูก" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรขาวทองข้างนักรบโรมันสวมหมวกขนนกและสิงโตคำรามในสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming พร้อมโลโก้ค่ายบนพื้นหลังไฟนีออน" },
];

// The URL each entry resolves to is schema.ts's problem, not this file's — an
// older version pasted a hand-built page URL onto all 12 and got the trailing
// slash and the Thai encoding wrong on every one of them.
const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

// 150–160 CHARACTERS (Thai is 3 bytes per character, so a byte count reads
// about three times too long and will send you rewriting a fine description).
// This one measures 159.
const pageDescription =
  "ทดลองเล่นสล็อต THUNDER87 เปิดดูเกมค่ายดังครบล็อบบี้ก่อนลงเครดิตจริง ดูจังหวะสปิน ฟีเจอร์ฟรีสปินและตัวคูณ พร้อมเดิมพันต่อรอบ บนระบบออโต้ที่สลับค่ายไวไม่มีกระตุก";

const pageHeading = "ทดลองเล่นสล็อต THUNDER87 เปิดดูเกมค่ายดังครบล็อบบี้ก่อนลงเครดิตจริง";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมสล็อตจากค่ายชั้นนำของ THUNDER87",
      alternateName: "THUNDER87 โหมดทดลองเล่นสล็อตบนมือถือก่อนเล่นด้วยเครดิตจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});

// เหลืองสายฟ้าไล่ไปหาทองเข้ม — ชุดเดียวกับที่ ContentBox ใช้กับหัวข้อของตัวเอง
const headingClass = "bg-gradient-to-r from-[#fff89a] via-[#fae61c] to-[#dcb309] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="ทดลองเล่น THUNDER87 ลองสล็อตค่ายดังครบล็อบบี้ก่อนเติมเครดิตจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <h2 class={`mb-6 ${headingClass}`}>โหมดทดลองของ THUNDER87 มีไว้ทำอะไร และควรดูอะไรก่อนเลือกเกม</h2>

      <p class="mb-8 text-left text-base leading-relaxed">
        THUNDER87 ขนเกมจากค่ายดังระดับโลกมาลงแน่นไว้ในที่เดียวแบบไม่หวง คัดมาแล้วทั้งงานภาพคมชัดและอัตราการจ่ายที่สมน้ำสมเนื้อ เปิดล็อบบี้มาทีจึงมีแต่ตัวน่าเล่น
        ระบบประมวลผลเองก็แรงและเสถียร กดเข้าเกมได้ฉับไวและสลับค่ายได้ลื่นไหลไม่มีกระตุก หน้านี้มีไว้ให้กดเปิดดูหน้าเกมก่อนว่าระบบหน้าตาเป็นแบบไหน ปุ่มปรับเดิมพันอยู่ตรงไหน
        ฟีเจอร์ซื้อฟรีสปินกับตัวคูณเรียกใช้อย่างไร และหนึ่งรอบกินเวลาแค่ไหน โดยยังไม่ต้องเติมเครดิตจริงและไม่มีการได้เสียเกิดขึ้นแม้แต่บาทเดียว
        สิ่งที่ควรดูจริงคือเดิมพันเริ่มต้นต่อรอบ ความผันผวนของเกม และรูปแบบการจ่ายรางวัล มากกว่าดูว่าเกมไหนกำลังดังที่สุด เกมดังช่วยให้หารีวิวง่าย
        แต่ไม่ได้ช่วยเจรจากับระบบสุ่มเป็นการส่วนตัว ถือเป็นการอ่านคู่มือก่อนขับ ซึ่งน่าเบื่อกว่าการลองขับเลยอยู่แล้ว แต่ค่าซ่อมมันถูกกว่ากันเยอะ
      </p>

      <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[200, 400, 600]}
                sizes="(max-width: 768px) 100vw, 25vw"
                class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(220,179,9,0.30)] transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href="/register"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ THUNDER87`}
                class="absolute inset-0 flex items-center justify-center bg-[#080703]/72 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-full border border-[#fff89a]/70 bg-gradient-to-r from-[#fae61c] to-[#8a7405] px-6 py-2 font-bold text-[#0b0a04] shadow-[0_10px_30px_rgba(250,230,28,0.45)] transition-transform hover:scale-110">เล่นเลย</span>
              </a>
            </div>
          ))
        }
      </div>

      <h2 class={`mt-8 mb-6 ${headingClass}`}>โหมดทดลองบอกอะไรได้ และบอกอะไรไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed">
        โหมดทดลองบอกได้ว่าเกมทำงานอย่างไร เมนูอยู่ตรงไหน ฟีเจอร์ฟรีสปินเรียกใช้ยังไง สัญลักษณ์พิเศษหน้าตาเป็นแบบไหน และหนึ่งรอบใช้เวลาเท่าไร
        แต่เครดิตในโหมดนี้เป็นยอดสมมติ ถอนไม่ได้ และผลที่ออกมาก็ไม่ได้บอกว่าเล่นจริงจะได้ผลเหมือนกัน เพราะเกมแต่ละตัววิ่งบนกลไกสุ่มผลของค่ายเกมนั้น ๆ โดยตรง
        ผลของแต่ละสปินจึงเป็นอิสระจากกันเสมอ ตัวคูณสะสม สัญลักษณ์พิเศษที่ช่วยเข้าฟีเจอร์ง่ายขึ้น และฟรีสปินที่ THUNDER87 คัดมาไว้ให้ เป็นสิ่งที่ดูรูปแบบได้จากโหมดทดลอง
        แต่ไม่ใช่หลักฐานว่าเกมนั้นกำลังอารมณ์ดีรอเราอยู่ โหมดนี้มีไว้ศึกษาระบบ ไม่ใช่ไว้ดูดวงผ่านหน้าจอ
      </p>

      <p class="mb-4 text-left text-base leading-relaxed">
        อีกเรื่องที่ควรเผื่อใจคือโหมดทดลองไม่ได้มีให้ครบทุกเกม จึงควรเปิดหน้ารายละเอียดของเกมดูก่อนเลือก และยอดที่หมุนในโหมดทดลองไม่นับเป็นยอดเทิร์นของบัญชีหรือของโปรโมชั่นใด
        ถ้าเกมที่อยากลองไม่มีปุ่มทดลอง ให้ถือว่าวันนี้โชคไม่ดี ไม่ใช่สัญญาณลับที่ระบบส่งมาให้เราคนเดียว อีกอย่างที่โหมดทดลองตามไม่ทันคือเกมที่เพิ่งอัปเดตเข้าระบบ
        เพราะล็อบบี้ของ THUNDER87 รวมทั้งสล็อต คาสิโนสด และบาคาร่าไว้เต็มล็อบบี้และมีของใหม่เข้ามาเสมอ บางตัวจึงเข้ามาให้เล่นด้วยเครดิตจริงก่อนแล้วค่อยมีโหมดทดลองตามมาทีหลัง
        และรูปแบบการจ่ายรางวัลที่ใช้จริงก็ต้องดูจากตารางการจ่ายของเกมเอง ไม่ใช่จากจำนวนสปินที่ลองหมุนเล่นในโหมดนี้
      </p>

      <h2 class={`mt-8 mb-6 ${headingClass}`}>จากโหมดทดลองไปเล่นจริงบน THUNDER87 ควรเช็กอะไรก่อน</h2>

      <p class="mb-2 text-left text-base leading-relaxed">
        ถ้าจะขยับจากโหมดทดลองไปเล่นด้วยเครดิตจริง เรื่องที่ควรดูก่อนคือบัญชี งบต่อรอบ และลิงก์ที่ใช้เข้าเว็บ ด้านบัญชี ขั้นตอนลงทะเบียนถูกออกแบบมาให้สั้นและกระชับ
        ผูกเบอร์มือถือกับบัญชีธนาคารให้เรียบร้อยก็ได้ยูสเซอร์เดียวไปสลับเล่นได้ทั้งสล็อต คาสิโนสด และบาคาร่า ควรเตรียมเบอร์โทรที่ใช้งานจริงและรับข้อความได้
        ตั้งรหัสผ่านที่เดายากและไม่ใช้ซ้ำกับบัญชีอื่น แล้วตรวจชื่อบัญชีธนาคารกับข้อมูลสมาชิกให้ตรงกันก่อนยืนยัน เพราะระบบออโต้อ่านชื่อบัญชีเป็นหลัก
        สมัครเร็วเป็นเรื่องดี แต่กรอกผิดแล้วตามแก้ทีหลัง ความเร็วก็หายหมด ด้านงบ ควรตั้งเดิมพันต่อรอบให้พอดีกับยอดที่ตั้งใจใช้ในวันนั้น แล้วดูยอดบนหน้าฝากและหน้าเกมแยกกันอีกครั้ง
        เพราะเดิมพันต่อรอบของเกมกับเงื่อนไขของการฝากถอนเป็นคนละตัวเลขกัน ส่วนเรื่องเงิน ระบบการเงินออโต้ที่นี่แม่นยำและรวดเร็ว ทำรายการฝากถอนเองได้ ไม่ต้องผ่านคนกลาง
        ทุกขั้นตอนจบภายในเวลาอันสั้นโดยไม่ต้องนั่งรอจนเสียอารมณ์ เมนูก็จัดหมวดหมู่ไว้ให้สลับค่ายได้คล่องกว่าตอนอยู่ในโหมดทดลองมาก สุดท้ายควรเข้าใช้งานผ่านทางเข้าจริงของ THUNDER87
        ที่ตรวจชื่อเว็บไซต์แล้วและเชื่อมต่อแบบ HTTPS เท่านั้น ไม่ใช่ลิงก์ที่ส่งต่อกันมาในแชตพร้อมคำโฆษณา เพราะลิงก์แบบนั้นมักพาไปเจออะไรจริง แค่ไม่ใช่ในทางที่เราหวัง
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
