---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

// JAICHUA: ticker หมุนมาเป็น AnnouncementPremium ให้ตรงกับทั้งเว็บ เรียก
// <Announcement /> เปล่า ๆ เพราะ default message ของ variant นี้ถูกตั้งให้ตรงกับ
// ข้อความที่หน้าแรกส่งเข้าไปแล้ว
//
// แบรนด์ก่อนหน้าเป็นเว็บหวย หน้านี้จึงเคยเป็นเรื่องคีย์โพย ตลาดหวย และงวด ซึ่ง
// ผิดแนวกับแบรนด์นี้ทั้งหน้า — เนื้อหารอบนี้เขียนใหม่จาก docx เป็นเรื่องทดลองเล่น
// สล็อตฟรีไม่ต้องสมัคร และกริดแบนเนอร์ค่ายเกมกลับเข้ามาเพราะแบรนด์นี้เป็นสล็อต
//
// สีย้ายจากน้ำเงินธงชาติคู่แดงของแบรนด์ก่อน มาเป็นทองคำคู่น้ำเงินรอยัลบนกรมท่า
// เกือบดำ — ทอง #fbeec9 / #f6d67e / #d8a83f / #a97722 คู่น้ำเงิน #cfe0fb /
// #5b8ede / #2f5fb0 บนผิว #040915 / #0a1226 เนื้อความ #dce6f8
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// One list, two consumers: the gallery below and the ItemList in the JSON-LD.
// They used to be two hand-kept arrays that had to stay in the same order, and
// the name shown to a reader could drift from the name handed to a crawler.
// The card shows the artwork only — the provider name is chrome, so it lives in
// the link's aria-label, never in a heading tag.
//
// alt describes the picture, not the brand: the artwork is the same on every
// rebrand (gamedemo7-18.webp เป็นชุดถาวรของเทมเพลต ลงวันที่ 2026-07-25 ไม่ใช่
// ของดรอปแบรนด์นี้) so an alt that names the site rots the moment the site is
// renamed. Three alts were re-checked against the actual files on 2026-08-29
// and were wrong — SBOBET's wordmark is white on black (not blue), Ask Me Bet's
// art is a Chinese lion-dance head (not cards and chips), and AFB Gaming's is a
// bearded god in front of a Greek temple (not neon). ชุด alt นี้จึงข้ามรีแบรนด์
// มาได้โดยไม่ต้องแก้ ต่างจากตัวบทความด้านล่างที่เขียนใหม่ทุกครั้ง
const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่ายเกม AskmeSlot โลโก้โพดำสีเหลืองข้างตัวการ์ตูนเด็กชายหมวกแดงบนถนนหมู่บ้านกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์รวมเกมยอดนิยม Popular Game ตัวอักษรทองข้างตัวการ์ตูนกระต่ายและแมวสวมแว่น ล้อมด้วยกองชิปและเหรียญทอง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่ายเกม SlotXO โลโก้ตู้สล็อตและเหรียญทองข้างภาพนักรบโรมันสวมมงกุฎใบลอเรลหน้าโคลอสเซียม" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่ายเกม Skywind Group โลโก้วงกลมสี่สีข้างแมวกวักญี่ปุ่นสีขาวคอกระพรวนทอง มีไหเงินและป้ายทองท่ามกลางดอกซากุระ" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่ายเกม PG Soft โลโก้พิกเซลตัวอักษร PG ข้างตัวละครหญิงนักรบสวมเครื่องประดับทองและหมวกขนนกสีสด" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET ตัวอักษรสีขาวบนพื้นดำ ข้างตัวละครหญิงผมบลอนด์มีหูจิ้งจอก สวมชุดกิโมโนสีชมพู ถือลูกอมเกลียวสีรุ้ง" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์ค่ายเกม Sexy Slot ตัวอักษรสีชมพูม่วงข้างภาพตัวละครหญิงในชุดรัดรูปสีน้ำเงินม่วงและสัญลักษณ์รูปหัวใจ" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรสีทองข้างตัวละครนางเงือกผมแดงถือหอยสังข์ใต้ทะเลพร้อมปลาการ์ตูน" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม Ask Me Bet โลโก้ตัวอักษรขาวเหลืองเขียวบนพื้นดำ ข้างหัวสิงโตเชิดจีนสีส้มแดงใต้โคมไฟแดง" },
  { name: "New Game", src: image10, alt: "แบนเนอร์เกมออกใหม่ New Game ตัวอักษรขาวบนฟลอร์นีออนสีสด ขนาบด้วยตัวการ์ตูนฟักทองสวมหมวกและโครงกระดูกยิ้ม" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรขาวทองข้างนักรบโรมันสวมหมวกขนนกและสิงโตคำรามในสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming โลโก้ตัวอักษรทองบนพื้นดำ ข้างเทพเจ้ากรีกเคราขาวสวมมงกุฎใบลอเรล ตาเปล่งแสงสีฟ้า หน้าวิหารเสาหินสีขาว" },
];

// The URL each entry resolves to is schema.ts's problem, not this file's — an
// older version pasted a hand-built page URL onto all 12 and got the trailing
// slash and the Thai encoding wrong on every one of them.
const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

// 150–160 CHARACTERS (ภาษาไทย 1 ตัวอักษร = 3 ไบต์ การนับไบต์จะยาวเกินจริงราวสามเท่า)
// บรรทัดนี้วัดได้ 157 และเป็นประโยคเดียวที่บอกว่าหน้านี้มีไว้ทำอะไร ไม่ใช่สารบัญของทั้งหน้า
const pageDescription =
  "หน้าทดลองเล่นสล็อตของ JAICHUA สำหรับเปิดดูหน้าจอเกมและฟีเจอร์ของค่ายดังฟรีก่อนลงเครดิตจริง ได้เห็นตัวคูณ ฟรีสปิน และค่า RTP ตรงสเปกโรงงานก่อนตัดสินใจเลือกเกม";

const pageTitle = "ทดลองเล่น JAICHUA | เปิดดูสล็อตค่ายดังฟรีก่อนลงเครดิตจริง";

// หัวข้อระดับ h1 ของหน้า แยกจากค่า title เพราะ title มีขีดคั่นแบรนด์อยู่
const pageHeading = "ทดลองเล่น JAICHUA เปิดดูสล็อตค่ายดังฟรีก่อนลงเครดิตจริง";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ค่ายเกมชั้นนำที่เปิดอยู่ในล็อบบี้ของ JAICHUA",
      alternateName: "JAICHUA โหมดทดลองเล่นสล็อตฟรีก่อนลงเครดิตจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});

// ชุดไล่สีของหัวข้อในหน้านี้ — ทองซีดผ่านทองอ่อนไปจบที่น้ำเงินรอยัลอ่อนของแบรนด์
// เขียนคลาสเต็มไว้ตรงนี้เพื่อให้ Tailwind สแกนเจอ (สแกนเป็นข้อความดิบ ไม่ได้
// ประเมิน template)
const headingClass = "bg-gradient-to-r from-[#fbeec9] via-[#f6d67e] to-[#5b8ede] bg-clip-text text-xl leading-normal font-bold text-transparent md:text-2xl";

// sizes บอกว่าภาพถูก "วาด" กว้างเท่าไหร่ ไม่ใช่อยากได้ไฟล์กว้างเท่าไหร่
// กริดเป็น grid-cols-2 จนถึง md: แล้วค่อยเป็น 4 คอลัมน์ ส่วน ContentBox
// มี px-4 (2rem) กับ p-8 (4rem) แล้วขยับเป็น p-10 (5rem) ที่ md: และการ์ดชนเพดาน
// max-w-[1400px] เมื่อ viewport กว้างตั้งแต่ 1432px ขึ้นไป
//   < 768px : 2 คอลัมน์ + gap-5 หนึ่งช่อง  → (100vw - 7.25rem) / 2
//   ≥ 768px : 4 คอลัมน์ + gap-5 สามช่อง   → (100vw - 10.75rem) / 4
//   ≥ 1432px: การ์ดชนเพดาน 1400px         → (1400 - 5rem - 3.75rem) / 4 = 315px
const galleryImageSizes = "(max-width: 767px) calc((100vw - 7.25rem) / 2), (max-width: 1431px) calc((100vw - 10.75rem) / 4), 315px";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <h2 class={`mb-6 ${headingClass}`}>หน้านี้ของ JAICHUA มีไว้ทำอะไร และควรดูอะไรก่อนเลือกเกม</h2>

      <p class="mb-8 text-left text-base leading-relaxed">
        โหมดทดลองของ <strong class="text-[#f6d67e]">JAICHUA</strong> มีไว้ให้เปิดเกมขึ้นมาดูฟรีก่อนลงเครดิตจริงแม้แต่บาทเดียว ไม่ต้องสมัคร ไม่ต้องเติมเงิน และไม่ต้องผูกอะไรไว้ล่วงหน้า
        ล็อบบี้ชุดที่วางไว้ในหน้านี้เป็นชุดเดียวกับที่เปิดให้เล่นจริง เพราะที่นี่เป็นสล็อตเว็บตรงที่ยิงตรงจาก<strong class="text-[#cfe0fb]">ระบบ API แท้ของคลังเกมหลัก</strong>โดยไม่ผ่านเอเย่นต์คั่นกลาง ทุกการหมุนจึงอยู่บนค่า RTP ที่ตรงตามสเปกโรงงานของตัวเกม ไม่มีการปรับลดเปอร์เซ็นต์ระหว่างทาง ชนะเท่าไหร่ถอนได้เท่านั้น
        ของที่เปิดอยู่ขนมาแบบยกค่าย ทั้ง PG Soft, Pragmatic Play และ Joker Gaming วางรวมไว้บนกระเป๋าเดียวกัน มีให้เลือกครบทั้งสล็อตวิดีโอ 3D ที่ภาพสวย สล็อตตัวคูณสะสม และสายซื้อฟีเจอร์ฟรีสปิน กดสลับเปลี่ยนอารมณ์ได้ทันทีโดยไม่ต้องวนอยู่แค่แนวเดิมให้เบื่อ
        ล็อบบี้ยังไม่หยุดอยู่แค่เกมเดิม รายชื่อเกมใหม่ถูกเติมเข้าคลังต่อเนื่องทันทีที่ค่ายผู้พัฒนาปล่อยตัวเกมออกมา จึงมีตัวสดให้กดค้นต่อเรื่อย ๆ และโหมดทดลองคือที่ที่ควรเอาไว้ลองของใหม่พวกนั้นก่อน
        สิ่งที่ควรใช้เวลากับมันจริง ๆ ระหว่างทดลองคือกลไกของเกมแต่ละตัว ว่าปุ่มปรับไลน์กับปุ่มปรับเดิมพันอยู่ตรงไหน ระบบสุ่มแจกตัวคูณ Multiplier ทบขึ้นจังหวะใด สัญลักษณ์ Expanding Wild ขยายกินพื้นที่รีลแค่ไหน คอมโบแตกต่อเนื่อง Cascading ไล่ต่อกันได้กี่ชั้น โหมดซื้อฟรีสปินกินทุนต่อครั้งเท่าไร และตารางอัตราจ่ายกดเปิดดูได้จากปุ่มไหน
        มากกว่าจะไล่กดดูว่าเกมไหนภาพสวยที่สุด ภาพสวยช่วยให้ปั่นเพลินขึ้นจริง แต่ไม่ได้ช่วยเจรจากับผลของรอบถัดไปเป็นการส่วนตัว
        ถือเป็นการอ่านคู่มือก่อนขับ ซึ่งน่าเบื่อกว่าการลองขับเลยอยู่แล้ว แต่ค่าซ่อมถูกกว่ากันเยอะ
      </p>

      <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[200, 400, 600]}
                sizes={galleryImageSizes}
                class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(22,39,78,0.45)] transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href="/register"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ JAICHUA`}
                class="absolute inset-0 flex items-center justify-center bg-[#040915]/72 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-full border border-[#fbeec9]/70 bg-gradient-to-r from-[#f6d67e] to-[#d8a83f] px-6 py-2 font-bold text-[#040915] shadow-[0_10px_30px_rgba(216,168,63,0.5)] transition-transform hover:scale-110">
                  เล่นเลย
                </span>
              </a>
            </div>
          ))
        }
      </div>

      <h2 class={`mt-8 mb-6 ${headingClass}`}>โหมดทดลองบอกอะไรได้ และบอกอะไรไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed">
        การเปิดดูก่อนบอกได้ว่าเกมทำงานอย่างไร วางไลน์ไว้กี่เส้น สัญลักษณ์ตัวไหนเป็นไวลด์ตัวไหนเป็นสแกตเตอร์ และรอบโบนัสหน้าตาเป็นแบบไหนตอนที่มันเข้ามาจริง
        บอกได้ด้วยว่าโครงสร้างการจ่ายรางวัลของเกมนั้นอ่านออกและ<strong class="text-[#cfe0fb]">ตรวจสอบย้อนกลับได้จริง</strong>หรือเปล่า ซึ่งเป็นเกณฑ์เดียวกับที่ใช้คัดเกมขึ้นล็อบบี้ตั้งแต่แรก คือเป็นเกมลิขสิทธิ์แท้จากค่ายผู้พัฒนาโดยตรง จ่ายตรงตามที่ค่ายกำหนด ฟีเจอร์เด่นชัด และตัวคูณสะสมทบขึ้นได้จริง
        บอกได้อีกอย่างว่าแนวไหนถูกจริตกับเรา ตั้งแต่สล็อตวิดีโอ 3D ที่อ่านง่ายและจบรอบเร็ว ไปจนถึงสายคอมโบแตกต่อเนื่องและสายซื้อฟีเจอร์ฟรีสปินที่ต้องรอสะสมให้ทบขึ้นหลายชั้น สลับลองดูรอบเดียวก็พอเห็นว่าเราเป็นสายค่อย ๆ สะสมหรือสายจบไว และเพราะล็อบบี้จัดหมวดหมู่ไว้ให้กดเข้าเกมได้ทันที การไล่ลองหลายตัวรวดเดียวจึงไม่กินเวลาอย่างที่คิด
        แต่สิ่งที่มันบอกไม่ได้เลยคือผลของรอบถัดไป เพราะแต่ละรอบตัดสินจากตัวสุ่มของค่ายในวินาทีนั้น และเป็นอิสระจากกันเสมอ ไม่ว่ารอบก่อนหน้าจะออกมาเป็นอะไร
        ค่า RTP ที่เกมประกาศไว้เป็นค่าเฉลี่ยระยะยาวตามสเปกโรงงานของตัวเกม ใช้ตัดสินใจว่าจะลงกับเกมไหนและวางเดิมพันเท่าไหร่ได้จริง แต่ไม่ใช่หลักฐานว่าเกมนั้นกำลังอารมณ์ดีรอเราอยู่
        หน้านี้มีไว้ศึกษาระบบ ไม่ได้มีไว้ดูดวงผ่านหน้าจอ
      </p>

      <p class="mb-4 text-left text-base leading-relaxed">
