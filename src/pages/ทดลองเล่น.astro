---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

// GUESS168: ticker เป็น AnnouncementPremium และกล่องเป็น ContentBox ให้ตรงกับทั้ง
// เว็บ เรียก <Announcement /> เปล่าๆ เพราะ default message ของ variant นี้เป็น
// ข้อความของแบรนด์นี้อยู่แล้ว
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// One list, two consumers: the gallery below and the ItemList in the JSON-LD.
// They used to be two hand-kept arrays that had to stay in the same order, and
// the name shown to a reader could drift from the name handed to a crawler.
// The card shows the artwork only — the provider name is chrome, so it lives in
// the link's aria-label, never in a heading tag.
//
// alt describes the picture, not the brand: the artwork is the same on every
// rebrand, so an alt that names the site rots the moment the site is renamed.
// Three alts were re-checked against the actual files on 2026-08-29 and were
// wrong — SBOBET's wordmark is white on black (not blue), Ask Me Bet's art is a
// Chinese lion-dance head (not cards and chips), and AFB Gaming's is a bearded
// god in front of a Greek temple (not neon).
const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่ายเกม AskmeSlot โลโก้โพดำสีเหลืองข้างตัวการ์ตูนเด็กชายหมวกแดงบนถนนหมู่บ้านกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์รวมเกมยอดนิยม Popular Game ตัวอักษรทองข้างตัวการ์ตูนกระต่ายและแมวสวมแว่น ล้อมด้วยกองชิปและเหรียญทอง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่ายเกม SlotXO โลโก้ตู้สล็อตและเหรียญทองข้างภาพนักรบโรมันสวมมงกุฎใบลอเรลหน้าโคลอสเซียม" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่ายเกม Skywind Group โลโก้วงกลมสี่สีข้างแมวกวักญี่ปุ่นสีขาวคอกระพรวนทอง มีไหเงินและป้ายทองท่ามกลางดอกซากุระ" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่ายเกม PG Soft โลโก้พิกเซลตัวอักษร PG ข้างตัวละครหญิงนักรบสวมเครื่องประดับทองและหมวกขนนกสีสด" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET ตัวอักษรสีขาวบนพื้นดำ ข้างตัวละครหญิงผมบลอนด์มีหูจิ้งจอก สวมชุดกิโมโนสีชมพู ถือลูกอมเกลียวสีรุ้ง" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์ค่ายเกม Sexy Slot ตัวอักษรสีชมพูม่วงข้างภาพตัวละครหญิงในชุดรัดรูปสีน้ำเงินม่วงและสัญลักษณ์รูปหัวใจ" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรสีทองข้างตัวละครนางเงือกผมแดงถือหอยสังข์ใต้ทะเลพร้อมปลาการ์ตูน" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม Ask Me Bet โลโก้ตัวอักษรขาวเหลืองเขียวบนพื้นดำ ข้างหัวสิงโตเชิดจีนสีส้มแดงใต้โคมไฟแดง" },
  { name: "New Game", src: image10, alt: "แบนเนอร์เกมออกใหม่ New Game ตัวอักษรขาวบนฟลอร์นีออนสีสด ขนาบด้วยตัวการ์ตูนฟักทองสวมหมวกและโครงกระดูกยิ้ม" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรขาวทองข้างนักรบโรมันสวมหมวกขนนกและสิงโตคำรามในสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming โลโก้ตัวอักษรทองบนพื้นดำ ข้างเทพเจ้ากรีกเคราขาวสวมมงกุฎใบลอเรล ตาเปล่งแสงสีฟ้า หน้าวิหารเสาหินสีขาว" },
];

// The URL each entry resolves to is schema.ts's problem, not this file's — an
// older version pasted a hand-built page URL onto all 12 and got the trailing
// slash and the Thai encoding wrong on every one of them.
const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

// 150–160 CHARACTERS (Thai is 3 bytes per character, so a byte count reads
// about three times too long and will send you rewriting a fine description).
// This one measures 157.
const pageDescription =
  "ทดลองเล่น GUESS168 เปิดโหมดทดลองฟรี เช็กจังหวะโบนัสและกลไกเกมก่อนลงเงินจริง ดูหน้าจอเกมค่าย PG Soft Pragmatic Play Joker Gaming ทั้ง Multiplier และ Bonus Buy";

const pageTitle = "ทดลองเล่น GUESS168 | โหมดทดลองฟรี เช็กจังหวะโบนัสก่อนลงเงินจริง";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "ทดลองเล่น GUESS168 เปิดโหมดทดลองฟรีก่อนลงเงินจริง";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ค่ายเกมชั้นนำที่เปิดอยู่ในคลังเกมของ GUESS168",
      alternateName: "GUESS168 โหมดทดลองเล่นฟรีก่อนเดิมพันด้วยเครดิตจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});

// ชุดไล่สีเดียวกับที่ ContentBox ใช้กับหัวข้อของตัวเอง — ครีมทองผ่านทองหลอมไปหาส้มไฟ
// เขียนคลาสเต็มไว้ตรงนี้เพื่อให้ Tailwind สแกนเจอ (สแกนเป็นข้อความดิบ ไม่ได้ประเมิน template)
const headingClass = "bg-gradient-to-r from-[#fff6e0] via-[#fecc02] to-[#fe9c01] bg-clip-text text-xl leading-normal font-bold text-transparent md:text-2xl";

// sizes บอกว่าภาพถูก "วาด" กว้างเท่าไหร่ ไม่ใช่อยากได้ไฟล์กว้างเท่าไหร่
// กริดเป็น grid-cols-2 จนถึง md: แล้วค่อยเป็น 4 คอลัมน์ ส่วน ContentBox
// มี px-4 (2rem) กับ p-8 (4rem) แล้วขยับเป็น p-10 (5rem) ที่ md: และการ์ดชนเพดาน
// max-w-[1400px] เมื่อ viewport กว้างตั้งแต่ 1432px ขึ้นไป
//   < 768px : 2 คอลัมน์ + gap-5 หนึ่งช่อง  → (100vw - 7.25rem) / 2
//   ≥ 768px : 4 คอลัมน์ + gap-5 สามช่อง   → (100vw - 10.75rem) / 4
//   ≥ 1432px: การ์ดชนเพดาน 1400px         → (1400 - 5rem - 3.75rem) / 4 = 315px
const galleryImageSizes = "(max-width: 767px) calc((100vw - 7.25rem) / 2), (max-width: 1431px) calc((100vw - 10.75rem) / 4), 315px";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <h2 class={`mb-6 ${headingClass}`}>หน้านี้ของ GUESS168 มีไว้ทำอะไร และควรดูอะไรก่อนเลือกเกม</h2>

      <p class="mb-8 text-left text-base leading-relaxed">
        โหมดทดลองเล่นฟรีของ GUESS168 มีไว้ให้เปิดเกมขึ้นมาหมุนดูก่อนที่จะลงเครดิตจริงแม้แต่บาทเดียว ไม่ต้องเติมเงินและไม่ต้องผูกอะไรไว้ล่วงหน้า
        คลังเกมที่คัดมาวางไว้ในหน้านี้เป็นชุดเดียวกับที่เปิดให้เล่นจริง คัดเฉพาะค่ายใหญ่มาตรฐานสากลอย่าง PG Soft, Pragmatic Play และ Joker Gaming ยิงตรงจากเซิร์ฟเวอร์หลักผ่าน API แท้
        แยกหมวดตามค่ายไว้ชัด กดสลับได้ในไม่กี่คลิกโดยไม่มีโฆษณามาบังและไม่มีเมนูซับซ้อนให้เสียอารมณ์
        สิ่งที่ควรใช้เวลากับมันจริงๆ ระหว่างทดลองคือจังหวะของเกมแต่ละตัว ว่าปุ่มปรับเดิมพันกับปุ่มหมุนอยู่ตรงไหน ตารางการจ่ายและสัญลักษณ์พิเศษเปิดดูได้จากปุ่มใด ฟีเจอร์โบนัสเข้าได้ด้วยเงื่อนไขแบบไหน
        และเดิมพันขั้นต่ำกับขั้นสูงห่างกันแค่ไหน มากกว่าไล่ดูว่าเกมไหนภาพสวยที่สุด งานภาพคมและเสียงประกอบดีช่วยให้เล่นเพลินขึ้นจริง แต่ไม่ได้ช่วยเจรจากับผลของสปินถัดไปเป็นการส่วนตัว
        ถือเป็นการอ่านคู่มือก่อนขับ ซึ่งน่าเบื่อกว่าการลองขับเลยอยู่แล้ว แต่ค่าซ่อมมันถูกกว่ากันเยอะ
      </p>

      <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[200, 400, 600]}
                sizes={galleryImageSizes}
                class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(197,138,0,0.3)] transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href="/register"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ GUESS168`}
                class="absolute inset-0 flex items-center justify-center bg-[#140800]/72 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-full border border-[#ffd54a]/70 bg-gradient-to-r from-[#fe9c01] to-[#a35800] px-6 py-2 font-bold text-[#fff6e0] shadow-[0_10px_30px_rgba(254,156,1,0.45)] transition-transform hover:scale-110">
                  เล่นเลย
                </span>
              </a>
            </div>
          ))
        }
      </div>

      <h2 class={`mt-8 mb-6 ${headingClass}`}>โหมดทดลองบอกอะไรได้ และบอกอะไรไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed">
        การหมุนดูก่อนบอกได้ว่าเกมทำงานอย่างไร ลูกเล่นที่ GUESS168 รวมไว้มีอะไรบ้าง และแต่ละแบบให้ความรู้สึกต่างกันตรงไหน ทั้ง Multiplier ที่สุ่มตัวคูณหนักและยิ่งเล่นยิ่งทบ ระบบ Wild ซ้อนทับที่เปลี่ยนหน้าตาของวงล้อไปทั้งแถว
        คอมโบ Cascading ที่สัญลักษณ์แตกแล้วร่วงลงมาแทนที่ให้แตกต่อเนื่อง และโหมด Bonus Buy สำหรับสายใจร้อนที่อยากพุ่งเข้ารอบฟรีสปินเลยโดยไม่รอจังหวะ ทดลองรอบเดียวก็พอเห็นว่าเกมแนวไหนถูกจริตกับเรา
        แต่สิ่งที่มันบอกไม่ได้เลยคือผลของสปินถัดไป เพราะทุกรอบตัดสินจากตัวสุ่มในวินาทีนั้น แต่ละสปินจึงเป็นอิสระจากกันเสมอ ไม่ว่ารอบก่อนหน้าจะออกมาเป็นอะไรก็ตาม
        ค่า RTP และรายละเอียดฟีเจอร์ที่แสดงไว้บนหน้าเกมมีประโยชน์จริงในแง่การเลือกความผันผวนให้เหมาะกับขนาดเงินทุนและวางจังหวะเข้าออก แต่มันไม่ใช่หลักฐานว่าเกมนั้นกำลังอารมณ์ดีรอเราอยู่
        หน้านี้มีไว้ศึกษาระบบ ไม่ใช่ไว้ดูดวงผ่านหน้าจอ
      </p>

      <p class="mb-4 text-left text-base leading-relaxed">
        อีกเรื่องที่ควรเผื่อใจคือไม่ได้มีเครดิตทดลองให้กดครบทุกเกมในคลัง บางค่ายเปิดให้เข้าไปดูหน้าจอเกมได้อย่างเดียวโดยยังไม่ให้ทดลองหมุน จึงควรเปิดรายละเอียดของเกมนั้นดูก่อนเลือก
        ส่วนยอดที่หมุนระหว่างทดลองไม่นับเป็นยอดของบัญชีหรือของโปรโมชันรายการใด ถ้าเกมที่อยากลองยังไม่เปิดให้ทดลองฟรี ให้ถือว่าวันนี้โชคไม่ดี ไม่ใช่สัญญาณลับที่ระบบส่งมาให้เราคนเดียว
        อีกอย่างที่การทดลองตามไม่ทันคือของใหม่ เพราะค่ายใหญ่ปล่อยเกมไหนออกมา GUESS168 ก็อัปเดตเข้าคลังให้ภายใน 24 ชั่วโมง ค่ายไหนเปิดตัวเกมนอกกระแสหรือฟีเจอร์แปลกใหม่ก็หยิบมาให้สมาชิกได้ลองเป็นกลุ่มแรก
        พร้อมกับไล่เก็บเกมที่กำลังฮิตติดลมบนเข้าลิสต์ไม่ให้ตกเทรนด์ บางเกมจึงขึ้นคลังก่อนแล้วค่อยมีข้อมูลประกอบตามมาทีหลัง ใช้จังหวะที่ทดลองอยู่สำรวจให้ครบก่อนตัดสินใจลงเงินจริงจะคุ้มกว่า
      </p>

      <h2 class={`mt-8 mb-6 ${headingClass}`}>จากโหมดทดลองไปเดิมพันจริงบน GUESS168 ควรเช็กอะไรก่อน</h2>

      <p class="mb-2 text-left text-base leading-relaxed">
        ถ้าจะขยับจากโหมดทดลองไปเดิมพันด้วยเครดิตจริง เรื่องที่ควรดูก่อนคือบัญชี งบต่อสปิน และลิงก์ที่ใช้เข้าเว็บ ด้านบัญชี เมื่อสมัครและผูกเบอร์มือถือกับบัญชีธนาคารเรียบร้อยแล้ว ก็ได้ยูสเซอร์เดียวไว้เข้าได้ทุกค่ายในคลัง
        อยากเปลี่ยนจากค่ายสายภาพสวยไปลุยค่ายสายโบนัสหนักกลางคืนเดียวก็สลับได้ทันทีในกระเป๋าเดียว ไม่ต้องโยกเงินข้ามค่ายไปมาให้ยุ่งยากและเสี่ยงต่อยอดตกค้าง ทุกอย่างทั้งเลือกเกม กดรับโปร และกดถอน อยู่บนแดชบอร์ดเดียว
        ควรเตรียมเบอร์โทรที่ใช้งานจริงและรับข้อความได้ ตั้งรหัสผ่านที่เดายากและไม่ใช้ซ้ำกับบัญชีอื่น แล้วตรวจชื่อบัญชีธนาคารกับข้อมูลสมาชิกให้ตรงกันก่อนยืนยัน เพราะระบบการเงินอ่านชื่อบัญชีเป็นหลัก
        สมัครเร็วเป็นเรื่องดี แต่กรอกผิดแล้วตามแก้ทีหลัง ความเร็วก็หายหมด ด้านงบ เบทเริ่มต้นที่นี่อยู่ที่ 1 บาท จึงตั้งยอดต่อสปินให้พอดีกับทุนที่ตั้งใจใช้ในวันนั้นได้ไม่ยาก แล้วดูเดิมพันขั้นต่ำของเกมกับยอดขั้นต่ำบนหน้าฝากแยกกันอีกครั้ง เพราะสองตัวเลขนั้นเป็นคนละเรื่องกัน
        ส่วนโปรโมชันของที่นี่จัดมาแบบถึงใจ ทั้งโบนัสต้อนรับเพิ่มทุนสปิน โปรฝากแรกของวัน และ Cash Back คืนยอดเสียทุกวันที่กดรับเองได้ผ่านหน้าเว็บ แต่ละรายการมีเพดานและรอบเวลาของตัวเอง จึงควรอ่านเงื่อนไขของสิทธิ์ที่จะกดรับให้จบก่อนกด
        เรื่องเวลารอเป็นส่วนที่ระบบออโต้จัดการให้แล้ว ทั้งการฝากเข้าคีย์ยอดและการถอนกำไรออกเข้าบัญชี ประมวลผลผ่าน Gateway ตรงเสร็จใน 3–5 วินาที ไม่ต้องส่งสลิปยืนยันและไม่ต้องรอแอดมินกดอนุมัติ ไร้เทิร์นโอเวอร์จุกจิก ปั่นได้เท่าไหร่ถอนออกได้ครบทุกบาท
        และไม่ว่าจะเปิดจากมือถือที่พกติดตัวหรือจากคอมที่แสดงผลเต็มจอ ระบบก็ปรับสเกลตามหน้าจอให้เอง เลือกอุปกรณ์ตามความถนัดได้เลย
        สุดท้ายควรเข้าใช้งานผ่านทางเข้าลิงก์ตรงของ GUESS168 ที่ตรวจชื่อเว็บไซต์แล้วและเชื่อมต่อแบบ HTTPS เท่านั้น ไม่ใช่ลิงก์ที่ส่งต่อกันมาในแชตพร้อมคำโฆษณา เพราะลิงก์แบบนั้นมักพาไปเจออะไรจริง แค่ไม่ใช่ในทางที่เราหวัง
