---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

// One list, two consumers: the gallery below and the ItemList in the JSON-LD.
// They used to be two hand-kept arrays that had to stay in the same order, and
// the name shown to a reader could drift from the name handed to a crawler.
// The card shows the artwork only — the provider name is chrome, so it lives in
// the link's aria-label, never in a heading tag.
//
// alt describes the picture, not the brand: the artwork is the same on every
// rebrand, so an alt that names the site rots the moment the site is renamed.
const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่ายเกม AskmeSlot โลโก้โพดำสีเหลืองข้างตัวการ์ตูนเด็กชายหมวกแดงบนถนนหมู่บ้านกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์รวมเกมยอดนิยม Popular Game พร้อมตัวการ์ตูนกระต่ายและแมว กองชิปและเหรียญทอง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่ายเกม SlotXO โลโก้ตู้สล็อตและเหรียญทองข้างภาพนักรบโรมันสวมมงกุฎใบลอเรลหน้าโคลอสเซียม" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่ายเกม Skywind Group โลโก้วงกลมสี่สีข้างแมวกวักญี่ปุ่นสีขาวท่ามกลางดอกซากุระและถุงทอง" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่ายเกม PG Soft โลโก้พิกเซลตัวอักษร PG ข้างตัวละครหญิงนักรบสวมเครื่องประดับทองและหมวกขนนกสีสด" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET ตัวอักษรสีน้ำเงินข้างตัวการ์ตูนถือลูกอมบนพื้นหลังโทนสว่าง" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์ค่ายเกม Sexy Slot ตัวอักษรสีชมพูข้างภาพตัวละครหญิงในชุดรัดรูปสีน้ำเงินและสัญลักษณ์รูปหัวใจ" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรสีทองข้างตัวละครนางเงือกผมแดงถือหอยสังข์ใต้ทะเลพร้อมปลาการ์ตูน" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม Ask Me Bet ตัวอักษรสีทองข้างไพ่ ลูกเต๋า และกองชิปคาสิโนบนโต๊ะเดิมพัน" },
  { name: "New Game", src: image10, alt: "แบนเนอร์เกมออกใหม่ New Game พร้อมตัวการ์ตูนฟักทองและโครงกระดูก" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรขาวทองข้างนักรบโรมันสวมหมวกขนนกและสิงโตคำรามในสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming โลโก้ตัวอักษร AFB บนพื้นหลังไฟนีออนโทนเข้ม" },
];

// The URL each entry resolves to is schema.ts's problem, not this file's — an
// older version pasted a hand-built page URL onto all 12 and got the trailing
// slash and the Thai encoding wrong on every one of them.
const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

// 150–160 CHARACTERS (Thai is 3 bytes per character, so a byte count reads
// about three times too long and will send you rewriting a fine description).
// This one measures 160.
const pageDescription =
  "ทดลองเล่นคาสิโนสด MAHAHENG333 ฟรี ไม่ต้องสมัคร ไม่ต้องฝาก เปิดดูโต๊ะบาคาร่า รูเล็ต เสือมังกร และไฮโลจากค่ายดังได้ทันที จับจังหวะวางเดิมพันให้ครบก่อนลงเครดิตจริง";

const pageHeading = "ทดลองเล่นคาสิโนสด MAHAHENG333 เปิดดูโต๊ะเกมสดจากค่ายดังฟรีก่อนลงเดิมพันจริง";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมคาสิโนสดจากค่ายชั้นนำในล็อบบี้ของ MAHAHENG333",
      alternateName: "MAHAHENG333 โหมดทดลองเล่นเกมคาสิโนสดบนมือถือก่อนเดิมพันด้วยเครดิตจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});

// ทองอ่อนไล่ไปหาทองเข้ม — ชุดเดียวกับที่ ContentBox ใช้กับหัวข้อของตัวเอง
const headingClass = "bg-gradient-to-r from-[#ffe98a] via-[#e8b923] to-[#a5760a] bg-clip-text text-2xl leading-normal font-bold text-transparent";

// sizes บอกว่าภาพถูก "วาด" กว้างเท่าไหร่ ไม่ใช่อยากได้ไฟล์กว้างเท่าไหร่
// กริดเป็น grid-cols-2 จนถึง md: แล้วค่อยเป็น 4 คอลัมน์ ส่วน ContentBox มี
// px-4 + p-8 (รวม 6rem) และขยับเป็น p-10 ที่ md: (รวม 7rem) พร้อม max-w-[1400px]
//   < 768px : 2 คอลัมน์ + gap-5 หนึ่งช่อง  → (100vw - 7.25rem) / 2
//   ≥ 768px : 4 คอลัมน์ + gap-5 สามช่อง   → (100vw - 10.75rem) / 4
//   ≥ 1432px: การ์ดชนเพดาน 1400px         → (1400 - 5rem - 3.75rem) / 4 = 315px
const galleryImageSizes = "(max-width: 767px) calc((100vw - 7.25rem) / 2), (max-width: 1431px) calc((100vw - 10.75rem) / 4), 315px";
---

<MainLayout title="ทดลองเล่น MAHAHENG333 รวมค่ายเกมสดชั้นนำไว้ล็อบบี้เดียว ลองฟรีก่อนเดิมพันจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <h2 class={`mb-6 ${headingClass}`}>โหมดทดลองของ MAHAHENG333 มีไว้ทำอะไร และควรดูอะไรก่อนเลือกโต๊ะ</h2>

      <p class="mb-8 text-left text-base leading-relaxed">
        MAHAHENG333 คัดสรรเฉพาะค่ายเกมสดชื่อดังระดับโลกมารวบรวมไว้ในล็อบบี้เดียว ทั้งบาคาร่าที่เปิดโต๊ะไว้หลายห้อง รูเล็ตที่ลุ้นวงล้อกันสด ๆ ไปจนถึงเสือมังกรและไฮโลที่ตัดสินไว
        ไม่ต้องโยกเงินหรือสลับเว็บไปมาให้เสียเวลา อยากเปลี่ยนฟีลเมื่อไหร่ก็กดเลือกห้องใหม่ในล็อบบี้ได้ทันที
        หน้านี้มีไว้ให้เปิดดูก่อนว่าหน้าโต๊ะเดิมพันหน้าตาเป็นแบบไหน ช่องวางชิปอยู่ตรงไหน สถิติย้อนหลังกับเค้าไพ่อ่านจากตรงไหน และหนึ่งตาใช้เวลานับถอยหลังแค่ไหน
        โดยยังไม่ต้องเติมเครดิตจริงและไม่มีการได้เสียเกิดขึ้นแม้แต่บาทเดียว สิ่งที่ควรดูจริงคือเดิมพันขั้นต่ำต่อตาของแต่ละห้อง จังหวะการนับเวลาของโต๊ะ และรูปแบบการจ่ายของแต่ละช่องเดิมพัน
        มากกว่าดูว่าโต๊ะไหนกำลังคนแน่นที่สุด โต๊ะคนเยอะช่วยให้บรรยากาศสนุกขึ้น แต่ไม่ได้ช่วยเจรจากับไพ่ที่กำลังจะเปิดเป็นการส่วนตัว ถือเป็นการอ่านคู่มือก่อนขับ ซึ่งน่าเบื่อกว่าการลองขับเลยอยู่แล้ว แต่ค่าซ่อมมันถูกกว่ากันเยอะ
      </p>

      <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[200, 400, 600]}
                sizes={galleryImageSizes}
                class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(232,185,35,0.30)] transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href="/register"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ MAHAHENG333`}
                class="absolute inset-0 flex items-center justify-center bg-[#0a0704]/72 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-full border border-[#ffe98a]/70 bg-gradient-to-r from-[#e8b923] to-[#a5760a] px-6 py-2 font-bold text-[#0a0704] shadow-[0_10px_30px_rgba(232,185,35,0.45)] transition-transform hover:scale-110">เล่นเลย</span>
              </a>
            </div>
          ))
        }
      </div>

      <h2 class={`mt-8 mb-6 ${headingClass}`}>โหมดทดลองบอกอะไรได้ และบอกอะไรไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed">
        โหมดทดลองบอกได้ว่าโต๊ะทำงานอย่างไร ปุ่มวางเดิมพันอยู่ตรงไหน ช่องเสือ ช่องมังกร ช่องเสมอ หรือช่องเลขคู่คี่ของไฮโลแยกกันตรงไหน ตารางเค้าไพ่อ่านอย่างไร และหนึ่งตาใช้เวลาเท่าไร
        แต่เครดิตในโหมดนี้เป็นยอดสมมติ ถอนไม่ได้ และผลที่ออกมาก็ไม่ได้บอกว่าเดิมพันจริงจะได้ผลเหมือนกัน เพราะโต๊ะสดแต่ละห้องเดินด้วยไพ่และลูกเต๋าจริงที่ดีลเลอร์เปิดสด ๆ หน้ากล้อง
        ผลของแต่ละตาจึงเป็นอิสระจากกันเสมอ สถิติย้อนหลังของโต๊ะ ตารางเค้าไพ่ และอัตราจ่ายของแต่ละช่องที่ MAHAHENG333 แสดงไว้ให้ เป็นสิ่งที่ดูรูปแบบได้จากโหมดทดลอง
        แต่ไม่ใช่หลักฐานว่าโต๊ะนั้นกำลังอารมณ์ดีรอเราอยู่ โหมดนี้มีไว้ศึกษาระบบ ไม่ใช่ไว้ดูดวงผ่านหน้าจอ
      </p>

      <p class="mb-4 text-left text-base leading-relaxed">
        อีกเรื่องที่ควรเผื่อใจคือโหมดทดลองไม่ได้มีให้ครบทุกโต๊ะ เพราะห้องที่ถ่ายทอดสดจริงบางห้องเปิดให้เข้าดูได้อย่างเดียวโดยไม่มีเครดิตทดลองให้กด จึงควรเปิดรายละเอียดของห้องดูก่อนเลือก
        และยอดที่วางในโหมดทดลองไม่นับเป็นยอดเทิร์นของบัญชีหรือของโปรโมชั่นใด ถ้าห้องที่อยากลองไม่มีปุ่มทดลอง ให้ถือว่าวันนี้โชคไม่ดี ไม่ใช่สัญญาณลับที่ระบบส่งมาให้เราคนเดียว
        อีกอย่างที่โหมดทดลองตามไม่ทันคือโต๊ะที่เพิ่งเปิดใหม่ เพราะล็อบบี้ของ MAHAHENG333 มีห้องใหม่ทยอยเข้ามาเสมอ บางห้องจึงเปิดให้เดิมพันด้วยเครดิตจริงก่อนแล้วค่อยมีโหมดทดลองตามมาทีหลัง
        และเมื่อระบบสลับโต๊ะได้ลื่นไหลแทบจะทันทีที่กด การไล่เปิดดูหลายห้องรวดเดียวจึงเสียเวลาน้อยกว่าเดิมมาก ใช้จังหวะนั้นสำรวจให้ครบก่อนตัดสินใจลงเงินจริงจะคุ้มกว่า
      </p>

      <h2 class={`mt-8 mb-6 ${headingClass}`}>จากโหมดทดลองไปเดิมพันจริงบน MAHAHENG333 ควรเช็กอะไรก่อน</h2>

      <p class="mb-2 text-left text-base leading-relaxed">
        ถ้าจะขยับจากโหมดทดลองไปเดิมพันด้วยเครดิตจริง เรื่องที่ควรดูก่อนคือบัญชี งบต่อตา และลิงก์ที่ใช้เข้าเว็บ ด้านบัญชี ขั้นตอนสมัครของที่นี่ใช้เวลาไม่ถึงหนึ่งนาที
        ผูกเบอร์มือถือกับบัญชีธนาคารหรือทรูวอลเล็ทให้เรียบร้อยก็ได้ยูสเซอร์เดียวไปสลับเข้าโต๊ะได้ทุกค่ายในล็อบบี้ โดยไม่ต้องเปลี่ยนยูสเซอร์หรือกดออกจากระบบให้เสียจังหวะ
        ควรเตรียมเบอร์โทรที่ใช้งานจริงและรับข้อความได้ ตั้งรหัสผ่านที่เดายากและไม่ใช้ซ้ำกับบัญชีอื่น แล้วตรวจชื่อบัญชีธนาคารกับข้อมูลสมาชิกให้ตรงกันก่อนยืนยัน
        เพราะระบบการเงินอ่านชื่อบัญชีเป็นหลัก สมัครเร็วเป็นเรื่องดี แต่กรอกผิดแล้วตามแก้ทีหลัง ความเร็วก็หายหมด ด้านงบ ควรตั้งเดิมพันต่อตาให้พอดีกับยอดที่ตั้งใจใช้ในวันนั้น
        แล้วดูยอดบนหน้าฝากและขั้นต่ำของห้องแยกกันอีกครั้ง เพราะเดิมพันขั้นต่ำของโต๊ะกับเงื่อนไขของการฝากถอนเป็นคนละตัวเลขกัน ส่วนเรื่องเงิน ระบบฝากถอนของที่นี่เป็นออโต้เต็มรูปแบบและจบภายใน 5 วินาที
        ทำรายการเองได้ผ่านหน้าเว็บโดยไม่ต้องส่งสลิปและไม่ต้องรอแอดมิน ยอดเล็กหลักร้อยหรือยอดใหญ่หลักแสนก็เคลียร์ให้ไวเหมือนกัน และย้อนดูประวัติรายการของตัวเองได้ตลอด
        สุดท้ายควรเข้าใช้งานผ่านทางเข้าจริงของ MAHAHENG333 ที่ตรวจชื่อเว็บไซต์แล้วและเชื่อมต่อแบบ HTTPS เท่านั้น ไม่ใช่ลิงก์ที่ส่งต่อกันมาในแชตพร้อมคำโฆษณา เพราะลิงก์แบบนั้นมักพาไปเจออะไรจริง แค่ไม่ใช่ในทางที่เราหวัง
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
