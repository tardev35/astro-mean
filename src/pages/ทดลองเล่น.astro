---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

// ASHTON168: ticker เป็น AnnouncementPremium ให้ตรงกับทั้งเว็บ เรียก <Announcement />
// เปล่าๆ เพราะ default message ของ variant นี้เป็นข้อความ ASHTON168 อยู่แล้ว
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// One list, two consumers: the gallery below and the ItemList in the JSON-LD.
// They used to be two hand-kept arrays that had to stay in the same order, and
// the name shown to a reader could drift from the name handed to a crawler.
// The card shows the artwork only — the provider name is chrome, so it lives in
// the link's aria-label, never in a heading tag.
//
// alt describes the picture, not the brand: the artwork is the same on every
// rebrand, so an alt that names the site rots the moment the site is renamed.
const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่ายเกม AskmeSlot โลโก้โพดำสีเหลืองข้างตัวการ์ตูนเด็กชายหมวกแดงบนถนนหมู่บ้านกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์รวมเกมยอดนิยม Popular Game พร้อมตัวการ์ตูนกระต่ายและแมว กองชิปและเหรียญทอง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่ายเกม SlotXO โลโก้ตู้สล็อตและเหรียญทองข้างภาพนักรบโรมันสวมมงกุฎใบลอเรลหน้าโคลอสเซียม" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่ายเกม Skywind Group โลโก้วงกลมสี่สีข้างแมวกวักญี่ปุ่นสีขาวท่ามกลางดอกซากุระและถุงทอง" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่ายเกม PG Soft โลโก้พิกเซลตัวอักษร PG ข้างตัวละครหญิงนักรบสวมเครื่องประดับทองและหมวกขนนกสีสด" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET ตัวอักษรสีน้ำเงินข้างตัวการ์ตูนถือลูกอมบนพื้นหลังโทนสว่าง" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์ค่ายเกม Sexy Slot ตัวอักษรสีชมพูข้างภาพตัวละครหญิงในชุดรัดรูปสีน้ำเงินและสัญลักษณ์รูปหัวใจ" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรสีทองข้างตัวละครนางเงือกผมแดงถือหอยสังข์ใต้ทะเลพร้อมปลาการ์ตูน" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม Ask Me Bet ตัวอักษรสีทองข้างไพ่ ลูกเต๋า และกองชิปคาสิโนบนโต๊ะเดิมพัน" },
  { name: "New Game", src: image10, alt: "แบนเนอร์เกมออกใหม่ New Game พร้อมตัวการ์ตูนฟักทองและโครงกระดูก" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรขาวทองข้างนักรบโรมันสวมหมวกขนนกและสิงโตคำรามในสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming โลโก้ตัวอักษร AFB บนพื้นหลังไฟนีออนโทนเข้ม" },
];

// The URL each entry resolves to is schema.ts's problem, not this file's — an
// older version pasted a hand-built page URL onto all 12 and got the trailing
// slash and the Thai encoding wrong on every one of them.
const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

// 150–160 CHARACTERS (Thai is 3 bytes per character, so a byte count reads
// about three times too long and will send you rewriting a fine description).
// This one measures 157.
const pageDescription =
  "ทดลองเล่น ASHTON168 เปิดดูล็อบบี้สล็อตค่ายชั้นนำก่อนลงเดิมพันจริง ดูหน้าจอเกม สัญลักษณ์พิเศษ และตารางการจ่ายให้คุ้นมือ ระบบเชื่อมตรงค่ายดัง รันลื่นไม่มีสะดุด";

const pageTitle = "ทดลองเล่น ASHTON168 | เปิดดูล็อบบี้สล็อตค่ายชั้นนำก่อนเดิมพัน";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "ทดลองเล่น ASHTON168 เปิดดูล็อบบี้เกมค่ายชั้นนำก่อนลงเดิมพันจริง";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ค่ายเกมชั้นนำที่เปิดอยู่ในล็อบบี้ของ ASHTON168",
      alternateName: "ASHTON168 โหมดเปิดดูค่ายเกมสล็อตก่อนเดิมพันด้วยเครดิตจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});

// ชุดไล่สีเดียวกับที่ ContentBoxPremium ใช้กับหัวข้อของตัวเอง — ไอวอรีผ่านทองสว่างไปหาเงินโครเมียม
// เขียนคลาสเต็มไว้ตรงนี้เพื่อให้ Tailwind สแกนเจอ (สแกนเป็นข้อความดิบ ไม่ได้ประเมิน template)
const headingClass = "bg-gradient-to-r from-[#fdf6e6] via-[#ffd75e] to-[#e2e5e9] bg-clip-text text-xl leading-normal font-bold text-transparent md:text-2xl";

// sizes บอกว่าภาพถูก "วาด" กว้างเท่าไหร่ ไม่ใช่อยากได้ไฟล์กว้างเท่าไหร่
// กริดเป็น grid-cols-2 จนถึง md: แล้วค่อยเป็น 4 คอลัมน์ ส่วน ContentBoxPremium
// มี px-4 (2rem) คงที่ และ p-8 (4rem) ที่ขยับเป็น md:p-10 (5rem) ตั้งแต่ 768px
// เพดานการ์ดอยู่ที่ max-w-[1400px] ซึ่งจะชนเมื่อ viewport กว้างตั้งแต่ 1432px ขึ้นไป
//   < 768px : 2 คอลัมน์ + gap-5 หนึ่งช่อง  → (100vw - 7.25rem) / 2
//   ≥ 768px : 4 คอลัมน์ + gap-5 สามช่อง   → (100vw - 10.75rem) / 4
//   ≥ 1432px: การ์ดชนเพดาน 1400px         → (1400 - 5rem - 3.75rem) / 4 = 315px
const galleryImageSizes = "(max-width: 767px) calc((100vw - 7.25rem) / 2), (max-width: 1431px) calc((100vw - 10.75rem) / 4), 315px";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <h2 class={`mb-6 ${headingClass}`}>หน้านี้ของ ASHTON168 มีไว้ทำอะไร และควรดูอะไรก่อนเลือกเกม</h2>

      <p class="mb-8 text-left text-base leading-relaxed">
        ล็อบบี้ของ ASHTON168 รวมเกมสล็อตตัวตึงจากค่ายชั้นนำระดับโลกไว้ในที่เดียว โดยเชื่อมตรงเข้าเซิร์ฟเวอร์หลักของค่ายนั้น อัตราการจ่ายที่แสดงบนหน้าเกมจึงเป็นสเปกจริงของค่าย ไม่ได้ถูกปรับใหม่ระหว่างทาง
        และเพราะโครงสร้างระบบหลังบ้านวางมาให้รันได้แน่น การไล่เปิดดูหลายเกมรวดเดียวจึงเสียเวลาน้อยกว่าที่คิด หน้านี้จึงมีไว้ให้เปิดดูก่อนว่าแต่ละค่ายเสิร์ฟเกมแนวไหน
        หน้าจอเกมจริงหน้าตาเป็นแบบไหน ปุ่มปรับเดิมพันกับปุ่มหมุนอยู่ตรงไหน ตารางการจ่ายกับสัญลักษณ์พิเศษเปิดดูได้จากปุ่มใด และฟีเจอร์โบนัสของเกมนั้นเข้าได้ด้วยเงื่อนไขแบบไหน
        โดยยังไม่ต้องเติมเครดิตจริงและไม่มีการได้เสียเกิดขึ้นแม้แต่บาทเดียว สิ่งที่ควรดูจริงคือเดิมพันขั้นต่ำและขั้นสูงของแต่ละเกม รูปแบบการจ่ายของแต่ละไลน์
        และจังหวะของเกมว่ารอบสั้นหรือยาวพอดีกับที่เราถนัดหรือเปล่า มากกว่าดูว่าเกมไหนภาพสวยที่สุด งานภาพ 3D คมชัดกับเสียงประกอบตื่นเต้นช่วยให้เล่นเพลินขึ้นจริง
        แต่ไม่ได้ช่วยเจรจากับผลของสปินถัดไปเป็นการส่วนตัว ถือเป็นการอ่านคู่มือก่อนขับ ซึ่งน่าเบื่อกว่าการลองขับเลยอยู่แล้ว แต่ค่าซ่อมมันถูกกว่ากันเยอะ
      </p>

      <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[200, 400, 600]}
                sizes={galleryImageSizes}
                class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(200,148,26,0.3)] transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href="/register"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ ASHTON168`}
                class="absolute inset-0 flex items-center justify-center bg-[#080502]/72 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-full border border-[#ffe9a3]/70 bg-gradient-to-r from-[#f5c518] to-[#c8941a] px-6 py-2 font-bold text-[#080502] shadow-[0_10px_30px_rgba(245,197,24,0.45)] transition-transform hover:scale-110">
                  เล่นเลย
                </span>
              </a>
            </div>
          ))
        }
      </div>

      <h2 class={`mt-8 mb-6 ${headingClass}`}>การเปิดดูก่อนลงเงินบอกอะไรได้ และบอกอะไรไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed">
        การเปิดดูก่อนบอกได้ว่าเกมทำงานอย่างไร ปุ่มปรับเดิมพันกับปุ่มออโต้สปินอยู่ตรงไหน ฟีเจอร์ฟรีสปินเข้าด้วยสัญลักษณ์กี่ตัว และสล็อตแต่ละตัวมีสัญลักษณ์พิเศษหน้าตาเป็นอย่างไร
        แต่สิ่งที่มันบอกไม่ได้เลยคือผลของสปินถัดไป เพราะทุกรอบตัดสินจากตัวสุ่มในวินาทีนั้น แต่ละสปินจึงเป็นอิสระจากกันเสมอ ไม่ว่ารอบก่อนหน้าจะออกมาเป็นอะไรก็ตาม
        และเพราะ ASHTON168 เชื่อมตรงเข้าเซิร์ฟเวอร์หลักของค่ายโดยไม่มีชั้นกลางมาคั่น อัตราการจ่ายจึงไม่ถูกปรับระหว่างทาง ผลที่ออกเป็นผลของค่ายล้วนๆ ซึ่งแปลว่าไม่มีใครรู้ล่วงหน้าจริงๆ รวมถึงตัวเว็บเอง
        ค่าอัตราการจ่ายและรายละเอียดฟีเจอร์ที่แสดงไว้ชัดเจนบนหน้าเกมมีประโยชน์จริงในแง่การเลือกความผันผวนให้เหมาะกับขนาดเงินทุนและวางจังหวะเข้าออก และเราตั้งใจเลือกค่ายที่แสดงมันให้ชัดด้วยเหตุผลนั้น
        แต่มันไม่ใช่หลักฐานว่าเกมนั้นกำลังอารมณ์ดีรอเราอยู่ หน้านี้มีไว้ศึกษาระบบ ไม่ใช่ไว้ดูดวงผ่านหน้าจอ
      </p>

      <p class="mb-4 text-left text-base leading-relaxed">
        อีกเรื่องที่ควรเผื่อใจคือไม่ได้มีเครดิตทดลองให้กดครบทุกเกมในล็อบบี้ บางค่ายเปิดให้เข้าไปดูหน้าจอเกมได้อย่างเดียวโดยยังไม่ให้ทดลองหมุน
        จึงควรเปิดรายละเอียดของเกมนั้นดูก่อนเลือก ส่วนยอดที่หมุนระหว่างทดลองไม่นับเป็นยอดของบัญชีหรือของโปรโมชันรายการใด ถ้าเกมที่อยากลองยังไม่เปิดให้ดูฟรี ให้ถือว่าวันนี้โชคไม่ดี ไม่ใช่สัญญาณลับที่ระบบส่งมาให้เราคนเดียว
        อีกอย่างที่การเปิดดูตามไม่ทันคือเกมที่เพิ่งเข้าใหม่ เพราะทีมงาน ASHTON168 หมุนเวียนเกมใหม่เข้าล็อบบี้ต่อเนื่อง ทั้งค่ายสายภาพสวย 3D ค่ายสายแตกโหดตัวคูณเยอะ ไปจนถึงค่ายยอดนิยมตลอดกาล
        บางเกมจึงขึ้นล็อบบี้ก่อนแล้วค่อยมีข้อมูลประกอบตามมาทีหลัง
        ข้อดีคือระบบที่นี่รันได้สมูธไม่กระตุกไม่ค้างแม้ช่วงที่คนเข้าใช้งานพร้อมกันเยอะ ล็อบบี้ยังจัดหมวดหมู่ไว้แยกตามประเภทและค่ายเกม กดสลับได้ทันทีเพียงไม่กี่คลิกโดยไม่ต้องค้นวนหลายรอบ ใช้จังหวะนั้นสำรวจให้ครบก่อนตัดสินใจลงเงินจริงจะคุ้มกว่า
      </p>

      <h2 class={`mt-8 mb-6 ${headingClass}`}>จากการเปิดดูไปเดิมพันจริงบน ASHTON168 ควรเช็กอะไรก่อน</h2>

      <p class="mb-2 text-left text-base leading-relaxed">
        ถ้าจะขยับจากการเปิดดูไปเดิมพันด้วยเครดิตจริง เรื่องที่ควรดูก่อนคือบัญชี งบต่อสปิน และลิงก์ที่ใช้เข้าเว็บ ด้านบัญชี เมื่อสมัครและผูกเบอร์มือถือกับบัญชีธนาคารเรียบร้อยแล้ว
        ก็ได้ยูสเซอร์เดียวไว้เข้าได้ทุกค่ายในล็อบบี้ จะสลับจากเกมสล็อตค่ายหนึ่งไปลองอีกค่ายในคืนเดียวกันก็ทำได้ทันที เพราะกระเป๋าเงินใบเดียวใช้ได้กับทุกค่าย ไม่ต้องกดโยกเงินไปมาให้เสียเวลาหรือเสี่ยงต่อยอดเงินตกค้าง
        ควรเตรียมเบอร์โทรที่ใช้งานจริงและรับข้อความได้ ตั้งรหัสผ่านที่เดายากและไม่ใช้ซ้ำกับบัญชีอื่น แล้วตรวจชื่อบัญชีธนาคารกับข้อมูลสมาชิกให้ตรงกันก่อนยืนยัน เพราะระบบการเงินอ่านชื่อบัญชีเป็นหลัก
        สมัครเร็วเป็นเรื่องดี แต่กรอกผิดแล้วตามแก้ทีหลัง ความเร็วก็หายหมด ด้านงบ ควรตั้งยอดต่อสปินให้พอดีกับทุนที่ตั้งใจใช้ในวันนั้น แล้วดูเดิมพันขั้นต่ำของเกมกับยอดขั้นต่ำบนหน้าฝากแยกกันอีกครั้ง
        เพราะสองตัวเลขนั้นเป็นคนละเรื่องกัน ข้อดีของที่นี่คือเมนูสำคัญอย่างปุ่มฝากถอน คลังเกม ค่ายเกม และหน้ากิจกรรม ถูกวางไว้เป็นระเบียบให้กดหยิบใช้ได้ทันที ไม่ต้องคลิกวนหาหลายชั้นให้เสียจังหวะ
        ด้านการเงิน ระบบฝากถอนออโต้ทำงานตลอด 24 ชั่วโมง ยอดเข้าบัญชีในไม่กี่วินาทีโดยไม่ต้องส่งสลิปและไม่ต้องรอแอดมินอนุมัติ ส่วนโปรโมชั่นแต่ละรายการมีเงื่อนไขและรอบเวลาของตัวเอง จึงควรอ่านเพดานกับเงื่อนไขของสิทธิ์ที่จะกดรับให้จบก่อนกด
        สุดท้ายควรเข้าใช้งานผ่านทางเข้าลิงก์ตรงของ ASHTON168 ที่ตรวจชื่อเว็บไซต์แล้วและเชื่อมต่อแบบ HTTPS เท่านั้น ไม่ใช่ลิงก์ที่ส่งต่อกันมาในแชตพร้อมคำโฆษณา เพราะลิงก์แบบนั้นมักพาไปเจออะไรจริง แค่ไม่ใช่ในทางที่เราหวัง
      </p>
