---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

// 9KPLUS: ticker หมุนมาเป็น Announcement3 ให้ตรงกับทั้งเว็บ เรียก <Announcement />
// เปล่า ๆ เพราะ default message ของ variant นี้ถูกตั้งให้ตรงกับข้อความที่หน้าแรก
// ส่งเข้าไปแล้ว
//
// หน้านี้เป็นบทความจริง จึงเก็บ h2 ไว้สามหัวข้อ ต่างจาก promotion / ทางเข้า /
// contact-us ที่เป็นหน้าปุ่มและต้องมี h2 เป็นศูนย์ เนื้อความรอบนี้เขียนใหม่จาก
// brief ของแบรนด์นี้ทั้งหมด — ข้อเท็จจริงที่อ้างได้มีเท่าที่ brief ให้ไว้เท่านั้น
// (เว็บตรง API แท้ ยิงตรงจากเซิร์ฟนอก ปรับระบบตรงสเปกโรงงาน · ค่า RTP ยุติธรรม
// ไม่ล็อกยูส ไม่ปรับเปอร์เซ็นต์ชนะ · ดีไซน์หน้าเว็บและคลังเกมให้เข้าถึงง่าย
// รองรับสายงบน้อย สายเบทใหญ่ และสายตามล่าแจ็คพอต · กระเป๋าเดียว · PG Soft /
// Pragmatic Play / Joker Gaming · อัปเดตคลังเกมใหม่ต่อเนื่อง ได้ลองฟีเจอร์ใหม่
// ก่อนใคร · Multipliers / Expanding Wild / Cascading / Bonus Buy · ออโต้ไฮสปีด
// ผ่าน Gateway ตรง 3 วินาที ไม่ต้องแนบสลิป ไม่ต้องรอแอดมินอนุมัติ · ถอนได้เต็ม
// ทุกบาท · โบนัสต้อนรับ / ฝากแรกของวัน / Cash Back ทุกวัน ไม่ติดเทิร์นโอเวอร์
// มหาโหด) ห้ามเติมใบอนุญาต จำนวนสมาชิก มาตรฐาน SSL ค่ายเกมนอกสามค่ายข้างบน หรือ
// หมวดคาสิโนสด กีฬา หวย เข้ามาเอง แบรนด์นี้เป็นสล็อตล้วน
//
// สีย้ายจากฟ้าอะซูร์คู่ทองส้มบนกรมท่าเข้มของแบรนด์ก่อน มาเป็นแดงนีออนคู่ชมพู
// บานเย็นบนพื้นเกือบดำ — ชมพูขาว #ffd8e7 / #ff4a74 / #ff4fa3 / #f5003e / #b3022c /
// #7c1040 บนผิว #120309 / #1f0611 / #4d012c เนื้อความ #ffe3ee
// วอลเปเปอร์รอบนี้เป็นพื้นเกือบดำลายวงจรแดงเข้ม การ์ดจึงเป็นแดงเลือดหมูเข้มลอยอยู่ข้างบน
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// One list, two consumers: the gallery below and the ItemList in the JSON-LD.
// They used to be two hand-kept arrays that had to stay in the same order, and
// the name shown to a reader could drift from the name handed to a crawler.
// The card shows the artwork only — the provider name is chrome, so it lives in
// the link's aria-label, never in a heading tag.
//
// alt describes the picture, not the brand: the artwork is the same on every
// rebrand (gamedemo7-18.webp เป็นชุดถาวรของเทมเพลต ลงวันที่ 2026-07-25 ไม่ใช่
// ของดรอปแบรนด์นี้) so an alt that names the site rots the moment the site is
// renamed. Three alts were re-checked against the actual files on 2026-08-29
// and were wrong — SBOBET's wordmark is white on black (not blue), Ask Me Bet's
// art is a Chinese lion-dance head (not cards and chips), and AFB Gaming's is a
// bearded god in front of a Greek temple (not neon). ชุด alt นี้จึงข้ามรีแบรนด์
// มาได้โดยไม่ต้องแก้ ต่างจากตัวบทความด้านล่างที่เขียนใหม่ทุกครั้ง
const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่ายเกม AskmeSlot โลโก้โพดำสีเหลืองข้างตัวการ์ตูนเด็กชายหมวกแดงบนถนนหมู่บ้านกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์รวมเกมยอดนิยม Popular Game ตัวอักษรทองข้างตัวการ์ตูนกระต่ายและแมวสวมแว่น ล้อมด้วยกองชิปและเหรียญทอง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่ายเกม SlotXO โลโก้ตู้สล็อตและเหรียญทองข้างภาพนักรบโรมันสวมมงกุฎใบลอเรลหน้าโคลอสเซียม" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่ายเกม Skywind Group โลโก้วงกลมสี่สีข้างแมวกวักญี่ปุ่นสีขาวคอกระพรวนทอง มีไหเงินและป้ายทองท่ามกลางดอกซากุระ" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่ายเกม PG Soft โลโก้พิกเซลตัวอักษร PG ข้างตัวละครหญิงนักรบสวมเครื่องประดับทองและหมวกขนนกสีสด" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET ตัวอักษรสีขาวบนพื้นดำ ข้างตัวละครหญิงผมบลอนด์มีหูจิ้งจอก สวมชุดกิโมโนสีชมพู ถือลูกอมเกลียวสีรุ้ง" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์ค่ายเกม Sexy Slot ตัวอักษรสีชมพูม่วงข้างภาพตัวละครหญิงในชุดรัดรูปสีน้ำเงินม่วงและสัญลักษณ์รูปหัวใจ" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรสีทองข้างตัวละครนางเงือกผมแดงถือหอยสังข์ใต้ทะเลพร้อมปลาการ์ตูน" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม Ask Me Bet โลโก้ตัวอักษรขาวเหลืองเขียวบนพื้นดำ ข้างหัวสิงโตเชิดจีนสีส้มแดงใต้โคมไฟแดง" },
  { name: "New Game", src: image10, alt: "แบนเนอร์เกมออกใหม่ New Game ตัวอักษรขาวบนฟลอร์นีออนสีสด ขนาบด้วยตัวการ์ตูนฟักทองสวมหมวกและโครงกระดูกยิ้ม" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรขาวทองข้างนักรบโรมันสวมหมวกขนนกและสิงโตคำรามในสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming โลโก้ตัวอักษรทองบนพื้นดำ ข้างเทพเจ้ากรีกเคราขาวสวมมงกุฎใบลอเรล ตาเปล่งแสงสีฟ้า หน้าวิหารเสาหินสีขาว" },
];

// The URL each entry resolves to is schema.ts's problem, not this file's — an
// older version pasted a hand-built page URL onto all 12 and got the trailing
// slash and the Thai encoding wrong on every one of them.
const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

// 150–160 CHARACTERS (ภาษาไทย 1 ตัวอักษร = 3 ไบต์ การนับไบต์จะยาวเกินจริงราวสามเท่า)
// บรรทัดนี้วัดได้ 158 และเป็นประโยคเดียวที่บอกว่าหน้านี้มีไว้ทำอะไร ไม่ใช่สารบัญของทั้งหน้า
const pageDescription = "หน้าทดลองเล่นสล็อตของ 9KPLUS เปิดดูหน้าจอเกมและฟีเจอร์ของค่ายใหญ่ได้ฟรีก่อนลงเครดิตจริง เห็นทั้งตัวคูณ ฟรีสปิน และจังหวะการจ่ายบนค่า RTP ยุติธรรมที่ไม่ล็อกยูส";

const pageTitle = "ทดลองเล่น 9KPLUS | เปิดดูสล็อตค่ายใหญ่ฟรีก่อนลงเครดิตจริง";

// หัวข้อระดับ h1 ของหน้า แยกจากค่า title เพราะ title มีขีดคั่นแบรนด์อยู่
const pageHeading = "ทดลองเล่น 9KPLUS เปิดดูสล็อตค่ายใหญ่ฟรีก่อนลงเครดิตจริง";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ค่ายเกมที่เปิดอยู่ในล็อบบี้ของ 9KPLUS",
      alternateName: "9KPLUS โหมดทดลองเล่นสล็อตฟรีก่อนลงเครดิตจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});

// ชุดไล่สีของหัวข้อในหน้านี้ — ชมพูขาวผ่านชมพูบานเย็นไปจบที่แดงนีออนของแบรนด์
// เขียนคลาสเต็มไว้ตรงนี้เพื่อให้ Tailwind สแกนเจอ (สแกนเป็นข้อความดิบ ไม่ได้
// ประเมิน template)
const headingClass = "bg-gradient-to-r from-[#ffd8e7] via-[#ff4fa3] to-[#f5003e] bg-clip-text text-xl leading-normal font-bold text-transparent md:text-2xl";

// sizes บอกว่าภาพถูก "วาด" กว้างเท่าไหร่ ไม่ใช่อยากได้ไฟล์กว้างเท่าไหร่
// กริดเป็น grid-cols-2 จนถึง md: แล้วค่อยเป็น 4 คอลัมน์ ส่วน ContentBox
// มี px-4 (2rem) กับ p-8 (4rem) แล้วขยับเป็น p-10 (5rem) ที่ md: และการ์ดชนเพดาน
// max-w-[1400px] เมื่อ viewport กว้างตั้งแต่ 1432px ขึ้นไป
//   < 768px : 2 คอลัมน์ + gap-5 หนึ่งช่อง  → (100vw - 7.25rem) / 2
//   ≥ 768px : 4 คอลัมน์ + gap-5 สามช่อง   → (100vw - 10.75rem) / 4
//   ≥ 1432px: การ์ดชนเพดาน 1400px         → (1400 - 5rem - 3.75rem) / 4 = 315px
const galleryImageSizes = "(max-width: 767px) calc((100vw - 7.25rem) / 2), (max-width: 1431px) calc((100vw - 10.75rem) / 4), 315px";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <h2 class={`mb-6 ${headingClass}`}>หน้านี้ของ 9KPLUS มีไว้ทำอะไร และควรดูอะไรก่อนเลือกเกม</h2>

      <p class="mb-8 text-left text-base leading-relaxed">
        โหมดทดลองของ <strong class="text-[#ff4fa3]">9KPLUS</strong> มีไว้ให้เปิดเกมขึ้นมาดูฟรีก่อนลงเครดิตจริงแม้แต่บาทเดียว ไม่ต้องสมัคร ไม่ต้องเติมเงิน และไม่ต้องผูกอะไรไว้ล่วงหน้า ล็อบบี้ชุดที่วางไว้ในหน้านี้เป็นชุดเดียวกับที่เปิดให้เล่นจริง
        เพราะที่นี่เป็นสล็อตเว็บตรงที่<strong class="text-[#ffd8e7]">ยิงตรงจากเซิร์ฟนอกด้วยระบบ API แท้</strong> ปรับระบบมาแบบตรงสเปกโรงงาน ทุกการสปินจึงลื่นไหลและอยู่บน<strong class="text-[#ffd8e7]">
          ค่า RTP ยุติธรรม ไม่ล็อกยูส ไม่ปรับเปอร์เซ็นต์ชนะ
        </strong> ของที่เปิดอยู่มาจากค่ายใหญ่ระดับโลกอย่าง PG Soft, Pragmatic Play และ Joker Gaming วางรวมไว้บน<strong class="text-[#ff4fa3]">ระบบกระเป๋าเดียว</strong>
        กดสลับเปลี่ยนแนวได้ทันทีโดยไม่ต้องเสียเวลาโยกเงินข้ามค่าย หน้าเว็บและคลังเกมจัดไว้ให้เข้าถึงง่าย พุ่งตรงเข้าเกมที่อยากเล่นได้ตั้งแต่เปิดหน้าแรกโดยไม่ต้องนั่งสุ่มหา
        และโหมดทดลองคือที่ที่ควรเอาไว้ลองตัวที่ยังไม่คุ้นก่อนตัดสินใจ สิ่งที่ควรใช้เวลากับมันจริง ๆ ระหว่างทดลองคือกลไกของเกมแต่ละตัว ว่าปุ่มปรับไลน์กับปุ่มปรับเดิมพันอยู่ตรงไหน ระบบสุ่มแจกตัวคูณทวีคูณ
        Multipliers ขึ้นจังหวะใด สัญลักษณ์ Expanding Wild ยืดกินพื้นที่รีลแค่ไหน คอมโบแตกต่อเนื่องแบบ Cascading ทำงานตอนไหน โหมด Bonus Buy กินทุนต่อครั้งเท่าไร และตารางอัตราจ่ายกดเปิดดูได้จากปุ่มไหน
        มากกว่าจะไล่กดดูว่าเกมไหนภาพสวยที่สุด ภาพสวยช่วยให้ปั่นเพลินขึ้นจริง แต่ไม่ได้ช่วยเจรจากับผลของรอบถัดไปเป็นการส่วนตัว ถือเป็นการอ่านคู่มือก่อนขับ ซึ่งน่าเบื่อกว่าการลองขับเลยอยู่แล้ว
        แต่ค่าซ่อมถูกกว่ากันเยอะ
      </p>

      <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[200, 400, 600]}
                sizes={galleryImageSizes}
                class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(124,16,64,0.45)] transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href="/register"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ 9KPLUS`}
                class="absolute inset-0 flex items-center justify-center bg-[#120309]/72 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-full border border-[#ffd8e7]/70 bg-gradient-to-r from-[#f5003e] to-[#ff4fa3] px-6 py-2 font-bold text-[#ffe3ee] shadow-[0_10px_30px_rgba(245,0,62,0.5)] transition-transform hover:scale-110">
                  เล่นเลย
                </span>
              </a>
            </div>
          ))
        }
      </div>

      <h2 class={`mt-8 mb-6 ${headingClass}`}>โหมดทดลองบอกอะไรได้ และบอกอะไรไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed">
        การเปิดดูก่อนบอกได้ว่าเกมทำงานอย่างไร วางไลน์ไว้กี่เส้น สัญลักษณ์ตัวไหนเป็นไวลด์ตัวไหนเป็นสแกตเตอร์ และรอบโบนัสหน้าตาเป็นแบบไหนตอนที่มันเข้ามาจริง
        บอกได้ด้วยว่าโครงสร้างการจ่ายรางวัลของเกมนั้นอ่านออกและ<strong class="text-[#ffd8e7]">ตรวจสอบย้อนกลับได้จริง</strong>หรือเปล่า ซึ่งเป็นเกณฑ์เดียวกับที่ทำให้เราเลือกยิงตรงจากเซิร์ฟนอกตั้งแต่แรก
        คือค่า RTP ต้องยุติธรรมตรงตามสเปกโรงงาน ฟีเจอร์ต้องเด่นชัด และตัวคูณต้องสะสมทบขึ้นได้จริง บอกได้อีกอย่างว่าแนวไหนถูกจริตกับเรา ตั้งแต่สล็อตแนวเทพเจ้า แนวสายกิน ไปจนถึงแนวแอ็กชันที่ต้องรอให้ฟีเจอร์ทบขึ้นหลายชั้น
