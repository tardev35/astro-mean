---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

// One list, two consumers: the gallery below and the ItemList in the JSON-LD.
// They used to be two hand-kept arrays that had to stay in the same order, and
// the name shown to a reader could drift from the name handed to a crawler.
// The card shows the artwork only — the provider name is chrome, so it lives in
// the link's aria-label, never in a heading tag.
//
// alt describes the picture, not the brand: the artwork is the same on every
// rebrand, so an alt that names the site rots the moment the site is renamed.
const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่ายเกม AskmeSlot โลโก้โพดำสีเหลืองข้างตัวการ์ตูนเด็กชายหมวกแดงบนถนนหมู่บ้านกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์รวมเกมยอดนิยม Popular Game พร้อมตัวการ์ตูนกระต่ายและแมว กองชิปและเหรียญทอง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่ายเกม SlotXO โลโก้ตู้สล็อตและเหรียญทองข้างภาพนักรบโรมันสวมมงกุฎใบลอเรลหน้าโคลอสเซียม" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่ายเกม Skywind Group โลโก้วงกลมสี่สีข้างแมวกวักญี่ปุ่นสีขาวท่ามกลางดอกซากุระและถุงทอง" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่ายเกม PG Soft โลโก้พิกเซลตัวอักษร PG ข้างตัวละครหญิงนักรบสวมเครื่องประดับทองและหมวกขนนกสีสด" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET ตัวอักษรสีน้ำเงินข้างตัวการ์ตูนถือลูกอมบนพื้นหลังโทนสว่าง" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์ค่ายเกม Sexy Slot ตัวอักษรสีชมพูข้างภาพตัวละครหญิงในชุดรัดรูปสีน้ำเงินและสัญลักษณ์รูปหัวใจ" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรสีทองข้างตัวละครนางเงือกผมแดงถือหอยสังข์ใต้ทะเลพร้อมปลาการ์ตูน" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม Ask Me Bet ตัวอักษรสีทองข้างไพ่ ลูกเต๋า และกองชิปคาสิโนบนโต๊ะเดิมพัน" },
  { name: "New Game", src: image10, alt: "แบนเนอร์เกมออกใหม่ New Game พร้อมตัวการ์ตูนฟักทองและโครงกระดูก" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรขาวทองข้างนักรบโรมันสวมหมวกขนนกและสิงโตคำรามในสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming โลโก้ตัวอักษร AFB บนพื้นหลังไฟนีออนโทนเข้ม" },
];

// The URL each entry resolves to is schema.ts's problem, not this file's — an
// older version pasted a hand-built page URL onto all 12 and got the trailing
// slash and the Thai encoding wrong on every one of them.
const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

// 150–160 CHARACTERS (Thai is 3 bytes per character, so a byte count reads
// about three times too long and will send you rewriting a fine description).
// This one measures 155.
const pageDescription =
  "ทดลองเล่นสล็อต MONACO89 ฟรี ไม่ต้องสมัคร ไม่ต้องฝาก เปิดกริดเกมค่ายอินเตอร์ตัวดังจากระบบตรง API แท้ ลองฟีเจอร์ฟรีสปินและตัวคูณเงินรางวัลได้ก่อนลงเครดิตจริง";

const pageHeading = "ทดลองเล่นสล็อต MONACO89 เปิดกริดเกมค่ายอินเตอร์ให้ลองฟรีก่อนลงเดิมพันจริง";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมสล็อตจากค่ายอินเตอร์ชั้นนำในกริดเกมของ MONACO89",
      alternateName: "MONACO89 โหมดทดลองเล่นสล็อตบนมือถือก่อนเดิมพันด้วยเครดิตจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});

// ทองอ่อนไล่ไปหาทองแดงเข้ม — ชุดเดียวกับที่ ContentBox ใช้กับหัวข้อของตัวเอง
const headingClass = "bg-gradient-to-r from-[#ffe9b8] via-[#ef8f22] to-[#a44516] bg-clip-text text-2xl leading-normal font-bold text-transparent";

// sizes บอกว่าภาพถูก "วาด" กว้างเท่าไหร่ ไม่ใช่อยากได้ไฟล์กว้างเท่าไหร่
// กริดเป็น grid-cols-2 จนถึง md: แล้วค่อยเป็น 4 คอลัมน์ ส่วน ContentBox มี
// px-4 + p-8 (รวม 6rem) และขยับเป็น p-10 ที่ md: (รวม 7rem) พร้อม max-w-[1400px]
//   < 768px : 2 คอลัมน์ + gap-5 หนึ่งช่อง  → (100vw - 7.25rem) / 2
//   ≥ 768px : 4 คอลัมน์ + gap-5 สามช่อง   → (100vw - 10.75rem) / 4
//   ≥ 1432px: การ์ดชนเพดาน 1400px         → (1400 - 5rem - 3.75rem) / 4 = 315px
const galleryImageSizes = "(max-width: 767px) calc((100vw - 7.25rem) / 2), (max-width: 1431px) calc((100vw - 10.75rem) / 4), 315px";
---

<MainLayout title="ทดลองเล่น MONACO89 รวมค่ายสล็อตอินเตอร์ไว้กริดเดียว ลองฟรีก่อนเดิมพันจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <h2 class={`mb-6 ${headingClass}`}>โหมดทดลองของ MONACO89 มีไว้ทำอะไร และควรดูอะไรก่อนเลือกเกม</h2>

      <p class="mb-8 text-left text-base leading-relaxed">
        MONACO89 รวบรวมกริดเกมสล็อตอินเตอร์ตัวดังจากค่ายใหญ่ทั่วโลกมาไว้ในหน้าเดียว ทั้งแนวแฟนตาซีสุดตระการตา แนวคลาสสิกที่เล่นง่าย ไปจนถึงเกมยอดฮิตติดเทรนด์ที่คนกำลังตามหา
        ล็อบบี้จัดวางไว้เป็นระเบียบ อยากเปลี่ยนค่ายหรือเปลี่ยนแนวเกมเมื่อไหร่ก็กดสลับได้ทันทีโดยไม่ต้องไล่หาทีละเว็บและไม่ต้องโยกเครดิตไปมา
        หน้านี้มีไว้ให้เปิดดูก่อนว่าหน้าเกมจริงหน้าตาเป็นแบบไหน ปุ่มปรับไลน์กับปรับเบทอยู่ตรงไหน ฟีเจอร์ฟรีสปินเข้าโหมดด้วยสัญลักษณ์อะไร และตัวคูณเงินรางวัลทำงานตอนไหน
        โดยยังไม่ต้องเติมเครดิตจริงและไม่มีการได้เสียเกิดขึ้นแม้แต่บาทเดียว สิ่งที่ควรดูจริงคือเบทขั้นต่ำต่อสปินของแต่ละเกม ความถี่ที่ฟีเจอร์เข้า และตารางการจ่ายของแต่ละสัญลักษณ์
        มากกว่าดูว่าเกมไหนภาพสวยที่สุด ภาพสวยช่วยให้ปั่นเพลินขึ้นจริง แต่ไม่ได้ช่วยเจรจากับวงล้อที่กำลังจะหยุดเป็นการส่วนตัว ถือเป็นการอ่านคู่มือก่อนขับ ซึ่งน่าเบื่อกว่าการลองขับเลยอยู่แล้ว แต่ค่าซ่อมมันถูกกว่ากันเยอะ
      </p>

      <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[200, 400, 600]}
                sizes={galleryImageSizes}
                class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(239,143,34,0.30)] transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href="/register"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ MONACO89`}
                class="absolute inset-0 flex items-center justify-center bg-[#0b0602]/72 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-full border border-[#ffd77a]/70 bg-gradient-to-r from-[#ef8f22] to-[#a44516] px-6 py-2 font-bold text-[#1a0d03] shadow-[0_10px_30px_rgba(239,143,34,0.45)] transition-transform hover:scale-110">เล่นเลย</span>
              </a>
            </div>
          ))
        }
      </div>

      <h2 class={`mt-8 mb-6 ${headingClass}`}>โหมดทดลองบอกอะไรได้ และบอกอะไรไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed">
        โหมดทดลองบอกได้ว่าเกมทำงานอย่างไร ปุ่มสปินกับปุ่มออโต้อยู่ตรงไหน จำนวนไลน์กับรูปแบบการจ่ายนับจากทางไหน สัญลักษณ์ไวลด์กับสแคทเทอร์หน้าตาเป็นอย่างไร และหนึ่งรอบใช้เวลาเท่าไร
        แต่เครดิตในโหมดนี้เป็นยอดสมมติ ถอนไม่ได้ และผลที่ออกมาก็ไม่ได้บอกว่าเดิมพันจริงจะได้ผลเหมือนกัน เพราะ MONACO89 เชื่อมระบบตรง API แท้ที่ส่งสัญญาณจากเซิร์ฟเวอร์หลักของค่ายเกมโดยตรง
        ไม่ผ่านเอเย่นต์หรือคนกลาง ผลของแต่ละสปินจึงสุ่มขึ้นใหม่และเป็นอิสระจากกันเสมอ อัตราการจ่ายและความผันผวนของแต่ละเกมที่แสดงไว้ให้ เป็นสิ่งที่ดูรูปแบบได้จากโหมดทดลอง
        แต่ไม่ใช่หลักฐานว่าเกมนั้นกำลังอารมณ์ดีรอเราอยู่ โหมดนี้มีไว้ศึกษาระบบ ไม่ใช่ไว้ดูดวงผ่านหน้าจอ
      </p>

      <p class="mb-4 text-left text-base leading-relaxed">
        อีกเรื่องที่ควรเผื่อใจคือโหมดทดลองไม่ได้มีให้ครบทุกเกม เพราะบางค่ายเปิดให้ดูตัวอย่างหน้าเกมได้อย่างเดียวโดยไม่มีเครดิตทดลองให้กด จึงควรเปิดรายละเอียดของเกมดูก่อนเลือก
        และยอดที่วางในโหมดทดลองไม่นับเป็นยอดเทิร์นของบัญชีหรือของโปรโมชั่นใด ถ้าเกมที่อยากลองไม่มีปุ่มทดลอง ให้ถือว่าวันนี้โชคไม่ดี ไม่ใช่สัญญาณลับที่ระบบส่งมาให้เราคนเดียว
        อีกอย่างที่โหมดทดลองตามไม่ทันคือเกมที่เพิ่งออกใหม่ เพราะกริดเกมของ MONACO89 มีเกมใหม่ทยอยเข้ามาเสมอ บางเกมจึงเปิดให้เดิมพันด้วยเครดิตจริงก่อนแล้วค่อยมีโหมดทดลองตามมาทีหลัง
        และเมื่อระบบสลับค่ายเกมได้แบบไร้รอยต่อแทบจะทันทีที่กด การไล่เปิดดูหลายเกมรวดเดียวจึงเสียเวลาน้อยกว่าเดิมมาก ใช้จังหวะนั้นสำรวจให้ครบก่อนตัดสินใจลงเงินจริงจะคุ้มกว่า
      </p>

      <h2 class={`mt-8 mb-6 ${headingClass}`}>จากโหมดทดลองไปเดิมพันจริงบน MONACO89 ควรเช็กอะไรก่อน</h2>

      <p class="mb-2 text-left text-base leading-relaxed">
        ถ้าจะขยับจากโหมดทดลองไปเดิมพันด้วยเครดิตจริง เรื่องที่ควรดูก่อนคือบัญชี งบต่อสปิน และลิงก์ที่ใช้เข้าเว็บ ด้านบัญชี ขั้นตอนสมัครของที่นี่ใช้เวลาไม่ถึงหนึ่งนาที
        ผูกเบอร์มือถือกับบัญชีธนาคารหรือทรูวอลเล็ทให้เรียบร้อยก็ได้ยูสเซอร์เดียวไปสลับเข้าเกมได้ทุกค่ายในกริด โดยไม่ต้องเปลี่ยนยูสเซอร์หรือกดออกจากระบบให้เสียจังหวะ
        ควรเตรียมเบอร์โทรที่ใช้งานจริงและรับข้อความได้ ตั้งรหัสผ่านที่เดายากและไม่ใช้ซ้ำกับบัญชีอื่น แล้วตรวจชื่อบัญชีธนาคารกับข้อมูลสมาชิกให้ตรงกันก่อนยืนยัน
        เพราะระบบการเงินอ่านชื่อบัญชีเป็นหลัก สมัครเร็วเป็นเรื่องดี แต่กรอกผิดแล้วตามแก้ทีหลัง ความเร็วก็หายหมด ด้านงบ ควรตั้งเบทต่อสปินให้พอดีกับยอดที่ตั้งใจใช้ในวันนั้น
        แล้วดูยอดบนหน้าฝากและเบทขั้นต่ำของเกมแยกกันอีกครั้ง เพราะเบทขั้นต่ำของตัวเกมกับเงื่อนไขของการฝากถอนเป็นคนละตัวเลขกัน ส่วนเรื่องเงิน ระบบฝากถอนของที่นี่เป็นออโต้เต็มรูปแบบและจัดการยอดได้แม่นยำ
        ทำรายการเองได้ผ่านหน้าเว็บโดยไม่ต้องส่งสลิปและไม่ต้องรอแอดมิน ยอดเล็กหลักร้อยหรือยอดใหญ่หลักแสนก็เคลียร์ให้ไวเหมือนกัน และถ้าติดขัดตรงไหนก็มีทีมงานดูแลตลอด 24 ชั่วโมง
        สุดท้ายควรเข้าใช้งานผ่านทางเข้าจริงของ MONACO89 ที่ตรวจชื่อเว็บไซต์แล้วและเชื่อมต่อแบบ HTTPS เท่านั้น ไม่ใช่ลิงก์ที่ส่งต่อกันมาในแชตพร้อมคำโฆษณา เพราะลิงก์แบบนั้นมักพาไปเจออะไรจริง แค่ไม่ใช่ในทางที่เราหวัง
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
