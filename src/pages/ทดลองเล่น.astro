---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

// PAY69: ticker เป็น Announcement5 และกล่องเป็น ContentBox ให้ตรงกับทั้งเว็บ
// เรียก <Announcement /> เปล่าๆ เพราะ default message ของ variant นี้เป็นข้อความ
// ของแบรนด์นี้อยู่แล้ว
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// One list, two consumers: the gallery below and the ItemList in the JSON-LD.
// They used to be two hand-kept arrays that had to stay in the same order, and
// the name shown to a reader could drift from the name handed to a crawler.
// The card shows the artwork only — the provider name is chrome, so it lives in
// the link's aria-label, never in a heading tag.
//
// alt describes the picture, not the brand: the artwork is the same on every
// rebrand, so an alt that names the site rots the moment the site is renamed.
// Three alts were re-checked against the actual files on 2026-08-29 and were
// wrong — SBOBET's wordmark is white on black (not blue), Ask Me Bet's art is a
// Chinese lion-dance head (not cards and chips), and AFB Gaming's is a bearded
// god in front of a Greek temple (not neon). ชุด alt นี้จึงข้ามรีแบรนด์มาได้
// โดยไม่ต้องแก้ ต่างจากตัวบทความด้านล่างที่เขียนใหม่ทุกครั้ง
const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่ายเกม AskmeSlot โลโก้โพดำสีเหลืองข้างตัวการ์ตูนเด็กชายหมวกแดงบนถนนหมู่บ้านกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์รวมเกมยอดนิยม Popular Game ตัวอักษรทองข้างตัวการ์ตูนกระต่ายและแมวสวมแว่น ล้อมด้วยกองชิปและเหรียญทอง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่ายเกม SlotXO โลโก้ตู้สล็อตและเหรียญทองข้างภาพนักรบโรมันสวมมงกุฎใบลอเรลหน้าโคลอสเซียม" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่ายเกม Skywind Group โลโก้วงกลมสี่สีข้างแมวกวักญี่ปุ่นสีขาวคอกระพรวนทอง มีไหเงินและป้ายทองท่ามกลางดอกซากุระ" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่ายเกม PG Soft โลโก้พิกเซลตัวอักษร PG ข้างตัวละครหญิงนักรบสวมเครื่องประดับทองและหมวกขนนกสีสด" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET ตัวอักษรสีขาวบนพื้นดำ ข้างตัวละครหญิงผมบลอนด์มีหูจิ้งจอก สวมชุดกิโมโนสีชมพู ถือลูกอมเกลียวสีรุ้ง" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์ค่ายเกม Sexy Slot ตัวอักษรสีชมพูม่วงข้างภาพตัวละครหญิงในชุดรัดรูปสีน้ำเงินม่วงและสัญลักษณ์รูปหัวใจ" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรสีทองข้างตัวละครนางเงือกผมแดงถือหอยสังข์ใต้ทะเลพร้อมปลาการ์ตูน" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม Ask Me Bet โลโก้ตัวอักษรขาวเหลืองเขียวบนพื้นดำ ข้างหัวสิงโตเชิดจีนสีส้มแดงใต้โคมไฟแดง" },
  { name: "New Game", src: image10, alt: "แบนเนอร์เกมออกใหม่ New Game ตัวอักษรขาวบนฟลอร์นีออนสีสด ขนาบด้วยตัวการ์ตูนฟักทองสวมหมวกและโครงกระดูกยิ้ม" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรขาวทองข้างนักรบโรมันสวมหมวกขนนกและสิงโตคำรามในสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming โลโก้ตัวอักษรทองบนพื้นดำ ข้างเทพเจ้ากรีกเคราขาวสวมมงกุฎใบลอเรล ตาเปล่งแสงสีฟ้า หน้าวิหารเสาหินสีขาว" },
];

// The URL each entry resolves to is schema.ts's problem, not this file's — an
// older version pasted a hand-built page URL onto all 12 and got the trailing
// slash and the Thai encoding wrong on every one of them.
const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

// 150–160 CHARACTERS (Thai is 3 bytes per character, so a byte count reads
// about three times too long and will send you rewriting a fine description).
// This one measures 152.
const pageDescription =
  "ทดลองเล่น PAY69 เปิดดูหน้าจอเกมและกลไกการเดิมพันได้ฟรีก่อนลงเครดิตจริง ล็อบบี้เชื่อมด้วย API แท้ ไม่ผ่านเอเย่นต์ พร้อมโต๊ะคาสิโนสดค่ายดังรอสลับไปเล่นต่อ";

const pageTitle = "ทดลองเล่น PAY69 | เปิดดูเกมฟรีก่อนลงเครดิตจริงบนโต๊ะคาสิโนสด";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "ทดลองเล่น PAY69 เปิดดูเกมฟรีก่อนลงเครดิตจริง";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ค่ายเกมชั้นนำที่เปิดอยู่ในล็อบบี้ของ PAY69",
      alternateName: "PAY69 โหมดทดลองเล่นฟรีก่อนเดิมพันด้วยเครดิตจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});

// ชุดไล่สีเดียวกับที่ ContentBox ใช้กับหัวข้อของตัวเอง — ครีมผ่านทองสว่างไปหาทองแชมเปญ
// เขียนคลาสเต็มไว้ตรงนี้เพื่อให้ Tailwind สแกนเจอ (สแกนเป็นข้อความดิบ ไม่ได้ประเมิน template)
const headingClass = "bg-gradient-to-r from-[#fdf4e0] via-[#f7dfa5] to-[#e8c37a] bg-clip-text text-xl leading-normal font-bold text-transparent md:text-2xl";

// sizes บอกว่าภาพถูก "วาด" กว้างเท่าไหร่ ไม่ใช่อยากได้ไฟล์กว้างเท่าไหร่
// กริดเป็น grid-cols-2 จนถึง md: แล้วค่อยเป็น 4 คอลัมน์ ส่วน ContentBox
// มี px-4 (2rem) กับ p-8 (4rem) แล้วขยับเป็น p-10 (5rem) ที่ md: และการ์ดชนเพดาน
// max-w-[1400px] เมื่อ viewport กว้างตั้งแต่ 1432px ขึ้นไป
//   < 768px : 2 คอลัมน์ + gap-5 หนึ่งช่อง  → (100vw - 7.25rem) / 2
//   ≥ 768px : 4 คอลัมน์ + gap-5 สามช่อง   → (100vw - 10.75rem) / 4
//   ≥ 1432px: การ์ดชนเพดาน 1400px         → (1400 - 5rem - 3.75rem) / 4 = 315px
const galleryImageSizes = "(max-width: 767px) calc((100vw - 7.25rem) / 2), (max-width: 1431px) calc((100vw - 10.75rem) / 4), 315px";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <h2 class={`mb-6 ${headingClass}`}>หน้านี้ของ PAY69 มีไว้ทำอะไร และควรดูอะไรก่อนเลือกเกม</h2>

      <p class="mb-8 text-left text-base leading-relaxed">
        โหมดทดลองเล่นของ PAY69 มีไว้ให้เปิดเกมขึ้นมาดูฟรีก่อนจะลงเครดิตจริงแม้แต่บาทเดียว ไม่ต้องเติมเงินและไม่ต้องผูกอะไรไว้ล่วงหน้า
        ล็อบบี้ที่วางไว้ในหน้านี้เป็นชุดเดียวกับที่เปิดให้เล่นจริง เชื่อมด้วย API แท้ที่ยิงสัญญาณตรงจากเซิร์ฟเวอร์หลัก ไม่ผ่านเอเย่นต์ และไม่มีการดัดแปลงระบบหลังบ้าน
        แยกหมวดตามค่ายไว้ชัด กดสลับได้ในไม่กี่คลิกบนอินเทอร์เฟซที่สะอาดตา ไม่มีป๊อปอัปโฆษณาเด้งมาบัง และภาพก็โหลดลื่นไม่กระตุกแม้เปิดจากมือถือ
        ส่วนฟลอร์หลักของเว็บคือคาสิโนสด ที่ยิงสัญญาณระดับ Ultra HD ส่งตรงจากฟลอร์คาสิโนจริงในต่างประเทศ ดีลเลอร์แจกไพ่จริงแบบเรียลไทม์ ไม่มีการตัดต่อหรือใช้คลิปวน
        สิ่งที่ควรใช้เวลากับมันจริงๆ ระหว่างทดลองคือจังหวะของเกมแต่ละตัว ว่าปุ่มปรับเดิมพันกับปุ่มยืนยันอยู่ตรงไหน อัตราจ่ายของแต่ละช่องเปิดดูได้จากปุ่มใด และเดิมพันขั้นต่ำกับขั้นสูงของห้องนั้นห่างกันแค่ไหน
        มากกว่าไล่ดูว่าเกมไหนภาพสวยที่สุด งานภาพคมและเสียงประกอบดีช่วยให้เล่นเพลินขึ้นจริง แต่ไม่ได้ช่วยเจรจากับผลของตาถัดไปเป็นการส่วนตัว
        ถือเป็นการอ่านคู่มือก่อนขับ ซึ่งน่าเบื่อกว่าการลองขับเลยอยู่แล้ว แต่ค่าซ่อมมันถูกกว่ากันเยอะ
      </p>

      <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[200, 400, 600]}
                sizes={galleryImageSizes}
                class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(107,77,21,0.3)] transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href="/register"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ PAY69`}
                class="absolute inset-0 flex items-center justify-center bg-[#08070a]/72 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-full border border-[#e8c37a]/70 bg-gradient-to-r from-[#a87c2e] to-[#6b4d15] px-6 py-2 font-bold text-[#fdf4e0] shadow-[0_10px_30px_rgba(232,195,122,0.45)] transition-transform hover:scale-110">
                  เล่นเลย
                </span>
              </a>
            </div>
          ))
        }
      </div>

      <h2 class={`mt-8 mb-6 ${headingClass}`}>โหมดทดลองบอกอะไรได้ และบอกอะไรไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed">
        การเปิดดูก่อนบอกได้ว่าเกมทำงานอย่างไร หน้าตาโต๊ะเป็นแบบไหน ช่องเดิมพันวางไว้ตรงไหน และเวลานับถอยหลังก่อนปิดรับแต่ละตายาวแค่ไหน
        บอกได้ด้วยว่าหมวดไหนถูกจริตกับเรา ตั้งแต่บาคาร่าคลาสสิกที่จังหวะนิ่งและอ่านเกมได้ยาว บาคาร่าสายฟ้าที่ใส่ตัวคูณเข้ามาให้ลุ้นหนักขึ้นในบางตา
        ไปจนถึงรูเล็ต เสือมังกร ไฮโล วงล้อเสี่ยงโชค และเกมโชว์สดที่เล่นเป็นรอบและมีพิธีกรคุมเกม ลองสลับดูรอบเดียวก็พอเห็นว่าเราเป็นสายวางแผนยาวหรือสายจบไว
        แต่สิ่งที่มันบอกไม่ได้เลยคือผลของตาถัดไป เพราะทุกตาตัดสินจากไพ่หรือลูกที่ออกในวินาทีนั้นตรงหน้ากล้อง แต่ละตาจึงเป็นอิสระจากกันเสมอ ไม่ว่ารอบก่อนหน้าจะออกมาเป็นอะไรก็ตาม
        กระดานสถิติที่โต๊ะแสดงไว้ใช้ดูจังหวะและเลือกขนาดเดิมพันให้เหมาะกับทุนได้จริง แต่มันไม่ใช่หลักฐานว่าโต๊ะนั้นกำลังอารมณ์ดีรอเราอยู่
        หน้านี้มีไว้ศึกษาระบบ ไม่ใช่ไว้ดูดวงผ่านหน้าจอ
      </p>

      <p class="mb-4 text-left text-base leading-relaxed">
        อีกเรื่องที่ควรเผื่อใจคือไม่ได้มีเครดิตทดลองให้กดครบทุกเกมในล็อบบี้ บางค่ายเปิดให้เข้าไปดูหน้าจอเกมได้อย่างเดียวโดยยังไม่ให้ทดลองเดิมพัน จึงควรเปิดรายละเอียดของเกมนั้นดูก่อนเลือก
        ส่วนโต๊ะคาสิโนสดเป็นการถ่ายทอดจากฟลอร์จริงแบบเรียลไทม์ เข้าไปดูบรรยากาศ มุมกล้อง และจังหวะที่ดีลเลอร์แจกไพ่ได้ก่อน แต่การลงเดิมพันบนโต๊ะสดใช้เครดิตจริงเสมอ
        ยอดที่เดินระหว่างทดลองจึงไม่นับเป็นยอดของบัญชีหรือของโปรโมชันรายการใด ถ้าเกมที่อยากลองยังไม่เปิดให้ทดลองฟรี ให้ถือว่าวันนี้โชคไม่ดี ไม่ใช่สัญญาณลับที่ระบบส่งมาให้เราคนเดียว
        อีกอย่างที่การทดลองตามไม่ทันคือของใหม่ เพราะค่ายไหนเปิดโต๊ะหรือปล่อยเกมใหม่ออกมา PAY69 ก็ดึงเข้าล็อบบี้ทันที แล้วยกขึ้นหมวดเด่นให้เห็นตั้งแต่หน้าแรกที่เข้าสู่ระบบ
        ล็อบบี้จึงมีความเคลื่อนไหวตลอดเวลาและไม่มีคำว่าตกเทรนด์ ใช้จังหวะที่ทดลองอยู่สำรวจให้ครบก่อนตัดสินใจลงเงินจริงจะคุ้มกว่า
      </p>

      <h2 class={`mt-8 mb-6 ${headingClass}`}>จากโหมดทดลองไปนั่งโต๊ะจริงบน PAY69 ควรเช็กอะไรก่อน</h2>

      <p class="mb-2 text-left text-base leading-relaxed">
        ถ้าจะขยับจากโหมดทดลองไปเดิมพันด้วยเครดิตจริง เรื่องที่ควรดูก่อนคือบัญชี งบต่อตา และลิงก์ที่ใช้เข้าเว็บ ด้านบัญชี เมื่อสมัครและผูกเบอร์มือถือกับบัญชีธนาคารเรียบร้อยแล้ว ก็ได้ยูสเซอร์เดียวไว้เข้าได้ทุกค่ายในล็อบบี้
        อยากสลับจากโต๊ะบาคาร่าไปเดิมพันรูเล็ต วงล้อเสี่ยงโชค หรือเกมโชว์สดกลางคืนเดียวก็ทำได้ทันทีในกระเป๋าเงินเดียว ไม่ต้องโยกเงินข้ามค่ายไปมาให้ยุ่งยากและเสี่ยงต่อยอดตกค้าง ทุกอย่างทั้งเลือกโต๊ะ กดรับโปร และกดถอน อยู่บนแดชบอร์ดเดียว
