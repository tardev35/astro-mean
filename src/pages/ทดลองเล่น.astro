---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

// One list, two consumers: the gallery below and the ItemList in the JSON-LD.
// They used to be two hand-kept arrays that had to stay in the same order, and
// the name shown to a reader could drift from the name handed to a crawler.
const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์เกมสล็อตค่าย AskmeSlot ที่เปิดให้ทดลองเล่นบน NEKOATK" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์รวมเกมยอดนิยม Popular Game พร้อมกองชิปและเหรียญทอง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์เกมสล็อตค่าย SlotXO ที่เปิดให้ทดลองเล่นบน NEKOATK" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์เกมสล็อตค่าย Skywind Group ที่เปิดให้ทดลองเล่นบน NEKOATK" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์เกมสล็อตค่าย PG Soft ที่เปิดให้ทดลองเล่นบน NEKOATK" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET พร้อมตัวละครการ์ตูนถือลูกอม" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์เกมสล็อตค่าย Sexy Slot ที่เปิดให้ทดลองเล่นบน NEKOATK" },
  { name: "JILI", src: image8, alt: "แบนเนอร์เกมสล็อตค่าย JILI ที่เปิดให้ทดลองเล่นบน NEKOATK" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม Ask Me Bet ที่เปิดให้ทดลองเล่นบน NEKOATK" },
  { name: "New Game", src: image10, alt: "แบนเนอร์เกมออกใหม่ New Game พร้อมตัวการ์ตูนฟักทองและโครงกระดูก" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์เกมสล็อตค่าย JOKER ที่เปิดให้ทดลองเล่นบน NEKOATK" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming ที่เปิดให้ทดลองเล่นบน NEKOATK" },
];

// The URL each entry resolves to is schema.ts's problem, not this file's — an
// older version pasted a hand-built page URL onto all 12 and got the trailing
// slash and the Thai encoding wrong on every one of them.
const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

// 150–160 CHARACTERS (Thai is 3 bytes per character, so a byte count reads
// about three times too long and will send you rewriting a fine description).
// This one measures 156.
const pageDescription =
  "ทดลองเล่นสล็อต NEKOATK เปิดดูหน้าเกม API ลิขสิทธิ์แท้ได้ก่อนใช้เครดิตจริง ดูจังหวะหมุน ฟีเจอร์โบนัส และเดิมพันต่อรอบให้ครบ แล้วค่อยเลือกเกมที่ถูกใจไปลุยจริง";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: "ทดลองเล่นเกมสล็อตของ NEKOATK ลองระบบก่อนใช้เครดิตจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมสล็อต API ลิขสิทธิ์แท้ของ NEKOATK",
      alternateName: "NEKOATK โหมดทดลองเล่นสล็อตหลายค่ายบนมือถือก่อนเล่นด้วยเงินจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title="ทดลองเล่น NEKOATK ลองสล็อต API ลิขสิทธิ์แท้ก่อนเติมเครดิตจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่นเกมสล็อตของ NEKOATK ลองระบบก่อนใช้เครดิตจริง">
    <div>
      <h2 class="mb-6 bg-gradient-to-r from-[#ffb457] via-[#fd841b] to-[#fb0660] bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองของ NEKOATK มีไว้ทำอะไร และควรดูอะไรก่อนเลือกเกม</h2>

      <p class="mb-8 text-left text-base leading-relaxed">
        NEKOATK คือสล็อตเว็บตรงไม่ผ่านเอเย่นต์ที่นำเข้าเกมผ่าน API ลิขสิทธิ์แท้จากค่ายผู้พัฒนาโดยตรง ทั้ง PG Soft, JOKER, JILI, SlotXO และค่ายอื่นอีกหลายกลุ่ม รวมไว้ในเมนูเดียว มีทั้งแนวแอคชั่นผจญภัย แฟนตาซี และสไตล์คลาสสิกให้สลับเล่นได้ตลอดเวลาโดยไม่มีคำว่าเบื่อ ภาพคมชัด โหลดไว ไม่กินเน็ตมือถือ
        หน้านี้มีไว้ให้กดเปิดดูหน้าเกมก่อนว่าหน้าตาระบบเป็นแบบไหน ปุ่มปรับเดิมพันอยู่ตรงไหน ฟีเจอร์ฟรีสปินกับตัวคูณเรียกใช้อย่างไร และหนึ่งรอบกินเวลาแค่ไหน โดยยังไม่ต้องเติมเครดิตจริงและไม่มีการได้เสียเกิดขึ้นแม้แต่บาทเดียว
        สิ่งที่ควรดูจริงคือเดิมพันเริ่มต้นต่อรอบ ความผันผวนของเกม และรูปแบบการจ่ายรางวัล มากกว่าดูว่าเกมไหนกำลังดังที่สุด เกมดังช่วยให้หารีวิวง่าย แต่ไม่ได้ช่วยเจรจากับระบบสุ่มเป็นการส่วนตัว ถือเป็นการอ่านคู่มือก่อนขับ ซึ่งน่าเบื่อกว่าการลองขับเลยอยู่แล้ว แต่ค่าซ่อมมันถูกกว่ากันเยอะ
      </p>

      <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[200, 400, 600]}
                sizes="(max-width: 768px) 100vw, 25vw"
                class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(251,6,96,0.20)] transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href="/register"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ NEKOATK`}
                class="absolute inset-0 flex items-center justify-center bg-[#0d0210]/75 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-full border border-[#fd841b]/60 bg-gradient-to-r from-[#ffb457] via-[#fd841b] to-[#fb0660] px-6 py-2 font-bold text-[#2a0210] shadow-[0_10px_30px_rgba(253,132,27,0.32)] transition-transform hover:scale-110">เล่นเลย</span>
              </a>
            </div>
          ))
        }
      </div>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#ffb457] via-[#fd841b] to-[#fb0660] bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองบอกอะไรได้ และบอกอะไรไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed">
        โหมดทดลองบอกได้ว่าเกมทำงานอย่างไร เมนูอยู่ตรงไหน ฟีเจอร์ฟรีสปินเรียกใช้ยังไง สัญลักษณ์พิเศษหน้าตาเป็นแบบไหน และหนึ่งรอบใช้เวลาเท่าไร แต่เครดิตในโหมดนี้เป็นยอดสมมติ ถอนไม่ได้ และผลที่ออกมาก็ไม่ได้บอกว่าเล่นจริงจะได้ผลเหมือนกัน
        เพราะเกมทุกตัวบน NEKOATK วิ่งบนระบบสุ่มของค่ายเกมโดยตรงผ่าน API ลิขสิทธิ์แท้ ไม่มีการแทรกแซงจากหลังบ้าน ผลของแต่ละสปินจึงเป็นอิสระจากกันเสมอ ต่อให้กดในโหมดทดลองแล้วจังหวะเข้ามือ ก็ไม่ใช่หลักฐานว่าเกมนั้นกำลังอารมณ์ดีรอเราอยู่ โหมดนี้มีไว้ศึกษาระบบ ไม่ใช่ไว้ดูดวงผ่านหน้าจอ
      </p>

      <p class="mb-4 text-left text-base leading-relaxed">
        อีกเรื่องที่ควรเผื่อใจคือโหมดทดลองไม่ได้มีให้ครบทุกเกม จึงควรเปิดหน้ารายละเอียดของเกมดูก่อนเลือก และยอดที่หมุนในโหมดทดลองไม่นับเป็นยอดเทิร์นของบัญชีหรือของโปรโมชั่นใด
        ถ้าเกมที่อยากลองไม่มีปุ่มทดลอง ให้ถือว่าวันนี้โชคไม่ดี ไม่ใช่สัญญาณลับที่ระบบส่งมาให้เราคนเดียว ส่วนโต๊ะถ่ายทอดสดที่เดินรอบแบบเรียลไทม์เป็นโต๊ะจริงที่ไม่มีโหมดทดลองให้กดลองผล จึงต้องอาศัยการอ่านกติกา ดูวงเงินโต๊ะ ความเร็วรอบ และสถานะเปิดรับเดิมพันให้แม่นแทน
      </p>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#ffb457] via-[#fd841b] to-[#fb0660] bg-clip-text text-2xl leading-normal font-bold text-transparent">จากโหมดทดลองไปเล่นจริงบน NEKOATK ควรเช็กอะไรก่อน</h2>

      <p class="mb-2 text-left text-base leading-relaxed">
        ถ้าจะขยับจากโหมดทดลองไปเล่นด้วยเครดิตจริง เรื่องที่ควรดูก่อนคือบัญชี งบต่อรอบ โปรโมชั่น และลิงก์ ด้านบัญชี ควรเตรียมเบอร์โทรที่ใช้งานจริงและรับข้อความได้ ตั้งรหัสผ่านที่เดายากและไม่ใช้ซ้ำกับบัญชีอื่น แล้วตรวจชื่อบัญชีธนาคารกับข้อมูลสมาชิกให้ตรงกันก่อนยืนยัน เพราะระบบออโต้ของ NEKOATK อ่านชื่อบัญชีเป็นหลัก สมัครเร็วเป็นเรื่องดี แต่กรอกผิดแล้วตามแก้ทีหลัง ความเร็วก็หายหมด
        ด้านงบ ควรตั้งเดิมพันต่อรอบให้พอดีกับยอดที่ตั้งใจใช้ในวันนั้น แล้วดูยอดบนหน้าฝากและหน้าเกมแยกกันอีกครั้ง เพราะเดิมพันต่อรอบของเกมกับขั้นต่ำของการฝากถอนเป็นคนละตัวเลขกัน ส่วนโปรโมชั่นของที่นี่แจกเครดิตฟรีให้อัปเดตกันทุกวันและตั้งเทิร์นโอเวอร์ไว้ต่ำ แต่ก็ยังต้องอ่านยอดฝากขั้นต่ำ โบนัสที่ได้รับ จำนวนเทิร์น และเกมที่ร่วมรายการให้จบก่อนกดรับ
        เรื่องเงินที่นี่ทำผ่านระบบออโต้ที่รวดเร็ว ยอดอัปเดตเข้ากระเป๋าเองโดยไม่ต้องแจ้งสลิปหรือรอคิวตรวจ กดถอนปุ๊บเงินเด้งเข้าแอปธนาคารปั๊บ จ่ายเต็มทุกบิลและไม่มีอั้นยอดถอนต่อวัน สุดท้ายควรเข้าใช้งานผ่านทางเข้าจริงของ NEKOATK ที่ตรวจชื่อเว็บไซต์แล้วและเชื่อมต่อแบบ HTTPS เท่านั้น ไม่ใช่ลิงก์ที่ส่งต่อกันมาในแชตพร้อมคำโฆษณา เพราะลิงก์แบบนั้นมักพาไปเจออะไรจริง แค่ไม่ใช่ในทางที่เราหวัง
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
