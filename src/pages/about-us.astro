---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 154.
const pageDescription =
  "เกี่ยวกับ FAST369 เว็บสล็อตสปีดเกมไหลที่รีดระบบมาเพื่อความไว เกมตัวตึงลงครบทุกค่าย สลับค่ายได้ทันฟีล ฟีเจอร์มีของ และโบนัสพร้อมบวกเติมทุนให้ทุกช่วงการเล่น";

const pageTitle = "เกี่ยวกับ FAST369 เว็บสล็อตสปีดเกมไหล ระบบเร็วแรงถึงใจ โบนัสพร้อมบวก";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// ทองแบรนด์ไล่ไปหาแดงสัญญาณ — ชุดเดียวกับที่ ContentBox ใช้กับหัวข้อของตัวเอง
const headingClass = "mt-8 mb-6 bg-gradient-to-r from-[#ffe27a] via-[#ffc531] to-[#ff3b2f] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed">
        FAST369 เริ่มต้นจากความคิดง่าย ๆ ว่าคนสายสปินยุคนี้ไม่ได้อยากเสียอารมณ์กับเว็บที่เปิดมาแล้วช้า หมุนแล้วสะดุด หรือกดเปลี่ยนเกมทีต้องรอโหลดจนหมดฟีล
        เราจึงวางตัวเองเป็นเว็บสล็อตที่เอาเรื่องสปีดขึ้นมาเป็นโจทย์ข้อแรก แล้วรีดประสิทธิภาพของระบบให้จังหวะปั่นต่อกันได้ลื่นไหลตั้งแต่คลิกแรกจนถึงรอบสุดท้าย
        ไม่ว่าจะเข้าเล่นช่วงเวลาไหน คนออนไลน์เยอะแค่ไหน ความเร็วก็ต้องคงที่เท่าเดิม ควบคู่ไปกับโบนัสที่พร้อมบวกให้เรื่อย ๆ ไม่ใช่แจกหนักทีเดียวตอนเปิดตัวแล้วเงียบหายไป
      </p>

      <h2 class={headingClass}>เกมตัวตึงลงครบทุกค่าย ล็อบบี้แน่นเปิดมาทีไรก็มีตัวน่าเล่น</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        เรารวมเอาเกมตัวตึงระดับท็อปจากค่ายดังมาปักหลักไว้ในที่เดียว คัดเฉพาะตัวที่ขึ้นชื่อเรื่องภาพสวย เอฟเฟกต์อลังการ และมีเอกลักษณ์ของตัวเองจริง ๆ
        การเปิดล็อบบี้แต่ละครั้งจึงเจอแต่ตัวเลือกที่น่ากดสปิน ไม่ต้องมานั่งเสี่ยงกับเกมที่ทำมาครึ่ง ๆ กลาง ๆ ไม่ว่าจะชอบแนวไหน สไตล์ไหน
        ก็มีของเด็ดคอยสลับมาให้เล่นแบบไม่ขาดสาย และรายการเกมก็อัปเดตอยู่เสมอ ทั้งเกมฮิตระดับตำนานที่ทุกคนต้องเคยเล่น และเกมนอกกระแสที่รอให้เข้าไปค้นเจอ
      </p>

      <h2 class={headingClass}>ระบบเร็วแรงถึงใจ เข้าไวสลับไว เปลี่ยนค่ายได้ทันฟีล</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        ไฮไลต์ที่ทำให้หลายคนติดใจคือความคล่องตัวในการสลับค่ายเกม ไม่ต้องกดออกหลายขั้นตอนหรือนั่งรอรีโหลดนาน ๆ อยากเปลี่ยนบรรยากาศไปลุ้นเกมอีกค่ายก็ทำได้ทันที
        เมนูแบ่งหมวดหมู่ไว้เป็นระเบียบ หาเกมที่อยากเล่นเจอในไม่กี่วินาที ตัวระบบเองก็ออกแบบให้โหลดหน้าเกมและองค์ประกอบต่าง ๆ ได้อย่างสมูธตั้งแต่จังหวะแรกที่กดเข้ามา
        จังหวะกำลังมา ฟีลกำลังได้ ก็จัดต่อได้เลยโดยไม่เสีย mood การปั่นที่ต่อเนื่องแบบนี้แหละที่ทำให้โอกาสเจอรอบใหญ่มาถึงเร็วขึ้นกว่าการเล่นแบบสะดุดเป็นช่วง ๆ
      </p>

      <h2 class={headingClass}>ฟีเจอร์มีของ โบนัสพร้อมบวก และระบบโอนไวเข้าบัญชีทันที</h2>

      <p class="text-left text-base leading-relaxed">
        เกมที่เราเลือกเข้ามาต้องมีลูกเล่นให้ลุ้นมากกว่าแค่นั่งมองวงล้อหมุน ทั้งตัวคูณสะสม สัญลักษณ์พิเศษที่ช่วยเข้าฟีเจอร์ง่ายขึ้น และโหมดฟรีสปินที่ออกบ่อยจนน่าตกใจ
        ทำให้ทุกสปินเต็มไปด้วยจังหวะที่ซัพพอร์ตให้ลุ้นกำไรก้อนใหญ่ได้สนุกกว่าเดิม ควบคู่ไปกับสิทธิประโยชน์และโบนัสที่เติมทุนให้ผู้เล่นอยู่ตลอด
        มีทั้งกิจกรรมและโปรเด็ดพร้อมบวกเข้ายูสเซอร์ ให้มีทุนไปหมุนต่อยอดได้ยาวขึ้นแบบไม่มีคำว่าเกลือ ส่วนเรื่องการเงิน ทุกรายการฝากถอนทำเองได้แบบออโต้
        เงินเข้าบัญชีตรงเป๊ะในเวลาอันสั้น ไม่ต้องรอทีมงานอนุมัติจนเสียอารมณ์ เล่นได้เท่าไหร่จ่ายเต็มจำนวน ทั้งหมดนี้คือสิ่งที่เราหมายถึงเวลาบอกว่า FAST369
        คือเว็บสปีดแรงที่เกม ระบบ และล็อบบี้เดินหน้าไปพร้อมกันแบบไม่ติดเบรก
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
