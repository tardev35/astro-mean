---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";

// XONEBET: ticker หมุนมาเป็น Announcement2 ส่วนกล่องหน้าย่อยยังเป็น ContentBox
// (การ์ดถาวรของหน้าย่อย) ตามสเปกรอบนี้ เรียก <Announcement /> เปล่า ๆ เพราะ
// default message ของ variant นี้ถูกตั้งให้ตรงกับที่หน้าแรกส่งเข้าไปแล้ว
// สีเน้นในย่อหน้าใช้เงิน #e9e9e9 กับเหลืองสว่าง #fee505 ของพาเลตต์รอบนี้
// (ไม่ใช้ทองเข้ม #a87c02 กับตัวอักษรขนาดเนื้อความ เพราะคอนทราสต์บนผิว
// #161105 ของการ์ดตกลงมาใกล้เกณฑ์ AA เกินไป — สองสีที่เลือกไว้ผ่านสบาย)
// ส่วนสีเนื้อความมาจากการ์ดเอง ไม่ต้องระบุซ้ำ
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 156.
const pageDescription =
  "รู้จัก XONEBET สล็อตวันสต็อป เว็บตรง API แท้ ยิงตรงจากเซิร์ฟเวอร์หลักนอก ไม่ผ่านเอเย่นต์ ค่า RTP โปร่งใสตามมาตรฐานสากล ฝากถอนออโต้ไวใน 3 วินาที ถอนเต็มจำนวน";

const pageTitle = "เกี่ยวกับเรา XONEBET | สล็อตวันสต็อป เว็บตรง API แท้ ไม่ผ่านเอเย่นต์";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา XONEBET";

// docx รอบนี้ไม่มีส่วน SUB-PAGES จึงไม่มีบอดี้สำเร็จรูปให้หน้านี้ — หัวข้อและ
// ย่อหน้าทั้งเจ็ดบล็อกด้านล่างเขียนขึ้นใหม่จากข้อเท็จจริงของแบรนด์ในบรีฟรอบนี้
// (เว็บตรง API แท้ ยิงสัญญาณตรงจากเซิร์ฟเวอร์หลักนอก ไม่ผ่านเอเย่นต์ · ค่า RTP
// โปร่งใสตามมาตรฐานสากล ไม่มีปรับแต่งเปอร์เซ็นต์การชนะ · โครงสร้าง One-Stop
// Service บัญชีเดียว ไม่ต้องสมัครหลายยูส ไม่ต้องโยกเงินข้ามค่าย แดชบอร์ดเดียว ·
// ค่ายเกรด A อย่าง PG Soft, Pragmatic Play, Joker Gaming โครงสร้างการจ่ายเงิน
// โปร่งใส ฟรีสปินเข้าไว อัตราคูณสะสมสูง · จัดหมวดหมู่หน้าเว็บแยกตามประเภทเกม
// ค่ายดัง และหมวดกระแสมาแรง · ฟีเจอร์ Multipliers / Wild ซ้อนทับ / Cascading /
// Buy Feature · เซิร์ฟเวอร์หลังบ้านประมวลผลเร็ว ไม่ค้าง ไม่กระตุก ไม่เด้งหลุด ·
// ฝากถอนออโต้ไวใน 3 วินาที ไม่ติดเทิร์นจุกจิก ถอนเต็มจำนวน · Responsive 100%
// ทั้ง iOS, Android, แท็บเล็ต, คอมพิวเตอร์ ตลอด 24 ชั่วโมง)
// — ไม่ลอกย่อหน้าในบรีฟมาทั้งดุ้น เพราะย่อหน้าชุดนั้นใช้เต็ม ๆ อยู่บนหน้าแรกแล้ว
// หัวข้อจึงตั้งคนละสำนวนกับ h2 ของหน้าแรกด้วย โครงเป็น h1×1 + h2×7 ไม่มี h3
// และห้ามเติมข้อเท็จจริงที่บรีฟไม่ได้ให้ เช่น เลขใบอนุญาต จำนวนผู้เล่น รางวัล
// ชื่อธนาคาร หรือตัวเลขเวลาทำรายการที่บรีฟไม่ได้ระบุไว้
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="text-left text-base leading-relaxed">
      <strong class="text-[#e9e9e9]">XONEBET</strong> เริ่มจากข้อสังเกตง่าย ๆ ว่าคนที่ตั้งใจมานั่งปั่นสล็อตควรมีเรื่องให้ลุ้นแค่เรื่องเดียว คือรอบถัดไปจะเข้าฟีเจอร์หรือไม่
      ไม่ใช่ต้องแบ่งใจไปลุ้นด้วยว่าเว็บที่นั่งอยู่ทำตามที่ประกาศไว้จริงหรือเปล่า หรือต้องเปิดอีกสามแท็บเพื่อหาเกมที่อยากเล่น
      เราจึงวางเว็บนี้เป็นสล็อตวันสต็อป เกมตัวท็อปครบวงจร ที่รวมคลังเกมจากทุกค่ายชั้นนำและระบบการเงินไว้ในบัญชีเดียว เชื่อมต่อแบบเว็บตรง API แท้ ยิงสัญญาณตรงจากเซิร์ฟเวอร์หลักนอกโดยไม่ผ่านเอเย่นต์
      งานที่เหลือเป็นของเราล้วน ๆ คือคัดของเด่นขึ้นล็อบบี้ จัดหมวดหมู่ให้หาเจอง่าย แล้วยกงานฝากถอนทั้งหมดให้ระบบออโต้รับไปทำแทนคน เพื่อให้เวลาของสมาชิกหมดไปกับการสปิน ไม่ใช่กับการรอ
    </p>
  </ContentBox>

  <ContentBox title="เว็บตรง API แท้ ยิงสัญญาณตรงจากเซิร์ฟเวอร์หลักนอก ไม่มีเอเย่นต์คั่นกลาง" as="h2">
    <p class="text-left text-base leading-relaxed">
      จุดยืนข้อแรกของเราคือระหว่างปุ่มสปินกับเซิร์ฟเวอร์ของค่ายเจ้าของเกมต้องไม่มีอะไรมาคั่น ทุกเกมในล็อบบี้เชื่อมด้วยสัญญาณ API แท้ที่ยิงตรงจากเซิร์ฟเวอร์หลักนอก
      คำสั่งจึงวิ่งไปบันทึกที่ค่ายแล้วส่งผลกลับมาตามที่ตัวสุ่มของค่ายตัดสินจริง
      <strong class="text-[#fee505]">โครงสร้างที่ไม่ผ่านเอเย่นต์</strong> แปลว่าไม่มีจุดใดเลยตลอดทางที่ใครจะเข้าไปแตะผลของสปินได้ ไม่มีชั้นกลางที่เก็บยอดไว้ก่อน และไม่มีคิวที่รอให้คนอนุมัติ
      สิ่งที่สมาชิกเห็นบนหน้าจอจึงเป็นสิ่งเดียวกับที่ระบบของค่ายบันทึกไว้ ไม่ใช่ภาพที่ถูกส่งต่อกันมาอีกทอด
    </p>
  </ContentBox>

  <ContentBox title="ค่า RTP โปร่งใสตามมาตรฐานสากล ไม่มีการปรับแต่งเปอร์เซ็นต์การชนะ" as="h2">
    <p class="text-left text-base leading-relaxed">
      ตัวเลขที่ตัดสินว่าเกมหนึ่งคืนกลับให้ผู้เล่นเท่าไหร่คือค่า RTP และตัวเลขนั้นเป็นของค่ายผู้พัฒนา ไม่ใช่ของเรา ทุกเกมบนเว็บนี้จึงรันด้วย
      <strong class="text-[#fee505]">ค่า RTP โปร่งใสตามมาตรฐานสากล</strong> ที่ค่ายตั้งมาเอง เราไม่ปรับ ไม่หรี่ และไม่มีการปรับแต่งเปอร์เซ็นต์การชนะให้สมาชิกคนหนึ่งต่างจากอีกคนในช่วงเวลาไหนทั้งสิ้น
      ผลที่ตามมาคือคนที่ปั่นหลักสิบกับคนที่ปั่นหลักหมื่นอยู่บนกลไกชุดเดียวกันเป๊ะ ๆ สิ่งที่ต่างกันได้มีแค่โปรโมชั่นและสิทธิ์ที่แต่ละคนเลือกกดรับ ไม่ใช่ตัวเกม
      และเพราะทุกอย่างวางอยู่บนตัวเลขที่ตรวจสอบได้ เราจึงไม่ต้องใช้คำว่าสูตรหรือช่วงเวลาแตกดีมาอธิบายอะไรเลย
    </p>
  </ContentBox>

  <ContentBox title="โครงสร้าง One-Stop Service บัญชีเดียวจบ ไม่ต้องโยกเงินข้ามค่าย" as="h2">
    <p class="text-left text-base leading-relaxed">
      เรายึดโครงสร้าง One-Stop Service เต็มรูปแบบ นั่นแปลว่าคลังเกมจากทุกค่ายชั้นนำและระบบการเงินทั้งหมดถูกเชื่อมไว้ใน
      <strong class="text-[#fee505]">บัญชีเดียว</strong> ไม่ต้องเสียเวลาสมัครหลายยูสเซอร์ให้จำรหัสไม่ไหว และไม่ต้องโยกเงินข้ามค่ายไปมาจนสับสนว่ายอดค้างอยู่ตรงไหน
      เลือกเล่น สลับเกม และจัดการถอนกำไรได้ทันทีผ่านหน้าแดชบอร์ดเดียว
      ข้อดีที่เห็นชัดที่สุดคือเวลาที่เคยหายไปกับการย้ายเครดิตกลับมาอยู่กับการเล่นทั้งหมด และยอดคงเหลือที่เห็นบนหน้าจอคือยอดจริงที่ใช้ได้กับทุกเกมในเว็บ ไม่ใช่ยอดของค่ายใดค่ายหนึ่ง
    </p>
  </ContentBox>

  <ContentBox title="คัดเฉพาะค่ายเกรด A จาก PG Soft, Pragmatic Play และ Joker Gaming" as="h2">
    <p class="text-left text-base leading-relaxed">
      คลังเกมของเราผ่านการคัดกรองก่อนขึ้นล็อบบี้ทุกตัว เรากวาดเฉพาะค่ายใหญ่ระดับเกรด A อย่าง PG Soft, Pragmatic Play และ Joker Gaming เข้าระบบ แล้วเลือกเน้น ๆ เฉพาะเกมตัวท็อปของแต่ละค่าย
      เกณฑ์คัดมีสามข้อและตรงไปตรงมา ข้อแรก <strong class="text-[#fee505]">โครงสร้างการจ่ายเงินต้องโปร่งใส</strong> อ่านออกได้จากตารางอัตราจ่ายของเกมเอง ข้อสอง จังหวะฟรีสปินต้องเข้าไวพอจะเห็นได้ในรอบที่นั่งปั่นจริง
      และข้อสาม ต้องมีอัตราคูณสะสมสูงพอให้รอบที่แตกคุ้มกับรอบที่รอ
      เกมไร้คุณภาพที่จ่ายแบบอ่านไม่ออกว่าจ่ายมาจากอะไร เราตัดออกทั้งหมดตั้งแต่ก่อนขึ้นหน้าเว็บ เพื่อให้ทุกสปินในล็อบบี้มีโอกาสทำเงินได้จริงตั้งแต่เปิดเข้ามา
    </p>
  </ContentBox>

  <ContentBox title="จัดหมวดหมู่หน้าเว็บเป็นระบบ หาเกมที่ใช่เจอได้ในไม่กี่คลิก" as="h2">
    <p class="text-left text-base leading-relaxed">
      ปัญหาที่คนเล่นสล็อตเจอบ่อยที่สุดไม่ใช่หาเกมไม่ได้ แต่คือเลื่อนหาจนหมดอารมณ์จะเล่น หน้าเว็บของเราจึงจัดหมวดหมู่ไว้อย่างเป็นระบบ
      <strong class="text-[#fee505]">แยกตามประเภทเกม ค่ายดัง และหมวดเกมกระแสมาแรง</strong> ให้กดเข้าหาสิ่งที่ต้องการได้ในไม่กี่คลิก
      คนที่รู้อยู่แล้วว่าจะเล่นค่ายไหนกดเข้าค่ายนั้นตรง ๆ ส่วนคนที่ยังไม่ได้ตัดสินใจก็เปิดหมวดกระแสมาแรงดูว่าตอนนี้คนกำลังลงกับเกมไหน
      ผลคือสลับเปลี่ยนฟีลการปั่นได้ตรงสไตล์ทันทีโดยไม่ต้องค้นหาหลายรอบ และไม่มีหน้าคั่นระหว่างทางที่ตั้งใจให้เสียเวลา
    </p>
  </ContentBox>

  <ContentBox title="ฟีเจอร์ยุคใหม่ ตั้งแต่ตัวคูณทวีคูณและ Wild ซ้อนทับ ถึงโหมด Buy Feature" as="h2">
    <p class="text-left text-base leading-relaxed">
      ลูกเล่นยุคใหม่คือเหตุผลที่สล็อตสองตัวซึ่งหน้าตารีลคล้ายกันกลับให้ฟีลคนละแบบ ล็อบบี้ของเราจึงเลือกเกมที่มีฟีเจอร์เด่นชัดพอให้รู้สึกได้ตั้งแต่รอบแรกที่หมุน
      ตัวที่เจอบ่อยและเปลี่ยนเกมได้จริงมีสี่กลุ่ม กลุ่มแรกคือระบบสุ่มแจกตัวคูณทวีคูณ <strong class="text-[#fee505]">Multipliers</strong> ที่หย่อนตัวคูณลงมาระหว่างรอบปกติ
      กลุ่มที่สองคือสัญลักษณ์ Wild ซ้อนทับที่เปลี่ยนหน้ารีลทั้งแถวให้กลายเป็นไวลด์ กลุ่มที่สามคือคอมโบแตกต่อเนื่องแบบ Cascading ที่สัญลักษณ์ชนะร่วงหายแล้วให้ตัวใหม่ไหลลงมาแทน
      และกลุ่มที่สี่คือโหมด Buy Feature สำหรับสายใจร้อนที่ไม่อยากรอเก็บสแกตเตอร์เอง
      ข้อแลกเปลี่ยนก็มีและเราไม่ปิดบัง โหมด Buy Feature กินทุนต่อครั้งหนักกว่าการปั่นปกติหลายเท่า จึงควรดูงบของวันนั้นก่อนกด ไม่ใช่กดเพราะปุ่มมันวางอยู่ตรงนั้นพอดี
    </p>
  </ContentBox>

  <ContentBox title="ฝากถอนออโต้ประมวลผลไวใน 3 วินาที ไม่ติดเทิร์นจุกจิก ถอนเต็มจำนวน" as="h2">
    <p class="text-left text-base leading-relaxed">
      ระบบการเงินคือส่วนที่เราเลือกให้เครื่องทำงานแทนคนทั้งหมด ธุรกรรมทุกรายการประมวลผลผ่านระบบออโต้และเสร็จสิ้นภายใน 3 วินาทีนับจากกดยืนยัน ยอดอัปเดตเข้าคลังเกมทันที
      ขั้นตอนถ่ายสลิปส่งแอดมินและการต่อคิวรออนุมัติถูกตัดออกทั้งหมด ฝากยอดปุ๊บเข้าเล่นได้เลย ถอนกำไรปุ๊บก็เดินต่อได้ทันที
      <strong class="text-[#fee505]">ไม่ติดเทิร์นจุกจิก และถอนออกได้เต็มจำนวนทุกยอด</strong>
      เบื้องหลังคือเซิร์ฟเวอร์หลังบ้านที่อัปเกรดมาให้ประมวลผลความเร็วสูง รองรับการใช้งานพร้อมกันจำนวนมากได้อย่างเสถียร การสลับค่ายเกมและการโหลดหน้าอินเทอร์เฟซจึงฉับไว ไม่ค้าง ไม่กระตุก และไม่เด้งหลุดกลางทาง
      สิ่งที่ยังต้องตรวจด้วยตัวเองเหลืออยู่สองอย่าง คือผูกชื่อบัญชีให้ตรงกับข้อมูลสมาชิกตั้งแต่ตอนสมัคร และเข้าใช้งานผ่านลิงก์ที่ตรวจชื่อเว็บไซต์แล้วเท่านั้น
    </p>
  </ContentBox>

  <ContentBox title="รองรับทุกอุปกรณ์แบบ Responsive 100% เข้าเล่นได้คล่องตลอด 24 ชั่วโมง" as="h2">
    <p class="text-left text-base leading-relaxed">
