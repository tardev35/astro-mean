---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 159.
const pageDescription =
  "รู้จัก BUFFXBET สล็อตเว็บตรงสายคุ้ม รวมเกมฮิตจากค่ายดังไว้ที่เดียว โบนัสเน้นทุกจังหวะ ลุ้นกำไรอิ่มคุ้ม ระบบออโต้ลื่นตอบสนองไว ฝากถอนคล่องจริง พร้อมเล่นต่อทันใจ";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ BUFFXBET สล็อตเว็บตรงสายคุ้ม โบนัสเน้น กำไรอิ่มคุ้ม ถอนคล่องจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

const headingClass = "mt-8 mb-6 bg-gradient-to-r from-[#3b8df1] via-[#7cc0ff] to-[#f5c542] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="เกี่ยวกับเรา BUFFXBET สล็อตเว็บตรงสายคุ้ม โบนัสเน้น กำไรอิ่มคุ้ม ถอนคล่องจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ BUFFXBET สล็อตเว็บตรงสายคุ้ม โบนัสเน้น กำไรอิ่มคุ้ม ถอนคล่องจริง" as="h1">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed">
        BUFFXBET เกิดขึ้นจากความตั้งใจง่ายๆ ว่าคนที่เข้ามาปั่นควรรู้สึกคุ้มค่าทุกบาททุกสตางค์ ไม่ใช่แค่เว็บที่มีดีแค่ชื่อ
        เราจึงจัดเต็มเรื่องความคุ้มแบบเน้นๆ โบนัสแตกง่าย กำไรอิ่มๆ และที่สำคัญคือถอนเงินได้คล่องปรื๊ด ไม่มีสะดุดให้หงุดหงิดใจ
        อินเทอร์เฟซถูกออกแบบมาให้ดูแพงสบายตา ฟีเจอร์ต่างๆ วางไว้อย่างใส่ใจ ทำให้ทุกการสปินรู้สึกถึงความเป็นวีไอพี
        และกลายเป็นจุดศูนย์รวมความสนุกที่ตอบโจทย์คนอยากเล่นยาวๆ โดยไม่เบื่อไปเสียก่อน
      </p>

      <h2 class={headingClass}>รวมเกมฮิตจากค่ายดังไว้ที่เดียว เลือกเล่นสนุกได้ไม่มีเบื่อ</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        สายขี้เบื่อถูกใจสิ่งนี้แน่นอน เพราะที่นี่เหมาค่ายเกมระดับท็อปฮิตมารวมไว้ที่เดียวจบ ไม่ต้องคอยสลับเว็บไปมาให้วุ่นวาย
        จะเป็นแนวแอคชั่นมันส์ๆ สายแฟนตาซีภาพสวย หรือสไตล์คลาสสิกเรียบง่าย ก็มีให้เลือกเพียบ แต่ละเกมคัดมาแล้วเน้นๆ
        ภาพคมชัดระดับไฮเอนด์ เล่นเพลินจนลืมเวลา จะสลับเปลี่ยนกี่เกมก็ยังสนุกและลุ้นมันส์เหมือนเดิม
        ทีเด็ดที่พลาดไม่ได้อีกอย่างคือจังหวะการแจกโบนัส ไม่ใช่แค่รอแจ็คพอตใหญ่อย่างเดียว แต่มีรางวัลยิบย่อย โบนัสตัวคูณ
        และฟรีสปินโผล่มาช่วยเพิ่มสีสันตลอดเกม ทำให้กราฟกำไรพุ่งกระฉูดได้แบบไม่อั้น
      </p>

      <h2 class={headingClass}>ระบบออโต้ลื่น ฝากถอนคล่องจริง พร้อมเล่นต่อได้ทันใจ</h2>

      <p class="text-left text-base leading-relaxed">
        สิ่งที่สมาชิกประทับใจตั้งแต่ก้าวแรกที่กดสมัครคือความไว ระบบออโต้ของ BUFFXBET ทำมาเสถียรมาก ลื่นไหลไม่มีอาการค้างหรือหน่วง
        ไม่ว่าจะกดรับโปรโมชั่น ย้ายค่ายเกม หรือตั้งค่าเมนูต่างๆ ก็ตอบสนองรวดเร็วทันใจ ใช้งานง่ายสุดๆ มือใหม่เข้าใจระบบได้ในไม่กี่วินาที
        ส่วนเรื่องเงินๆ ทองๆ ที่หลายคนซีเรียสที่สุด บอกลาความกังวลไปได้เลย เพราะระบบฝากถอนคล่องตัวจริงตามคำเคลม
        ทำรายการผ่านระบบออโต้แบบไม่ต้องรอยอดนานให้เสียอารมณ์ ชนะปุ๊บ สั่งถอนปั๊บ เงินเด้งเข้าบัญชีทันใจ
        ทำให้คุณมีสมาธิโฟกัสกับการเล่นต่อได้แบบไม่ขาดตอน ครบทั้งเกม โบนัส และความคุ้มในที่เดียว
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
