---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 159.
const pageDescription = "เกี่ยวกับเรา DEKDDD เว็บสล็อตสายเอ็นจอยที่คัดเกมฮิตติดล็อบบี้พร้อมเกมใหม่สลับมาให้ลอง ระบบตอบสนองไวสลับเกมลื่นไม่มีสะดุด เล่นได้ทุกอุปกรณ์ ฟีเจอร์และกิจกรรมครบ";

const pageTitle = "เกี่ยวกับเรา DEKDDD | สล็อตสายเอ็นจอย เกมฮิตติดล็อบบี้";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา DEKDDD เว็บสล็อตสายเอ็นจอยที่ตั้งใจให้ทุกจังหวะเล่นลื่นไม่มีสะดุด";

// หัวข้อของหน้านี้เขียนขึ้นใหม่ในมุม "เกี่ยวกับเรา" ไม่ได้ยกย่อหน้าจาก docx
// มาซ้ำกับหน้าแรก ข้อเท็จจริงทุกข้อยังมาจากบรีฟชุดเดียวกัน
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <p class="text-left text-base leading-relaxed">
        DEKDDD เริ่มต้นจากโจทย์สั้นๆ ว่าการเข้ามาปั่นสล็อตแต่ละรอบควรรู้สึกสบายๆ ไม่ต้องเครียด และควรจบลงด้วยความรู้สึกที่ดีกลับไป ไม่ใช่แค่หน้าจอที่หมุนเสร็จแล้วจบ
        คำว่าสายเอ็นจอยที่เราใช้เรียกตัวเองจึงไม่ใช่คำโฆษณา แต่เป็นเกณฑ์ที่ใช้ตัดสินใจจริงตั้งแต่เลือกเกมเข้าล็อบบี้ วางหน้าเว็บให้สบายตา ไปจนถึงจูนระบบหลังบ้านให้สลับเกมได้ไว
        หน้านี้เขียนไว้บอกว่าเรายืนอยู่บนอะไรบ้าง ทั้งวิธีคัดเกมฮิตกับเกมใหม่ให้อยู่ในสายตาเดียวกัน เหตุผลที่เราลงแรงกับความเร็วในการสลับเกมมากเป็นพิเศษ
        การรองรับทุกอุปกรณ์ที่ผู้เล่นหยิบขึ้นมาใช้จริง และมุมมองที่เรามีต่อฟีเจอร์ในเกมกับกิจกรรมที่จัดให้สมาชิก คนที่กำลังชั่งใจอยู่ควรอ่านจบแล้วรู้ว่ากำลังคุยอยู่กับเว็บแบบไหน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เว็บสล็อตสายเอ็นจอยแปลว่าอะไรในแบบของ DEKDDD" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        คนส่วนใหญ่วัดเว็บสล็อตกันที่อัตราการแตกของเกมฮิตเป็นหลัก ซึ่งไม่ผิด แต่เราคิดว่ามันเล่าได้ไม่หมด เพราะสิ่งที่ทำให้คนอยู่กับเว็บได้ยาวๆ คือบรรยากาศการเล่นที่เป็นมิตรและผ่อนคลาย
        เราจึงเอาคำว่าเอ็นจอยมาเป็นเกณฑ์ตัดสินใจจริง ตั้งแต่ดีไซน์หน้าเว็บที่ต้องสบายตาและไม่รกจนหาปุ่มไม่เจอ คลังเกมที่ต้องมีให้เลือกหลายสไตล์พอที่จะเปลี่ยนอารมณ์ได้ในวันเดียวกัน
        ไปจนถึงจังหวะการแจกโบนัสที่ต้องมาแบบสม่ำเสมอมากกว่ามาเป็นก้อนใหญ่นานๆ ครั้ง ผลที่ตั้งใจให้เกิดคือคนที่เข้ามาเพื่อผ่อนคลายก็ได้ผ่อนคลายจริง
        ส่วนคนที่ตั้งใจมาล่าโบนัสแจ็คพอตก็ยังได้ของที่ต้องการครบ โดยไม่ต้องเลือกอย่างใดอย่างหนึ่ง และสายสปินทุกระดับควรรู้สึกว่ามีที่ทางของตัวเองในเว็บนี้เท่ากัน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ล็อบบี้ที่คัดแต่เกมฮิต แล้วสลับตัวใหม่เข้ามาให้ลองไม่ให้จำเจ" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        เรื่องที่คนพูดถึงน้อยที่สุดแต่เจอทุกครั้งที่เปิดเว็บคือหน้าล็อบบี้ ถ้าจัดไม่ดี คลังใหญ่แค่ไหนก็กลายเป็นกำแพงรูปเกมที่เลื่อนหาอะไรไม่เจอ เราจึงเลือกคัดมากกว่าเลือกกวาด
        เกมที่ได้อยู่หน้าล็อบบี้ต้องเป็นตัวเต็งที่ติดกระแสจริง ทั้งเกมสล็อตยอดฮิตระดับตำนานที่ผู้เล่นรู้จักชื่ออยู่แล้วและเปิดหาเจอได้ทันที และเกมมาใหม่ล่าสุดจากค่ายชั้นนำที่ทยอยเข้ามาให้ทดลองเล่นอยู่ตลอดเวลา
        การให้ของสองกลุ่มนี้อยู่ในสายตาเดียวกันทำให้คนที่มาเพื่อปั่นเกมตัวตึงได้เริ่มเลย ส่วนคนที่อยากเปลี่ยนบรรยากาศก็มีของใหม่วางรออยู่ตรงนั้นโดยไม่ต้องตั้งใจไปหา
        อยากเปลี่ยนฟีลเมื่อไหร่ก็แค่คลิกเลือกเกมใหม่ได้ทันที เป้าหมายมีข้อเดียวคือจากเปิดเว็บถึงกดหมุนควรใช้เวลาน้อยที่สุด เพราะเวลาที่หมดไปกับการหาเกม ไม่ใช่ส่วนที่ใครมาเพื่อจะได้
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ระบบตอบสนองไว คือส่วนที่เราลงแรงมากที่สุดแต่ควรรู้สึกได้น้อยที่สุด" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        จุดที่ผู้เล่นบอกเราบ่อยที่สุดว่าติดใจ ไม่ใช่ฟีเจอร์ที่หวือหวา แต่คือความฉับไวของระบบหลังบ้านตอนกดสลับเกม เวลาที่อยากเปลี่ยนเกมหรือสลับค่ายเล่น ไม่ควรต้องนั่งรอโหลดหน้าเว็บนานๆ ให้เสียอารมณ์
        เราจึงตัดขั้นตอนระหว่างทางออกให้เหลือน้อยที่สุดเท่าที่ทำได้ ระบบสลับเข้าเกมใหม่ได้อย่างสมูธ รวดเร็ว ไร้รอยต่อ จังหวะกำลังได้ อารมณ์กำลังมา ก็ปั่นต่อได้ทันทีโดยไม่มีคำว่าสะดุดมาขัด
        เรื่องนี้ฟังดูเป็นงานเบื้องหลังที่ไม่มีใครเห็น และนั่นคือความตั้งใจ เพราะความเร็วที่ทำได้ดีจริงจะไม่มีใครสังเกตเห็น คนจะสังเกตก็ต่อเมื่อมันช้าเท่านั้น
        เราจึงถือว่าหน้าจอรอโหลดหนึ่งครั้งคือหนึ่งจังหวะที่ผู้เล่นต้องหยุดโดยไม่จำเป็น และเป็นสิ่งที่ต้องไล่เก็บออกไปเรื่อยๆ ไม่ใช่ปัญหาที่แก้ครั้งเดียวจบ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="พัฒนาให้เล่นลื่นทุกอุปกรณ์ เปิดจากมือถือ แท็บเล็ต หรือคอมก็คล่องตัวเท่ากัน" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        เราไม่คิดว่าผู้เล่นควรต้องเลือกว่าจะเล่นจากเครื่องไหน เพราะจังหวะที่อยากปั่นสักรอบมักเกิดตอนที่มีแค่มือถืออยู่ในมือ ระบบของ DEKDDD จึงถูกพัฒนาขึ้นมารองรับการใช้งานในทุกแพลตฟอร์ม
        ทั้งสมาร์ตโฟน แท็บเล็ต และคอมพิวเตอร์ ครอบคลุมทุกระบบปฏิบัติการที่คนใช้กันจริง หน้าจอจะถูกปรับให้เหมาะกับอุปกรณ์ที่เปิดเข้ามาโดยอัตโนมัติ ปุ่มกดวางไว้ใกล้มือ
        และกราฟิกยังแสดงผลได้คมชัดไหลลื่นโดยไม่ต้องลดคุณภาพลงเพื่อแลกกับความเร็ว สิ่งที่ตามมาคือยูสเซอร์เดียวใช้ได้ทุกเครื่อง เปลี่ยนอุปกรณ์กลางคันก็เล่นต่อได้โดยไม่ต้องเรียนรู้หน้าเว็บใหม่
        ความสนุกจึงพกพาไปได้ทุกที่ทุกเวลาตามต้องการ ไม่ได้ผูกอยู่กับโต๊ะตัวใดตัวหนึ่ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ฟีเจอร์ในเกมและกิจกรรมของเรา มีไว้เพิ่มจังหวะให้ลุ้น ไม่ใช่แค่ตัวเลขบนแบนเนอร์" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        ความสนุกจากตัวเกมเป็นของที่ค่ายเกมทำมาให้อยู่แล้ว หน้าที่ของเราคือเลือกเกมที่มีจังหวะให้ลุ้นเป็นของตัวเองเข้ามา ไม่ใช่เกมที่มีแค่สัญลักษณ์เรียงกันเฉยๆ
        เกมที่อยู่ในล็อบบี้จึงมักมาพร้อมตัวคูณรางวัลสุดพิเศษที่พลิกหน้าตาของรอบนั้นได้ทันที และโหมดฟรีสปินที่ออกบ่อยพอจะทำให้การปั่นยาวๆ ยังน่าติดตาม
        นอกจากในตัวเกมแล้ว เรายังจัดกิจกรรมและโปรโมชันน่าติดตามขึ้นเพื่อสมาชิกโดยเฉพาะเป็นระยะ เจตนาของทุกรายการเหมือนกันหมด คือยืดเวลาที่อยู่ในเกมให้นานขึ้นโดยไม่ต้องเพิ่มทุน
        เพราะจำนวนรอบที่ได้ปั่นคือสิ่งที่เปิดโอกาสให้เจอฟีเจอร์และรางวัลก้อนใหญ่ และเพราะแต่ละรายการคิดจากยอดคนละชุดและมีเงื่อนไขของตัวเอง เราจึงเขียนรายละเอียดไว้บนแบนเนอร์ของแต่ละโปรตรงๆ ให้อ่านจบก่อนกดรับ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เลือกเกมให้ตรงสไตล์ แล้วเริ่มเอ็นจอยกับเราได้ตั้งแต่รอบแรก" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        สุดท้ายแล้วเราอยากให้ DEKDDD เป็นพื้นที่ความบันเทิงที่สายสล็อตเดินเข้ามาแล้วเจอของที่ใช่ได้เร็ว ไม่ว่าจะเป็นสายเน้นภาพสวยที่ดูงานอาร์ตก่อนดูอย่างอื่น สายปั่นชิลๆ ที่ขอแค่กดเพลินๆ ไม่กดดัน
        หรือสายล่ารางวัลใหญ่ที่ตั้งใจไล่ตามฟีเจอร์และแจ็คพอตเป็นหลัก ทั้งสามแบบควรหาที่ทางของตัวเองในล็อบบี้เดียวกันได้โดยไม่ต้องย้ายไปหาเว็บอื่น
        ส่วนงานที่เหลือเป็นของเรา ทั้งการดูแลระบบให้ได้มาตรฐาน โอนไว และปลอดภัยในทุกขั้นตอน กับการทำให้ทุกอย่างตั้งแต่สมัครสมาชิกจนถึงกดรับสิทธิ์จบได้เองบนหน้าเว็บโดยไม่ต้องรอใครกดอนุมัติ
        คนที่ยังไม่แน่ใจ ลองเปิดโหมดทดลองเล่นดูก่อนก็ได้ เพราะเราเชื่อว่าคำว่าเอ็นจอยเป็นเรื่องที่ต้องลองเองถึงจะรู้ มากกว่าจะอ่านจากหน้าเกี่ยวกับเราหน้านี้
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
