---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 154.
const pageDescription =
  "เกี่ยวกับ DRACO65 สล็อตเว็บตรงไฟลุก ระบบอัปเดตใหม่เร็วแรงกว่าเดิม ฟีเจอร์ฟรีสปินตัวคูณ รวมเกมดังค่ายเด็ดเต็มล็อบบี้ เชื่อมเซิร์ฟเวอร์ตรง ฝาก-ถอนออโต้ 3 วิ";

const pageTitle = "เกี่ยวกับ DRACO65 สล็อตเว็บตรงไฟลุก ระบบแรง ฟีเจอร์ดุ ฝาก-ถอน 3 วิ";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// เขียวมิ้นต์อ่อนไล่ไปหาเขียวนีออน — ชุดเดียวกับที่ ContentBox ใช้กับหัวข้อของตัวเอง
const headingClass = "mt-8 mb-6 bg-gradient-to-r from-[#dcfce7] via-[#4ade80] to-[#22c55e] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed">
        DRACO65 เกิดขึ้นจากโจทย์สั้น ๆ ข้อเดียวว่าการปั่นสล็อตในยุคนี้ไม่ควรมีจังหวะให้รอ ไม่ว่าจะเป็นรอหน้าเว็บโหลด รอสลับค่ายเกม หรือรอให้ใครสักคนมากดอนุมัติยอดเงินให้
        เราจึงวางที่นี่ให้เป็นเว็บตรงสายลุยที่ประกอบขึ้นจากสามส่วนหลักซึ่งต้องแรงพร้อมกันทั้งหมด คือระบบหลังบ้านที่ประมวลผลไว ฟีเจอร์ในเกมที่ช่วยเปิดทางทำกำไรได้จริง
        และระบบการเงินออโต้ที่จบงานให้ในไม่กี่วินาที ผลลัพธ์คือเว็บสล็อตที่ปั่นแล้วฟีลต่อเนื่อง ลุ้นรางวัลใหญ่ได้ยาว ๆ โดยไม่มีอะไรมาตัดจังหวะกลางทาง
      </p>

      <h2 class={headingClass}>ยกเครื่องระบบใหม่ให้เสถียรและตอบสนองไวตั้งแต่คลิกแรก</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        การอัปเดตระบบรอบล่าสุดของ DRACO65 คือการรื้อโครงสร้างเบื้องหลังใหม่เพื่อความเสถียรเป็นหลัก ไม่ใช่แค่เปลี่ยนหน้าตาให้ดูใหม่เฉย ๆ
        หน้าเว็บจึงเปิดติดเร็ว กราฟิกในเกมไหลลื่นตลอดรอบโดยไม่มีอาการกระตุกหรือภาพค้าง และการกดสปินตอบสนองทันทีแม้ในช่วงที่คนเข้าใช้งานหนาแน่นที่สุดของวัน
        ทั้งหมดนี้ทำงานเหมือนกันทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์ เปิดจากเครื่องไหนก็ได้บรรยากาศเดียวกัน ไม่ต้องมาเรียนรู้หน้าตาเว็บใหม่ทุกครั้งที่เปลี่ยนอุปกรณ์
      </p>

      <h2 class={headingClass}>ฟีเจอร์ดุครบเครื่องและล็อบบี้เกมค่ายดังที่คัดมาให้เลือกเต็มมือ</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        สิ่งที่นักปั่นมองหาจริง ๆ คือลูกเล่นที่ช่วยเปิดทางทำกำไร ล็อบบี้ของที่นี่จึงคัดเกมที่มีของมาให้ทั้งหมด ทั้งโหมดฟรีสปินที่เข้าถี่ ตัวคูณรางวัลที่สะสมต่อเนื่องจนดันแจ็คพอตให้ระเบิด
        และสัญลักษณ์พิเศษที่ช่วยพาเข้ารอบโบนัสได้ง่ายกว่าเกมทั่วไป ทุกจังหวะการหมุนจึงมีเรื่องให้ลุ้น และเบทเบา ๆ ก็มีโอกาสพลิกเป็นกำไรก้อนใหญ่ได้เสมอ
        ด้านความหลากหลาย เรารวมค่ายเกมชั้นนำระดับโลกไว้ในที่เดียว เลือกเฉพาะเกมตัวตึง เกมฮิตติดเทรนด์ และเกมที่คนบอกต่อว่าแตกดี อยากเปลี่ยนฟีลเมื่อไหร่ก็กดสลับเกมใหม่ได้ทันทีในยูสเซอร์เดียว
      </p>

      <h2 class={headingClass}>เชื่อมเซิร์ฟเวอร์ตรงและฝาก-ถอนออโต้ 3 วิ ที่ดูแลตลอด 24 ชั่วโมง</h2>

      <p class="text-left text-base leading-relaxed">
        ความคล่องตัวของ DRACO65 มาจากการเชื่อมต่อเซิร์ฟเวอร์หลักโดยตรงโดยไม่ผ่านคนกลาง การสลับค่ายเกมจึงทำได้ทันที การตัดยอดแม่นยำทุกครั้ง
        และไม่มีอาการกดสปินแล้วค้างจนต้องรีโหลดหน้าเว็บทิ้งไป ความต่อเนื่องตรงนี้เองที่ทำให้รักษาจังหวะการเล่นของตัวเองไว้ได้ตลอดทั้งรอบ
        อีกหัวใจหนึ่งคือระบบการเงิน ฝาก-ถอนออโต้ไฮสปีดของที่นี่เคลียร์ยอดให้จบภายใน 3 วินาที ทำเองได้ครบทุกขั้นตอน ไม่ต้องส่งสลิป ไม่ต้องรอแอดมินอนุมัติ
        และตรวจย้อนประวัติการเดิมพันกับยอดเงินเข้าออกได้เองตลอดเวลา ส่วนเรื่องที่ระบบตอบแทนไม่ได้ ยังมีทีมงานคอยดูแลและให้คำแนะนำตลอด 24 ชั่วโมง ทักเข้ามาถามได้ทันทีเมื่อติดขัด
        ทั้งหมดนี้คือมาตรฐานเดียวกันที่ DRACO65 วางไว้กับเกม ระบบ และบริการ เพื่อให้ทุกบาททุกสตางค์ที่คุณทำได้ถูกดูแลอย่างตรงไปตรงมา
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
