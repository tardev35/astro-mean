---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// QUEEN189: ticker หมุนมาเป็น AnnouncementPremium ส่วนกล่องหน้าย่อยยังเป็น ContentBox
// (การ์ดถาวรของหน้าย่อย) เรียก <Announcement /> เปล่า ๆ เพราะ default message ของ
// variant นี้ถูกตั้งให้ตรงกับที่หน้าแรกส่งเข้าไปแล้ว
// สีเน้นในย่อหน้าใช้ทองสว่าง #fceb83 กับทองหลัก #e4bb53 ของพาเลตต์รอบนี้
// (ไม่ใช้ทองสำริดเข้ม #7a5615 หรือน้ำตาลลึก #3c2505 กับตัวอักษรขนาดเนื้อความ เพราะ
// คอนทราสต์บนผิว #1a1108 ของการ์ดตกลงมาใต้เกณฑ์ AA — สองสีที่เลือกไว้ผ่านสบาย)
// ส่วนสีเนื้อความมาจากการ์ดเอง ไม่ต้องระบุซ้ำ
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 159.
const pageDescription =
  "รู้จัก QUEEN189 คาสิโนมงลงทุกสปิน เว็บตรง API แท้ ยิงตรงจากเซิร์ฟเวอร์นอก ไม่ผ่านเอเย่นต์ ไม่ล็อกยูส ค่า RTP มาตรฐานสากล ไร้การดัดแปลง ฝากถอนออโต้จบใน 3 วินาที";

const pageTitle = "เกี่ยวกับเรา QUEEN189 | คาสิโนมงลงทุกสปิน เว็บตรง API แท้ ไร้การดัดแปลง";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา QUEEN189";

// docx รอบนี้ไม่มีส่วน SUB-PAGES จึงไม่มีบอดี้สำเร็จรูปให้หน้านี้ — หัวข้อและ
// ย่อหน้าทั้งเจ็ดบล็อกด้านล่างเขียนขึ้นใหม่จากข้อเท็จจริงของแบรนด์ในบรีฟรอบนี้
// (เว็บตรง API แท้ ยิงตรงจากเซิร์ฟนอก ไม่ผ่านเอเย่นต์ ไม่ล็อกยูส · ค่า RTP
// มาตรฐานสากล ไร้การดัดแปลง · ค่าย PG Soft, Pragmatic Play, SA Gaming และ
// Evolution · สล็อตมี Multipliers ตัวคูณสะสม โหมดซื้อฟรีสปิน และ Cascading ·
// โต๊ะสดสัญญาณ Ultra HD ทั้งบาคาร่า รูเล็ต ไฮโล เสือมังกร · กระเป๋าเงินเดียว
// ไม่ต้องโยกเครดิต · โบนัสต้อนรับ โปรฝากแรกของวัน และ Cash Back คืนยอดเสียทุกวัน
// ไม่ติดเทิร์นโอเวอร์มหาโหด · ฝากถอนออโต้ 3 วินาที ถอนเต็มจำนวน ไม่ต้องรอแอดมิน
// อนุมัติ ไม่ต้องส่งสลิป)
// — ไม่ลอกย่อหน้าในบรีฟมาทั้งดุ้น เพราะย่อหน้าชุดนั้นใช้เต็ม ๆ อยู่บนหน้าแรกแล้ว
// หน้านี้จึงเขียนคนละสำนวนจากข้อเท็จจริงชุดเดียวกัน โครงเป็น h1×1 + h2×6 ไม่มี h3
// และห้ามเติมข้อเท็จจริงที่บรีฟไม่ได้ให้ เช่น เลขใบอนุญาต จำนวนผู้เล่น รางวัล
// ชื่อธนาคาร หรือตัวเลขเวลาทำรายการที่บรีฟไม่ได้ระบุไว้
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="text-left text-base leading-relaxed">
      <strong class="text-[#fceb83]">QUEEN189</strong> ตั้งต้นจากคำถามข้อเดียวว่า ถ้าตัดเรื่องที่ผู้เล่นไม่ควรต้องคิดออกไปให้หมด จะเหลืออะไรอยู่บนหน้าจอบ้าง
      คำตอบที่เราได้คือควรเหลือแค่เกมกับรอบถัดไป ไม่ใช่คำถามว่าสัญญาณที่เห็นถูกส่งผ่านมือใครมาบ้าง ไม่ใช่การรอคนกดอนุมัติ และไม่ใช่การไล่เปิดเกมทีละตัวเพื่อหาว่าตัวไหนพอเล่นได้
      เว็บนี้จึงถูกวางเป็นคาสิโนที่เชื่อมตรงกับเซิร์ฟเวอร์ของค่ายเจ้าของเกม รวมทั้งฝั่งสล็อตและฝั่งโต๊ะสดไว้ในบัญชีเดียว แล้วยกงานฝากถอนทั้งหมดให้ระบบออโต้รับไปทำแทนคน
      สิ่งที่เราถือว่าเป็นงานของเราคือคัดของขึ้นฟลอร์ ดูแลให้ทางเดินระหว่างปุ่มกับเซิร์ฟเวอร์สั้นที่สุด และเขียนเงื่อนไขทุกข้อให้อ่านจบได้ก่อนกด ส่วนที่เหลือเป็นของผู้เล่นล้วน ๆ
    </p>
  </ContentBox>

  <ContentBox title="เว็บตรง API แท้ ยิงตรงจากเซิร์ฟเวอร์นอก ไม่ผ่านเอเย่นต์และไม่ล็อกยูส" as="h2">
    <p class="text-left text-base leading-relaxed">
      ข้อแรกที่เราตัดสินใจไว้ตั้งแต่ก่อนเปิดคือ ระหว่างปุ่มที่ผู้เล่นกดกับเซิร์ฟเวอร์ของค่ายเจ้าของเกมจะต้องไม่มีใครมายืนคั่น ทุกเกมในฟลอร์เชื่อมด้วย
      <strong class="text-[#e4bb53]">สัญญาณ API แท้ที่ยิงตรงจากเซิร์ฟเวอร์นอก</strong> คำสั่งจึงวิ่งไปบันทึกที่ค่ายแล้วส่งผลกลับมาตามที่ตัวสุ่มของค่ายตัดสินจริง
      โครงสร้างแบบไม่ผ่านเอเย่นต์แปลว่าไม่มีชั้นกลางที่เก็บยอดไว้ก่อน ไม่มีคิวที่รอให้ใครเคาะ และไม่มีจุดใดตลอดทางที่ใครจะเข้าไปแตะผลของรอบนั้นได้
      อีกด้านหนึ่งของเรื่องเดียวกันคือเราไม่ล็อกยูส ไม่มีการหรี่บัญชีใดให้ต่างจากบัญชีอื่น เพราะระบบไม่ได้ถูกออกแบบให้ทำอย่างนั้นได้ตั้งแต่ต้น
    </p>
  </ContentBox>

  <ContentBox title="ค่า RTP มาตรฐานสากล ไร้การดัดแปลง เพราะตัวเลขนั้นไม่ใช่ของเรา" as="h2">
    <p class="text-left text-base leading-relaxed">
      ตัวเลขที่บอกว่าเกมหนึ่งคืนกลับให้ผู้เล่นเท่าไหร่คือค่า RTP และตัวเลขนั้นเป็นของค่ายผู้พัฒนา ไม่ใช่ของเว็บ ทุกเกมที่เปิดอยู่บนฟลอร์นี้จึงรันด้วย
      <strong class="text-[#e4bb53]">ค่า RTP มาตรฐานสากล ไร้การดัดแปลง</strong> ตามที่ค่ายตั้งมาเอง
      ผลที่ตามมาตรงไปตรงมา คือคนที่ปั่นหลักสิบกับคนที่ปั่นหลักหมื่นยืนอยู่บนกลไกชุดเดียวกันเป๊ะ ๆ สิ่งที่ต่างกันได้มีแค่โปรที่แต่ละคนเลือกกดรับ ไม่ใช่ตัวเกม
      และเพราะทุกอย่างวางอยู่บนตัวเลขที่ค่ายประกาศไว้แล้ว เราจึงไม่มีเหตุผลต้องพูดถึงสูตร ช่วงเวลาแตกดี หรืออะไรทำนองนั้นเลยสักคำเดียว
    </p>
  </ContentBox>

  <ContentBox title="ค่ายที่เราเลือกให้ลงฟลอร์ PG Soft, Pragmatic Play, SA Gaming และ Evolution" as="h2">
    <p class="text-left text-base leading-relaxed">
      แทนที่จะกวาดทุกค่ายที่เชื่อมได้เข้ามาให้ดูเยอะไว้ก่อน เราเลือกเปิดเฉพาะค่ายที่ทำงานคนละด้านและทำได้ดีจริงในด้านนั้น
      <strong class="text-[#e4bb53]">PG Soft และ Pragmatic Play</strong> ดูแลฝั่งสล็อต ส่วน <strong class="text-[#e4bb53]">SA Gaming กับ Evolution</strong> ดูแลฝั่งโต๊ะสด
      ทั้งสี่ค่ายอยู่บนกระเป๋าเงินเดียวกัน ผู้เล่นจึงไม่ต้องสมัครหลายยูส ไม่ต้องจำรหัสหลายชุด และไม่ต้องโยกเครดิตข้ามค่ายจนไม่แน่ใจว่ายอดค้างอยู่ตรงไหน
      ยอดที่เห็นบนหน้าจอคือยอดจริงที่ใช้ได้กับทุกเกมในเว็บ ไม่ใช่ยอดของค่ายใดค่ายหนึ่ง อยากสลับจากรีลไปโต๊ะกลางคืนเดียวก็กดข้ามได้ทันทีโดยไม่ต้องรออะไรเลย
    </p>
  </ContentBox>

  <ContentBox title="ฝั่งสล็อต ทำไมเราเลือกเกมที่มีตัวคูณสะสม ซื้อฟรีสปิน และ Cascading" as="h2">
    <p class="text-left text-base leading-relaxed">
      สล็อตสองตัวที่หน้ารีลคล้ายกันให้ความรู้สึกคนละแบบได้ทั้งหมดเพราะฟีเจอร์ที่อยู่ข้างใน เราจึงคัดเกมที่มีกลไกเด่นพอให้รู้สึกได้ตั้งแต่รอบแรกที่หมุน
      สามอย่างที่เจอบ่อยและเปลี่ยนเกมได้จริงคือ <strong class="text-[#e4bb53]">Multipliers ตัวคูณสะสม</strong> ที่ทบขึ้นไปเรื่อยระหว่างรอบ
      <strong class="text-[#e4bb53]">โหมดซื้อฟรีสปิน</strong> สำหรับคนไม่อยากรอเก็บสแกตเตอร์เอง และ <strong class="text-[#e4bb53]">Cascading</strong> ที่สัญลักษณ์ชนะร่วงหายแล้วให้ตัวใหม่ไหลลงมาแทน จนคอมโบแตกต่อกันได้หลายชั้นในสปินเดียว
      ข้อแลกเปลี่ยนของโหมดซื้อฟรีสปินเราไม่ปิดบัง คือกินทุนต่อครั้งหนักกว่าการปั่นปกติหลายเท่า จึงควรดูงบของวันนั้นก่อนกด ไม่ใช่กดเพราะปุ่มมันวางอยู่ตรงนั้นพอดี
    </p>
  </ContentBox>

  <ContentBox title="ฝั่งโต๊ะสด สัญญาณ Ultra HD กับบาคาร่า รูเล็ต ไฮโล และเสือมังกร" as="h2">
    <p class="text-left text-base leading-relaxed">
      คนที่มาคาสิโนออนไลน์ไม่ได้อยากเห็นแค่ผลลัพธ์ แต่อยากเห็นมือที่แจกไพ่ด้วย เราจึงเลือกเชื่อมสัญญาณไลฟ์ระดับ
      <strong class="text-[#e4bb53]">Ultra HD</strong> ที่ส่งตรงจากคาสิโนจริง ให้เห็นทั้งมือดีลเลอร์ ทั้งไพ่ ทั้งลูกรูเล็ต ในจังหวะเดียวกับที่มันเกิดขึ้นตรงหน้าโต๊ะ
      โต๊ะที่เปิดอยู่มีสี่แบบและเลือกมาให้ครอบคลุมคนละจังหวะการเล่น ตั้งแต่ <strong class="text-[#fceb83]">บาคาร่า</strong> ที่จบรอบไว
      <strong class="text-[#fceb83]">รูเล็ต</strong> ที่วางเดิมพันได้หลายชั้นในรอบเดียว <strong class="text-[#fceb83]">ไฮโล</strong> ที่อ่านง่ายตั้งแต่ตาแรก และ <strong class="text-[#fceb83]">เสือมังกร</strong> ที่ตัดสินกันในไพ่ใบเดียว
      ทั้งหมดอยู่บนกระเป๋าเงินเดียวกับฝั่งสล็อต ลุกจากหน้าสปินมานั่งโต๊ะได้เลยโดยไม่ต้องโยกเครดิตและไม่ต้องเปิดหน้าใหม่
    </p>
  </ContentBox>

  <ContentBox title="โปรที่กดรับได้จริง และระบบออโต้ 3 วินาทีที่ถอนเต็มจำนวน" as="h2">
    <p class="text-left text-base leading-relaxed">
      โปรโมชันบนเว็บนี้เขียนเงื่อนไขไว้ให้อ่านจบก่อนกด ไม่ใช่หลังกด รายการที่เปิดอยู่มีทั้งโบนัสต้อนรับสำหรับสมาชิกใหม่ โปรฝากแรกของวัน และ
      <strong class="text-[#e4bb53]">Cash Back คืนยอดเสียทุกวัน</strong> ทุกรายการ<strong class="text-[#fceb83]">ไม่ติดเทิร์นโอเวอร์มหาโหด</strong> เพราะเงื่อนไขที่ทำให้ถอนไม่ออกไม่ได้แปลว่าโปรนั้นใจกว้างขึ้น มันแค่ทำให้ตัวเลขบนแบนเนอร์ดูใหญ่ขึ้นเฉย ๆ
      ฝั่งการเงินเป็นงานที่เราเลือกให้เครื่องทำแทนคนทั้งหมด ทุกธุรกรรมประมวลผลผ่านระบบออโต้และเสร็จภายใน 3 วินาทีนับจากกดยืนยัน
      ไม่ต้องถ่ายสลิปส่งใคร ไม่ต้องรอแอดมินอนุมัติ และ<strong class="text-[#e4bb53]">ถอนได้เต็มจำนวน</strong>ตามยอดที่กด
      สิ่งที่ยังต้องตรวจด้วยตัวเองเหลืออยู่สองอย่าง คือผูกชื่อบัญชีให้ตรงกับข้อมูลสมาชิกตั้งแต่ตอนสมัคร และเข้าใช้งานผ่านลิงก์ที่ตรวจชื่อเว็บไซต์แล้วเท่านั้น
      ทั้งนี้ทุกเกมบนเว็บยังเป็นเกมที่ผลของแต่ละรอบเป็นอิสระจากกันเสมอ การตั้งงบให้พอดีกับทุนของวันนั้นและหยุดเมื่อถึงขีดที่ตั้งไว้ ยังเป็นเรื่องสำคัญที่สุดที่เราอยากให้ถือติดตัวไว้
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
