---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// ASHTON168: ticker เป็น AnnouncementPremium ให้ตรงกับทั้งเว็บ เรียก <Announcement />
// เปล่าๆ เพราะ default message ของ variant นี้เป็นข้อความ ASHTON168 อยู่แล้ว
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 160.
const pageDescription =
  "เกี่ยวกับเรา ASHTON168 เว็บสล็อตที่วางโครงสร้างระบบหลังบ้านให้แน่น เชื่อมตรงเซิร์ฟเวอร์ค่ายชั้นนำ รันเกมลื่นไหลแม้คนเข้าพร้อมกันเยอะ ออโต้ไวทันใจตลอด 24 ชั่วโมง";

const pageTitle = "เกี่ยวกับเรา ASHTON168 | สล็อตระบบแน่น เกมพร้อมรัน ออโต้ไวทันใจ";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา ASHTON168";

// docx รอบนี้ไม่มีส่วน SUB-PAGES จึงไม่มีบอดี้สำเร็จรูปให้หน้านี้ — หัวข้อและ
// ย่อหน้าทั้งเจ็ดบล็อกด้านล่างเขียนขึ้นใหม่จากข้อเท็จจริงของแบรนด์ใน
// src/assets/content.txt (โครงสร้างระบบหลังบ้านที่เสถียรและเชื่อมตรงเข้า
// เซิร์ฟเวอร์หลักของค่ายเกมยักษ์ใหญ่ คลังเกมตัวตึงที่คัดจากอัตราการจ่ายที่ได้
// มาตรฐาน การจัดหมวดหมู่เกมให้ค้นเจอไว ระบบออโต้ที่ฝากถอนจบเองในไม่กี่วินาที
// โดยไม่ต้องส่งสลิปและไม่ต้องรอแอดมินอนุมัติ และไลน์อัปโปรโมชันกับกิจกรรมที่
// หมุนเวียนมาเติมทุกวัน) — ไม่ลอกย่อหน้าใน docx มาทั้งดุ้น เพราะย่อหน้าชุดนั้น
// ใช้เต็ม ๆ อยู่บนหน้าแรกแล้ว โครงยังเป็น h1×1 + h2×6 เท่าเดิม
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="text-left text-base leading-relaxed">
      ASHTON168 คือแพลตฟอร์มสล็อตออนไลน์ที่ตั้งต้นจากโจทย์เดียวว่า ทำอย่างไรให้ผู้เล่นไม่ต้องมาลุ้นว่าระบบจะทำงานไหวหรือไม่ในจังหวะสำคัญ เราจึงลงแรงกับโครงสร้างหลังบ้านก่อนสิ่งอื่น เพราะเกมภาพสวยแค่ไหนก็ไม่มีความหมายถ้ามันค้างกลางรอบโบนัส
      สิ่งที่เราถือเป็นงานหลักจึงมีสามเรื่อง คือระบบที่เชื่อมตรงเข้าเซิร์ฟเวอร์หลักของค่ายเกมยักษ์ใหญ่และรันได้แน่นแม้คนเข้าพร้อมกันเยอะ ล็อบบี้ที่รวมเกมตัวตึงไว้ครบและจัดหมวดให้หาเจอไว และระบบออโต้ที่ปิดงานฝากถอนให้จบเองในไม่กี่วินาทีตลอด 24 ชั่วโมง
    </p>
  </ContentBox>

  <ContentBox title="แนวคิดตั้งต้นของ ASHTON168 ทำไมเราวางระบบให้แน่นมาก่อนเรื่องอื่น" as="h2">
    <p class="text-left text-base leading-relaxed">
      คำว่าระบบแน่นในชื่อแบรนด์ไม่ได้หมายถึงหน้าเว็บที่เพิ่งทำใหม่ แต่หมายถึงการวางเสถียรภาพให้อยู่ในระดับที่ผู้เล่นไม่ต้องคิดถึงมันเลย นักเดิมพันยุคนี้เปิดเกมจากมือถือเป็นหลัก สลับค่ายบ่อย และลงเดิมพันในช่วงเวลาที่คนออนไลน์พร้อมกันหนาแน่นที่สุด ระบบจึงต้องรับแรงตรงนั้นให้ไหว
      เราวัดตัวเองด้วยสิ่งที่ผู้เล่นรู้สึกได้จริง ทั้งความนิ่งของเกมตอนคนใช้งานพร้อมกันเยอะ เวลาที่ใช้ตั้งแต่กดเลือกเกมจนภาพขึ้น และเวลาที่ยอดเงินวิ่งเข้าบัญชีหลังกดถอน มากกว่าจะวัดด้วยจำนวนเกมในล็อบบี้เพียงอย่างเดียว
    </p>
  </ContentBox>

  <ContentBox title="โครงสร้างหลังบ้านที่เชื่อมตรงเข้าเซิร์ฟเวอร์หลักของค่ายชั้นนำ" as="h2">
    <p class="text-left text-base leading-relaxed">
      เบื้องหลังล็อบบี้ของ ASHTON168 คือโครงสร้างระบบหลังบ้านที่วางมาให้เสถียรและรองรับการเชื่อมต่อตรงเข้าสู่เซิร์ฟเวอร์หลักของค่ายเกมยักษ์ใหญ่ทั่วโลก ไม่มีชั้นกลางที่ต้องส่งต่อข้อมูลอีกทอด ตัวระบบจึงพร้อมรันทุกเกมสล็อตได้สมูธ กราฟิกแสดงผลคมชัดเต็มประสิทธิภาพ และเอฟเฟกต์เสียงมาครบตามที่ค่ายออกแบบไว้
      สิ่งที่เห็นผลชัดที่สุดคือช่วงเวลาที่มีผู้เข้าใช้งานพร้อมกันจำนวนมาก ซึ่งเป็นจังหวะที่ระบบทั่วไปมักเริ่มหน่วง ระบบของเรารองรับได้โดยไม่มีอาการเกมค้างหรือหลุดระหว่างลุ้นโบนัสก้อนโต และนั่นคือเรื่องที่ไม่มีใครสังเกตตอนสมัคร แต่เป็นเหตุผลที่ทำให้อยู่กับเว็บได้ยาว ๆ
    </p>
  </ContentBox>

  <ContentBox title="รวมเกมตัวตึงจากค่ายชั้นนำไว้ครบวงจร คัดจากอัตราการจ่ายที่ยุติธรรม" as="h2">
    <p class="text-left text-base leading-relaxed">
      ภายในล็อบบี้ของเรารวบรวมเกมสล็อตตัวตึงกระแสแรงจากค่ายชั้นนำระดับโลกไว้แบบครบวงจร ทั้งค่ายสายภาพสวย 3D ค่ายสายแตกโหดตัวคูณเยอะ และค่ายยอดนิยมตลอดกาลที่คนไทยเล่นกันจนคุ้นมือ ผู้เล่นจึงกดเลือกเกมฮิตทำเงินได้ทันทีโดยไม่ต้องเสียเวลาไล่หาจากหลาย ๆ เว็บ
      เกณฑ์ที่เราใช้คัดไม่ใช่ความสวยของหน้าปก แต่เป็นอัตราการจ่ายเงินรางวัลที่ได้มาตรฐานยุติธรรมและเงื่อนไขการเข้าโบนัสที่แสดงไว้ชัดเจนบนหน้าเกม เกมเดียวกันจึงให้ประสบการณ์เดียวกับที่คุณเคยเล่นจากที่อื่น ทั้งกลไกฟีเจอร์และตารางการจ่าย เพราะมันคือเกมเดียวกันจริง ๆ
    </p>
  </ContentBox>

  <ContentBox title="จัดหมวดเกมให้เลือกง่าย เจอตัวที่ใช่ไวโดยไม่ต้องค้นหลายรอบ" as="h2">
    <p class="text-left text-base leading-relaxed">
      หน้าเว็บของ ASHTON168 ดีไซน์มาเพื่อตอบโจทย์ผู้เล่นโดยเฉพาะ เกมทั้งหมดถูกจัดหมวดหมู่ไว้อย่างเป็นระเบียบชัดเจน แยกตามประเภทเกม ตามค่ายเกม และตามหมวดเกมยอดฮิต ผู้เล่นจึงค้นหาและเจอเกมที่ตรงกับสไตล์การเล่นของตัวเองได้อย่างรวดเร็ว
      ไม่ว่าจะอยากเปลี่ยนแนวไปปั่นเกมใหม่ ๆ หรือย้อนกลับมาเล่นเกมโปรดที่คุ้นมือ ก็ทำได้ในไม่กี่คลิกโดยไม่ต้องค้นวนหลายรอบ เมนูสำคัญอย่างปุ่มฝากถอน คลังเกม ค่ายเกม และหน้ากิจกรรม ก็ถูกวางตำแหน่งไว้ให้กดหยิบใช้ได้ทันทีในจังหวะเดียว
    </p>
  </ContentBox>

  <ContentBox title="ระบบออโต้ไฮสปีด ฝากถอนจบเองในไม่กี่วินาทีตลอด 24 ชั่วโมง" as="h2">
    <p class="text-left text-base leading-relaxed">
      เรื่องความเร็วในการจัดการธุรกรรมเป็นส่วนที่เราตัดขั้นตอนซับซ้อนออกทั้งหมด การฝากและถอนเงินดำเนินการได้เองง่าย ๆ ผ่านหน้าเว็บในไม่กี่วินาที ยอดเงินอัปเดตไวและแม่นยำตรงเป๊ะ โดยไม่ต้องส่งสลิปยืนยันและไม่ต้องเสียเวลารอแอดมินอนุมัติ ทุกจังหวะการเดิมพันจึงลื่นไหลตั้งแต่ต้นจนจบ
      ผลที่ตามมาคือคุณบริหารทุนได้ตามแผนของตัวเองจริง ๆ อยากเติมเพิ่มระหว่างรอบก็ทำได้ทันที อยากถอนกำไรออกไปใช้ก็ไม่ต้องรอรอบอนุมัติของใคร ระบบทำงานให้ตลอด 24 ชั่วโมง ไม่ว่าจะเป็นตีหนึ่งของวันธรรมดาหรือช่วงพีคของวันหยุดยาว
    </p>
  </ContentBox>

  <ContentBox title="โปรโมชันและสิทธิพิเศษที่เติมให้ตามต่อ กับความรับผิดชอบที่มาคู่กัน" as="h2">
    <p class="text-left text-base leading-relaxed">
      ไลน์อัปโปรโมชันของเราคิดมาเพื่อรองรับผู้เล่นทุกรูปแบบ ทั้งสิทธิประโยชน์สำหรับสมาชิกใหม่ที่เพิ่งเริ่มต้น โบนัสเติมเงินรายวันสำหรับสายลุยต่อเนื่อง และสิทธิ์รับเครดิตพิเศษตามช่วงเวลา นอกจากนั้นยังมีกิจกรรมคืนยอดเสียประจำวัน โค้ดเครดิตฟรีตามเทศกาล และระบบสะสมแต้มแลกรางวัลหมุนเวียนมาเติมให้ตามต่อได้ไม่ขาดสาย
      สิ่งที่มาคู่กับความคุ้มคือเรื่องที่ยังต้องตรวจด้วยตัวเอง ทั้งการผูกชื่อบัญชีธนาคารให้ตรงกับข้อมูลสมาชิก การอ่านเพดานและรอบเวลาของโปรโมชันแต่ละรายการก่อนกดรับ และการเข้าใช้งานผ่านทางเข้าลิงก์ตรงที่ตรวจชื่อเว็บไซต์แล้วเท่านั้น ทั้งนี้สล็อตเป็นเกมที่ผลลัพธ์สุ่มทุกรอบ การตั้งงบต่อสปินให้พอดีกับทุนของวันนั้นยังสำคัญที่สุด
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
