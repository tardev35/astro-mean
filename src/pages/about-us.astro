---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 155.
const pageDescription =
  "เกี่ยวกับ THUNDER87 เว็บสล็อตฟอร์มฟาดที่ขนเกมค่ายดังมาลงแน่นไม่หวง ครบทั้งสล็อต คาสิโนสด และบาคาร่าในยูสเซอร์เดียว ระบบประมวลผลแรง ฝากถอนออโต้ไม่ผ่านคนกลาง";

const pageTitle = "เกี่ยวกับ THUNDER87 สล็อตฟอร์มฟาด เกมครบแบบไม่หวง ระบบแรงออโต้ไว";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// เหลืองสายฟ้าไล่ไปหาทองเข้ม — ชุดเดียวกับที่ ContentBox ใช้กับหัวข้อของตัวเอง
const headingClass = "mt-8 mb-6 bg-gradient-to-r from-[#fff89a] via-[#fae61c] to-[#dcb309] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed">
        THUNDER87 เกิดขึ้นเพื่อยกระดับความมันส์ให้พุ่งทะลุพิกัด ด้วยแนวคิดของเว็บสล็อตสายดุดันที่พร้อมฟาดทุกวงการด้วยความครบเครื่อง
        ไม่ต้องทนกับความจำเจของระบบเดิม ๆ อีกต่อไป เพราะที่นี่ขนความบันเทิงระดับพรีเมียมมาให้สัมผัสกันแบบจัดเต็ม
        ทั้งความอลังการของตัวเกม ความรวดเร็วของระบบออโต้ และจังหวะการแจกรางวัลที่มาแบบไม่หวง
        ไม่ว่าคุณจะเป็นสายปั่นมือใหม่หรือเซียนเก๋าเกม แค่ได้ก้าวเข้ามาสัมผัสบรรยากาศความสนุกที่นี่ ก็พร้อมเปิดประตูสู่อีกระดับของการทำกำไรที่ไร้ขีดจำกัดแล้ว
      </p>

      <h2 class={headingClass}>ขนเกมค่ายดังมาลงแน่น ล็อบบี้ครบทั้งสล็อต คาสิโนสด และบาคาร่า</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        เรารวมเอารายชื่อค่ายเกมชั้นนำระดับโลกมาไว้ในที่เดียว ไม่ว่าจะเป็นค่ายใหญ่ในกระแสหรือค่ายดังเฉพาะกลุ่ม
        ทุกเกมถูกคัดสรรมาอย่างพิถีพิถันเพื่อตอบโจทย์สายสปินที่ต้องการงานภาพคมชัดและอัตราการจ่ายที่สมน้ำสมเนื้อ เล่นได้ยาว ๆ ไม่มีคำว่ากั๊กฟีเจอร์
        และไม่ได้มีดีแค่เรื่องสล็อต เพราะล็อบบี้ถูกดีไซน์มาให้อยู่ในรูปแบบอาณาจักรความบันเทิงแบบครบวงจร อยากสลับอารมณ์จากการปั่นวงล้อไปลุ้นหน้าไพ่บาคาร่า
        หรือสัมผัสความตื่นเต้นกับคาสิโนสดถ่ายทอดตรง ก็ทำได้ทันทีในยูสเซอร์เดียว ไม่ต้องเสียเวลาโยกเงินหรือสมัครหลายบัญชีให้ยุ่งยาก
      </p>

      <h2 class={headingClass}>ระบบประมวลผลแรงและเสถียร เข้าเกมคล่องสลับค่ายไวไม่มีกระตุก</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        เรื่องเทคโนโลยีเบื้องหลังคือจุดขายที่ทำให้ THUNDER87 ยืนหนึ่งในใจนักเล่น ด้วยระบบการประมวลผลที่แรงและเสถียรที่สุด
        สามารถกดเข้าเกมได้ฉับไว ตอบสนองทันทีที่คลิก การสลับเปลี่ยนค่ายเกมทำได้อย่างลื่นไหลไม่มีกระตุก หมดปัญหาหน้าจอค้างหรือเกมหลุดระหว่างลุ้นโบนัส
        ให้คุณดื่มด่ำกับความสนุกได้อย่างต่อเนื่องไม่มีสะดุดแม้แต่วินาทีเดียว และไม่ว่าจะเข้าใช้งานช่วงเช้า สาย บ่าย หรือดึก
        ตัวเกมยังคงรักษามาตรฐานการจ่ายรางวัลอย่างเที่ยงตรง จังหวะโบนัสแตกและฟีเจอร์พิเศษพร้อมทำงานตลอดเวลา
      </p>

      <h2 class={headingClass}>ฝากถอนออโต้ไม่ผ่านคนกลาง ปักหลักเล่นเกมโปรดที่เดียวจบ</h2>

      <p class="text-left text-base leading-relaxed">
        ความสบายใจเรื่องการเงินคือเรื่องสำคัญที่สุด เราจึงพัฒนาระบบการเงินออโต้ให้มีความแม่นยำและรวดเร็วสูงสุด
        ไม่ว่าจะฝากเงินเพื่อเติมทุนลุยต่อ หรือถอนกำไรก้อนโตเข้าบัญชี ทุกขั้นตอนถูกจัดการอย่างเรียบร้อยภายในเวลาอันสั้น ไร้ความซับซ้อน ไม่ต้องผ่านคนกลาง
        ให้คุณมั่นใจได้เต็มร้อยว่าทุกบาททุกสตางค์จะถูกจัดการอย่างตรงไปตรงมา และหากคุณกำลังมองหาพื้นที่เล่นเกมระยะยาวที่ไม่ต้องคอยย้ายเว็บหนีปัญหา
        THUNDER87 คือคำตอบสุดท้ายที่รวมทุกอย่างเอาไว้ครบ ทั้งความอุดมสมบูรณ์ของตัวเกม ความเสถียรของระบบ และบริการที่จริงใจ
        ปักหลักเล่นที่นี่ที่เดียวจบ ได้ทั้งความสนุก ได้ทั้งความคุ้มค่า
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
