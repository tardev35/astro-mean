---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 156.
const pageDescription = "เกี่ยวกับเรา ORCA789 เว็บเดียวที่รวมสล็อต บาคาร่าสด และแทงบอลไว้ครบ คัดเกมเด็ดเข้าล็อบบี้ต่อเนื่อง ระบบเสถียรไม่หน่วง ฝากถอนออโต้จบใน 3 วินาที เอาอยู่ทุกสาย";

const pageTitle = "เกี่ยวกับเรา ORCA789 | สล็อต บาคาร่าสด แทงบอล ครบเว็บเดียว";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา ORCA789 เว็บเดียวที่รวมสล็อต บาคาร่าสด และแทงบอลไว้ครบทุกสาย";

// หัวข้อของหน้านี้เขียนขึ้นใหม่ในมุม "เกี่ยวกับเรา" ไม่ได้ยกย่อหน้าจาก docx
// มาซ้ำกับหน้าแรก ข้อเท็จจริงทุกข้อยังมาจากบรีฟชุดเดียวกัน
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <p class="text-left text-base leading-relaxed">
        ORCA789 เริ่มต้นจากโจทย์สั้นๆ ว่าคนหนึ่งคนไม่ควรต้องเปิดสามเว็บเพื่อความบันเทิงสามแบบ สายปั่นสล็อตอยากสลับไปนั่งโต๊ะบาคาร่าสัก
        ครึ่งชั่วโมง หรืออยากแทงบอลคู่ดึกต่อ ก็ควรทำได้จบในที่เดียวโดยไม่ต้องโยกเงินไปมาให้ยุ่งยาก
        เราจึงรวมความตื่นเต้นครบทุกมิติมาเสิร์ฟไว้ในเว็บเดียว ทั้งสล็อตตัวฮิตกระแสแรง บาคาร่าสด คาสิโน และแทงบอลออนไลน์
        หน้านี้เขียนไว้บอกว่าเรายืนอยู่บนอะไรบ้าง ทั้งความหมายของคำว่าเว็บเดียวเอาอยู่ที่เราใช้เรียกตัวเอง วิธีคัดเกมเข้าล็อบบี้
        เหตุผลที่เราลงแรงกับความเสถียรของระบบมากเป็นพิเศษ และมาตรฐานที่เราตั้งไว้กับเรื่องการเงิน คนที่กำลังชั่งใจอยู่ควรอ่านจบแล้วรู้ว่ากำลังคุยอยู่กับเว็บแบบไหน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เว็บเดียวเอาอยู่ทุกสาย แปลว่าอะไรในแบบของ ORCA789" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        คนส่วนใหญ่วัดเว็บเดิมพันกันที่อัตราการแตกของเกมฮิตเป็นหลัก ซึ่งไม่ผิด แต่เราคิดว่ามันเล่าได้ไม่หมด เพราะสิ่งที่ทำให้คนอยู่กับเว็บได้ยาวๆ คือการไม่ต้องย้ายไปไหนอีกเลย
        คำว่าครบเครื่องที่เราใช้จึงไม่ใช่คำโฆษณา แต่เป็นเกณฑ์ที่ใช้ตัดสินใจจริง ตั้งแต่การเปิดโหมดให้ครบทั้งสล็อต บาคาร่าสด คาสิโน และกีฬา
        ไปจนถึงการวางให้ทุกโหมดอยู่ในยูสเซอร์เดียว สลับอารมณ์ไปเล่นอีกฝั่งได้ทันทีโดยไม่ต้องเปลี่ยนบัญชีหรือรอโอนยอดข้ามกระเป๋า
        ผลที่ตั้งใจให้เกิดคือคนที่เข้ามาเพื่อผ่อนคลายก็ได้ผ่อนคลายจริง ส่วนคนที่ตั้งใจมาลุยทำกำไรจริงจังก็ยังได้ของที่ต้องการครบ โดยไม่ต้องเลือกอย่างใดอย่างหนึ่ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ล็อบบี้ที่คัดแต่ตัวเด็ด แล้วเติมเกมใหม่เข้ามาให้ลองไม่ให้จำเจ" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        เรื่องที่คนพูดถึงน้อยที่สุดแต่เจอทุกครั้งที่เปิดเว็บคือหน้าล็อบบี้ ถ้าจัดไม่ดี คลังใหญ่แค่ไหนก็กลายเป็นกำแพงรูปเกมที่เลื่อนหาอะไรไม่เจอ เราจึงเลือกคัดมากกว่าเลือกกวาด
        เกมที่ได้อยู่หน้าล็อบบี้ต้องเป็นตัวเด็ดแตกหนักที่คัดมาจากทุกค่ายชั้นนำ ทั้งเกมธีมแฟนตาซีตระการตา เกมแนวสตรีทสุดเท่ และเกมสไตล์คลาสสิกโบนัสแตกง่าย
        อีกครึ่งหนึ่งของงานคือการไม่ปล่อยให้ล็อบบี้นิ่ง ทีมงานจึงอัปเดตไลน์อัปเกมใหม่เข้าสู่ระบบอย่างต่อเนื่อง ค่ายดังออกเกมอะไรใหม่มา สมาชิกที่นี่จะได้สัมผัสและทดลองเล่นเป็นกลุ่มแรกๆ เสมอ
        หน้าล็อบบี้จึงสดใหม่อยู่ตลอดเวลาโดยที่คนซึ่งมาปั่นเกมตัวตึงประจำก็ยังเปิดหาเจอได้ทันที อยากเปลี่ยนไปลุ้นเกมฟีเจอร์แปลกใหม่เมื่อไหร่ก็แค่คลิกเลือกเล่นได้เลย
      </p>
    </div>
  </ContentBox>

  <ContentBox title="บาคาร่าสดและเดิมพันฟุตบอล สองโหมดที่อยู่ในยูสเซอร์เดียวกัน" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        เราไม่ได้มองว่าสล็อตคือทั้งหมดของเว็บ เพราะอารมณ์ของคนเล่นเปลี่ยนได้ในวันเดียวกัน บางจังหวะอยากได้ความเร็วของวงล้อ บางจังหวะอยากได้จังหวะช้าลงและมีคนแจกไพ่อยู่ตรงหน้า
        ฝั่งบาคาร่าของเราจึงเป็นการยิงตรงสัญญาณสดความละเอียดสูงระดับ HD จากคาสิโนจริง เห็นมือดีลเลอร์เปิดไพ่ตรงหน้าแบบเรียลไทม์ ไม่ใช่ภาพจำลองที่ตัดต่อมาให้ดู
        ส่วนโหมดเดิมพันฟุตบอลเปิดราคาน้ำดี ค่าน้ำกว้าง และมีลีกให้เลือกครอบคลุมทั่วโลก สำหรับคนที่ตามบอลอยู่แล้วและอยากได้อีกจอไว้ลุ้นคู่กัน
        ที่สำคัญคือทั้งสองโหมดอยู่ในยูสเซอร์เดียวกับสล็อต สลับไปเล่นได้ทันทีโดยไม่ต้องเสียเวลาโยกเงินให้ยุ่งยาก และไม่ต้องจำรหัสผ่านเพิ่มอีกชุด
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ระบบเสถียรไม่หน่วง คือส่วนที่เราลงแรงมากที่สุดแต่ควรรู้สึกได้น้อยที่สุด" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        จุดที่ผู้เล่นบอกเราบ่อยที่สุดว่าติดใจ ไม่ใช่ฟีเจอร์ที่หวือหวา แต่คือความฉับไวของระบบหลังบ้านตอนกดสลับเกมหรือสลับโหมด นี่คือส่วนที่เราใส่ใจพัฒนาอย่างสม่ำเสมอที่สุด
        ตัวระบบถูกปรับจูนให้มีความเสถียรสูงสุด รองรับการใช้งานพร้อมกันของสมาชิกจำนวนมากได้โดยไม่หน่วง ไม่กระตุก และไม่มีปัญหาเกมหลุดกลางคันระหว่างที่กำลังลุ้นโบนัสอยู่
        การเข้าสู่ระบบ การสลับค่ายเกม หรือการเลือกโหมดต่างๆ จึงทำได้อย่างฉับไวไร้รอยต่อ ช่วยรักษาจังหวะการทำกำไรให้ไหลลื่นต่อเนื่องตลอดวัน
        เรื่องนี้ฟังดูเป็นงานเบื้องหลังที่ไม่มีใครเห็น และนั่นคือความตั้งใจ เพราะความเร็วที่ทำได้ดีจริงจะไม่มีใครสังเกตเห็น คนจะสังเกตก็ต่อเมื่อมันช้าเท่านั้น
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ฝากถอนออโต้จบใน 3 วินาที เพราะเวลาที่นั่งรอไม่ใช่ส่วนหนึ่งของความสนุก" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        เรื่องระบบการเงินเป็นมาตรฐานที่เราตั้งไว้สูงที่สุด เพราะเป็นจุดเดียวที่ทำให้คนเลิกสนุกได้ทันทีถ้าทำพลาด ระบบฝากถอนของที่นี่เป็นออโต้ไฮสปีดที่ทำรายการเสร็จสรรพภายใน 3 วินาทีเท่านั้น
        ไม่ว่าจะเป็นการเติมทุนเข้าไปลุยต่อในจังหวะที่กำลังมา หรือการถอนยอดกำไรก้อนโตกลับเข้าบัญชีหลังจบเกม ก็จัดการได้ด้วยตัวเองง่ายๆ บนหน้าเว็บตลอดเวลา
        ไม่ต้องส่งสลิปยืนยันให้ใครดู และไม่ต้องนั่งรอแอดมินกดอนุมัตินานจนเสียอารมณ์ ทุกขั้นตอนจบได้เองในไม่กี่คลิก
        สิ่งที่ตามมาพร้อมความคล่องตัวคือความปลอดภัยสูงในทุกธุรกรรม เพราะรายการที่ระบบทำเองทั้งหมดคือรายการที่ตรวจย้อนได้และไม่มีคนกลางมาแตะยอดของสมาชิกระหว่างทาง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="เลือกโหมดที่ใช่ แล้วเริ่มสนุกกับ ORCA789 ได้ตั้งแต่รอบแรก" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        สุดท้ายแล้วเราอยากให้ ORCA789 เป็นพื้นที่ความบันเทิงที่ตอบโจทย์นักเดิมพันได้ครบทุกสไตล์อย่างแท้จริง ไม่ว่าจะเป็นสายสล็อตที่ตั้งใจไล่ตามฟีเจอร์และแจ็คพอตเป็นหลัก
        สายคาสิโนสดที่ชอบบรรยากาศโต๊ะบาคาร่าและมือดีลเลอร์จริง หรือสายกีฬาที่ตามบอลอยู่ทุกสัปดาห์อยู่แล้ว ทั้งสามแบบควรหาที่ทางของตัวเองได้ในเว็บเดียวโดยไม่ต้องย้ายไปไหน
        ส่วนงานที่เหลือเป็นของเรา ทั้งการดูแลระบบให้เสถียรและรวดเร็ว การรักษาความปลอดภัยของทุกธุรกรรม และการทำให้ทุกอย่างตั้งแต่สมัครสมาชิกจนถึงกดรับสิทธิ์จบได้เองบนหน้าเว็บโดยไม่ต้องรอใครกดอนุมัติ
        คนที่ยังไม่แน่ใจ ลองเปิดโหมดทดลองเล่นดูก่อนก็ได้ เพราะเราเชื่อว่าคำว่าเว็บเดียวเอาอยู่เป็นเรื่องที่ต้องลองเองถึงจะรู้ มากกว่าจะอ่านจากหน้าเกี่ยวกับเราหน้านี้
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
