---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// CK1968: ticker หมุนมาเป็น Announcement3 ส่วนกล่องหน้าย่อยยังเป็น ContentBox
// (การ์ดถาวรของหน้าย่อย) เรียก <Announcement /> เปล่า ๆ เพราะ default message ของ
// variant นี้ถูกตั้งให้ตรงกับที่หน้าแรกส่งเข้าไปแล้ว
// สีย้ายจากทองแอนทีคอมน้ำผึ้งคู่กราไฟต์ของแบรนด์ก่อน มาเป็นทองคำคู่แดงเลือดหมูบน
// ดำอมน้ำตาล — เน้นข้อความด้วยทองสว่าง #ffd45c ทองหลัก #f0a80c และแดงสว่าง
// #ff4b52 สามสีนี้วัดคอนทราสต์บนผิว #170806 ของการ์ดแล้วผ่าน AA สบาย ส่วนแดงหลัก
// #d4090f กับทองเข้ม #a76806 / #5d3a05 และขอบ #4d1f0d ใช้เป็นพื้น ขอบ และปลาย
// gradient เท่านั้น ไม่ใช้กับตัวอักษรขนาดเนื้อความ สีเนื้อความหลักมาจากการ์ดเอง
// (#f6e4c0) จึงไม่ต้องระบุซ้ำ
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 155, and is one
// sentence about what the page is for rather than a table of contents.
const pageDescription =
  "หน้าแนะนำตัวของ CK1968 สล็อตเว็บตรงแบรนด์แท้ 100% ว่าเราเป็นใคร ดูแลความปลอดภัยของสมาชิกอย่างไร และยึดอะไรเป็นมาตรฐานในการให้บริการและการจ่ายเงินรางวัลจริง";

const pageTitle = "เกี่ยวกับเรา CK1968 | สล็อตเว็บตรง แบรนด์แท้ 100% ปลอดภัย จ่ายจริง";

// หัวข้อระดับ h1 ของหน้า แยกจากค่า title เพราะ title มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา CK1968";

// docx รอบนี้ไม่มีส่วน SUB-PAGES จึงไม่มีบอดี้สำเร็จรูปให้หน้านี้ — หัวข้อและ
// ย่อหน้าทั้งหกบล็อกด้านล่างเขียนขึ้นใหม่จากข้อเท็จจริงของแบรนด์ในบรีฟรอบนี้
// (ผู้ให้บริการลิขสิทธิ์แท้ที่ส่งตรงเกมจากค่ายดังทั่วโลก · ระบบ API แท้จาก
// เซิร์ฟเวอร์หลักของค่ายเกมโดยตรง ค่า RTP เป็นมาตรฐานสากล ไม่แอบปรับลด
// เปอร์เซ็นต์การชนะ · ระบบรักษาความปลอดภัยระดับสูง ข้อมูลและประวัติธุรกรรมเป็น
// ความลับ ไม่ล็อคยูสเซอร์เมื่อเล่นได้กำไรก้อนโต · ระบบ AI จัดการธุรกรรมการเงิน
// อัตโนมัติเต็มรูปแบบ เข้ากระเป๋าในไม่กี่วินาที · ฝากถอนไม่มีขั้นต่ำ ทุนหลักสิบ
// หรือหลักหมื่นก็เท่าเทียมกัน · หลังบ้านเสถียร รองรับพร้อมกันนับหมื่นคน เกมแตก
// ง่ายจริงตามสถิติ มีฟีเจอร์ใหม่อัปเดตก่อนใคร · จ่ายจริงเต็มจำนวนทุกบาททุก
// สตางค์ ไม่หักค่าธรรมเนียม ไม่แบ่งจ่ายเป็นงวด ไม่ต้องทำเทิร์นโอเวอร์ซ้ำซ้อน)
// — ไม่ลอกย่อหน้าในบรีฟมาทั้งดุ้น เพราะย่อหน้าชุดนั้นใช้เต็ม ๆ อยู่บนหน้าแรกแล้ว
// หน้านี้จึงเขียนคนละสำนวนในมุม "เราเป็นใคร" จากข้อเท็จจริงชุดเดียวกัน โครงเป็น
// h1×1 + h2×5 ไม่มี h3 และห้ามเติมข้อเท็จจริงที่บรีฟไม่ได้ให้ เช่น เลขใบอนุญาต
// จำนวนผู้เล่น รางวัล ชื่อธนาคาร ชื่อค่ายเกมที่บรีฟไม่ได้เอ่ยถึง หรือโต๊ะคาสิโนสด
// — บรีฟรอบนี้เป็นสล็อตล้วน ไม่มีฝั่งไลฟ์คาสิโน
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="text-left text-base leading-relaxed">
      <strong class="text-[#ffd45c]">CK1968</strong> เกิดขึ้นจากคำถามข้อเดียวว่า ในวงการเดิมพันออนไลน์ที่มีเว็บเปิดใหม่ทุกสัปดาห์ อะไรคือสิ่งที่ทำให้คนคนหนึ่งกล้าลงเงินก้อนแรกกับที่ไหนสักแห่ง
      คำตอบที่เราได้ไม่ใช่ภาพสวยหรือแบนเนอร์ตัวเลขใหญ่ ๆ แต่เป็นความมั่นใจว่าเกมที่กำลังหมุนอยู่ไม่ได้ถูกใครแตะ ยอดที่กดถอนจะเข้าจริง และบัญชีจะไม่ถูกปิดในวันที่เล่นได้
      เราจึงวางตัวเองเป็น<strong class="text-[#f0a80c]">สล็อตเว็บตรงแบรนด์แท้ 100%</strong> ในฐานะผู้ให้บริการลิขสิทธิ์แท้ที่รับเกมจากค่ายดังทั่วโลกมาเปิดให้เล่นเอง ไม่ได้เป็นเว็บเอเย่นต์ที่รับสัญญาณต่อจากใครอีกที
      หน้านี้เขียนไว้ให้อ่านก่อนตัดสินใจ ว่าเราเป็นใคร วางระบบไว้อย่างไร และยึดอะไรเป็นมาตรฐานในการดูแลสมาชิกทุกคนที่เลือกเดินเข้ามา
    </p>
  </ContentBox>

  <ContentBox title="ผู้ให้บริการลิขสิทธิ์แท้ที่ส่งเกมจากค่ายดังทั่วโลกมาถึงมือคุณเอง" as="h2">
    <p class="text-left text-base leading-relaxed">
      ปัญหาที่นักปั่นส่วนใหญ่ต้องเจอคือการหลงไปเล่นเว็บเอเย่นต์ที่ปรับอัตราการชนะเองหรือฝากถอนล่าช้า และปัญหานั้นเกิดจากโครงสร้าง ไม่ได้เกิดจากโชค เพราะเมื่อมีคนกลางยืนคั่นระหว่างผู้เล่นกับค่ายเกม ก็มีที่ให้แตะโดยปริยาย
      เราเลือกโครงสร้างที่ไม่มีชั้นกลางนั้นตั้งแต่วันแรก โดยเป็น<strong class="text-[#f0a80c]">ผู้ให้บริการลิขสิทธิ์แท้</strong>ที่ส่งตรงเกมจากค่ายดังทั่วโลกมาให้สมาชิกสัมผัสด้วยตัวเอง ทุกเกมบนฟลอร์นี้จึงเป็นของแท้จากเจ้าของเกม ไม่ใช่เกมเลียนแบบที่หน้าตาคล้ายกันแต่กลไกข้างในเป็นคนละเรื่อง
      สิ่งที่เราถือว่าเป็นงานของเราคือคัดของขึ้นฟลอร์ให้มีเชิงชั้น ดูแลทางเดินระหว่างปุ่มที่กดกับเซิร์ฟเวอร์ของค่ายให้สั้นที่สุด และเขียนเงื่อนไขทุกข้อให้อ่านจบได้ก่อนกด
      เกมที่นี่แตกง่ายจริงตามสถิติของตัวเกม และเมื่อค่ายปล่อยฟีเจอร์ใหม่ เราอัปเดตให้สมาชิกได้เล่นก่อนใคร เพราะเราต่อตรงกับต้นทางอยู่แล้ว ไม่ต้องรอใครส่งต่อมาให้อีกทอด
    </p>
  </ContentBox>

  <ContentBox title="ระบบ API แท้จากเซิร์ฟเวอร์หลัก กับค่า RTP ที่เราไม่แตะ" as="h2">
    <p class="text-left text-base leading-relaxed">
      การเล่นเกมสล็อตยุคนี้แค่ภาพสวยอย่างเดียวคงไม่พอ แต่ต้องอาศัยระบบหลังบ้านที่เสถียรด้วย เราจึงนำเข้า<strong class="text-[#f0a80c]">ระบบ API แท้จากเซิร์ฟเวอร์หลักของค่ายเกมโดยตรง</strong> คำสั่งที่สมาชิกกดจึงวิ่งไปบันทึกที่ค่ายแล้วส่งผลกลับมาตามที่ตัวสุ่มของค่ายตัดสินจริงในวินาทีนั้น
      ผลตามมาที่สำคัญที่สุดคือ อัตราการแตกหรือค่า RTP ที่สมาชิกได้สัมผัสเป็น<strong class="text-[#ffd45c]">มาตรฐานสากลจริง ๆ</strong> ตรงตามที่ค่ายผู้พัฒนาตั้งมา ไม่มีการแอบปรับลดเปอร์เซ็นต์การชนะ เพราะตัวเลขนั้นเป็นของค่าย ไม่ใช่ของเว็บ และระบบของเราก็ไม่ได้ถูกออกแบบให้เข้าไปยุ่งกับมันได้ตั้งแต่ต้น
      คนที่เบทเริ่มต้นหลักบาทกับคนที่ปรับยอดขึ้นสูงจึงยืนอยู่บนกลไกชุดเดียวกันเป๊ะ ๆ สิ่งที่ต่างกันได้มีแค่โปรที่แต่ละคนเลือกกดรับ ไม่ใช่ตัวเกม
      ด้านประสบการณ์ใช้งาน หลังบ้านที่เสถียรทำให้เล่นลื่นไหลไม่มีอาการกระตุกหรือหลุดออกจากเกมในจังหวะเข้าฟรีสปิน และรองรับผู้ใช้งานพร้อมกันนับหมื่นคนได้โดยที่เว็บไม่อืด ซึ่งเป็นจังหวะที่ระบบส่วนใหญ่มักพังพอดี
    </p>
  </ContentBox>

  <ContentBox title="ความปลอดภัยที่ทำให้คำว่าล็อกยูสเซอร์ไม่มีอยู่ในระบบของเรา" as="h2">
    <p class="text-left text-base leading-relaxed">
      สิ่งสำคัญที่สุดที่ทำให้นักลงทุนกล้าตัดสินใจลงเงินคือความน่าเชื่อถือ และเราเข้าใจดีว่าเรื่องที่ทุกคนกลัวที่สุดไม่ใช่การเสีย แต่คือการเล่นได้กำไรก้อนโตแล้วเข้าบัญชีไม่ได้ในวันรุ่งขึ้น
      เราจึงวางโครงสร้างแพลตฟอร์มด้วย<strong class="text-[#ff4b52]">ระบบรักษาความปลอดภัยระดับสูง</strong>ตั้งแต่ชั้นล่างสุด ข้อมูลส่วนตัวและประวัติการทำธุรกรรมของสมาชิกถูกเก็บเป็นความลับทั้งหมด ไม่ถูกส่งต่อและไม่ถูกเอาไปทำอย่างอื่น
      ที่สำคัญกว่านั้นคือ<strong class="text-[#ffd45c]">การล็อกยูสเซอร์ไม่ใช่นโยบายที่เราเลือกไม่ทำ แต่เป็นสิ่งที่ระบบทำไม่ได้</strong> เพราะผลของแต่ละรอบถูกตัดสินและบันทึกที่ค่ายเจ้าของเกม ไม่มีจุดใดตลอดเส้นทางที่ใครฝั่งเราจะเข้าไปหรี่บัญชีใครให้ต่างจากบัญชีอื่นได้
      สมาชิกจึงโฟกัสกับการปั่นสล็อตได้เต็มที่โดยไม่ต้องระแวงเรื่องตุกติก ซึ่งเป็นเหตุผลหลักที่กลุ่มคนที่อยู่ในวงการมานานและรู้ดีว่าเว็บไหนคือของจริง เลือกปักหลักทำกำไรกับเราอย่างต่อเนื่อง
    </p>
  </ContentBox>

  <ContentBox title="ระบบ AI ฝากถอนออโต้ กับเงื่อนไขไม่มีขั้นต่ำที่เปิดกว้างให้ทุกทุน" as="h2">
    <p class="text-left text-base leading-relaxed">
      งานฝากถอนเป็นงานที่เราตัดสินใจยกให้เครื่องทำแทนคนทั้งหมด เพราะการรอแอดมินตรวจสลิปคือจุดที่ทำให้จังหวะการเดิมพันขาดตอนและเสียอรรถรส เราจึงพัฒนา<strong class="text-[#f0a80c]">ระบบ AI สำหรับจัดการธุรกรรมการเงินแบบอัตโนมัติเต็มรูปแบบ</strong>ขึ้นมาแทน
      ทุกครั้งที่สมาชิกกดทำรายการ ระบบจะประมวลผลยอดเงินให้เข้ากระเป๋าภายในเวลาไม่กี่วินาที ไม่ว่าจะฝากเข้าเล่นตอนดึกหรือถอนเงินช่วงเช้าตรู่ก็ลื่นไหลไม่มีสะดุด ไม่ต้องถ่ายสลิปส่งใครและไม่ต้องรอใครอนุมัติ
      อีกครึ่งหนึ่งของเรื่องนี้คือเงื่อนไข เราเปิดกว้างให้สมาชิกบริหารจัดการเงินทุนของตัวเองได้อย่างอิสระผ่าน<strong class="text-[#ffd45c]">การฝากถอนที่ไม่มีข้อจำกัดขั้นต่ำ</strong> อยากฝากแค่ 1 บาทเพื่อปั่นสล็อตเล่นขำ ๆ หรืออยากถอนยอดเล็ก ๆ ออกไปใช้ก่อน ก็ทำรายการได้ด้วยตัวเองทันทีโดยไม่มีเงื่อนไขผูกมัด
      เราเชื่อว่าทุนหลักสิบกับทุนหลักหมื่นควรได้ลุ้นรางวัลใหญ่บนเงื่อนไขเดียวกัน ตัวเลขขั้นต่ำที่หลายที่ตั้งไว้ไม่ได้ทำให้ใครเล่นดีขึ้น มันแค่คัดคนออกเฉย ๆ
    </p>
  </ContentBox>

  <ContentBox title="คำมั่นของเราคือจ่ายจริงเต็มจำนวน ไม่หักเปอร์เซ็นต์ ไม่แบ่งงวด" as="h2">
    <p class="text-left text-base leading-relaxed">
      เป้าหมายสูงสุดของการเล่นสล็อตคือการถอนเงินรางวัลออกมาใช้ได้จริง ทุกอย่างที่เขียนมาข้างบนจะไม่มีความหมายเลยถ้าข้อนี้ไม่เกิดขึ้น เราจึงถือว่านี่คือคำมั่นสัญญาที่เรามีให้กับสมาชิก <strong class="text-[#ffd45c]">CK1968</strong> ทุกคน
      ไม่ว่าแจ็คพอตจะแตกหลักหมื่น หลักแสน หรือทะลุถึงหลักล้าน เรามีทุนสำรองมหาศาลพร้อม<strong class="text-[#ff4b52]">โอนจ่ายเต็มจำนวนทุกบาททุกสตางค์</strong> ไม่มีการหักค่าธรรมเนียม ไม่มีการแบ่งจ่ายเป็นงวด ๆ และไม่ต้องทำเทิร์นโอเวอร์ซ้ำซ้อนให้วุ่นวาย ชนะปุ๊บรับเงินเข้าบัญชีไปเลย
      เงื่อนไขที่ทำให้ถอนไม่ออกไม่ได้แปลว่าโปรนั้นใจกว้างขึ้น มันแค่ทำให้ตัวเลขบนแบนเนอร์ดูใหญ่ขึ้นเฉย ๆ เราจึงเลือกเขียนเงื่อนไขทุกข้อให้อ่านจบได้ก่อนกด ไม่ใช่หลังกด
      สิ่งที่ยังเป็นของผู้เล่นล้วน ๆ และเราอยากให้ถือติดตัวไว้คือ ผลของแต่ละรอบเป็นอิสระจากกันเสมอ การตั้งงบให้พอดีกับทุนของวันนั้นและหยุดเมื่อถึงขีดที่ตั้งไว้ ยังเป็นเรื่องสำคัญที่สุดเสมอ ไม่ว่าเว็บที่เล่นอยู่จะดีแค่ไหน
    </p>
