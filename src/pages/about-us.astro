---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// GUESS168: ticker หมุนมาเป็น AnnouncementPremium และกล่องหน้าย่อยหมุนมาเป็น
// ContentBox ตามสเปกรอบนี้ เรียก <Announcement /> เปล่า ๆ เพราะ default
// message ของ variant นี้ถูกตั้งเป็นข้อความของแบรนด์นี้แล้ว
// สีเน้นในย่อหน้าใช้ทอง #ffd54a ของพาเลตต์รอบนี้ ส่วนสีเนื้อความมาจากการ์ดเอง
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 157.
const pageDescription =
  "เกี่ยวกับเรา GUESS168 เว็บตรง API แท้ ยิงตรงจากเซิร์ฟเวอร์หลัก คัดสล็อตค่า RTP สูงจาก PG Soft Pragmatic Play และ Joker Gaming เบทเริ่มต้น 1 บาท ฝากถอนออโต้ไว";

const pageTitle = "เกี่ยวกับเรา GUESS168 | สล็อตคัดเกรด เว็บตรง API แท้ ฝากถอนออโต้ทันใจ";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา GUESS168";

// docx รอบนี้ไม่มีส่วน SUB-PAGES จึงไม่มีบอดี้สำเร็จรูปให้หน้านี้ — หัวข้อและ
// ย่อหน้าทั้งหกบล็อกด้านล่างเขียนขึ้นใหม่จากข้อเท็จจริงของแบรนด์ใน
// src/assets/content.txt (เว็บตรง API แท้ยิงตรงจากเซิร์ฟเวอร์หลักและไม่ดัดแปลง
// เปอร์เซ็นต์ชนะ คัดค่ายลิขสิทธิ์ PG Soft, Pragmatic Play และ Joker Gaming
// เบทเริ่มต้น 1 บาท เกมใหม่เข้าคลังภายใน 24 ชั่วโมงพร้อมโหมดทดลองเล่นฟรี
// ฟีเจอร์ Multiplier, Wild ซ้อนทับ, Cascading และ Bonus Buy โปรโมชันกดรับเอง
// พร้อม Cash Back คืนยอดเสียทุกวัน ฝากถอนออโต้ 3–5 วินาทีผ่าน Gateway ตรง และ
// กระเป๋าเดียวจบในแดชบอร์ดเดียว) — ไม่ลอกย่อหน้าใน docx มาทั้งดุ้น เพราะย่อหน้า
// ชุดนั้นใช้เต็ม ๆ อยู่บนหน้าแรกแล้ว โครงเป็น h1×1 + h2×6 ไม่มี h3
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="text-left text-base leading-relaxed">
      <strong class="text-[#ffd54a]">GUESS168</strong> ตั้งต้นจากความคิดง่าย ๆ ว่าการปั่นสล็อตควรวัดกันที่จังหวะของเกม ไม่ใช่ที่ความอดทนของคนเล่น เราจึงเลือกเดินทางเว็บตรงที่เชื่อมต่อผ่าน API แท้ ยิงตรงจากเซิร์ฟเวอร์หลักของค่าย ไม่มีการดัดแปลงเปอร์เซ็นต์ชนะระหว่างทาง สิ่งที่วงล้อจ่ายจึงเป็นค่าเดียวกับที่ค่ายตั้งไว้จริง
      หน้าที่ที่เหลือของเราคือคัดเกมค่า RTP สูงมาไว้ให้ครบมือ เปิดฟีเจอร์และโปรโมชันให้หยิบใช้ได้จริง แล้วให้ระบบออโต้รับงานฝากถอนไปทำแทนคนทั้งหมด เพื่อให้เวลาที่เคยหมดไปกับการรอ กลับมาอยู่กับการสปินแทน
    </p>
  </ContentBox>

  <ContentBox title="เว็บตรง API แท้ ยิงตรงจากเซิร์ฟเวอร์หลัก ไม่ดัดแปลงเปอร์เซ็นต์ชนะ" as="h2">
    <p class="text-left text-base leading-relaxed">
      คำว่าเว็บตรงในที่นี้หมายถึงการเชื่อมต่อกับค่ายเกมด้วย API แท้โดยไม่ผ่านตัวกลาง ทุกคำสั่งสปินวิ่งไปถึงเซิร์ฟเวอร์หลักของค่ายแล้วส่งผลกลับมาตามที่ค่ายคำนวณ นี่คือเหตุผลที่เราพูดได้เต็มปากว่าไม่มีการปรับเปอร์เซ็นต์ชนะของเกมใดเลย เพราะโครงสร้างแบบนี้ไม่มีจุดให้ใครเข้าไปแตะตรงกลาง
      ผลที่ตามมาคือค่า RTP ที่แสดงในตัวเกมเป็นค่าจริงที่ผู้เล่นได้รับ เราจึงคัดเฉพาะเกมที่อัตราจ่ายอยู่ในเกณฑ์สูงเข้าคลัง แล้วปล่อยให้ตัวเลขทำงานของมันเอง สิ่งที่เราการันตีได้คือความตรงไปตรงมาของระบบ ส่วนผลของแต่ละสปินยังเป็นการสุ่มตามกลไกของค่ายเสมอ
    </p>
  </ContentBox>

  <ContentBox title="คัดเฉพาะค่ายลิขสิทธิ์ PG Soft, Pragmatic Play และ Joker Gaming" as="h2">
    <p class="text-left text-base leading-relaxed">
      คลังเกมของเราไม่ได้เน้นจำนวน แต่เน้นว่าทุกเกมที่อยู่ในลิสต์ต้องมาจากค่ายที่มีมาตรฐานสากลจริง สามชื่อหลักที่เราเปิดให้เล่นคือ PG Soft ที่เด่นเรื่องงานภาพและกลไกแปลกใหม่ Pragmatic Play ที่ขึ้นชื่อเรื่องรอบโบนัสจ่ายหนัก และ Joker Gaming ที่ครองใจสายคลาสสิกมายาวนาน ทุกเกมผ่านการทดสอบอัตราจ่ายก่อนขึ้นคลัง
      อีกเรื่องที่ตั้งใจทำคือเปิดให้เบทเริ่มต้นที่ 1 บาท เพราะทุนของแต่ละคนไม่เท่ากัน คนที่อยากลองจังหวะเกมก่อนด้วยเงินก้อนเล็กจึงเข้าถึงเกมชุดเดียวกับสายทุนหนักได้ทั้งหมด ไม่มีเกมไหนถูกกันไว้ให้เฉพาะคนที่เบทสูง
    </p>
  </ContentBox>

  <ContentBox title="เกมใหม่เข้าคลังภายใน 24 ชั่วโมง พร้อมโหมดทดลองเล่นฟรี" as="h2">
    <p class="text-left text-base leading-relaxed">
      ค่ายใหญ่ปล่อยเกมใหม่ออกมาเมื่อไหร่ เราถือเป็นหน้าที่ที่ต้องอัปเดตเข้าคลังภายใน 24 ชั่วโมง สายปั่นที่ตามกระแสอยู่จึงไม่ต้องย้ายไปหาที่เล่นใหม่ทุกครั้งที่มีเกมฮิตโผล่ขึ้นมา และคนที่ชอบเป็นกลุ่มแรกที่ได้ลองก็ไม่ต้องรอให้เกมนั้นดังเสียก่อนถึงจะมีให้เล่น
      ทุกเกมในคลังเปิดโหมดทดลองเล่นฟรีไว้ให้ด้วย จุดประสงค์คือให้ผู้เล่นได้เช็กจังหวะโบนัส ความถี่ของฟรีสปิน และกลไกของแต่ละเกมก่อนตัดสินใจลงเงินจริง การรู้ว่าเกมหนึ่งเข้าโบนัสบ่อยแค่ไหนก่อนเริ่มเดิมพัน คือส่วนที่ช่วยให้วางงบต่อรอบได้แม่นขึ้นมาก
    </p>
  </ContentBox>

  <ContentBox title="ฟีเจอร์อัดแน่น ทั้ง Multiplier, Wild ซ้อนทับ, Cascading และ Bonus Buy" as="h2">
    <p class="text-left text-base leading-relaxed">
      สิ่งที่ทำให้แต่ละสปินไม่ซ้ำฟีลคือลูกเล่นที่ซ่อนอยู่ในตัวเกม เราจึงรวบรวมเกมที่มีฟีเจอร์หลายสไตล์ไว้ในคลังเดียวกัน ทั้งระบบ Multiplier ที่สุ่มตัวคูณก้อนใหญ่ให้ในจังหวะที่ไม่ทันตั้งตัว สัญลักษณ์ Wild แบบซ้อนทับที่ช่วยต่อไลน์ให้ครบ กลไก Cascading ที่ทำให้สัญลักษณ์แตกต่อเนื่องเป็นลูกโซ่ในสปินเดียว และโหมด Bonus Buy สำหรับคนที่อยากพุ่งเข้ารอบฟรีสปินทันที
      การมีฟีเจอร์หลายแบบให้เลือกยังแปลว่าผู้เล่นวางแผนรอบของตัวเองได้ วันไหนอยากเล่นยาวก็ไปทางเกมสะสมตัวคูณ วันไหนมีเวลาน้อยก็เลือกเกมที่จบไว ส่วนคนที่อยากเห็นรอบโบนัสเลยก็มีทางลัดของตัวเองอยู่แล้ว ทั้งหมดนี้อยู่ในคลังเดียวกัน ไม่ต้องแยกไปเปิดอีกเว็บให้เสียจังหวะ
    </p>
  </ContentBox>

  <ContentBox title="โปรโมชันกดรับเองผ่านหน้าเว็บ พร้อม Cash Back คืนยอดเสียทุกวัน" as="h2">
    <p class="text-left text-base leading-relaxed">
      โปรโมชันของเราวางไว้ให้ใช้ได้จริงมากกว่าไว้ให้ดูตัวเลขสวย ทั้งโบนัสต้อนรับที่เพิ่มทุนสปินให้สมาชิกใหม่ โปรฝากแรกของวันสำหรับสายลุยต่อเนื่อง และระบบ Cash Back ที่คืนยอดเสียให้ทุกวันโดยไม่ต้องรอสรุปรอบยาว ทุกสิทธิ์กดรับเองได้จากหน้าเว็บ เงื่อนไขเขียนไว้ชัดเจน และไม่มีการติดล็อกยูสหลังรับโปร
      สิ่งที่ยังต้องทำเองคืออ่านเพดานและรอบเวลาของแต่ละรายการก่อนกดรับ เพราะแต่ละสิทธิ์คิดจากยอดคนละชุดและมีจังหวะของตัวเอง เลือกสิทธิ์ให้เข้ากับสไตล์การเล่นของวันนั้นจะได้ประโยชน์มากกว่าการกดรับทุกอย่างที่เห็น
    </p>
  </ContentBox>

  <ContentBox title="ฝากถอนออโต้ 3–5 วินาที กระเป๋าเดียวจบในแดชบอร์ดเดียว" as="h2">
    <p class="text-left text-base leading-relaxed">
      ระบบฝากถอนของเราทำงานผ่าน Gateway ตรง ประมวลผลจบภายใน 3–5 วินาทีต่อรายการ ไม่ต้องส่งสลิปยืนยันและไม่ต้องรอแอดมินกดอนุมัติทีละคน ถอนได้ไม่จำกัดรอบ ไม่มีเทิร์นโอเวอร์จุกจิกมาคั่น ปั่นได้เท่าไหร่ถอนออกได้ครบทุกบาท ส่วนการสลับค่ายก็จบในกระเป๋าเดียว ไม่ต้องโยกยอดไปมาให้เสียจังหวะ
      ทุกอย่างตั้งแต่เลือกเกม กดรับโปร ดูยอด ไปจนถึงกดถอนกำไร ทำได้ครบผ่านแดชบอร์ดเดียวกัน สิ่งที่ยังต้องตรวจด้วยตัวเองคือการผูกชื่อบัญชีธนาคารให้ตรงกับข้อมูลสมาชิก และการเข้าใช้งานผ่านลิงก์ที่ตรวจชื่อเว็บไซต์แล้วเท่านั้น ทั้งนี้สล็อตเป็นเกมที่ผลลัพธ์สุ่มทุกรอบ การตั้งงบต่อสปินให้พอดีกับทุนของวันนั้นยังเป็นเรื่องสำคัญที่สุด
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
