---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 156.
const pageDescription =
  "เกี่ยวกับ MAHAHENG333 อาณาจักรคาสิโนสดฟลอร์ใหญ่ รวมโต๊ะบาคาร่า รูเล็ต เสือมังกร ไฮโล ถ่ายทอดสดคมชัดระดับ HD ดีลเลอร์มืออาชีพ 24 ชม. ฝากถอนออโต้จบใน 5 วินาที";

const pageTitle = "เกี่ยวกับ MAHAHENG333 คาสิโนสดฟลอร์ใหญ่ เปิดโต๊ะมหาเฮงครบทุกเกม";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="text-left text-base leading-relaxed">
        MAHAHENG333 คืออาณาจักรคาสิโนสดที่ตั้งใจยกความหรูหราของฟลอร์เดิมพันจริงมาเสิร์ฟให้ถึงหน้าจอ ไม่ใช่แค่ที่ไล่กดวางเดิมพันไปวัน ๆ หน้านี้เขียนไว้บอกว่าเรายืนอยู่บนอะไรบ้าง
        ตั้งแต่ที่มาของโต๊ะเดิมพันในล็อบบี้ ดีลเลอร์ที่ประจำอยู่หน้ากล้อง ความเร็วของระบบที่อยู่เบื้องหลังทุกการสลับห้อง ระบบการเงินที่ดูแลยอดฝากถอน ไปจนถึงวิธีที่เราปกป้องข้อมูลของสมาชิก
        เราไม่ได้เขียนหน้านี้ไว้ขายของ แต่เขียนไว้ให้คนที่กำลังชั่งใจอ่านจบแล้วรู้ว่ากำลังคุยอยู่กับเว็บแบบไหน และตัดสินใจได้ด้วยข้อมูลที่ตรงไปตรงมา
        ไม่ใช่ด้วยคำโฆษณาที่ฟังดูดีแต่ไม่มีอะไรรองรับ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ค่ายเกมสดระดับโลกในล็อบบี้เดียว ถ่ายทอดสดตรงจากคาสิโนจริงตลอด 24 ชั่วโมง" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        เรื่องแรกที่เราไม่ยอมแผ่วคือคุณภาพของโต๊ะเดิมพัน MAHAHENG333 คัดสรรเฉพาะค่ายเกมสดชื่อดังระดับโลกมารวบรวมไว้ในล็อบบี้เดียว ไม่ใช่ระบบที่ลอกหน้าเกมมาวางไว้เฉย ๆ
        ทุกโต๊ะถูกถ่ายทอดสดตรงจากคาสิโนจริง ให้ความรู้สึกเหมือนคุณกำลังนั่งอยู่ติดขอบโต๊ะเดิมพัน มีดีลเลอร์มืออาชีพคอยให้บริการตลอด 24 ชั่วโมง
        เลือกโต๊ะเล่นได้ตามใจชอบ ไม่ต้องแย่งที่นั่งกับใคร และไม่มีคำว่าโต๊ะเต็มมาขัดจังหวะความมันส์
        ความโปร่งใสตรงนี้ไม่ใช่คำโฆษณา แต่เป็นผลจากการเลือกทำงานกับต้นทางจริงตั้งแต่ต้น
      </p>
    </div>
  </ContentBox>

  <ContentBox title="บาคาร่า รูเล็ต เสือมังกร และไฮโล พร้อมหน้าต่างเลือกห้องที่จัดมาเป็นระเบียบ" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        อีกด้านที่เราลงแรงมากคือการจัดล็อบบี้ให้หาโต๊ะเจอเร็ว ไม่ว่าคุณจะเป็นสายอ่านเค้าไพ่บาคาร่า สายลุ้นวงล้อรูเล็ต หรือถนัดเสือมังกรกับไฮโลที่ตัดสินไว ที่นี่ก็มีพร้อมเปิดโต๊ะให้เลือกห้องได้อย่างอิสระ
        ตัวระบบออกแบบหน้าต่างการเลือกห้องมาให้อย่างเป็นระเบียบ มีการแสดงสถิติย้อนหลังและรายละเอียดของแต่ละโต๊ะอย่างชัดเจน ช่วยให้คุณวิเคราะห์และวางแผนการเดิมพันได้อย่างแม่นยำ
        อยากได้โต๊ะสปีดเกมไว หรือชอบโต๊ะบรรยากาศสบาย ๆ ก็เลือกปรับให้เข้ากับสไตล์การเล่นของตัวเองได้ทันที
        ไม่ต้องไล่เปิดทีละห้องเพื่อเดาว่าห้องไหนคือห้องที่ใช่
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สลับโต๊ะได้ลื่นไหลในคลิกเดียว ไม่ต้องโยกเงินและไม่ต้องออกจากระบบ" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        จังหวะที่หลุดมือบ่อยที่สุดคือตอนที่อยากเปลี่ยนโต๊ะแล้วต้องมานั่งรอระบบ เราจึงวางระบบให้สลับเปลี่ยนโต๊ะเดิมพันได้อย่างลื่นไหลและรวดเร็วที่สุดเท่าที่ทำได้
        หากรู้สึกว่าโต๊ะเดิมดวงไม่มา หรืออยากเปลี่ยนไปลองลุ้นเกมสดรูปแบบอื่น ก็กดเปลี่ยนห้องได้ทันทีในคลิกเดียว โดยไม่ต้องกดโยกเงินไปมาหรือออกจากระบบให้เสียเวลา
        ความต่อเนื่องตรงนี้ช่วยรักษาจังหวะการทำกำไรของคุณให้อยู่ในฟอร์มที่ดีที่สุด ลุยต่อได้ยาว ๆ ไม่มีอารมณ์ค้าง
        ความเร็วจึงเป็นเรื่องของประสบการณ์ตรงหน้าโต๊ะ ไม่ใช่แค่ตัวเลขทางเทคนิคที่เอาไว้พูดให้ดูดี
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ระบบการเงินออโต้ไฮสปีด ฝากถอนจบภายใน 5 วินาที ไม่ต้องส่งสลิปยืนยัน" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        จุดที่มัดใจผู้เล่นได้อยู่หมัดที่สุดคือเรื่องระบบการเงิน ทุกรายการฝากและถอนของ MAHAHENG333 เดินผ่านระบบออโต้ไฮสปีดที่จัดการยอดเงินเสร็จสรรพภายใน 5 วินาทีเท่านั้น
        ไม่ว่าจะเป็นขั้นตอนฝากเงินเพื่อเติมทุนลุยต่อ หรือการถอนกำไรก้อนโตเข้าบัญชี ทุกอย่างทำได้อย่างรวดเร็ว แม่นยำ และปลอดภัยสูงสุด ไร้ขั้นตอนซับซ้อน ไม่ต้องส่งสลิปยืนยัน
        เราลงแรงกับส่วนนี้เป็นพิเศษ เพราะจังหวะที่คนเล่นหงุดหงิดที่สุดไม่ใช่ตอนเสีย
        แต่คือตอนที่เงินของตัวเองค้างอยู่ในระบบโดยไม่มีใครตอบได้ว่าอีกนานแค่ไหน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ความปลอดภัยของข้อมูลสมาชิกและทุกธุรกรรมบนระบบของเรา" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        ความปลอดภัยเป็นเรื่องที่เราให้ความสำคัญเป็นอันดับหนึ่ง เพราะข้อมูลที่สมาชิกฝากไว้กับเราไม่ใช่แค่ชื่อกับเบอร์ แต่ผูกอยู่กับบัญชีเงินจริงของเขาด้วย
        เราจึงวางระบบปกป้องข้อมูลสมาชิกไว้ในระดับสูง ทั้งข้อมูลส่วนตัวและข้อมูลทางการเงิน เพื่อป้องกันการรั่วไหลอย่างเข้มงวด
        ทุกขั้นตอนการใช้งานตั้งแต่การสมัครสมาชิก การเข้าสู่ระบบ การเข้าโต๊ะเดิมพัน ไปจนถึงการกดถอนเงิน ล้วนผ่านการตรวจสอบและเข้ารหัสไว้ทั้งหมด
        ผู้เล่นจึงลงเดิมพันหน้าโต๊ะได้อย่างสบายใจ ไม่ต้องเผื่อใจไว้กับปัญหาความไม่ปลอดภัยตั้งแต่แรก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สิ่งที่ MAHAHENG333 รวมไว้ด้วยกัน ทั้งเกมสด ความเร็ว และทีมงานที่ดูแลทุกเวลา" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        สรุปรวมแล้ว MAHAHENG333 ไม่ได้มีดีแค่การเป็นศูนย์รวมโต๊ะเดิมพันสดคุณภาพสูงเพียงอย่างเดียว แต่ยังจัดเต็มทั้งสตรีมมิ่งความละเอียดสูงที่คมชัดระดับ HD ไร้การดีเลย์
        ความคุ้มค่าจากสิทธิประโยชน์ที่เตรียมไว้ให้สมาชิก และทีมงานมืออาชีพที่คอยดูแลอำนวยความสะดวกตลอด 24 ชั่วโมง ตั้งแต่เรื่องการเลือกห้องเล่น ข้อสงสัยเกี่ยวกับตัวเกม ไปจนถึงปัญหาการใช้งาน
        นั่นคือเหตุผลที่เราเรียกตัวเองว่าเว็บตรงคาสิโนสดที่ครบเครื่องเรื่องความบันเทิงและบริการ ใครกำลังมองหาเว็บเล่นยาว ๆ ที่เข้าโต๊ะง่าย โอนไว
        และได้มาตรฐานระดับสากล ลองเข้ามาสัมผัสด้วยตัวเองสักครั้งแล้วจะรู้ว่าฟลอร์คาสิโนของจริงต่างจากที่เคยเจอมาอย่างไร
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
