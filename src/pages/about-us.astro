---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// ROOM89: ticker หมุนมาเป็น Announcement5 ส่วนกล่องหน้าย่อยยังเป็น ContentBox
// (การ์ดถาวรของหน้าย่อย) เรียก <Announcement /> เปล่า ๆ เพราะ default message ของ
// variant นี้ถูกตั้งให้ตรงกับที่หน้าแรกส่งเข้าไปแล้ว
// สีย้ายจากทองคำคู่แดงเลือดหมูของแบรนด์ก่อน มาเป็นทองคำขัดเงาคู่เงินแพลตินัมบน
// ดำอมน้ำตาล — เน้นข้อความด้วยทองหลัก #e6cf72 ทองอ่อน #f7edc4 และเงินหลัก
// #b9c2cc / เงินอ่อน #e8ebef สี่สีนี้วัดคอนทราสต์บนผิว #161009 ของการ์ดแล้วผ่าน AA
// สบาย ส่วนทองกลาง #c9a227 ทองเข้ม #6b5424 เงินกลาง #7c8794 และขอบ #4a3a18
// ใช้เป็นพื้น ขอบ และปลาย gradient เท่านั้น ไม่ใช้กับตัวอักษรขนาดเนื้อความ
// สีเนื้อความหลักมาจากการ์ดเอง (#f0e6cf) จึงไม่ต้องระบุซ้ำ
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 158, and is one
// sentence about what the page is for rather than a table of contents.
const pageDescription =
  "หน้าแนะนำตัวของ ROOM89 สล็อตเว็บตรง API แท้ ยิงตรงจากเซิร์ฟเวอร์ค่าย ว่าเราเป็นใคร ดูแลค่า RTP กับความปลอดภัยของสมาชิกอย่างไร และยึดอะไรเป็นมาตรฐานตอนจ่ายเงิน";

const pageTitle = "เกี่ยวกับเรา ROOM89 | สล็อตเว็บตรง API แท้ ไม่ล็อกยูส ถอนได้เต็มจำนวน";

// หัวข้อระดับ h1 ของหน้า แยกจากค่า title เพราะ title มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา ROOM89";

// docx รอบนี้ไม่มีส่วน SUB-PAGES จึงไม่มีบอดี้สำเร็จรูปให้หน้านี้ — หัวข้อและ
// ย่อหน้าทั้งหกบล็อกด้านล่างเขียนขึ้นใหม่จากข้อเท็จจริงของแบรนด์ในบรีฟรอบนี้
// (สล็อตเว็บตรง API แท้ ยิงตรงจากเซิร์ฟนอกโดยไม่ผ่านเอเย่นต์ · ค่า RTP เป๊ะตาม
// สเปกโรงงาน ไม่ปรับลดเปอร์เซ็นต์แตก · ไม่ล็อกยูส บวกเท่าไหร่ก็ถอนได้เต็มระบบ ·
// ออโต้ไฮสปีดทำรายการเสร็จใน 3 วินาที ถอนปุ๊บเงินเด้งเข้าแอปปั๊บ · ล็อกเป้าคัด
// เฉพาะเกมตัวเด่นมาไว้หน้าล็อบบี้ จัดหมวดหมู่ให้กดเข้าเกมได้ในคลิกเดียว ·
// ลิขสิทธิ์แท้ยกค่าย PG Soft / Pragmatic Play / Joker Gaming กราฟิก 3D คมชัด
// อัลกอริทึมการจ่ายเงินโปร่งใส 100% เบทเริ่มต้นบาทเดียว · เกมหลายสไตล์บนกระเป๋า
// เดียว ทั้งคอมโบแตกนอก ซื้อฟีเจอร์ฟรีสปิน และคลาสสิกตัวคูณหนัก · ฟีเจอร์
// Multipliers / Expanding Wild / Cascading / Bonus Buy · โปรฝากแรกของวันกับ
// Cash Back คืนยอดเสีย กดรับเองผ่านหน้าเว็บ เงื่อนไขโปร่งใส ไม่ติดเทิร์นจุกจิก ·
// เซิร์ฟเวอร์ความเร็วสูงรันได้ 24 ชั่วโมง ไม่ค้าง ไม่เด้งหลุดกลางทาง)
// — ไม่ลอกย่อหน้าในบรีฟมาทั้งดุ้น เพราะย่อหน้าชุดนั้นใช้เต็ม ๆ อยู่บนหน้าแรกแล้ว
// หน้านี้จึงเขียนคนละสำนวนในมุม "เราเป็นใคร" จากข้อเท็จจริงชุดเดียวกัน โครงเป็น
// h1×1 + h2×5 ไม่มี h3 และห้ามเติมข้อเท็จจริงที่บรีฟไม่ได้ให้ เช่น เลขใบอนุญาต
// จำนวนผู้เล่น รางวัล ทุนสำรอง ชื่อธนาคาร ชื่อค่ายเกมที่บรีฟไม่ได้เอ่ยถึง หรือ
// โต๊ะคาสิโนสด — บรีฟรอบนี้เป็นสล็อตล้วน ไม่มีฝั่งไลฟ์คาสิโน
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="text-left text-base leading-relaxed">
      <strong class="text-[#e6cf72]">ROOM89</strong> เกิดขึ้นจากคำถามข้อเดียวว่า ในวงการสล็อตออนไลน์ที่มีเว็บเปิดใหม่ทุกสัปดาห์ อะไรคือสิ่งที่ทำให้คนคนหนึ่งกล้าลงเงินก้อนแรกกับที่ไหนสักแห่ง
      คำตอบที่เราได้ไม่ใช่ภาพสวยหรือแบนเนอร์ตัวเลขใหญ่ ๆ แต่เป็นความมั่นใจว่าเกมที่กำลังหมุนอยู่ไม่ได้ถูกใครแตะ ยอดที่กดถอนจะเข้าจริง และบัญชีจะไม่ถูกหรี่ลงในวันที่เล่นได้
      เราจึงวางตัวเองเป็น<strong class="text-[#b9c2cc]">สล็อตเว็บตรงตัวตึงที่ยิงตรงจากเซิร์ฟเวอร์นอกของค่ายเกม</strong> ด้วยระบบ API แท้ ไม่ได้เป็นเว็บเอเย่นต์ที่รับสัญญาณต่อจากใครอีกที
      หน้านี้เขียนไว้ให้อ่านก่อนตัดสินใจ ว่าเราเป็นใคร วางระบบไว้อย่างไร และยึดอะไรเป็นมาตรฐานในการดูแลสมาชิกทุกคนที่เลือกเดินเข้ามา
    </p>
  </ContentBox>

  <ContentBox title="เว็บตรง API แท้ ยิงตรงจากเซิร์ฟนอก ไม่มีเอเย่นต์ยืนคั่นกลาง" as="h2">
    <p class="text-left text-base leading-relaxed">
      ปัญหาที่นักปั่นส่วนใหญ่ต้องเจอคือการหลงไปเล่นเว็บเอเย่นต์ที่ปรับอัตราการชนะเองหรือฝากถอนล่าช้า และปัญหานั้นเกิดจากโครงสร้าง ไม่ได้เกิดจากโชค เพราะเมื่อมีคนกลางยืนคั่นระหว่างผู้เล่นกับค่ายเกม ก็มีที่ให้แตะโดยปริยาย
      เราเลือกโครงสร้างที่ไม่มีชั้นกลางนั้นตั้งแต่วันแรก โดยต่อ<strong class="text-[#e6cf72]">ระบบ API แท้เข้ากับเซิร์ฟเวอร์หลักของค่ายเกมที่อยู่นอกประเทศโดยตรง</strong> คำสั่งที่สมาชิกกดจึงวิ่งไปบันทึกที่ค่ายแล้วส่งผลกลับมาตามที่ตัวสุ่มของค่ายตัดสินจริงในวินาทีนั้น ไม่ได้แวะผ่านมือใครก่อน
      สิ่งที่เราถือว่าเป็นงานของเราคือดูแลทางเดินระหว่างปุ่มที่กดกับเซิร์ฟเวอร์ของค่ายให้สั้นที่สุด คัดของขึ้นล็อบบี้ให้มีเชิงชั้น และเขียนเงื่อนไขทุกข้อให้อ่านจบได้ก่อนกด ไม่ใช่หลังกด
      ส่วนผลของแต่ละรอบเป็นของค่ายเจ้าของเกมล้วน ๆ และเราตั้งใจให้มันเป็นแบบนั้นตั้งแต่ต้น
    </p>
  </ContentBox>

  <ContentBox title="ค่า RTP เป๊ะตามสเปกโรงงาน กับคำว่าล็อกยูสที่ระบบเราทำไม่ได้" as="h2">
    <p class="text-left text-base leading-relaxed">
      ผลตามมาที่สำคัญที่สุดของการต่อตรงคือ อัตราการแตกหรือค่า RTP ที่สมาชิกได้สัมผัสเป็น<strong class="text-[#f7edc4]">ค่าเดียวกับที่ค่ายผู้พัฒนาตั้งมาเป๊ะ ๆ</strong> ไม่มีการปรับลดเปอร์เซ็นต์แตกระหว่างทาง เพราะตัวเลขนั้นเป็นของค่าย ไม่ใช่ของเว็บ และระบบของเราไม่ได้ถูกออกแบบให้เข้าไปยุ่งกับมันได้ตั้งแต่ต้น
      เรื่องที่ทุกคนกลัวที่สุดไม่ใช่การเสีย แต่คือการปั่นจนบวกก้อนโตแล้วเข้าบัญชีไม่ได้ในวันรุ่งขึ้น เราจึงพูดเรื่องนี้ตรง ๆ ว่า<strong class="text-[#b9c2cc]">การล็อกยูสไม่ใช่นโยบายที่เราเลือกไม่ทำ แต่เป็นสิ่งที่ระบบทำไม่ได้</strong> เพราะผลของแต่ละรอบถูกตัดสินและบันทึกที่ค่าย ไม่มีจุดใดตลอดเส้นทางที่ใครฝั่งเราจะเข้าไปหรี่บัญชีใครให้ต่างจากบัญชีอื่น
      บวกเท่าไหร่จึงถอนได้เต็มระบบตามนั้น ปั่นยังไงก็มีทรงเท่ากันทุกบัญชี คนที่เบทบาทเดียวกับคนที่ปรับยอดขึ้นสูงยืนอยู่บนกลไกชุดเดียวกัน สิ่งที่ต่างกันได้มีแค่โปรที่แต่ละคนเลือกกดรับ ไม่ใช่ตัวเกม
      สมาชิกจึงโฟกัสกับการปั่นได้เต็มที่โดยไม่ต้องระแวงเรื่องตุกติก ซึ่งเป็นเหตุผลหลักที่คนที่อยู่ในวงการมานานและรู้ว่าเว็บไหนคือของจริง เลือกปักหลักทำกำไรกับเราต่อเนื่อง
    </p>
  </ContentBox>

  <ContentBox title="ลิขสิทธิ์แท้ยกค่าย กับการล็อกเป้าคัดเกมมาไว้ให้เจอง่าย" as="h2">
    <p class="text-left text-base leading-relaxed">
      บนล็อบบี้ของเราเป็นเกมลิขสิทธิ์แท้ที่ขนมาแบบยกค่าย ทั้ง <strong class="text-[#e6cf72]">PG Soft, Pragmatic Play และ Joker Gaming</strong> ทุกเกมเป็นของแท้จากเจ้าของเกม ไม่ใช่เกมเลียนแบบที่หน้าตาคล้ายกันแต่กลไกข้างในเป็นคนละเรื่อง กราฟิกจึงเป็นภาพคมชัดระดับ 3D ที่ลื่นไม่กระตุก และอัลกอริทึมการจ่ายเงินโปร่งใส 100% ตามที่ค่ายกำหนด
      อีกครึ่งหนึ่งของงานเราคือการคัด เราเลิกเชื่อว่าการเทเกมทั้งตลาดมากองรวมกันคือการให้ทางเลือก เพราะสุดท้ายมันคือการโยนภาระให้ผู้เล่นเลื่อนหาเอง เราจึง<strong class="text-[#b9c2cc]">ล็อกเป้าคัดเฉพาะเกมตัวเด่นที่มีทรงโบนัสมาไว้หน้าล็อบบี้</strong>และจัดหมวดหมู่ไว้ให้ชัด เปิดเข้าเว็บมาก็กดเข้าเกมที่อยากปั่นได้ในคลิกเดียว
      ของที่คัดมาครอบคลุมหลายสไตล์ ทั้งสายคอมโบแตกนอก สายซื้อฟีเจอร์พุ่งชนฟรีสปิน และสายคลาสสิกตัวคูณหนัก สลับค่ายสลับแนวได้ในกระเป๋าเดียวโดยไม่ต้องเสียเวลาโยกเงิน
      ในตัวเกมยังมีฟีเจอร์ให้ไล่ลองอีกชั้น ทั้ง Multipliers ที่ทบตัวคูณสะสม สัญลักษณ์ Expanding Wild ที่ยืดเต็มรีล ระบบ Cascading ที่แตกต่อเนื่องในสปินเดียว และโหมด Bonus Buy ที่กดซื้อฟรีสปินเข้าไปลุ้นได้ทันที ส่วนเบทเริ่มต้นเราเปิดไว้เบา ๆ แค่บาทเดียวก็มีสิทธิ์คว้าโบนัสก้อนโตได้จริง
    </p>
  </ContentBox>

  <ContentBox title="ระบบออโต้ไฮสปีด 3 วินาที ที่รันต่อเนื่องได้ตลอด 24 ชั่วโมง" as="h2">
    <p class="text-left text-base leading-relaxed">
      งานฝากถอนเป็นงานที่เราตัดสินใจยกให้เครื่องทำแทนคนทั้งหมด เพราะการรอแอดมินตรวจสลิปคือจุดที่ทำให้จังหวะการปั่นขาดตอนและเสียอรรถรส เราจึงวาง<strong class="text-[#e6cf72]">ระบบฝากถอนออโต้ไฮสปีด</strong>ไว้แทน กดทำรายการแล้วเสร็จภายใน 3 วินาที ถอนปุ๊บเงินเด้งเข้าแอปปั๊บ ไม่ต้องถ่ายสลิปส่งใครและไม่ต้องรอใครอนุมัติ
      อีกครึ่งหนึ่งของเรื่องความลื่นคือเซิร์ฟเวอร์ เรารันระบบบน<strong class="text-[#e8ebef]">เซิร์ฟเวอร์ความเร็วสูงที่เปิดต่อเนื่องตลอด 24 ชั่วโมง</strong> เล่นยาว ๆ ได้โดยไม่มีอาการค้าง ไม่มีเด้งหลุดกลางทาง และไม่หลุดออกจากเกมในจังหวะที่กำลังเข้าฟรีสปินพอดี ซึ่งเป็นจังหวะที่ระบบส่วนใหญ่มักพัง
      เราถือว่าความเร็วไม่ใช่ลูกเล่นทางการตลาด แต่เป็นเงื่อนไขขั้นต่ำของเว็บที่คิดจะให้คนฝากเงินเข้ามา จะฝากเข้าเล่นตอนดึกหรือถอนช่วงเช้าตรู่ก็ต้องได้เท่ากันทุกเวลา
      เวลาที่ประหยัดจากการไม่ต้องนั่งรออนุมัติ คือเวลาที่กลับไปอยู่กับเกม ซึ่งเป็นเหตุผลที่ทุกคนเปิดเว็บนี้ขึ้นมาตั้งแต่แรกอยู่แล้ว
    </p>
  </ContentBox>

  <ContentBox title="โบนัสที่กดรับเองได้ กับเงื่อนไขที่เขียนให้อ่านจบก่อนกด" as="h2">
    <p class="text-left text-base leading-relaxed">
      เป้าหมายสูงสุดของการปั่นสล็อตคือการถอนเงินรางวัลออกมาใช้ได้จริง ทุกอย่างที่เขียนมาข้างบนจะไม่มีความหมายเลยถ้าข้อนี้ไม่เกิดขึ้น เราจึงถือว่านี่คือคำมั่นที่เรามีให้กับสมาชิก <strong class="text-[#e6cf72]">ROOM89</strong> ทุกคน
