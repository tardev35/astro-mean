---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

// XTOP666: ticker หมุนมาเป็น AnnouncementCyber และกล่องหน้าย่อยหมุนมาเป็น
// ContentBoxCyberCut ตามสเปกรอบนี้ เรียก <Announcement /> เปล่า ๆ เพราะ default
// message ของ variant นี้ถูกตั้งเป็นข้อความของแบรนด์นี้แล้ว
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 158.
const pageDescription =
  "เกี่ยวกับเรา XTOP666 เว็บสล็อตสายสปีดที่ออกแบบระบบให้ตัดความล่าช้าออกทุกจุด ลิงก์ตรงเข้าเกมค่ายดังในคลิกเดียว คัดเกมหลายแนว เมนูใช้คล่อง โบนัสกดรับเองได้ทันที";

const pageTitle = "เกี่ยวกับเรา XTOP666 | สล็อตสปีดท็อป โหลดเกมไว ระบบพร้อมบวก";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา XTOP666";

// docx รอบนี้ไม่มีส่วน SUB-PAGES จึงไม่มีบอดี้สำเร็จรูปให้หน้านี้ — หัวข้อและ
// ย่อหน้าทั้งเจ็ดบล็อกด้านล่างเขียนขึ้นใหม่จากข้อเท็จจริงของแบรนด์ใน
// src/assets/content.txt (ระบบสายสปีดที่ตัดความล่าช้าตั้งแต่คลิกแรก ลิงก์ตรง
// ทางเข้าที่ไม่ผ่านหน้าเอเย่นต์และตัดการกรอกข้อมูลซ้ำกับการยืนยันตัวตนหลายชั้น
// คลังเกมค่ายดังที่คัดมาหลายแนวทั้งแฟนตาซี 3D คลาสสิกโบนัสแตกไว และสายสะสม
// ตัวคูณ การวางเมนูฝากถอน คลังเกม ค่ายเกม และกิจกรรมให้หยิบใช้ได้ในแตะเดียว
// โบนัสที่ผู้เล่นกดรับสิทธิ์เองได้ก่อนขึ้นสปิน และการใช้งานที่เท่ากันทั้ง
// มือถือกับคอม) — ไม่ลอกย่อหน้าใน docx มาทั้งดุ้น เพราะย่อหน้าชุดนั้นใช้เต็ม ๆ
// อยู่บนหน้าแรกแล้ว โครงยังเป็น h1×1 + h2×6 เท่าเดิม
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="text-left text-base leading-relaxed">
      <strong class="text-[#ffc9a3]">XTOP666</strong> คือเว็บสล็อตที่ตั้งต้นจากคำถามข้อเดียวว่า ระหว่างที่ผู้เล่นอยากปั่น มีอะไรบ้างที่มาขวางอยู่ตรงกลาง คำตอบไม่ใช่เกม แต่เป็นเวลาที่หมดไปกับหน้าโหลด หน้าเปลี่ยนเส้นทาง แบบฟอร์มที่ต้องกรอกซ้ำ และเมนูที่ต้องคลิกวนกว่าจะเจอ เราจึงเลือกไล่ตัดสิ่งเหล่านั้นออกก่อนสิ่งอื่น
      งานหลักของเราจึงมีสี่เรื่องที่จับต้องได้ คือระบบที่ประมวลผลและดึงข้อมูลขึ้นแสดงทันทีตั้งแต่คลิกแรก ลิงก์ตรงที่พาเข้าล็อบบี้ค่ายดังโดยไม่ผ่านหน้าเอเย่นต์ คลังเกมที่คัดมาหลายแนวแทนการนับจำนวนเข้าขู่ และโบนัสที่กดรับสิทธิ์เองได้ก่อนขึ้นสปินโดยไม่ต้องรอใครอนุมัติ
    </p>
  </ContentBox>

  <ContentBox title="แนวคิดตั้งต้นของ XTOP666 ทำไมเราวัดตัวเองด้วยความเร็วเป็นอย่างแรก" as="h2">
    <p class="text-left text-base leading-relaxed">
      คำว่าสปีดท็อปในชื่อแบรนด์ไม่ได้หมายถึงตัวเลขบนหน้าโฆษณา แต่หมายถึงช่วงเวลาที่ผู้เล่นรู้สึกได้จริง นับตั้งแต่วินาทีที่กดเข้าหน้าเว็บจนภาพเกมขึ้นเต็มจอ ระบบของเราถูกปรับให้ทำงานและดึงข้อมูลขึ้นแสดงทันที ไม่ปล่อยให้ใครต้องนั่งมองไอคอนหมุนติ้วอยู่กลางจังหวะที่กำลังอยากเล่น
      เราจึงวัดตัวเองด้วยสามค่านี้มากกว่าจำนวนเกมในล็อบบี้ คือเวลาตั้งแต่กดลิงก์จนถึงหน้าเลือกเกม เวลาตั้งแต่กดเลือกเกมจนภาพขึ้น และความนิ่งของระบบในช่วงที่คนออนไลน์พร้อมกันหนาแน่นที่สุด เพราะสามค่านี้คือสิ่งที่ตัดสินว่าผู้เล่นจะยังอยู่กับจังหวะของตัวเองได้หรือเสียอารมณ์ไปก่อน
    </p>
  </ContentBox>

  <ContentBox title="ลิงก์ตรงทางเข้า ตัดหน้าเอเย่นต์และการกรอกข้อมูลซ้ำออกจากเส้นทางเข้าเกม" as="h2">
    <p class="text-left text-base leading-relaxed">
      ทางเข้าของเราเป็นลิงก์ตรงที่ไม่ผ่านหน้าเว็บเอเย่นต์และไม่ผ่านหน้าเปลี่ยนเส้นทางซ้อนกันหลายชั้น สิ่งที่หายไปจากเส้นทางจึงเป็นของจริงและนับได้ ทั้งการกรอกข้อมูลซ้ำซ้อนที่เคยต้องทำใหม่ทุกครั้ง การยืนยันตัวตนหลายชั้นระหว่างทาง และการรอโหลดหน้าคีย์ข้อมูลที่ไม่ได้พาไปไหนเลย
      ผลที่ได้คือคลิกเดียวจากลิงก์ตรงพุ่งเข้าหน้าล็อบบี้ของเกมค่ายดังระดับโลกได้ทันที ซึ่งสำคัญกว่าที่ฟังดู เพราะทุกหน้าที่คั่นกลางคือโอกาสที่โฟกัสจะหลุด และการรักษาจังหวะของผู้เล่นให้ต่อเนื่องคือสิ่งที่เว็บทั่วไปมักยอมแลกทิ้งไปเพื่อความสะดวกของฝั่งระบบเอง
    </p>
  </ContentBox>

  <ContentBox title="คลังเกมค่ายดังที่คัดมาหลายแนว ไม่ได้วัดกันที่จำนวนเกมเพียงอย่างเดียว" as="h2">
    <p class="text-left text-base leading-relaxed">
      การขนเกมจากค่ายชั้นนำเข้ามาไว้ในที่เดียวไม่ใช่เรื่องยาก แต่การเลือกว่าเกมไหนควรอยู่ในล็อบบี้ต่างหากที่เป็นงาน เราจึงคัดโดยดูจากจุดเด่นของแต่ละเกมเป็นหลัก แล้ววางให้ครอบคลุมหลายสไตล์การเล่น ทั้งสล็อตแนวแฟนตาซีภาพ 3D อลังการ สล็อตสไตล์คลาสสิกที่เน้นโบนัสแตกไว และสล็อตสายสะสมตัวคูณที่ยิ่งเล่นยาวยิ่งมัน
      เหตุผลที่ต้องคัดแบบนี้คือคนเล่นสล็อตไม่ได้ต้องการสิ่งเดียวกัน บางคนมาเพื่อภาพและเสียงเต็มตา บางคนมาเพื่อรอบสั้น ๆ ที่จบไว และบางคนสนุกกับการไล่สะสมตัวคูณให้ถึงจังหวะใหญ่ ล็อบบี้ที่มีทั้งสามแนวจึงทำให้ผู้เล่นเลือกเกมที่ตรงกับจริตของตัวเองได้ แทนที่จะต้องเล่นเท่าที่มีให้เล่น
    </p>
  </ContentBox>

  <ContentBox title="วางเมนูให้หยิบใช้ได้ในแตะเดียว ทั้งฝากถอน คลังเกม ค่ายเกม และหน้ากิจกรรม" as="h2">
    <p class="text-left text-base leading-relaxed">
      หน้าเว็บของเราออกแบบโดยเอาผู้ใช้งานเป็นตัวตั้ง เมนูสำคัญทั้งปุ่มฝากถอน คลังเกม รายชื่อค่ายเกม และหน้ากิจกรรม ถูกวางตำแหน่งไว้อย่างเป็นระเบียบและอยู่ในระยะที่กดถึงได้ในแตะเดียว ไม่ต้องคลิกวนเข้าเมนูซ้อนเมนูหลายชั้นเพื่อไปให้ถึงฟังก์ชันที่ใช้บ่อยที่สุดของทุกวัน
      ความคล่องตรงนี้สะสมเป็นเวลาจริง ผู้เล่นที่สลับค่ายบ่อยหรือเติมทุนระหว่างรอบจะรู้สึกได้ชัดที่สุด เพราะการหยิบเมนูได้ทันทีแปลว่าไม่ต้องออกจากจังหวะที่กำลังเล่นอยู่ และนั่นคือความต่างระหว่างระบบที่ออกแบบมาให้ใช้งานจริง กับหน้าเว็บที่สวยแต่ต้องเรียนรู้ว่าปุ่มไหนซ่อนอยู่ตรงไหน
    </p>
  </ContentBox>

  <ContentBox title="โบนัสที่กดรับสิทธิ์เองได้ก่อนขึ้นสปิน ไม่ต้องรอใครมาเปิดให้" as="h2">
    <p class="text-left text-base leading-relaxed">
      ระบบโบนัสของเราเปิดให้ผู้เล่นเลือกกดรับสิทธิ์พิเศษได้เองทันทีจากหน้าเว็บ ตั้งแต่ก่อนเข้าสู่ตัวเกม ไม่ว่าจะเป็นเครดิตเพิ่มทุนรายวันสำหรับสายลุยต่อเนื่อง หรือสิทธิประโยชน์ที่ผูกกับการเติมเงินในแต่ละรอบ ทุกอย่างจบได้ในไม่กี่วินาทีโดยไม่ต้องทักไปขอ ไม่ต้องส่งสลิป และไม่ต้องรอรอบอนุมัติของใคร
      จังหวะการรับที่ง่ายแบบนี้มีผลกับการเล่นมากกว่าตัวเลขบนป้าย เพราะมันเพิ่มสภาพคล่องให้กับทุนของวันนั้น เพิ่มจำนวนรอบสปินที่ทำได้จริง และยกโอกาสไปถึงจังหวะแจ็คพอตก้อนใหญ่ให้สูงขึ้นตาม สิ่งที่ยังต้องทำเองคืออ่านเพดานและรอบเวลาของแต่ละรายการก่อนกดรับ เพราะแต่ละสิทธิ์คิดจากยอดคนละชุด
    </p>
  </ContentBox>

  <ContentBox title="มือถือกับคอมได้เท่ากัน กับเรื่องที่ยังต้องตรวจด้วยตัวเองก่อนลงเดิมพัน" as="h2">
    <p class="text-left text-base leading-relaxed">
      ระบบของเราถูกพัฒนาให้ปรับสเกลตามหน้าจอโดยอัตโนมัติ เข้าจากมือถือก็ได้การประมวลผลที่ฉับไวและปุ่มที่อยู่ใกล้มือ เข้าจากคอมพิวเตอร์ก็ได้กราฟิกและเอฟเฟกต์เต็มตาแบบที่ค่ายเกมออกแบบไว้ ความลื่นไหลอยู่ในระดับเดียวกันทั้งสองทาง ไม่มีอุปกรณ์ไหนถูกลดทอนให้กลายเป็นเวอร์ชันรอง
      สิ่งที่มาคู่กับความสะดวกคือเรื่องที่ยังต้องตรวจด้วยตัวเอง ทั้งการผูกชื่อบัญชีธนาคารให้ตรงกับข้อมูลสมาชิก การเข้าใช้งานผ่านลิงก์ตรงที่ตรวจชื่อเว็บไซต์แล้วเท่านั้น และการอ่านเงื่อนไขของโปรโมชันแต่ละรายการก่อนกดรับ ทั้งนี้สล็อตเป็นเกมที่ผลลัพธ์สุ่มทุกรอบ การตั้งงบต่อสปินให้พอดีกับทุนของวันนั้นยังเป็นเรื่องที่สำคัญที่สุด
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
