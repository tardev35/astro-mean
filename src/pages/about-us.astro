---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// PHOENIX168: ticker หมุนมาเป็น AnnouncementPremium ส่วนกล่องหน้าย่อยยังเป็น
// ContentBox (การ์ดถาวรของหน้าย่อย) ตามสเปกรอบนี้ เรียก <Announcement /> เปล่า ๆ
// เพราะ default message ของ variant นี้ถูกตั้งเป็นข้อความของแบรนด์นี้แล้ว
// สีเน้นในย่อหน้าใช้ส้มไฟ #ff5a1e คู่ส้มอ่อน #ffa14a ของพาเลตต์รอบนี้
// ส่วนสีเนื้อความมาจากการ์ดเอง ไม่ต้องระบุซ้ำ
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 151.
const pageDescription =
  "เกี่ยวกับเรา PHOENIX168 เว็บตรงสล็อตสายสปีด ยิงตรง API แท้จากค่ายใหญ่ โหลดไว สลับเกมลื่นไม่สะดุด รองรับทุกอุปกรณ์ เปิด 24 ชม. ฝากถอนออโต้ไม่ต้องส่งสลิป";

const pageTitle = "เกี่ยวกับเรา PHOENIX168 | เว็บตรงสล็อตสายสปีด ออโต้ไวไม่ต้องรอ";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา PHOENIX168";

// docx รอบนี้ไม่มีส่วน SUB-PAGES จึงไม่มีบอดี้สำเร็จรูปให้หน้านี้ — หัวข้อและ
// ย่อหน้าทั้งหกบล็อกด้านล่างเขียนขึ้นใหม่จากข้อเท็จจริงของแบรนด์ในบรีฟรอบนี้
// (เว็บตรงสล็อตสายสปีด · ยิงตรง API แท้จากค่ายใหญ่ เซิร์ฟนอกมาตรฐานสากล ·
// โบนัสแตกตามอัตราจ่ายจริง ไม่ดัดแปลงเปอร์เซ็นต์ชนะ · ระบบหลังบ้านโหลดไวกว่า
// ทั่วไปหลายเท่า พุ่งจากหน้าแรกเข้าเกมในคลิกเดียว · เกมลิขสิทธิ์แท้จาก PG Soft,
// Pragmatic Play, Joker Gaming และค่ายชั้นนำอื่น ๆ · ฟีเจอร์ตัวคูณหนัก ฟรีสปิน
// เข้าไว · ล็อบบี้จัดหมวดครบ ทั้ง 3D สตรีตนำโชค และสายซื้อฟีเจอร์ · กระเป๋าเดียว
// ไม่ต้องย้ายเว็บ · สลับค่ายสลับเกมได้ทันที ไม่ต้องรอโหลดหน้าใหม่ · รองรับมือถือ
// iOS, Android, แท็บเล็ต และคอมพิวเตอร์ · เปิดตลอด 24 ชั่วโมง ไม่ปิดปรับปรุง
// แบบไม่แจ้งล่วงหน้า · ฝากถอนออโต้ไฮสปีดเสร็จในไม่กี่วินาที ไม่ต้องส่งสลิป
// ไม่ต้องรอแอดมินอนุมัติ ถอนได้ครบเต็มจำนวน)
// — ไม่ลอกย่อหน้าในบรีฟมาทั้งดุ้น เพราะย่อหน้าชุดนั้นใช้เต็ม ๆ อยู่บนหน้าแรกแล้ว
// หัวข้อจึงตั้งคนละสำนวนกับ h2 ของหน้าแรกด้วย โครงเป็น h1×1 + h2×6 ไม่มี h3
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="text-left text-base leading-relaxed">
      <strong class="text-[#ff5a1e]">PHOENIX168</strong> ตั้งต้นจากโจทย์ที่ตรงไปตรงมาว่าเว็บสล็อตที่ดีไม่ควรบังคับให้คนเล่นลุ้นสองชั้น ชั้นแรกคือลุ้นว่าสปินถัดไปจะเข้าฟีเจอร์ไหม ส่วนชั้นที่สองคือลุ้นว่าระบบหลังบ้านจะซื่อตรงกับที่ประกาศไว้หรือเปล่า
      เราจึงวางเว็บนี้เป็นเว็บตรงสล็อตสายสปีดที่ยิงตรงด้วย API แท้กับค่ายเจ้าของเกมโดยตรงบนเซิร์ฟนอกมาตรฐานสากล ไม่ผ่านเอเย่นต์ และไม่มีตัวกลางมาคั่นระหว่างการกดสปินกับตัวสุ่มของค่าย
      โบนัสจึงแตกตามอัตราจ่ายจริงที่เกมประกาศไว้ ไม่มีการดัดแปลงเปอร์เซ็นต์ชนะให้ใครในช่วงเวลาใดเวลาหนึ่ง
      ที่เหลือคือหน้าที่ของเราล้วน ๆ คัดเกมที่ปั่นแล้วสนุกจริงเข้าล็อบบี้ จัดหน้าให้หาเจอไว ปรับจูนระบบให้โหลดไวจนกดคลิกเดียวก็เข้าเกม แล้วปล่อยให้ระบบออโต้รับงานฝากถอนไปทำแทนคนทั้งหมด
      เพื่อให้เวลาของสมาชิกหมดไปกับการปั่น ไม่ใช่การรอ
    </p>
  </ContentBox>

  <ContentBox title="เว็บตรงสล็อตสายสปีด ยิงตรง API แท้จากค่ายใหญ่ ไม่ผ่านเอเย่นต์" as="h2">
    <p class="text-left text-base leading-relaxed">
      จุดยืนข้อแรกของเราคือไม่มีอะไรมาคั่นกลางระหว่างปุ่มสปินกับเซิร์ฟเวอร์ของค่ายเจ้าของเกม ทุกเกมในล็อบบี้เชื่อมด้วย API แท้ที่ต่อตรงกับต้นทาง คำสั่งจึงวิ่งออกไปบันทึกที่ค่ายแล้วส่งผลกลับมาตามที่ตัวสุ่มของค่ายตัดสินจริง
      โครงสร้างแบบไม่ผ่านเอเย่นต์ทำให้ไม่มีจุดไหนเลยที่ใครจะเข้าไปแตะผลของแต่ละสปินได้ระหว่างทาง
      ระบบทั้งหมดวางอยู่บนเซิร์ฟนอกที่ทำตามมาตรฐานสากล อัตราจ่ายของแต่ละเกมเป็นค่าที่ค่ายกำหนดมาเอง เราไม่ปรับ ไม่หรี่ และไม่ตั้งเงื่อนไขซ่อนไว้ให้สมาชิกคนใดคนหนึ่งต่างจากคนอื่น
      คนที่ปั่นหลักสิบกับคนที่ปั่นหลักหมื่นจึงอยู่บนระบบชุดเดียวกัน สิ่งที่เปลี่ยนได้คือโปรโมชันและบริการ ไม่ใช่กลไกของเกม
    </p>
  </ContentBox>

  <ContentBox title="คลังเกมลิขสิทธิ์แท้หลายค่าย ทั้ง PG Soft, Pragmatic Play และ Joker Gaming" as="h2">
    <p class="text-left text-base leading-relaxed">
      เรื่องคลังเกมเราจัดเต็มตั้งแต่วันแรก ล็อบบี้รวมสล็อตลิขสิทธิ์แท้จากค่ายดังอย่าง PG Soft, Pragmatic Play, Joker Gaming และค่ายชั้นนำอื่น ๆ มาไว้แบบแน่น ๆ ทุกเกมมาจากต้นทางของค่ายเอง ไม่ใช่เกมหน้าตาเหมือนที่ทำเลียนแบบขึ้นมา
      สิ่งที่เราคัดคือตัวที่แตกง่ายและมีอะไรให้ลุ้นจริง ทั้งฟีเจอร์<strong class="text-[#ffa14a]">ตัวคูณหนัก</strong>ที่ทบยอดขึ้นไปได้หลายชั้น ฟรีสปินที่เข้าไวพอจะได้เห็นในรอบที่นั่งปั่นจริง และอัตราการจ่ายเงินรางวัลที่ยุติธรรมกับคนเล่น
      แต่ละค่ายมีบุคลิกของตัวเองชัดเจน บางค่ายเด่นเรื่องงานภาพและตัวละครที่ทำออกมาไม่ซ้ำ บางค่ายเด่นเรื่องจังหวะเกมที่กระชับและฟีเจอร์ที่เข้าใจง่ายตั้งแต่สปินแรก
      การมีทุกค่ายอยู่ในยูสเซอร์เดียวจึงแปลว่าเลือกได้ตามอารมณ์ของคืนนั้น ไม่ใช่ตามว่าเว็บมีอะไรให้
    </p>
  </ContentBox>

  <ContentBox title="ล็อบบี้เดียวครบทุกแนว ตั้งแต่สล็อต 3D ถึงสายซื้อฟีเจอร์ ในกระเป๋าเดียว" as="h2">
    <p class="text-left text-base leading-relaxed">
      คนที่ปั่นสล็อตส่วนใหญ่ไม่ได้อยู่กับเกมเดียวทั้งคืน เราจึงจัดหมวดหมู่ในล็อบบี้ให้หาเจอไวที่สุดเท่าที่ทำได้ เริ่มจากสล็อตสายภาพสวย 3D ที่ทำงานภาพกับแอนิเมชันมาเต็ม ไปสล็อตสตรีตนำโชคที่จังหวะกระชับและอ่านง่าย
      แล้วขยับไปสล็อตสายซื้อฟีเจอร์สำหรับคนที่ไม่อยากรอ กดพุ่งชนโบนัสได้ทันทีในรอบเดียว ทั้งหมดอยู่ในหน้าเดียวกัน กดเลือกหมวดที่อยากเล่นได้เลยโดยไม่ต้องไล่หาทีละหน้า
      จุดที่ทำให้สลับได้อิสระจริงคือ<strong class="text-[#ffa14a]">กระเป๋าเดียว ยูสเซอร์เดียว</strong> ย้ายจากเกมของค่ายหนึ่งไปอีกค่ายเป็นแค่การเลือกเกม
      ไม่ต้องสมัครหลายเว็บเพื่อเล่นเกมที่ชอบ ไม่ต้องกดโอนยอดข้ามค่ายให้เสียจังหวะ และไม่มีเครดิตตกค้างอยู่ในค่ายที่เพิ่งออกมาให้ต้องตามเก็บทีหลัง
    </p>
  </ContentBox>

  <ContentBox title="ระบบหลังบ้านโหลดไว สลับเกมลื่นไม่สะดุด ไม่ปล่อยจังหวะให้หลุด" as="h2">
    <p class="text-left text-base leading-relaxed">
      ความเร็วคือส่วนที่เราลงแรงมากที่สุด และเป็นเหตุผลที่คำว่าสายสปีดอยู่ในชื่อของสิ่งที่เราทำ ระบบหลังบ้านถูกปรับจูนมาให้โหลดไวกว่าเว็บทั่วไปหลายเท่า กดเข้าหน้าเว็บแล้วพร้อมลุยได้เลย ไม่ต้องนั่งมองหน้าจอหมุนค้างให้เสียอารมณ์
      ขั้นตอนที่ไม่จำเป็นถูกตัดออกทั้งหมด จากหน้าแรกถึงตัวเกมเหลือแค่คลิกเดียว
      ตอนสลับเกมก็เป็นอีกเรื่องที่เราทำมาให้ดี ปั่นเกมนี้จนพอใจแล้วอยากเปลี่ยนไปลองตัวอื่น ระบบตอบสนองได้ฉับไว สลับค่ายสลับเกมได้ทันทีโดยไม่ต้องรอโหลดหน้าคีย์ข้อมูลใหม่
      ตัวเกมประมวลผลสมูธ กราฟิกแสดงผลคมชัด ไม่มีอาการกระตุกหรือหลุดออกจากเกมกลางรอบโบนัสให้ต้องมานั่งเสียดาย ความเร็วแบบนี้ไม่ได้ทำให้ใครชนะบ่อยขึ้น แต่ทำให้จังหวะที่ตั้งใจจะเล่นไม่หลุดมือไปเพราะระบบ ซึ่งเป็นคนละเรื่องกันและสำคัญพอ ๆ กัน
    </p>
  </ContentBox>

  <ContentBox title="รองรับมือถือ แท็บเล็ต และคอมพิวเตอร์ เปิดให้บริการตลอด 24 ชั่วโมง" as="h2">
    <p class="text-left text-base leading-relaxed">
      เว็บปรับสเกลหน้าจอให้อัตโนมัติแบบสมบูรณ์ ไม่ว่าจะถนัดปั่นบนมือถือ iOS หรือ Android เปิดบนแท็บเล็ต หรือนั่งเล่นจอใหญ่บนคอมพิวเตอร์ โครงสร้างเว็บถูกวางให้แสดงผลคมชัด ลื่นไหล และเสถียรเท่ากันทุกช่องทาง
      ปุ่มกดต่าง ๆ วางในตำแหน่งที่ใช้นิ้วโป้งกดถึงโดยไม่ต้องขยับมือ เล่นบนมือถือได้สบาย ๆ ไม่มีอะไรเกะกะสายตา และไม่ต้องโหลดแอปเพิ่มให้กินพื้นที่เครื่อง
      ด้านเวลาเปิดบริการ เราไม่มีการปิดปรับปรุงระบบแบบไม่แจ้งล่วงหน้า เซิร์ฟเวอร์วางไว้ให้เสถียรสูงและพร้อมเปิดตลอด 24 ชั่วโมง
      จะเป็นสายปั่นช่วงพักเที่ยงหรือสายลุยดึก ๆ จังหวะโบนัสและระบบฝากถอนก็ทำงานด้วยความเร็วสูงสุดเท่ากันตลอดวัน หยิบมือถือขึ้นมาตอนไหนก็ต่อความสนุกได้ทันทีจากจุดที่ค้างไว้
    </p>
  </ContentBox>

  <ContentBox title="ฝากถอนออโต้ไฮสปีด เสร็จในไม่กี่วินาที ไม่ต้องส่งสลิป ไม่ต้องรอแอดมิน" as="h2">
    <p class="text-left text-base leading-relaxed">
      ระบบการเงินคือส่วนที่เราเลือกให้เครื่องทำงานแทนคนทั้งหมด ฝากถอนเป็นออโต้ไฮสปีดเต็มรูปแบบ ทำรายการเสร็จภายในไม่กี่วินาทีนับจากกดยืนยัน ไม่ต้องถ่ายสลิปส่งให้ใคร ไม่ต้องต่อคิวรอแอดมินอนุมัติ
      ปั่นได้เท่าไหร่กดถอนออกได้ครบเต็มจำนวนทันทีจากหน้าแดชบอร์ดเดียวกับที่ใช้เลือกเกมและกดรับโปร
      สิ่งที่ยังต้องตรวจด้วยตัวเองมีสองอย่าง คือผูกชื่อบัญชีธนาคารให้ตรงกับข้อมูลสมาชิก และเข้าใช้งานผ่านลิงก์ที่ตรวจชื่อเว็บไซต์แล้วเท่านั้น
      ทั้งนี้สล็อตยังเป็นเกมที่ผลของแต่ละสปินเป็นอิสระจากกันเสมอ การตั้งงบต่อสปินให้พอดีกับทุนของวันนั้น เลือกเกมให้ตรงกับงบ และหยุดเมื่อถึงขีดที่ตั้งไว้
      ยังเป็นเรื่องสำคัญที่สุดที่เราอยากให้ถือติดตัวไว้เสมอ
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
