---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 154.
const pageDescription =
  "เกี่ยวกับ กงล้อ88 เว็บตรงสล็อตไม่ผ่านเอเย่นต์ ไม่ล็อคยูส ไม่ลด RTP รวมค่ายดังไว้ล็อบบี้เดียว ฝากถอนออโต้ไม่ต้องส่งสลิป ฐานการเงินมั่นคง จ่ายจริงถอนไม่อั้น";

const pageTitle = "เกี่ยวกับ กงล้อ88 เว็บตรงสล็อตไม่ผ่านเอเย่นต์ จ่ายจริงถอนไม่อั้นทุกยอด";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="text-left text-base leading-relaxed">
        กงล้อ88 (WHEEL88) เริ่มต้นจากโจทย์ข้อเดียวคืออยากให้คนที่ชอบหมุนสล็อตมีที่เล่นที่ไม่ต้องคอยระแวงหลังบ้าน เราจึงเลือกเปิดเป็นเว็บตรงเต็มตัว
        ดูแลระบบเอง ดูแลการเงินเอง และรับผิดชอบทุกยอดที่เกิดขึ้นบนเว็บด้วยตัวเอง โดยไม่มีเอเย่นต์หรือคนกลางมายืนคั่นระหว่างผู้เล่นกับเกม
        หน้านี้ไม่ได้เขียนไว้ขายของ แต่เขียนไว้บอกว่าเรายืนอยู่บนอะไรบ้าง ตั้งแต่กติกาของเกม ระบบเงิน ค่ายที่เลือกเข้าล็อบบี้ ไปจนถึงเรื่องที่เราสัญญาว่าจะไม่ทำ
        เพื่อให้คนที่กำลังชั่งใจอยู่อ่านจบแล้วรู้ว่ากำลังคุยอยู่กับใคร
      </p>
    </div>
  </ContentBox>

  <ContentBox title="จุดยืนของเรา เว็บตรงไม่ผ่านเอเย่นต์ ไม่ล็อคยูส และไม่ปรับลด RTP" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        สิ่งแรกที่เราตัดสินใจตั้งแต่วันเปิดคือไม่รับงานผ่านเอเย่นต์ เพราะทุกชั้นที่แทรกเข้ามาระหว่างผู้เล่นกับระบบเกม คือช่องที่ทำให้ตัวเลขถูกขยับได้โดยเจ้าของยูสไม่มีทางรู้
        เมื่อเราเชื่อมกับค่ายเกมโดยตรง เราจึงไม่มีทั้งเครื่องมือและไม่มีเหตุผลที่จะล็อคยูสของใคร หรือปรับลดอัตราการจ่ายของเกมตัวไหน
        วงล้อที่คุณเห็นคือชุดเดียวกับที่ค่ายส่งมา ผลของแต่ละรอบมาจากกลไกสุ่มของค่ายนั้นล้วน ๆ เราไม่แตะ และไม่มีการหักเปอร์เซ็นต์ย้อนหลังจากยอดที่ชนะไปแล้ว
        ความโปร่งใสตรงนี้ไม่ใช่คำโฆษณา แต่เป็นผลจากโครงสร้างที่เราเลือกไว้ตั้งแต่ต้น
      </p>
    </div>
  </ContentBox>

  <ContentBox title="หมุนกงล้อพารวย กิจกรรมเสี่ยงทายและโบนัสที่เราตั้งใจแจกทุกวัน" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        ชื่อแบรนด์ของเรามาจากกงล้อ และเราตั้งใจให้มันเป็นของจริงไม่ใช่แค่ลวดลายบนโลโก้ ทุกวันจะมีรอบเสี่ยงทายและกิจกรรมแจกโบนัสให้สมาชิกที่ล็อกอินเข้ามาร่วมสนุกได้
        ไม่ต้องเติมหนักถึงจะมีสิทธิ์ และไม่ต้องรอเทศกาลถึงจะได้ลุ้น เหตุผลที่ออกแบบแบบนี้ตรงไปตรงมามาก คนที่ได้หมุนบ่อยขึ้นคือคนที่อยู่กับเรานานขึ้น
        และเราอยากโตจากสมาชิกที่กลับมาเล่นซ้ำ มากกว่าโตจากคนที่แวะเข้ามาครั้งเดียวแล้วหายไป เงื่อนไขการทำยอดและรอบการรับสิทธิ์ของแต่ละกิจกรรมเขียนไว้ชัดในหน้าโปรโมชั่น
        อ่านให้ครบก่อนกดรับได้เสมอ เพราะเราไม่มีเงื่อนไขที่ซ่อนไว้รอตอนถอน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ระบบฝากถอนออโต้ที่จบได้ในตัวเอง ไม่ต้องส่งสลิป ไม่ต้องรอแอดมิน" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        ที่นี่ไม่มีขั้นตอนส่งสลิป ไม่มีการรอแอดมินกดยืนยัน และไม่มีเวลาทำการของระบบการเงิน ทุกอย่างเป็นออโต้ผ่านหน้าเว็บตั้งแต่ต้นจนจบ
        ผูกบัญชีธนาคารหรือทรูวอลเล็ทไว้ครั้งเดียว จากนั้นฝากและถอนได้ด้วยตัวเองทุกเวลา ยอดเดินภายในไม่กี่วินาที รองรับธนาคารชั้นนำครบทุกแห่ง
        และย้อนดูประวัติรายการทั้งหมดของตัวเองได้ตลอดโดยไม่ต้องทักถามใคร ที่เราลงแรงกับส่วนนี้มากเป็นพิเศษ เพราะจังหวะที่คนเล่นหงุดหงิดที่สุดไม่ใช่ตอนเสีย
        แต่คือตอนที่เงินของตัวเองค้างอยู่ในระบบโดยไม่มีใครตอบได้ว่าอีกนานแค่ไหน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ค่ายเกมที่เราคัดเข้าล็อบบี้ และเกณฑ์ที่ใช้ตัดสินว่าค่ายไหนผ่าน" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        ล็อบบี้ของเรารวมค่ายใหญ่ที่คนไทยเล่นกันจริง ทั้ง PG Slot, Joker Gaming และ Pragmatic Play รวมถึงค่ายชั้นนำระดับโลกอีกหลายเจ้าไว้ในยูสเซอร์เดียว
        แต่เราไม่ได้เปิดรับทุกค่ายที่ติดต่อเข้ามา เกณฑ์ที่ใช้คัดมีสามข้อ ข้อแรกค่ายต้องเป็นต้นทางจริงไม่ใช่ระบบที่คัดลอกหน้าเกมมา ข้อสองเกมต้องลื่นบนมือถือรุ่นกลาง
        ไม่ใช่ลื่นเฉพาะบนเครื่องแรง และข้อสามฟีเจอร์โบนัสกับรอบฟรีสปินต้องเข้าถึงได้จริงในระดับทุนที่สมาชิกส่วนใหญ่ใช้เล่น ค่ายไหนไม่ผ่านสามข้อนี้เราก็ไม่เอาเข้าล็อบบี้
        ต่อให้ชื่อจะดังแค่ไหนก็ตาม
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ฐานการเงินที่มั่นคง คือเหตุผลที่เรากล้าบอกว่าจ่ายเต็มถอนไม่อั้น" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        คำถามที่เราถูกถามบ่อยที่สุดคือถ้าชนะก้อนใหญ่แล้วจะได้จริงไหม คำตอบคือได้ และไม่มีการแบ่งจ่ายเป็นงวด ไม่มีการอั้นยอดถอนต่อวัน
        ไม่มีเงื่อนไขที่เพิ่งโผล่มาตอนกดถอน สิ่งที่ทำให้เรายืนยันแบบนี้ได้ไม่ใช่คำพูดสวย ๆ แต่คือทุนหมุนเวียนที่เตรียมเผื่อยอดชนะก้อนใหญ่ไว้ตั้งแต่ก่อนวันเปิดให้บริการ
        เราคิดเสมอว่าเว็บที่จ่ายช้าเพียงครั้งเดียวคือเว็บที่เสียคนเล่นไปถาวร ต้นทุนในการรักษาสภาพคล่องจึงถูกกว่าราคาที่ต้องจ่ายในวันที่ความน่าเชื่อถือหายไปมาก
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สมัครสมาชิกไม่ถึงหนึ่งนาที แล้วเริ่มหมุนได้ทันทีด้วยยูสเดียว" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        ขั้นตอนสมัครของเราใช้เวลาไม่ถึงหนึ่งนาที กรอกเบอร์โทรที่ใช้งานจริงกับบัญชีรับเงิน ตั้งรหัสผ่าน แล้วรับยูสเซอร์เข้าเล่นได้ทันที
        ยูสเดียวใช้ได้กับทุกค่ายในล็อบบี้ ไม่ต้องโยกเงินไปมาและไม่ต้องออกจากระบบเพื่อสลับเกม สิ่งเดียวที่อยากให้ใช้เวลาตรวจสักครู่คือชื่อบัญชีธนาคารต้องตรงกับชื่อผู้สมัคร
        เพราะระบบการเงินอ่านชื่อบัญชีเป็นหลัก กรอกผิดแล้วต้องตามแก้ทีหลัง ความเร็วที่ได้มาก็หายไปหมด และสมาชิกใหม่ทุกคนจะเห็นสิทธิ์โปรโมชั่นต้อนรับรออยู่ในหน้าโปรโมชั่นตั้งแต่วันแรก
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
