---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

// AURA456: ticker หมุนมาเป็น AnnouncementCyber ส่วนกล่องหน้าย่อยยังเป็น ContentBox
// (การ์ดถาวรของหน้าย่อย) ตามสเปกรอบนี้ เรียก <Announcement /> เปล่า ๆ เพราะ
// default message ของ variant นี้ถูกตั้งเป็นข้อความของแบรนด์นี้แล้ว
// สีเน้นในย่อหน้าใช้บานเย็นหลัก #ff2fb0 คู่ฟ้าอิเล็กทริก #7fd0ff ของพาเลตต์รอบนี้
// ส่วนสีเนื้อความมาจากการ์ดเอง ไม่ต้องระบุซ้ำ
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 158.
const pageDescription =
  "เกี่ยวกับเรา AURA456 เว็บตรงสล็อตคัดเกรด รันบนเซิร์ฟเวอร์หลัก API แท้ 100% ค่า RTP โปร่งใส ไม่ดัดแปลงหลังบ้าน รวมค่ายดัง เบทเริ่ม 1 บาท ฝากถอนออโต้ 3-5 วินาที";

const pageTitle = "เกี่ยวกับเรา AURA456 | เว็บตรงสล็อตคัดเกรด API แท้ ออโต้ 3-5 วินาที";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา AURA456";

// docx รอบนี้ไม่มีส่วน SUB-PAGES จึงไม่มีบอดี้สำเร็จรูปให้หน้านี้ — หัวข้อและ
// ย่อหน้าทั้งหกบล็อกด้านล่างเขียนขึ้นใหม่จากข้อเท็จจริงของแบรนด์ในบรีฟรอบนี้
// (เว็บตรงสล็อตคัดเกรด รันบนเซิร์ฟเวอร์หลักด้วย API แท้ 100% ค่า RTP โปร่งใส
// ไม่ดัดแปลงระบบหลังบ้าน โครงสร้างเว็บตอบสนองไวตั้งแต่คลิกแรก ไร้ป๊อปอัปโฆษณา
// กราฟิก 3D ลื่นไม่กระตุกแม้ช่วงพีค รวมเกมลิขสิทธิ์แท้จาก PG Soft, Pragmatic
// Play และ Joker เบทเริ่มต้น 1 บาท หมวดเกมฮิตกระแสแรงขึ้นหน้าแรก กลไก Cascading
// / Multiplier / Wild ยืดขยาย / Bonus Buy โบนัสต้อนรับ โปรฝากแรกของวัน และ
// Cash Back คืนยอดเสีย ไม่ติดเทิร์นโอเวอร์ กระเป๋าเดียวสลับค่ายได้ ฝากถอนออโต้
// 3-5 วินาที และทีมงานดูแลตลอด 24 ชั่วโมง)
// — ไม่ลอกย่อหน้าในบรีฟมาทั้งดุ้น เพราะย่อหน้าชุดนั้นใช้เต็ม ๆ อยู่บนหน้าแรกแล้ว
// โครงเป็น h1×1 + h2×6 ไม่มี h3
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="text-left text-base leading-relaxed">
      <strong class="text-[#ff2fb0]">AURA456</strong> เริ่มต้นจากโจทย์ที่ตรงไปตรงมาว่าเว็บสล็อตที่ดีไม่ควรทำให้คนเล่นต้องลุ้นสองชั้น ชั้นแรกคือลุ้นวงล้อ ส่วนชั้นที่สองคือลุ้นว่าระบบหลังบ้านจะซื่อตรงกับที่โฆษณาไว้หรือเปล่า
      เราจึงวางเว็บนี้เป็นเว็บตรงคัดเกรดที่รันบนเซิร์ฟเวอร์หลักด้วย API แท้ 100% ไม่มีตัวกลาง ไม่มีการดัดแปลงระบบหลังบ้าน และค่า RTP ที่เห็นก็เป็นค่าเดียวกับที่ค่ายเกมตั้งไว้
      ที่เหลือคือหน้าที่ของเราล้วน ๆ คัดเกมที่เล่นแล้วสนุกจริงเข้าล็อบบี้ จัดหน้าให้หาเจอเร็ว เติมสิทธิ์ที่ถอนได้จริงให้ทุกวัน แล้วปล่อยให้ระบบออโต้รับงานฝากถอนไปทำแทนคนทั้งหมด
      เพื่อให้เวลาของสมาชิกหมดไปกับการสปิน ไม่ใช่การรอ
    </p>
  </ContentBox>

  <ContentBox title="เว็บตรงคัดเกรดที่รันบนเซิร์ฟเวอร์หลักด้วย API แท้ 100%" as="h2">
    <p class="text-left text-base leading-relaxed">
      จุดยืนแรกของเราคือไม่มีอะไรคั่นกลางระหว่างคำสั่งสปินกับเซิร์ฟเวอร์ของค่ายเกม ทุกเกมในล็อบบี้เชื่อมด้วย API แท้ 100% ที่ต่อตรงกับเซิร์ฟเวอร์หลัก คำสั่งจึงวิ่งออกไปคำนวณที่ต้นทางแล้วส่งผลกลับมาตามที่ค่ายกำหนดเอง
      โครงสร้างแบบนี้ทำให้ไม่มีจุดไหนเลยที่ใครจะเข้าไปแตะผลการออกรางวัลได้ระหว่างทาง
      ค่า RTP ของทุกเกมจึงเป็นค่าที่โปร่งใส ตรวจสอบเทียบกับค่ายต้นทางได้ และเราไม่มีการดัดแปลงระบบหลังบ้านเพื่อขยับอัตราจ่ายในช่วงเวลาใดเวลาหนึ่ง สิ่งที่เปลี่ยนได้คือโปรโมชันและบริการ ไม่ใช่กลไกของเกม
      สมาชิกที่เบทหลักบาทกับสมาชิกที่เบทหลักพันจึงเล่นอยู่บนระบบประมวลผลชุดเดียวกัน ไม่มีเกมหรือความเร็วระดับไหนถูกกันไว้ให้เฉพาะบางกลุ่ม
    </p>
  </ContentBox>

  <ContentBox title="โครงสร้างเว็บที่ตอบสนองไวตั้งแต่คลิกแรก ไม่มีป๊อปอัปมากวน" as="h2">
    <p class="text-left text-base leading-relaxed">
      ความเร็วของเว็บเป็นเรื่องที่เราถือว่าเป็นส่วนหนึ่งของประสบการณ์เล่น ไม่ใช่เรื่องเทคนิคหลังบ้านที่ผู้เล่นไม่ต้องรู้ เราจึงวางสถาปัตยกรรมหน้าเว็บให้ตอบสนองตั้งแต่คลิกแรก
      ล็อบบี้เปิดไว เข้าเกมได้โดยไม่ต้องนั่งดูแถบโหลดค้าง และอินเทอร์เฟซถูกเก็บให้สะอาดตาโดยไม่มีป๊อปอัปโฆษณาเด้งขวางจังหวะ
      อีกด้านที่ให้ความสำคัญไม่แพ้กันคือการรับน้ำหนักช่วงพีค เกมสมัยใหม่ใช้กราฟิก 3D ที่กินทรัพยากรมากกว่าสล็อตรุ่นเก่าหลายเท่า เราจึงเผื่อกำลังของระบบไว้สำหรับช่วงที่คนเข้าพร้อมกันหนาแน่นที่สุด
      เป้าหมายคือให้จังหวะสปินยังลื่นเท่าเดิม ไม่มีอาการเกมค้างหรือหลุดออกกลางรอบมาทำลายอารมณ์ที่กำลังไปได้ดี
    </p>
  </ContentBox>

  <ContentBox title="เกมลิขสิทธิ์แท้จาก PG Soft, Pragmatic Play และ Joker ในล็อบบี้ที่หาเจอง่าย" as="h2">
    <p class="text-left text-base leading-relaxed">
      คลังเกมของเราคัดจากค่ายที่มีลิขสิทธิ์แท้เท่านั้น ทั้ง PG Soft, Pragmatic Play, Joker และค่ายชั้นนำอื่น ๆ ที่จ่ายรางวัลตามอัลกอริทึมของโรงงานเกมเอง ไม่ใช่ไฟล์ก๊อบที่หน้าตาเหมือนแต่กลไกข้างในไม่ตรงกับต้นฉบับ
      เกณฑ์ที่ใช้คัดคืออัตราจ่ายต้องเป็นธรรมและฟีเจอร์ต้องทำงานจริงตามที่ค่ายเขียนไว้ ส่วนเพดานการเข้าถึงเราตั้งใจให้ต่ำ เบทเริ่มต้นของหลายเกมอยู่ที่ 1 บาทต่อรอบ คนที่อยากลองจับทางเกมใหม่จึงไม่ต้องเตรียมทุนก้อนใหญ่ก่อนถึงจะได้เริ่ม
      เกมเยอะเป็นข้อดีก็ต่อเมื่อหาเจอ เราจึงลงแรงกับการจัดระเบียบหน้าล็อบบี้พอ ๆ กับการคัดเกมเข้ามา หมวด<strong class="text-[#7fd0ff]">เกมฮิตกระแสแรง</strong>ถูกวางไว้ให้เห็นตั้งแต่เข้าสู่ระบบ
      ค่ายไหนเพิ่งปล่อยเกมใหม่ หรือช่วงนี้คนกำลังปั่นเกมอะไรกันมาก เราดึงขึ้นมาไว้หน้าแรกให้เลย ไม่ต้องเลื่อนไล่ทีละหน้าเพื่อตามหาตัวที่กำลังมา
      และเพราะทุกค่ายอยู่ในกระเป๋าเดียวกัน การเปลี่ยนจากค่ายสายภาพสวยไปหาค่ายสายโบนัสหนักจึงเป็นแค่การเลือกเกม ไม่ต้องโยกเงินไปมาและไม่มียอดตกค้างอยู่ในค่ายที่เพิ่งออกมา
    </p>
  </ContentBox>

  <ContentBox title="ฟีเจอร์ครบมือ ทั้ง Cascading, Multiplier, Wild ยืดขยาย และ Bonus Buy" as="h2">
    <p class="text-left text-base leading-relaxed">
      สิ่งที่ทำให้การสปินไม่น่าเบื่อคือกลไกของตัวเกม เราจึงเลือกเกมที่มีลูกเล่นทำเงินยุคใหม่เข้ามาไว้ให้ครบชุด ทั้งระบบ Cascading ที่สัญลักษณ์แตกต่อเนื่องเป็นคอมโบในรอบเดียว
      และระบบ Multiplier ที่สุ่มแจกตัวคูณและทบขึ้นไปตามจังหวะของรอบนั้น ๆ
      อีกสองกลไกที่สายสปินมองหาเป็นพิเศษคือสัญลักษณ์ Wild แบบยืดขยายทับรีล ซึ่งเปลี่ยนหน้าตาของรอบทั้งรอบได้ในทีเดียว และโหมด Bonus Buy สำหรับคนที่ไม่อยากรอจังหวะฟรีสปินมาเอง
      สามารถซื้อเข้าฟีเจอร์ไปลุ้นรางวัลใหญ่ได้เลย
      ทั้งหมดนี้มีโหมดให้ลองจับทางก่อนลงเงินจริง เพราะการรู้จังหวะโบนัสและความถี่ของฟรีสปินล่วงหน้า ช่วยให้วางงบต่อรอบได้แม่นกว่าการเดา ส่วนผลของแต่ละสปินยังเป็นการสุ่มตามกลไกของค่ายเสมอ
    </p>
  </ContentBox>

  <ContentBox title="สิทธิ์ที่ถอนได้จริง โบนัสต้อนรับ โปรฝากแรกของวัน และ Cash Back คืนยอดเสีย" as="h2">
    <p class="text-left text-base leading-relaxed">
      โปรโมชันของเราตั้งใจเขียนให้กดรับแล้วได้ใช้จริง ไม่ใช่ตัวเลขไว้โชว์หน้าเว็บ ชุดหลักมีสามรายการที่วนอยู่ตลอด ได้แก่ โบนัสต้อนรับสำหรับสมาชิกใหม่ที่เพิ่มทุนให้ตั้งแต่รอบแรก
      โปรเพิ่มทุนสำหรับยอดฝากแรกของวันที่ออกแบบมาให้สายเล่นต่อเนื่อง และระบบคืนยอดเสีย Cash Back ที่ส่งทุนกลับไปให้แก้ตัวใหม่ในวันถัดไป
      จุดที่เราถือเป็นเรื่องจริงจังคือเงื่อนไขต้องอ่านจบในบรรทัดเดียว ถอนได้จริง และไม่มีเทิร์นโอเวอร์มหาโหดซ่อนไว้ท้ายรายการ
      สิ่งที่ยังต้องดูเองก่อนกดรับคือเพดานและรอบเวลาของแต่ละสิทธิ์ เพราะแต่ละรายการคิดจากยอดคนละชุดและมีจังหวะของตัวเอง เลือกให้ตรงกับสไตล์การเล่นของวันนั้นจะคุ้มกว่าการกดรับทุกอย่างที่เห็น
    </p>
  </ContentBox>

  <ContentBox title="ฝากถอนออโต้ 3-5 วินาที และทีมงานที่ยังอยู่ตลอด 24 ชั่วโมง" as="h2">
    <p class="text-left text-base leading-relaxed">
      ระบบการเงินคือส่วนที่เราเลือกให้เครื่องทำงานแทนคนทั้งหมด ฝากถอนเป็นออโต้ 100% เชื่อมต่อตรงกับธนาคารและแอปพลิเคชันวอลเล็ท ทำรายการเสร็จภายใน 3-5 วินาที
      ไม่ต้องถ่ายสลิปส่งให้แอดมินยืนยัน ไม่ต้องต่อคิวรออนุมัติ ฝากเสร็จเข้าเล่นได้ทันที และเมื่อปั่นได้กำไรก็กดถอนเข้าบัญชีได้เองตลอด 24 ชั่วโมง
      สิ่งที่ยังต้องตรวจด้วยตัวเองมีสองอย่าง คือผูกชื่อบัญชีธนาคารให้ตรงกับข้อมูลสมาชิก และเข้าใช้งานผ่านลิงก์ที่ตรวจชื่อเว็บไซต์แล้วเท่านั้น
      ส่วนงานที่เครื่องทำแทนไม่ได้ยังมีทีมงานรับอยู่ตลอดวัน ถามเรื่องระบบ ติดขัดตรงไหน หรืออยากได้คำแนะนำเรื่องการทำรายการก็ทักมาได้ ทั้งนี้สล็อตยังเป็นเกมที่ผลลัพธ์สุ่มทุกรอบ
      การตั้งงบต่อสปินให้พอดีกับทุนของวันนั้นและหยุดเมื่อถึงขีดที่ตั้งไว้ ยังเป็นเรื่องสำคัญที่สุดที่เราอยากให้ถือติดตัวไว้เสมอ
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
