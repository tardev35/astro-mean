---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 151.
const pageDescription =
  "รู้จัก 9UFA เว็บสล็อตยอดนิยม ที่รวมค่ายเกมลิขสิทธิ์แท้ต่อตรง API สมัครใหม่รับทุนเล่นฟรี 199 บาททันที ไม่ต้องแชร์ เทิร์นต่ำถอนง่าย ระบบลื่นไหลไม่มีสะดุด";

// The ticker on this page carries the about-page framing (who we are) rather
// than the homepage's promo framing, so the two do not read as one duplicated
// strip when a visitor moves between them.
const tickerMessage =
  "9UFA เว็บสล็อตยอดนิยมที่เปิดให้เล่นด้วยเกมลิขสิทธิ์แท้ต่อตรง API ทุกค่าย • สมัครสมาชิกใหม่รับทุนเล่นฟรี 199 บาท ไม่ต้องกดแชร์ ไม่ต้องส่งหลักฐาน • เทิร์นโอเวอร์ต่ำ ถอนเข้าบัญชีได้เองตลอดเวลา • เซิร์ฟเวอร์รองรับผู้เล่นพร้อมกันหลักแสน ลื่นไหลไม่มีสะดุด";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ 9UFA เว็บสล็อตยอดนิยม รวมค่ายเกมลิขสิทธิ์แท้ แจกทุนฟรี 199",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

const headingClass = "mt-8 mb-6 bg-gradient-to-r from-[#0743a8] via-[#0a5df1] to-[#01cbf6] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="เกี่ยวกับเรา 9UFA เว็บสล็อตยอดนิยม แจกโหด รับเครดิตฟรี 199 ไม่ต้องแชร์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={tickerMessage} />

  <ContentBox title="เกี่ยวกับ 9UFA เว็บสล็อตยอดนิยม รวมค่ายเกมลิขสิทธิ์แท้ แจกทุนฟรี 199" as="h1">
    <div>
      <h2 class="mb-6 bg-gradient-to-r from-[#0743a8] via-[#0a5df1] to-[#01cbf6] bg-clip-text text-2xl leading-normal font-bold text-transparent">
        9UFA คือใคร และทำไมสายปั่นถึงเลือกที่นี่เป็นเว็บหลัก
      </h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#0b3a63]">
        วงการสล็อตทุกวันนี้หาเว็บที่แจกจริงจ่ายจริงยากขึ้นทุกวัน ส่วนใหญ่เป็นโปรหลอกตาที่อ่านเงื่อนไขแล้วรับไม่ได้จริงสักข้อ 9UFA จึงตั้งใจเปิดขึ้นมาเพื่อฉีกกฎการเดิมพันแบบเดิม
        ด้วยแนวคิดง่าย ๆ ว่าผู้เล่นควรได้ทุนไปเริ่มต้นจริง ได้เงื่อนไขที่อ่านจบในบรรทัดเดียว และได้ถอนเงินที่ตัวเองทำได้ออกไปใช้โดยไม่ติดกำแพง
        เราไม่หมกเม็ดข้อกำหนดไว้ท้ายหน้า ไม่ตั้งเงื่อนไขซ่อนไว้เพื่อกันยอดถอน และไม่ขอให้ใครทำอะไรที่เสียความเป็นส่วนตัวเพื่อแลกกับโบนัส
        นี่คือพื้นที่ทำเงินที่แฟร์กับผู้เล่นตั้งแต่วินาทีแรกที่กดสมัคร ไปจนถึงวินาทีที่เงินเข้าบัญชี
      </p>

      <h2 class={headingClass}>แหล่งรวมค่ายเกมลิขสิทธิ์แท้ ต่อตรง API ไม่ผ่านคนกลาง</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#0b3a63]">
        เราไม่ได้มีดีแค่เรื่องโปรโมชั่น เพราะเรื่องตัวเกมก็จัดเต็มไม่แพ้ใคร ที่นี่รวบรวมค่ายสล็อตระดับโลกมาไว้ในกระเป๋าเดียว ทุกเกมดึงสัญญาณตรงผ่าน API ลิขสิทธิ์แท้จากค่ายต้นทาง
        ไม่ผ่านคนกลางที่ไหนทั้งสิ้น ผลคือค่า RTP หรือเปอร์เซ็นต์การจ่ายรางวัลอยู่ในระดับมาตรฐานสากลตามที่ค่ายตั้งมาจริง ไม่ได้ถูกปรับลดระหว่างทาง
        ไม่ว่าคุณจะถนัดสล็อตผลไม้คลาสสิกที่อ่านจังหวะง่าย หรือสายซื้อฟรีสปินวัดดวงรอบเดียวจบ ก็เลือกเล่นได้ครบในบัญชีเดียว โบนัสแตกง่าย สแกตเตอร์เข้าบ่อย
        และเราอัปเดตเกมใหม่จากค่ายเข้าคลังอย่างต่อเนื่อง ไม่ใช่ตู้เกมชุดเดิมที่ค้างอยู่ตั้งแต่วันเปิดเว็บ
      </p>

      <h2 class={headingClass}>ทุนเล่นฟรี 199 บาทสำหรับสมาชิกใหม่ ไม่ต้องกดแชร์ลงกลุ่ม</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#0b3a63]">
        สำหรับสายปั่นทุนน้อยหรือคนที่อยากลองระบบก่อนควักกระเป๋าตัวเอง เราเตรียมเครดิตฟรีมูลค่า 199 บาทไว้ต้อนรับสมาชิกใหม่ทุกคนทันทีที่สมัครเสร็จ
        เงินก้อนนี้ไม่ใช่ตัวเลขหลอกตา แต่เป็นทุนที่หมุนได้จริงกับสล็อตค่ายไหนเกมอะไรก็ได้บนเว็บของเรา จึงเป็นตัวช่วยชั้นดีที่จะปั้นยอดจากหลักร้อยขึ้นไปโดยไม่ต้องลงทุนเองแม้แต่บาทเดียว
        และสิ่งที่ทำให้กติกาของเราแฟร์กว่าที่อื่นคือเราตัดเงื่อนไขจุกจิกทิ้งทั้งหมด ไม่ต้องแคปรูปลงกลุ่มเฟซบุ๊ก ไม่ต้องส่งต่อให้เพื่อนในไลน์ ไม่ต้องทักแชทยืนยัน
        แค่สมัครและยืนยันตัวตนผ่านระบบสำเร็จ โบนัสก็ปรับเข้ากระเป๋าเครดิตให้ทันที เอาเวลาที่ต้องมานั่งแชร์ไปโฟกัสกับการปั่นสล็อตดีกว่า
      </p>

      <h2 class={headingClass}>เทิร์นโอเวอร์ต่ำ ถอนง่าย บนเซิร์ฟเวอร์ที่ลื่นไหลไม่มีสะดุด</h2>

      <p class="text-left text-base leading-relaxed text-[#0b3a63]">
        ความเจ็บปวดคลาสสิกของคนรับโบนัสฟรีคือปั่นจนแตกหนักแล้วกลับถอนไม่ได้ เพราะติดยอดเทิร์นโอเวอร์หฤโหด 20-30 เท่า ที่ 9UFA เราตั้งกติกาการทำเทิร์นไว้ต่ำมาก
        เล่นให้ได้ยอดตามที่กำหนดเพียงเล็กน้อยก็กดทำรายการถอนเงินสดเข้าบัญชีได้ทันที ไม่มีกั๊ก ไม่มีอั้นยอดถอนต่อวัน เล่นได้เท่าไหร่จ่ายเต็มทุกบิล
        ส่วนการสมัครก็เป็นระบบออโต้เต็มรูปแบบ กรอกข้อมูลไม่กี่ช่อง ผูกเบอร์มือถือและบัญชีธนาคาร ใช้เวลาไม่ถึงหนึ่งนาทีก็ได้ยูสเซอร์เข้าไปลุยได้เอง โดยข้อมูลทุกอย่างถูกเก็บเป็นความลับ
        เบื้องหลังทั้งหมดคือเซิร์ฟเวอร์เทคโนโลยีล่าสุดที่รองรับคนออนไลน์พร้อมกันหลักแสนคนได้สบาย กราฟิกคมชัด กดเบทแบบเรียลไทม์ไม่มีดีเลย์ ต่อให้เล่นผ่านมือถือสเปคต่ำหรือเน็ตมือถือธรรมดาก็ยังลื่นไหลไม่มีสะดุด
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
