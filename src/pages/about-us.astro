---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// JAICHUA: ticker หมุนมาเป็น AnnouncementPremium ส่วนกล่องหน้าย่อยยังเป็น ContentBox
// (การ์ดถาวรของหน้าย่อย) เรียก <Announcement /> เปล่า ๆ เพราะ default message ของ
// variant นี้ถูกตั้งให้ตรงกับที่หน้าแรกส่งเข้าไปแล้ว
//
// ห้ามใส่คลาสสีลงในย่อหน้าข้างในการ์ด — ContentBox ตั้งสีเนื้อความให้แล้ว การเขียน
// สีทับตรงนี้คือการฝัง hex ของแบรนด์รอบนี้ไว้ในไฟล์ที่รีแบรนด์รอบหน้าไม่ได้เปิด
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 155, and is one
// sentence about what the page is for rather than a table of contents.
const pageDescription = "หน้าแนะนำตัวของ JAICHUA สล็อตเว็บตรง API แท้ ไม่ผ่านเอเย่นต์ ว่าเราเป็นใคร รวมค่ายเกมไหนไว้บ้าง ดูแลค่า RTP อย่างไร และวางระบบฝากถอนออโต้ 3 วินาทีไว้แบบไหน";

const pageTitle = "เกี่ยวกับเรา JAICHUA | สล็อตเว็บตรง API แท้ ค่า RTP ตรงสเปกโรงงาน";

// หัวข้อระดับ h1 ของหน้า แยกจากค่า title เพราะ title มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา JAICHUA";

// docx รอบนี้ไม่มีส่วน SUB-PAGES จึงไม่มีบอดี้สำเร็จรูปให้หน้านี้ — หัวข้อและย่อหน้า
// ด้านล่างเขียนขึ้นใหม่จากข้อเท็จจริงของแบรนด์ในบรีฟรอบนี้ (สล็อตเว็บตรง API แท้
// ยิงตรงจากคลังเกมหลัก ไม่ผ่านเอเย่นต์ · ค่า RTP ตรงตามสเปกโรงงาน ชนะเท่าไหร่ถอนได้
// เท่านั้น ไม่มีหมกเม็ด ไม่ล็อกยูส · ระบบหลังบ้านเสถียร ประมวลผลแม่นยำ ไร้เกมค้าง
// หรือสลีปหลุด คำนวณยอดชนะแบบเรียลไทม์ · ค่ายเกมชั้นนำ PG Soft, Pragmatic Play,
// Joker Gaming ครบทั้งสล็อตวิดีโอ 3D สล็อตตัวคูณสะสม และสายซื้อฟีเจอร์ฟรีสปิน บน
// กระเป๋าเดียว · อัปเดตเกมใหม่เข้าคลังต่อเนื่อง · ลูกเล่นโบนัส Multiplier /
// Expanding Wild / Cascading · โปรกดรับเองผ่านแดชบอร์ด รวมถึง Cash Back ทุกวัน
// เงื่อนไขโปร่งใส ไม่ติดเทิร์นโอเวอร์มหาโหด · ฝากถอนออโต้ผ่าน Gateway ตรง รองรับ
// ธนาคารและ TrueMoney Wallet ทำรายการเสร็จใน 3 วินาที)
// — ไม่ลอกย่อหน้าในบรีฟมาทั้งดุ้น เพราะย่อหน้าชุดนั้นใช้เต็ม ๆ อยู่บนหน้าแรกแล้ว
// หน้านี้จึงเขียนคนละสำนวนในมุม "เราเป็นใคร" จากข้อเท็จจริงชุดเดียวกัน โครงเป็น
// h1×1 + h2×3 ไม่มี h3 และห้ามเติมข้อเท็จจริงที่บรีฟไม่ได้ให้ เช่น เลขใบอนุญาต
// จำนวนสมาชิก รางวัล ทุนสำรอง ชื่อธนาคาร หรือฝั่งหวย/คาสิโนสด — บรีฟรอบนี้เป็น
// เว็บสล็อตล้วน
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="text-left text-base leading-relaxed">
      JAICHUA เริ่มต้นจากคำถามข้อเดียวว่า คนที่ชอบปั่นสล็อตต้องเจอเรื่องกวนใจกี่อย่างกว่าจะได้เล่นจริงสักรอบ เกมค้างกลางฟีเจอร์บ้าง ยอดชนะขึ้นช้ากว่าที่กดบ้าง ถอนแล้วต้องรอคนอนุมัติบ้าง
      และคำถามที่ค้างอยู่ตลอดว่าอัตราจ่ายที่เห็นเป็นตัวเดียวกับที่ค่ายเกมตั้งไว้จริงหรือเปล่า เราจึงตั้งใจทำเว็บที่ชื่อบอกสิ่งที่ทำ คือ<strong>จ่ายชัวร์แบบไม่ต้องเดา</strong> ต่อ API แท้ยิงตรงจากคลังเกมหลัก
      แล้ววางระบบการเงินให้จบในไม่กี่วินาที หน้านี้เขียนไว้ให้อ่านก่อนตัดสินใจว่าเราเป็นใคร วางระบบไว้อย่างไร และยึดอะไรเป็นมาตรฐานตอนจ่ายเงินคืนสมาชิก
    </p>
  </ContentBox>

  <ContentBox title="เว็บตรง API แท้ ไม่ผ่านเอเย่นต์ ค่า RTP ตรงตามสเปกโรงงาน" as="h2">
    <p class="text-left text-base leading-relaxed">
      เรื่องที่สายปั่นเจอบ่อยที่สุดเวลาเล่นผ่านคนกลางคือไม่มีทางรู้เลยว่าเกมที่เปิดอยู่ถูกปรับค่าอะไรมาก่อนถึงมือหรือไม่ ปัญหาชุดนี้มาจากโครงสร้าง ไม่ได้มาจากดวง
      เพราะเมื่อมีเอเย่นต์ยืนคั่นระหว่างผู้เล่นกับคลังเกม ก็มีชั้นที่แก้ค่าได้เพิ่มขึ้นมาโดยปริยาย JAICHUA จึงเลือกเป็น<strong>เว็บตรงที่เชื่อม API แท้ยิงตรงจากคลังเกมหลักตั้งแต่วันแรก</strong> ค่า RTP
      ที่คุณเล่นจึงเป็นค่าที่ค่ายผู้พัฒนาตั้งมาตามสเปกโรงงาน ไม่ได้ถูกใครหมุนลงระหว่างทาง ชนะเท่าไหร่ถอนได้เท่านั้น ไม่มีหมกเม็ดและไม่มีการล็อกยูส ฝั่งระบบหลังบ้านเราวางไว้ให้เสถียรระดับสูงสุด ประมวลผลแม่นยำ
      ไม่มีเกมค้างกลางฟีเจอร์หรือหลุดสลีปกลางรอบ และคำนวณยอดชนะเข้าเครดิตให้แบบเรียลไทม์ สิ่งที่เราถือว่าเป็นหน้าที่ของเราคือทำให้ตัวเลขที่คุณเห็นบนหน้าเกม เป็นตัวเลขเดียวกับที่คุณถอนออกไปได้จริง
    </p>
  </ContentBox>

  <ContentBox title="ค่ายเกมชั้นนำครบทั้ง PG Soft, Pragmatic Play และ Joker Gaming" as="h2">
    <p class="text-left text-base leading-relaxed">
      ล็อบบี้ของเราคัดมาให้สลับอารมณ์การเล่นได้จบในที่เดียว ขนทัพค่ายเกมชั้นนำระดับโลกมาไว้ครบครันทั้ง <strong>PG Soft, Pragmatic Play และ Joker Gaming</strong> ครอบคลุมทั้งสล็อตวิดีโอ 3D ภาพสวย สล็อตตัวคูณสะสมโหด
      และสล็อตสายซื้อฟีเจอร์ฟรีสปิน ทุกค่ายอยู่บนกระเป๋าเดียว สลับเกมข้ามค่ายได้ทันทีโดยไม่ต้องโยกเงินและไม่ต้องสลับแอปให้เสียจังหวะ เราไม่ปล่อยให้ล็อบบี้ซ้ำซาก จึงอัปเดตรายชื่อเกมใหม่เข้าคลังต่อเนื่องทันทีที่
      ค่ายผู้พัฒนาปล่อยตัวเกมออกมา คัดเฉพาะตัวเด็ดแตกง่ายมาเติม ให้สมาชิกได้ลองฟีเจอร์สดใหม่และอ่านจังหวะโบนัสก่อนใคร ในแง่ลูกเล่น แต่ละเกมอัดระบบแจกโบนัสไว้แน่นทั้ง <strong>
        ตัวคูณ Multiplier สัญลักษณ์ Expanding Wild และคอมโบแตกต่อเนื่อง Cascading
      </strong> ทำให้การกดหมุนแต่ละรอบมีอะไรให้ลุ้นมากกว่าแค่หน้าสปินเดิม
    </p>
  </ContentBox>

  <ContentBox title="ฝากถอนออโต้ 3 วินาที รองรับ TrueMoney Wallet และ Cash Back ทุกวัน" as="h2">
    <p class="text-left text-base leading-relaxed">
      งานการเงินเป็นงานที่เราตัดสินใจยกให้ระบบทำแทนคนทั้งหมด เพราะช่วงรอแอดมินอนุมัติคือจุดที่จังหวะการเล่นขาดบ่อยที่สุด JAICHUA วาง<strong>ระบบฝากถอนออโต้ไฮสปีดผ่าน Gateway ตรง</strong> ไว้แทน รองรับทั้งบัญชีธนาคารและ
      TrueMoney Wallet ทำรายการเสร็จภายใน 3 วินาที ยอดเงินอัปเดตเข้าเกมทันที ถอนแล้วเงินเข้าบัญชีเลย ไม่ต้องส่งสลิปและไม่ต้องรอใครกดอนุมัติ ฝั่งสิทธิประโยชน์เราแจกแบบตรงไปตรงมา คัดโปรที่มีของจริงมาให้ <strong>
        กดรับเองผ่านหน้าแดชบอร์ด
      </strong> ทั้งโบนัสต้อนรับสมาชิกใหม่ โปรเติมเงินฝากแรกของวัน และสิทธิ์คืนยอดเสีย Cash Back ทุกวัน เงื่อนไขเขียนไว้ให้อ่านจบก่อนกดและไม่ติดเทิร์นโอเวอร์มหาโหด ส่วนเรื่องที่ระบบตอบแทนไม่ได้ เรามีทีมงานสแตนด์บายดูแลตลอด
      24 ชั่วโมง สุดท้ายสิ่งที่ยังเป็นของผู้เล่นล้วน ๆ และเราอยากให้ถือติดตัวไว้คือ ผลของแต่ละรอบเป็นอิสระจากกันเสมอ การตั้งงบให้พอดีกับทุนของวันนั้นและหยุดเมื่อถึงขีดที่ตั้งไว้ ยังเป็นเรื่องสำคัญที่สุดไม่ว่าเว็บที่เล่นอยู่จะดีแค่ไหน
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
