---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 154.
const pageDescription =
  "เกี่ยวกับ TANGTEM168 เว็บตรงสล็อตชื่อดัง คอนเซปต์ตังเต็มระบบ รวมเกมเด็ดจากค่ายดังไว้หน้าเดียว ระบบการเงินแบ่งขั้นตอนชัด ปลอดภัย 100% ตรวจสอบย้อนหลังได้เอง";

const pageTitle = "เกี่ยวกับ TANGTEM168 เว็บตรงสล็อตชื่อดัง ตังเต็มระบบ เกมเด็ดให้เลือกครบ";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="text-left text-base leading-relaxed">
        TANGTEM168 คือเว็บตรงสล็อตชื่อดังที่ถูกพูดถึงกันปากต่อปากในตอนนี้ วางตัวเองเป็นศูนย์รวมความบันเทิงยุคใหม่ที่จัดเต็มทั้งความหลากหลายของเกมสล็อตและระบบการทำงานที่ทันสมัย
        ทุกส่วนของเว็บถูกออกแบบมาเพื่อตอบโจทย์สายปั่นที่ต้องการความชัวร์ ความสนุก และความคุ้มค่าแบบจัดเต็ม เล่นง่าย ไม่ยุ่งยาก เปิดเข้ามาแล้วเริ่มได้เลยโดยไม่ต้องศึกษาอะไรยาว
        หน้านี้รวมไว้ว่าที่นี่ยืนอยู่บนอะไรบ้าง ตั้งแต่คอนเซปต์ตังเต็มระบบ การคัดเกมเข้าล็อบบี้ สิทธิพิเศษที่แจกให้สมาชิก ไปจนถึงระบบการเงินและมาตรฐานความปลอดภัยที่อยู่เบื้องหลังทั้งหมด
      </p>
    </div>
  </ContentBox>

  <ContentBox title="คอนเซปต์ตังเต็มระบบของ TANGTEM168 ที่สัมผัสได้ตั้งแต่ครั้งแรกที่ใช้งาน" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        สมกับเป็นเว็บตรงชื่อดัง เพราะ TANGTEM168 มาพร้อมคอนเซปต์ตังเต็มระบบที่ผู้เล่นทุกคนสัมผัสได้จริงตั้งแต่ครั้งแรกที่ใช้งาน ตัวระบบได้รับการพัฒนาให้มีความเสถียรสูง
        อัตราการแตกของแจ็คพอตเป็นไปอย่างตรงไปตรงมา ไม่มีการปรับลดเปอร์เซ็นต์การชนะ ทุกสปินจึงเต็มไปด้วยความหวังและโอกาสรับเงินรางวัลใหญ่เท่ากันทุกคน
        ความตรงไปตรงมาและแจกจริงแบบไม่มีออมมือนี้เองคือเหตุผลที่ชื่อของเว็บถูกบอกต่ออย่างรวดเร็ว และเป็นมาตรฐานที่เราตั้งใจรักษาไว้ในทุกเกมและทุกรอบการเล่น
      </p>
    </div>
  </ContentBox>

  <ContentBox title="คัดเกมเด็ดจากค่ายดังระดับโลกมาไว้หน้าเดียว ไม่ต้องไล่หาทีละเว็บ" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        ที่นี่รวบรวมเกมสล็อตตัวเด็ด ตัวฮิต และเกมแตกง่ายจากค่ายดังระดับโลกมาไว้ในหน้าเดียว ไม่ว่าจะเป็นเกมแนวสตรีทสุดมันส์ แนวแฟนตาซีอลังการ หรือแนวคลาสสิกที่เล่นง่าย
        ทุกเกมผ่านการคัดสรรมาแล้วว่าทำเงินได้จริงและงานภาพสวยสมจริง ผู้เล่นจึงไม่ต้องเสียเวลาโยกเงินหรือสลับเว็บไปมาให้ยุ่งยากอีกต่อไป
        อยากเปลี่ยนฟีล เปลี่ยนบรรยากาศเมื่อไหร่ก็แค่คลิกเลือกเกมใหม่ในล็อบบี้ได้ทันทีด้วยยูสเซอร์เดิม และยังมีเกมใหม่จากค่ายดังทยอยเข้ามาให้ลองอยู่เสมอ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="สิทธิพิเศษและกิจกรรมที่คอยเติมทุนให้สมาชิกอย่างสม่ำเสมอ" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        ความคุ้มค่าคืออีกจุดเด่นที่ทำให้ TANGTEM168 ครองใจนักเล่นได้อยู่หมัด ที่นี่มีกิจกรรมและสิทธิพิเศษมากมายคอยเติมทุนให้สมาชิกอย่างสม่ำเสมอ
        ทั้งโปรโมชันต้อนรับ โบนัสประจำวัน และเครดิตคืนยอดเสีย ทุกสิทธิประโยชน์ถูกออกแบบมาเพื่อเพิ่มรอบการปั่นและยืดระยะเวลาความสนุกให้ยาวขึ้น
        เป้าหมายคือให้มีโอกาสทำกำไรเพิ่มขึ้นโดยไม่ต้องแบกรับความเสี่ยงสูงจนเกินไป โดยแต่ละรายการมีเงื่อนไขการทำยอดและรอบการรับสิทธิ์ของตัวเอง อ่านรายละเอียดได้จากหน้าโปรโมชั่นก่อนกดรับ
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ระบบการเงินแบ่งทุกขั้นตอนชัด และความปลอดภัย 100% ในทุกการใช้งาน" as="h2">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed">
        ระบบการทำรายการของ TANGTEM168 ถูกจัดสรรมาอย่างมีระเบียบและเป็นระบบ ทุกขั้นตอนถูกแบ่งออกอย่างชัดเจน ไม่ว่าจะเป็นการฝาก การถอน หรือการเช็กประวัติย้อนหลัง
        ผู้เล่นจัดการทุกอย่างได้ด้วยตัวเองผ่านหน้าเว็บอย่างรวดเร็ว ไร้ขั้นตอนซับซ้อน ทำรายการจบได้ภายในเวลาไม่นาน ให้ความคล่องตัวสูงสุดในทุกการใช้งาน
        และถ้าติดขัดตรงไหน ยังมีทีมงานคอยดูแลและให้คำแนะนำอยู่ตลอดเวลา
      </p>

      <p class="text-left text-base leading-relaxed">
        เรื่องความปลอดภัยคือหัวใจหลักที่เราให้ความสำคัญสูงสุด เว็บไซต์ใช้เทคโนโลยีการเข้ารหัสขั้นสูงเพื่อปกป้องข้อมูลส่วนตัวของสมาชิกทุกคนไม่ให้รั่วไหลไปสู่ภายนอก
        รวมถึงระบบการเงินที่เชื่อมต่อตรงกับสถาบันการเงินชั้นนำเพื่อป้องกันความเสี่ยงทุกรูปแบบ ทั้งหมดนี้คือสิ่งที่ทำให้ TANGTEM168 สอบผ่านในทุกมิติ
        ทั้งการรวบรวมเกมเด็ดจากค่ายดัง ความเสถียรของระบบหลังบ้านที่ไร้รอยต่อ และระบบการเงินที่รวดเร็วปลอดภัย สมกับชื่อตังเต็มระบบอย่างแท้จริง
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
