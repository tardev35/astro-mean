---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// 9KPLUS: ticker หมุนมาเป็น Announcement3 ส่วนกล่องหน้าย่อยยังเป็น ContentBox
// (การ์ดถาวรของหน้าย่อย) เรียก <Announcement /> เปล่า ๆ เพราะ default message ของ
// variant นี้ถูกตั้งให้ตรงกับที่หน้าแรกส่งเข้าไปแล้ว
//
// ห้ามใส่คลาสสีลงในย่อหน้าข้างในการ์ด — ContentBox ตั้งสีเนื้อความให้แล้ว การเขียน
// สีทับตรงนี้คือการฝัง hex ของแบรนด์รอบนี้ไว้ในไฟล์ที่รีแบรนด์รอบหน้าไม่ได้เปิด
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 152, and is one
// sentence about what the page is for rather than a table of contents.
const pageDescription = "หน้าแนะนำตัวของ 9KPLUS สล็อตพลัสความมันส์ เว็บตรง API แท้ ยิงตรงจากเซิร์ฟนอก ว่าเราเป็นใคร เปิดเกมจากค่ายไหน ดูแลค่า RTP และวางระบบฝากถอนออโต้ไว้อย่างไร";

const pageTitle = "เกี่ยวกับเรา 9KPLUS | สล็อตพลัสความมันส์ เว็บตรง API แท้ ออโต้ 3 วินาที";

// หัวข้อระดับ h1 ของหน้า แยกจากค่า title เพราะ title มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา 9KPLUS";

// docx รอบนี้ไม่มีส่วน SUB-PAGES จึงไม่มีบอดี้สำเร็จรูปให้หน้านี้ — หัวข้อและย่อหน้า
// ด้านล่างเขียนขึ้นใหม่จากข้อเท็จจริงของแบรนด์ในบรีฟรอบนี้ (สล็อตเว็บตรง API แท้
// ยิงตรงจากเซิร์ฟนอก ปรับระบบตรงสเปกโรงงาน · ค่า RTP ยุติธรรม ไม่ล็อกยูส ไม่ปรับ
// เปอร์เซ็นต์ชนะ · ดีไซน์หน้าเว็บและคลังเกมให้เข้าถึงง่าย รองรับทั้งสายงบน้อย
// สายเบทใหญ่ และสายตามล่าแจ็คพอต · ค่าย PG Soft, Pragmatic Play, Joker Gaming
// บนกระเป๋าเดียว · อัปเดตคลังเกมใหม่ต่อเนื่อง · ฟีเจอร์ Multipliers / Expanding
// Wild / Cascading / Bonus Buy · โบนัสต้อนรับ / ฝากแรกของวัน / Cash Back ทุกวัน
// ไม่ติดเทิร์นโอเวอร์มหาโหด · ออโต้ไฮสปีดผ่าน Gateway ตรง เสร็จใน 3 วินาที
// ไม่ต้องแนบสลิป ไม่ต้องรอแอดมินอนุมัติ ถอนได้เต็มทุกบาท)
// — ไม่ลอกย่อหน้าในบรีฟมาทั้งดุ้น เพราะย่อหน้าชุดนั้นใช้เต็ม ๆ อยู่บนหน้าแรกแล้ว
// หน้านี้จึงเขียนคนละสำนวนในมุม "เราเป็นใคร" จากข้อเท็จจริงชุดเดียวกัน โครงเป็น
// h1×1 + h2×3 ไม่มี h3 และห้ามเติมข้อเท็จจริงที่บรีฟไม่ได้ให้ เช่น เลขใบอนุญาต
// จำนวนสมาชิก รางวัล ทุนสำรอง ชื่อค่ายเกมนอกสามค่ายข้างบน หรือฝั่งหวย/คาสิโนสด/
// กีฬา — บรีฟรอบนี้เป็นเว็บสล็อตล้วน
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="text-left text-base leading-relaxed">
      9KPLUS ตั้งต้นจากโจทย์ข้อเดียวว่าเว็บสล็อตที่เล่นสนุกจริงต้องไม่ทำให้คนเล่นสะดุดตั้งแต่ยังไม่ได้กดหมุน เราจึง<strong>
        ดีไซน์หน้าเว็บและคลังเกมให้เข้าถึงง่าย
      </strong>
      ขนเกมสล็อตหลากหลายรูปแบบมาจัดวางไว้อย่างลงตัว กดเข้าเกมที่อยากเล่นได้ตั้งแต่เปิดหน้าแรกโดยไม่ต้องไถหาทีละหน้า จากนั้นวางโครงสร้างเบื้องหลังให้ตรงไปตรงมาที่สุด ทั้งการต่อ API แท้ที่ยิงตรงจากเซิร์ฟนอก
      ปรับระบบมาแบบตรงสเปกโรงงาน และระบบการเงินที่จบงานภายในไม่กี่วินาที สายปั่นงบน้อยเน้นปั้นทุน สายลุยเบทใหญ่ หรือสายตามล่าแจ็คพอต จึงเจอจังหวะที่ใช่ของตัวเองได้บนล็อบบี้เดียวกัน
      หน้านี้เขียนไว้ให้อ่านก่อนตัดสินใจว่าเราเป็นใคร เปิดเกมจากค่ายไหน ยึดอะไรเป็นมาตรฐานของค่า RTP และจ่ายเงินคืนสมาชิกด้วยระบบแบบไหน
    </p>
  </ContentBox>

  <ContentBox title="เว็บตรง API แท้ ยิงตรงจากเซิร์ฟนอก ค่า RTP ยุติธรรม ไม่ล็อกยูส ไม่ปรับเปอร์เซ็นต์ชนะ" as="h2">
    <p class="text-left text-base leading-relaxed">
      คำถามที่สายปั่นถามกันบ่อยที่สุดคืออัตราจ่ายที่เห็นอยู่บนหน้าเกมเป็นตัวเดียวกับที่ค่ายผู้พัฒนาตั้งไว้จริงหรือเปล่า คำตอบของคำถามนี้ไม่ได้อยู่ที่ดวง แต่อยู่ที่โครงสร้างของเว็บที่คุณเล่นอยู่ 9KPLUS จึงเลือกเป็น<strong>
        เว็บตรงที่เชื่อม API แท้ ยิงตรงจากเซิร์ฟนอกตั้งแต่วันแรก
      </strong>
      ปรับระบบมาแบบตรงสเปกโรงงาน ทุกการสปินจึงลื่นไหลและเดินอยู่บน<strong>ค่า RTP ยุติธรรม ไม่ล็อกยูส ไม่ปรับเปอร์เซ็นต์ชนะ</strong> เราจัดจังหวะการจ่ายเงินไว้แบบแฟร์ ๆ
      ให้ลุ้นโบนัสแตกได้ตั้งแต่วินาทีแรกที่เริ่มสปิน และบวกเท่าไหร่ก็ถอนได้เต็มทุกบาท สิ่งที่เราถือว่าเป็นหน้าที่ของเราคือทำให้ตัวเลขที่คุณเห็นบนหน้าเกมเป็นตัวเลขเดียวกับที่คุณถอนออกไปได้จริง
      โดยไม่ต้องเชื่อคำโฆษณาของใครเลยแม้แต่ของเราเอง
    </p>
  </ContentBox>

  <ContentBox title="ตัวเด็ดพร้อมชนจาก PG Soft, Pragmatic Play และ Joker Gaming บนกระเป๋าเดียว" as="h2">
    <p class="text-left text-base leading-relaxed">
      คลังเกมของเราเริ่มจากที่มาของตัวเกมเป็นอันดับแรก เพราะเรา<strong>รวมค่ายใหญ่ระดับโลกไว้ครบทั้ง PG Soft, Pragmatic Play และ Joker Gaming</strong>
      แล้วคัดเกมตัวเด็ดกระแสแรงมาให้เลือกเล่นแบบไม่ขาดสาย อยากเปลี่ยนอารมณ์จากสล็อตแนวเทพเจ้าไปลองแนวสายกินหรือแนวแอ็กชัน ก็สลับได้ทันทีผ่าน<strong>ระบบกระเป๋าเดียว</strong>
      ไม่ต้องเสียเวลาโยกเงินข้ามค่ายให้สะดุดจังหวะ ถัดจากที่มาคือความสดของล็อบบี้ เราอัปเดตคลังเกมใหม่เข้ามาเติมระบบอย่างต่อเนื่องทันทีที่ค่ายผู้พัฒนาปล่อยตัวเกมออกมา สมาชิกจึงได้ลองฟีเจอร์ใหม่ก่อนใคร
      ได้เช็กจังหวะแจกโบนัสก่อนใคร และปั่นได้ยาว ๆ โดยไม่ต้องวนอยู่กับล็อบบี้เดิม ส่วนลูกเล่นที่ทำให้แต่ละเกมมีจังหวะเซอร์ไพรส์ก็มาครบ ทั้ง<strong>
        ระบบสุ่มแจกตัวคูณทวีคูณ Multipliers สัญลักษณ์ Expanding Wild ยืดเต็มรีล คอมโบแตกต่อเนื่องแบบ Cascading และโหมด Bonus Buy
      </strong> ที่กดซื้อฟรีสปินเข้าไปลุ้นรอบแจ็คพอตใหญ่ได้ทันที เปลี่ยนสปินธรรมดาให้เป็นจังหวะแตกหนักได้ทุกหมุน
    </p>
  </ContentBox>

  <ContentBox title="โปรใหม่ไฟแรงกับระบบลั่นพร้อมออโต้ ทำรายการเสร็จใน 3 วินาที" as="h2">
    <p class="text-left text-base leading-relaxed">
      งานการเงินเป็นงานที่เราตัดสินใจยกให้ระบบทำแทนคนทั้งหมด เพราะช่วงรออนุมัติคือจุดที่จังหวะการเล่นขาดบ่อยที่สุด 9KPLUS จึงรันทุกธุรกรรมด้วย<strong>ระบบออโต้ไฮสปีดผ่าน Gateway ตรง</strong>
      ตัดขั้นตอนยุ่งยากออกทั้งหมด ไม่ต้องแนบสลิป ไม่ต้องคอยแอดมินอนุมัติ ทำรายการฝากถอนเสร็จภายใน 3 วินาที ยอดเงินอัปเดตเข้าคลังเกมและเด้งกลับเข้าบัญชีธนาคารฉับไว จะฝากตอนดึกหรือถอนช่วงเช้าตรู่ก็ไปต่อได้คล่องแบบไม่เสียฟีล
      ฝั่งสิทธิประโยชน์เราปล่อยโปรใหม่ไฟแรงออกมาให้ตามเก็บต่อเนื่อง ทั้ง<strong>โบนัสต้อนรับสมาชิกใหม่ โปรเติมเงินฝากแรกของวัน และสิทธิ์คืนยอดเสีย Cash Back ทุกวัน</strong>
      กดรับเองได้เลยผ่านหน้าเว็บ เงื่อนไขเขียนไว้ชัดเจนให้อ่านจบก่อนกด ถอนกำไรได้จริงและไม่ติดเทิร์นโอเวอร์มหาโหด ช่วยเพิ่มทุนสปินให้ทำเงินได้เพลินขึ้น สุดท้ายสิ่งที่ยังเป็นของผู้เล่นล้วน ๆ
      และเราอยากให้ถือติดตัวไว้คือ ผลของแต่ละรอบเป็นอิสระจากกันเสมอ การตั้งงบให้พอดีกับทุนของวันนั้นและหยุดเมื่อถึงขีดที่ตั้งไว้ ยังเป็นเรื่องสำคัญที่สุดไม่ว่าเว็บที่เล่นอยู่จะดีแค่ไหน
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
