---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 158.
const pageDescription =
  "เกี่ยวกับ MACAUBET เว็บสล็อตฟอร์มใหญ่ที่ยกบรรยากาศคาสิโนมาเก๊ามาไว้หน้าสปิน ระบบตรงออโต้ฝากถอนไวใน 3 วินาที รวมเกมดังครบทุกค่าย มีโต๊ะสดถ่ายทอด HD เมนูใช้ง่าย";

const pageTitle = "เกี่ยวกับ MACAUBET สล็อตฟอร์มใหญ่ ฟีลคาสิโนมาเก๊า ระบบตรงโอนไว";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// เขียวนีออนไล่ไปหาเขียวเข้ม — ชุดเดียวกับที่ ContentBox ใช้กับหัวข้อของตัวเอง
const headingClass = "mt-8 mb-6 bg-gradient-to-r from-[#dcffc0] via-[#8ef04a] to-[#59cb13] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed">
        MACAUBET เริ่มต้นจากความตั้งใจง่าย ๆ ว่าคนที่อยากสัมผัสความหรูหราตระการตาแบบคาสิโนระดับโลกไม่ควรต้องเสียเวลาเดินทางไปถึงมาเก๊าก่อนถึงจะได้ลุ้น
        เราจึงเลือกยกบรรยากาศทั้งงานภาพ แสง สี เสียง และจังหวะการออกรางวัลมาไว้บนหน้าจอเดียว แล้ววางระบบเบื้องหลังให้ทำงานตรงโดยไม่ผ่านคนกลาง
        ความบันเทิงระดับพรีเมียมถูกอัดแน่นมาพร้อมกับความเร็วของการโอนที่ไว้ใจได้ เพื่อให้ทุกวินาทีที่กดสปินเป็นเวลาของการลุ้นโบนัส ไม่ใช่เวลาของการรอให้เว็บทำงานเสร็จ
        ใครที่มองหาเว็บปั่นสล็อตที่ได้ทั้งอารมณ์และได้ทั้งความชัวร์ นี่คือจุดหมายที่เราตั้งใจทำขึ้นมาให้
      </p>

      <h2 class={headingClass}>ยกบรรยากาศคาสิโนมาเก๊ามาไว้หน้าสปิน ให้ทุกเกมมีฟีลมากกว่าเว็บทั่วไป</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        ความยิ่งใหญ่ของ MACAUBET สัมผัสได้ตั้งแต่คลิกแรกที่เข้าใช้งาน เพราะเราออกแบบหน้าเกมและบรรยากาศโดยรอบให้หรูหราและสมจริงเหมือนกำลังนั่งกดสปินอยู่ในคาสิโนชื่อดังกลางมาเก๊า
        ไม่ว่าจะเป็นงานภาพที่คมชัด แสงไฟที่วิ่งรับกับวงล้อ เสียงเอฟเฟกต์ที่ขึ้นตรงจังหวะ หรือช่วงเวลาที่รางวัลกำลังจะออก ทุกส่วนถูกยกระดับให้มีฟีลลิ่งเหนือกว่าเว็บทั่วไป
        ผลลัพธ์คือการปั่นที่เพลินและตื่นเต้นตั้งแต่รอบแรกจนถึงรอบท้าย ทุกการหมุนกลายเป็นเรื่องน่าลุ้นตลอดเวลา ไม่ใช่แค่การกดปุ่มซ้ำไปมาให้ครบยอด
      </p>

      <h2 class={headingClass}>ล็อบบี้รวมเกมดังครบทุกค่าย พร้อมโต๊ะสดถ่ายทอด HD ในยูสเซอร์เดียว</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        เปิดเข้ามาในล็อบบี้ของ MACAUBET จะพบอาณาจักรเกมสล็อตที่รวบรวมตัวฮิตจากค่ายดังไว้เยอะที่สุด ทั้งเกมในกระแส เกมแตกหนัก และเกมคลาสสิกที่ผู้เล่นชื่นชอบกันมานาน
        เราคัดสรรเฉพาะตัวเกมคุณภาพสูงที่มีอัตราการจ่ายสมน้ำสมเนื้อมาให้เลือกเล่นแบบจุใจ อยากเปลี่ยนสไตล์การเล่นตอนไหนก็เลือกได้ทันที ไม่มีคำว่าจำเจหรือขาดช่วง
        และไม่ได้มีแค่วงล้อ เพราะฝั่งคาสิโนโต๊ะสดของเราถ่ายทอดสดแบบเรียลไทม์คมชัดระดับ HD จากดีลเลอร์มืออาชีพตลอด 24 ชั่วโมง
        อยากสลับอารมณ์จากการกดสปินไปลุ้นไพ่หรือเปิดโต๊ะเดิมพันอื่นก็ทำได้ทันทีโดยไม่ต้องเปลี่ยนยูสเซอร์ ความสนุกจึงต่อเนื่องอยู่ในเว็บเดียว
      </p>

      <h2 class={headingClass}>ระบบตรงออโต้ฝากถอนไวใน 3 วินาที กับเมนูที่ตัดขั้นตอนซับซ้อนออก</h2>

      <p class="text-left text-base leading-relaxed">
        เรื่องความเร็วคือไฮไลต์ที่เราภูมิใจที่สุด ระบบตรงออโต้ระดับไฮสปีดของ MACAUBET ทำรายการฝากถอนจบภายใน 3 วินาที ต่อให้เป็นช่วงที่ผู้เล่นแน่นแค่ไหน
        เงินก็เข้าบัญชีตรงเป๊ะโดยไม่ต้องส่งสลิปและไม่ต้องรอแอดมินอนุมัติ เมนูทั้งหมดถูกจัดวางอย่างเป็นระเบียบ ตัดขั้นตอนที่ไม่จำเป็นออก
        ทั้งมือใหม่และผู้เล่นระดับเก๋าจึงค้นหาเกมโปรด เลือกค่ายที่ต้องการ หรือเข้าถึงโหมดบริการต่าง ๆ ได้ตรงจุดตั้งแต่ครั้งแรกที่ใช้งาน
        สรุปรวมแล้วสิ่งที่เราตั้งใจทำคือความบันเทิงระดับพรีเมียม ระบบการเงินที่มั่นคงปลอดภัย และตัวเลือกเกมที่ครอบคลุมทุกความต้องการมาไว้ในที่เดียว ปักหลักเล่นที่นี่แล้วจบครบในเว็บเดียว
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
