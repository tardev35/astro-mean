---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxNeumorphism.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 157.
const pageDescription = "เกี่ยวกับเรา AURORA688 เว็บสล็อตฟีลดีที่รวมเกมฮิตติดแสงกว่า 1,000+ เกม พร้อมระบบออโต้ฝากถอนไว โปรโมชั่นมีให้ตามหลายจังหวะ และทีมงานดูแลผู้เล่นตลอด 24 ชั่วโมง";

const pageTitle = "เกี่ยวกับเรา AURORA688 | เว็บสล็อตฟีลดี เกมฮิตติดแสงครบ";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา AURORA688 เว็บสล็อตฟีลดีที่รวมเกมฮิตติดแสงไว้ครบในที่เดียว";

// หัวข้อของหน้านี้เขียนขึ้นใหม่ในมุม "เกี่ยวกับเรา" ไม่ได้ยกย่อหน้าจาก docx
// มาซ้ำกับหน้าแรก ข้อเท็จจริงทุกข้อยังมาจากบรีฟชุดเดียวกัน
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div>
      <p class="text-left text-base leading-relaxed">
        AURORA688 เริ่มต้นจากโจทย์สั้น ๆ ว่าการกดหมุนแต่ละครั้งควรให้ความรู้สึกที่ดีกลับไป ไม่ใช่แค่หน้าจอที่หมุนเสร็จแล้วจบ คำว่าเว็บสล็อตฟีลดีที่เราใช้เรียกตัวเองจึงไม่ใช่คำโฆษณา
        แต่เป็นเกณฑ์ที่ใช้ตัดสินใจจริงตั้งแต่คัดเกมเข้าคลัง จัดวางล็อบบี้ ไปจนถึงออกแบบขั้นตอนฝากถอน หน้านี้เขียนไว้บอกว่าเรายืนอยู่บนอะไรบ้าง ตั้งแต่วิธีเลือกเกมกว่า 1,000+ ตัวเลือกที่อยู่ในคลัง
        มุมมองที่เรามีต่อแจ็คพอตและรอบโบนัส เหตุผลที่เราเลือกกระจายโปรออกเป็นหลายจังหวะแทนก้อนใหญ่ก้อนเดียว ไปจนถึงขั้นตอนที่เราตั้งใจตัดออกด้วยระบบออโต้
        คนที่กำลังชั่งใจอยู่ควรอ่านจบแล้วรู้ว่ากำลังคุยอยู่กับเว็บแบบไหน และตัดสินใจได้ด้วยข้อมูล ไม่ใช่ด้วยคำที่ฟังดูดีแต่ไม่มีอะไรรองรับอยู่ข้างหลัง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="คลังเกมกว่า 1,000+ จากค่ายยักษ์ใหญ่ทั่วโลก เราคัดเข้ามาด้วยอะไร" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        ตัวเลขหลักพันฟังดูใหญ่ แต่คลังที่ใหญ่โดยไม่ได้คัดคือคลังที่หาเกมที่ใช่ไม่เจอ เราจึงถือว่าการเพิ่มเกมเป็นงานที่ต้องอธิบายได้ทุกตัว ไม่ใช่การกวาดของทุกค่ายเข้ามากองรวมกันให้ตัวเลขสวย
        เกมที่เข้ามาอยู่ในคลังผ่านการดูสามเรื่องคู่กันเสมอ คือกราฟิกที่ทำมาถึงระดับจนภาพยังน่ามองเมื่อปั่นยาว อัตราการจ่ายรางวัลที่คุ้มค่าพอจะยังน่าลุ้นหลังผ่านไปหลายสิบรอบ
        และแนวเกมที่คลังยังขาดอยู่ ณ ตอนนั้น ผลคือแต่ละแนวมีตัวเด่นของตัวเอง ทั้งแฟนตาซีตระการตา แอ็กชันที่จังหวะเร็วเร้าใจ และสตรีทสุดเท่ที่กติกาตรงไปตรงมา
        คนที่เข้ามาจึงสลับฟีลการเล่นได้ทุกวันโดยไม่ต้องย้ายไปหาเว็บอื่น และไม่ต้องเจอคำว่าจำเจตั้งแต่เดือนที่สอง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ล็อบบี้ที่จัดวางเป็นระเบียบ เกมฮิตติดแสงยืนอยู่ข้างเกมใหม่มาแรง" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        เรื่องที่คนพูดถึงน้อยที่สุดแต่เจอทุกครั้งที่เปิดเว็บคือหน้าล็อบบี้ ถ้าจัดไม่ดี คลังใหญ่แค่ไหนก็กลายเป็นกำแพงรูปเกมที่เลื่อนหาอะไรไม่เจอ เราจึงวางล็อบบี้ให้เห็นของสองกลุ่มพร้อมกันตั้งแต่หน้าแรก
        กลุ่มแรกคือเกมฮิตติดแสงระดับตำนานที่ผู้เล่นรู้จักชื่ออยู่แล้วและเปิดหาเจอได้ทันทีโดยไม่ต้องค้น กลุ่มที่สองคือเกมใหม่มาแรงนอกกระแสที่ยังไม่มีใครพูดถึงมากแต่ซ่อนโบนัสเด็ดไว้ไม่น้อย
        การให้ของสองกลุ่มนี้อยู่ในสายตาเดียวกันทำให้คนที่มาเพื่อปั่นเกมตัวตึงได้เริ่มเลย ส่วนคนที่อยากลองของแปลกก็มีทางเลือกวางรออยู่ตรงนั้นโดยไม่ต้องตั้งใจไปหา
        เป้าหมายของหน้านี้มีข้อเดียวคือจากเปิดเว็บถึงกดหมุนควรใช้เวลาน้อยที่สุด เพราะเวลาที่หมดไปกับการหาเกม ไม่ใช่ส่วนที่ใครมาเพื่อจะได้
      </p>
    </div>
  </ContentBox>

  <ContentBox title="แจ็คพอตและรอบโบนัสกระจายอยู่ทุกเกม ไม่ได้ซ่อนไว้แค่ในตัวยอดนิยม" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        ความเข้าใจที่เจอบ่อยคือรางวัลใหญ่มีอยู่แค่ในเกมดัง ๆ ไม่กี่ตัว แล้วเกมที่เหลือมีไว้ให้คลังดูแน่นเฉย ๆ เราตั้งใจไม่ทำแบบนั้น เกมที่รับเข้าคลังต้องมีจังหวะให้ลุ้นเป็นของตัวเอง
        ไม่ว่าจะเป็นรอบโบนัสที่เข้าถึงได้จริงโดยไม่ต้องรอทั้งวัน ระบบรีสปินที่ล็อกสัญลักษณ์ค้างไว้ให้ต่อยอดในรอบถัดไป การสุ่มคูณเงินรางวัลที่พลิกหน้าตาของรอบนั้นทันที หรือแจ็คพอตที่มีโอกาสแตกได้ทุกวัน
        เกมที่ไม่มีอะไรให้ลุ้นเลยนอกจากรอสัญลักษณ์เรียงกันเฉย ๆ จะไม่ผ่านเข้ามาตั้งแต่แรก ผลที่ตั้งใจให้เกิดคือคนที่อยากลองเกมนอกกระแสไม่ต้องรู้สึกว่ากำลังเสียโอกาสเพื่อแลกกับความแปลกใหม่
        เพราะทุกวันควรเป็นวันที่หมุนเกมไหนก็มีเรื่องให้ลุ้น ไม่ใช่แค่ในเกมที่คนอื่นเล่นกันเยอะที่สุด
      </p>
    </div>
  </ContentBox>

  <ContentBox title="โปรมีให้ตามหลายจังหวะ ทำไมเราเลือกกระจายสิทธิ์แทนก้อนใหญ่ก้อนเดียว" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        โบนัสก้อนเดียวที่ตัวเลขใหญ่ที่สุดมักดูดีบนแบนเนอร์ แต่พอเอาเข้าจริงมักเหมาะกับคนกลุ่มเดียวเท่านั้น เราจึงเลือกกระจายสิทธิ์ออกเป็นหลายจังหวะให้หยิบตามสไตล์การเล่นแทน
        คนที่เพิ่งเข้ามาครั้งแรกมีชุดต้อนรับของตัวเอง คนที่เล่นสม่ำเสมอมีโบนัสเติมเงินประจำวันไว้ต่อทุน และมีเครดิตพิเศษกับกิจกรรมตามเทศกาลหมุนเวียนคืนกำไรให้ผู้เล่นเป็นระยะ
        เจตนาของทุกสิทธิ์เหมือนกันหมด คือยืดเวลาที่อยู่ในเกมให้นานขึ้นโดยไม่ต้องเพิ่มทุน เพราะจำนวนรอบที่ได้ปั่นคือสิ่งที่เปิดโอกาสให้เจอฟีเจอร์และแจ็คพอต
        และเพราะแต่ละรายการคิดจากยอดคนละชุดและมีเงื่อนไขของตัวเอง เราจึงเขียนรายละเอียดไว้บนแบนเนอร์ของแต่ละโปรตรง ๆ ให้อ่านจบก่อนกดรับ ไม่ต้องไปตามหาตัวหนังสือเล็ก ๆ ที่ไหน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ระบบออโต้ 24 ชั่วโมง คือส่วนที่เราตัดขั้นตอนออกมากที่สุด ไม่ใช่ส่วนที่ใส่เพิ่มมากที่สุด" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        เวลาพูดถึงระบบออโต้ หลายคนนึกถึงฟังก์ชันที่เพิ่มเข้ามา แต่สำหรับเรามันคือรายการของสิ่งที่ถูกเอาออก ตั้งแต่การส่งสลิปยืนยัน การรอแอดมินกดอนุมัติ ไปจนถึงการทักไปขอรับโปรทีละครั้ง
        ทุกอย่างตั้งแต่สมัครสมาชิก กดรับโปรโมชั่น จนถึงฝากและถอน ถูกย้ายมาให้ผู้เล่นจัดการเองผ่านหน้าเว็บได้ในไม่กี่วินาที ทำได้ตลอด 24 ชั่วโมง และตรวจย้อนได้ด้วยตัวเอง
        เหตุผลที่เราให้ความสำคัญกับเรื่องนี้มากไม่ใช่เรื่องต้นทุนของทีม แต่เพราะจุดที่ต้องรอคนอีกฝั่งกดอนุมัติคือจุดเดียวที่ทำให้ความคล่องตัวทั้งหมดที่สร้างมาหายไปหมด
        เมนูของเราจึงสั้นกว่าที่หลายคนคาดไว้ตอนเปิดเข้ามาครั้งแรก และเราตั้งใจให้มันสั้นแบบนั้น เพราะทุกขั้นตอนที่เพิ่มเข้ามาคือหนึ่งจังหวะที่ผู้เล่นต้องหยุดคิดโดยไม่จำเป็น
        เวลาที่ประหยัดได้จากตรงนี้ควรถูกใช้ไปกับการปั่นสล็อต ไม่ใช่กับการรอ
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
