---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// TITANWIN168: ticker หมุนมาเป็น AnnouncementPremium ส่วนกล่องหน้าย่อยยังเป็น
// ContentBox (การ์ดถาวรของหน้าย่อย) ตามสเปกรอบนี้ เรียก <Announcement /> เปล่า ๆ
// เพราะ default message ของ variant นี้ถูกตั้งเป็นข้อความของแบรนด์นี้แล้ว
// สีเน้นในย่อหน้าใช้ม่วงไททันหลัก #a855f7 คู่ทองมงกุฎ #f2dda3 ของพาเลตต์รอบนี้
// ส่วนสีเนื้อความมาจากการ์ดเอง ไม่ต้องระบุซ้ำ
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 159.
const pageDescription =
  "เกี่ยวกับเรา TITANWIN168 เว็บตรง API แท้ ยิงสัญญาณตรงจากเซิร์ฟเวอร์หลัก ไม่ผ่านเอเย่นต์ คลังเกมคัดเกรด ค่า RTP ตรงสเปกโรงงาน ไร้ล็อกยูส ฝากถอนออโต้ทันใจไว 3 วิ";

const pageTitle = "เกี่ยวกับเรา TITANWIN168 | เว็บตรง API แท้ เกมคัดเกรด ออโต้ไว 3 วิ";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา TITANWIN168";

// docx รอบนี้ไม่มีส่วน SUB-PAGES จึงไม่มีบอดี้สำเร็จรูปให้หน้านี้ — หัวข้อและ
// ย่อหน้าทั้งหกบล็อกด้านล่างเขียนขึ้นใหม่จากข้อเท็จจริงของแบรนด์ในบรีฟรอบนี้
// (เว็บตรง API แท้ ยิงสัญญาณตรงจากเซิร์ฟเวอร์หลัก ไม่ผ่านเอเย่นต์ · เกมคัดเกรด
// ไม่เอาเกมระบบล้าหลังหรืออัตราจ่ายต่ำ · ค่า RTP ยุติธรรมตรงตามสเปกโรงงาน ·
// ไร้ประวัติการล็อกยูส ถอนได้เต็มจำนวน · PG Soft / Pragmatic Play / Joker Gaming ·
// สล็อต 3D และสตรีตสไตล์เน้นคูณหนัก กระเป๋าเดียวไม่ต้องโยกเงิน · Multipliers /
// Cascading / Wild ขยาย / Buy Feature · โบนัสต้อนรับสมาชิกใหม่ โปรฝากแรกของวัน
// Cash Back คืนยอดเสีย ไม่ติดเทิร์นโอเวอร์มหาโหด · ฝากถอนออโต้ทันใจไว 3 วิ ผ่าน
// Gateway ตรง ไม่ต้องส่งสลิป ไม่ต้องรอคิวอนุมัติ)
// — ไม่ลอกย่อหน้าในบรีฟมาทั้งดุ้น เพราะย่อหน้าชุดนั้นใช้เต็ม ๆ อยู่บนหน้าแรกแล้ว
// โครงเป็น h1×1 + h2×6 ไม่มี h3
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="text-left text-base leading-relaxed">
      <strong class="text-[#a855f7]">TITANWIN168</strong> ตั้งต้นจากโจทย์ที่ตรงไปตรงมาว่าเว็บสล็อตที่ดีไม่ควรบังคับให้คนเล่นลุ้นสองชั้น ชั้นแรกคือลุ้นวงล้อ ส่วนชั้นที่สองคือลุ้นว่าระบบหลังบ้านจะซื่อตรงกับที่ประกาศไว้หรือเปล่า
      เราจึงวางเว็บนี้เป็นเว็บตรงที่ยิงสัญญาณจากเซิร์ฟเวอร์หลักด้วย API แท้ ไม่ผ่านเอเย่นต์ ไม่มีตัวกลางมาคั่นระหว่างคำสั่งสปินกับค่ายเกม และค่า RTP ที่เห็นก็เป็นค่าเดียวกับที่โรงงานเกมตั้งไว้ในสเปก
      ที่เหลือคือหน้าที่ของเราล้วน ๆ คัดเกมที่สปินแล้วสนุกจริงเข้าคลัง จัดหน้าล็อบบี้ให้หาเจอไว เติมสิทธิ์ที่กดรับแล้วได้ใช้จริงทุกช่วงเวลา แล้วปล่อยให้ระบบออโต้รับงานฝากถอนไปทำแทนคนทั้งหมด
      เพื่อให้เวลาของสมาชิกหมดไปกับการปั่น ไม่ใช่การรอ
    </p>
  </ContentBox>

  <ContentBox title="เว็บตรง API แท้ ยิงสัญญาณจากเซิร์ฟเวอร์หลัก ไม่ผ่านเอเย่นต์" as="h2">
    <p class="text-left text-base leading-relaxed">
      จุดยืนข้อแรกของเราคือไม่มีอะไรมาคั่นกลางระหว่างปุ่มสปินกับเซิร์ฟเวอร์ของค่ายเกม ทุกเกมในคลังเชื่อมด้วย API แท้ที่ต่อตรงกับเซิร์ฟเวอร์หลัก คำสั่งจึงวิ่งออกไปคำนวณที่ต้นทางแล้วส่งผลกลับมาตามที่ค่ายกำหนดเอง
      โครงสร้างแบบไม่ผ่านเอเย่นต์ทำให้ไม่มีจุดไหนเลยที่ใครจะเข้าไปแตะผลการออกรางวัลได้ระหว่างทาง
      ค่า RTP ของทุกเกมจึงเป็นค่าที่ยุติธรรมและตรงตามสเปกโรงงาน เทียบกับค่ายต้นทางได้ และเราไม่ขยับอัตราจ่ายในช่วงเวลาใดเวลาหนึ่งเพื่อผลลัพธ์ของใครก็ตาม สิ่งที่เปลี่ยนได้คือโปรโมชั่นและบริการ ไม่ใช่กลไกของเกม
      สมาชิกที่เบทหลักบาทกับสมาชิกที่เบทหลักพันจึงเล่นอยู่บนระบบประมวลผลชุดเดียวกัน ไม่มีการล็อกยูส และไม่มีเกมหรือความเร็วระดับไหนถูกกันไว้ให้เฉพาะบางกลุ่ม
    </p>
  </ContentBox>

  <ContentBox title="คลังเกมคัดเกรด ไม่เอาเกมระบบล้าหลังหรืออัตราจ่ายต่ำมาเปิดให้บริการ" as="h2">
    <p class="text-left text-base leading-relaxed">
      คำว่าเกมคัดเกรดของเราเป็นเกณฑ์จริง ไม่ใช่คำโฆษณา ทุกเกมที่จะขึ้นคลังต้องผ่านการคัดกรองจากระบบหลังบ้านก่อนว่าอัลกอริทึมการจ่ายรางวัลเป็นไปตามมาตรฐานสากล กราฟิกคมชัดในระดับที่เล่นยาวได้ และจังหวะสปินสนุกจริงเมื่อลองหมุนดูเอง
      เกมที่ใช้ระบบล้าหลังหรือตั้งอัตราจ่ายไว้ต่ำจนผู้เล่นไม่มีทางลุ้น เราไม่นำมาเปิดให้บริการตั้งแต่ต้น แม้จะเป็นเกมที่มีคนรู้จักชื่อก็ตาม
      เหตุผลง่ายมาก คลังที่ยัดเกมเข้ามาให้ตัวเลขดูเยอะ แต่ครึ่งหนึ่งเป็นเกมที่ไม่มีใครอยากเปิดซ้ำรอบสอง ไม่ได้ช่วยให้ใครทำกำไรได้จริง
      เราจึงเลือกให้คลังเล็กลงหน่อยแต่ทุกตัวที่อยู่ในนั้นเปิดเล่นได้อย่างมั่นใจ และหมุนเกมเข้าออกตามผลจริงที่วัดได้ ไม่ใช่ตามที่ค่ายส่งมาให้เท่านั้น
    </p>
  </ContentBox>

  <ContentBox title="ค่ายชั้นนำที่ยกมาชนกัน ทั้ง PG Soft, Pragmatic Play และ Joker Gaming" as="h2">
    <p class="text-left text-base leading-relaxed">
      คลังของเรารวมตัวเด่นจากค่ายเกมยักษ์ใหญ่ระดับโลกมาประชันกันแบบจัดเต็ม ทั้ง PG Soft, Pragmatic Play, Joker Gaming และค่ายชั้นนำอีกมากมายที่จ่ายรางวัลตามอัลกอริทึมของโรงงานเกมเอง ไม่ใช่ไฟล์ที่หน้าตาเหมือนแต่กลไกข้างในไม่ตรงกับต้นฉบับ
      มีให้เลือกเล่นครบทุกสไตล์ ตั้งแต่สล็อตสายภาพสวยกราฟิก 3D ที่ทำมาให้ดูเพลินตลอดรอบ ไปจนถึงสล็อตสตรีตสไตล์ที่เน้นคูณหนักและจบเกมไว
      จุดที่ทำให้สลับเล่นได้อิสระจริงคือ<strong class="text-[#f2dda3]">กระเป๋าเดียวไม่ต้องโยกเงิน</strong> ย้ายจากค่ายสายภาพสวยไปหาค่ายสายคูณหนักเป็นแค่การเลือกเกม
      ไม่ต้องกดโอนยอดไปมาให้เสียจังหวะ และไม่มีเครดิตตกค้างอยู่ในค่ายที่เพิ่งออกมาให้ต้องตามเก็บทีหลัง
    </p>
  </ContentBox>

  <ContentBox title="ฟีเจอร์ครบมือ ทั้ง Multipliers, Cascading, Wild ขยาย และ Buy Feature" as="h2">
    <p class="text-left text-base leading-relaxed">
      สิ่งที่ทำให้การสปินไม่น่าเบื่อคือกลไกของตัวเกม เราจึงคัดเกมที่มีลูกเล่นทันสมัยเข้ามาไว้ให้ครบชุด ทั้งระบบ Multipliers ที่สะสมตัวคูณแบบทวีคูณไปตามจังหวะของรอบนั้น
      และระบบ Cascading ที่สัญลักษณ์แตกต่อเนื่องเป็นคอมโบยาวได้ในสปินเดียวโดยไม่ต้องหมุนใหม่
      อีกสองกลไกที่สายล่าโบนัสมองหาเป็นพิเศษคือรีลขยายพร้อมสัญลักษณ์ Wild ซ้อนทับ ซึ่งพลิกหน้าตาของรอบทั้งรอบได้ในทีเดียว และโหมด Buy Feature สำหรับสายใจร้อนที่ไม่อยากรอจังหวะฟรีสปินมาเอง
      ซื้อพุ่งตรงเข้าลุ้นโบนัสก้อนใหญ่ได้ทันที
      เกมที่มีทรงโบนัสแตกดีและเข้ารอบฟรีสปินไวถูกจัดไว้ให้หาเจอง่ายเป็นพิเศษ เพราะการรู้จังหวะโบนัสและความถี่ของฟรีสปินล่วงหน้าช่วยให้วางงบต่อรอบได้แม่นกว่าการเดา ส่วนผลของแต่ละสปินยังเป็นการสุ่มตามกลไกของค่ายเสมอ
    </p>
  </ContentBox>

  <ContentBox title="โปรโมชั่นใหม่พร้อมชนทุกเวลา เงื่อนไขโปร่งใส ไม่ติดเทิร์นโอเวอร์มหาโหด" as="h2">
    <p class="text-left text-base leading-relaxed">
      โปรโมชั่นของเราตั้งใจเขียนให้กดรับแล้วได้ใช้จริง ไม่ใช่ตัวเลขไว้โชว์หน้าเว็บ ชุดหลักมีสามรายการที่อัปเดตวนอยู่ตลอดทุกช่วงเวลา ได้แก่ โบนัสต้อนรับสำหรับสมาชิกใหม่ที่เพิ่มทุนให้ตั้งแต่รอบแรก
      โปรฝากแรกของวันที่ออกแบบมาให้สายเล่นต่อเนื่อง และสิทธิ์รับเครดิตคืนยอดเสีย Cash Back ที่ส่งทุนกลับไปให้ปั่นต่อได้ยาวขึ้น
      จุดที่เราถือเป็นเรื่องจริงจังคือเงื่อนไขต้องโปร่งใสและอ่านจบได้ในบรรทัดเดียว กดรับเองได้ทันทีโดยไม่ต้องทักแอดมิน และไม่มีเทิร์นโอเวอร์มหาโหดซ่อนไว้ท้ายรายการให้มาเซอร์ไพรส์ตอนจะถอน
      สิ่งที่ยังต้องดูเองก่อนกดรับคือเพดานและรอบเวลาของแต่ละสิทธิ์ เพราะแต่ละรายการคิดจากยอดคนละชุดและมีจังหวะของตัวเอง เลือกให้ตรงกับสไตล์การเล่นของวันนั้นจะคุ้มกว่าการกดรับทุกอย่างที่เห็น
    </p>
  </ContentBox>

  <ContentBox title="ฝากถอนออโต้ทันใจไว 3 วิ ผ่าน Gateway ตรง และทีมงานที่ยังอยู่ตลอดวัน" as="h2">
    <p class="text-left text-base leading-relaxed">
      ระบบการเงินคือส่วนที่เราเลือกให้เครื่องทำงานแทนคนทั้งหมด ฝากถอนเป็นออโต้เต็มรูปแบบ ประมวลผลผ่าน Gateway ที่ต่อตรงกับธนาคารและวอลเล็ท ทำรายการจบภายใน 3 วินาที
      ฝากเงินปุ๊บยอดเข้าเกมปั๊บ ถอนกำไรก็เด้งเข้าบัญชีทันที ไม่ต้องถ่ายสลิปส่งให้ใครยืนยัน ไม่ต้องต่อคิวรออนุมัติ และถอนออกได้เต็มจำนวนทุกยอดโดยไม่มีเงื่อนไขยุ่งยาก
      สิ่งที่ยังต้องตรวจด้วยตัวเองมีสองอย่าง คือผูกชื่อบัญชีธนาคารให้ตรงกับข้อมูลสมาชิก และเข้าใช้งานผ่านลิงก์ที่ตรวจชื่อเว็บไซต์แล้วเท่านั้น
      ส่วนงานที่เครื่องทำแทนไม่ได้ยังมีทีมงานรับอยู่ตลอดวัน ถามเรื่องระบบ ติดขัดตรงไหน หรืออยากได้คำแนะนำเรื่องการทำรายการก็ทักมาได้ ทั้งนี้สล็อตยังเป็นเกมที่ผลลัพธ์สุ่มทุกรอบ
      การตั้งงบต่อสปินให้พอดีกับทุนของวันนั้นและหยุดเมื่อถึงขีดที่ตั้งไว้ ยังเป็นเรื่องสำคัญที่สุดที่เราอยากให้ถือติดตัวไว้เสมอ
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
