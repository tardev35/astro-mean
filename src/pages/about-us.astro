---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// PAY69: ticker หมุนมาเป็น Announcement5 ส่วนกล่องหน้าย่อยยังเป็น ContentBox
// (การ์ดถาวรของหน้าย่อย) ตามสเปกรอบนี้ เรียก <Announcement /> เปล่า ๆ เพราะ
// default message ของ variant นี้ถูกตั้งเป็นข้อความของแบรนด์นี้แล้ว
// สีเน้นในย่อหน้าใช้ทองแชมเปญ #e8c37a คู่ทองสว่าง #f7dfa5 ของพาเลตต์รอบนี้
// ส่วนสีเนื้อความมาจากการ์ดเอง ไม่ต้องระบุซ้ำ
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 157.
const pageDescription =
  "เกี่ยวกับเรา PAY69 คาสิโนสดเว็บตรง API แท้ สัญญาณ Ultra HD จากฟลอร์จริงต่างประเทศ ไม่ผ่านเอเย่นต์ ไม่ล็อคยูส รวมโต๊ะสดค่ายดัง ฝากถอนออโต้เข้าบัญชีใน 3 วินาที";

const pageTitle = "เกี่ยวกับเรา PAY69 | คาสิโนสดเว็บตรง โต๊ะค่ายดัง ออโต้ใน 3 วินาที";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา PAY69";

// docx รอบนี้ไม่มีส่วน SUB-PAGES จึงไม่มีบอดี้สำเร็จรูปให้หน้านี้ — หัวข้อและ
// ย่อหน้าทั้งหกบล็อกด้านล่างเขียนขึ้นใหม่จากข้อเท็จจริงของแบรนด์ในบรีฟรอบนี้
// (คาสิโนสดเว็บตรง API แท้ · สัญญาณสด Ultra HD จากฟลอร์จริงต่างประเทศ ดีลเลอร์
// แจกไพ่จริงเรียลไทม์ ไม่ตัดต่อ ไม่ใช้คลิปวน · ไม่ผ่านเอเย่นต์ · ไม่ล็อคยูส
// ไม่ปรับอัตราแพ้ชนะ · ค่ายสด Evolution Gaming / SA Gaming / Sexy Baccarat /
// Pragmatic Play Live · บาคาร่าคลาสสิก บาคาร่าสายฟ้า รูเล็ต เสือมังกร ไฮโล
// วงล้อเสี่ยงโชค เกมโชว์สด · ห้องตั้งแต่หลักสิบถึง High Roller · กระเป๋าเงินเดียว
// ยูสเซอร์เดียว · ธนาคารชั้นนำทั่วไทย + TrueMoney Wallet · โบนัสต้อนรับคาสิโนสด
// โปรฝากแรกของวัน Cash Back ทุกวัน คอมมิชชันชวนเพื่อน · ไม่ติดเทิร์นโอเวอร์
// มหาโหด กดรับเองผ่านแดชบอร์ด · ฝากถอนออโต้ผ่าน Gateway ตรง เครดิตเข้าใน
// 3 วินาที ไม่ต้องส่งสลิป ไม่ต้องรอแอดมิน)
// — ไม่ลอกย่อหน้าในบรีฟมาทั้งดุ้น เพราะย่อหน้าชุดนั้นใช้เต็ม ๆ อยู่บนหน้าแรกแล้ว
// หัวข้อจึงตั้งคนละสำนวนกับ h2 ของหน้าแรกด้วย โครงเป็น h1×1 + h2×6 ไม่มี h3
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="text-left text-base leading-relaxed">
      <strong class="text-[#e8c37a]">PAY69</strong> ตั้งต้นจากโจทย์ที่ตรงไปตรงมาว่าคาสิโนออนไลน์ที่ดีไม่ควรบังคับให้คนเล่นลุ้นสองชั้น ชั้นแรกคือลุ้นไพ่ที่ดีลเลอร์กำลังจะเปิด ส่วนชั้นที่สองคือลุ้นว่าระบบหลังบ้านจะซื่อตรงกับที่ประกาศไว้หรือเปล่า
      เราจึงวางเว็บนี้เป็นคาสิโนสดเว็บตรงที่เชื่อมด้วย API แท้กับค่ายเจ้าของโต๊ะโดยตรง ไม่ผ่านเอเย่นต์ และไม่มีตัวกลางมาคั่นระหว่างการวางเดิมพันกับฟลอร์จริง
      สิ่งที่สมาชิกเห็นบนหน้าจอคือสัญญาณสดระดับ Ultra HD ที่ส่งตรงจากฟลอร์คาสิโนจริงในต่างประเทศ ดีลเลอร์แจกไพ่จริงแบบเรียลไทม์ ไม่มีการตัดต่อและไม่ใช้คลิปวน
      ที่เหลือคือหน้าที่ของเราล้วน ๆ คัดโต๊ะที่เล่นแล้วสนุกจริงเข้าล็อบบี้ จัดหน้าให้หาเจอไว เติมสิทธิ์ที่กดรับแล้วได้ใช้จริงทุกวัน แล้วปล่อยให้ระบบออโต้รับงานฝากถอนไปทำแทนคนทั้งหมด
      เพื่อให้เวลาของสมาชิกหมดไปกับการอยู่หน้าโต๊ะ ไม่ใช่การรอ
    </p>
  </ContentBox>

  <ContentBox title="คาสิโนสดเว็บตรง API แท้ ยิงสัญญาณ Ultra HD จากฟลอร์จริง ไม่ผ่านเอเย่นต์" as="h2">
    <p class="text-left text-base leading-relaxed">
      จุดยืนข้อแรกของเราคือไม่มีอะไรมาคั่นกลางระหว่างปุ่มยืนยันเดิมพันกับโต๊ะที่กำลังถ่ายทอดอยู่ ทุกห้องในล็อบบี้เชื่อมด้วย API แท้ที่ต่อตรงกับเซิร์ฟเวอร์ของค่ายเจ้าของโต๊ะ คำสั่งจึงวิ่งออกไปบันทึกที่ต้นทางแล้วส่งผลกลับมาตามที่เกิดขึ้นจริงตรงหน้ากล้อง
      โครงสร้างแบบไม่ผ่านเอเย่นต์ทำให้ไม่มีจุดไหนเลยที่ใครจะเข้าไปแตะผลของแต่ละตาได้ระหว่างทาง
      ภาพที่ส่งมาเป็นสัญญาณสดระดับ Ultra HD จากฟลอร์คาสิโนจริงในต่างประเทศ มีมุมกล้องหลายมุมให้มองเห็นทุกมิติของการแทง ทั้งจังหวะที่ไพ่ถูกเปิด ลูกรูเล็ตหยุด และไฮโลถูกเขย่า สัญญาณเสถียรไม่มีอาการกระตุกกลางตา
      เราไม่ล็อคยูสและไม่ปรับอัตราแพ้ชนะให้ใครในช่วงเวลาใดเวลาหนึ่ง สมาชิกที่แทงหลักสิบกับสมาชิกที่แทงหลักหมื่นจึงอยู่บนระบบชุดเดียวกัน สิ่งที่เปลี่ยนได้คือโปรโมชันและบริการ ไม่ใช่กลไกของเกม
    </p>
  </ContentBox>

  <ContentBox title="โต๊ะสดค่ายดังระดับพรีเมียม รวม Evolution Gaming, SA Gaming, Sexy Baccarat และ Pragmatic Play Live" as="h2">
    <p class="text-left text-base leading-relaxed">
      ล็อบบี้ของเรารวมค่ายคาสิโนสดชั้นนำระดับโลกมาไว้ครบในที่เดียว ทั้ง Evolution Gaming, SA Gaming, Sexy Baccarat และ Pragmatic Play Live ซึ่งเป็นเจ้าของสตูดิโอและฟลอร์จริงที่ถ่ายทอดออกมาเอง ไม่ใช่ภาพที่หน้าตาเหมือนแต่ต้นทางไม่ตรงกับที่บอก
      แต่ละค่ายมีบุคลิกของตัวเองชัดเจน บางค่ายเด่นเรื่องจำนวนโต๊ะและเกมโชว์สดที่ผลิตออกมาไม่ซ้ำ บางค่ายเด่นเรื่องดีลเลอร์และบรรยากาศห้องที่ดูสบายตา การมีทั้งสี่ค่ายอยู่ในยูสเซอร์เดียวจึงแปลว่าเลือกได้ตามอารมณ์ของคืนนั้น ไม่ใช่ตามว่าเว็บมีอะไรให้
      ห้องเล่นเปิดไว้หลายระดับ ตั้งแต่โต๊ะหลักสิบสำหรับคนที่อยากลองจังหวะก่อน ไปจนถึงโต๊ะระดับ <strong class="text-[#f7dfa5]">High Roller</strong> สำหรับสายที่วางเดิมพันก้อนใหญ่
      เลือกห้องให้พอดีกับทุนตั้งแต่แรกช่วยให้เล่นได้ยาวกว่าการฝืนนั่งโต๊ะที่ขั้นต่ำสูงเกินงบของวันนั้น
    </p>
  </ContentBox>

  <ContentBox title="เกมหลายหมวดในยูสเซอร์เดียว จากบาคาร่าไปรูเล็ต เสือมังกร ไฮโล และเกมโชว์สด" as="h2">
    <p class="text-left text-base leading-relaxed">
      คนที่เล่นคาสิโนสดส่วนใหญ่ไม่ได้อยู่กับเกมเดียวทั้งคืน เราจึงจัดล็อบบี้ให้สลับฟีลได้เร็วที่สุดเท่าที่ทำได้ เริ่มจากบาคาร่าคลาสสิกที่จังหวะนิ่งและอ่านเกมได้ยาว ไปบาคาร่าสายฟ้าที่ใส่ตัวคูณเข้ามาให้ลุ้นหนักขึ้นในบางตา
      แล้วขยับไปรูเล็ตที่วางเดิมพันได้หลายรูปแบบในตาเดียว เสือมังกรที่ตัดจบไวที่สุดในบรรดาเกมโต๊ะ ไฮโลที่คุ้นมือคนไทยอยู่แล้ว วงล้อเสี่ยงโชค และเกมโชว์สดที่เล่นเป็นรอบและมีพิธีกรคุมเกมให้บรรยากาศต่างออกไปทั้งหมด
      จุดที่ทำให้สลับได้อิสระจริงคือ<strong class="text-[#f7dfa5]">กระเป๋าเงินเดียว ยูสเซอร์เดียว</strong> ย้ายจากโต๊ะบาคาร่าไปวงล้อเสี่ยงโชคเป็นแค่การเลือกห้อง
      ไม่ต้องกดโอนยอดข้ามค่ายให้เสียจังหวะ และไม่มีเครดิตตกค้างอยู่ในค่ายที่เพิ่งออกมาให้ต้องตามเก็บทีหลัง
    </p>
  </ContentBox>

  <ContentBox title="เว็บใหญ่ทุนหนา จ่ายเต็มจำนวนทุกยอด ไม่ล็อคยูส ไม่ปรับอัตราแพ้ชนะ" as="h2">
    <p class="text-left text-base leading-relaxed">
      คำว่าเว็บใหญ่ทุนหนาของเราวัดกันที่ตอนถอน ไม่ใช่ตอนโฆษณา ฐานการเงินของเว็บถูกวางไว้ให้รองรับยอดชนะก้อนใหญ่ได้จริง ถอนหลักแสนหลักล้านก็จ่ายครบเต็มจำนวนโดยไม่มีการต่อรองหรือหั่นยอดปลายทาง
      สิ่งที่เราไม่ทำและถือเป็นเส้นตายมีสองข้อ คือไม่ล็อคยูสสมาชิกที่ทำกำไรได้ และไม่ปรับอัตราแพ้ชนะของโต๊ะเพื่อผลลัพธ์ของใครก็ตาม ผลของแต่ละตาเกิดขึ้นบนฟลอร์จริงตรงหน้ากล้อง ไม่ได้เกิดในระบบหลังบ้านของเรา
      ข้อมูลของสมาชิกเก็บเป็นความลับขั้นสุด และช่องทางการเงินรองรับครบทั้งธนาคารชั้นนำทั่วไทยและ TrueMoney Wallet เพื่อให้คนที่ไม่ได้ผูกบัญชีธนาคารไว้ก็ยังทำรายการได้ตามปกติ
      ความมั่นคงแบบนี้ไม่ได้ทำให้ใครชนะบ่อยขึ้น แต่ทำให้ตอนชนะแล้วไม่ต้องลุ้นซ้ำอีกรอบว่าเงินจะออกไหม ซึ่งเป็นคนละเรื่องกันและสำคัญพอ ๆ กัน
    </p>
  </ContentBox>

  <ContentBox title="สิทธิพิเศษที่กดรับเองได้ทุกวัน เงื่อนไขโปร่งใส ไม่ติดเทิร์นโอเวอร์มหาโหด" as="h2">
    <p class="text-left text-base leading-relaxed">
      โปรโมชันของเราตั้งใจเขียนให้กดรับแล้วได้ใช้จริง ไม่ใช่ตัวเลขไว้โชว์หน้าเว็บ ชุดหลักมีสี่รายการที่อัปเดตวนอยู่ตลอด ได้แก่ โบนัสต้อนรับคาสิโนสดสำหรับสมาชิกใหม่ที่เพิ่มทุนให้ตั้งแต่รอบแรก
      โปรฝากแรกของวันที่ออกแบบมาให้สายเล่นต่อเนื่อง สิทธิ์รับเครดิตคืนยอดเสีย Cash Back ที่คำนวณให้ทุกวัน และคอมมิชชันจากการชวนเพื่อนสำหรับคนที่พาคนรู้จักเข้ามาเล่นด้วยกัน
      จุดที่เราถือเป็นเรื่องจริงจังคือเงื่อนไขต้องโปร่งใสและอ่านจบได้ในบรรทัดเดียว กดรับเองได้ทันทีจากหน้าแดชบอร์ดโดยไม่ต้องทักแอดมิน และไม่มีเทิร์นโอเวอร์มหาโหดซ่อนไว้ท้ายรายการให้มาเซอร์ไพรส์ตอนจะถอน
      สิ่งที่ยังต้องดูเองก่อนกดรับคือเพดานและรอบเวลาของแต่ละสิทธิ์ เพราะแต่ละรายการคิดจากยอดคนละชุดและมีจังหวะของตัวเอง เลือกให้ตรงกับสไตล์การเล่นของวันนั้นจะคุ้มกว่าการกดรับทุกอย่างที่เห็น
    </p>
  </ContentBox>

  <ContentBox title="ฝากถอนออโต้ผ่าน Gateway ตรง เครดิตเข้าใน 3 วินาที ไม่ต้องส่งสลิป" as="h2">
    <p class="text-left text-base leading-relaxed">
      ระบบการเงินคือส่วนที่เราเลือกให้เครื่องทำงานแทนคนทั้งหมด ฝากถอนเป็นออโต้เต็มรูปแบบ ประมวลผลผ่าน Gateway ที่ต่อตรงกับธนาคารชั้นนำทั่วไทยและ TrueMoney Wallet ฝากเงินปุ๊บเครดิตเข้าเกมภายใน 3 วินาที
      กดถอนได้ด้วยตัวเองจากหน้าแดชบอร์ด ไม่ต้องถ่ายสลิปส่งให้ใครยืนยัน ไม่ต้องต่อคิวรอแอดมินอนุมัติ และถอนออกได้เต็มจำนวนทุกยอดโดยไม่มีเงื่อนไขยุ่งยาก
      สิ่งที่ยังต้องตรวจด้วยตัวเองมีสองอย่าง คือผูกชื่อบัญชีธนาคารให้ตรงกับข้อมูลสมาชิก และเข้าใช้งานผ่านลิงก์ที่ตรวจชื่อเว็บไซต์แล้วเท่านั้น
      ทั้งนี้คาสิโนสดยังเป็นเกมที่ผลลัพธ์ของแต่ละตาเป็นอิสระจากกันเสมอ การตั้งงบต่อตาให้พอดีกับทุนของวันนั้น เลือกห้องให้ตรงกับงบ และหยุดเมื่อถึงขีดที่ตั้งไว้
      ยังเป็นเรื่องสำคัญที่สุดที่เราอยากให้ถือติดตัวไว้เสมอ
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
