---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 152.
const pageDescription =
  "รู้จัก IOK66 เว็บสล็อตต่างประเทศ ส่งเกมลิขสิทธิ์แท้ตรงจากค่ายแม่ผ่านระบบ API แท้ RTP สูง ไม่ล็อคผล สุ่มผลด้วย RNG ถอนเต็มจำนวน ฝากถอนออโต้ไม่ต้องส่งสลิป";

const pageTitle = "เกี่ยวกับ IOK66 เว็บสล็อตต่างประเทศ ลิขสิทธิ์แท้ 100% ส่งตรงจากค่ายแม่";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

const headingClass = "mt-8 mb-6 bg-gradient-to-r from-[#ffe9a3] via-[#e3b64a] to-[#b8862c] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed">
        IOK66 เกิดขึ้นมาเพื่อคนที่กำลังมองหาแหล่งทำเงินที่ไว้ใจได้ และเลือกเล่นกับเว็บตรงจากต่างประเทศเพราะมาตรฐานการให้บริการสูงกว่าเว็บทั่วไปอย่างชัดเจน
        เรานำเสนอประสบการณ์ปั่นสล็อตระดับโลกด้วยระบบ API แท้ที่ดึงตรงจากเซิร์ฟเวอร์หลัก ไม่มีตัวกลางมาคั่นระหว่างทาง ทุกการหมุนจึงวิ่งบนระบบเดียวกับที่ค่ายเกมตั้งค่าไว้จริง
        และเริ่มต้นได้ง่ายเพียงสมัครเข้ามาเป็นครอบครัวเดียวกัน ขั้นตอนลงทะเบียนสั้น กระชับ ไม่ต้องกรอกข้อมูลส่วนตัวให้วุ่นวาย
        เปิดยูสเซอร์สำเร็จก็รับสิทธิพิเศษและโปรโมชั่นต้อนรับไปต่อยอดเป็นทุนเดิมพันได้ทันที
      </p>

      <h2 class={headingClass}>เกมลิขสิทธิ์แท้ 100% ส่งตรงจากค่ายแม่ผ่านเซิร์ฟเวอร์หลัก</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        ทุกเกมบนเว็บถูกนำเข้ามาอย่างถูกต้องตามกฎหมายของวงการคาสิโนสากล เราคัดสรรเฉพาะค่ายเกมชั้นนำที่ได้รับการยอมรับระดับโลกมาให้บริการ
        คุณภาพกราฟิก ฟีเจอร์ตัวคูณ และระบบเสียงจึงมาครบตามที่ค่ายแม่ตั้งใจทำไว้ ไม่ถูกลดทอนระหว่างทาง
        ผลที่ผู้เล่นสัมผัสได้ตรงที่สุดคือหมดปัญหาภาพกระตุกหรือเกมค้างช่วงโบนัสไทม์ เพราะการเล่นผ่านเซิร์ฟเวอร์หลักทำให้ทุกรอบการเดิมพันแฟร์และได้มาตรฐานสูงสุด
      </p>

      <h2 class={headingClass}>RTP สูงกว่าเว็บทั่วไป ไม่ล็อคผล และสุ่มผลด้วย RNG ที่ตรวจสอบได้</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        เคล็ดลับที่ทำให้นักปั่นหลายคนเลือกตั้งรกรากอยู่ที่นี่ คือค่า RTP หรือ Return to Player ที่สูงกว่าเว็บทั่วไป เราไม่มีการปรับลดอัตราการชนะของผู้เล่น
        จังหวะการออกสแกตเตอร์หรือฟรีสปินจึงมาบ่อยและเข้าถึงง่าย ไม่ว่าจะเดินเบทขั้นต่ำหรือปรับเบทหนัก
        ความกังวลเรื่องการถูกปรับเรทชนะหรือล็อคยูสเซอร์ก็หมดไป เพราะระบบทำงานด้วยกลไกสุ่มผลแบบ RNG หรือ Random Number Generator ที่ตรวจสอบได้และได้รับการรับรองจากสถาบันอิสระ
        ทุกยอดการได้เสียเกิดจากอัลกอริทึมที่โปร่งใส 100% ไม่มีแอดมินหลังบ้านคอยกดปุ่มแทรกแซงผลรางวัล
      </p>

      <h2 class={headingClass}>ถอนเต็มจำนวนไม่หักเปอร์เซ็นต์ ด้วยระบบฝากถอนออโต้ที่ไม่ต้องส่งสลิป</h2>

      <p class="text-left text-base leading-relaxed">
        เล่นได้เท่าไหร่เราพร้อมโอนให้เต็มจำนวนไม่มีหักเปอร์เซ็นต์ ไม่ว่าจะเป็นยอดแตกหลักร้อยหรือแจ็คพอตแตกล้าน ฐานการเงินของเรามั่นคงระดับแนวหน้าของเอเชีย
        จึงรองรับการทำรายการถอนเงินก้อนใหญ่ได้อย่างไร้ขีดจำกัด และไม่ต้องทำเทิร์นโอเวอร์ซ้ำซ้อนให้เสียเวลา
        เพราะเวลาเป็นสิ่งมีค่าสำหรับนักลงทุน เราจึงพัฒนาระบบธุรกรรมการเงินให้เป็นรูปแบบอัตโนมัติเต็มรูปแบบ ไม่ต้องส่งสลิป ไม่ต้องรอแอดมินตอบแชท
        คุณทำรายการฝากและถอนผ่านหน้าเว็บได้ด้วยตัวเอง ระบบจะประมวลผลและอัปเดตยอดเงินในกระเป๋าภายในไม่กี่วินาที รองรับทุกธนาคารชั้นนำ
        ให้สนุกกับการปั่นสล็อตได้อย่างต่อเนื่องไม่มีสะดุด ทั้งบนมือถือและคอมพิวเตอร์
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
