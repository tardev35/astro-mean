---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// DEED888: ticker หมุนมาเป็น Announcement5 ส่วนกล่องหน้าย่อยยังเป็น ContentBox
// (การ์ดถาวรของหน้าย่อย) ตามสเปกรอบนี้ เรียก <Announcement /> เปล่า ๆ เพราะ
// default message ของ variant นี้ถูกตั้งให้ตรงกับที่หน้าแรกส่งเข้าไปแล้ว
// สีเน้นในย่อหน้าใช้ทอง #f4940c กับส้มอ่อน #ff9d4d ของพาเลตต์รอบนี้
// (ไม่ใช้ส้มเพลิงเข้ม #e95b0b กับตัวอักษรขนาดเนื้อความ เพราะคอนทราสต์บนผิว
// #210702 ของการ์ดตกลงมาใกล้เกณฑ์ AA เกินไป — สองสีที่เลือกไว้ผ่านสบาย)
// ส่วนสีเนื้อความมาจากการ์ดเอง ไม่ต้องระบุซ้ำ
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 157.
const pageDescription =
  "รู้จัก DEED888 สล็อตเกมแท้ตัวท็อป ยิงตรง API จากสตูดิโอผู้พัฒนา ค่า RTP ตามสเปกโรงงาน ไม่ผ่านเอเย่นต์ คัดเกม A-List จัดโปรเป็นชุด ฝากถอนออโต้จบในไม่กี่วินาที";

const pageTitle = "เกี่ยวกับเรา DEED888 | สล็อตเกมแท้ตัวท็อป API ตรงจากสตูดิโอผู้พัฒนา";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา DEED888";

// docx รอบนี้ไม่มีส่วน SUB-PAGES จึงไม่มีบอดี้สำเร็จรูปให้หน้านี้ — หัวข้อและ
// ย่อหน้าทั้งเจ็ดบล็อกด้านล่างเขียนขึ้นใหม่จากข้อเท็จจริงของแบรนด์ในบรีฟรอบนี้
// (API ตรงจากสตูดิโอผู้พัฒนา · RTP มาตรฐานยุติธรรมตามสเปกโรงงาน ไม่ผ่านเอเย่นต์
// ไม่ปรับเปอร์เซ็นต์แพ้ชนะ · เซิร์ฟเวอร์เสถียรรองรับการเดิมพันทุกระดับ · เกมระดับ
// A-List จาก PG Soft, Pragmatic Play และ Joker Gaming โครงสร้างการจ่ายโปร่งใส
// กราฟิกคมชัด · ทั้งเกมกระแสติดชาร์ตและเกมนอกกระแสอัตราคูณโหด · โบนัสสมทบทุน
// ฝากแรก สิทธิ์คืนยอดเสีย Cash Back รายวัน เครดิตพิเศษเฉพาะช่วงเวลา ถอนได้จริง
// ไม่ติดล็อคยูส · ฟีเจอร์ Multiplier Drops / Expanding Wilds / ซื้อฟรีสปิน ·
// ล็อบบี้อัปเดตเกมใหม่ขึ้นแถวหน้า เช็กอัตราจ่ายและลองในโหมดทดลองฟรีได้ก่อน ·
// ฝากถอนออโต้ผ่าน Gateway ตรง เสร็จในไม่กี่วินาที ไม่ต้องแนบสลิป ไม่ต้องรอคิว
// แอดมิน) — ไม่ลอกย่อหน้าในบรีฟมาทั้งดุ้น เพราะย่อหน้าชุดนั้นใช้เต็ม ๆ อยู่บน
// หน้าแรกแล้ว หัวข้อจึงตั้งคนละสำนวนกับ h2 ของหน้าแรกด้วย โครงเป็น h1×1 + h2×6
// ไม่มี h3 และห้ามเติมข้อเท็จจริงที่บรีฟไม่ได้ให้ เช่น เลขใบอนุญาต จำนวนผู้เล่น
// รางวัล ชื่อธนาคาร หรือตัวเลขเวลาทำรายการที่บรีฟไม่ได้ระบุไว้
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="text-left text-base leading-relaxed">
      <strong class="text-[#f4940c]">DEED888</strong> เริ่มจากข้อสังเกตง่าย ๆ ว่าคนที่ตั้งใจมานั่งปั่นสล็อตควรมีเรื่องให้ลุ้นแค่เรื่องเดียว คือรอบถัดไปจะเข้าฟีเจอร์หรือไม่ ไม่ใช่ต้องแบ่งใจไปลุ้นด้วยว่าเว็บที่นั่งอยู่ทำตามที่ประกาศไว้จริงหรือเปล่า
      เราจึงวางเว็บนี้ให้เป็นสล็อตเกมแท้ตัวท็อปที่เชื่อมต่อสัญญาณ API ตรงจากสตูดิโอผู้พัฒนาสล็อตระดับโลก ทุกการหมุนวางอยู่บนค่า RTP มาตรฐานยุติธรรมตามสเปกโรงงานที่ค่ายเป็นคนกำหนดเอง ไม่ผ่านเอเย่นต์ และไม่มีการปรับแต่งเปอร์เซ็นต์แพ้ชนะให้ใครในช่วงเวลาไหนทั้งสิ้น
      งานที่เหลือเป็นของเราล้วน ๆ คือคัดเฉพาะเกมระดับ A-List ขึ้นล็อบบี้ จัดโปรฮิตมาเป็นชุดให้เลือกกดรับตามจังหวะเดิมพันของแต่ละวัน แล้วยกงานฝากถอนทั้งหมดให้ระบบออโต้รับไปทำแทนคน
      เพื่อให้เวลาของสมาชิกหมดไปกับการสปิน ไม่ใช่กับการรอ
    </p>
  </ContentBox>

  <ContentBox title="ยิงตรง API จากสตูดิโอเจ้าของเกม ไม่มีเอเย่นต์คั่นกลางสักชั้น" as="h2">
    <p class="text-left text-base leading-relaxed">
      จุดยืนข้อแรกของเราคือระหว่างปุ่มสปินกับเซิร์ฟเวอร์ของค่ายเจ้าของเกมต้องไม่มีอะไรมาคั่น ทุกเกมในล็อบบี้เชื่อมด้วยสัญญาณ API ที่ยิงตรงจากสตูดิโอผู้พัฒนา คำสั่งจึงวิ่งไปบันทึกที่ค่ายแล้วส่งผลกลับมาตามที่ตัวสุ่มของค่ายตัดสินจริง
      โครงสร้างที่ไม่ผ่านเอเย่นต์แปลว่าไม่มีจุดใดเลยตลอดทางที่ใครจะเข้าไปแตะผลของสปินได้
      ค่า <strong class="text-[#ff9d4d]">RTP มาตรฐานยุติธรรมตามสเปกโรงงาน</strong> ของแต่ละเกมเป็นตัวเลขที่ค่ายตั้งมาเอง เราไม่ปรับ ไม่หรี่ และไม่ตั้งเงื่อนไขซ่อนไว้ให้สมาชิกคนหนึ่งต่างจากอีกคน
      ตัวระบบรันบนเซิร์ฟเวอร์เสถียรสูงที่รองรับการเดิมพันได้ทุกระดับ คนที่ปั่นหลักสิบกับคนที่ปั่นหลักหมื่นจึงอยู่บนระบบชุดเดียวกัน สิ่งที่ต่างกันได้มีแค่โปรโมชันและสิทธิ์ที่แต่ละคนเลือกกดรับ ไม่ใช่กลไกของตัวเกม
    </p>
  </ContentBox>

  <ContentBox title="คัดเฉพาะเกมระดับ A-List จาก PG Soft, Pragmatic Play และ Joker Gaming" as="h2">
    <p class="text-left text-base leading-relaxed">
      คลังเกมของเราผ่านการคัดกรองก่อนขึ้นล็อบบี้ทุกตัว เรากวาดเฉพาะเกมระดับ A-List จากค่ายยักษ์ใหญ่อย่าง PG Soft, Pragmatic Play และ Joker Gaming เข้าระบบ ไม่ใช่เกมหน้าตาคล้ายกันที่ทำเลียนแบบขึ้นมาทีหลัง
      เกณฑ์คัดมีสามข้อและตรงไปตรงมา ข้อแรก <strong class="text-[#ff9d4d]">โครงสร้างการจ่ายรางวัลต้องโปร่งใส</strong> อ่านออกได้จากตารางอัตราจ่ายของเกมเอง ข้อสอง จังหวะโบนัสต้องแตกง่ายพอจะเห็นได้ในรอบที่นั่งปั่นจริง และข้อสาม กราฟิกต้องประมวลผลคมชัดลื่นไหลไม่มีสะดุดตั้งแต่สปินแรก
      เกมที่ระบบล้าหลัง หรือจ่ายแบบอ่านไม่ออกว่าจ่ายมาจากอะไร เราตัดออกตั้งแต่ก่อนขึ้นหน้าเว็บ
      ในล็อบบี้จึงมีทั้งเกมกระแสที่ติดอันดับชาร์ตอยู่ตอนนี้ และเกมสล็อตนอกกระแสที่อัตราคูณโหดกว่าแต่คนพูดถึงน้อยกว่า การมีทุกค่ายอยู่ในยูสเซอร์เดียวแปลว่าเลือกได้ตามกลยุทธ์เดินเงินของคืนนั้น ไม่ใช่ตามว่าเว็บเหลืออะไรให้เลือก
    </p>
  </ContentBox>

  <ContentBox title="โปรฮิตจัดมาเป็นชุด เลือกกดรับให้ตรงกับจังหวะเดิมพันของแต่ละวัน" as="h2">
    <p class="text-left text-base leading-relaxed">
      ข้อเสนอของเราคิดมาเป็นชุดให้ครอบจังหวะเดิมพันจริง ไม่ใช่ยัดใบเดียวให้ทุกคนเหมือนกันหมด คนที่เพิ่งเปิดยูสมีโบนัสสมทบทุนฝากแรกรออยู่ คนที่ปั่นยาวทุกวันมีสิทธิ์คืนยอดเสีย <strong class="text-[#ff9d4d]">Cash Back รายวัน</strong> ส่วนคนที่เลือกลงเป็นช่วงก็มีเครดิตพิเศษเฉพาะช่วงเวลาให้กด
      ทุกสิทธิ์เลือกรับเองได้ จึงจับคู่กับแผนของวันนั้นได้ด้วยตัวเองโดยไม่ต้องทักหาใครก่อน
      เรื่องที่เราให้น้ำหนักไม่แพ้กันคือเงื่อนไขต้องใช้ได้จริง ทุกโปรโมชันกำหนดเงื่อนไขไว้โปร่งใส อ่านจบแล้วรู้ทันทีว่าต้องทำอะไรถึงถอนได้ ถอนได้จริง และไม่มีการล็อคยูสคนที่ทำกำไรได้
      โบนัสที่ถอนไม่ได้ไม่นับเป็นโบนัส มันเป็นแค่เหตุผลให้เล่นต่อ เราจึงออกแบบสิทธิ์ให้มีเหตุผลพอที่คนอ่านเงื่อนไขจบแล้วยังอยากกดรับ แล้วเอาไปต่อรอบสปินได้ยาวขึ้นจริง
    </p>
  </ContentBox>

  <ContentBox title="ฟีเจอร์ใหม่น่าลอง ตั้งแต่ Multiplier Drops ถึงโหมดซื้อฟรีสปินทันใจ" as="h2">
    <p class="text-left text-base leading-relaxed">
      ลูกเล่นยุคใหม่คือเหตุผลที่สล็อตสองตัวซึ่งหน้าตารีลคล้ายกันกลับให้ฟีลคนละแบบ ล็อบบี้ของเราจึงเลือกเกมที่มีฟีเจอร์เด่นชัดพอให้รู้สึกได้ตั้งแต่รอบแรกที่หมุน
      ตัวที่เจอบ่อยและเปลี่ยนเกมได้จริงมีสามกลุ่ม กลุ่มแรกคือระบบสุ่มแจกตัวคูณทวีคูณ <strong class="text-[#ff9d4d]">Multiplier Drops</strong> ที่หย่อนตัวคูณลงมาระหว่างรอบปกติ กลุ่มที่สองคือสัญลักษณ์ขยายเต็มรีล Expanding Wilds ที่เปลี่ยนรีลทั้งแถวให้กลายเป็นไวลด์ และกลุ่มที่สามคือโหมดซื้อฟรีสปินแบบทันใจสำหรับคนที่ไม่อยากรอเก็บสแกตเตอร์เอง
      สามอย่างนี้ฉีกกฎการหมุนแบบเดิม แล้วแทรกจังหวะลุ้นแจ็คพอตก้อนโตเข้ามาในรอบที่เคยซ้ำซาก
      ข้อแลกเปลี่ยนก็มีและเราไม่ปิดบัง โหมดซื้อฟรีสปินกินทุนต่อครั้งหนักกว่าการปั่นปกติหลายเท่า จึงควรดูงบของวันนั้นก่อนกด ไม่ใช่กดเพราะปุ่มมันวางอยู่ตรงนั้นพอดี
    </p>
  </ContentBox>

  <ContentBox title="ล็อบบี้อัปเดตต่อเนื่อง ทดลองเล่นฟรีดูกลไกได้ก่อนเลือกขึ้นสปิน" as="h2">
    <p class="text-left text-base leading-relaxed">
      หน้าล็อบบี้เป็นส่วนที่เราออกแบบให้เข้าถึงง่ายที่สุด หมวดหมู่จัดวางไว้ชัดเจนและไม่ซับซ้อน กดเลือกค่ายที่อยากเล่นแล้วพุ่งตรงเข้าหน้าสปินได้ทันที ระหว่างทางไม่มีหน้าคั่นที่ตั้งใจให้เสียเวลา
      ที่สำคัญกว่านั้นคือเกมใหม่และค่ายเกมมาแรงจะถูกดันขึ้นแถวหน้าทันทีที่เปิดตัว คลังเกมจึงไม่มีวันตันและไม่มีคำว่าตกเทรนด์
      ก่อนตัดสินใจลงเครดิตจริง สมาชิกเช็กอัตราการจ่ายของเกมนั้นได้ กด<strong class="text-[#ff9d4d]">ทดลองเล่นในโหมดทดลองฟรี</strong>ได้ และอ่านกลไกของเกมที่เข้าใหม่ได้ก่อนใคร ทั้งสามอย่างนี้ทำให้การเลือกเกมขึ้นสปินแม่นขึ้น ตรงสไตล์ขึ้น และไม่ต้องเสียเวลาไล่หา
      สำหรับคนที่วางแผนมาแล้วว่าจะปั่นเกมไหนด้วยงบเท่าไหร่ ทุกวินาทีที่ถูกขวางไว้คือจังหวะที่หลุดไป เราจึงตัดระยะจากหน้าแรกถึงตัวเกมให้สั้นที่สุดเท่าที่ทำได้
    </p>
  </ContentBox>

  <ContentBox title="ฝากถอนออโต้ผ่าน Gateway ตรง ไม่ต้องแนบสลิป ไม่ต้องรอคิวแอดมิน" as="h2">
    <p class="text-left text-base leading-relaxed">
      ระบบการเงินคือส่วนที่เราเลือกให้เครื่องทำงานแทนคนทั้งหมด ธุรกรรมทุกรายการประมวลผลผ่าน Gateway ตรง และทำรายการเสร็จสิ้นในไม่กี่วินาทีนับจากกดยืนยัน ยอดอัปเดตเข้าคลังเกมทันที
      ขั้นตอนถ่ายสลิปส่งแอดมินและการต่อคิวรออนุมัติถูกตัดออกทั้งหมด ฝากยอดปุ๊บเข้าเล่นได้เลย ถอนกำไรปุ๊บก็เดินต่อได้ทันที <strong class="text-[#ff9d4d]">ลื่นไหลไร้รอยต่อตั้งแต่เติมทุนไปจนถึงถอนกำไร</strong>
      สิ่งที่ยังต้องตรวจด้วยตัวเองเหลืออยู่สองอย่าง คือผูกชื่อบัญชีให้ตรงกับข้อมูลสมาชิกตั้งแต่ตอนสมัคร และเข้าใช้งานผ่านลิงก์ที่ตรวจชื่อเว็บไซต์แล้วเท่านั้น สองข้อนี้ระบบทำแทนไม่ได้ แต่ใช้เวลาครั้งเดียวแล้วจบ
      ทั้งนี้สล็อตยังเป็นเกมที่ผลของแต่ละสปินเป็นอิสระจากกันเสมอ การตั้งงบต่อสปินให้พอดีกับทุนของวันนั้น เลือกเกมให้ตรงกับงบ และหยุดเมื่อถึงขีดที่ตั้งไว้ ยังเป็นเรื่องสำคัญที่สุดที่เราอยากให้ถือติดตัวไว้เสมอ
    </p>
