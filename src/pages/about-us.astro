---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 156.
const pageDescription =
  "เกี่ยวกับเรา VIREL168 สล็อตเว็บตรงที่รวมเกมแตกง่ายจากค่ายดังไว้ในล็อบบี้เดียว จัดหมวดชัด สลับค่ายไม่กี่คลิก โบนัสพร้อมทุกวัน ถอนออโต้เข้าบัญชีในไม่กี่วินาที";

const pageTitle = "เกี่ยวกับเรา VIREL168 | สล็อตเว็บตรงรวมเกมฮิตทุกค่าย โบนัสพร้อมทุกวัน";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา VIREL168";

// docx รอบนี้ไม่มีส่วน SUB-PAGES จึงไม่มีบอดี้สำเร็จรูปให้หน้านี้ — หัวข้อและ
// ย่อหน้าทั้งเจ็ดบล็อกด้านล่างเขียนขึ้นจากข้อเท็จจริงของแบรนด์ใน
// src/assets/content.txt (เว็บตรง รวมเกมแตกง่ายติดเทรนด์จากค่ายชั้นนำใน
// ล็อบบี้เดียว จัดหมวดตามค่ายและสไตล์ สลับค่ายไม่กี่คลิก โบนัสรายวัน
// ถอนออโต้เข้าบัญชีในไม่กี่วินาทีโดยไม่ต้องส่งสลิปหรือรอแอดมิน)
// โครงยังเป็น h1×1 + h2×6 เท่าเดิม
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="text-left text-base leading-relaxed">
      VIREL168 คือเว็บสล็อตออนไลน์แบบเว็บตรงที่ตั้งใจรวบรวมเกมสล็อตแตกง่ายติดเทรนด์จากค่ายชั้นนำทุกค่ายมาไว้ในล็อบบี้เดียว เปิดเข้ามาครั้งเดียวก็เลือกได้ทั้งเกมตัวตึงที่กำลังเป็นกระแสและเกมนอกกระแสที่ซ่อนฟีเจอร์เด็ดเอาไว้
      โดยไม่ต้องโยกเว็บไปมาเพื่อตามหาเกมของค่ายโปรด เราปรับจูนระบบให้ทำงานลื่นไหลไร้ปัญหากระตุก จัดโบนัสไว้ต้อนรับทุกวัน และปิดท้ายด้วยระบบถอนออโต้ที่โอนเข้าบัญชีภายในไม่กี่วินาที
    </p>
  </ContentBox>

  <ContentBox title="เว็บตรงที่รวมค่ายดังไว้ในล็อบบี้เดียว" as="h2">
    <p class="text-left text-base leading-relaxed">
      จุดตั้งต้นของ VIREL168 คือการดึงค่ายเกมยักษ์ใหญ่ระดับโลกมารวมไว้ในหน้าเดียว ผู้เล่นจึงได้สัมผัสงานภาพและกลไกเกมที่หลากหลายอย่างอิสระ ทั้งค่ายที่ขึ้นชื่อเรื่องภาพสวยสมจริงและค่ายที่เน้นจังหวะโบนัสระเบิดไว
      เมื่อทุกอย่างอยู่ในล็อบบี้เดียวกัน ยูสเซอร์เดียวกับกระเป๋าเงินใบเดียวก็พาไปได้ทุกค่าย ไม่ต้องกดโยกยอดไปมาและไม่ต้องเสียเวลาเปิดหลายเว็บให้วุ่นวายอีกต่อไป
    </p>
  </ContentBox>

  <ContentBox title="แนวทางการคัดเกมเข้าล็อบบี้ ทั้งตัวท็อปและเกมน่าค้น" as="h2">
    <p class="text-left text-base leading-relaxed">
      ไลน์อัปที่เราคัดเข้ามามีทั้งเกมฮิตระดับตัวตึงที่กำลังเป็นกระแสในหมู่สายปั่น ทั้งสล็อตธีมผจญภัยสุดอลังการและเกมแนวแอ็กชันที่มีฟีเจอร์ตัวคูณสะสมแบบทวีคูณ ทุกเกมผ่านการดูแล้วว่าอัตราการจ่ายรางวัลดีและลุ้นรอบแจ็คพอตได้จริง
      ขณะเดียวกันเราก็เก็บเกมนอกกระแสที่ซ่อนลูกเล่นไว้เข้ามาด้วย ทั้งฟรีสปินที่ออกง่ายเกินคาดและสัญลักษณ์พิเศษที่เปลี่ยนรางวัลธรรมดาให้กลายเป็นแจ็คพอตก้อนโต เพราะเกมทำเงินตัวใหม่มักซ่อนอยู่นอกลิสต์ยอดนิยม
    </p>
  </ContentBox>

  <ContentBox title="จัดหมวดหมู่ให้เลือกง่าย สลับค่ายได้ในไม่กี่คลิก" as="h2">
    <p class="text-left text-base leading-relaxed">
      หน้าเว็บของ VIREL168 ถูกวางหมวดหมู่เกมไว้อย่างเป็นระเบียบ แบ่งประเภทตามค่ายเกมและสไตล์การเล่นไว้ชัดเจน อยากเปลี่ยนบรรยากาศจากสล็อตแนวหนึ่งไปอีกแนวก็สลับได้ทันทีเพียงไม่กี่คลิก
      ระบบตอบสนองไวโดยไม่ต้องนั่งรอโหลดนาน การไล่เปิดดูหลายเกมรวดเดียวจึงเสียเวลาน้อยกว่าที่คิด และช่วยรักษาจังหวะการเล่นของคุณให้ต่อเนื่องแบบไม่มีสะดุด
    </p>
  </ContentBox>

  <ContentBox title="โบนัสและโปรโมชันที่หมุนเวียนให้ตามทุกวัน" as="h2">
    <p class="text-left text-base leading-relaxed">
      อีกเรื่องที่เราให้ความสำคัญคือการเตรียมโบนัสและสิทธิประโยชน์ไว้ต้อนรับอยู่เสมอ ทั้งโปรโมชันต้อนรับสมาชิกใหม่ โบนัสเติมเงินรายวัน และกิจกรรมพิเศษตามเทศกาลที่หมุนเวียนเปลี่ยนไปตามแต่ละช่วง
      ทั้งหมดออกแบบมาเพื่อเพิ่มทุนให้ผู้เล่นปั่นสล็อตได้นานขึ้นและมีโอกาสพิชิตรางวัลใหญ่บ่อยขึ้น ทั้งนี้แต่ละรายการมีเงื่อนไขและรอบเวลาของตัวเอง จึงควรอ่านรายละเอียดของสิทธิ์ที่จะกดรับให้จบก่อนกดทุกครั้ง
    </p>
  </ContentBox>

  <ContentBox title="ระบบการเงินออโต้ ถอนเข้าบัญชีภายในไม่กี่วินาที" as="h2">
    <p class="text-left text-base leading-relaxed">
      ระบบการเงินของ VIREL168 เชื่อมต่อกันตั้งแต่ขั้นตอนการเข้าเล่นไปจนถึงขั้นตอนการถอนเงิน เมื่อทำกำไรได้ตามเป้า คุณกดถอนผ่านหน้าเว็บได้ด้วยตัวเองทันที ยอดเงินจะถูกโอนเข้าบัญชีอย่างแม่นยำภายในไม่กี่วินาที
      โดยไม่ต้องส่งสลิปยืนยันและไม่ต้องรอแอดมินอนุมัติ ทำรายการได้เองทุกช่วงเวลา จึงบริหารจัดการยอดเงินของตัวเองได้อย่างคล่องตัวโดยไม่เสียจังหวะการเล่น
    </p>
  </ContentBox>

  <ContentBox title="ความตั้งใจของเราในการดูแลผู้เล่น" as="h2">
    <p class="text-left text-base leading-relaxed">
      เป้าหมายของ VIREL168 คือการทำให้บรรยากาศการทำกำไรโปร่งใสและตรวจสอบได้ ถอนเงินได้จริงทุกยอด และทำให้ผู้เล่นมั่นใจได้ตั้งแต่สปินแรกที่เข้ามาใช้งาน เราจึงเลือกลงแรงกับสิ่งที่ผู้เล่นสัมผัสได้จริง
      ทั้งความเสถียรของระบบ ความชัดเจนของเงื่อนไข และความเร็วของการโอนเงิน พร้อมกันนั้นเราก็สนับสนุนการเดิมพันอย่างมีสติ ตั้งงบต่อรอบให้พอดีกับทุนที่ตั้งใจใช้ในวันนั้น แล้วความสนุกจะอยู่กับคุณได้นานกว่า
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
