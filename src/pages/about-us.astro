---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

// VIPSAND356: ticker หมุนมาเป็น AnnouncementCyber ส่วนกล่องหน้าย่อยยังเป็น ContentBox
// (การ์ดถาวรของหน้าย่อย) เรียก <Announcement /> เปล่า ๆ เพราะ default message ของ
// variant นี้ถูกตั้งให้ตรงกับที่หน้าแรกส่งเข้าไปแล้ว
//
// ห้ามใส่คลาสสีลงในย่อหน้าข้างในการ์ด — ContentBox ตั้งสีเนื้อความให้แล้ว การเขียน
// สีทับตรงนี้คือการฝัง hex ของแบรนด์รอบนี้ไว้ในไฟล์ที่รีแบรนด์รอบหน้าไม่ได้เปิด
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 158, and is one
// sentence about what the page is for rather than a table of contents.
const pageDescription = "หน้าแนะนำตัวของ VIPSAND356 สล็อตของพรีเมียม เว็บตรง API แท้ ไม่ผ่านเอเย่นต์ ว่าเราเป็นใคร คัดเกมเกรด A-List ด้วยเกณฑ์ไหน ดูแลค่า RTP และวางระบบออโต้ไว้อย่างไร";

const pageTitle = "เกี่ยวกับเรา VIPSAND356 | สล็อตของพรีเมียม เว็บตรง API แท้ ออโต้ 3 วินาที";

// หัวข้อระดับ h1 ของหน้า แยกจากค่า title เพราะ title มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา VIPSAND356";

// docx รอบนี้ไม่มีส่วน SUB-PAGES จึงไม่มีบอดี้สำเร็จรูปให้หน้านี้ — หัวข้อและย่อหน้า
// ด้านล่างเขียนขึ้นใหม่จากข้อเท็จจริงของแบรนด์ในบรีฟรอบนี้ (เว็บตรงสล็อตพรีเมียม
// API แท้ ยิงตรงจากคลังเกมหลักสากล ไม่ผ่านเอเย่นต์ · ค่า RTP ตรงตามสเปกโรงงาน
// ผู้พัฒนา ไร้การดัดแปลงระบบ ไม่ล็อกยูส · คัดเฉพาะเกมเกรด A-List จัดหมวดหมู่ใน
// ล็อบบี้เดียว · ค่าย PG Soft, Pragmatic Play, Joker Gaming · ฟีเจอร์ Multiplier /
// Expanding Wild / Cascading / Bonus Buy · โบนัสต้อนรับสมาชิกใหม่ / โปรฝากแรกของวัน
// / Cash Back ทุกวัน ไม่ติดเทิร์นโอเวอร์ซับซ้อน · ฝากถอนออโต้ผ่าน Gateway ตรงเสร็จ
// ใน 3 วินาที ไม่ต้องส่งสลิป ถอนได้เต็มทุกยอด · บริการระดับ VIP แอดมินสแตนด์บาย
// ตลอด 24 ชั่วโมง)
// — ไม่ลอกย่อหน้าในบรีฟมาทั้งดุ้น เพราะย่อหน้าชุดนั้นใช้เต็ม ๆ อยู่บนหน้าแรกแล้ว
// หน้านี้จึงเขียนคนละสำนวนในมุม "เราเป็นใคร" จากข้อเท็จจริงชุดเดียวกัน โครงเป็น
// h1×1 + h2×3 ไม่มี h3 และห้ามเติมข้อเท็จจริงที่บรีฟไม่ได้ให้ เช่น เลขใบอนุญาต
// จำนวนสมาชิก รางวัล ทุนสำรอง ชื่อธนาคารเจาะจง หรือฝั่งหวย/คาสิโนสด/กีฬา —
// บรีฟรอบนี้เป็นเว็บสล็อตล้วน
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="text-left text-base leading-relaxed">
      VIPSAND356 ตั้งต้นจากข้อสังเกตเดียวว่าล็อบบี้สล็อตส่วนใหญ่ยัดเกมมาให้มากจนหาเกมที่อยากเล่นไม่เจอ กว่าจะได้กดหมุนจริงก็เสียเวลาไถหาไปครึ่งค่อนรอบ เราจึงเลือกทำสวนทาง คือ<strong>
        คัดเกมเด็ดมาเต็มแต่คัดให้จริง
      </strong>
      ตัดเกมคุณภาพต่ำออกจากระบบทั้งหมด เหลือไว้เฉพาะเกมเกรด A-List ที่อัตราการจ่ายเงินรางวัลโปร่งใสและโบนัสแจ็คพอตแตกง่าย แล้วจัดหมวดหมู่ไว้ในหน้าแดชบอร์ดเดียวให้พุ่งเข้าสปินได้ตั้งแต่เปิดหน้าแรก จากนั้นวางโครงสร้าง
      เบื้องหลังให้ตรงไปตรงมาที่สุด ทั้งการต่อ API แท้ยิงตรงจากคลังเกมหลักสากล และระบบการเงินที่จบงานในไม่กี่วินาที หน้านี้เขียนไว้ให้อ่านก่อนตัดสินใจว่าเราเป็นใคร คัดเกมด้วยเกณฑ์อะไร และยึดอะไรเป็นมาตรฐานตอนจ่ายเงินคืนสมาชิก
    </p>
  </ContentBox>

  <ContentBox title="เว็บตรงสล็อตพรีเมียม API แท้ ไม่ผ่านเอเย่นต์ ค่า RTP ตรงตามสเปกโรงงานผู้พัฒนา" as="h2">
    <p class="text-left text-base leading-relaxed">
      คำถามที่สายปั่นถามกันบ่อยที่สุดคือ อัตราจ่ายที่เห็นอยู่บนหน้าเกมเป็นตัวเดียวกับที่ค่ายผู้พัฒนาตั้งไว้จริงหรือเปล่า คำตอบของคำถามนี้ไม่ได้อยู่ที่ดวง แต่อยู่ที่โครงสร้างของเว็บที่คุณเล่นอยู่
      เพราะทุกครั้งที่มีเอเย่นต์ยืนคั่นระหว่างผู้เล่นกับคลังเกม ก็เท่ากับมีชั้นที่แก้ค่าได้เพิ่มขึ้นมาอีกชั้นโดยปริยาย VIPSAND356 จึงเลือกเป็น<strong>
        เว็บตรงที่เชื่อม API แท้ยิงตรงจากคลังเกมหลักสากลตั้งแต่วันแรก
      </strong>
      ไม่ผ่านคนกลาง ค่า RTP ที่คุณเล่นจึงตรงตามสเปกโรงงานของผู้พัฒนา ไร้การดัดแปลงระบบและไม่ล็อกยูสไม่ว่ากรณีใด ชนะเท่าไหร่การันตีถอนได้เต็มทุกยอด สิ่งที่เราถือว่าเป็นหน้าที่ของเราคือทำให้ตัวเลขที่คุณเห็นบนหน้าเกม
      เป็นตัวเลขเดียวกับที่คุณถอนออกไปได้จริง โดยไม่ต้องเชื่อคำโฆษณาของใครเลยแม้แต่ของเราเอง
    </p>
  </ContentBox>

  <ContentBox title="คัดเกมเด็ดจาก PG Soft, Pragmatic Play และ Joker Gaming มาไว้ในกระเป๋าเดียว" as="h2">
    <p class="text-left text-base leading-relaxed">
      เกณฑ์การคัดเกมของเราเริ่มจากที่มาของตัวเกมก่อนเป็นอันดับแรก ทุกเกมในคลังมาจาก<strong>ค่ายเกมชั้นนำระดับโลกอย่าง PG Soft, Pragmatic Play, Joker Gaming และอีกมากมาย</strong>
      ผ่านการวัดอัตราการจ่ายเงินรางวัลมาแล้วว่าตรงตามมาตรฐานโรงงานของผู้พัฒนา ปั่นด้วยเบทเล็กหรือเบทใหญ่ก็มีสิทธิ์ลุ้นแตกหนักเท่ากันทุกรอบ ถัดจากที่มาคือความหลากหลาย เราคัดให้ครบทุกแนว ทั้งสล็อตวิดีโอ 3D
      ภาพสวยสมจริง สล็อตคลาสสิกตัวคูณหนัก และสล็อตสายซื้อฟรีสปิน สลับเปลี่ยนแนวการปั่นเมื่อไหร่ก็เจอลูกเล่นคนละแบบให้ลุ้น ทั้ง <strong>
        Multiplier สะสมตัวคูณทวีคูณ Expanding Wild ยืดเต็มรีล คอมโบแตกต่อเนื่อง Cascading และโหมด Bonus Buy
      </strong>
      สำหรับคนที่อยากพุ่งตรงเข้าลุ้นรอบแจ็คพอตทันทีไม่ต้องรอ ทั้งหมดนี้อยู่บน<strong>ระบบกระเป๋าเดียว</strong> ข้ามค่ายได้ทันทีโดยไม่ต้องเสียเวลาโยกเงินและไม่ต้องสลับแอปให้ขาดจังหวะ
    </p>
  </ContentBox>

  <ContentBox title="ระบบออโต้เสร็จใน 3 วินาที กับบริการระดับ VIP ตลอด 24 ชั่วโมง" as="h2">
    <p class="text-left text-base leading-relaxed">
      งานการเงินเป็นงานที่เราตัดสินใจยกให้ระบบทำแทนคนทั้งหมด เพราะช่วงรออนุมัติคือจุดที่จังหวะการเล่นขาดบ่อยที่สุด VIPSAND356 วาง<strong>ระบบออโต้ไฮสปีดที่ทำรายการผ่าน Gateway ตรง</strong> ไว้แทน ตัดขั้นตอนการรออนุมัติและการส่งสลิปออกทั้งหมด
      รองรับทุกช่องทางการเงิน ฝากถอนเสร็จสรรพภายใน 3 วินาที เครดิตอัปเดตเข้าเกมไว ถอนเงินกำไรเด้งเข้าบัญชีทันใจ ฝั่งสิทธิประโยชน์เราอัปเดตโปรน่าตามเข้าระบบต่อเนื่อง ให้ <strong>
        กดรับเองผ่านหน้าเว็บได้เรื่อย ๆ
      </strong> ทั้งโบนัสต้อนรับสมาชิกใหม่ โปรฝากแรกของวัน และระบบคืนยอดเสีย Cash Back ทุกวัน เงื่อนไขเขียนไว้ให้อ่านจบก่อนกดและไม่ติดเทิร์นโอเวอร์ซับซ้อน ส่วนเรื่องที่เหลือทั้งหมดเรายกให้คน <strong>
        ทีมงานแอดมินมืออาชีพสแตนด์บายตลอด 24 ชั่วโมง
      </strong> ดูแลครบตั้งแต่ขั้นตอนสมัคร การรับโปรโมชัน จนถึงการแนะนำระบบการใช้งาน บนมาตรฐานการบริการระดับ VIP สุดท้ายสิ่งที่ยังเป็นของผู้เล่นล้วน ๆ และเราอยากให้ถือติดตัวไว้คือ ผลของแต่ละรอบเป็นอิสระจากกันเสมอ
      การตั้งงบให้พอดีกับทุนของวันนั้นและหยุดเมื่อถึงขีดที่ตั้งไว้ ยังเป็นเรื่องสำคัญที่สุดไม่ว่าเว็บที่เล่นอยู่จะดีแค่ไหน
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
