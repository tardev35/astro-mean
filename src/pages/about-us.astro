---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long.
const pageDescription =
  "รู้จัก KUMI99 สล็อตออนไลน์ตัวท็อปที่คัดค่ายเด็ดเข้าไม่พัก อัปเดตเกมใหม่มาแรงไม่หยุด โบนัสโคตรคุ้ม ระบบไวเกินต้าน และฝากถอนไวภายใน 3 วิ ผ่านระบบออโต้ทุกอุปกรณ์";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ KUMI99 สล็อตออนไลน์ตัวท็อปที่ครบทั้งเกมและประสบการณ์",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา KUMI99 สล็อตออนไลน์ตัวท็อป คัดค่ายเด็ดไม่หยุด" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ KUMI99 สล็อตออนไลน์ตัวท็อปที่ครบทั้งเกมและประสบการณ์" as="h1">
    <div>
      <h2 class="mb-6 bg-gradient-to-r from-[#ffe98a] via-[#fcda3d] to-[#a9760d] bg-clip-text text-2xl leading-normal font-bold text-transparent">KUMI99 คือพื้นที่รวมสล็อตมาแรงที่ตั้งใจทำมาเพื่อสายปั่น</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        KUMI99 คือสล็อตออนไลน์ตัวท็อปที่ตั้งใจมอบประสบการณ์สุดพิเศษให้ผู้เล่นทุกวัน เราจัดเต็มด้วยเกมใหม่มาแรงที่คัดสรรมาเพื่อสายปั่นโดยเฉพาะ ใครที่ชอบความท้าทายจะพบว่าที่นี่คือพื้นที่รวมสล็อตมาแรงที่ตอบโจทย์ที่สุด เพราะเราอัปเดตระบบสม่ำเสมอเพื่อให้มั่นใจว่าคุณจะได้รับสิ่งที่ดีที่สุด และเมื่อล็อกอินเข้ามาก็จะมีเกมใหม่ให้ค้นหาอยู่ตลอดเวลา
        ไม่ว่าจะเป็นแนวแอคชันผจญภัยหรือสไตล์คลาสสิกสุดฮิต เราดึงตรงจากค่ายผู้พัฒนาชื่อดังเพื่อให้คุณได้สัมผัสก่อนใคร กราฟิกจัดเต็มอลังการพร้อมเสียงเอฟเฟกต์สมจริงช่วยให้การเล่นของคุณมีสีสัน และไม่ต้องกลัวเบื่อเพราะเราเตรียมตัวเลือกมากมายไว้รอคุณเสมอ
      </p>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#ffe98a] via-[#fcda3d] to-[#a9760d] bg-clip-text text-2xl leading-normal font-bold text-transparent">คัดค่ายเด็ดเข้าไม่พัก โบนัสโคตรคุ้ม และลูกเล่นที่ชวนให้ลุ้นทุกการหมุน</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        เราตั้งใจสร้างมาตรฐานใหม่ด้วยการคัดค่ายเด็ดเข้าไม่พักอัปเดตไม่หยุด เพื่อให้ทุกคนได้เลือกเล่นอย่างจุใจ ทีมงานคอยติดตามกระแสและนำเข้าตัวเลือกฮิตจากทั่วโลกมาเสิร์ฟถึงมือคุณ การันตีว่าความสนุกในแต่ละวันก็ไม่เคยซ้ำเดิม คุณสามารถสลับเปลี่ยนสไตล์ไปได้เรื่อย ๆ ตามอารมณ์ ค้นหารูปแบบที่ตรงใจได้อย่างอิสระ ฟีเจอร์แตกง่ายจัดเต็มทุกเกมให้คุณลุ้นรางวัลใหญ่ได้ต่อเนื่อง
        ความพิเศษของการเข้ามาปั่นสล็อตที่นี่คือผลตอบแทนที่คุณจะได้รับ เพราะไม่ใช่แค่โบนัสโคตรคุ้มที่เราเตรียมไว้แจกแบบไม่อั้น แต่ยังมีลูกเล่นในเกมที่ชวนให้ลุ้นทุกการหมุน ไม่ว่าจะเป็นฟีเจอร์ตัวคูณรอบฟรีสปินที่ออกบ่อย หรือสัญลักษณ์พิเศษที่ช่วยเพิ่มโอกาสรับรางวัลใหญ่ ทุกฟังก์ชันถูกออกแบบมาเพื่อเพิ่มสีสันและความเร้าใจ
      </p>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#ffe98a] via-[#fcda3d] to-[#a9760d] bg-clip-text text-2xl leading-normal font-bold text-transparent">ฝากถอนไวภายใน 3 วิ กับระบบไวเกินต้านที่รองรับทุกอุปกรณ์</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        ลืมการรอคอยที่แสนน่าเบื่อไปได้เลย เพราะเราให้ความสำคัญกับระบบทำรายการที่ทันสมัยที่สุด คุณจะได้สัมผัสประสบการณ์ฝากถอนไวภายใน 3 วิ ผ่านระบบออโต้ที่แม่นยำและปลอดภัย ยอดเงินอัปเดตเข้ากระเป๋าทันทีไม่ต้องแจ้งสลิป เมื่อได้โบนัสก้อนโตก็สามารถถอนออกไปใช้ได้จริงทันใจ ทำให้ไม่มีจังหวะให้เสียอารมณ์เล่นต่อแบบลื่น ๆ เป็นบริการทางการเงินที่ KUMI99 พัฒนาขึ้นมาเพื่อตอบสนองไลฟ์สไตล์ของคนยุคใหม่
        ส่วนปัญหาเกมค้างหรือโหลดช้าก็จะไม่มารบกวนจิตใจคุณอีกต่อไป เพราะเราใช้เทคโนโลยีเซิร์ฟเวอร์ขั้นสูง ทำให้ระบบไวเกินต้านรองรับผู้ใช้งานจำนวนมากได้พร้อมกัน คุณจึงเล่นต่อเนื่องปั่นได้สุดฟีลอย่างอิสระ ไม่ว่าจะเข้าใช้งานจากอุปกรณ์ไหน ทั้งสมาร์ทโฟน แท็บเล็ต หรือคอมพิวเตอร์ หน้าเว็บก็ปรับสัดส่วนให้พอดีกับหน้าจอโดยอัตโนมัติ
      </p>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#ffe98a] via-[#fcda3d] to-[#a9760d] bg-clip-text text-2xl leading-normal font-bold text-transparent">เหตุผลที่หลายคนเลือกอยู่กับ KUMI99</h2>

      <p class="text-left text-base leading-relaxed">
        หากสงสัยว่าทำไมที่นี่ถึงได้รับความนิยม เหตุผลที่หลายคนมองว่า KUMI99 คือสล็อตออนไลน์ตัวท็อปที่ครบทั้งเกมและประสบการณ์ เป็นเพราะเราใส่ใจในทุกรายละเอียด ตั้งแต่การคัดเลือกสล็อตลิขสิทธิ์แท้ ระบบฝากถอนที่รวดเร็วทันใจ ไปจนถึงการบริการลูกค้าที่พร้อมดูแลตลอดเวลา ทุกองค์ประกอบถูกสร้างขึ้นมาเพื่อให้คุณสนุกกับการปั่นได้อย่างสบายใจที่สุด การันตีคุณภาพด้วยเสียงตอบรับจากผู้ใช้งานจริง นี่คือจุดหมายปลายทางที่สายสปินไม่ควรพลาดเด็ดขาด
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
