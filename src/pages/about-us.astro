---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// HAPPYSUPERWIN: ticker หมุนมาเป็น Announcement5 ส่วนกล่องหน้าย่อยยังเป็น ContentBox
// (การ์ดถาวรของหน้าย่อย) เรียก <Announcement /> เปล่า ๆ เพราะ default message ของ
// variant นี้ถูกตั้งให้ตรงกับที่หน้าแรกส่งเข้าไปแล้ว
// สีเน้นในย่อหน้าใช้เหลืองลูกกวาด #ffd83d กับบานเย็นสว่าง #ff5ae6 ของพาเลตต์รอบนี้
// (ไม่ใช้องุ่นเข้ม #4c0d6b หรือบานเย็นเข้ม #8a1f9e กับตัวอักษรขนาดเนื้อความ เพราะ
// คอนทราสต์บนผิว #280747 ของการ์ดตกลงมาใต้เกณฑ์ AA — สองสีที่เลือกไว้ผ่านสบาย)
// ส่วนสีเนื้อความมาจากการ์ดเอง ไม่ต้องระบุซ้ำ
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 154.
const pageDescription =
  "รู้จัก HAPPYSUPERWIN สล็อตรวมตัวจี๊ด เว็บตรง API แท้ ยิงตรงจากเซิร์ฟเวอร์นอก ค่า RTP มาตรฐานสากล ไม่ปรับลดอัตราแตก โบนัสฟรีกดรับเอง ฝากถอนออโต้ใน 3 วินาที";

const pageTitle = "เกี่ยวกับเรา HAPPYSUPERWIN | สล็อตรวมตัวจี๊ด เว็บตรง API แท้ ไม่ปรับลดอัตราแตก";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา HAPPYSUPERWIN";

// docx รอบนี้ไม่มีส่วน SUB-PAGES จึงไม่มีบอดี้สำเร็จรูปให้หน้านี้ — หัวข้อและ
// ย่อหน้าทั้งแปดบล็อกด้านล่างเขียนขึ้นใหม่จากข้อเท็จจริงของแบรนด์ในบรีฟรอบนี้
// (เว็บตรง API แท้ ยิงตรงจากเซิร์ฟนอก ไม่ผ่านเอเย่นต์ · ค่า RTP มาตรฐานสากล
// ไม่มีปรับลดอัตราแตก · คัดเฉพาะสล็อตตัวจี๊ดแตกง่ายที่จ่ายสูงและโบนัสแตกบ่อย
// เบทเริ่มต้นเบา ๆ แต่ลุ้นแจ็คพอตก้อนโตได้ · ค่ายชั้นนำ PG Soft, Pragmatic Play,
// Joker Gaming ครบทั้งสล็อต 3D ตัวคูณทวีคูณ สายซื้อฟีเจอร์ฟรีสปิน และคลาสสิก
// แตกไว อยู่ในกระเป๋าเดียวไม่ต้องโยกเงิน · เติมเกมใหม่เข้าล็อบบี้ทันทีที่ค่าย
// ปล่อยไฟล์ออกจากสตูดิโอ · ฟีเจอร์ Cascading / Multiplier / Wild ซ้อนทับ ·
// โบนัสฟรีกดรับเองผ่านแดชบอร์ด ทั้งเพิ่มทุนสปิน เครดิตฟรี และคืนยอดเสีย Cash
// Back ไม่ต้องรอแอดมิน · ฝากถอนออโต้เสร็จใน 3 วินาที ถอนเต็มยอด ไร้เงื่อนไข
// จุกจิก · โครงสร้างหลังบ้านเชื่อมตรงเซิร์ฟเวอร์หลัก เกมใหม่เข้าทุกสัปดาห์)
// — ไม่ลอกย่อหน้าในบรีฟมาทั้งดุ้น เพราะย่อหน้าชุดนั้นใช้เต็ม ๆ อยู่บนหน้าแรกแล้ว
// หัวข้อจึงตั้งคนละสำนวนกับ h2 ของหน้าแรกด้วย โครงเป็น h1×1 + h2×7 ไม่มี h3
// และห้ามเติมข้อเท็จจริงที่บรีฟไม่ได้ให้ เช่น เลขใบอนุญาต จำนวนผู้เล่น รางวัล
// ชื่อธนาคาร หรือตัวเลขเวลาทำรายการที่บรีฟไม่ได้ระบุไว้
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="text-left text-base leading-relaxed">
      <strong class="text-[#ffd83d]">HAPPYSUPERWIN</strong> เริ่มจากข้อสังเกตง่าย ๆ ว่าคนที่ตั้งใจมานั่งปั่นสล็อตควรมีเรื่องให้ลุ้นแค่เรื่องเดียว คือรอบถัดไปจะเข้าฟีเจอร์หรือไม่
      ไม่ใช่ต้องแบ่งใจไปลุ้นด้วยว่าเว็บที่นั่งอยู่ทำตามที่ประกาศไว้จริงหรือเปล่า หรือต้องไล่สุ่มเปิดเกมทีละตัวกว่าจะเจอตัวที่น่าเล่น
      เราจึงวางเว็บนี้เป็นเว็บสล็อตรวมตัวจี๊ด ที่คัดเฉพาะเกมแตกง่ายจากค่ายใหญ่มาไว้ให้แล้ว เชื่อมต่อแบบเว็บตรง API แท้ ยิงสัญญาณตรงจากเซิร์ฟเวอร์นอก และรวมคลังเกมกับระบบการเงินไว้ในกระเป๋าเดียว
      งานที่เหลือเป็นของเราล้วน ๆ คือคัดของเด่นขึ้นล็อบบี้ เติมของใหม่ให้ทัน แล้วยกงานฝากถอนทั้งหมดให้ระบบออโต้รับไปทำแทนคน เพื่อให้เวลาของสมาชิกหมดไปกับการสปิน ไม่ใช่กับการรอ
    </p>
  </ContentBox>

  <ContentBox title="เว็บตรง API แท้ ยิงสัญญาณตรงจากเซิร์ฟเวอร์นอก ไม่มีคนกลางคั่นระหว่างทาง" as="h2">
    <p class="text-left text-base leading-relaxed">
      จุดยืนข้อแรกของเราคือระหว่างปุ่มสปินกับเซิร์ฟเวอร์ของค่ายเจ้าของเกมต้องไม่มีอะไรมาคั่น ทุกเกมในล็อบบี้เชื่อมด้วยสัญญาณ API แท้ที่ยิงตรงจากเซิร์ฟเวอร์หลักนอก
      คำสั่งจึงวิ่งไปบันทึกที่ค่ายแล้วส่งผลกลับมาตามที่ตัวสุ่มของค่ายตัดสินจริง
      <strong class="text-[#ff5ae6]">โครงสร้างที่ไม่มีเอเย่นต์คั่นกลาง</strong> แปลว่าไม่มีจุดใดเลยตลอดทางที่ใครจะเข้าไปแตะผลของสปินได้ ไม่มีชั้นกลางที่เก็บยอดไว้ก่อน และไม่มีคิวที่รอให้คนอนุมัติ
      สิ่งที่สมาชิกเห็นบนหน้าจอจึงเป็นสิ่งเดียวกับที่ระบบของค่ายบันทึกไว้ ไม่ใช่ภาพที่ถูกส่งต่อกันมาอีกทอด
    </p>
  </ContentBox>

  <ContentBox title="ค่า RTP มาตรฐานสากล ไม่มีการปรับลดอัตราแตกของเกมใดในล็อบบี้" as="h2">
    <p class="text-left text-base leading-relaxed">
      ตัวเลขที่ตัดสินว่าเกมหนึ่งคืนกลับให้ผู้เล่นเท่าไหร่คือค่า RTP และตัวเลขนั้นเป็นของค่ายผู้พัฒนา ไม่ใช่ของเรา ทุกเกมบนเว็บนี้จึงรันด้วย
      <strong class="text-[#ff5ae6]">ค่า RTP มาตรฐานสากล</strong> ที่ค่ายตั้งมาเอง เราไม่ปรับ ไม่หรี่ และไม่มีการปรับลดอัตราแตกให้สมาชิกคนหนึ่งต่างจากอีกคนในช่วงเวลาไหนทั้งสิ้น
      ผลที่ตามมาคือคนที่ปั่นหลักสิบกับคนที่ปั่นหลักหมื่นอยู่บนกลไกชุดเดียวกันเป๊ะ ๆ สิ่งที่ต่างกันได้มีแค่โบนัสและสิทธิ์ที่แต่ละคนเลือกกดรับ ไม่ใช่ตัวเกม
      และเพราะทุกอย่างวางอยู่บนตัวเลขที่ตรวจสอบได้ เราจึงไม่ต้องใช้คำว่าสูตรหรือช่วงเวลาแตกดีมาอธิบายอะไรเลย
    </p>
  </ContentBox>

  <ContentBox title="เกณฑ์คัดสล็อตตัวจี๊ดก่อนขึ้นล็อบบี้ และเหตุผลที่ไม่ปล่อยให้สุ่มเปิดเอง" as="h2">
    <p class="text-left text-base leading-relaxed">
      คลังเกมของเราผ่านการคัดกรองก่อนขึ้นล็อบบี้ทุกตัว เกณฑ์มีสามข้อและตรงไปตรงมา ข้อแรก <strong class="text-[#ff5ae6]">อัตราการจ่ายรางวัลต้องสูงและอ่านออกได้</strong> จากตารางอัตราจ่ายของเกมเอง
      ข้อสอง จังหวะโบนัสต้องแตกบ่อยพอจะเห็นได้ในรอบที่นั่งปั่นจริง และข้อสาม ต้องมีอัตราคูณสะสมสูงพอให้รอบที่แตกคุ้มกับรอบที่รอ
      ทุกเกมที่ผ่านสามข้อนี้จะถูกดันขึ้นหน้าแรกให้เห็นก่อน ส่วนเกมไร้คุณภาพที่จ่ายแบบอ่านไม่ออกว่าจ่ายมาจากอะไร เราตัดออกตั้งแต่ก่อนขึ้นหน้าเว็บ
      เหตุผลที่ทำแบบนี้ตรงไปตรงมา คือเวลาที่เสียไปกับการสุ่มเปิดเกมที่ไม่ผ่านเกณฑ์ ไม่ได้ให้อะไรกลับมาเลยนอกจากความรำคาญ เบทเริ่มต้นบนเกมที่คัดไว้แล้วเบาพอจะลองได้สบาย แต่ยังมีสิทธิ์ลุ้นแจ็คพอตก้อนโตได้เท่ากัน
    </p>
  </ContentBox>

  <ContentBox title="ค่ายชั้นนำอยู่ในกระเป๋าเดียว ตั้งแต่ PG Soft ถึง Pragmatic Play และ Joker Gaming" as="h2">
    <p class="text-left text-base leading-relaxed">
      เรารวมค่ายเกมชั้นนำระดับโลกอย่าง PG Soft, Pragmatic Play และ Joker Gaming ไว้ในที่เดียว แล้ววางทุกค่ายให้ใช้
      <strong class="text-[#ff5ae6]">กระเป๋าเดียวกัน</strong> สมาชิกจึงไม่ต้องสมัครหลายยูสเซอร์ให้จำรหัสไม่ไหว และไม่ต้องเสียเวลาโยกเงินข้ามค่ายไปมาจนสับสนว่ายอดค้างอยู่ตรงไหน
      แนวเกมที่ขนมาก็ครบหลายสไตล์ ทั้งสล็อต 3D ภาพสวยที่ตัวคูณทวีคูณหนัก สล็อตสายซื้อฟีเจอร์ฟรีสปินสำหรับคนไม่อยากรอเก็บสแกตเตอร์เอง และสล็อตคลาสสิกแตกไวที่จบรอบเร็ว
      อยากสลับฟีลกลางคืนเดียวก็กดข้ามค่ายได้ทันที ยอดคงเหลือที่เห็นบนหน้าจอคือยอดจริงที่ใช้ได้กับทุกเกมในเว็บ ไม่ใช่ยอดของค่ายใดค่ายหนึ่ง
    </p>
  </ContentBox>

  <ContentBox title="ของใหม่ไม่ปล่อยให้รอ เติมเกมเข้าล็อบบี้ทันทีที่ค่ายปล่อยไฟล์ออกจากสตูดิโอ" as="h2">
    <p class="text-left text-base leading-relaxed">
      คลังเกมที่นิ่งอยู่กับที่คือเหตุผลที่คนเล่นเบื่อเว็บ เราจึงตั้งงานเติมของใหม่ไว้เป็นงานประจำ ทันทีที่ค่ายผู้พัฒนาปล่อยไฟล์เกมออกจากสตูดิโอ เราดึงสัญญาณเกมตัวนั้นเข้ามาเติมในล็อบบี้
      แล้วส่งผ่านเกณฑ์คัดชุดเดิมก่อนดันขึ้นแถวหน้า ผลคือ <strong class="text-[#ff5ae6]">มีเกมใหม่เข้าล็อบบี้ทุกสัปดาห์</strong> ให้สมาชิกได้ลองฟีเจอร์เด็ดและอ่านจังหวะโบนัสของเกมนั้นก่อนใคร
      ข้อดีที่ตามมาไม่ใช่แค่ของใหม่ให้เล่น แต่คือการได้ทำความเข้าใจเกมตั้งแต่ยังไม่มีใครรู้ว่ามันเล่นยังไง ซึ่งเป็นจังหวะที่หายากที่สุดของเกมทุกตัว
      และเพราะของเข้าใหม่ตลอด คำว่าคลังเกมตันจึงไม่เคยเกิดขึ้นบนหน้าเว็บนี้
    </p>
  </ContentBox>

  <ContentBox title="ฟีเจอร์ยุคใหม่ที่เลือกไว้ ตั้งแต่ Cascading และ Multiplier ถึง Wild ซ้อนทับ" as="h2">
    <p class="text-left text-base leading-relaxed">
      ลูกเล่นยุคใหม่คือเหตุผลที่สล็อตสองตัวซึ่งหน้าตารีลคล้ายกันกลับให้ฟีลคนละแบบ ล็อบบี้ของเราจึงเลือกเกมที่มีฟีเจอร์เด่นชัดพอให้รู้สึกได้ตั้งแต่รอบแรกที่หมุน
      ตัวที่เจอบ่อยและเปลี่ยนเกมได้จริงมีสามกลุ่ม กลุ่มแรกคือระบบ <strong class="text-[#ff5ae6]">Cascading</strong> ที่สัญลักษณ์ชนะร่วงหายแล้วให้ตัวใหม่ไหลลงมาแทน ทำให้คอมโบแตกต่อกันได้หลายชั้นในสปินเดียว
      กลุ่มที่สองคือระบบสุ่มแจกตัวคูณ Multiplier ที่หย่อนตัวคูณหนัก ๆ ลงมาระหว่างรอบปกติโดยไม่ต้องรอโบนัส และกลุ่มที่สามคือสัญลักษณ์ Wild ซ้อนทับที่เปลี่ยนหน้ารีลทั้งแถวให้กลายเป็นไวลด์
      สามอย่างนี้คือสิ่งที่เปลี่ยนการกดสปินธรรมดาให้เป็นจังหวะลุ้นจริง ส่วนโหมดซื้อฟีเจอร์ฟรีสปินมีข้อแลกเปลี่ยนที่เราไม่ปิดบัง คือกินทุนต่อครั้งหนักกว่าการปั่นปกติหลายเท่า จึงควรดูงบของวันนั้นก่อนกด ไม่ใช่กดเพราะปุ่มมันวางอยู่ตรงนั้นพอดี
    </p>
  </ContentBox>

  <ContentBox title="โบนัสฟรีกดรับเองไม่ต้องรอแอดมิน และฝากถอนออโต้จบใน 3 วินาที" as="h2">
    <p class="text-left text-base leading-relaxed">
      ระบบการขอโปรโมชันแบบเดิมที่ต้องทักแชตไปขอสิทธิ์แล้วรอคนตอบ ถูกตัดออกทั้งหมด สมาชิกเลือกกดรับสิทธิ์เองได้จากหน้าแดชบอร์ดทันที ทั้งโบนัสเพิ่มทุนสปิน เครดิตฟรี และคืนยอดเสีย Cash Back
      ยอดเข้าเครดิตไว เงื่อนไขของแต่ละรายการเขียนไว้ชัดเจนตั้งแต่ก่อนกด และ <strong class="text-[#ff5ae6]">ถอนออกได้เต็มยอด ไร้เงื่อนไขจุกจิก</strong>
      ฝั่งการเงินก็เป็นงานที่เราเลือกให้เครื่องทำแทนคนทั้งหมด ธุรกรรมทุกรายการประมวลผลผ่านระบบออโต้และเสร็จสิ้นภายใน 3 วินาทีนับจากกดยืนยัน ยอดอัปเดตเข้าคลังเกมทันที ไม่ต้องถ่ายสลิปส่งแอดมินและไม่ต้องต่อคิวรออนุมัติ
      เบื้องหลังคือโครงสร้างหลังบ้านที่เชื่อมตรงกับเซิร์ฟเวอร์หลัก รองรับการใช้งานพร้อมกันจำนวนมากได้อย่างเสถียร การสลับค่ายเกมและการโหลดหน้าอินเทอร์เฟซจึงฉับไว ไม่ค้าง ไม่กระตุก และไม่เด้งหลุดกลางทาง
      สิ่งที่ยังต้องตรวจด้วยตัวเองเหลืออยู่สองอย่าง คือผูกชื่อบัญชีให้ตรงกับข้อมูลสมาชิกตั้งแต่ตอนสมัคร และเข้าใช้งานผ่านลิงก์ที่ตรวจชื่อเว็บไซต์แล้วเท่านั้น
      ทั้งนี้สล็อตยังเป็นเกมที่ผลของแต่ละสปินเป็นอิสระจากกันเสมอ การตั้งงบต่อสปินให้พอดีกับทุนของวันนั้นและหยุดเมื่อถึงขีดที่ตั้งไว้ ยังเป็นเรื่องสำคัญที่สุดที่เราอยากให้ถือติดตัวไว้
    </p>
