---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// SETH88: ticker หมุนมาเป็น Announcement5 ส่วนกล่องหน้าย่อยยังเป็น ContentBox
// (การ์ดถาวรของหน้าย่อย) เรียก <Announcement /> เปล่า ๆ เพราะ default message ของ
// variant นี้ถูกตั้งให้ตรงกับที่หน้าแรกส่งเข้าไปแล้ว
//
// ห้ามใส่คลาสสีลงในย่อหน้าข้างในการ์ด — ContentBox ตั้งสีเนื้อความให้แล้ว การเขียน
// สีทับตรงนี้คือการฝัง hex ของแบรนด์รอบนี้ไว้ในไฟล์ที่รีแบรนด์รอบหน้าไม่ได้เปิด
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 158, and is one
// sentence about what the page is for rather than a table of contents.
const pageDescription = "หน้าแนะนำตัวของ SETH88 สล็อตเว็บตรง API แท้ ไม่ผ่านเอเย่นต์ ว่าเราเป็นใคร คัดเกมจากค่ายไหนเข้าคลัง ดูแลค่า RTP อย่างไร และวางระบบฝากถอนออโต้ 3 วินาทีไว้แบบไหน";

const pageTitle = "เกี่ยวกับเรา SETH88 | สล็อตเว็บตรงเกมคัด API แท้ ออโต้ 3 วินาที";

// หัวข้อระดับ h1 ของหน้า แยกจากค่า title เพราะ title มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา SETH88";

// docx รอบนี้ไม่มีส่วน SUB-PAGES จึงไม่มีบอดี้สำเร็จรูปให้หน้านี้ — หัวข้อและย่อหน้า
// ด้านล่างเขียนขึ้นใหม่จากข้อเท็จจริงของแบรนด์ในบรีฟรอบนี้ (เว็บตรง API แท้ ยิงตรง
// จากเซิร์ฟเวอร์หลัก ไม่ผ่านเอเย่นต์ · RTP มาตรฐานสากลจากค่ายแม่ ไม่ปรับลดอัตราแตก
// ไม่ล็อกยูส · เกมคัดเกรด A-List กระเป๋าเดียว · ค่าย PG Soft, Pragmatic Play,
// Joker Gaming · ลูกเล่น Multiplier / Expanding Wild / ซื้อฟรีสปิน · โบนัสต้อนรับ
// สมาชิกใหม่ / โปรฝากแรกของวัน / Cash Back ทุกวัน ไม่ติดเทิร์นโอเวอร์มหาโหด ·
// ฝากถอนออโต้ไฮสปีด 3 วินาทีผ่าน Gateway ตรง รองรับธนาคารชั้นนำและ TrueMoney Wallet
// ไม่ต้องส่งสลิป · ถอนเต็มจำนวน · SSL · ตรวจสอบประวัติการทำรายการเรียลไทม์)
// — ไม่ลอกย่อหน้าในบรีฟมาทั้งดุ้น เพราะย่อหน้าชุดนั้นใช้เต็ม ๆ อยู่บนหน้าแรกแล้ว
// หน้านี้จึงเขียนคนละสำนวนในมุม "เราเป็นใคร" จากข้อเท็จจริงชุดเดียวกัน โครงเป็น
// h1×1 + h2×3 ไม่มี h3 และห้ามเติมข้อเท็จจริงที่บรีฟไม่ได้ให้ เช่น เลขใบอนุญาต
// จำนวนสมาชิก รางวัล ทุนสำรอง ชื่อธนาคารเจาะจง หรือฝั่งหวย/คาสิโนสด/กีฬา —
// บรีฟรอบนี้เป็นเว็บสล็อตล้วน
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="text-left text-base leading-relaxed">
      SETH88 ตั้งต้นจากข้อสังเกตเดียวว่าล็อบบี้สล็อตส่วนใหญ่ยัดเกมมาให้มากจนหาเกมที่อยากเล่นไม่เจอ กว่าจะได้กดหมุนจริงก็เสียเวลาไถหาไปครึ่งค่อนรอบ เราจึงเลือกทำสวนทาง คือ<strong>คัดให้น้อยลงแต่ให้ดีขึ้น</strong>
      ตัดเกมคุณภาพต่ำและเกมล้าหลังออกจากระบบทั้งหมด เหลือไว้เฉพาะตัวเกมเกรด A-List ที่โบนัสแตกง่ายและคุ้มค่ากับเวลาที่เสียไป จากนั้นวางโครงสร้างเบื้องหลังให้ตรงไปตรงมาที่สุด ทั้งการต่อ API แท้ยิงตรงจากเซิร์ฟเวอร์หลัก
      และระบบการเงินที่จบงานในไม่กี่วินาที หน้านี้เขียนไว้ให้อ่านก่อนตัดสินใจว่าเราเป็นใคร คัดเกมด้วยเกณฑ์อะไร และยึดอะไรเป็นมาตรฐานตอนจ่ายเงินคืนสมาชิก
    </p>
  </ContentBox>

  <ContentBox title="เว็บตรง API แท้ ไม่ผ่านเอเย่นต์ ค่า RTP มาตรฐานสากลจากค่ายแม่" as="h2">
    <p class="text-left text-base leading-relaxed">
      คำถามที่สายปั่นถามกันบ่อยที่สุดคือ อัตราจ่ายที่เห็นอยู่บนหน้าเกมเป็นตัวเดียวกับที่ค่ายผู้พัฒนาตั้งไว้จริงหรือเปล่า คำตอบของคำถามนี้ไม่ได้อยู่ที่ดวง แต่อยู่ที่โครงสร้างของเว็บที่คุณเล่นอยู่
      เพราะทุกครั้งที่มีเอเย่นต์ยืนคั่นระหว่างผู้เล่นกับเซิร์ฟเวอร์เกม ก็เท่ากับมีชั้นที่แก้ค่าได้เพิ่มขึ้นมาอีกชั้นโดยปริยาย SETH88 จึงเลือกเป็น<strong>เว็บตรงที่เชื่อม API แท้ยิงตรงจากเซิร์ฟเวอร์หลักตั้งแต่วันแรก</strong>
      ไม่ผ่านคนกลาง ค่า RTP ที่คุณเล่นจึงเป็นค่ามาตรฐานสากลที่ค่ายแม่ตั้งมา เราไม่ปรับลดอัตราแตกและไม่ล็อกยูสไม่ว่ากรณีใด ชนะเท่าไหร่ถอนออกได้เต็มจำนวนทุกบาท สิ่งที่เราถือว่าเป็นหน้าที่ของเราคือทำให้ตัวเลขที่คุณเห็นบนหน้าเกม
      เป็นตัวเลขเดียวกับที่คุณถอนออกไปได้จริง โดยไม่ต้องเชื่อคำโฆษณาของใครเลยแม้แต่ของเราเอง
    </p>
  </ContentBox>

  <ContentBox title="เกมลิขสิทธิ์แท้จาก PG Soft, Pragmatic Play และ Joker Gaming ในกระเป๋าเดียว" as="h2">
    <p class="text-left text-base leading-relaxed">
      เกณฑ์การคัดเกมของเราเริ่มจากที่มาของตัวเกมก่อนเป็นอันดับแรก ทุกเกมในคลังเป็น<strong>เกมลิขสิทธิ์แท้ที่ส่งตรงจากค่ายยักษ์ใหญ่ระดับโลก ทั้ง PG Soft, Pragmatic Play และ Joker Gaming</strong>
      ผ่านการทดสอบอัลกอริทึมการจ่ายเงินรางวัลมาแล้วว่ายุติธรรมตามมาตรฐานโรงงานของผู้พัฒนา ปั่นด้วยเบทเล็กหรือเบทใหญ่ก็มีสิทธิ์ลุ้นแตกหนักเท่ากันทุกรอบ ถัดจากที่มาคือความหลากหลายของลูกเล่น
      เราคัดให้แต่ละค่ายมีเอกลักษณ์ของตัวเองชัดเจน สลับเกมเมื่อไหร่ก็เจอฟีเจอร์คนละแบบให้ลุ้น ทั้งระบบ <strong>ตัวคูณสะสม Multiplier สัญลักษณ์ Expanding Wild ที่ขยายเต็มรีล และโหมดซื้อฟรีสปิน</strong>
      สำหรับคนที่อยากพุ่งเข้าโบนัสเลยไม่ต้องรอ ทั้งหมดนี้อยู่บนกระเป๋าเดียว ข้ามค่ายได้ทันทีโดยไม่ต้องโยกเงินและไม่ต้องสลับแอปให้เสียจังหวะ ส่วนหน้าล็อบบี้เราจัดระเบียบไว้ให้กดเข้าเกมที่ตรงกับสไตล์การเดิมพันได้ตั้งแต่วินาทีแรก
    </p>
  </ContentBox>

  <ContentBox title="ออโต้ไฮสปีด 3 วินาที กับมาตรฐานความปลอดภัยที่เราไม่ยอมลด" as="h2">
    <p class="text-left text-base leading-relaxed">
      งานการเงินเป็นงานที่เราตัดสินใจยกให้ระบบทำแทนคนทั้งหมด เพราะช่วงรอแอดมินกดอนุมัติคือจุดที่จังหวะการเล่นขาดบ่อยที่สุด SETH88 วาง<strong>ระบบฝากถอนออโต้ไฮสปีดผ่าน Gateway ตรง</strong> ไว้แทน
      รองรับทั้งสถาบันการเงินชั้นนำและ TrueMoney Wallet ทำรายการเสร็จสิ้นภายใน 3 วินาที ฝากปุ๊บเครดิตเข้าเกมปั๊บ ถอนปุ๊บเงินเด้งเข้าบัญชีทันที ไม่ต้องส่งสลิปยืนยันและไม่ต้องรอใครอนุมัติ ฝั่งสิทธิประโยชน์เราอัปเดตของใหม่เข้าระบบต่อเนื่อง
      คัดโปรที่มีของจริงมาให้ <strong>กดรับเองผ่านหน้าแดชบอร์ด</strong> ทั้งโบนัสต้อนรับสมาชิกใหม่ โปรเติมเงินฝากแรกของวัน และสิทธิ์คืนยอดเสีย Cash Back ทุกวัน เงื่อนไขเขียนไว้ให้อ่านจบก่อนกดและไม่ติดเทิร์นโอเวอร์มหาโหด
      ส่วนงานที่อยู่เบื้องหลังและไม่ค่อยมีใครพูดถึง เราเข้ารหัสปกป้องข้อมูลสมาชิกด้วยระบบ SSL และเปิดให้ตรวจสอบประวัติการทำรายการย้อนหลังแบบเรียลไทม์ สุดท้ายสิ่งที่ยังเป็นของผู้เล่นล้วน ๆ และเราอยากให้ถือติดตัวไว้คือ
      ผลของแต่ละรอบเป็นอิสระจากกันเสมอ การตั้งงบให้พอดีกับทุนของวันนั้นและหยุดเมื่อถึงขีดที่ตั้งไว้ ยังเป็นเรื่องสำคัญที่สุดไม่ว่าเว็บที่เล่นอยู่จะดีแค่ไหน
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
