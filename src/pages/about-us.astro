---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 155.
const pageDescription = "รู้จัก BOOST168 เว็บสล็อตตรงที่จัดหนักทั้งคลังเกมและฟีเจอร์ เติมเกมใหม่ตามต่อไม่ขาดช่วง มีโบนัสหลายรูปแบบ ระบบไวไม่เกินจริง และออโต้ที่จบได้เองในไม่กี่คลิก";

const pageTitle = "เกี่ยวกับ BOOST168 สล็อตเว็บตรงจัดหนัก เกมดีมีบูสต์ ระบบไวไม่เกินจริง";

// หัวข้อของหน้านี้เขียนขึ้นใหม่ในมุม "เกี่ยวกับเรา" ไม่ได้ยกย่อหน้าจาก docx
// มาซ้ำกับหน้าแรก ข้อเท็จจริงทุกข้อยังมาจากบรีฟชุดเดียวกัน
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="text-left text-base leading-relaxed">
        BOOST168 เริ่มต้นจากโจทย์ที่ฟังดูเรียบง่ายแต่ทำให้ครบยาก คือทำเว็บสล็อตตรงที่คุยน้อยกว่าที่ทำ หน้านี้ไม่ได้เขียนไว้ขายของ แต่เขียนไว้บอกว่าเรายืนอยู่บนอะไรบ้าง ตั้งแต่วิธีคัดเกมเข้าคลัง
        มุมมองที่เรามีต่อฟีเจอร์ในตัวเกม แนวคิดเรื่องโบนัสที่เลือกให้หลายรูปแบบแทนก้อนใหญ่ก้อนเดียว เหตุผลที่เราเลือกใช้คำว่าไวไม่เกินจริงแทนคำโฆษณาที่ใหญ่กว่านั้น
        ไปจนถึงขั้นตอนที่เราตั้งใจตัดออกด้วยระบบออโต้ คนที่กำลังชั่งใจอยู่ควรอ่านจบแล้วรู้ว่ากำลังคุยอยู่กับเว็บแบบไหน และตัดสินใจได้ด้วยข้อมูล ไม่ใช่ด้วยคำที่ฟังดูดีแต่ไม่มีอะไรรองรับอยู่ข้างหลัง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="คลังเกมของ BOOST168 คัดกันอย่างไร และทำไมถึงต้องเติมของใหม่เข้าตลอด" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        สิ่งที่ทำให้ผู้เล่นเบื่อเว็บหนึ่งไม่ใช่เกมไม่ดี แต่คือเปิดเข้ามาสามเดือนแล้วเห็นหน้าเดิม เราจึงถือว่าการเติมเกมใหม่เป็นงานประจำวัน ไม่ใช่กิจกรรมตามเทศกาล
        ทุกตัวที่เข้ามาอยู่ในคลังผ่านการเลือกจากทีมงานก่อนเสมอ โดยดูสามเรื่องคู่กัน คือกราฟิกที่ทำมาถึงระดับ จังหวะการจ่ายรางวัลที่ยังน่าลุ้นเมื่อปั่นยาว และความหลากหลายของแนวเกมที่คลังยังขาดอยู่ ณ
        ตอนนั้น เราจึงไม่ได้ไล่เก็บทุกเกมของทุกค่ายเข้ามากองรวมกัน แต่เลือกให้แต่ละแนวมีตัวเด่นของตัวเอง ทั้งสายสตรีทที่จังหวะเร็ว สายแฟนตาซีที่ภาพจัดเต็ม และสายคลาสสิกที่กติกาตรงไปตรงมา
        ผลที่ตั้งใจให้เกิดคือคนที่เข้ามาเปลี่ยนบรรยากาศได้ตลอดโดยไม่ต้องย้ายไปหาเว็บอื่น
      </p>
    </div>
  </ContentBox>

  <ContentBox title="นิยามคำว่าเกมดีมีบูสต์ในแบบที่เราใช้ตัดสินใจ ไม่ใช่แค่เรื่องภาพสวย" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        คำว่าบูสต์ในชื่อของเราไม่ได้หมายถึงความเร็วอย่างเดียว แต่หมายถึงลูกเล่นในตัวเกมที่ทำให้แต่ละสปินมีความหมายมากกว่าการรอสัญลักษณ์เรียงกันเฉย ๆ เวลาเราดูว่าเกมหนึ่งควรอยู่ในคลังไหม
        สิ่งที่เปิดดูก่อนคือมันมีฟีเจอร์อะไรให้ผู้เล่นได้ลุ้นเพิ่มบ้าง เช่นการสุ่มคูณเงินรางวัลที่เข้ามาเปลี่ยนหน้าตาของรอบนั้นทันที ระบบรีสปินที่ล็อกสัญลักษณ์ค้างไว้ให้ต่อยอดในรอบถัดไป
        หรือโหมดฟรีสปินที่เข้าถึงได้จริงโดยไม่ต้องรอทั้งวัน ภาพสวยเป็นเรื่องดีและเราให้ค่ากับมัน แต่ภาพสวยอย่างเดียวสนุกได้ไม่กี่สิบรอบ ส่วนเกมที่มีฟีเจอร์รองรับจะยังชวนให้กดต่ออีกครั้งเสมอ
        นั่นคือเส้นที่เราใช้แยกว่าเกมไหนได้ไปต่อและเกมไหนไม่ผ่าน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="มุมมองเรื่องโบนัส ทำไมเราเลือกให้หลายรูปแบบแทนก้อนใหญ่ก้อนเดียว" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        โบนัสก้อนเดียวที่ตัวเลขใหญ่ที่สุดมักดูดีบนแบนเนอร์ แต่พอเอาเข้าจริงมักเหมาะกับคนกลุ่มเดียวเท่านั้น เราจึงเลือกกระจายสิทธิ์ออกเป็นหลายรูปแบบให้เลือกหยิบตามสไตล์การเล่นแทน
        คนที่เพิ่งเข้ามาครั้งแรกมีชุดต้อนรับของตัวเอง คนที่เล่นสม่ำเสมอมีโบนัสเติมเงินรายวันไว้ต่อทุน และมีกิจกรรมพิเศษหมุนเวียนคืนกำไรให้ผู้เล่นเป็นระยะ เจตนาของทุกสิทธิ์เหมือนกันหมด
        คือช่วยยืดเวลาที่อยู่ในเกมให้นานขึ้นโดยไม่ต้องเพิ่มทุน เพราะจำนวนรอบที่ได้ปั่นคือสิ่งที่เปิดโอกาสให้เจอฟีเจอร์และแจ็คพอต และเพราะแต่ละรายการคิดจากยอดคนละชุดและมีเงื่อนไขของตัวเอง
        เราจึงเขียนรายละเอียดไว้บนแบนเนอร์ของแต่ละโปรตรง ๆ ให้อ่านจบก่อนกดรับ ไม่ต้องไปตามหาตัวหนังสือเล็ก ๆ ที่ไหน
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ทำไมเราเลือกคำว่าไวไม่เกินจริง แทนคำโฆษณาที่ใหญ่กว่านั้น" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        คำเคลมเรื่องความเร็วเป็นสิ่งที่วงการนี้พูดกันจนแทบไม่มีใครเชื่อแล้ว เราจึงเลือกคำที่ตรวจสอบได้ด้วยการเปิดใช้งานจริงแทนคำที่ฟังแล้วน่าตื่นเต้นกว่า สิ่งที่ยืนยันได้คือหน้าเว็บโหลดขึ้นเร็ว
        กดเข้าเกมแล้วเข้าได้เลยโดยไม่มีหน้าจอดำมาคั่น และการเชื่อมต่อกับค่ายเกมหลักทำงานนิ่งพอที่จะไม่กระตุกหรือหลุดกลางรอบโบนัส งานส่วนนี้อยู่หลังบ้านทั้งหมดและไม่มีใครเห็น
        แต่เป็นส่วนที่ทีมเฝ้าดูทุกวัน โดยเฉพาะช่วงเวลาที่มีคนเข้าใช้งานพร้อมกันเยอะที่สุด เพราะเว็บไหนก็ลื่นได้ตอนคนน้อย ความไวที่มีให้เห็นเฉพาะตอนเว็บว่างไม่ใช่ความไว แต่เป็นความบังเอิญ
        และเราไม่คิดว่าผู้เล่นควรต้องมาลุ้นเรื่องนี้เพิ่มอีกเรื่องหนึ่ง
      </p>
    </div>
  </ContentBox>

  <ContentBox title="ระบบออโต้คือส่วนที่เราตัดขั้นตอนออกมากที่สุด ไม่ใช่ส่วนที่ใส่เพิ่มมากที่สุด" as="h2">
    <div>
      <p class="text-left text-base leading-relaxed">
        เวลาพูดถึงระบบออโต้ หลายคนนึกถึงฟังก์ชันที่เพิ่มเข้ามา แต่สำหรับเรามันคือรายการของสิ่งที่ถูกเอาออก ตั้งแต่การส่งสลิป การรอแอดมินกดอนุมัติ ไปจนถึงการทักไปขอรับโปรทีละครั้ง
        ทุกอย่างตั้งแต่สมัครสมาชิก กดรับโปรโมชัน จนถึงฝากและถอน ถูกย้ายมาให้ผู้เล่นจัดการเองผ่านหน้าเว็บได้ในไม่กี่คลิก รวดเร็ว แม่นยำ และตรวจย้อนได้ด้วยตัวเอง
        เหตุผลที่เราให้ความสำคัญกับเรื่องนี้มากไม่ใช่เรื่องต้นทุนของทีม แต่เพราะจุดที่ต้องรอคนอีกฝั่งกดอนุมัติคือจุดเดียวที่ทำให้ความเร็วทั้งหมดที่สร้างมาหายไปหมด
        เมนูของเราจึงสั้นกว่าที่หลายคนคาดไว้ตอนเปิดเข้ามาครั้งแรก และเราตั้งใจให้มันสั้นแบบนั้น เพราะทุกขั้นตอนที่เพิ่มเข้ามาคือหนึ่งจังหวะที่ผู้เล่นต้องหยุดคิดโดยไม่จำเป็น
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
