---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

// GEN4: ticker กลับไปเป็น AnnouncementCyber ให้ตรงกับทั้งเว็บ เรียก <Announcement />
// เปล่าๆ เพราะ default message ของ variant นี้เป็นข้อความ GEN4 อยู่แล้ว
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 154.
const pageDescription =
  "เกี่ยวกับเรา GEN4 สล็อตเจนใหม่มีของ รวมเกมลิขสิทธิ์แท้จากค่ายชั้นนำไว้ในคลังเดียว ระบบอัปเดตใหม่โหลดไวไม่สะดุด ฝากถอนออโต้ 24 ชั่วโมง ไม่ต้องส่งสลิปยืนยัน";

const pageTitle = "เกี่ยวกับเรา GEN4 | สล็อตเจนใหม่ เกมลิขสิทธิ์แท้ ระบบอัปเดตใหม่";

// หัวข้อ <h1> ของหน้า แยกจาก <title> เพราะ <title> มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา GEN4";

// docx รอบนี้ไม่มีส่วน SUB-PAGES จึงไม่มีบอดี้สำเร็จรูปให้หน้านี้ — หัวข้อและ
// ย่อหน้าทั้งเจ็ดบล็อกด้านล่างเขียนขึ้นใหม่จากข้อเท็จจริงของแบรนด์ใน
// src/assets/content.txt (เกมลิขสิทธิ์แท้จากค่ายชั้นนำ คลังเกมใหญ่ที่อัปเดต
// ต่อเนื่อง เซิร์ฟเวอร์และซอฟต์แวร์หลังบ้านที่อัปเกรดใหม่ทั้งชุด การตัดขั้นตอน
// ระหว่างเลือกเกมกับหน้าสปิน และฝากถอนออโต้ 24 ชั่วโมงที่ไม่ต้องส่งสลิปและไม่ต้อง
// รอแอดมินอนุมัติ) — ไม่ลอกย่อหน้าใน docx มาทั้งดุ้น เพราะย่อหน้าชุดนั้นใช้เต็ม ๆ
// อยู่บนหน้าแรกแล้ว โครงยังเป็น h1×1 + h2×6 เท่าเดิม
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="text-left text-base leading-relaxed">
      GEN4 คือแพลตฟอร์มสล็อตออนไลน์ที่ตั้งต้นจากคำถามเดียวว่า อะไรบ้างที่ทำให้คนเล่นต้องรอโดยไม่จำเป็น แล้วไล่ตัดสิ่งนั้นออกทีละอย่าง ตั้งแต่หน้าเว็บที่โหลดช้า ขั้นตอนกลางระหว่างล็อบบี้กับหน้าสปิน ไปจนถึงงานการเงินที่ต้องส่งสลิปแล้วนั่งรอคนกดอนุมัติ
      สิ่งที่เราลงแรงจริงจังจึงมีอยู่สามเรื่อง คือคลังเกมลิขสิทธิ์แท้จากค่ายชั้นนำที่อัปเดตต่อเนื่อง โครงสร้างระบบที่อัปเกรดใหม่ให้ประมวลผลได้ไวและนิ่ง และระบบฝากถอนออโต้ที่ปิดงานให้จบภายในไม่กี่วินาทีตลอด 24 ชั่วโมง
    </p>
  </ContentBox>

  <ContentBox title="แนวคิดตั้งต้นของ GEN4 ทำไมเราถึงเรียกตัวเองว่าสล็อตเจนใหม่" as="h2">
    <p class="text-left text-base leading-relaxed">
      คำว่าเจนใหม่ในชื่อแบรนด์ไม่ได้หมายถึงหน้าตาเว็บที่เพิ่งทำใหม่ แต่หมายถึงการรื้อโครงสร้างเบื้องหลังทั้งชุดให้รองรับพฤติกรรมของนักเดิมพันยุคปัจจุบัน ซึ่งเปิดเกมจากมือถือเป็นหลัก สลับค่ายบ่อย และเลิกเล่นทันทีถ้าต้องรอนานเกินไป
      เราจึงวัดตัวเองด้วยสิ่งที่ผู้เล่นรู้สึกได้จริง ทั้งเวลาที่ใช้ตั้งแต่คลิกจนภาพเกมขึ้น จำนวนขั้นตอนกว่าจะถึงปุ่มหมุน และเวลาที่ยอดเงินวิ่งเข้าบัญชีหลังกดถอน มากกว่าจะวัดด้วยจำนวนเกมในล็อบบี้เพียงอย่างเดียว
    </p>
  </ContentBox>

  <ContentBox title="เกมลิขสิทธิ์แท้จากค่ายชั้นนำ คือข้อกำหนดแรกที่เราไม่ลด" as="h2">
    <p class="text-left text-base leading-relaxed">
      ทุกเกมที่ขึ้นล็อบบี้ของ GEN4 เชื่อมตรงมาจากค่ายเกมสล็อตยักษ์ใหญ่ระดับโลกในรูปแบบลิขสิทธิ์แท้ ไม่ผ่านการดัดแปลงโปรแกรมใดๆ ระหว่างทาง อัตราการจ่ายที่แสดงบนหน้าเกมจึงเป็นสเปกจริงของค่ายนั้น ไม่ใช่ตัวเลขที่ถูกปรับใหม่ก่อนถึงมือคุณ
      ข้อดีที่ตามมาคือเกมเดียวกันให้ประสบการณ์เดียวกันกับที่คุณเคยเล่นจากที่อื่น ทั้งกลไกฟีเจอร์ ตารางการจ่าย และเงื่อนไขการเข้าโบนัส เราจึงไม่ต้องอธิบายว่าเกมที่นี่ต่างจากต้นฉบับตรงไหน เพราะมันไม่ต่าง
    </p>
  </ContentBox>

  <ContentBox title="คลังเกมขนาดใหญ่ที่เติมของสดตลอด ไม่ปล่อยให้ล็อบบี้ตกยุค" as="h2">
    <p class="text-left text-base leading-relaxed">
      คลังเกมของเราออกแบบมาให้ครอบคลุมหลายจริตในที่เดียว ทั้งสายที่ชอบงานภาพกราฟิก 3D สุดอลังการ สายที่ตามหาเกมฮิตระดับตำนานซึ่งขึ้นชื่อเรื่องแจ็คพอตแตกง่าย และสายที่ชอบกลไกเกมแปลกใหม่นอกกระแสที่มีอัตราคูณโบนัสสูงและฟีเจอร์เด็ดซ่อนอยู่
      ทีมงานคอยอัปเดตไลน์อัปเกมใหม่เข้าระบบอย่างต่อเนื่อง ค่ายดังเปิดตัวเกมไหนหรือมีเกมตัวไหนกำลังมาแรง หน้าเกมของเราจะมีให้ลองเป็นกลุ่มแรกๆ เสมอ ผู้เล่นจึงกระจายความเสี่ยงและสลับบรรยากาศการทำกำไรได้อิสระโดยไม่ต้องเปิดหลายเว็บ
    </p>
  </ContentBox>

  <ContentBox title="เซิร์ฟเวอร์และซอฟต์แวร์หลังบ้านที่อัปเกรดใหม่ทั้งชุด" as="h2">
    <p class="text-left text-base leading-relaxed">
      จุดเปลี่ยนสำคัญที่ทำให้ GEN4 ต่างจากระบบทั่วไปคือการอัปเกรดเซิร์ฟเวอร์และซอฟต์แวร์หลังบ้านใหม่ทั้งหมด ระยะเวลาโหลดหน้าเว็บและหน้าเกมจึงสั้นลงอย่างเห็นได้ชัด การเปลี่ยนค่ายเกม สลับเมนู หรือกดเลือกโหมดต่างๆ ทำได้ลื่นไหลในจังหวะเดียว
      ที่สำคัญกว่าคือความนิ่งตอนคนใช้งานพร้อมกันเยอะ ระบบรองรับสมาชิกจำนวนมากพร้อมกันได้สบายโดยไม่มีอาการหน่วงหรือกระตุกมาขัดจังหวะสำคัญ ซึ่งเป็นเรื่องที่ไม่มีใครสังเกตตอนสมัคร แต่เป็นเหตุผลที่ทำให้อยู่กับเว็บได้ยาวๆ
    </p>
  </ContentBox>

  <ContentBox title="จากล็อบบี้ถึงหน้าสปิน เราตัดจังหวะรอระหว่างทางออกให้หมด" as="h2">
    <p class="text-left text-base leading-relaxed">
      ประสบการณ์การใช้งานของ GEN4 ถูกดีไซน์มาเพื่อความคล่องตัวเป็นหลัก ระบบตัดขั้นตอนเปลี่ยนผ่านที่ยุ่งยากออกไปทั้งหมด ตั้งแต่คลิกเลือกเกมในล็อบบี้ ตัวระบบจะพาพุ่งตรงเข้าหน้าสปินและพร้อมให้เริ่มหมุนวงล้อได้ในไม่กี่วินาที
      เมนูสำคัญอย่างปุ่มฝากถอน คลังเกม ค่ายเกม และหน้ากิจกรรม ถูกวางตำแหน่งไว้เป็นระเบียบให้กดหยิบใช้ได้ทันที ไม่ต้องคลิกวนหาหลายชั้น ทั้งนี้สล็อตเป็นเกมที่ผลลัพธ์สุ่มทุกรอบ ความคล่องตัวช่วยรักษาจังหวะสนุก แต่การตั้งงบต่อสปินให้พอดีกับทุนของวันนั้นยังสำคัญที่สุด
    </p>
  </ContentBox>

  <ContentBox title="ฝากถอนออโต้ 24 ชั่วโมง กับความรับผิดชอบที่มาคู่กัน" as="h2">
    <p class="text-left text-base leading-relaxed">
      ระบบฝากถอนออโต้ของ GEN4 พร้อมจัดการธุรกรรมให้ตลอด 24 ชั่วโมง ดำเนินการเสร็จผ่านหน้าเว็บในไม่กี่วินาที ยอดเงินอัปเดตเข้าบัญชีทันทีโดยไม่ต้องส่งสลิปยืนยันและไม่ต้องนั่งรอแอดมินกดอนุมัติ คุณจึงบริหารเงินทุนและถอนกำไรออกไปใช้ได้ตั้งแต่ต้นจนจบ
      สิ่งที่มาคู่กับความเร็วคือเรื่องที่ยังต้องตรวจด้วยตัวเอง ทั้งการผูกชื่อบัญชีธนาคารให้ตรงกับข้อมูลสมาชิก การอ่านเงื่อนไขและรอบเวลาของโปรโมชั่นแต่ละรายการก่อนกดรับ และการเข้าใช้งานผ่านทางเข้าลิงก์ตรงที่ตรวจชื่อเว็บไซต์แล้วเท่านั้น
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
