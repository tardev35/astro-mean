---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 158.
const pageDescription =
  "เกี่ยวกับ FUSIONNEW สล็อตเจนใหม่ที่ฟิวชั่นเกมดีจากค่ายชั้นนำไว้ในเว็บเดียว จับเกมฮิตชนเกมใหม่สลับฟีลได้ไม่เบื่อ ระบบไวไม่มีดรอป พร้อมโบนัสและฟีเจอร์แจกทุกวัน";

const pageTitle = "เกี่ยวกับ FUSIONNEW สล็อตเจนใหม่ ฟิวชั่นเกมดีทุกค่ายไว้ในเว็บเดียว";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

const headingClass = "mt-8 mb-6 bg-gradient-to-r from-[#d9dde3] via-[#ff5f52] to-[#e01a1a] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed">
        FUSIONNEW เริ่มต้นจากความคิดง่าย ๆ ว่าคนเล่นสล็อตยุคนี้ไม่ได้อยากได้แค่ปุ่มหมุนที่กดได้ แต่อยากได้เว็บที่รวมของดีเอาไว้ให้ครบตั้งแต่แรก
        เราจึงวางตัวเองเป็นเว็บสล็อตเจนใหม่ที่จับเกมคุณภาพจากหลายค่ายมาไว้ในหน้าเดียว ปรับระบบให้ลื่นตั้งแต่หน้าล็อบบี้ไปจนถึงจังหวะสปิน
        และถือเรื่องอัปเดตเกมกับโบนัสเป็นงานประจำ ไม่ใช่กิจกรรมที่จัดกันตามเทศกาล ใครเคยเจอเว็บโหลดช้า หมุนแล้วกระตุก หรือเกมค้างกลางรอบโบนัส
        น่าจะเข้าใจได้ทันทีว่าทำไมเราถึงให้น้ำหนักกับเรื่องพวกนี้เป็นพิเศษ
      </p>

      <h2 class={headingClass}>ฟิวชั่นในแบบของ FUSIONNEW คือการคัดเกมดีจากหลายค่ายมาไว้ที่เดียว</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        คำว่าฟิวชั่นที่เราหยิบมาใช้ ไม่ได้แปลว่ายัดทุกอย่างเข้ามาให้เยอะไว้ก่อน แต่หมายถึงการคัดเกมที่เล่นสนุกจริงจากค่ายชั้นนำหลายเจ้ามาวางเรียงไว้ด้วยกันอย่างมีจังหวะ
        ผู้เล่นจึงได้เจอทั้งกราฟิกระดับอลังการ เอฟเฟกต์เสียงที่ทำมาเต็ม และธีมเกมที่ไม่ซ้ำกัน ตั้งแต่สายผจญภัยและแฟนตาซี ไปจนถึงสล็อตคลาสสิกที่กติกาตรงไปตรงมา
        ทุกตัวที่เลือกเข้ามาต้องผ่านเกณฑ์เดียวกันคือเล่นง่าย เข้าใจไว และสร้างความตื่นเต้นได้ตั้งแต่สปินแรกโดยไม่ต้องอ่านคู่มือยาวเป็นหน้า
      </p>

      <h2 class={headingClass}>จับเกมฮิตชนเกมใหม่ ให้สลับฟีลได้โดยไม่ต้องย้ายเว็บไปมา</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        เราเข้าใจดีว่าคนสายสปินเบื่อง่าย เล่นเกมเดิมซ้ำ ๆ ไม่กี่วันก็เริ่มเฉา การจัดหมวดหมู่บนเว็บจึงตั้งใจให้เกมฮิตระดับตำนานอยู่ใกล้กับเกมที่เพิ่งเข้าระบบ
        อยากเปลี่ยนอารมณ์ตอนไหนก็กดเลือกได้จบในหน้าเดียว ไม่ต้องเปิดหลายเว็บสลับไปมาให้เสียจังหวะและเสียเวลาไปกับการล็อกอินใหม่
        ความหลากสไตล์ตรงนี้คือเหตุผลที่หลายคนเข้ามาลองแล้วอยู่ยาว และมักจะชวนเพื่อนเข้ามาเล่นด้วยกันต่อโดยที่เราไม่ต้องตามไปบอก
      </p>

      <h2 class={headingClass}>ระบบไวไม่มีดรอป และการอัปเดตที่ไม่ได้จบตั้งแต่วันเปิดตัว</h2>

      <p class="text-left text-base leading-relaxed">
        ความเร็วกับความเสถียรเป็นงานหลักที่เราดูแลเองทุกวัน ระบบฝากถอนอัตโนมัติทำรายการจบไว ส่วนตัวเกมก็วางระบบมาให้รองรับช่วงเวลาที่มีคนเข้าใช้งานพร้อมกันหนาแน่น
        จังหวะสปินจึงต่อเนื่อง ไม่มีหลุดกลางคันให้เสียอารมณ์ตอนกำลังลุ้นรอบโบนัสหรือไล่คอมโบอยู่ และเมื่อค่ายดังปล่อยเกมใหม่ออกมา เราจะเปิดให้เข้าไปตามได้ทันที
        ไม่ต้องรอคิว ไม่ต้องรอระบบอนุมัตินาน คู่ไปกับกิจกรรมและโบนัสที่หมุนเวียนแจกให้ตามทุกวัน เพื่อให้ทุกครั้งที่เปิดเว็บเข้ามามีอะไรให้ลุ้นเสมอ
        ทั้งหมดนี้คือสิ่งที่เราหมายถึงเวลาบอกว่า FUSIONNEW จบครบในเว็บเดียวแบบเจนใหม่ของจริง
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
