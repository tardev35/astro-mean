---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 160.
const pageDescription =
  "รู้จัก FLASH789 สล็อตเว็บตรงมาแรง คัดเกมคุณภาพแตกง่ายจากค่ายดังระดับโลกครบทุกแนว ระบบไวทุกคลิก เล่นลื่นทุกสปินทุกอุปกรณ์ อัปเดตเกมใหม่ต่อเนื่อง โบนัสคุ้มตลอดวัน";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ FLASH789 สล็อตเว็บตรงมาแรง เกมดีทุกตา ระบบไวทุกคลิก โบนัสคุ้ม",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

const headingClass = "mt-8 mb-6 bg-gradient-to-r from-[#ff2b2b] via-[#c1121f] to-[#ffc531] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="เกี่ยวกับเรา FLASH789 สล็อตเว็บตรงมาแรง เกมดีทุกตา ระบบไวทุกคลิก โบนัสคุ้ม" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ FLASH789 สล็อตเว็บตรงมาแรง เกมดีทุกตา ระบบไวทุกคลิก โบนัสคุ้ม" as="h1">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed text-[#f7ddd8]">
        FLASH789 คือสล็อตเว็บตรงที่กำลังมาแรงสุดๆ ในตอนนี้ และเกิดขึ้นจากความตั้งใจง่ายๆ ว่าคนที่เข้ามาปั่นควรได้เจอแต่เกมคุณภาพ ไม่ต้องเสียเวลาไล่งมเองทีละหน้า
        เราจึงคัดมาเน้นๆ เฉพาะเกมที่แตกง่าย ลุ้นสนุกได้ทุกตา แล้ววางไว้บนระบบหลังบ้านที่อัปเกรดมาใหม่ กดปุ๊บมาปั๊บ ไวทุกคลิกไม่มีสะดุด
        และที่ขาดไม่ได้คือโบนัสกับโปรโมชันที่จัดเต็ม คุ้มค่าทุกยอดฝากตั้งแต่ครั้งแรกที่เข้ามาเล่น จนกลายเป็นเว็บประจำที่หลายคนบอกต่อกันปากต่อปาก
      </p>

      <h2 class={headingClass}>ยกขบวนเกมดีจากค่ายดังระดับโลก ครบทุกแนวที่คุณชอบ</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f7ddd8]">
        ไม่ต้องกลัวเบื่อ เพราะ FLASH789 ยกขบวนเกมสล็อตจากค่ายดังระดับโลกมาไว้ที่นี่ที่เดียว ไม่ว่าคุณจะเป็นสายชอบภาพสวยฟีลผจญภัย สายมินิมอลที่ชอบอะไรเรียบง่ายอ่านง่าย
        หรือสายซื้อฟรีสปินที่อยากลุ้นรอบใหญ่ไปเลย ก็มีให้เลือกครบทุกแนว การันตีว่าเกมดีทุกตา โบนัสเข้าบ่อย เล่นเพลินจนลืมเวลาไปเลย
        แถมเรายังขยันอัปเดตเกมใหม่ๆ เข้ามาตลอดเวลา อะไรฮิต อะไรกำลังเป็นกระแส สมาชิกที่นี่รับรองว่าได้เล่นก่อนใคร สนุกกับการค้นหาเกมโปรดใหม่ๆ ได้แบบไม่มีจุดอิ่มตัว
      </p>

      <h2 class={headingClass}>ระบบไวทุกคลิก เซิร์ฟเวอร์เสถียร โบนัสคุ้มโปรเด็ดตลอดวัน</h2>

      <p class="text-left text-base leading-relaxed text-[#f7ddd8]">
        ใครที่เคยหงุดหงิดกับเว็บค้างๆ หมุนแล้วกระตุก บอกเลยว่าปัญหานั้นจะหมดไป ระบบของ FLASH789 ถูกพัฒนามาให้ตอบสนองไวทุกคลิก ลื่นไหลทุกการสปิน
        จะเข้าเล่นผ่านมือถือรุ่นไหนหรือคอมพิวเตอร์ก็รองรับหมด เซิร์ฟเวอร์แรงและเสถียรมาก ออกแบบมาเพื่อรองรับคนเล่นพร้อมกันเยอะๆ โดยเฉพาะ
        จึงไม่มีอาการเว็บค้างตอนโบนัสกำลังจะเข้า ฟีลลิงตอนกดสปินคือสมูทสุดๆ ตอบสนองไวทันใจ และเมื่อบวกกับโปรโมชันเด็ดๆ ที่จัดไว้รอต้อนรับสมาชิกตลอดทั้งวัน
        ทั้งโบนัสต้อนรับและโปรฝากตามช่วงเวลา ก็ยิ่งเพิ่มทุนให้คุณไปลุยต่อได้ยาวๆ ทำให้ทุกการสปินน่าตื่นเต้นและคุ้มค่ายิ่งกว่าที่เคย
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
