---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// BLACKJACK789: ticker หมุนมาเป็น Announcement5 ส่วนกล่องหน้าย่อยยังเป็น ContentBox
// (การ์ดถาวรของหน้าย่อย) เรียก <Announcement /> เปล่า ๆ เพราะ default message ของ
// variant นี้ถูกตั้งให้ตรงกับที่หน้าแรกส่งเข้าไปแล้ว
// สีย้ายจากทองอำพันออกส้มคู่โครเมียมเงินของแบรนด์ก่อน มาเป็นทองแอนทีคอมน้ำผึ้ง
// คู่กราไฟต์บนดำสนิท — เน้นข้อความด้วยทองสว่าง #f2cf70 ทองหลัก #d3aa4b และ
// กราไฟต์สว่าง #cfd6e0 (ไม่ใช้ทองเข้ม #5c4113 หรือขอบ #3a2a11 กับตัวอักษรขนาด
// เนื้อความ เพราะคอนทราสต์บนผิว #100b05 ของการ์ดตกลงมาใต้เกณฑ์ AA — สามสีที่
// เลือกไว้ผ่านสบาย) ส่วนสีเนื้อความมาจากการ์ดเอง ไม่ต้องระบุซ้ำ
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 157.
const pageDescription =
  "รู้จัก BLACKJACK789 สล็อตเว็บตรง API แท้ ยิงตรงจากเซิร์ฟเวอร์หลัก ไม่ผ่านเอเย่นต์ ค่า RTP ตรงตามสเปกโรงงาน ไร้ประวัติล็อกยูส พร้อมฝากถอนออโต้เสร็จใน 3 วินาที";

const pageTitle = "เกี่ยวกับเรา BLACKJACK789 | สล็อตเว็บตรง API แท้ ไม่ผ่านเอเย่นต์ ออโต้ 3 วินาที";

// หัวข้อระดับ h1 ของหน้า แยกจากค่า title เพราะ title มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา BLACKJACK789";

// docx รอบนี้ไม่มีส่วน SUB-PAGES จึงไม่มีบอดี้สำเร็จรูปให้หน้านี้ — หัวข้อและ
// ย่อหน้าทั้งหกบล็อกด้านล่างเขียนขึ้นใหม่จากข้อเท็จจริงของแบรนด์ในบรีฟรอบนี้
// (เว็บตรง API แท้ ยิงตรงจากเซิร์ฟเวอร์หลัก ไม่ผ่านเอเย่นต์ ไร้ประวัติล็อกยูส ·
// ค่า RTP มาตรฐานยุติธรรมตรงตามสเปกโรงงาน ไม่มีปรับลดเปอร์เซ็นต์ชนะ · คลังเกม
// คัดมามีเชิงชั้น ไม่อัดเกมขยะ เน้นโครงสร้างการจ่ายรางวัลโปร่งใส · ดึงสัญญาณ
// เกมลิขสิทธิ์แท้จากค่าย A-List ทั้ง PG Soft, Pragmatic Play และ Joker Gaming ·
// ฟีเจอร์ Multipliers, Expanding Wild, Cascading และ Bonus Buy · หมวดสล็อต 3D
// สายสตรีตตัวคูณโหด และคลาสสิกไลน์จ่ายน้อยแต่แตกหนัก บนกระเป๋าเงินเดียว ·
// โบนัสต้อนรับ โปรฝากแรกของวัน และ Cash Back คืนยอดเสียทุกวัน กดรับเองผ่าน
// แดชบอร์ด ไม่ติดเทิร์นโอเวอร์มหาโหด · เซิร์ฟเวอร์ความเร็วสูง ฝากถอนออโต้ผ่าน
// Gateway ตรง เสร็จใน 3 วินาที ไม่ต้องส่งสลิป ถอนกำไรได้เต็มทุกยอด)
// — ไม่ลอกย่อหน้าในบรีฟมาทั้งดุ้น เพราะย่อหน้าชุดนั้นใช้เต็ม ๆ อยู่บนหน้าแรกแล้ว
// หน้านี้จึงเขียนคนละสำนวนจากข้อเท็จจริงชุดเดียวกัน โครงเป็น h1×1 + h2×5 ไม่มี h3
// และห้ามเติมข้อเท็จจริงที่บรีฟไม่ได้ให้ เช่น เลขใบอนุญาต จำนวนผู้เล่น รางวัล
// ชื่อธนาคาร ค่ายที่บรีฟไม่ได้เอ่ยชื่อ หรือโต๊ะคาสิโนสด — บรีฟรอบนี้เป็นสล็อต
// ล้วน ไม่มีฝั่งไลฟ์คาสิโน บล็อกโต๊ะสดของแบรนด์ก่อนจึงถูกถอดออกทั้งบล็อก
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="text-left text-base leading-relaxed">
      <strong class="text-[#f2cf70]">BLACKJACK789</strong> เปิดขึ้นมาด้วยโจทย์ข้อเดียวว่า ถ้าตัดทุกอย่างที่ผู้เล่นไม่ควรต้องมานั่งคิดออกไป จะเหลืออะไรค้างอยู่บนหน้าจอบ้าง
      คำตอบที่เราได้คือควรเหลือแค่ตัวเกมกับรอบถัดไป ไม่ใช่คำถามว่าสัญญาณที่กำลังเล่นอยู่ผ่านมือใครมาก่อน ไม่ใช่การนั่งรอคนกดอนุมัติยอด และไม่ใช่การไล่เปิดเกมทีละตัวเพื่อเดาว่าตัวไหนพอเล่นได้
      เว็บนี้จึงถูกวางเป็นสล็อตเว็บตรงที่ยิงสัญญาณตรงจากเซิร์ฟเวอร์หลักของค่ายเจ้าของเกม รวมทุกค่ายไว้ในบัญชีเดียว แล้วยกงานฝากถอนทั้งหมดให้ระบบออโต้รับไปทำแทนคน
      สิ่งที่เราถือว่าเป็นงานของเราคือคัดของขึ้นฟลอร์ให้มีเชิงชั้น ดูแลทางเดินระหว่างปุ่มกับเซิร์ฟเวอร์ให้สั้นที่สุด และเขียนเงื่อนไขทุกข้อให้อ่านจบได้ก่อนกด ส่วนที่เหลือเป็นของผู้เล่นล้วน ๆ
    </p>
  </ContentBox>

  <ContentBox title="เว็บตรง API แท้ ยิงตรงจากเซิร์ฟเวอร์หลัก ไม่ผ่านเอเย่นต์และไร้ประวัติล็อกยูส" as="h2">
    <p class="text-left text-base leading-relaxed">
      ข้อแรกที่ตัดสินใจกันไว้ตั้งแต่ก่อนเปิดคือ ระหว่างปุ่มที่ผู้เล่นกดกับเซิร์ฟเวอร์ของค่ายเจ้าของเกมจะต้องไม่มีใครมายืนคั่น ทุกเกมบนฟลอร์นี้เชื่อมด้วย
      <strong class="text-[#d3aa4b]">สัญญาณ API แท้ที่ยิงตรงจากเซิร์ฟเวอร์หลัก</strong> คำสั่งจึงวิ่งไปบันทึกที่ค่ายแล้วส่งผลกลับมาตามที่ตัวสุ่มของค่ายตัดสินจริง
      โครงสร้างแบบไม่ผ่านเอเย่นต์แปลว่าไม่มีชั้นกลางที่พักยอดเอาไว้ก่อน ไม่มีคิวที่ต้องรอให้ใครเคาะ และไม่มีจุดใดตลอดเส้นทางที่ใครจะเข้าไปแตะผลของรอบนั้นได้
      อีกด้านหนึ่งของเรื่องเดียวกันคือเรา<strong class="text-[#cfd6e0]">ไร้ประวัติล็อกยูส</strong> ไม่มีการหรี่บัญชีใดให้ต่างจากบัญชีอื่น เพราะระบบไม่ได้ถูกออกแบบให้ทำแบบนั้นได้ตั้งแต่ต้น
    </p>
  </ContentBox>

  <ContentBox title="ค่า RTP มาตรฐานยุติธรรมตรงตามสเปกโรงงาน ไม่มีปรับลดเปอร์เซ็นต์ชนะ" as="h2">
    <p class="text-left text-base leading-relaxed">
      ตัวเลขที่บอกว่าเกมหนึ่งคืนกลับให้ผู้เล่นเท่าไหร่คือค่า RTP และตัวเลขนั้นเป็นของค่ายผู้พัฒนา ไม่ใช่ของเว็บ ทุกเกมที่เปิดอยู่บนฟลอร์นี้จึงรันด้วย
      <strong class="text-[#d3aa4b]">ค่า RTP ที่ตรงตามสเปกโรงงาน</strong> ไม่มีการปรับลดเปอร์เซ็นต์ชนะลงจากที่ค่ายตั้งมาเอง
      ผลที่ตามมาตรงไปตรงมา คือคนที่เบทเริ่มต้นหลักบาทกับคนที่ปรับยอดขึ้นสูงยืนอยู่บนกลไกชุดเดียวกันเป๊ะ ๆ สิ่งที่ต่างกันได้มีแค่โปรที่แต่ละคนเลือกกดรับ ไม่ใช่ตัวเกม
      และเพราะทุกอย่างวางอยู่บนตัวเลขที่ค่ายประกาศไว้แล้ว เราจึงไม่มีเหตุผลจะต้องพูดถึงสูตร ช่วงเวลาแตกดี หรืออะไรทำนองนั้นเลยสักคำเดียว
    </p>
  </ContentBox>

  <ContentBox title="คัดค่ายดังเกมแท้เน้นคุณภาพ ไม่ได้วัดกันที่จำนวนเกม" as="h2">
    <p class="text-left text-base leading-relaxed">
      แทนที่จะกวาดทุกค่ายที่เชื่อมได้เข้ามาให้ดูเยอะไว้ก่อนจนรกหน้าเว็บ เราเลือกเปิดเฉพาะเกมสล็อตลิขสิทธิ์แท้จากค่ายยักษ์ใหญ่ระดับ A-List ที่ทำได้ดีจริงในแนวของตัวเอง ทั้ง
      <strong class="text-[#d3aa4b]">PG Soft, Pragmatic Play และ Joker Gaming</strong> โดยดึงสัญญาณเข้าระบบโดยตรง ไม่ผ่านตัวกลาง
      เกณฑ์ที่ใช้คัดคือโครงสร้างการจ่ายรางวัลต้องอ่านออกและโปร่งใส ผ่านการทดสอบอัตราจ่ายมาตามมาตรฐานผู้พัฒนา ผู้เล่นจึงวางแผนเดินเงินได้ว่าเกมตัวนี้เหมาะกับทุนเท่าไหร่
      คลังเกมถูกจัดเป็นหมวดหมู่ตั้งแต่ต้นและมีฟิลเตอร์ให้กรองทั้งตามค่ายและตามประเภทเกม คนที่รู้อยู่แล้วว่าจะเล่นอะไรจึงพุ่งตรงเข้าเกมนั้นได้ทันทีโดยไม่ต้องเลื่อนหาทีละแถว
      ที่สำคัญกว่าจำนวนเกมคือทุกตัวบนฟลอร์นี้เป็นของแท้จากค่ายเจ้าของเกม กราฟิกคมชัดระดับ HD ลื่นไหลทุกการสปิน ไม่ใช่เกมเลียนแบบที่หน้าตาคล้ายกันแต่กลไกข้างในเป็นคนละเรื่อง
    </p>
  </ContentBox>

  <ContentBox title="หลายแนวบนกระเป๋าเดียว กับฟีเจอร์ที่เราเลือกให้อยู่ในเกมแต่ละหมวด" as="h2">
    <p class="text-left text-base leading-relaxed">
      คนเบื่อเกมเดิมไม่ได้เบื่อเพราะเกมไม่ดี แต่เบื่อเพราะไม่มีอะไรให้เปลี่ยน เราจึงเปิดหมวดหมู่ให้ครบทุกสไตล์การเล่น ทั้ง
      <strong class="text-[#f2cf70]">สล็อต 3D</strong> ที่เนื้อเรื่องเข้มข้นและภาพจัดเต็ม <strong class="text-[#f2cf70]">สล็อตสายสตรีต</strong> ที่เน้นตัวคูณโหด
      และ <strong class="text-[#f2cf70]">สล็อตแนวคลาสสิก</strong> ที่ไลน์จ่ายน้อยแต่แตกหนักและอ่านออกตั้งแต่ตาแรก ทั้งหมดวางอยู่บน<strong class="text-[#cfd6e0]">กระเป๋าเงินเดียว</strong> สลับฟีลได้ทันทีโดยไม่ต้องเสียเวลาโยกเงินข้ามค่าย
      ส่วนกลไกข้างในเกม สี่อย่างที่เจอบ่อยและเปลี่ยนจังหวะการเล่นได้จริงคือ <strong class="text-[#d3aa4b]">Multipliers</strong> ที่สุ่มแจกตัวคูณทวีคูณขึ้นไประหว่างรอบ
      <strong class="text-[#d3aa4b]">Expanding Wild</strong> ที่สัญลักษณ์ขยายกินพื้นที่เต็มรีล <strong class="text-[#d3aa4b]">Cascading</strong> ที่ตัวชนะแตกแล้วให้ตัวใหม่ไหลลงมาแทนจนต่อกันได้หลายชั้นในสปินเดียว และโหมด <strong class="text-[#d3aa4b]">Bonus Buy</strong> สำหรับคนที่อยากพุ่งตรงเข้ารอบแจ็คพอตโดยไม่รอเก็บสแกตเตอร์เอง
      ข้อแลกเปลี่ยนของโหมดซื้อฟรีสปินเราไม่ปิดบัง คือกินทุนต่อครั้งหนักกว่าการปั่นปกติหลายเท่า จึงควรดูงบของวันนั้นก่อนกด ไม่ใช่กดเพราะปุ่มมันวางอยู่ตรงนั้นพอดี
    </p>
  </ContentBox>

  <ContentBox title="โปรที่กดรับเองได้ และระบบออโต้ 3 วินาทีที่ถอนได้เต็มทุกยอด" as="h2">
    <p class="text-left text-base leading-relaxed">
      โปรโมชั่นบนเว็บนี้เขียนเงื่อนไขไว้ให้อ่านจบก่อนกด ไม่ใช่หลังกด รายการที่เติมสิทธิ์เข้าระบบต่อเนื่องมีทั้งโบนัสต้อนรับเพิ่มทุนสปิน โปรฝากแรกของวัน และ
      <strong class="text-[#d3aa4b]">Cash Back คืนยอดเสียทุกวัน</strong> ที่คำนวณยอดตรงไปตรงมาและกดรับเองได้ผ่านหน้าแดชบอร์ด ทุกรายการ<strong class="text-[#f2cf70]">ไม่ติดเทิร์นโอเวอร์มหาโหด</strong> เพราะเงื่อนไขที่ทำให้ถอนไม่ออกไม่ได้แปลว่าโปรนั้นใจกว้างขึ้น มันแค่ทำให้ตัวเลขบนแบนเนอร์ดูใหญ่ขึ้นเฉย ๆ
      ฝั่งการเงินเป็นงานที่เราเลือกให้เครื่องทำแทนคนทั้งหมด โครงสร้างเซิร์ฟเวอร์ความเร็วสูงทำให้สปินลื่นไม่ค้างไม่เด้งหลุดกลางทาง ส่วนทุกธุรกรรมเดินผ่าน <strong class="text-[#cfd6e0]">Gateway ตรง</strong> และเสร็จภายใน 3 วินาทีนับจากกดยืนยัน
      ไม่ต้องถ่ายสลิปส่งใคร ไม่ต้องรอแอดมินอนุมัติ ฝากแล้วเครดิตเด้งเข้าเกมทันที และ<strong class="text-[#d3aa4b]">ถอนกำไรได้เต็มทุกยอด</strong>ตามที่กด
      สิ่งที่ยังต้องตรวจด้วยตัวเองเหลืออยู่สองอย่าง คือผูกชื่อบัญชีให้ตรงกับข้อมูลสมาชิกตั้งแต่ตอนสมัคร และเข้าใช้งานผ่านลิงก์ที่ตรวจชื่อเว็บไซต์แล้วเท่านั้น
      ทั้งนี้ทุกเกมบนเว็บยังเป็นเกมที่ผลของแต่ละรอบเป็นอิสระจากกันเสมอ การตั้งงบให้พอดีกับทุนของวันนั้นและหยุดเมื่อถึงขีดที่ตั้งไว้ ยังเป็นเรื่องสำคัญที่สุดที่เราอยากให้ถือติดตัวไว้
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
