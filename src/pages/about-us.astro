---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 151.
const pageDescription =
  "รู้จัก LONGSAP168 เว็บสล็อตครบมือที่รวมเกมดังจากค่ายใหญ่ไว้ครบ โต๊ะสดจัดหนักภาพระดับ HD ฝากถอนออโต้ไม่ต้องส่งสลิป เล่นลื่นทุกอุปกรณ์ ปลอดภัยมาตรฐานสากล";

const pageTitle = "เกี่ยวกับ LONGSAP168 เว็บสล็อตครบมือ เกมดังค่ายจัดเต็ม โต๊ะสดจัดหนัก";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

const headingClass = "mt-8 mb-6 bg-gradient-to-r from-[#ffd76a] via-[#f2b024] to-[#a86a0c] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed">
        LONGSAP168 เกิดขึ้นมาเพื่อคนที่กำลังมองหาเว็บที่เล่นแล้วจบในที่เดียว ไม่ต้องโยกเงินไปมาและไม่ต้องเปลี่ยนเว็บให้วุ่นวาย
        เราจัดมาให้แบบจุกๆ ทั้งสายปั่นสล็อตที่ชอบเกมดังจากค่ายใหญ่ และสายลุ้นไพ่ที่ชอบโต๊ะสดแบบเรียลไทม์
        เข้ามาที่เดียวคือพร้อมลุยได้ยาวๆ ได้ฟีลเหมือนเพื่อนบอกต่อของดีที่ต้องลอง ซึ่งเป็นความรู้สึกที่เราตั้งใจทำให้เกิดขึ้นตั้งแต่หน้าแรกจนถึงตอนกดถอน
      </p>

      <h2 class={headingClass}>เกมดังค่ายจัดเต็ม เปิดทีเดียวเจอค่ายระดับโลกรออยู่เพียบ</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        พูดถึงเรื่องเกมสล็อต บอกเลยว่าเราไม่ได้มาเล่นๆ เพราะรวบรวมค่ายดังระดับโลกมาไว้เพียบ เปิดหน้าเว็บเข้ามาปุ๊บคือเจอเกมฮิตที่คุ้นเคยรออยู่ครบ
        แถมอัปเดตเกมใหม่ๆ ไวมาก ใครที่ชอบลองของใหม่หรือมีเกมลูกรักในดวงใจอยู่แล้ว มารวมกันตรงนี้ได้เลย ภาพสวย สปินลื่น แตกบ่อยจนต้องหยิบมารีวิวให้เพื่อนฟัง
        และเพราะทุกค่ายอยู่ในเว็บเดียว การสลับไปลองเกมของอีกค่ายจึงใช้แค่การกดไม่กี่ครั้ง ไม่ต้องจำหลายรหัสและไม่ต้องย้ายยอดไปมาให้เสียจังหวะ
      </p>

      <h2 class={headingClass}>โต๊ะสดจัดหนัก ภาพเกมถึงอารมณ์ พร้อมหลายโต๊ะให้เลือกตามจังหวะที่ชอบ</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        ส่วนสายคาสิโนสดก็ไม่น้อยหน้า โต๊ะสดของที่นี่จัดหนักจัดเต็มมาก ภาพคมชัดระดับ HD สตรีมมาแบบเรียลไทม์ไม่มีกระตุกให้เสียอารมณ์
        แถมมีห้องให้เลือกเข้าเพียบ ชอบดีลเลอร์คนไหน ชอบจังหวะการเดินเกมโต๊ะไหน ก็เลือกเข้าได้ตามสไตล์เลย บรรยากาศเหมือนบินไปนั่งเล่นที่คาสิโนของจริง ได้ฟีลลิ่งสุดๆ
        ใครที่อยากเปลี่ยนบรรยากาศจากการปั่นสล็อตมานั่งโต๊ะสักพัก ก็ทำได้ทันทีในเว็บเดียวโดยไม่ต้องเปิดแอปอื่นเพิ่ม
      </p>

      <h2 class={headingClass}>ฝากไวถอนคล่อง เล่นลื่นทุกอุปกรณ์ และดูแลความปลอดภัยอย่างเป็นระบบ</h2>

      <p class="text-left text-base leading-relaxed">
        เรื่องเงินๆ ทองๆ นี่สำคัญสุด ซึ่งระบบของที่นี่ทำออกมาได้ตอบโจทย์วัยรุ่นใจร้อนมาก ฝากถอนเป็นระบบออโต้ที่ไวแบบไม่ต้องแคปสลิปส่งหาแอดมินให้เมื่อยมือ
        เล่นได้ปุ๊บ กดถอนปั๊บ เงินเด้งเข้าบัญชีแทบจะทันที ไม่ต้องมารอข้ามชั่วโมงให้หงุดหงิด จังหวะกำลังดวงขึ้นก็ฝากเข้าไปลุยต่อได้แบบสมูทๆ ไม่มีสะดุด
        ด้านการใช้งานก็รองรับทุกแพลตฟอร์ม จะนอนไถจอเล่นผ่านมือถือบนเตียง หรือจะนั่งจอใหญ่จัดเต็มผ่านคอมพิวเตอร์ ก็ลื่นไหลเหมือนกัน
        หน้าเว็บออกแบบมาให้ใช้งานง่ายและปรับขนาด UI ตามหน้าจอเป๊ะๆ สลับอุปกรณ์เล่นตอนไหนฟีลก็ไม่ขาดตอน
        ปิดท้ายด้วยเรื่องที่ต้องยืนหนึ่ง คือระบบรักษาความปลอดภัยระดับมาตรฐานสากล ข้อมูลส่วนตัวและข้อมูลบัญชีถูกเก็บรักษาไว้อย่างดี
        เล่นได้อย่างสบายใจ โฟกัสกับเกมตรงหน้าได้เต็มที่โดยไม่ต้องมากังวลเรื่องระบบหลังบ้านเลย
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
