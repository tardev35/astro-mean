---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// ROSTY59: ticker หมุนมาเป็น Announcement3 ส่วนกล่องหน้าย่อยยังเป็น ContentBox
// (การ์ดถาวรของหน้าย่อย) เรียก <Announcement /> เปล่า ๆ เพราะ default message ของ
// variant นี้ถูกตั้งให้ตรงกับที่หน้าแรกส่งเข้าไปแล้ว
// สีย้ายจากทองแชมเปญราชสำนักบนดำอมน้ำตาลของแบรนด์ก่อน มาเป็นทองอำพันออกส้ม
// คู่โครเมียมเงิน — เน้นข้อความด้วยทองสว่าง #ffc94a ทองหลัก #f2a01a และเงิน #dbe1e8
// (ไม่ใช้ทองมืด #6b3f07 หรือขอบ #4a2f0d กับตัวอักษรขนาดเนื้อความ เพราะคอนทราสต์
// บนผิว #150e07 ของการ์ดตกลงมาใต้เกณฑ์ AA — สามสีที่เลือกไว้ผ่านสบาย)
// ส่วนสีเนื้อความมาจากการ์ดเอง ไม่ต้องระบุซ้ำ
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 157.
const pageDescription =
  "รู้จัก ROSTY59 สล็อตเว็บตรงสัญญาณ API แท้ เชื่อมตรงเซิร์ฟนอก ไม่ผ่านเอเย่นต์ ไร้ประวัติล็อกยูส ค่า RTP ตรงมาตรฐานสากลจากค่ายแม่ พร้อมระบบฝากถอนออโต้ 3 วินาที";

const pageTitle = "เกี่ยวกับเรา ROSTY59 | สล็อตเว็บตรง API แท้ ไม่ผ่านเอเย่นต์ ออโต้ 3 วินาที";

// หัวข้อระดับ h1 ของหน้า แยกจากค่า title เพราะ title มีขีดคั่นแบรนด์อยู่
const pageHeading = "เกี่ยวกับเรา ROSTY59";

// docx รอบนี้ไม่มีส่วน SUB-PAGES จึงไม่มีบอดี้สำเร็จรูปให้หน้านี้ — หัวข้อและ
// ย่อหน้าทั้งหกบล็อกด้านล่างเขียนขึ้นใหม่จากข้อเท็จจริงของแบรนด์ในบรีฟรอบนี้
// (เว็บตรงสัญญาณ API แท้ เชื่อมตรงเซิร์ฟนอก ไม่ผ่านเอเย่นต์ ไร้ประวัติล็อกยูส ·
// ค่า RTP ตรงตามมาตรฐานสากลจากค่ายแม่ ไม่มีปรับลดเปอร์เซ็นต์ชนะ · สถาปัตยกรรม
// หลังบ้านเน้นความเร็ว โหลดหน้าเกมไว ไร้ป๊อปอัป ไม่ค้างไม่เด้งหลุด · เกม
// ลิขสิทธิ์แท้จาก PG Soft, Pragmatic Play, Joker Gaming จัดคลังเป็นหมวดหมู่
// ค้นหาด้วยฟิลเตอร์ค่ายและประเภทเกม · หมวดวิดีโอ 3D คลาสสิก ตัวคูณหนัก และสาย
// ซื้อฟีเจอร์ บนกระเป๋าเดียวไม่ต้องโยกเงินข้ามค่าย · ฟีเจอร์ Multiplier,
// Cascading, รีลขยาย Wild และ Bonus Buy · โบนัสต้อนรับ โปรฝากแรกของวัน และ
// Cash Back คืนยอดเสีย ไม่ติดเทิร์นโอเวอร์ซับซ้อน · ฝากถอนออโต้ 3 วินาทีผ่าน
// Gateway ตรง รองรับธนาคารชั้นนำและวอลเล็ท ไม่ต้องส่งสลิป ถอนเต็มจำนวน)
// — ไม่ลอกย่อหน้าในบรีฟมาทั้งดุ้น เพราะย่อหน้าชุดนั้นใช้เต็ม ๆ อยู่บนหน้าแรกแล้ว
// หน้านี้จึงเขียนคนละสำนวนจากข้อเท็จจริงชุดเดียวกัน โครงเป็น h1×1 + h2×5 ไม่มี h3
// และห้ามเติมข้อเท็จจริงที่บรีฟไม่ได้ให้ เช่น เลขใบอนุญาต จำนวนผู้เล่น รางวัล
// ชื่อธนาคาร ค่ายที่บรีฟไม่ได้เอ่ยชื่อ หรือโต๊ะคาสิโนสด — บรีฟรอบนี้เป็นสล็อต
// ล้วน ไม่มีฝั่งไลฟ์คาสิโน บล็อกโต๊ะสดของแบรนด์ก่อนจึงถูกถอดออกทั้งบล็อก
const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="text-left text-base leading-relaxed">
      <strong class="text-[#ffc94a]">ROSTY59</strong> ตั้งต้นจากคำถามข้อเดียวว่า ถ้าตัดเรื่องที่ผู้เล่นไม่ควรต้องคิดออกไปให้หมด จะเหลืออะไรอยู่บนหน้าจอบ้าง
      คำตอบที่เราได้คือควรเหลือแค่เกมกับรอบถัดไป ไม่ใช่คำถามว่าสัญญาณที่เห็นถูกส่งผ่านมือใครมาบ้าง ไม่ใช่การรอคนกดอนุมัติ และไม่ใช่การไล่เปิดเกมทีละตัวเพื่อหาว่าตัวไหนพอเล่นได้
      เว็บนี้จึงถูกวางเป็นสล็อตเว็บตรงที่เชื่อมสัญญาณตรงกับเซิร์ฟเวอร์ของค่ายเจ้าของเกม รวมทุกค่ายไว้ในบัญชีเดียว แล้วยกงานฝากถอนทั้งหมดให้ระบบออโต้รับไปทำแทนคน
      สิ่งที่เราถือว่าเป็นงานของเราคือคัดของขึ้นฟลอร์ ดูแลให้ทางเดินระหว่างปุ่มกับเซิร์ฟเวอร์สั้นที่สุด และเขียนเงื่อนไขทุกข้อให้อ่านจบได้ก่อนกด ส่วนที่เหลือเป็นของผู้เล่นล้วน ๆ
    </p>
  </ContentBox>

  <ContentBox title="เว็บตรงสัญญาณ API แท้ เชื่อมตรงเซิร์ฟเวอร์นอก ไม่ผ่านเอเย่นต์และไร้ประวัติล็อกยูส" as="h2">
    <p class="text-left text-base leading-relaxed">
      ข้อแรกที่เราตัดสินใจไว้ตั้งแต่ก่อนเปิดคือ ระหว่างปุ่มที่ผู้เล่นกดกับเซิร์ฟเวอร์ของค่ายเจ้าของเกมจะต้องไม่มีใครมายืนคั่น ทุกเกมในฟลอร์เชื่อมด้วย
      <strong class="text-[#f2a01a]">สัญญาณ API แท้ที่ยิงตรงจากเซิร์ฟเวอร์นอก</strong> คำสั่งจึงวิ่งไปบันทึกที่ค่ายแล้วส่งผลกลับมาตามที่ตัวสุ่มของค่ายตัดสินจริง
      โครงสร้างแบบไม่ผ่านเอเย่นต์แปลว่าไม่มีชั้นกลางที่เก็บยอดไว้ก่อน ไม่มีคิวที่รอให้ใครเคาะ และไม่มีจุดใดตลอดทางที่ใครจะเข้าไปแตะผลของรอบนั้นได้
      อีกด้านหนึ่งของเรื่องเดียวกันคือเรา<strong class="text-[#dbe1e8]">ไร้ประวัติล็อกยูส</strong> ไม่มีการหรี่บัญชีใดให้ต่างจากบัญชีอื่น เพราะระบบไม่ได้ถูกออกแบบให้ทำอย่างนั้นได้ตั้งแต่ต้น
    </p>
  </ContentBox>

  <ContentBox title="ค่า RTP ตรงตามมาตรฐานสากลจากค่ายแม่ ไม่มีปรับลดเปอร์เซ็นต์ชนะ" as="h2">
    <p class="text-left text-base leading-relaxed">
      ตัวเลขที่บอกว่าเกมหนึ่งคืนกลับให้ผู้เล่นเท่าไหร่คือค่า RTP และตัวเลขนั้นเป็นของค่ายผู้พัฒนา ไม่ใช่ของเว็บ ทุกเกมที่เปิดอยู่บนฟลอร์นี้จึงรันด้วย
      <strong class="text-[#f2a01a]">ค่า RTP ตรงตามมาตรฐานสากลจากค่ายแม่</strong> ไม่มีการปรับลดเปอร์เซ็นต์ชนะลงจากที่ค่ายตั้งมาเอง
      ผลที่ตามมาตรงไปตรงมา คือคนที่ปั่นหลักสิบกับคนที่ปั่นหลักหมื่นยืนอยู่บนกลไกชุดเดียวกันเป๊ะ ๆ สิ่งที่ต่างกันได้มีแค่โปรที่แต่ละคนเลือกกดรับ ไม่ใช่ตัวเกม
      และเพราะทุกอย่างวางอยู่บนตัวเลขที่ค่ายประกาศไว้แล้ว เราจึงไม่มีเหตุผลต้องพูดถึงสูตร ช่วงเวลาแตกดี หรืออะไรทำนองนั้นเลยสักคำเดียว
    </p>
  </ContentBox>

  <ContentBox title="คลังเกมลิขสิทธิ์แท้จาก PG Soft, Pragmatic Play และ Joker Gaming" as="h2">
    <p class="text-left text-base leading-relaxed">
      แทนที่จะกวาดทุกค่ายที่เชื่อมได้เข้ามาให้ดูเยอะไว้ก่อน เราเลือกเปิดเฉพาะเกมสล็อตลิขสิทธิ์แท้จากค่ายที่ทำได้ดีจริงในแนวของตัวเอง ทั้ง
      <strong class="text-[#f2a01a]">PG Soft, Pragmatic Play และ Joker Gaming</strong> รวมถึงค่ายชั้นนำระดับโลกอีกหลายเจ้าที่ปล่อยเกมใหม่ออกมาสม่ำเสมอ
      คลังเกมถูกจัดเรียงเป็นหมวดหมู่ตั้งแต่ต้น และมีฟิลเตอร์ให้กรองทั้งตามค่ายและตามประเภทเกม คนที่รู้อยู่แล้วว่าจะเล่นอะไรจึงพุ่งตรงเข้าเกมนั้นได้ทันทีโดยไม่ต้องเลื่อนหาทีละแถว
      ที่สำคัญกว่าจำนวนเกมคือทุกตัวที่อยู่บนฟลอร์นี้เป็นของแท้จากค่ายเจ้าของเกม อัตราจ่ายเป็นไปตามที่ระบบของค่ายกำหนด ไม่ใช่เกมเลียนแบบที่หน้าตาคล้ายกันแต่กลไกข้างในเป็นคนละเรื่อง
    </p>
  </ContentBox>

  <ContentBox title="หลายหมวดบนกระเป๋าเดียว กับฟีเจอร์ที่เราเลือกให้อยู่ในเกมแต่ละแนว" as="h2">
    <p class="text-left text-base leading-relaxed">
      คนเบื่อเกมเดิมไม่ได้เบื่อเพราะเกมไม่ดี แต่เบื่อเพราะไม่มีอะไรให้เปลี่ยน เราจึงเปิดหมวดหมู่ให้ครบทุกสไตล์การเล่น ทั้ง
      <strong class="text-[#ffc94a]">สล็อตวิดีโอ 3D</strong> ที่ภาพจัดเต็ม <strong class="text-[#ffc94a]">สล็อตคลาสสิก</strong> ที่ไลน์จ่ายอ่านออกตั้งแต่ตาแรก
      <strong class="text-[#ffc94a]">สล็อตตัวคูณหนัก</strong> และ <strong class="text-[#ffc94a]">สายซื้อฟีเจอร์</strong> ที่พุ่งชนโบนัสได้เลย ทั้งหมดวางอยู่บน<strong class="text-[#dbe1e8]">กระเป๋าเงินเดียว</strong> สลับสไตล์ได้ตลอดเวลาโดยไม่ต้องเสียเวลาโยกเงินข้ามค่าย
      ส่วนกลไกข้างในเกม สี่อย่างที่เจอบ่อยและเปลี่ยนจังหวะการเล่นได้จริงคือ <strong class="text-[#f2a01a]">Multiplier</strong> ที่สะสมตัวคูณทวีคูณขึ้นไประหว่างรอบ
      <strong class="text-[#f2a01a]">Cascading</strong> ที่สัญลักษณ์ชนะแตกแล้วให้ตัวใหม่ไหลลงมาแทนจนต่อกันได้หลายชั้นในสปินเดียว <strong class="text-[#f2a01a]">รีลขยาย Wild</strong> ที่ซ้อนทับกินพื้นที่รีล และโหมด <strong class="text-[#f2a01a]">Bonus Buy</strong> สำหรับคนไม่อยากรอเก็บสแกตเตอร์เอง
      ข้อแลกเปลี่ยนของโหมดซื้อฟรีสปินเราไม่ปิดบัง คือกินทุนต่อครั้งหนักกว่าการปั่นปกติหลายเท่า จึงควรดูงบของวันนั้นก่อนกด ไม่ใช่กดเพราะปุ่มมันวางอยู่ตรงนั้นพอดี
    </p>
  </ContentBox>

  <ContentBox title="โปรที่กดรับเองได้ และระบบออโต้ 3 วินาทีที่ถอนเต็มจำนวน" as="h2">
    <p class="text-left text-base leading-relaxed">
      โปรโมชันบนเว็บนี้เขียนเงื่อนไขไว้ให้อ่านจบก่อนกด ไม่ใช่หลังกด รายการที่เติมเข้าระบบต่อเนื่องมีทั้งโบนัสต้อนรับเพิ่มทุนสปิน โปรโมชันฝากแรกของวัน และ
      <strong class="text-[#f2a01a]">Cash Back คืนยอดเสีย</strong> ที่คำนวณยอดตรงไปตรงมาและกดรับเองได้ผ่านหน้าเว็บ ทุกรายการ<strong class="text-[#ffc94a]">ไม่ติดเทิร์นโอเวอร์ซับซ้อน</strong> เพราะเงื่อนไขที่ทำให้ถอนไม่ออกไม่ได้แปลว่าโปรนั้นใจกว้างขึ้น มันแค่ทำให้ตัวเลขบนแบนเนอร์ดูใหญ่ขึ้นเฉย ๆ
      ฝั่งการเงินเป็นงานที่เราเลือกให้เครื่องทำแทนคนทั้งหมด ทุกธุรกรรมเดินผ่าน <strong class="text-[#dbe1e8]">Gateway ตรง</strong> และเสร็จภายใน 3 วินาทีนับจากกดยืนยัน รองรับทั้งธนาคารชั้นนำและวอลเล็ท
      ไม่ต้องถ่ายสลิปส่งใคร ไม่ต้องรอคิวอนุมัติ ฝากแล้วเครดิตเด้งเข้าเกมทันที และ<strong class="text-[#f2a01a]">ถอนได้เต็มจำนวน</strong>ตามยอดที่กด
      สิ่งที่ยังต้องตรวจด้วยตัวเองเหลืออยู่สองอย่าง คือผูกชื่อบัญชีให้ตรงกับข้อมูลสมาชิกตั้งแต่ตอนสมัคร และเข้าใช้งานผ่านลิงก์ที่ตรวจชื่อเว็บไซต์แล้วเท่านั้น
      ทั้งนี้ทุกเกมบนเว็บยังเป็นเกมที่ผลของแต่ละรอบเป็นอิสระจากกันเสมอ การตั้งงบให้พอดีกับทุนของวันนั้นและหยุดเมื่อถึงขีดที่ตั้งไว้ ยังเป็นเรื่องสำคัญที่สุดที่เราอยากให้ถือติดตัวไว้
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
