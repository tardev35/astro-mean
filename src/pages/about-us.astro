---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 158.
const pageDescription =
  "เกี่ยวกับ 249UP เว็บสล็อตฟอร์มตึงที่ขนค่ายเกมมาครบเครื่อง เข้าเมนูไว สลับค่ายคล่อง ฟีเจอร์มีของทั้งซื้อฟรีสปินและตัวคูณ ล็อบบี้ไม่จำเจ พร้อมระบบโอนไวเข้าบัญชี";

const pageTitle = "เกี่ยวกับ 249UP เว็บสล็อตฟอร์มตึง เกมแน่นค่ายครบเครื่องในเว็บเดียว";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

const headingClass = "mt-8 mb-6 bg-gradient-to-r from-[#ffe9a8] via-[#ffd86b] to-[#f5b626] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed">
        249UP เริ่มต้นจากความคิดง่าย ๆ ว่าคนเล่นสล็อตยุคนี้ไม่ได้อยากเสียอารมณ์กับเว็บเดิม ๆ ที่เปิดมาแล้วช้า หมุนแล้วสะดุด หรือหาเกมที่อยากเล่นไม่เจอสักที
        เราจึงวางตัวเองเป็นเว็บสล็อตที่เน้นความตึงของระบบเป็นอันดับแรก แล้วขนค่ายเกมมาให้เลือกเล่นแบบอัดแน่นในหน้าเดียว ไม่ว่าจะเป็นสายปั่นเอาสนุกหรือสายล่าแตกหนัก
        จังหวะการเล่นต้องลื่นไหลเท่ากัน และโบนัสต้องมีมาให้ตามเรื่อย ๆ ไม่ใช่แจกทีเดียวตอนเปิดตัวแล้วเงียบหายไป
      </p>

      <h2 class={headingClass}>เกมแน่นค่ายครบเครื่อง เปิดมาทีมีแต่ตัวน่าเล่น</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        เราคัดค่ายเกมชั้นนำเข้ามารวมไว้แบบครบครัน โดยเลือกเฉพาะเกมที่ขึ้นชื่อเรื่องภาพสวย แตกง่าย และมีเอกลักษณ์ของตัวเอง การเปิดหน้าเกมแต่ละครั้งจึงเต็มไปด้วยตัวเลือกที่น่าเล่นจริง
        ไม่ต้องมานั่งสุ่มเสี่ยงกับเกมไร้คุณภาพหรือเกมที่ทำมาครึ่ง ๆ กลาง ๆ ทุกค่ายที่ผ่านเข้ามาต้องพร้อมให้ผู้เล่นสัมผัสความมันส์ได้ตั้งแต่สปินแรก
        โดยไม่ต้องอ่านกติกายาวเป็นหน้าก่อนถึงจะเริ่มสนุกได้
      </p>

      <h2 class={headingClass}>เข้าเมนูไว สลับค่ายคล่อง และล็อบบี้ที่ไม่ปล่อยให้จำเจ</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        การจัดวางระบบของเราออกแบบมาให้ใช้งานง่ายและรวดเร็ว เมนูแบ่งหมวดหมู่ไว้เป็นระเบียบ อยากสลับค่ายเปลี่ยนบรรยากาศตอนไหนก็ทำได้ทันทีโดยไม่ต้องผ่านหลายขั้นตอน
        เปลี่ยนแนวจากสล็อตสายลุยไปเล่นแนวสบายตาก็จบในหน้าเดียว ประหยัดเวลาค้นหาไปโฟกัสกับการปั่นได้เต็มที่ ล็อบบี้เองก็อัปเดตรายการเกมใหม่อยู่เสมอ
        มีทั้งเกมฮิตระดับตำนานที่ทุกคนต้องเล่นติดไว้ และเกมนอกกระแสที่แจ็คพอตดีรอให้เข้าไปค้นพบ เข้ามาช่วงไหนก็มีอะไรใหม่ให้ลองเสมอ
      </p>

      <h2 class={headingClass}>ฟีเจอร์มีของ โบนัสมาไม่มีแผ่ว และระบบโอนไวเข้าบัญชีเลย</h2>

      <p class="text-left text-base leading-relaxed">
        เกมที่เราเลือกเข้ามาต้องมีลูกเล่นให้ลุ้นมากกว่าแค่นั่งมองวงล้อหมุน ทั้งระบบคูณเงินรางวัล ฟีเจอร์ซื้อฟรีสปิน และตัวคูณแบบสุ่มที่โผล่มาถูกจังหวะ
        ควบคู่ไปกับโปรโมชันและโบนัสที่เติมให้อย่างสม่ำเสมอ ตั้งแต่ก้าวแรกที่สมัครเข้ามาจนถึงการเล่นรายวัน เพื่อให้ต่อยอดการปั่นได้จริงโดยไม่ต้องใช้ทุนเยอะ
        ส่วนเรื่องการเงิน ทุกรายการฝากถอนทำได้ด้วยตัวเองแบบออโต้ เงินเข้าบัญชีตรงเป๊ะในเวลาอันสั้น ไม่ต้องนั่งรอทีมงานอนุมัตินานให้เสียอารมณ์
        เล่นได้เท่าไหร่จ่ายเต็มจำนวน ทั้งหมดนี้คือสิ่งที่เราหมายถึงเวลาบอกว่า 249UP เป็นเว็บสล็อตฟอร์มตึงที่จบครบในเว็บเดียว
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
