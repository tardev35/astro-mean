---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";

// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character, so a byte
// count reads about three times too long. This one measures 154.
const pageDescription =
  "รู้จัก PODK888 เว็บตรงเกมครบทุกสาย รวมสล็อต บาคาร่า และคาสิโนสดจากค่ายแท้ไว้ที่เดียว ระบบใหม่โอนไว ปลอดภัยทุกยอด ไม่มีประวัติโกง พร้อมแจกสูตรเล่นให้สมาชิก";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: "เกี่ยวกับ PODK888 เว็บตรงเกมครบทุกสาย คาสิโนสดพร้อมลั่น ระบบใหม่โอนไว",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

const headingClass = "mt-8 mb-6 bg-gradient-to-r from-[#f670b7] via-[#e01e83] to-[#02dbfd] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="เกี่ยวกับเรา PODK888 เว็บตรงเกมครบทุกสาย คาสิโนสดพร้อมลั่น ระบบใหม่โอนไว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เกี่ยวกับ PODK888 เว็บตรงเกมครบทุกสาย คาสิโนสดพร้อมลั่น ระบบใหม่โอนไว" as="h1">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed text-[#f3d7e7]">
        PODK888 เกิดขึ้นจากความตั้งใจง่าย ๆ ว่าคนเล่นควรจบทุกอย่างได้ในที่เดียว ไม่ต้องโยกเงินไปมา ไม่ต้องจำหลายรหัส และไม่ต้องเปิดสามเว็บเพื่อหาเกมที่อยากเล่น
        เราจึงรวบรวมเกมไว้ครบทุกสายในแพลตฟอร์มเดียว ทั้งสล็อตที่ปั่นเพลิน ๆ ระหว่างวัน บาคาร่าและไพ่สำหรับคนชอบลุ้นสั้น ๆ ไปจนถึงคาสิโนสดที่เดินรอบแบบเรียลไทม์
        ทุกอย่างอยู่ในบัญชีเดียว กระเป๋าเดียว สลับหมวดได้ทันทีโดยไม่ต้องออกจากหน้าเว็บ ภาพคมชัดไม่มีสะดุด และเล่นได้ลื่นเท่ากันทั้งบนคอมพิวเตอร์และมือถือ
      </p>

      <h2 class={headingClass}>รวมค่ายแท้ คัดเกมเด่นมาให้เลือกโดยไม่ต้องเสียเวลาหา</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f3d7e7]">
        เรื่องตัวเกมเราไม่ได้เอาปริมาณมาข่ม แต่เน้นว่าทุกค่ายที่อยู่บนเว็บเป็นค่ายแท้ที่ต่อระบบมาตรง ไม่ผ่านคนกลาง อัตราการจ่ายจึงเป็นไปตามมาตรฐานที่ค่ายตั้งไว้จริง ไม่ได้ถูกปรับลดระหว่างทาง
        ฝั่งคาสิโนสดเราคัดเฉพาะค่ายระดับโลกที่ภาพสวยและดีลเลอร์ทำงานได้ไหลลื่น ส่วนฝั่งสล็อตเราจัดหมวดหมู่เกมเด่นไว้ให้แล้ว ไม่ต้องไล่งมทีละหน้าเอง เข้ามาก็เลือกได้เลยว่าจะลุยสายไหน
        และเราอัปเดตเกมใหม่จากค่ายเข้าคลังต่อเนื่อง ไม่ใช่ตู้เกมชุดเดิมที่ค้างอยู่ตั้งแต่วันเปิดเว็บ นี่คือเหตุผลที่หลายคนบอกกันปากต่อปากว่าเกมที่นี่แตกโหดเต็มหน้ากระดานและเข้าฟีเจอร์กันรัว ๆ
      </p>

      <h2 class={headingClass}>ระบบใหม่โอนไว ปลอดภัยทุกยอด และไม่มีประวัติโกง</h2>

      <p class="text-left text-base leading-relaxed text-[#f3d7e7]">
        ปัญหาเงินเข้าช้าคือสิ่งแรกที่เราแก้ ระบบออโต้รุ่นใหม่ของ PODK888 ทำรายการฝากถอนได้ไวมาก กดปุ๊บเงินเด้งปั๊บ ไม่ว่าจะยอดหลักร้อยหรือหลักล้าน ทุกยอดวิ่งผ่านระบบเดียวกันและข้อมูลสมาชิกไม่รั่วไหลออกไปไหน
        เราเปิดให้บริการด้วยความโปร่งใส ไม่มีประวัติการโกงหรือบิดยอดแม้แต่บาทเดียว มีทีมงานสแตนด์บายดูแลตลอด ติดขัดตรงไหนทักถามได้เสมอ ตั้งแต่ก้าวแรกที่กดสมัครไปจนถึงตอนกดถอนเข้าบัญชี
        นอกจากนั้นเรายังอัปเดตสูตรเล่นและเทคนิคดี ๆ ให้สมาชิกได้อ่านเรื่อย ๆ เอาไปปรับใช้เป็นแนวทางวางแผนของตัวเอง เพราะเราอยากให้ทุกคนเล่นแบบเข้าใจเกม ไม่ใช่เดิมพันไปตามอารมณ์อย่างเดียว
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
