---
import MainLayout from "../layouts/MainLayout.astro";
import { BRAND_NAME } from "../lib/brandProfile";

// wrangler.toml declares `not_found_handling = "404-page"`, which makes
// Cloudflare serve dist/404.html for any unmatched path. That file did not
// exist, so every mistyped URL fell through to Cloudflare's own bare 404.
//
// This page stays BRAND-NEUTRAL IN ITS BODY: no brand hex, no per-brand copy
// inside <section>. The moment it hardcodes a palette it silently rots into the
// PREVIOUS brand's 404 page. Everything brand-specific a visitor sees here —
// fonts, palette, navbar, footer, background — arrives through MainLayout, so
// it rethemes itself for free on every launch.
//
// The title/description DO name the brand, because the brief writes one per
// launch — but they take it from BRAND_NAME rather than typing it, so this file
// keeps the same self-rebranding property the body has. Never hardcode the
// literal here.
//
// No pageGraph on purpose: Cloudflare serves this one file for EVERY unmatched
// path, so any node built from Astro.url would claim /404's identity while
// sitting at some other URL, and a breadcrumb to a page that does not exist is
// nonsense. The page is noindex anyway — there is nothing for structured data
// to help.
//
// noindex, follow: a 404 must never be indexed, but its links should still be
// crawled so the crawler finds its way back to the real pages.
//
// 150–160 CHARACTERS, not bytes — Thai is 3 bytes per character. This one
// measures 154 once BRAND_NAME (10 characters this round) is substituted. The
// length moves with the brand name: it read 155 on a 9-character brand and 154
// on a 4-character one, so re-count it every launch rather than assuming the
// sentence is still in the window — a 20-character brand would push it past 160.
//
// This brand's floor is licensed slots from the big studios, so the sentence
// names that and the direct entry link — not the live-dealer wording a previous
// brand had here.
const pageDescription = `ไม่พบหน้าที่คุณกำลังมองหาบน ${BRAND_NAME} อาจถูกย้ายหรือลิงก์หมดอายุ กลับไปหน้าแรกเพื่อเลือกเกมสล็อตลิขสิทธิ์แท้จากค่ายดัง หรือเข้าเว็บหลักได้ตลอด 24 ชั่วโมง`;
---

<MainLayout title={`ไม่พบหน้านี้ | ${BRAND_NAME}`} description={pageDescription} robots="noindex, follow">
  <section class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 py-20 text-center font-sans">
    <p class="text-6xl font-black tracking-widest opacity-40 md:text-8xl" aria-hidden="true">404</p>

    <h1 class="mt-4 text-2xl font-black tracking-wide md:text-3xl">ไม่พบหน้าที่ต้องการ</h1>

    <p class="mt-4 max-w-xl text-base leading-relaxed opacity-80">
      ลิงก์ที่เปิดมาอาจหมดอายุ ถูกย้ายไปที่อื่น หรือพิมพ์ที่อยู่คลาดเคลื่อนไปเพียงตัวอักษรเดียว
      เมนูทั้งหมดยังใช้งานได้ตามปกติจากด้านบนและด้านล่างของหน้านี้
    </p>

    <a
      href="/"
      class="mt-8 inline-flex items-center justify-center rounded-full border px-8 py-3 font-bold transition-transform hover:scale-105">
      กลับไปหน้าแรก
    </a>
  </section>
</MainLayout>
