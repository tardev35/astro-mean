---
// Widget, not article: the heading line is a <p> and the <section> carries the
// accessible name.
//
// JUDTEM168: rethemed off the previous brand's blue (#3b8df1 / #0a2563 /
// #0a1330 / #050b1e / #dbe7fb / #a8bcd8 / #f5c542) onto gold — #feeb33 /
// #fac42c / #e4a434 / #cc8425 / #7a4a0d over #150d04 / #1e1206 / #0a0602.
// Copy follows the docx brief.
const reviews = [
  {
    name: "สมาชิกที่เคยเจอปัญหาเว็บปลิวมาก่อน",
    role: "เซิร์ฟเวอร์หลักและลิงก์สำรองพร้อม 24 ชั่วโมง",
    stars: 5,
    tag: "ทางเข้าเสถียรที่สุด",
    content:
      "เมื่อก่อนเจอปัญหาลิงก์เสียตอนโบนัสไทม์ประจำ พอย้ายมาที่นี่หมดปัญหาไปเลย จะกดจากมือถือ iOS Android หรือคอมพิวเตอร์ก็เข้าเกมได้ลื่นไหลไม่มีสะดุด ภาพและเสียงคมชัดระดับ Full HD ไม่พลาดจังหวะแจ็คพอตแตก",
    avatar: "🔗",
  },
  {
    name: "สมาชิกที่เล่นทะลุหลักแสนแล้วกดถอน",
    role: "จ่ายเต็มจำนวน ไม่หักค่าธรรมเนียม",
    stars: 5,
    tag: "จ่ายเงินจริงทุกยอด",
    content:
      "ความโปร่งใสเรื่องการจ่ายเงินคือจุดที่ทำให้ไว้ใจ เกมเป็นลิขสิทธิ์แท้จากค่ายดังโดยตรง อัตราการชนะสูงกว่าเว็บทั่วไป เล่นได้หลักหมื่นหรือทะลุหลักล้านก็โอนจ่ายเต็มจำนวน ยอดเข้ากระเป๋าเน้นๆ ทุกบิล",
    avatar: "💰",
  },
  {
    name: "สมาชิกทุนน้อยที่เพิ่งเริ่มปั่นสล็อต",
    role: "ฝากถอนออโต้ไม่เกิน 3 วินาที ไม่มีขั้นต่ำ",
    stars: 5,
    tag: "ฝากถอนออโต้ไม่มีขั้นต่ำ",
    content:
      "ไม่ต้องส่งสลิปรอคิวแอดมินอีกแล้ว กดทำรายการเองได้ทั้งฝากและถอน ใช้เวลาประมวลผลไม่เกิน 3 วินาที ทุนน้อยแค่ 1 บาทก็ฝากเข้ามาปั่นได้สบายๆ ถอนได้ไม่อั้น ไม่จำกัดจำนวนครั้งต่อวัน",
    avatar: "⚡",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก JUDTEM168" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <div class="inline-block rounded-2xl border border-[#e4a434]/30 bg-[#150d04]/88 px-6 py-3 shadow-[0_10px_30px_rgba(250,196,44,0.18)] backdrop-blur-md">
      <p class="bg-gradient-to-r from-[#feeb33] via-[#fac42c] to-[#cc8425] bg-clip-text text-3xl font-black tracking-wide text-transparent">เสียงจากสมาชิก JUDTEM168</p>
    </div>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fac42c] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#e4a434]/30 bg-[#150d04]/88 px-6 py-4 shadow-[0_10px_30px_rgba(250,196,44,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#feeb33] to-[#cc8425] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#d8c49a]">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#7a4a0d]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fac42c]" : "text-[#7a4a0d]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#d8c49a]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#e4a434]/25 bg-[#150d04]/88 p-6 text-left shadow-[0_10px_30px_rgba(250,196,44,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#e4a434]/55 hover:shadow-[0_15px_40px_rgba(254,235,51,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#feeb33] to-[#7a4a0d] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#fac42c]/25 blur-[50px] transition-all duration-300 group-hover:bg-[#feeb33]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#e4a434]/35 bg-[#0a0602] px-3 py-1 text-[10px] font-bold tracking-wide text-[#fac42c]">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#feeb33]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#fac42c]" : "text-[#7a4a0d]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f3e3c4]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#7a4a0d] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e4a434]/35 bg-gradient-to-br from-[#feeb33] via-[#fac42c] to-[#7a4a0d] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f3e3c4] transition-colors group-hover:text-[#feeb33]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#d8c49a]">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
