---
// Widget ไม่ใช่ article: บรรทัดหัวข้อเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech
//
// TANGTEM168: ย้ายจากเขียวมังกรนีออนของ DRACO65 (#dcfce7 / #4ade80 / #22c55e /
// #15803d / #14532d / #0a3318 บนผิว #062011 / #04150a เนื้อความ #d6ecdd
// ข้อความรอง #9dbfa8 ดาวเงิน #e2e8e4) มาที่ทองบนม่วงพลัม — #ffe9a8 / #fcc30b /
// #e09a05 / #ce5a03 คู่กับม่วง #c79bf0 / #7e3ac7 / #3c0f52 บนผิว #2a0a2e /
// #1c0620 เนื้อความ #f7e6c4 ข้อความรอง #c3a98e ดาวใช้ทอง #fcc30b ซึ่งเป็นสีหลัก
// ของแบรนด์ เนื้อความเขียนใหม่ตาม brief ของแบรนด์นี้
const reviews = [
  {
    name: "คนที่ตามคำบอกต่อปากต่อปากมาลองเอง",
    role: "คอนเซปต์ตังเต็มระบบ",
    stars: 5,
    tag: "ตังเต็มระบบ",
    content: "สัมผัสได้จริงตั้งแต่ครั้งแรกที่ใช้งาน ระบบเสถียรสูง อัตราการแตกของแจ็คพอตเป็นไปอย่างตรงไปตรงมา ไม่มีการปรับลดเปอร์เซ็นต์การชนะ ทุกสปินเลยเต็มไปด้วยความหวังจริงๆ",
    avatar: "🪙",
  },
  {
    name: "สายสล็อตที่เบื่อการสลับเว็บไปมา",
    role: "เกมเด็ดครบอยู่หน้าเดียว",
    stars: 5,
    tag: "เกมเด็ดครบ",
    content: "ไม่ต้องเสียเวลาโยกเงินหรือสลับเว็บให้ยุ่งยากอีกแล้ว เกมตัวเด็ดตัวฮิตจากค่ายดังระดับโลกมารวมไว้หน้าเดียว อยากเปลี่ยนฟีลก็แค่คลิกเลือกเกมใหม่ในล็อบบี้ได้ทันที",
    avatar: "🎰",
  },
  {
    name: "คนที่ให้ความสำคัญกับความปลอดภัย",
    role: "ระบบการเงินและข้อมูลส่วนตัว",
    stars: 5,
    tag: "ปลอดภัย 100%",
    content: "ทุกขั้นตอนถูกแบ่งไว้ชัดเจน ทั้งฝาก ถอน และเช็กประวัติย้อนหลัง จัดการเองได้ผ่านหน้าเว็บ พร้อมการเข้ารหัสขั้นสูงและระบบที่เชื่อมต่อตรงกับสถาบันการเงินชั้นนำ",
    avatar: "🔐",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก TANGTEM168" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <div class="inline-block rounded-2xl border border-[#fcc30b]/35 bg-[#2a0a2e]/88 px-6 py-3 shadow-[0_10px_30px_rgba(252,195,11,0.22)] backdrop-blur-md">
      <p class="bg-gradient-to-r from-[#ffe9a8] via-[#fcc30b] to-[#c79bf0] bg-clip-text text-3xl font-black tracking-wide text-transparent">เสียงจากสมาชิก TANGTEM168</p>
    </div>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fcc30b] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#fcc30b]/35 bg-[#2a0a2e]/88 px-6 py-4 shadow-[0_10px_30px_rgba(252,195,11,0.22)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe9a8] to-[#e09a05] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#c3a98e]">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#3c0f52]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fcc30b]" : "text-[#3c0f52]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#c3a98e]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#fcc30b]/30 bg-[#2a0a2e]/88 p-6 text-left shadow-[0_10px_30px_rgba(252,195,11,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#fcc30b]/55 hover:shadow-[0_15px_40px_rgba(126,58,199,0.32)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe9a8] to-[#7e3ac7] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#7e3ac7]/45 blur-[50px] transition-all duration-300 group-hover:bg-[#fcc30b]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#fcc30b]/35 bg-[#1c0620] px-3 py-1 text-[10px] font-bold tracking-wide text-[#fcc30b]">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fcc30b]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#fcc30b]" : "text-[#3c0f52]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f7e6c4]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#3c0f52] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#fcc30b]/40 bg-gradient-to-br from-[#ffe9a8] via-[#fcc30b] to-[#e09a05] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f7e6c4] transition-colors group-hover:text-[#fcc30b]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#c3a98e]">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
