---
// Widget ไม่ใช่ article: บรรทัดหัวข้อเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech
//
// กงล้อ88: ย้ายจากทองบนม่วงพลัมของ TANGTEM168 (#ffe9a8 / #fcc30b / #e09a05 /
// #ce5a03 คู่ม่วง #c79bf0 / #7e3ac7 / #3c0f52 บนผิว #2a0a2e / #1c0620 เนื้อความ
// #f7e6c4 ข้อความรอง #c3a98e) มาที่ทองอร่ามคู่เปลวไฟ — #ffe974 / #ffcc4b /
// #eb9a1d / #8b4c0b คู่เปลวไฟ #ff6a13 / #ffa34d บนผิว #1e1105 / #140a02 /
// #2c1808 เนื้อความ #f6e6c2 ข้อความรอง #c9ab7a ดาวใช้ทอง #ffcc4b ซึ่งเป็นสีหลัก
// ของแบรนด์ เนื้อความเขียนใหม่ตาม brief ของแบรนด์นี้
const reviews = [
  {
    name: "สายปั่นที่ตามหาแหล่งทำเงินที่ไว้ใจได้",
    role: "เว็บแท้ไม่ผ่านเอเย่นต์",
    stars: 5,
    tag: "ไม่ล็อคยูส",
    content: "เข้าเล่นเกมไหนก็ไม่มีการล็อคยูสหรือปรับลดอัตราการชนะ เล่นได้เท่าไหร่รับกำไรไปเต็มๆ ไม่มีการหักเปอร์เซ็นต์ย้อนหลัง ปั้นบวกระยะยาวได้โดยไม่ต้องกังวลเรื่องโดนโกง",
    avatar: "🐉",
  },
  {
    name: "คนที่ชอบลุ้นกิจกรรมเสี่ยงทายประจำวัน",
    role: "หมุนกงล้อพารวย",
    stars: 5,
    tag: "แจ็คพอตแตกบ่อย",
    content: "แค่เข้ามาล็อกอินและร่วมสนุกกับเกมโปรดก็มีสิทธิ์ลุ้นรับรางวัลใหญ่ได้ทุกวัน แจ็คพอตที่นี่แตกง่ายแตกบ่อยจริง หลายคนพลิกวิกฤตเป็นโอกาสได้ในชั่วข้ามคืน",
    avatar: "🎡",
  },
  {
    name: "คนที่ไม่อยากรอแอดมินตอนโอนเงิน",
    role: "ระบบฝากถอนออโต้",
    stars: 5,
    tag: "ถอนไม่อั้น",
    content: "ทำรายการฝากถอนเองผ่านหน้าเว็บได้เลย ไม่ต้องทักแอดมินหรือส่งสลิปให้วุ่นวาย เงินเข้าไวในไม่กี่วินาที รองรับทุกธนาคารและทรูวอเลท เบิกเงินรางวัลออกได้ทันทีทุกยอด",
    avatar: "⚡",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก กงล้อ88" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <div class="inline-block rounded-2xl border border-[#ffcc4b]/35 bg-[#1e1105]/88 px-6 py-3 shadow-[0_10px_30px_rgba(255,204,75,0.22)] backdrop-blur-md">
      <p class="bg-gradient-to-r from-[#ffe974] via-[#ffcc4b] to-[#ff6a13] bg-clip-text text-3xl font-black tracking-wide text-transparent">เสียงจากสมาชิก กงล้อ88</p>
    </div>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ffcc4b] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#ffcc4b]/35 bg-[#1e1105]/88 px-6 py-4 shadow-[0_10px_30px_rgba(255,204,75,0.22)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe974] to-[#eb9a1d] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#c9ab7a]">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#2c1808]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ffcc4b]" : "text-[#2c1808]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#c9ab7a]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#ffcc4b]/30 bg-[#1e1105]/88 p-6 text-left shadow-[0_10px_30px_rgba(255,204,75,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#ffcc4b]/55 hover:shadow-[0_15px_40px_rgba(255,106,19,0.32)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe974] to-[#ff6a13] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#ff6a13]/35 blur-[50px] transition-all duration-300 group-hover:bg-[#ffcc4b]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#ffcc4b]/35 bg-[#140a02] px-3 py-1 text-[10px] font-bold tracking-wide text-[#ffcc4b]">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ffcc4b]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ffcc4b]" : "text-[#2c1808]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f6e6c2]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#2c1808] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ffcc4b]/40 bg-gradient-to-br from-[#ffe974] via-[#ffcc4b] to-[#eb9a1d] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f6e6c2] transition-colors group-hover:text-[#ffcc4b]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#c9ab7a]">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
