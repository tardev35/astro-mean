---
// Widget ไม่ใช่ article: บรรทัดหัวข้อเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ห้ามเลื่อนขึ้นเป็น <h2> เพราะจำนวน h2 บนหน้าแรกถูก diff กับ
// checklist ของ docx ชื่อผู้รีวิวในการ์ดก็เป็น <span> ด้วยเหตุผลเดียวกัน
//
// CK1968: ย้ายชุดทองอำพันคู่โครเมียมเงินของแบรนด์ก่อนออกทั้งหมด มาที่ทองคำคู่แดง
// เลือดหมูที่วัดจากอาร์ตจริง — ดาวที่ติดแล้วเป็นทองคำซึ่งเป็นสีนำของโลโก้ ส่วนดาวที่
// ยังไม่ติดใช้สีขอบการ์ด ตัวเลขคะแนนเฉลี่ยรับไล่เฉดจากทองซีดไปหาทองหลัก และแดง
// เลือดหมู (ตัว K ในโลโก้ มงกุฎประดับทับทิม ไพ่ชุดแดง) ไปอยู่ที่ป้ายแท็กกับสต็อป
// ท้ายของไล่เฉดหัวข้อ
// ทอง #ffefc4 / #ffd45c / #f0a80c / #a76806 / #5d3a05 คู่แดง #ff4b52 / #d4090f /
// #8c0206 บนผิว #090302 / #170806 / #2a100a ขอบ #4d1f0d เนื้อความ #f6e4c0
// ข้อความรอง #cdb494
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history)
//
// เนื้อความรีวิวเขียนใหม่ตาม brief ของแบรนด์นี้ — ระบบรักษาความปลอดภัยระดับสูงที่
// ไม่ล็อคยูสเซอร์เมื่อเล่นได้กำไรก้อนโต / ระบบ AI ทำธุรกรรมอัตโนมัติคู่กับเงื่อนไข
// ฝากถอนไม่มีขั้นต่ำ / การโอนจ่ายเต็มจำนวนทุกบิลโดยไม่หักค่าธรรมเนียมและไม่แบ่งงวด
const reviews = [
  {
    name: "สมาชิกที่เคยโดนล็อคยูสมาจากเว็บเอเย่นต์",
    role: "ระบบรักษาความปลอดภัยขั้นสูงสุด",
    stars: 5,
    tag: "ไม่ล็อคยูสเซอร์",
    content:
      "เล่นได้กำไรก้อนโตแล้วยังถอนออกได้ตามปกติ ไม่เจอเหตุการณ์ถูกล็อคยูสเซอร์แบบที่เคยโดนมา ข้อมูลส่วนตัวกับประวัติการทำธุรกรรมถูกเก็บเป็นความลับทั้งหมด เลยโฟกัสกับการปั่นสล็อตได้เต็มที่โดยไม่ต้องระแวงเรื่องตุกติก",
    avatar: "🛡️",
  },
  {
    name: "คนที่ฝากถอนทีละยอดเล็กตลอดทั้งคืน",
    role: "ระบบออโต้ AI คู่เงื่อนไขไม่มีขั้นต่ำ",
    stars: 5,
    tag: "ไม่ต้องส่งสลิป",
    content:
      "กดทำรายการแล้วยอดเงินเข้ากระเป๋าภายในไม่กี่วินาที ไม่ต้องส่งสลิปให้แอดมินตรวจและไม่ต้องรอคิวอนุมัติ จะฝากตอนดึกหรือถอนช่วงเช้าตรู่ก็ลื่นไหลไม่มีสะดุด ฝาก 1 บาทหรือถอนยอดเล็กๆ ก็ทำได้เองโดยไม่มีเงื่อนไขผูกมัด",
    avatar: "🤖",
  },
  {
    name: "คนที่แจ็คพอตแตกหลักแสนแล้วถอนออกจริง",
    role: "โอนจ่ายเต็มจำนวนทุกบิล",
    stars: 5,
    tag: "ไม่หักค่าธรรมเนียม",
    content:
      "ยอดเข้าบัญชีเต็มจำนวนทุกบาททุกสตางค์ ไม่มีหักค่าธรรมเนียม ไม่มีแบ่งจ่ายเป็นงวดๆ และไม่ต้องมาทำเทิร์นโอเวอร์ซ้ำซ้อนให้วุ่นวาย ชนะปุ๊บรับเงินเข้าบัญชีไปเลย ทำให้กล้าเดิมพันต่อเนื่องแบบไม่ต้องลุ้นตอนกดถอน",
    avatar: "👑",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก CK1968" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <div class="inline-block rounded-2xl border border-[#4d1f0d]/70 bg-[#170806]/90 px-6 py-3 shadow-[0_10px_30px_rgba(93,58,5,0.35)] backdrop-blur-md">
      <p class="bg-gradient-to-r from-[#ffefc4] via-[#ffd45c] to-[#ff4b52] bg-clip-text text-3xl font-black tracking-wide text-transparent">เสียงจากสมาชิก CK1968</p>
    </div>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f0a80c] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#f0a80c]/35 bg-[#170806]/90 px-6 py-4 shadow-[0_10px_30px_rgba(240,168,12,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffefc4] to-[#f0a80c] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#cdb494]">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#4d1f0d]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ffd45c]" : "text-[#4d1f0d]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#cdb494]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#4d1f0d]/60 bg-[#170806]/90 p-6 text-left shadow-[0_10px_30px_rgba(93,58,5,0.3)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#f0a80c]/55 hover:shadow-[0_15px_40px_rgba(240,168,12,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#f0a80c] to-[#8c0206] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#2a100a]/85 blur-[50px] transition-all duration-300 group-hover:bg-[#8c0206]/50" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#d4090f]/45 bg-[#090302] px-3 py-1 text-[10px] font-bold tracking-wide text-[#ff4b52]">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#d4090f]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ffd45c]" : "text-[#4d1f0d]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f6e4c0]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#4d1f0d] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f0a80c]/40 bg-gradient-to-br from-[#ffefc4] via-[#f0a80c] to-[#5d3a05] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f6e4c0] transition-colors group-hover:text-[#ffd45c]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#cdb494]">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
