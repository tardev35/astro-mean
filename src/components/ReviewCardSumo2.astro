---
// Widget ไม่ใช่ article: บรรทัดหัวข้อเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech
//
// MAHAHENG333: ย้ายจากชมพูกลอสคู่ทองของ GALA89 (#ff4d9c / #d41c6b / #9e154a คู่ทอง
// #ffe0a3 / #f0c274 / #b8801f บนผิว #1f0311 / #12010a / #3c0214 เนื้อความ #f7dce8
// ข้อความรอง #f9a8cd) มาที่ทองมังกรจีนบนดำ — ทอง #ffe98a / #e8b923 / #a5760a คู่แดง
// #b4231c / #6d1410 บนผิว #221708 / #15100a / #0a0704 / #33230b เนื้อความ #f3e2b8
// ข้อความรอง #c2a469 ดาวใช้ทอง #e8b923 ซึ่งเป็นสีหลักของแบรนด์
// เนื้อความเขียนใหม่ตาม brief คาสิโนสดของแบรนด์นี้ — ไม่มีสล็อต/ฟรีสปิน
const reviews = [
  {
    name: "สายลุ้นไพ่ที่ชอบบรรยากาศเรียลไทม์",
    role: "โต๊ะเดิมพันสดคุณภาพสูง",
    stars: 5,
    tag: "ภาพคมชัดระดับ HD",
    content: "สตรีมมิ่งคมชัดไร้ดีเลย์ ได้ยินเสียงบรรยากาศในคาสิโนจริงครบทุกจังหวะ ทั้งบาคาร่า รูเล็ต เสือมังกร และไฮโล ให้ความรู้สึกเหมือนนั่งอยู่ติดขอบโต๊ะเดิมพันจริงๆ",
    avatar: "🎴",
  },
  {
    name: "คนที่ชอบเลือกห้องเล่นเอง",
    role: "เลือกโต๊ะได้ตามสไตล์",
    stars: 5,
    tag: "ไม่มีคำว่าโต๊ะเต็ม",
    content: "หน้าต่างเลือกห้องจัดมาเป็นระเบียบ มีสถิติย้อนหลังและรายละเอียดของแต่ละโต๊ะให้ดูก่อนลง อยากได้โต๊ะสปีดเกมไวหรือโต๊ะบรรยากาศสบายๆ ก็เลือกได้เอง ไม่ต้องแย่งที่นั่งกับใคร",
    avatar: "🎡",
  },
  {
    name: "คนที่ไม่อยากรอแอดมินตอนโอนเงิน",
    role: "ระบบการเงินออโต้ไฮสปีด",
    stars: 5,
    tag: "ฝากถอน 5 วิ",
    content: "ทั้งเติมทุนลุยต่อและถอนกำไรก้อนโต ระบบจัดการให้เสร็จภายใน 5 วินาที ไม่ต้องส่งสลิปยืนยันและไม่ต้องรอใครมากดอนุมัติ สลับโต๊ะไปเล่นต่อได้ทันทีโดยไม่เสียจังหวะ",
    avatar: "⚡",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก MAHAHENG333" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <div class="inline-block rounded-2xl border border-[#e8b923]/35 bg-[#221708]/88 px-6 py-3 shadow-[0_10px_30px_rgba(232,185,35,0.22)] backdrop-blur-md">
      <p class="bg-gradient-to-r from-[#ffe98a] via-[#e8b923] to-[#a5760a] bg-clip-text text-3xl font-black tracking-wide text-transparent">เสียงจากสมาชิก MAHAHENG333</p>
    </div>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e8b923] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#e8b923]/35 bg-[#221708]/88 px-6 py-4 shadow-[0_10px_30px_rgba(232,185,35,0.22)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe98a] to-[#a5760a] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#c2a469]">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#33230b]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e8b923]" : "text-[#33230b]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#c2a469]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#e8b923]/30 bg-[#221708]/88 p-6 text-left shadow-[0_10px_30px_rgba(232,185,35,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#e8b923]/55 hover:shadow-[0_15px_40px_rgba(232,185,35,0.32)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe98a] to-[#a5760a] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#b4231c]/35 blur-[50px] transition-all duration-300 group-hover:bg-[#e8b923]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#e8b923]/35 bg-[#0a0704] px-3 py-1 text-[10px] font-bold tracking-wide text-[#e8b923]">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#b4231c]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#e8b923]" : "text-[#33230b]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f3e2b8]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#33230b] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e8b923]/40 bg-gradient-to-br from-[#ffe98a] via-[#e8b923] to-[#a5760a] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f3e2b8] transition-colors group-hover:text-[#e8b923]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#c2a469]">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
