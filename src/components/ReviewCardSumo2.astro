---
// Widget ไม่ใช่ article: บรรทัดหัวข้อเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ห้ามเลื่อนขึ้นเป็น <h2> เพราะจำนวน h2 บนหน้าแรกถูก diff กับ
// checklist ของ docx ชื่อผู้รีวิวในการ์ดก็เป็น <span> ด้วยเหตุผลเดียวกัน
//
// PAY69: ย้ายชุดสีของแบรนด์ก่อนออกทั้งหมด มาที่ทองแชมเปญเดี่ยวบนดำสนิทที่วัดจาก
// อาร์ตจริง ไม่มีสีคู่ — ดาวที่ติดแล้วเป็นทองหลัก ส่วนดาวที่ยังไม่ติดใช้สีผิวชั้นใน
// ตัวเลขคะแนนเฉลี่ยรับไล่เฉดจากทองครีมไปทองบรอนซ์ เพื่อให้ทองสองน้ำหนักอยู่ใน
// กล่องเดียวกันโดยไม่ต้องมีสีที่สอง (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ —
// Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มี
// ใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// เนื้อความรีวิวเขียนใหม่ตาม brief ของแบรนด์คาสิโนสด (ไม่ใช่สล็อต) — เว็บตรง
// API แท้กับสัญญาณสด Ultra HD จากฟลอร์จริง / โต๊ะสดค่ายดังที่สลับได้ในยูสเซอร์เดียว
// / เว็บใหญ่ทุนหนาพร้อมเพย์กับฝากถอนออโต้ที่เครดิตเข้าใน 3 วินาที
const reviews = [
  {
    name: "สมาชิกที่ดูสัญญาณสดก่อนลงเดิมพันทุกตา",
    role: "เว็บตรง API แท้ สัญญาณสด Ultra HD",
    stars: 5,
    tag: "ไม่ผ่านเอเย่นต์",
    content:
      "ภาพสดคมชัดจริง ยิงตรงจากฟลอร์คาสิโนในต่างประเทศ ไม่มีการตัดต่อหรือเอาคลิปวนมาหลอก มุมกล้องมีให้เลือกหลายมุมเลยมองออกทุกมิติการแทง เล่นมาหลายเดือนไม่เจอล็อคยูสและไม่เคยเจอการปรับอัตราแพ้ชนะ",
    avatar: "🎥",
  },
  {
    name: "คนที่สลับโต๊ะทั้งคืนในยูสเซอร์เดียว",
    role: "โต๊ะสดค่ายดังครบทุกหมวด",
    stars: 5,
    tag: "กระเป๋าเงินเดียว",
    content:
      "ค่ายสดมาครบทั้ง Evolution Gaming, SA Gaming, Sexy Baccarat และ Pragmatic Play Live เบื่อบาคาร่าก็ข้ามไปรูเล็ต เสือมังกร ไฮโล หรือเกมโชว์สดได้เลย ห้องมีตั้งแต่งบหลักสิบยันโต๊ะ High Roller และไม่ต้องโยกเงินข้ามค่ายให้เสียจังหวะ",
    avatar: "🃏",
  },
  {
    name: "คนที่ถอนกำไรออกทุกวัน",
    role: "จ่ายทุกยอด ออโต้เข้าใน 3 วินาที",
    stars: 5,
    tag: "ไม่ติดเทิร์นโอเวอร์",
    content:
      "โบนัสต้อนรับคาสิโนสด โปรฝากแรกของวัน Cash Back คืนยอดเสีย และคอมมิชชันชวนเพื่อน กดรับเองได้จากหน้าแดชบอร์ดโดยไม่ต้องรอแอดมิน เงื่อนไขโปร่งใสไม่ติดเทิร์นโอเวอร์มหาโหด ฝากถอนวิ่งผ่าน Gateway ตรง ไม่ต้องส่งสลิป",
    avatar: "⚡",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก PAY69" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <div class="inline-block rounded-2xl border border-[#a87c2e]/40 bg-[#12100c]/90 px-6 py-3 shadow-[0_10px_30px_rgba(107,77,21,0.28)] backdrop-blur-md">
      <p class="bg-gradient-to-r from-[#fdf4e0] via-[#f7dfa5] to-[#a87c2e] bg-clip-text text-3xl font-black tracking-wide text-transparent">เสียงจากสมาชิก PAY69</p>
    </div>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e8c37a] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#e8c37a]/35 bg-[#12100c]/90 px-6 py-4 shadow-[0_10px_30px_rgba(232,195,122,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#fdf4e0] to-[#a87c2e] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#a99a7d]">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#1c1811]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e8c37a]" : "text-[#1c1811]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#a99a7d]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#a87c2e]/35 bg-[#12100c]/90 p-6 text-left shadow-[0_10px_30px_rgba(107,77,21,0.25)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#e8c37a]/55 hover:shadow-[0_15px_40px_rgba(232,195,122,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#f7dfa5] to-[#6b4d15] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#1c1811]/80 blur-[50px] transition-all duration-300 group-hover:bg-[#a87c2e]/40" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#e8c37a]/35 bg-[#08070a] px-3 py-1 text-[10px] font-bold tracking-wide text-[#f7dfa5]">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e8c37a]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#e8c37a]" : "text-[#1c1811]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#e6dac2]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#1c1811] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e8c37a]/40 bg-gradient-to-br from-[#fdf4e0] via-[#e8c37a] to-[#6b4d15] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#e6dac2] transition-colors group-hover:text-[#f7dfa5]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#a99a7d]">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
