---
// Widget ไม่ใช่ article: บรรทัดหัวข้อเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech
//
// ORCA789: ย้ายจากทองคู่แดงของ DEKDDD (#ffe08a / #eebb1a / #a3760a คู่ #e01f26 /
// #a80d10 / #5c0201 บนผิว #2a0806 / #1a0503 / #0b0100 เนื้อความ #f7e7c8) มาที่ฟ้า
// นีออนใต้ทะเลคู่ทอง — ฟ้าหลัก #00abfc / #84ccfb / #016cfa / #011dc4 คู่ทอง #ffd54a
// / #ffe89a / #8a6206 บนผิว #08203f / #041028 / #010614 ขอบ #062a6b เนื้อความ
// #dbeafe
//
// ดาวยังเป็นทอง แต่เป็นทอง #ffd54a ของแบรนด์นี้ ส่วนดาวที่ยังไม่ติดใช้ #062a6b
// เนื้อความรีวิวเขียนใหม่ตาม brief — คลังเกมเด็ดจากทุกค่ายชั้นนำ / บาคาร่าสด HD คู่
// เดิมพันฟุตบอลในยูสเซอร์เดียว / ระบบเสถียรและฝากถอนออโต้ไฮสปีด 3 วินาที
const reviews = [
  {
    name: "สายปั่นที่ตามล่าเกมแตกหนัก",
    role: "คลังเกมเด็ดจากทุกค่ายชั้นนำ",
    stars: 5,
    tag: "เกมเด็ดครบ",
    content:
      "เปิดล็อบบี้เข้ามาก็เจอแต่ตัวเด็ด ทั้งธีมแฟนตาซีตระการตา แนวสตรีทสุดเท่ และคลาสสิกโบนัสแตกง่าย กราฟิกคมชัดเอฟเฟกต์อลังการ อัตราการจ่ายคุ้มค่า จังหวะโบนัสกับแจ็คพอตพร้อมระเบิดได้ตลอดเวลา",
    avatar: "🎰",
  },
  {
    name: "คนที่เล่นบาคาร่าคู่กับดูบอล",
    role: "สองโหมดจบในยูสเซอร์เดียว",
    stars: 5,
    tag: "ครบทุกสาย",
    content: "บาคาร่ายิงตรงสัญญาณสดความละเอียดสูง HD จากคาสิโนจริง ได้ฟีลลิ่งเรียลไทม์สุดๆ ส่วนโหมดเดิมพันฟุตบอลราคาน้ำดี ค่าน้ำเปิดกว้างทุกลีก สลับอารมณ์มาเล่นได้ทันทีโดยไม่ต้องโยกเงิน",
    avatar: "🃏",
  },
  {
    name: "สายที่ดูระบบก่อนดูโปร",
    role: "ระบบเสถียรและฝากถอนออโต้",
    stars: 5,
    tag: "ไวใน 3 วิ",
    content: "รองรับสมาชิกจำนวนมากพร้อมกันได้โดยไม่หน่วง ไม่กระตุก ไม่มีเกมหลุดระหว่างลุ้นโบนัส ส่วนฝากถอนออโต้ไฮสปีดจบภายใน 3 วินาที ไม่ต้องส่งสลิปยืนยันและไม่ต้องรอแอดมินอนุมัติ",
    avatar: "⚡",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก ORCA789" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <div class="inline-block rounded-2xl border border-[#00abfc]/35 bg-[#041028]/88 px-6 py-3 shadow-[0_10px_30px_rgba(0,171,252,0.22)] backdrop-blur-md">
      <p class="bg-gradient-to-r from-[#f0f9ff] via-[#84ccfb] to-[#ffd54a] bg-clip-text text-3xl font-black tracking-wide text-transparent">เสียงจากสมาชิก ORCA789</p>
    </div>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#00abfc] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#00abfc]/35 bg-[#041028]/88 px-6 py-4 shadow-[0_10px_30px_rgba(0,171,252,0.22)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe89a] to-[#ffd54a] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#dbeafe]/75">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#062a6b]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ffd54a]" : "text-[#062a6b]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#dbeafe]/80">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#00abfc]/30 bg-[#041028]/88 p-6 text-left shadow-[0_10px_30px_rgba(0,171,252,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#00abfc]/55 hover:shadow-[0_15px_40px_rgba(1,108,250,0.35)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#84ccfb] to-[#011dc4] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#016cfa]/35 blur-[50px] transition-all duration-300 group-hover:bg-[#00abfc]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#00abfc]/35 bg-[#010614] px-3 py-1 text-[10px] font-bold tracking-wide text-[#84ccfb]">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ffd54a]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ffd54a]" : "text-[#062a6b]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#dbeafe]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#062a6b] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ffd54a]/40 bg-gradient-to-br from-[#ffe89a] via-[#ffd54a] to-[#8a6206] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#dbeafe] transition-colors group-hover:text-[#84ccfb]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#dbeafe]/75">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
