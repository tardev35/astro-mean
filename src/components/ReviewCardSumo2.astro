---
// Widget ไม่ใช่ article: บรรทัดหัวข้อเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech
//
// DRACO65: ย้ายจากม่วงโกธิคของ PHANTOM569 (#ede9fe / #b794ff / #8b5cf6 /
// #6d28d9 / #4c1d95 / #2a0a52 บนผิว #1c0343 / #12002b เนื้อความ #ded4f5
// ข้อความรอง #a99ac9 ดาวสีทอง #f6c445) มาที่เขียวมังกรนีออน — #dcfce7 /
// #4ade80 / #22c55e / #15803d / #14532d / #0a3318 บนผิว #062011 / #04150a
// เนื้อความ #d6ecdd ข้อความรอง #9dbfa8 ดาวใช้เงิน/โครเมียม #e2e8e4 ซึ่งเป็นสีรอง
// ของแบรนด์ เนื้อความเขียนใหม่ตาม brief ของแบรนด์นี้
const reviews = [
  {
    name: "คนที่เพิ่งย้ายมาจากเว็บที่กดสปินแล้วค้าง",
    role: "ระบบอัปเดตใหม่ เร็วแรงกว่าเดิม",
    stars: 5,
    tag: "ลื่นไม่สะดุด",
    content: "หน้าเว็บโหลดรวดเร็วฉับไว กราฟิกสีสันสดใสไหลลื่นไม่มีกระตุกตั้งแต่คลิกแรก เข้าใช้งานจากมือถือหรือคอมก็ลุยได้ราบรื่นเหมือนกัน ไม่ต้องคอยรีโหลดหน้าเว็บใหม่ให้เสียเวลาอีกแล้ว",
    avatar: "⚡",
  },
  {
    name: "สายปั่นที่ตามหาฟีเจอร์แตกหนัก",
    role: "ฟีเจอร์ดุครบเครื่องในทุกเกม",
    stars: 5,
    tag: "ฟีเจอร์ดุ",
    content: "ลูกเล่นซัพพอร์ตการทำกำไรมาครบครัน ทั้งโหมดฟรีสปินที่ออกบ่อย ตัวคูณรางวัลที่พร้อมระเบิดแจ็คพอตต่อเนื่อง และสัญลักษณ์พิเศษที่ช่วยให้เข้าถึงรอบโบนัสได้ง่ายกว่าเดิมจริง",
    avatar: "💥",
  },
  {
    name: "คนที่ให้ความสำคัญกับความเร็วการเงิน",
    role: "ฝาก-ถอนออโต้จบใน 3 วิ",
    stars: 5,
    tag: "ฝาก-ถอน 3 วิ",
    content: "จะเติมทุนเพื่อลุยต่อหรือถอนกำไรก้อนโตเข้าบัญชี ก็ทำเองได้ง่ายๆ ไร้ขั้นตอนซับซ้อน ไม่ต้องรอแอดมินอนุมัติ เงินเข้าตรงเป๊ะทุกบาททุกสตางค์ ไม่เสียจังหวะการปั่นเลยสักครั้ง",
    avatar: "💸",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก DRACO65" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <div class="inline-block rounded-2xl border border-[#22c55e]/35 bg-[#062011]/88 px-6 py-3 shadow-[0_10px_30px_rgba(34,197,94,0.22)] backdrop-blur-md">
      <p class="bg-gradient-to-r from-[#dcfce7] via-[#4ade80] to-[#e2e8e4] bg-clip-text text-3xl font-black tracking-wide text-transparent">เสียงจากสมาชิก DRACO65</p>
    </div>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#22c55e] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#22c55e]/35 bg-[#062011]/88 px-6 py-4 shadow-[0_10px_30px_rgba(34,197,94,0.22)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#dcfce7] to-[#14532d] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#9dbfa8]">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#0a3318]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e2e8e4]" : "text-[#0a3318]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#9dbfa8]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#22c55e]/30 bg-[#062011]/88 p-6 text-left shadow-[0_10px_30px_rgba(34,197,94,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#22c55e]/55 hover:shadow-[0_15px_40px_rgba(74,222,128,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#dcfce7] to-[#14532d] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#14532d]/45 blur-[50px] transition-all duration-300 group-hover:bg-[#22c55e]/45" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#22c55e]/35 bg-[#04150a] px-3 py-1 text-[10px] font-bold tracking-wide text-[#4ade80]">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#4ade80]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#e2e8e4]" : "text-[#0a3318]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#d6ecdd]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#0a3318] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#22c55e]/35 bg-gradient-to-br from-[#4ade80] via-[#22c55e] to-[#0a3318] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#d6ecdd] transition-colors group-hover:text-[#4ade80]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#9dbfa8]">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
