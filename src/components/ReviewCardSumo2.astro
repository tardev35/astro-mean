---
// Widget ไม่ใช่ article: บรรทัดหัวข้อเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech
//
// 249UP: ย้ายจากแดงสัญญาณ + โครมเงินของ FUSIONNEW (#ff5f52 / #e01a1a / #8c0102 คู่
// กับ #d9dde3 / #97a0a8 / #4a5157 บนผิว #150809 / #1f0c0d / #0a0405 เนื้อความ
// #e7e3e1 ข้อความรอง #c3bcb9) มาที่ทองหรูบนพื้นเกือบดำ — #ffe9a8 / #ffd86b /
// #f5b626 / #c98a12 / #8a5c08 / #3a2606 บนผิว #150e05 / #1e1409 / #0b0703
// เนื้อความ #f0e4cd ข้อความรอง #f0e4cd ที่ opacity 60–70% เนื้อความตาม brief
const reviews = [
  {
    name: "สายปั่นที่เบื่อเว็บเดิมๆ จนอยากเปลี่ยนที่เล่น",
    role: "ค่ายเกมครบเครื่อง เปิดมาทีมีแต่ตัวน่าเล่น",
    stars: 5,
    tag: "เกมแน่นค่ายครบ",
    content: "กดเข้ามาหน้าเว็บแล้วเห็นเลยว่าค่ายชั้นนำมารวมไว้ครบครันจริง คัดมาเฉพาะเกมที่ภาพสวย แตกง่าย และมีเอกลักษณ์ ไม่ต้องมานั่งสุ่มเสี่ยงกับเกมไร้คุณภาพ เปิดหน้าเกมทีไรก็มีตัวน่าเล่นให้เลือกทั้งนั้น",
    avatar: "🎰",
  },
  {
    name: "คนที่ชอบเปลี่ยนแนวเล่นบ่อยในรอบเดียว",
    role: "เข้าเมนูไว สลับค่ายคล่อง ไม่ต้องเสียเวลาหาเกม",
    stars: 5,
    tag: "สลับค่ายคล่อง",
    content: "เมนูจัดหมวดหมู่มาเป็นระเบียบ อยากเปลี่ยนจากสล็อตสายลุยไปเล่นแนวสบายตาก็กดได้ทันที ไม่ต้องผ่านหลายขั้นตอนให้เสียเวลาค้นหา เอาเวลาที่เหลือไปโฟกัสกับการปั่นต่อเนื่องได้เต็มที่กว่าเดิมเยอะ",
    avatar: "🔄",
  },
  {
    name: "คนที่เคยเจอเว็บถอนช้าจนเสียอารมณ์",
    role: "ระบบโอนไวเข้าบัญชีเลย ฟีเจอร์ในเกมก็มีของ",
    stars: 5,
    tag: "โอนไวไม่ต้องรอ",
    content: "ฝากถอนทำเองแบบออโต้ เงินเข้าบัญชีตรงเป๊ะในเวลาสั้นๆ ไม่ต้องนั่งรอทีมงานอนุมัติ ตัวเกมเองก็มีระบบคูณเงินรางวัล ซื้อฟรีสปิน และตัวคูณสุ่มที่โผล่มาถูกจังหวะ เลยลุ้นได้มากกว่าแค่นั่งมองวงล้อหมุน",
    avatar: "⚡",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก 249UP" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <div class="inline-block rounded-2xl border border-[#f5b626]/30 bg-[#150e05]/88 px-6 py-3 shadow-[0_10px_30px_rgba(245,182,38,0.18)] backdrop-blur-md">
      <p class="bg-gradient-to-r from-[#ffe9a8] via-[#ffd86b] to-[#c98a12] bg-clip-text text-3xl font-black tracking-wide text-transparent">เสียงจากสมาชิก 249UP</p>
    </div>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5b626] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#f5b626]/30 bg-[#150e05]/88 px-6 py-4 shadow-[0_10px_30px_rgba(245,182,38,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe9a8] to-[#c98a12] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#f0e4cd]/70">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#3a2606]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ffd86b]" : "text-[#8a5c08]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f0e4cd]/70">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#f5b626]/25 bg-[#150e05]/88 p-6 text-left shadow-[0_10px_30px_rgba(245,182,38,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#ffd86b]/55 hover:shadow-[0_15px_40px_rgba(255,216,107,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe9a8] to-[#8a5c08] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#8a5c08]/35 blur-[50px] transition-all duration-300 group-hover:bg-[#f5b626]/40" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#f5b626]/35 bg-[#0b0703] px-3 py-1 text-[10px] font-bold tracking-wide text-[#ffd86b]">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f5b626]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ffd86b]" : "text-[#8a5c08]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f0e4cd]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#3a2606] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f5b626]/35 bg-gradient-to-br from-[#ffe9a8] via-[#f5b626] to-[#8a5c08] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f0e4cd] transition-colors group-hover:text-[#ffd86b]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#f0e4cd]/70">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
