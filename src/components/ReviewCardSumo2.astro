---
// Widget ไม่ใช่ article: บรรทัดหัวข้อเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech
//
// LONGSAP168: ย้ายจากทองอ่อนของแบรนด์ก่อน (#feeb33 / #fac42c / #e4a434 /
// #cc8425 / #7a4a0d บน #150d04 / #1e1206 / #0a0602) มาที่ทองมังกร #ffd76a /
// #f2b024 / #a86a0c คู่กับไฟ #ff4d2e / #d81f26 / #7d0508 บนผิว #170806 /
// #24100c / #0a0402 เนื้อความตาม brief
const reviews = [
  {
    name: "สายปั่นสล็อตที่ตามล่าเกมค่ายดัง",
    role: "รวมค่ายดังระดับโลก อัปเดตเกมใหม่ไวมาก",
    stars: 5,
    tag: "เกมดังค่ายจัดเต็ม",
    content: "เปิดหน้าเว็บเข้ามาปุ๊บคือเจอเกมฮิตที่คุ้นเคยรออยู่เพียบ ไม่ต้องไล่หาให้เสียเวลา ชอบตรงที่อัปเดตเกมใหม่ๆ ไวมาก มีเกมลูกรักอยู่แล้วก็ยังเจอ ภาพสวย สปินลื่น แตกบ่อยจนต้องหยิบมารีวิวให้ฟัง",
    avatar: "🎰",
  },
  {
    name: "สายลุ้นไพ่ที่ชอบโต๊ะสดแบบเรียลไทม์",
    role: "ภาพคมชัดระดับ HD มีห้องให้เลือกเพียบ",
    stars: 5,
    tag: "โต๊ะสดจัดหนัก",
    content:
      "โต๊ะสดของที่นี่จัดหนักจัดเต็มจริง ภาพคมชัดระดับ HD สตรีมมาแบบเรียลไทม์ไม่มีกระตุกให้เสียอารมณ์ ชอบดีลเลอร์คนไหนหรือชอบจังหวะโต๊ะไหนก็เลือกเข้าได้ตามสไตล์ ได้ฟีลเหมือนบินไปนั่งที่คาสิโนจริง",
    avatar: "🃏",
  },
  {
    name: "วัยรุ่นใจร้อนที่ไม่ชอบรอแอดมิน",
    role: "ฝากถอนออโต้ ไม่ต้องแคปสลิปส่งใคร",
    stars: 5,
    tag: "ฝากไวถอนคล่อง",
    content: "ระบบการเงินตอบโจทย์คนใจร้อนมาก ฝากถอนเป็นออโต้ไม่ต้องแคปสลิปส่งหาแอดมินให้เมื่อยมือ เล่นได้ปุ๊บกดถอนปั๊บ เงินเด้งเข้าบัญชีแทบจะทันที จังหวะกำลังดวงขึ้นก็ฝากเข้าไปลุยต่อได้แบบสมูทๆ",
    avatar: "⚡",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก LONGSAP168" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <div class="inline-block rounded-2xl border border-[#f2b024]/30 bg-[#170806]/88 px-6 py-3 shadow-[0_10px_30px_rgba(242,176,36,0.18)] backdrop-blur-md">
      <p class="bg-gradient-to-r from-[#ffd76a] via-[#f2b024] to-[#d81f26] bg-clip-text text-3xl font-black tracking-wide text-transparent">เสียงจากสมาชิก LONGSAP168</p>
    </div>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f2b024] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#f2b024]/30 bg-[#170806]/88 px-6 py-4 shadow-[0_10px_30px_rgba(242,176,36,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffd76a] to-[#a86a0c] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#e3c9ab]">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#a86a0c]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f2b024]" : "text-[#a86a0c]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e3c9ab]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#f2b024]/25 bg-[#170806]/88 p-6 text-left shadow-[0_10px_30px_rgba(242,176,36,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#f2b024]/55 hover:shadow-[0_15px_40px_rgba(216,31,38,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffd76a] to-[#7d0508] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#d81f26]/30 blur-[50px] transition-all duration-300 group-hover:bg-[#ff4d2e]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#f2b024]/35 bg-[#0a0402] px-3 py-1 text-[10px] font-bold tracking-wide text-[#f2b024]">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ff4d2e]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f2b024]" : "text-[#a86a0c]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f6e4c8]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#a86a0c] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f2b024]/35 bg-gradient-to-br from-[#ffd76a] via-[#f2b024] to-[#a86a0c] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f6e4c8] transition-colors group-hover:text-[#ffd76a]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#e3c9ab]">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
