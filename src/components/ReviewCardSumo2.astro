---
// Widget ไม่ใช่ article: บรรทัดหัวข้อเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech
//
// THUNDER87: ย้ายจากแดงสัญญาณของ FAST369 (#e40613 / #ff3b2f / #8f0206 คู่ทอง
// #ffe27a / #ffc531 / #a8720a บนผิว #170506 / #240709 / #0a0304 เนื้อความ
// #f4e7dd ข้อความรอง #cdb9b2) มาที่เหลืองสายฟ้าไฟฟ้าล้วน — #fff89a / #fae61c /
// #dcb309 / #ffd60a / #8a7405 บนผิว #17150a / #2b2606 / #080703 เนื้อความ
// #f0ead6 ข้อความรอง #c9c2a6 เนื้อความตาม brief
const reviews = [
  {
    name: "สายสปินที่ตามหาค่ายเกมครบในที่เดียว",
    role: "ขนเกมค่ายดังมาลงแน่นแบบไม่หวง",
    stars: 5,
    tag: "เกมครบไม่หวง",
    content: "ค่ายใหญ่ในกระแสหรือค่ายดังเฉพาะกลุ่มก็มีให้เลือกครบในล็อบบี้เดียว ทุกเกมคัดมาแล้วทั้งงานภาพคมชัดและอัตราการจ่ายที่สมน้ำสมเนื้อ เล่นได้ยาวๆ ไม่มีคำว่ากั๊กฟีเจอร์จริงอย่างที่บอกไว้",
    avatar: "🎰",
  },
  {
    name: "คนที่ชอบสลับจากวงล้อไปลุ้นหน้าไพ่",
    role: "สล็อต คาสิโนสด และบาคาร่าในยูสเซอร์เดียว",
    stars: 5,
    tag: "ครบทั้งล็อบบี้",
    content: "อยากสลับอารมณ์จากการปั่นวงล้อไปลุ้นบาคาร่าหรือเข้าโต๊ะถ่ายทอดสดก็ทำได้ทันที ไม่ต้องเสียเวลาโยกเงินหรือสมัครหลายบัญชีให้ยุ่งยาก ความหลากหลายตรงนี้ทำให้อารมณ์การเล่นสดใหม่อยู่เสมอ",
    avatar: "🃏",
  },
  {
    name: "สายที่ดูความเสถียรของระบบก่อนตัดสินใจ",
    role: "เข้าเกมคล่อง สลับค่ายไว ฝากถอนออโต้",
    stars: 5,
    tag: "แรงและเสถียร",
    content: "กดเข้าเกมได้ฉับไว ตอบสนองทันทีที่คลิก สลับค่ายลื่นไหลไม่มีกระตุก ไม่เจอหน้าจอค้างหรือเกมหลุดกลางโบนัส ฝั่งการเงินก็จบไวไม่ผ่านคนกลาง ทุกบาททุกสตางค์ตรงไปตรงมา",
    avatar: "⚡",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก THUNDER87" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <div class="inline-block rounded-2xl border border-[#fae61c]/35 bg-[#17150a]/88 px-6 py-3 shadow-[0_10px_30px_rgba(250,230,28,0.2)] backdrop-blur-md">
      <p class="bg-gradient-to-r from-[#fff89a] via-[#fae61c] to-[#dcb309] bg-clip-text text-3xl font-black tracking-wide text-transparent">เสียงจากสมาชิก THUNDER87</p>
    </div>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fae61c] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#fae61c]/35 bg-[#17150a]/88 px-6 py-4 shadow-[0_10px_30px_rgba(250,230,28,0.2)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#fff89a] to-[#8a7405] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#c9c2a6]">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#2b2606]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fae61c]" : "text-[#8a7405]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#c9c2a6]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#fae61c]/30 bg-[#17150a]/88 p-6 text-left shadow-[0_10px_30px_rgba(250,230,28,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#fae61c]/55 hover:shadow-[0_15px_40px_rgba(250,230,28,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#fff89a] to-[#8a7405] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#8a7405]/45 blur-[50px] transition-all duration-300 group-hover:bg-[#dcb309]/45" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#fae61c]/35 bg-[#080703] px-3 py-1 text-[10px] font-bold tracking-wide text-[#fae61c]">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fae61c]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#fae61c]" : "text-[#8a7405]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f0ead6]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#2b2606] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#fae61c]/35 bg-gradient-to-br from-[#ffd60a] via-[#dcb309] to-[#8a7405] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f0ead6] transition-colors group-hover:text-[#fae61c]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#c9c2a6]">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
