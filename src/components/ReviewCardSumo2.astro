---
// Widget ไม่ใช่ article: บรรทัดหัวข้อเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech
//
// IOK66: ย้ายจากทองเข้ม + ไฟมังกรของแบรนด์ก่อน (#ffd76a / #f2b024 / #a86a0c คู่กับ
// #ff4d2e / #d81f26 / #7d0508 บนผิว #170806 / #24100c / #0a0402 เนื้อความ #f6e4c8
// ข้อความรอง #e3c9ab) มาที่ทองหลวง + แดงชาด — #ffe9a3 / #f0cd6a / #e3b64a /
// #b8862c / #5c3a10 คู่กับ #a3161c / #d4472a / #5c0a0c บนผิว #1c110a / #150c07 /
// #0d0705 เนื้อความ #f2e2c4 ข้อความรอง #ddc8a4 เนื้อความตาม brief
const reviews = [
  {
    name: "ผู้เล่นหน้าใหม่ที่เพิ่งเปิดยูสรอบแรก",
    role: "สมัครสั้นกระชับ รับโปรต้อนรับไปต่อยอด",
    stars: 5,
    tag: "เปิดยูสใหม่",
    content: "ขั้นตอนลงทะเบียนสั้นมาก ไม่ต้องกรอกข้อมูลส่วนตัวให้วุ่นวายเหมือนที่อื่น เปิดยูสเสร็จก็ได้สิทธิพิเศษกับโปรโมชั่นต้อนรับมาเป็นทุนเดิมพันทันที ทำกำไรได้ตั้งแต่ครั้งแรกที่ล็อคอินเข้าระบบจริงๆ",
    avatar: "📝",
  },
  {
    name: "สายปั่นที่ไล่เทียบค่า RTP มาหลายเว็บ",
    role: "ไม่ปรับลดอัตราชนะ สแกตเตอร์มาบ่อย",
    stars: 5,
    tag: "RTP สูงกว่าที่อื่น",
    content:
      "เหตุผลที่ย้ายมาตั้งรกรากที่นี่คือค่า RTP สูงกว่าเว็บทั่วไปแบบรู้สึกได้ ไม่มีการปรับลดอัตราการชนะ จังหวะออกสแกตเตอร์กับฟรีสปินเลยมาบ่อยและเข้าถึงง่าย จะเดินเบทขั้นต่ำหรือปรับเบทหนักก็ลุ้นก้อนใหญ่ได้จริง",
    avatar: "📈",
  },
  {
    name: "คนที่เคยเจอเว็บหักเปอร์เซ็นต์ตอนถอน",
    role: "จ่ายเต็มทุกยอด ออโต้ไม่กี่วินาที",
    stars: 5,
    tag: "ถอนชัวร์ไม่อั้น",
    content: "เล่นได้เท่าไหร่โอนให้เต็มจำนวน ไม่หักเปอร์เซ็นต์ ไม่ต้องทำเทิร์นโอเวอร์ซ้ำซ้อนให้เสียเวลา ฝากถอนเป็นออโต้เต็มรูปแบบ ไม่ต้องส่งสลิป ไม่ต้องรอแอดมินตอบแชท กดทำรายการเองแล้วยอดเด้งเข้าบัญชีในไม่กี่วินาที",
    avatar: "💸",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก IOK66" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <div class="inline-block rounded-2xl border border-[#e3b64a]/30 bg-[#1c110a]/88 px-6 py-3 shadow-[0_10px_30px_rgba(227,182,74,0.18)] backdrop-blur-md">
      <p class="bg-gradient-to-r from-[#ffe9a3] via-[#e3b64a] to-[#a3161c] bg-clip-text text-3xl font-black tracking-wide text-transparent">เสียงจากสมาชิก IOK66</p>
    </div>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e3b64a] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#e3b64a]/30 bg-[#1c110a]/88 px-6 py-4 shadow-[0_10px_30px_rgba(227,182,74,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe9a3] to-[#b8862c] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#ddc8a4]">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#b8862c]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e3b64a]" : "text-[#5c3a10]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#ddc8a4]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#e3b64a]/25 bg-[#1c110a]/88 p-6 text-left shadow-[0_10px_30px_rgba(227,182,74,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#e3b64a]/55 hover:shadow-[0_15px_40px_rgba(163,22,28,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe9a3] to-[#5c0a0c] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#a3161c]/30 blur-[50px] transition-all duration-300 group-hover:bg-[#d4472a]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#e3b64a]/35 bg-[#0d0705] px-3 py-1 text-[10px] font-bold tracking-wide text-[#e3b64a]">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#d4472a]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#e3b64a]" : "text-[#5c3a10]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f2e2c4]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#5c3a10] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e3b64a]/35 bg-gradient-to-br from-[#ffe9a3] via-[#f0cd6a] to-[#b8862c] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f2e2c4] transition-colors group-hover:text-[#ffe9a3]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#ddc8a4]">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
