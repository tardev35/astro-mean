---
// Widget ไม่ใช่ article: บรรทัดหัวข้อเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech
//
// DEKDDD: ย้ายจากชุดสีของแบรนด์ก่อนหน้ามาที่ทองคู่แดง — ทองหลัก #ffe08a / #eebb1a
// / #a3760a คู่แดง #e01f26 / #a80d10 / #5c0201 บนผิว #2a0806 / #1a0503 / #0b0100
// เนื้อความ #f7e7c8 (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย
// ดูของเดิมได้จาก git history)
//
// ดาวยังเป็นทอง แต่เป็นทอง #eebb1a ของแบรนด์นี้ ส่วนดาวที่ยังไม่ติดใช้ #5c0201
// เนื้อความรีวิวเขียนใหม่ตาม brief — เกมฮิตติดล็อบบี้กับตัวใหม่สลับมาให้ลอง /
// ระบบตอบสนองไวสลับเกมสมูธ / เล่นลื่นทุกอุปกรณ์ / ฟีเจอร์เด่นและกิจกรรม
const reviews = [
  {
    name: "สายเอ็นจอยที่ชอบลองเกมใหม่ทุกวัน",
    role: "เกมฮิตติดล็อบบี้ พร้อมตัวใหม่สลับมา",
    stars: 5,
    tag: "ไม่จำเจ",
    content:
      "เปิดล็อบบี้เข้ามาทีไรก็เจอแต่ตัวเต็ง ทั้งเกมสล็อตยอดฮิตระดับตำนานและเกมมาใหม่ล่าสุดจากค่ายชั้นนำที่สลับสับเปลี่ยนเข้ามาให้ลองตลอดเวลา อยากเปลี่ยนฟีลเมื่อไหร่ก็แค่คลิกเลือกเกมใหม่ได้ทันที",
    avatar: "🎰",
  },
  {
    name: "คนที่ชอบสลับค่ายไปมาระหว่างวัน",
    role: "ระบบตอบสนองไว สลับเกมลื่นไร้รอยต่อ",
    stars: 5,
    tag: "ไวทันใจ",
    content: "จุดที่ติดใจคือความฉับไวของระบบหลังบ้าน เวลาจะเปลี่ยนเกมหรือสลับค่ายเล่นไม่ต้องนั่งรอโหลดหน้าเว็บนานๆ ให้เสียอารมณ์ จังหวะกำลังได้ อารมณ์กำลังมา ก็ปั่นต่อได้ทันทีโดยไม่มีคำว่าสะดุด",
    avatar: "⚡",
  },
  {
    name: "สายพกความสนุกไปเล่นนอกบ้าน",
    role: "เล่นลื่นทุกอุปกรณ์ ฟีเจอร์เด่นครบ",
    stars: 5,
    tag: "เล่นได้ทุกที่",
    content: "จะเปิดจากมือถือ แท็บเล็ต หรือคอมก็คล่องตัวเหมือนกัน หน้าจอปรับให้เหมาะกับอุปกรณ์อัตโนมัติ ปุ่มกดใกล้มือ กราฟิกคมชัด แถมยังมีตัวคูณรางวัลและโหมดฟรีสปินที่ออกบ่อยให้ลุ้นเพิ่มอีก",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก DEKDDD" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <div class="inline-block rounded-2xl border border-[#eebb1a]/35 bg-[#1a0503]/88 px-6 py-3 shadow-[0_10px_30px_rgba(238,187,26,0.22)] backdrop-blur-md">
      <p class="bg-gradient-to-r from-[#fff6dd] via-[#eebb1a] to-[#e01f26] bg-clip-text text-3xl font-black tracking-wide text-transparent">เสียงจากสมาชิก DEKDDD</p>
    </div>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#eebb1a] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#eebb1a]/35 bg-[#1a0503]/88 px-6 py-4 shadow-[0_10px_30px_rgba(238,187,26,0.22)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe08a] to-[#eebb1a] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#f7e7c8]/75">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#5c0201]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#eebb1a]" : "text-[#5c0201]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f7e7c8]/80">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#eebb1a]/30 bg-[#1a0503]/88 p-6 text-left shadow-[0_10px_30px_rgba(238,187,26,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#eebb1a]/55 hover:shadow-[0_15px_40px_rgba(168,13,16,0.35)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe08a] to-[#a80d10] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#a80d10]/35 blur-[50px] transition-all duration-300 group-hover:bg-[#eebb1a]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#eebb1a]/35 bg-[#0b0100] px-3 py-1 text-[10px] font-bold tracking-wide text-[#ffe08a]">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e01f26]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#eebb1a]" : "text-[#5c0201]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f7e7c8]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#5c0201] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#eebb1a]/40 bg-gradient-to-br from-[#ffe08a] via-[#eebb1a] to-[#a3760a] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f7e7c8] transition-colors group-hover:text-[#ffe08a]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#f7e7c8]/75">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
