---
// Widget, not article: the heading line is a <p> and the <section> carries the
// accessible name. Copy follows BUFFXBET's brief.
const reviews = [
  {
    name: "สมาชิกสายปั่นที่ลองมาแล้วหลายค่าย",
    role: "เหมาค่ายท็อปฮิตมารวมไว้ที่เดียวจบ",
    stars: 5,
    tag: "รวมเกมฮิตจากค่ายดัง",
    content:
      "สายขี้เบื่อถูกใจสิ่งนี้จริง ไม่ต้องคอยสลับเว็บไปมาให้วุ่นวายอีกแล้ว จะแนวแอคชั่น แฟนตาซี หรือสไตล์คลาสสิกก็มีให้เลือกเพียบ แต่ละเกมคัดมาแล้วเน้นๆ ภาพคมชัดระดับไฮเอนด์ เล่นเพลินจนลืมเวลา",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่ตามเก็บโบนัสทุกจังหวะ",
    role: "โบนัสตัวคูณและฟรีสปินโผล่มาตลอดเกม",
    stars: 5,
    tag: "โบนัสเน้นทุกจังหวะ",
    content:
      "จังหวะการแจกของที่นี่ทำมาได้ตื่นเต้นมาก ไม่ใช่แค่รอแจ็คพอตใหญ่อย่างเดียว แต่มีรางวัลยิบย่อยกับฟรีสปินโผล่มาช่วยเพิ่มสีสันตลอดเกม กราฟกำไรพุ่งกระฉูดได้แบบไม่อั้น ลุ้นตัวโก่งทุกวินาที",
    avatar: "🎁",
  },
  {
    name: "สมาชิกที่ถอนบ่อยและใจร้อนเรื่องเวลา",
    role: "ชนะปุ๊บ สั่งถอนปั๊บ เงินเด้งเข้าทันใจ",
    stars: 5,
    tag: "ฝากถอนคล่องจริง",
    content:
      "เรื่องเงินๆ ทองๆ เป็นอะไรที่ซีเรียสสุด แต่กับที่นี่บอกลาความกังวลไปได้เลย ทำรายการผ่านระบบออโต้แบบไม่ต้องรอยอดนานให้เสียอารมณ์ ทำให้มีสมาธิโฟกัสกับการเล่นต่อได้แบบไม่ขาดตอน",
    avatar: "⚡",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก BUFFXBET" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <div class="inline-block rounded-2xl border border-[#3b8df1]/25 bg-[#0a1330]/88 px-6 py-3 shadow-[0_10px_30px_rgba(59,141,241,0.18)] backdrop-blur-md">
      <p class="bg-gradient-to-r from-[#7cc0ff] via-[#3b8df1] to-[#f5c542] bg-clip-text text-3xl font-black tracking-wide text-transparent">เสียงจากสมาชิก BUFFXBET</p>
    </div>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#3b8df1] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#3b8df1]/25 bg-[#0a1330]/88 px-6 py-4 shadow-[0_10px_30px_rgba(59,141,241,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#fbe57d] to-[#f5c542] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#a8bcd8]">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#0a2563]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f5c542]" : "text-[#0a2563]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#a8bcd8]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#3b8df1]/25 bg-[#0a1330]/88 p-6 text-left shadow-[0_10px_30px_rgba(59,141,241,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#3b8df1]/55 hover:shadow-[0_15px_40px_rgba(245,197,66,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#f5c542] to-[#0a2563] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#f5c542]/25 blur-[50px] transition-all duration-300 group-hover:bg-[#3b8df1]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#3b8df1]/35 bg-[#050b1e] px-3 py-1 text-[10px] font-bold tracking-wide text-[#3b8df1]">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f5c542]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f5c542]" : "text-[#0a2563]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#dbe7fb]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#0a2563] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#3b8df1]/35 bg-gradient-to-br from-[#7cc0ff] via-[#3b8df1] to-[#0a2563] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#dbe7fb] transition-colors group-hover:text-[#f5c542]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#a8bcd8]">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
