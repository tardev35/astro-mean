---
// Widget ไม่ใช่ article: บรรทัดหัวข้อเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ห้ามเลื่อนขึ้นเป็น <h2> เพราะจำนวน h2 บนหน้าแรกถูก diff กับ
// checklist ของ docx
//
// UOK789: ย้ายจากนีออนม่วงคู่ทองของแบรนด์ก่อนหน้ามาที่เขียวมรกตคู่ทองเมทัลลิก —
// เขียว #2fc44f / #b6ecbd / #12923a / #0a4d1c คู่ทอง #f6c945 / #fdf3c9 / #8a6a1c
// บนผิว #08290f / #04140a ขอบ #0c3d18 เนื้อความ #e8f3e4 (ค่า hex ของแบรนด์เก่า
// ไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์
// ดูของเดิมได้จาก git history)
//
// ดาวยังเป็นทอง แต่เป็นทอง #f6c945 ของแบรนด์นี้ ส่วนดาวที่ยังไม่ติดใช้ #0c3d18
// เนื้อความรีวิวเขียนใหม่ตาม brief — สล็อตค่ายแท้เชื่อมตรงผ่าน API ไม่ล็อกผล /
// ตัวเด็ดเข้าไม่พักกับโบนัสจัดหนัก / เว็บทุนหนาจ่ายจริงและฝากถอนออโต้ไม่ล็อกยูส
const reviews = [
  {
    name: "คนที่เช็กว่าเกมเป็นค่ายแท้หรือไม่",
    role: "สล็อตออนไลน์ค่ายแท้ เชื่อมตรงผ่าน API",
    stars: 5,
    tag: "ค่ายแท้ไม่ล็อกผล",
    content:
      "ตัวระบบเชื่อมต่อตรงกับเซิร์ฟเวอร์หลักของค่ายเกมโดยไม่ผ่านเอเย่นต์หรือคนกลาง จึงไม่มีการดัดแปลงโปรแกรม ไม่มีการปรับลดเปอร์เซ็นต์ชนะ และไม่มีการล็อกผลใดๆ ทุกสปินลื่นไหลไร้ปัญหากระตุก ผลการออกรางวัลแม่นยำตามมาตรฐานสากล",
    avatar: "🔗",
  },
  {
    name: "สายล่ารางวัลที่ดูโปรก่อนสมัคร",
    role: "ตัวเด็ดเข้าไม่พัก โบนัสจัดหนักทุกจังหวะ",
    stars: 5,
    tag: "โบนัสจัดหนัก",
    content:
      "ล็อบบี้อัปเดตเกมสล็อตใหม่เข้ามาต่อเนื่อง ทั้งเกมฮิตติดลมบนและเกมนอกกระแสฟีเจอร์เด็ดที่พร้อมแตกหนัก ส่วนโปรโมชันก็มีทั้งเติมเงินรายวัน เครดิตพิเศษต้อนรับสมาชิกใหม่ และคืนยอดเสียที่แจกให้อย่างต่อเนื่อง เพิ่มทุนให้หมุนลุ้นแจ็คพอตได้นานขึ้น",
    avatar: "🎁",
  },
  {
    name: "คนที่ดูระบบการเงินก่อนฝากจริง",
    role: "เว็บทุนหนาจ่ายจริง ฝากถอนออโต้ไม่ล็อกยูส",
    stars: 5,
    tag: "ถอนเต็มจำนวน",
    content:
      "ถอนหลักร้อยหรือสปินแตกโบนัสใหญ่หลักแสนก็อนุมัติและโอนออกให้เต็มจำนวน ไร้ประวัติการเบี้ยว ยอดไม่ค้าง ไม่มีเงื่อนไขจุกจิกมาประวิงเวลา ทุกรายการทำผ่านระบบออโต้เสร็จในไม่กี่วินาที ไม่ต้องส่งสลิปให้แอดมิน และไม่ล็อกยูสให้เสียจังหวะ",
    avatar: "💰",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก UOK789" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <div class="inline-block rounded-2xl border border-[#2fc44f]/35 bg-[#08290f]/88 px-6 py-3 shadow-[0_10px_30px_rgba(47,196,79,0.22)] backdrop-blur-md">
      <p class="bg-gradient-to-r from-[#f4fdf3] via-[#b6ecbd] to-[#f6c945] bg-clip-text text-3xl font-black tracking-wide text-transparent">เสียงจากสมาชิก UOK789</p>
    </div>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#2fc44f] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#2fc44f]/35 bg-[#08290f]/88 px-6 py-4 shadow-[0_10px_30px_rgba(47,196,79,0.22)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#fdf3c9] to-[#f6c945] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#e8f3e4]/75">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#0c3d18]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f6c945]" : "text-[#0c3d18]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e8f3e4]/80">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#2fc44f]/30 bg-[#08290f]/88 p-6 text-left shadow-[0_10px_30px_rgba(47,196,79,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#2fc44f]/55 hover:shadow-[0_15px_40px_rgba(18,146,58,0.35)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#b6ecbd] to-[#0a4d1c] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#0a4d1c]/55 blur-[50px] transition-all duration-300 group-hover:bg-[#2fc44f]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#2fc44f]/35 bg-[#04140a] px-3 py-1 text-[10px] font-bold tracking-wide text-[#b6ecbd]">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f6c945]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f6c945]" : "text-[#0c3d18]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#e8f3e4]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#0c3d18] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f6c945]/40 bg-gradient-to-br from-[#fdf3c9] via-[#f6c945] to-[#8a6a1c] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#e8f3e4] transition-colors group-hover:text-[#b6ecbd]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#e8f3e4]/75">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
