---
// Widget ไม่ใช่ article: บรรทัดหัวข้อเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech
//
// FAST369: ย้ายจากทองหรูของ 249UP (#ffe9a8 / #ffd86b / #f5b626 / #c98a12 /
// #8a5c08 / #3a2606 บนผิว #150e05 / #1e1409 / #0b0703 เนื้อความ #f0e4cd) มาที่
// แดงสัญญาณ #e40613 / #ff3b2f / #8f0206 คู่ทอง #ffe27a / #ffc531 / #a8720a บนผิว
// #170506 / #240709 / #0a0304 เนื้อความ #f4e7dd ข้อความรอง #cdb9b2 เนื้อความตาม
// brief
const reviews = [
  {
    name: "สายสปินที่ชอบความสะใจ ไม่ชอบนั่งรอ",
    role: "เปิดโหมดความมันส์ไวตั้งแต่คลิกแรก",
    stars: 5,
    tag: "สปีดไม่มีตก",
    content: "กดเข้ามาแล้วสัมผัสได้เลยว่าตอบสนองฉับไวแบบทันที ไม่ต้องรอนานจนหมดอารมณ์ หน้าเกมกับองค์ประกอบต่างๆ โหลดสมูธ เข้าถึงโหมดความมันส์ได้ทันทีที่ใจต้องการ ปั่นสนุกไร้รอยต่อจริงอย่างที่บอกไว้",
    avatar: "⚡",
  },
  {
    name: "คนที่ชอบเปลี่ยนค่ายกลางรอบบ่อยๆ",
    role: "เข้าไวสลับไว เปลี่ยนค่ายได้ทันฟีล",
    stars: 5,
    tag: "ไม่เสียจังหวะ",
    content: "ความคล่องตัวในการสลับเปลี่ยนค่ายเกมคือของจริง ไม่ต้องกดออกหลายขั้นตอนหรือรอรีโหลดนานๆ จังหวะกำลังมา ฟีลกำลังได้ ก็จัดต่อได้ทันทีโดยไม่เสีย mood การปั่นที่ต่อเนื่องแบบนี้ลุ้นแจ็คพอตได้เต็มที่กว่าเดิม",
    avatar: "🔀",
  },
  {
    name: "สายล่าโปรที่ดูฟีเจอร์ก่อนตัดสินใจ",
    role: "ฟีเจอร์มีของ โบนัสพร้อมบวกเติมทุนตลอด",
    stars: 5,
    tag: "คุ้มทุกยอดปั่น",
    content: "เกมอุดมไปด้วยฟีเจอร์เด็ดทั้งตัวคูณสะสม สัญลักษณ์พิเศษที่ช่วยเข้าฟีเจอร์ง่ายขึ้น และโหมดฟรีสปินที่ออกบ่อยจนน่าตกใจ แถมมีกิจกรรมกับโปรเด็ดๆ พร้อมบวกเพิ่มเข้ายูสเซอร์ให้มีทุนหมุนต่อยอดได้ยาวขึ้น",
    avatar: "🎁",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก FAST369" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <div class="inline-block rounded-2xl border border-[#e40613]/35 bg-[#170506]/88 px-6 py-3 shadow-[0_10px_30px_rgba(228,6,19,0.2)] backdrop-blur-md">
      <p class="bg-gradient-to-r from-[#ffe27a] via-[#ffc531] to-[#e40613] bg-clip-text text-3xl font-black tracking-wide text-transparent">เสียงจากสมาชิก FAST369</p>
    </div>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e40613] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#e40613]/35 bg-[#170506]/88 px-6 py-4 shadow-[0_10px_30px_rgba(228,6,19,0.2)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe27a] to-[#a8720a] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#cdb9b2]">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#240709]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ffc531]" : "text-[#a8720a]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#cdb9b2]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#e40613]/30 bg-[#170506]/88 p-6 text-left shadow-[0_10px_30px_rgba(228,6,19,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#ffc531]/55 hover:shadow-[0_15px_40px_rgba(255,197,49,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe27a] to-[#8f0206] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#8f0206]/45 blur-[50px] transition-all duration-300 group-hover:bg-[#e40613]/45" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#ffc531]/35 bg-[#0a0304] px-3 py-1 text-[10px] font-bold tracking-wide text-[#ffc531]">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e40613]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ffc531]" : "text-[#a8720a]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f4e7dd]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#240709] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ffc531]/35 bg-gradient-to-br from-[#ff3b2f] via-[#e40613] to-[#8f0206] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f4e7dd] transition-colors group-hover:text-[#ffc531]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#cdb9b2]">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
