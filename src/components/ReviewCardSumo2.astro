---
// Widget ไม่ใช่ article: บรรทัดหัวข้อเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech
//
// MACAUBET: ย้ายจากม่วงบานเย็นนีออนของ SGD88 (#f7d0ff / #e879f9 / #bc07e2 /
// #930ac5 / #7a06a0 / #4c0a6b บนผิว #1b0d2e / #2a1145 / #050118 เนื้อความ #f3e8ff
// ข้อความรอง #cbb5e6) มาที่เขียวนีออนมาเก๊า + ทอง — #dcffc0 / #8ef04a / #59cb13 /
// #3b9b0d / #2c7a08 / #0f3a11 บนผิว #0a2c0d / #041b06 / #020b01 เนื้อความ #e9f9dc
// ข้อความรอง #a8c99a ดาวใช้ทอง #f6c445 เนื้อความเขียนใหม่ตาม brief ของแบรนด์นี้
const reviews = [
  {
    name: "คนที่อยากได้ฟีลคาสิโนมาเก๊าโดยไม่ต้องเดินทาง",
    role: "บรรยากาศหรูหราตั้งแต่คลิกแรก",
    stars: 5,
    tag: "ฟีลมาเก๊า",
    content: "งานภาพ แสง สี เสียง และจังหวะการออกรางวัลถูกยกระดับจนเหมือนนั่งกดสปินอยู่ในคาสิโนชื่อดังที่มาเก๊าจริงๆ ปั่นเพลินและตื่นเต้นตื่นตาตื่นใจทุกการหมุน ไม่ต้องเสียเวลาเดินทางไปถึงที่",
    avatar: "🎰",
  },
  {
    name: "สายฝากถอนที่เคยเบื่อการส่งสลิปรอแอดมิน",
    role: "ระบบตรงออโต้ไฮสปีดภายใน 3 วิ",
    stars: 5,
    tag: "โอนไว 3 วิ",
    content: "ทำรายการฝากถอนจบภายใน 3 วินาทีจริงตามที่บอก ต่อให้ช่วงผู้เล่นแน่นแค่ไหนเงินก็เข้าบัญชีตรงเป๊ะ ไม่ต้องส่งสลิป ไม่ต้องรออนุมัติ จัดการเรื่องการเงินเสร็จแล้วลุยต่อได้ทันทีไม่มีติดขัด",
    avatar: "⚡",
  },
  {
    name: "คนที่สลับไปมาระหว่างสล็อตกับโต๊ะสด",
    role: "ล็อบบี้เกมดังครบ โต๊ะสดพร้อม",
    stars: 5,
    tag: "ครบในเว็บเดียว",
    content: "ล็อบบี้รวมเกมตัวฮิตจากทุกค่ายดังไว้เยอะมาก ทั้งเกมในกระแส เกมแตกหนัก และเกมคลาสสิก อยากเปลี่ยนไปลุ้นโต๊ะสด HD ก็สลับได้ทันทีโดยไม่ต้องเปลี่ยนยูสเซอร์ เมนูจัดวางเป็นระเบียบหาเจอง่าย",
    avatar: "🎴",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก MACAUBET" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <div class="inline-block rounded-2xl border border-[#59cb13]/35 bg-[#0a2c0d]/88 px-6 py-3 shadow-[0_10px_30px_rgba(89,203,19,0.22)] backdrop-blur-md">
      <p class="bg-gradient-to-r from-[#dcffc0] via-[#8ef04a] to-[#f6c445] bg-clip-text text-3xl font-black tracking-wide text-transparent">เสียงจากสมาชิก MACAUBET</p>
    </div>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#59cb13] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#59cb13]/35 bg-[#0a2c0d]/88 px-6 py-4 shadow-[0_10px_30px_rgba(89,203,19,0.22)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#dcffc0] to-[#2c7a08] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#a8c99a]">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#0f3a11]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f6c445]" : "text-[#0f3a11]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#a8c99a]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#59cb13]/30 bg-[#0a2c0d]/88 p-6 text-left shadow-[0_10px_30px_rgba(89,203,19,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#59cb13]/55 hover:shadow-[0_15px_40px_rgba(142,240,74,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#dcffc0] to-[#2c7a08] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#2c7a08]/45 blur-[50px] transition-all duration-300 group-hover:bg-[#59cb13]/45" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#59cb13]/35 bg-[#020b01] px-3 py-1 text-[10px] font-bold tracking-wide text-[#8ef04a]">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#8ef04a]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f6c445]" : "text-[#0f3a11]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#e9f9dc]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#0f3a11] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#59cb13]/35 bg-gradient-to-br from-[#8ef04a] via-[#59cb13] to-[#0f3a11] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#e9f9dc] transition-colors group-hover:text-[#8ef04a]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#a8c99a]">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
