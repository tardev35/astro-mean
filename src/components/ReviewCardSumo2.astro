---
// Widget ไม่ใช่ article: บรรทัดหัวข้อเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ห้ามเลื่อนขึ้นเป็น <h2> เพราะจำนวน h2 บนหน้าแรกถูก diff กับ
// checklist ของ docx ชื่อผู้รีวิวในการ์ดก็เป็น <span> ด้วยเหตุผลเดียวกัน
//
// GUESS168: ย้ายชุดสีของแบรนด์ก่อนออกทั้งหมด มาที่ทองหลอมคู่ส้มไฟที่วัดจากอาร์ต
// จริง ดาวที่ติดแล้วเป็นทอง ส่วนดาวที่ยังไม่ติดใช้สีแผงชั้นใน ตัวเลขคะแนนเฉลี่ย
// รับไล่เฉดครีมไปทองเข้ม เพื่อให้คู่สีทั้งสองอยู่ในกล่องเดียวกัน (ห้ามพิมพ์ hex
// ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์
// จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// เนื้อความรีวิวเขียนใหม่ตาม brief — คลังเกมลิขสิทธิ์กับค่า RTP ที่ไม่ถูกดัดแปลง /
// เกมใหม่เข้าคลังใน 24 ชั่วโมงกับฟีเจอร์ที่อัดแน่น / โปรที่กดรับเองได้กับระบบ
// ฝากถอนออโต้ที่ไม่ต้องส่งสลิป
const reviews = [
  {
    name: "สายที่เปิดคลังเกมทุกวัน",
    role: "เว็บตรง API แท้ RTP สูง เกมลิขสิทธิ์แน่น",
    stars: 5,
    tag: "สล็อตคัดเกรด",
    content: "คลังคัดมาแต่ค่ายใหญ่จริง ทั้ง PG Soft, Pragmatic Play และ Joker Gaming ยิงตรงจากเซิร์ฟเวอร์หลัก ไม่มีดัดแปลงเปอร์เซ็นต์ชนะ เบทเริ่มที่ 1 บาทก็ยังลุ้นโบนัสก้อนโตได้",
    avatar: "🎰",
  },
  {
    name: "คนที่ชอบตามเกมใหม่ก่อนใคร",
    role: "อัปเดตใหม่มีให้ตาม ฟีเจอร์ครบทุกลูกเล่น",
    stars: 5,
    tag: "เข้าคลังใน 24 ชม.",
    content: "ค่ายปล่อยเกมไหนก็เข้าคลังภายในวันเดียว มีโหมดทดลองเล่นฟรีให้เช็กจังหวะโบนัสก่อน พอลงเงินจริงก็เจอทั้ง Multiplier, Wild ซ้อนทับ, Cascading และ Bonus Buy ครบ",
    avatar: "🆕",
  },
  {
    name: "คนที่ถอนกำไรออกทุกวัน",
    role: "โปรน่าสนใจ ฝากถอนออโต้ทันใจ",
    stars: 5,
    tag: "ไม่ต้องส่งสลิป",
    content: "โบนัสต้อนรับ โปรฝากแรกของวัน และ Cash Back คืนยอดเสียกดรับเองผ่านหน้าเว็บ ไม่ติดล็อกยูส ฝากถอนผ่าน Gateway ตรงจบใน 3-5 วินาที ไม่ต้องโอนสลิปและไม่ต้องรอคิวอนุมัติ",
    avatar: "⚡",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก GUESS168" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <div class="inline-block rounded-2xl border border-[#c58a00]/40 bg-[#231005]/88 px-6 py-3 shadow-[0_10px_30px_rgba(197,138,0,0.28)] backdrop-blur-md">
      <p class="bg-gradient-to-r from-[#fff6e0] via-[#ffd54a] to-[#fe9c01] bg-clip-text text-3xl font-black tracking-wide text-transparent">เสียงจากสมาชิก GUESS168</p>
    </div>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fecc02] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#c58a00]/40 bg-[#231005]/88 px-6 py-4 shadow-[0_10px_30px_rgba(197,138,0,0.28)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#fff6e0] to-[#c58a00] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#d8bb87]">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#33180a]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fecc02]" : "text-[#33180a]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#d8bb87]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#c58a00]/35 bg-[#231005]/88 p-6 text-left shadow-[0_10px_30px_rgba(197,138,0,0.25)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#ffd54a]/55 hover:shadow-[0_15px_40px_rgba(254,204,2,0.34)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#fecc02] to-[#fe9c01] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#33180a]/70 blur-[50px] transition-all duration-300 group-hover:bg-[#c58a00]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#c58a00]/40 bg-[#140800] px-3 py-1 text-[10px] font-bold tracking-wide text-[#ffd54a]">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fecc02]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#fecc02]" : "text-[#33180a]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f7e7c6]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#33180a] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#fecc02]/40 bg-gradient-to-br from-[#ffe680] via-[#fecc02] to-[#a35800] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f7e7c6] transition-colors group-hover:text-[#ffd54a]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#d8bb87]">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
