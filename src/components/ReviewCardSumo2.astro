---
// Widget ไม่ใช่ article: บรรทัดหัวข้อเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech
//
// FUSIONNEW: ย้ายจากทองหลวง + แดงชาดของ IOK66 (#ffe9a3 / #f0cd6a / #e3b64a /
// #b8862c / #5c3a10 คู่กับ #a3161c / #d4472a / #5c0a0c บนผิว #1c110a / #150c07 /
// #0d0705 เนื้อความ #f2e2c4 ข้อความรอง #ddc8a4) มาที่แดงสัญญาณ + โครมเงิน —
// #ff5f52 / #e01a1a / #8c0102 คู่กับ #d9dde3 / #97a0a8 / #4a5157 บนผิว #150809 /
// #1f0c0d / #0a0405 เนื้อความ #e7e3e1 ข้อความรอง #c3bcb9 เนื้อความตาม brief
const reviews = [
  {
    name: "สายปั่นที่ตามหาสล็อตยุคใหม่ที่ไม่เหมือนเดิม",
    role: "รวมเกมระดับท็อปไว้ครบทุกสไตล์",
    stars: 5,
    tag: "เกมดีฟิวชั่นครบ",
    content: "มาที่นี่แล้วเข้าใจเลยว่าคำว่าฟิวชั่นคืออะไร เกมดีจากทุกค่ายชั้นนำมารวมกันไว้จริง กราฟิกอลังการ เสียงตระการตา จะแนวผจญภัย แฟนตาซี หรือคลาสสิกก็เลือกได้หมด กดสปินทีไรก็ตื่นเต้นได้ทุกวินาที",
    avatar: "🎰",
  },
  {
    name: "คนที่เบื่อง่ายเวลาเล่นเกมเดิมซ้ำๆ",
    role: "จับเกมฮิตชนเกมใหม่ สลับฟีลได้ในหน้าเดียว",
    stars: 5,
    tag: "ไม่มีเบื่อ",
    content: "ชอบตรงที่จัดหมวดหมู่เกมมาดี เอาตัวฮิตติดระดับตำนานมาวางคู่กับเกมมาใหม่ล่าสุด อยากเปลี่ยนฟีลเมื่อไหร่ก็แค่กดเลือกเกมใหม่ในหน้าเดียว ไม่ต้องคอยสลับเว็บไปมาให้เสียเวลาอีกแล้ว",
    avatar: "🔄",
  },
  {
    name: "คนที่เคยเจอเว็บโหลดค้างตอนโบนัสกำลังมา",
    role: "ระบบไวไม่มีดรอป ฝากถอนออโต้ทำรายการไว",
    stars: 5,
    tag: "ระบบไวไม่มีดรอป",
    content: "ต่อให้เป็นช่วงที่คนเข้าเล่นเยอะ จังหวะสปินก็ยังต่อกันได้ไม่ขัดจังหวะ ไม่มีหลุดกลางคันให้เสียอารมณ์ ฝากถอนอัตโนมัติก็ทำรายการเสร็จไว เลยลุ้นรอบโบนัสกับคอมโบได้เต็มที่แบบไม่มีอะไรมารบกวนใจ",
    avatar: "⚡",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก FUSIONNEW" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <div class="inline-block rounded-2xl border border-[#e01a1a]/30 bg-[#150809]/88 px-6 py-3 shadow-[0_10px_30px_rgba(224,26,26,0.18)] backdrop-blur-md">
      <p class="bg-gradient-to-r from-[#d9dde3] via-[#ff5f52] to-[#e01a1a] bg-clip-text text-3xl font-black tracking-wide text-transparent">เสียงจากสมาชิก FUSIONNEW</p>
    </div>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e01a1a] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#e01a1a]/30 bg-[#150809]/88 px-6 py-4 shadow-[0_10px_30px_rgba(224,26,26,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#d9dde3] to-[#e01a1a] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#c3bcb9]">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#4a5157]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ff5f52]" : "text-[#4a5157]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#c3bcb9]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#e01a1a]/25 bg-[#150809]/88 p-6 text-left shadow-[0_10px_30px_rgba(224,26,26,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#ff5f52]/55 hover:shadow-[0_15px_40px_rgba(255,95,82,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#d9dde3] to-[#8c0102] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#8c0102]/35 blur-[50px] transition-all duration-300 group-hover:bg-[#e01a1a]/40" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#e01a1a]/35 bg-[#0a0405] px-3 py-1 text-[10px] font-bold tracking-wide text-[#ff5f52]">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e01a1a]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ff5f52]" : "text-[#4a5157]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#e7e3e1]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#4a5157] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e01a1a]/35 bg-gradient-to-br from-[#ff5f52] via-[#e01a1a] to-[#8c0102] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#e7e3e1] transition-colors group-hover:text-[#ff5f52]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#c3bcb9]">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
