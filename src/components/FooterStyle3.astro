---
import { BRAND_ADDRESS } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ลิงก์ด่วนชุดเดียว ใช้ .map ด้านล่าง — เดิมเขียน <a> ซ้ำหกก้อน ทำให้เพิ่ม/ลบหน้า
// ต้องไล่แก้ทีละอัน (และเป็นที่ที่ลิงก์หน้าหวยของแบรนด์ก่อนเคยค้างอยู่)
// LUCKYBKK เป็นคาสิโนสด หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ ห้ามมีลิงก์ถึง
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "ทดลองเล่นเกมฟรี", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่นสมาชิกใหม่", path: "/promotion" },
  { name: "ทางเข้าล่าสุด", path: "/ทางเข้า" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อแอดมิน", path: "/contact-us" },
];

const LOGO_ALT =
  "โลโก้ LUCKYBKK ตัวอักษร LUCKYBKK สีฟ้าน้ำแข็งไล่เงาสามมิติ ขอบน้ำเงินเข้มเรืองแสง มีสัญลักษณ์โพดำแทรกอยู่ในตัวอักษร ด้านบนเป็นโพดำสีฟ้าใส ล้อมด้วยไพ่เอซโพดำและโพแดง กับเหรียญทองกองอยู่สองข้าง";

// LUCKYBKK: ย้ายจากน้ำเงินคู่ส้มทองของ BOOST168 (#3f8cff / #9ecbff / #12306e /
// #0e1430 / #03060f คู่ทอง #ffc233 / #ffe680 / #b26a00 เนื้อความ #e6ecfb /
// #7d93c4) มาเป็นน้ำเงินรอยัลคู่ทองของแบรนด์นี้ — น้ำเงิน #3f9dfb / #cfe8ff /
// #1f5fd0 / #0a2a86 คู่ทอง #f0b323 / #ffdf7e / #9a6c05 บนผิว #030b28 / #061442 /
// #0d2160 เนื้อความ #e4eeff รองด้วย #93b4e8
---

<footer class="relative mt-32 w-full border-t border-[#f0b323]/30 bg-[#030b28] pt-64 pb-6 font-sans text-[#e4eeff] shadow-[0_-10px_30px_rgba(63,157,251,0.18)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#f0b323]/35 bg-gradient-to-r from-[#061442] via-[#1f5fd0] to-[#030b28] p-6 shadow-[0_15px_40px_rgba(63,157,251,0.35)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#f0b323] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">🃏</span> พร้อมนั่งโต๊ะเกมสด VIP กับ LUCKYBKK หรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#93b4e8] md:text-base">
        สมัคร LUCKYBKK แล้วเข้าโต๊ะได้ทันที คาสิโนสดยิงตรงสัญญาณจากสตูดิโอชั้นนำ คมชัดระดับ HD ทั้งบาคาร่า รูเล็ต เสือมังกร และไฮโล ดำเนินเกมโดยดีลเลอร์มืออาชีพ ระบบตรงไม่ผ่านเอเย่นต์ ฝากถอนออโต้ตรวจสอบย้อนหลังได้ทุกรายการ
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#f0b323] bg-gradient-to-b from-[#ffdf7e] to-[#f0b323] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#030b28] shadow-[0_0_15px_rgba(240,179,35,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🎲</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#ffdf7e] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={LOGO_ALT}
                widths={[101, 202, 303]}
                sizes="101px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(63,157,251,0.6)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#cfe8ff] to-[#0a2a86] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(63,157,251,0.55)]">LUCKYBKK</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#93b4e8]">
          LUCKYBKK คาสิโนอันดับต้นที่รวบรวมเกมสดคุณภาพ VIP จากสตูดิโอชั้นนำมาไว้ในที่เดียว ทั้งบาคาร่า รูเล็ต เสือมังกร และไฮโล ยิงตรงสัญญาณสดคมชัดระดับ HD ทั้งภาพและเสียง มีห้องเดิมพันให้เลือกตั้งแต่เบทเริ่มต้นสบายๆ
          ไปจนถึงห้องระดับ High Roller หน้าต่างการใช้งานแสดงสถิติย้อนหลังชัดเจน บนระบบตรงที่ไม่ผ่านเอเย่นต์ หลังบ้านเสถียรรองรับผู้ใช้งานพร้อมกันจำนวนมากโดยไม่หน่วง พร้อมทีมแอดมินดูแลตลอด 24 ชั่วโมง
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>

          {
            BRAND_ADDRESS.lines.length > 0 && (
              <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
                <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                  <span aria-hidden="true" class="text-sm">📍</span>
                  {BRAND_ADDRESS.label}
                </p>
                {BRAND_ADDRESS.lines.map((line) => (
                  <span class="block">{line}</span>
                ))}
                {BRAND_ADDRESS.email && (
                  <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                    <span aria-hidden="true" class="text-sm">✉️</span>
                    {BRAND_ADDRESS.email}
                  </a>
                )}
              </address>
            )
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#e4eeff] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#f0b323] to-[#3f9dfb] shadow-[0_0_8px_rgba(240,179,35,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {
            quickLinks.map((item) => (
              <a href={item.path} class="group flex items-center text-[#93b4e8] transition-colors hover:text-[#f0b323]">
                <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f0b323] transition-transform group-hover:rotate-45" />
                {item.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#e4eeff] uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#f0b323] to-[#3f9dfb] shadow-[0_0_8px_rgba(240,179,35,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#93b4e8]">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและ TrueMoney Wallet โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#061442] transition-colors hover:border-[#f0b323]/50" title="ตรวจบิลย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#e4eeff]"><span aria-hidden="true" class="text-lg text-[#f0b323]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#f0b323]/25" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#6f8dc4] md:block">
      คาสิโนอันดับต้นที่ยกระดับมาตรฐานเกมสดออนไลน์ ส่งตรงสัญญาณจากสตูดิโอชั้นนำแบบเรียลไทม์ คมชัดระดับ HD ทั้งภาพและเสียง ครบทั้งบาคาร่า รูเล็ต เสือมังกร และไฮโล ดำเนินเกมโดยดีลเลอร์มืออาชีพตลอด 24 ชั่วโมง
      คัดสรรโต๊ะเดิมพันและค่ายเกมชั้นนำมารวมไว้ในที่เดียว มีห้องให้เลือกหลากหลายระดับตั้งแต่เบทเริ่มต้นไปจนถึงห้อง High Roller พร้อมหน้าต่างแสดงสถิติย้อนหลังที่อ่านง่าย ให้วางแผนเดิมพันได้แม่นยำ ระบบตรงไม่ผ่านเอเย่นต์
      ทุกขั้นตอนโปร่งใสตรวจสอบได้จริง อัตราการจ่ายได้มาตรฐานสากล ระบบหลังบ้านเสถียรรองรับผู้ใช้งานพร้อมกันจำนวนมากโดยไม่หน่วง ฝากถอนออโต้ด้วยตัวเองในไม่กี่ขั้นตอน ทางเข้าเว็บล่าสุด ทดลองเล่นฟรี สมัครสมาชิกใหม่ LUCKYBKK
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#6f8dc4] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#f0b323] uppercase">LUCKYBKK</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#e4eeff]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#e4eeff]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#e4eeff] transition-all hover:border-[#f0b323] hover:bg-[#061442] hover:shadow-[0_0_15px_rgba(240,179,35,0.5)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
