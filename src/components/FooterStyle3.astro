---
import { BRAND_ADDRESS } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ลิงก์ด่วนชุดเดียว ใช้ .map ด้านล่าง — เดิมเขียน <a> ซ้ำหกก้อน ทำให้เพิ่ม/ลบหน้า
// ต้องไล่แก้ทีละอัน (และเป็นที่ที่ลิงก์หน้าหวยของแบรนด์ก่อนเคยค้างอยู่)
// แบรนด์นี้เป็นคาสิโนสด หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ ห้ามมีลิงก์ถึง
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "ทดลองเล่นเกมฟรี", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่นสมาชิกใหม่", path: "/promotion" },
  { name: "ทางเข้าล่าสุด", path: "/ทางเข้า" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อแอดมิน", path: "/contact-us" },
];

const LOGO_ALT =
  "โลโก้ MAHAHENG333 ตัวอักษร MAHAHENG สีเงินโครเมียมอยู่เหนือเลข 333 สีทองขนาดใหญ่ ขนาบสองข้างด้วยมังกรทองคู่ที่พันตัวขึ้นมา และมีไหอั่งเปาสีแดงที่มีเหรียญทองล้นออกมาวางอยู่ด้านล่าง";
---

<footer class="relative mt-32 w-full border-t border-[#e8b923]/30 bg-[#0a0704] pt-64 pb-6 font-sans text-[#f3e2b8] shadow-[0_-10px_30px_rgba(232,185,35,0.18)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#e8b923]/35 bg-gradient-to-r from-[#221708] via-[#6d1410] to-[#15100a] p-6 shadow-[0_15px_40px_rgba(232,185,35,0.35)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#e8b923] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">🐉</span> พร้อมนั่งโต๊ะมหาเฮงกับ MAHAHENG333 หรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#c2a469] md:text-base">
        สมัคร MAHAHENG333 แล้วเลือกโต๊ะเข้าเล่นได้ทันที คาสิโนฟลอร์ใหญ่ที่รวมเกมสดหลายโต๊ะไว้ในล็อบบี้เดียว ทั้งบาคาร่า รูเล็ต เสือมังกร และไฮโล ถ่ายทอดสดจากคาสิโนจริงระดับ HD ฝากถอน 5 วิ ดูแลตลอด 24 ชั่วโมง
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#e8b923] bg-gradient-to-b from-[#ffe98a] to-[#e8b923] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#1a1006] shadow-[0_0_15px_rgba(232,185,35,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🧧</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#ffe98a] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={LOGO_ALT}
                widths={[101, 202, 303]}
                sizes="101px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(232,185,35,0.6)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#ffe98a] to-[#a5760a] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(232,185,35,0.55)]">MAHAHENG333</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#c2a469]">
          MAHAHENG333 อาณาจักรคาสิโนสดที่ยกฟลอร์เดิมพันชั้นนำมาไว้ในมือถือ คัดเฉพาะค่ายเกมสดชื่อดังระดับโลกมารวมไว้ในล็อบบี้เดียว ทุกโต๊ะถ่ายทอดสดตรงจากคาสิโนจริง ภาพคมชัดระดับ HD ไร้ดีเลย์
          มีดีลเลอร์มืออาชีพประจำโต๊ะตลอด 24 ชั่วโมง เลือกห้องได้ตามใจ สลับโต๊ะได้ในคลิกเดียวโดยไม่ต้องโยกเงิน และระบบการเงินออโต้ที่เคลียร์ยอดให้ภายใน 5 วินาที
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>

          {
            BRAND_ADDRESS.lines.length > 0 && (
              <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
                <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                  <span aria-hidden="true" class="text-sm">📍</span>
                  {BRAND_ADDRESS.label}
                </p>
                {BRAND_ADDRESS.lines.map((line) => (
                  <span class="block">{line}</span>
                ))}
                {BRAND_ADDRESS.email && (
                  <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                    <span aria-hidden="true" class="text-sm">✉️</span>
                    {BRAND_ADDRESS.email}
                  </a>
                )}
              </address>
            )
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f3e2b8] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#e8b923] to-[#b4231c] shadow-[0_0_8px_rgba(232,185,35,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {
            quickLinks.map((item) => (
              <a href={item.path} class="group flex items-center text-[#c2a469] transition-colors hover:text-[#e8b923]">
                <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#e8b923] transition-transform group-hover:rotate-45" />
                {item.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f3e2b8] uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#e8b923] to-[#b4231c] shadow-[0_0_8px_rgba(232,185,35,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#c2a469]">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและ TrueMoney Wallet โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#221708] transition-colors hover:border-[#e8b923]/50" title="ตรวจบิลย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#f3e2b8]"><span aria-hidden="true" class="text-lg text-[#e8b923]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#e8b923]/25" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#9a8253] md:block">
      คาสิโนฟลอร์ใหญ่ เปิดโต๊ะมหาเฮง รวมเกมสดหลายโต๊ะไว้ในล็อบบี้เดียว ทั้งบาคาร่า รูเล็ต เสือมังกร และไฮโล ถ่ายทอดสดตรงจากคาสิโนจริงด้วยสตรีมมิ่งความละเอียดสูง สัญญาณคมชัดระดับ HD ไร้การดีเลย์
      หน้าต่างเลือกห้องจัดเรียงเป็นระเบียบ แสดงสถิติย้อนหลังและรายละเอียดของแต่ละโต๊ะอย่างชัดเจน อยากได้โต๊ะสปีดเกมไวหรือโต๊ะบรรยากาศสบายๆ ก็ปรับให้เข้ากับสไตล์การเล่นได้ทันที สลับโต๊ะได้ในคลิกเดียว
      ไม่ต้องโยกเงินหรือออกจากระบบ ระบบการเงินออโต้ไฮสปีดเคลียร์ยอดฝากถอนภายใน 5 วินาที ไม่ต้องส่งสลิปยืนยัน ทีมงานมืออาชีพดูแลตลอด 24 ชั่วโมง ทางเข้าเว็บล่าสุด ทดลองเล่นฟรี สมัครสมาชิกใหม่ MAHAHENG333
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#9a8253] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#e8b923] uppercase">MAHAHENG333</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#f3e2b8]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f3e2b8]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#f3e2b8] transition-all hover:border-[#e8b923] hover:bg-[#221708] hover:shadow-[0_0_15px_rgba(232,185,35,0.5)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
