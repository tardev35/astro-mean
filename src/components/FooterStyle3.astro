---
import { BRAND_ADDRESS } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ลิงก์ด่วนชุดเดียว ใช้ .map ด้านล่าง — เดิมเขียน <a> ซ้ำหกก้อน ทำให้เพิ่ม/ลบหน้า
// ต้องไล่แก้ทีละอัน (และเป็นที่ที่ลิงก์หน้าหวยของแบรนด์ก่อนเคยค้างอยู่)
// PHOENIX168 เป็นเว็บสล็อต หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ ห้ามมีลิงก์ถึง
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "ทดลองเล่นเกมฟรี", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่นสมาชิกใหม่", path: "/promotion" },
  { name: "ทางเข้าล่าสุด", path: "/ทางเข้า" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อแอดมิน", path: "/contact-us" },
];

const LOGO_ALT =
  "โลโก้ PHOENIX168 ตัวอักษร X ขนาดใหญ่สีเงินเหล็ก มีนกฟีนิกซ์สีแดงส้มกางปีกเปลวไฟสีทองอยู่ด้านหน้า ใต้ลงมาเป็นแผ่นป้ายสีดำขอบเทาเขียนว่า PHOENIX ด้วยตัวอักษรไล่เฉดส้มทอง และเลข 168 สีขาวเงินอยู่บรรทัดล่าง";

// PHOENIX168: ย้ายจากทองคลับคู่แพลทินัมของแบรนด์ก่อน มาเป็นไฟฟีนิกซ์คู่ทองของ
// แบรนด์นี้ — ส้มไฟ #ff5a1e / #ffa14a / #ffe2c4 / #c04a12 / #7a2408 คู่ทอง
// #f4dc6d / #f3ac3c บนผิว #0a0402 / #1f0a05 / #2c0e06 เนื้อความ #f2ddc9
// รองด้วย #c0a58c และหมายเหตุตัวเล็ก #9a8574
//
// ทองมาจากปลายขนปีกกับเลข 168 ในโลโก้ จึงใช้เป็นสีคู่ของเส้นใต้หัวคอลัมน์และ
// หัวลูกศรลิงก์ด่วน ส่วนส้มไฟคุมโครงสร้างหลักทั้งขอบและปุ่ม CTA
//
// บล็อก <address> ด้านล่างวางตามที่ playbook กำหนดแบบคำต่อคำ — ไม่ใส่สีของแบรนด์
// ลงไป (border-white/15 + bg-black/20 + opacity ทำงานได้กับ footer ทุก variant
// ซึ่งเป็นพื้นเข้มทั้งหมด) ห้าม retype ข้อความข้างในเอง มาจาก BRAND_ADDRESS
---

<footer class="relative mt-32 w-full border-t border-[#7a2408]/35 bg-[#0a0402] pt-64 pb-6 font-sans text-[#f2ddc9] shadow-[0_-10px_30px_rgba(122,36,8,0.25)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#ff5a1e]/35 bg-gradient-to-r from-[#1f0a05] via-[#7a2408] to-[#0a0402] p-6 shadow-[0_15px_40px_rgba(192,74,18,0.45)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#ff5a1e] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">🔥</span> พร้อมติดปีกทะยานไปกับ PHOENIX168 หรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#c0a58c] md:text-base">
        สมัคร PHOENIX168 แล้วพุ่งตรงเข้าล็อบบี้ได้ในคลิกเดียว เกมสล็อตลิขสิทธิ์แท้จาก PG Soft, Pragmatic Play และ Joker Gaming มาครบ คัดเฉพาะตัวที่แตกง่าย ฟีเจอร์ตัวคูณหนัก ฟรีสปินเข้าไว กระเป๋าเดียวสลับค่ายได้ทันที ฝากถอนออโต้ไฮสปีดเสร็จในไม่กี่วินาที
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#ff5a1e] bg-gradient-to-b from-[#ffa14a] to-[#ff5a1e] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#0a0402] shadow-[0_0_15px_rgba(255,90,30,0.5)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🎁</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#ffa14a] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={LOGO_ALT}
                widths={[101, 202, 303]}
                sizes="101px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(192,74,18,0.7)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#ffa14a] to-[#7a2408] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(192,74,18,0.6)]">PHOENIX168</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#c0a58c]">
          PHOENIX168 เว็บตรงสล็อตสายสปีดที่ตั้งใจทำระบบออกมาให้คนเล่นใช้งานได้จริงแบบไม่มีสะดุด ยิงตรง API แท้จากค่ายใหญ่ เซิร์ฟนอกมาตรฐานสากล เล่นแล้วโบนัสแตกตามอัตราจ่ายจริง ไม่มีดัดแปลงเปอร์เซ็นต์ชนะ
          คลังเกมจัดเต็มด้วยสล็อตลิขสิทธิ์แท้จากค่ายดังอย่าง PG Soft, Pragmatic Play, Joker Gaming และค่ายชั้นนำอื่นๆ คัดมาเฉพาะตัวที่แตกง่าย มีฟีเจอร์ตัวคูณหนัก ฟรีสปินเข้าไว และมีอัตราการจ่ายเงินรางวัลที่ยุติธรรม
          ระบบฝากถอนออโต้ไฮสปีดทำรายการเสร็จในไม่กี่วินาที ไม่ต้องส่งสลิป ไม่ต้องคอยแอดมินอนุมัติ ปั่นได้เท่าไหร่ถอนออกได้ครบเต็มจำนวนทันที
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>

          {
            BRAND_ADDRESS.lines.length > 0 && (
              <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
                <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                  <span aria-hidden="true" class="text-sm">📍</span>
                  {BRAND_ADDRESS.label}
                </p>
                {BRAND_ADDRESS.lines.map((line) => (
                  <span class="block">{line}</span>
                ))}
                {BRAND_ADDRESS.email && (
                  <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                    <span aria-hidden="true" class="text-sm">✉️</span>
                    {BRAND_ADDRESS.email}
                  </a>
                )}
              </address>
            )
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f2ddc9] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#ff5a1e] to-[#f3ac3c] shadow-[0_0_8px_rgba(255,90,30,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {
            quickLinks.map((item) => (
              <a href={item.path} class="group flex items-center text-[#c0a58c] transition-colors hover:text-[#ff5a1e]">
                <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f3ac3c] transition-transform group-hover:rotate-45" />
                {item.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f2ddc9] uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#ff5a1e] to-[#f3ac3c] shadow-[0_0_8px_rgba(255,90,30,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#c0a58c]">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและ TrueMoney Wallet โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#1f0a05] transition-colors hover:border-[#c04a12]/50" title="ตรวจบิลย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#f2ddc9]"><span aria-hidden="true" class="text-lg text-[#ff5a1e]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#7a2408]/30" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#9a8574] md:block">
      สล็อตสายสปีดที่ตัดระบบเอเย่นต์และขั้นตอนยุ่งยากออกทั้งหมด กดเข้าหน้าเว็บปุ๊บก็พร้อมลุยปั๊บ ปรับจูนระบบหลังบ้านมาให้โหลดไวกว่าเว็บทั่วไปหลายเท่า ไม่ต้องนั่งมองหน้าจอหมุนค้างให้เสียอารมณ์ พาคุณพุ่งตรงจากหน้าแรกเข้าสู่ตัวเกมได้ในคลิกเดียว ช่วยให้ไม่พลาดจังหวะสำคัญในการทำกำไรและเริ่มสปินได้ทันทีโดยไม่ต้องเสียเวลารอ
      ไม่ต้องเสียเวลาสมัครหลายเว็บเพื่อเล่นเกมที่ชอบ เพราะหน้าล็อบบี้จัดวางหมวดหมู่เกมไว้อย่างเป็นระเบียบ รวบรวมทั้งสล็อตสายภาพสวย 3D สล็อตสตรีตนำโชค หรือสล็อตสายซื้อฟีเจอร์พุ่งชนโบนัส อยากเล่นแนวไหนก็กดเลือกได้ทันทีในกระเป๋าเดียว ไม่ต้องย้ายเว็บ ไม่ต้องโยกเงินให้วุ่นวาย
      ความรู้สึกตอนสลับเกมคืออีกหนึ่งเรื่องที่ทำมาดีมาก สลับค่ายสลับเกมได้ทันทีโดยไม่ต้องรอโหลดหน้าคีย์ข้อมูลใหม่ ตัวเกมประมวลผลสมูธ กราฟิกแสดงผลคมชัด ไม่มีอาการกระตุกหรือหลุดออกจากเกมให้เสียจังหวะ พร้อมปรับสเกลหน้าจอให้อัตโนมัติทั้งมือถือ iOS, Android, แท็บเล็ต และคอมพิวเตอร์ ปุ่มกดวางในตำแหน่งที่ใช้นิ้วโป้งกดง่าย
      ไม่มีปิดปรับปรุงระบบแบบไม่แจ้งล่วงหน้า วางเซิร์ฟเวอร์เสถียรสูงที่พร้อมเปิดให้บริการตลอด 24 ชั่วโมง จะเป็นสายปั่นช่วงพักเที่ยงหรือสายลุยดึกๆ จังหวะโบนัสและระบบฝากถอนก็ทำงานด้วยความเร็วสูงสุดเท่ากันตลอดวัน ทางเข้าลิงก์ตรงอัปเดตใหม่ ทดลองเล่นฟรี สมัครสมาชิกใหม่ PHOENIX168
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#9a8574] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#ff5a1e] uppercase">PHOENIX168</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#f2ddc9]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f2ddc9]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#f2ddc9] transition-all hover:border-[#c04a12] hover:bg-[#1f0a05] hover:shadow-[0_0_15px_rgba(192,74,18,0.6)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
