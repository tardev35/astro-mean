---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ลิงก์ด่วนชุดเดียว ใช้ .map ด้านล่าง — เดิมเขียน <a> ซ้ำหกก้อน ทำให้เพิ่ม/ลบหน้า
// ต้องไล่แก้ทีละอัน (และเป็นที่ที่ลิงก์หน้าหวยของแบรนด์ก่อนเคยค้างอยู่)
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "ทดลองเล่นเกมฟรี", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่นสมาชิกใหม่", path: "/promotion" },
  { name: "ทางเข้าล่าสุด", path: "/ทางเข้า" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "ติดต่อแอดมิน", path: "/contact-us" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
];
---

<footer
  class="relative mt-32 w-full border-t border-[#fcda3d]/30 bg-[#0b0616] pt-64 pb-6 font-sans text-[#efe3f7] shadow-[0_-10px_30px_rgba(252,218,61,0.15)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#fcda3d]/35 bg-gradient-to-r from-[#12071f] via-[#2c014b] to-[#1a0b2e] p-6 shadow-[0_15px_40px_rgba(139,47,201,0.35)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#ffe98a] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl"><span aria-hidden="true">🎰</span> พร้อมปั่นกับ KUMI99 แล้วหรือยัง?</p>
      <p class="mt-2 text-sm font-medium text-[#bda6cf] md:text-base">
        สมัคร KUMI99 แล้วเข้าเล่นได้ทันที รวมค่ายดังไว้ในบัญชีเดียว ฝากถอนไวภายใน 3 วิ ผ่านระบบออโต้ ไม่ต้องแจ้งสลิป เข้าเล่นได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#ffe98a] bg-gradient-to-b from-[#ffe98a] to-[#a9760d] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#2a1400] shadow-[0_0_15px_rgba(252,218,61,0.4)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div class="absolute inset-0 translate-y-full bg-[#fcda3d] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ KUMI99 ตัวอักษรทองบนโล่ม่วง มีแพนด้าใส่แว่นดำอยู่ด้านหลัง"
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(252,218,61,0.6)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#ffe98a] to-[#a9760d] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(252,218,61,0.5)]">KUMI99</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#bda6cf]">
          KUMI99 วางแกนหลักไว้ที่สล็อตออนไลน์ คัดค่ายเด็ดเข้าไม่พักและอัปเดตเกมใหม่มาแรงอยู่ตลอด แบ่งหมวดตามค่ายผู้พัฒนาและรูปแบบการเล่น ทั้งแนวแอคชันผจญภัยและสไตล์คลาสสิก
          พร้อมระบบฝากถอนออโต้ที่ทำรายการเสร็จภายใน 3 วิ
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#efe3f7] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#a9760d] to-[#ffe98a] shadow-[0_0_8px_rgba(252,218,61,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {
            quickLinks.map((item) => (
              <a href={item.path} class="group flex items-center text-[#bda6cf] transition-colors hover:text-[#ffe98a]">
                <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fcda3d] transition-transform group-hover:rotate-45" />
                {item.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#efe3f7] uppercase">
          ระบบการเงิน
          <span class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#a9760d] to-[#ffe98a] shadow-[0_0_8px_rgba(252,218,61,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#bda6cf]">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและ TrueMoney Wallet โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#1a0b2e] transition-colors hover:border-[#fcda3d]/50" title="ตรวจบิลย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#efe3f7]"><span aria-hidden="true" class="text-lg text-[#fcda3d]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#fcda3d]/25" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#9b86ad] md:block">
      สล็อตออนไลน์ตัวท็อป เกมใหม่มาแรง คัดค่ายเด็ดเข้าไม่พัก อัปเดตไม่หยุด โบนัสโคตรคุ้ม ฟรีสปิน ตัวคูณ สัญลักษณ์พิเศษ ฝากถอนไวภายใน 3 วิ ระบบออโต้ไม่ต้องแจ้งสลิป ระบบไวเกินต้าน
      รองรับสมาร์ทโฟน แท็บเล็ต คอมพิวเตอร์ ทางเข้าเว็บล่าสุด ทดลองเล่นฟรี สมัครสมาชิกใหม่ KUMI99
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#9b86ad] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#ffe98a] uppercase">KUMI99</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#efe3f7]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#efe3f7]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#efe3f7] transition-all hover:border-[#ffe98a] hover:bg-[#2c014b] hover:shadow-[0_0_15px_rgba(252,218,61,0.5)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
