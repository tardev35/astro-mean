---
import { BRAND_ADDRESS } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ลิงก์ด่วนชุดเดียว ใช้ .map ด้านล่าง — เดิมเขียน <a> ซ้ำหกก้อน ทำให้เพิ่ม/ลบหน้า
// ต้องไล่แก้ทีละอัน (และเป็นที่ที่ลิงก์หน้าหวยของแบรนด์ก่อนเคยค้างอยู่)
// BOOST168 เป็นเว็บสล็อต หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ ห้ามมีลิงก์ถึง
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "ทดลองเล่นเกมฟรี", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่นสมาชิกใหม่", path: "/promotion" },
  { name: "ทางเข้าล่าสุด", path: "/ทางเข้า" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อแอดมิน", path: "/contact-us" },
];

const LOGO_ALT =
  "โลโก้ BOOST168 ตัวอักษร BOOST สีเงินโครเมียมขอบน้ำเงินต่อด้วยเลข 168 สีทองส้ม มีจรวดสีเงินหัวแดงพุ่งขึ้นพร้อมเปลวไฟสีส้มทองโค้งอยู่ด้านบน ใต้ตัวอักษรเป็นแถบไอคอนจอยเกม โพดำ ข้าวหลามตัด โพแดง ดอกจิก และลูกเต๋าสีทอง";
---

<footer class="relative mt-32 w-full border-t border-[#ffc233]/30 bg-[#03060f] pt-64 pb-6 font-sans text-[#e6ecfb] shadow-[0_-10px_30px_rgba(63,140,255,0.18)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#ffc233]/35 bg-gradient-to-r from-[#0e1430] via-[#12306e] to-[#050818] p-6 shadow-[0_15px_40px_rgba(63,140,255,0.35)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#ffc233] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">🚀</span> พร้อมบูสต์ความมันส์กับ BOOST168 หรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#9ecbff] md:text-base">
        สมัคร BOOST168 แล้วเข้าปั่นได้ทันที สล็อตเว็บตรงจัดหนักที่อัปคลังเกมใหม่ให้มีตัวเด็ดตามต่อไม่ขาดช่วง เกมดีมีบูสต์ทั้งฟีเจอร์คูณเงินรางวัลและฟรีสปิน ระบบไวไม่เกินจริง พร้อมออโต้ตั้งแต่สมัครถึงฝากถอน
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#ffc233] bg-gradient-to-b from-[#ffe680] to-[#ffc233] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#0a0f22] shadow-[0_0_15px_rgba(255,194,51,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#ffe680] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={LOGO_ALT}
                widths={[101, 202, 303]}
                sizes="101px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(255,194,51,0.6)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#ffe680] to-[#b26a00] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(255,194,51,0.55)]">BOOST168</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#9ecbff]">
          BOOST168 สล็อตเว็บตรงจัดหนักที่ขนเกมตัวตึงจากทุกค่ายชั้นนำมารวบรวมไว้ให้เลือกเล่นอย่างจุใจ ทั้งแนวสตรีทสุดมันส์ แฟนตาซีเวทมนตร์ และคลาสสิกโบนัสแตกง่าย ทุกเกมคัดมาแล้วว่ากราฟิกสวยและมีจังหวะจ่ายรางวัลที่น่าลุ้น
          เสริมด้วยฟีเจอร์สุ่มคูณเงินรางวัล รีสปินล็อกสัญลักษณ์ และโหมดฟรีสปินที่เข้าถึงง่าย บนระบบหลังบ้านที่ตอบสนองไวแบบพอดี ไม่มีกระตุกหรือเกมหลุด และมีออโต้ช่วยลดขั้นตอนตั้งแต่สมัครจนถึงฝากถอน
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>

          {
            BRAND_ADDRESS.lines.length > 0 && (
              <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
                <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                  <span aria-hidden="true" class="text-sm">📍</span>
                  {BRAND_ADDRESS.label}
                </p>
                {BRAND_ADDRESS.lines.map((line) => (
                  <span class="block">{line}</span>
                ))}
                {BRAND_ADDRESS.email && (
                  <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                    <span aria-hidden="true" class="text-sm">✉️</span>
                    {BRAND_ADDRESS.email}
                  </a>
                )}
              </address>
            )
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#e6ecfb] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#ffc233] to-[#3f8cff] shadow-[0_0_8px_rgba(255,194,51,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {
            quickLinks.map((item) => (
              <a href={item.path} class="group flex items-center text-[#9ecbff] transition-colors hover:text-[#ffc233]">
                <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ffc233] transition-transform group-hover:rotate-45" />
                {item.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#e6ecfb] uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#ffc233] to-[#3f8cff] shadow-[0_0_8px_rgba(255,194,51,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#9ecbff]">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและ TrueMoney Wallet โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#0e1430] transition-colors hover:border-[#ffc233]/50" title="ตรวจบิลย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#e6ecfb]"><span aria-hidden="true" class="text-lg text-[#ffc233]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#ffc233]/25" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#7d93c4] md:block">
      สล็อตเว็บตรงจัดหนัก อัปคลังเกมใหม่ให้มีตัวเด็ดตามต่อไม่ขาดช่วง รวมเกมตัวตึงจากทุกค่ายชั้นนำไว้ในล็อบบี้เดียว ครบทั้งแนวสตรีท แฟนตาซี และคลาสสิกโบนัสแตกง่าย เกมดีมีบูสต์ด้วยฟีเจอร์สุ่มคูณเงินรางวัล
      ฟีเจอร์รีสปินล็อกสัญลักษณ์ และโหมดฟรีสปินที่ออกบ่อยเข้าถึงง่าย พร้อมโบนัสหลายรูปแบบทั้งโปรโมชันต้อนรับสมาชิกใหม่ โบนัสเติมเงินรายวัน และกิจกรรมคืนกำไรให้ผู้เล่น ระบบไวไม่เกินจริง หน้าเว็บโหลดฉับไว
      กดเข้าเกมได้ทันทีโดยไม่ต้องรอ สัญญาณเชื่อมต่อตรงกับค่ายเกมหลักอย่างเสถียร ไม่มีอาการกระตุกหรือเกมหลุด ลดขั้นตอนด้วยระบบออโต้ตั้งแต่สมัครสมาชิก กดรับโปรโมชัน ไปจนถึงฝากถอน ทางเข้าเว็บล่าสุด ทดลองเล่นฟรี สมัครสมาชิกใหม่ BOOST168
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#7d93c4] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#ffc233] uppercase">BOOST168</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#e6ecfb]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#e6ecfb]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#e6ecfb] transition-all hover:border-[#ffc233] hover:bg-[#0e1430] hover:shadow-[0_0_15px_rgba(255,194,51,0.5)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
