---
import { BRAND_ADDRESS } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ลิงก์ด่วนชุดเดียว ใช้ .map ด้านล่าง — เดิมเขียน <a> ซ้ำหกก้อน ทำให้เพิ่ม/ลบหน้า
// ต้องไล่แก้ทีละอัน (และเป็นที่ที่ลิงก์หน้าหวยของแบรนด์ก่อนเคยค้างอยู่)
// แบรนด์นี้เป็นสล็อต/คาสิโน หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ ห้ามมีลิงก์ถึง
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "ทดลองเล่นเกมฟรี", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่นสมาชิกใหม่", path: "/promotion" },
  { name: "ทางเข้าล่าสุด", path: "/ทางเข้า" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อแอดมิน", path: "/contact-us" },
];
---

<footer class="relative mt-32 w-full border-t border-[#fae61c]/30 bg-[#080703] pt-64 pb-6 font-sans text-[#f0ead6] shadow-[0_-10px_30px_rgba(250,230,28,0.16)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#fae61c]/35 bg-gradient-to-r from-[#211d07] via-[#2b2606] to-[#14120a] p-6 shadow-[0_15px_40px_rgba(250,230,28,0.35)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#ffd60a] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl"><span aria-hidden="true">⚡</span> พร้อมฟาดกับ THUNDER87 แล้วหรือยัง?</p>
      <p class="mt-2 text-sm font-medium text-[#b8b195] md:text-base">
        สมัคร THUNDER87 แล้วลุยได้ทันที สล็อตฟอร์มฟาดที่ขนเกมค่ายดังมาลงแน่นแบบไม่หวง รวมคาสิโนสดและบาคาร่าไว้เต็มล็อบบี้ ระบบออโต้แรงไม่มีสะดุด ฝากถอนไวไม่ผ่านคนกลาง
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#ffd60a] bg-gradient-to-b from-[#fff89a] to-[#fae61c] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#080703] shadow-[0_0_15px_rgba(255,214,10,0.4)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#fff89a] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ THUNDER87 ตัวอักษร THUNDER สีขาว คั่นกลางด้วยสายฟ้าสีเหลือง และเลข 87 สีเหลือง"
                widths={[101, 202, 303]}
                sizes="101px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(250,230,28,0.6)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#fff89a] to-[#fae61c] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(250,230,28,0.5)]">THUNDER87</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#b8b195]">
          THUNDER87 สล็อตฟอร์มฟาดที่ยกความบันเทิงระดับพรีเมียมมาไว้ครบในที่เดียว ทั้งสล็อตค่ายดัง คาสิโนสด และบาคาร่า เลือกสลับได้ในยูสเซอร์เดียวไม่ต้องโยกเงินให้ยุ่งยาก
          ระบบประมวลผลแรงและเสถียร กดเข้าเกมฉับไว สลับค่ายลื่นไหลไม่มีกระตุก
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>

          {
            BRAND_ADDRESS.lines.length > 0 && (
              <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
                <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                  <span aria-hidden="true" class="text-sm">📍</span>
                  {BRAND_ADDRESS.label}
                </p>
                {BRAND_ADDRESS.lines.map((line) => (
                  <span class="block">{line}</span>
                ))}
                {BRAND_ADDRESS.email && (
                  <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                    <span aria-hidden="true" class="text-sm">✉️</span>
                    {BRAND_ADDRESS.email}
                  </a>
                )}
              </address>
            )
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f0ead6] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#fae61c] to-[#ffd60a] shadow-[0_0_8px_rgba(250,230,28,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {
            quickLinks.map((item) => (
              <a href={item.path} class="group flex items-center text-[#b8b195] transition-colors hover:text-[#ffd60a]">
                <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fae61c] transition-transform group-hover:rotate-45" />
                {item.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f0ead6] uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#fae61c] to-[#ffd60a] shadow-[0_0_8px_rgba(250,230,28,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#b8b195]">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและ TrueMoney Wallet โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#14120a] transition-colors hover:border-[#fae61c]/50" title="ตรวจบิลย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#f0ead6]"><span aria-hidden="true" class="text-lg text-[#ffd60a]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#fae61c]/25" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#97907a] md:block">
      สล็อตฟอร์มฟาด เกมครบแบบไม่หวง รวมค่ายเกมชั้นนำระดับโลกทั้งค่ายใหญ่ในกระแสและค่ายดังเฉพาะกลุ่ม งานภาพคมชัด อัตราการจ่ายสมน้ำสมเนื้อ ไม่มีคำว่ากั๊กฟีเจอร์ ครบทั้งสล็อต
      คาสิโนสด และบาคาร่าในยูสเซอร์เดียว ระบบออโต้สปีดแรง เข้าเกมคล่อง สลับค่ายไว ฝากถอนเป็นระบบทำรายการไว รองรับสมาร์ทโฟน แท็บเล็ต คอมพิวเตอร์ ทางเข้าเว็บล่าสุด ทดลองเล่นฟรี สมัครสมาชิกใหม่ THUNDER87
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#97907a] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#ffd60a] uppercase">THUNDER87</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#f0ead6]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f0ead6]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#f0ead6] transition-all hover:border-[#ffd60a] hover:bg-[#2b2606] hover:shadow-[0_0_15px_rgba(250,230,28,0.5)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
