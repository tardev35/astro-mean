---
import { BRAND_ADDRESS } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ลิงก์ด่วนชุดเดียว ใช้ .map ด้านล่าง — เดิมเขียน <a> ซ้ำหกก้อน ทำให้เพิ่ม/ลบหน้า
// ต้องไล่แก้ทีละอัน (และเป็นที่ที่ลิงก์หน้าหวยของแบรนด์ก่อนเคยค้างอยู่)
// แบรนด์นี้เป็นสล็อต/คาสิโน หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ ห้ามมีลิงก์ถึง
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "ทดลองเล่นเกมฟรี", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่นสมาชิกใหม่", path: "/promotion" },
  { name: "ทางเข้าล่าสุด", path: "/ทางเข้า" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อแอดมิน", path: "/contact-us" },
];

const LOGO_ALT =
  "โลโก้ TANGTEM168 หมูการ์ตูนสวมสูทและแว่นตากลมสีดำ ยกมือทั้งสองข้างขึ้นเหนือกองเหรียญทองและซองอั่งเปาสีแดง ด้านล่างเป็นตัวอักษร TANGTEM สีทองขอบม่วง และเลข 168 สีขาวบนแถบสีทอง";
---

<footer class="relative mt-32 w-full border-t border-[#fcc30b]/30 bg-[#1c0620] pt-64 pb-6 font-sans text-[#f7e6c4] shadow-[0_-10px_30px_rgba(252,195,11,0.18)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#fcc30b]/35 bg-gradient-to-r from-[#3c0f52] via-[#54178f] to-[#2a0a2e] p-6 shadow-[0_15px_40px_rgba(252,195,11,0.35)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#fcc30b] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl"><span aria-hidden="true">🎰</span> พร้อมสัมผัสตังเต็มระบบกับ TANGTEM168 หรือยัง?</p>
      <p class="mt-2 text-sm font-medium text-[#c3a98e] md:text-base">
        สมัคร TANGTEM168 แล้วกดสปินได้ทันที เว็บตรงสล็อตชื่อดังที่คัดเกมตัวเด็ดจากค่ายดังระดับโลกมาไว้หน้าเดียว อัตราการแตกตรงไปตรงมา ระบบการเงินแบ่งทุกขั้นตอนชัด จัดการเองได้ ปลอดภัย 100%
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#fcc30b] bg-gradient-to-b from-[#ffe9a8] to-[#fcc30b] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#2a0a2e] shadow-[0_0_15px_rgba(252,195,11,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🧧</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#ffe9a8] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={LOGO_ALT}
                widths={[101, 202, 303]}
                sizes="101px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(252,195,11,0.6)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#ffe9a8] to-[#e09a05] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(252,195,11,0.55)]">TANGTEM168</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#c3a98e]">
          TANGTEM168 เว็บตรงสล็อตชื่อดังที่มาพร้อมคอนเซปต์ตังเต็มระบบ ระบบพัฒนาให้เสถียรสูง อัตราการแตกของแจ็คพอตตรงไปตรงมา ไม่มีการปรับลดเปอร์เซ็นต์การชนะ
          รวมเกมตัวเด็ด ตัวฮิต และเกมแตกง่ายจากค่ายดังระดับโลกไว้ในหน้าเดียว ไม่ต้องโยกเงินหรือสลับเว็บ ระบบการเงินแบ่งทุกขั้นตอนชัดเจน จัดการได้ด้วยตัวเองผ่านหน้าเว็บ
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>

          {
            BRAND_ADDRESS.lines.length > 0 && (
              <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
                <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                  <span aria-hidden="true" class="text-sm">📍</span>
                  {BRAND_ADDRESS.label}
                </p>
                {BRAND_ADDRESS.lines.map((line) => (
                  <span class="block">{line}</span>
                ))}
                {BRAND_ADDRESS.email && (
                  <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                    <span aria-hidden="true" class="text-sm">✉️</span>
                    {BRAND_ADDRESS.email}
                  </a>
                )}
              </address>
            )
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f7e6c4] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#fcc30b] to-[#7e3ac7] shadow-[0_0_8px_rgba(252,195,11,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {
            quickLinks.map((item) => (
              <a href={item.path} class="group flex items-center text-[#c3a98e] transition-colors hover:text-[#fcc30b]">
                <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fcc30b] transition-transform group-hover:rotate-45" />
                {item.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f7e6c4] uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#fcc30b] to-[#7e3ac7] shadow-[0_0_8px_rgba(252,195,11,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#c3a98e]">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและ TrueMoney Wallet โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#2a0a2e] transition-colors hover:border-[#fcc30b]/50" title="ตรวจบิลย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#f7e6c4]"><span aria-hidden="true" class="text-lg text-[#fcc30b]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#fcc30b]/25" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#a08a72] md:block">
      เว็บตรงสล็อตชื่อดัง ตังเต็มระบบ คัดตัวฮิตหลายค่ายมาไว้หน้าเดียว ทั้งเกมแนวสตรีทสุดมันส์ แนวแฟนตาซีอลังการ และแนวคลาสสิกเล่นง่าย ทุกเกมผ่านการคัดสรรมาแล้วว่าทำเงินได้จริงและภาพสวยสมจริง
      อัตราการแตกของแจ็คพอตตรงไปตรงมา ไม่มีการปรับลดเปอร์เซ็นต์การชนะ สิทธิพิเศษเติมทุนสม่ำเสมอ ทั้งโปรโมชันต้อนรับ โบนัสประจำวัน และเครดิตคืนยอดเสีย ระบบการเงินแบ่งทุกขั้นตอนชัดเจน
      ฝาก ถอน เช็กประวัติย้อนหลัง จัดการเองได้ผ่านหน้าเว็บ ปลอดภัย 100% ด้วยการเข้ารหัสขั้นสูง รองรับสมาร์ทโฟน แท็บเล็ต คอมพิวเตอร์ ทางเข้าเว็บล่าสุด ทดลองเล่นฟรี สมัครสมาชิกใหม่ TANGTEM168
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#a08a72] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#fcc30b] uppercase">TANGTEM168</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#f7e6c4]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f7e6c4]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#f7e6c4] transition-all hover:border-[#fcc30b] hover:bg-[#3c0f52] hover:shadow-[0_0_15px_rgba(252,195,11,0.5)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
