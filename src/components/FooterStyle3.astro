---
import { BRAND_ADDRESS } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ลิงก์ด่วนชุดเดียว ใช้ .map ด้านล่าง — เดิมเขียน <a> ซ้ำหกก้อน ทำให้เพิ่ม/ลบหน้า
// ต้องไล่แก้ทีละอัน (และเป็นที่ที่ลิงก์หน้าหวยของแบรนด์ก่อนเคยค้างอยู่)
// SBOGOOL เป็นสล็อต/กีฬา หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ ห้ามมีลิงก์ถึง
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "ทดลองเล่นเกมฟรี", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่นสมาชิกใหม่", path: "/promotion" },
  { name: "ทางเข้าล่าสุด", path: "/ทางเข้า" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อแอดมิน", path: "/contact-us" },
];

const LOGO_ALT =
  "โลโก้ SBOGOOL เป็นรูปนักวิ่งลายเส้นโค้งสีน้ำเงินซ้อนเงาเทา ถัดมาเป็นตัวอักษร SBO สีเงินโครเมียมต่อด้วย GOOL สีน้ำเงินเข้ม โดยตัว O ตัวหนึ่งเป็นลูกฟุตบอลล้อมด้วยเส้นโค้งหลากสี ใต้ข้อความเขียนว่า NUMBER ONE SPORT GAME IN THE WORLD";

// SBOGOOL: ย้ายจากม่วงลึกคู่มาเจนต้าของแบรนด์ก่อน มาเป็นน้ำเงินรอยัลสนามไฟคู่ทอง
// ของแบรนด์นี้ — น้ำเงิน #1e4bb8 / #2f6fe4 / #5b9cff / #7fb0ff / #0b1f52 คู่ทอง
// #f5c518 / #ffe07a / #a87908 บนผิว #030b22 / #071433 / #0d1f4d เนื้อความ
// #dce7fb รองด้วย #93a9d4 / #6b80ad
//
// บล็อก <address> ด้านล่างวางตามที่ playbook กำหนดแบบคำต่อคำ — ไม่ใส่สีของแบรนด์
// ลงไป (border-white/15 + bg-black/20 + opacity ทำงานได้กับ footer ทุก variant
// ซึ่งเป็นพื้นเข้มทั้งหมด) ห้าม retype ข้อความข้างในเอง มาจาก BRAND_ADDRESS
---

<footer class="relative mt-32 w-full border-t border-[#1e4bb8]/35 bg-[#030b22] pt-64 pb-6 font-sans text-[#dce7fb] shadow-[0_-10px_30px_rgba(30,75,184,0.25)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#f5c518]/35 bg-gradient-to-r from-[#071433] via-[#1e4bb8] to-[#030b22] p-6 shadow-[0_15px_40px_rgba(47,111,228,0.45)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#f5c518] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">🎰</span> พร้อมเปิดโหมดคูลกับ SBOGOOL หรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#93a9d4] md:text-base">
        สมัคร SBOGOOL แล้วเข้าล็อบบี้ได้ทันที เกมเด่นระดับท็อปจากค่ายยักษ์ใหญ่มาครบ ฟีเจอร์หลากสไตล์ทั้งตัวคูณทวีคูณ คอมโบแตกต่อเนื่อง และโหมดซื้อฟรีสปิน สลับค่ายได้คล่องในกระเป๋าเดียว ระบบออโต้ทำรายการเสร็จในไม่กี่วินาที
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#f5c518] bg-gradient-to-b from-[#ffe07a] to-[#f5c518] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#0b1f52] shadow-[0_0_15px_rgba(245,197,24,0.5)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🎁</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#ffe07a] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={LOGO_ALT}
                widths={[101, 202, 303]}
                sizes="101px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(47,111,228,0.7)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#7fb0ff] to-[#1e4bb8] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(47,111,228,0.6)]">SBOGOOL</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#93a9d4]">
          SBOGOOL เว็บสล็อตที่เปิดโหมดคูลให้กับทุกการสปิน ขนเกมเด่นระดับท็อปจากค่ายยักษ์ใหญ่มาเสิร์ฟไว้อย่างอุดมสมบูรณ์ ล็อบบี้จัดวางมาให้หาเกมที่ใช่ได้ง่าย ไม่มีโฆษณามาบัง ไม่มีเมนูซับซ้อนให้เสียอารมณ์
          ทั้งสล็อตงานภาพ 3D สตรีตสไตล์สุดเท่ เกมแนวแฟนตาซีตระการตา และเกมโบนัสแตกไวที่ซ่อนเงินรางวัลคูณโหดเอาไว้ พร้อมอัปเดตไลน์อัปเกมเข้าใหม่ต่อเนื่องให้ได้ลองฟีเจอร์แปลกใหม่เป็นกลุ่มแรกเสมอ
          ระบบออโต้จัดการทุกขั้นตอน เข้าสู่ระบบ ฝากเงิน ถอนกำไร เสร็จในไม่กี่วินาที ไม่ต้องส่งสลิปยืนยัน และไม่ต้องรอแอดมินกดอนุมัติ
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>

          {
            BRAND_ADDRESS.lines.length > 0 && (
              <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
                <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                  <span aria-hidden="true" class="text-sm">📍</span>
                  {BRAND_ADDRESS.label}
                </p>
                {BRAND_ADDRESS.lines.map((line) => (
                  <span class="block">{line}</span>
                ))}
                {BRAND_ADDRESS.email && (
                  <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                    <span aria-hidden="true" class="text-sm">✉️</span>
                    {BRAND_ADDRESS.email}
                  </a>
                )}
              </address>
            )
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#dce7fb] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#f5c518] to-[#2f6fe4] shadow-[0_0_8px_rgba(245,197,24,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {
            quickLinks.map((item) => (
              <a href={item.path} class="group flex items-center text-[#93a9d4] transition-colors hover:text-[#f5c518]">
                <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#2f6fe4] transition-transform group-hover:rotate-45" />
                {item.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#dce7fb] uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#f5c518] to-[#2f6fe4] shadow-[0_0_8px_rgba(245,197,24,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#93a9d4]">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและ TrueMoney Wallet โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#071433] transition-colors hover:border-[#2f6fe4]/50" title="ตรวจบิลย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#dce7fb]"><span aria-hidden="true" class="text-lg text-[#f5c518]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#1e4bb8]/30" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#6b80ad] md:block">
      เว็บสล็อตที่เปิดโหมดคูลให้กับทุกการสปิน ขนเกมเด่นระดับท็อปจากค่ายยักษ์ใหญ่มาเสิร์ฟไว้อย่างอุดมสมบูรณ์ จัดระเบียบทุกค่ายเกมไว้อย่างดีให้ค้นหาเกมที่ใช่ได้สนุก โดยไม่มีโฆษณามาบังหรือเมนูซับซ้อนให้เสียอารมณ์
      กระแสเกมไหนกำลังมาแรงหรือสล็อตค่ายไหนกำลังฮิตติดลมบนก็ไม่เคยพลาดที่จะดึงเข้ามาไว้ในลิสต์ ทุกเกมที่ติดโผขึ้นชื่อเรื่องอัตราการจ่ายเงินรางวัลที่เป็นธรรม จังหวะเข้าฟรีสปินบ่อย และมีอัตราคูณสะสมที่พร้อมเปลี่ยนเบทหลักสิบให้กลายเป็นกำไรหลักพัน
      ฟีเจอร์ครบมือหลากหลายสไตล์ ทั้งฟีเจอร์สุ่มแจกตัวคูณทวีคูณ ระบบคอมโบสัญลักษณ์แตกต่อเนื่อง และโหมดซื้อฟีเจอร์ฟรีสปินสำหรับสายใจร้อนที่อยากพุ่งตรงเข้าสู่รอบรางวัลใหญ่ พร้อมโปรโมชันคุ้มค่าทั้งโบนัสต้อนรับ เครดิตเพิ่มทุนรายวัน และข้อเสนอพิเศษที่กดรับไปใช้ได้จริง
      รองรับการสลับค่ายเกมได้อย่างฉับไวจบในกระเป๋าเดียว ไม่ต้องวนหาเกมหรือโยกเงินให้ยุ่งยาก ระบบออโต้ตัดเวลารอคอยออกทุกขั้นตอน ทั้งเข้าสู่ระบบ ฝากเงิน และถอนกำไร ทางเข้าลิงก์ตรงอัปเดตใหม่ ทดลองเล่นฟรี สมัครสมาชิกใหม่ SBOGOOL
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#6b80ad] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#f5c518] uppercase">SBOGOOL</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#dce7fb]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#dce7fb]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#dce7fb] transition-all hover:border-[#2f6fe4] hover:bg-[#071433] hover:shadow-[0_0_15px_rgba(47,111,228,0.6)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
