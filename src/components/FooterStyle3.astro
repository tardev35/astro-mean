---
import { BRAND_ADDRESS } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ลิงก์ด่วนชุดเดียว ใช้ .map ด้านล่าง — เดิมเขียน <a> ซ้ำหกก้อน ทำให้เพิ่ม/ลบหน้า
// ต้องไล่แก้ทีละอัน (และเป็นที่ที่ลิงก์หน้าหวยของแบรนด์ก่อนเคยค้างอยู่)
// XONEBET เป็นเว็บสล็อต หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ ห้ามมีลิงก์ถึง
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "ทดลองเล่นเกมฟรี", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่นสมาชิกใหม่", path: "/promotion" },
  { name: "ทางเข้าล่าสุด", path: "/ทางเข้า" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อแอดมิน", path: "/contact-us" },
];

const LOGO_ALT =
  "โลโก้ XONEBET เป็นตัวอักษร X สีทองเหลืองขนาดใหญ่ทรงคมเหมือนสายฟ้าสองเส้นไขว้กัน ใต้ตัว X เป็นคำว่า ONE.BET ตัวอักษรหนาสีเงินโครเมียม และบรรทัดล่างสุดเป็นข้อความตัวเล็กสีเงินว่า SLOT&CASINO ONLINE ทั้งหมดวางอยู่บนพื้นสีดำ";

// XONEBET: ย้ายจากน้ำเงินรอยัลคู่ทองส้มของแบรนด์ก่อน มาเป็นทองหลอมคู่เงินโครเมียม
// ของแบรนด์นี้ — ทอง #ebb101 / #fee505 / #a87c02 / #5c4301 คู่เงิน #e9e9e9 /
// #c4c4c4 บนผิว #0a0803 / #161105 / #221a08 เนื้อความ #f4e6bd รองด้วย #c3ae76
// และหมายเหตุตัวเล็ก #9a8a5e
//
// ทองมาจากตัว X ในโลโก้ มังกรทองคำ และเหรียญทองที่ปลิวทั่วแบนเนอร์ จึงคุมโครงสร้าง
// หลักทั้งขอบและปุ่ม CTA ส่วนเงินโครเมียมมาจากตัวอักษร ONE.BET ใช้เป็นปลายไล่สี
// ของเส้นใต้หัวคอลัมน์ เพื่อให้ทองล้วนไม่กลืนกันเอง
//
// บล็อก <address> ด้านล่างวางตามที่ playbook กำหนดแบบคำต่อคำ — ไม่ใส่สีของแบรนด์
// ลงไป (border-white/15 + bg-black/20 + opacity ทำงานได้กับ footer ทุก variant
// ซึ่งเป็นพื้นเข้มทั้งหมด) ห้าม retype ข้อความข้างในเอง มาจาก BRAND_ADDRESS
---

<footer class="relative mt-32 w-full border-t border-[#5c4301]/35 bg-[#0a0803] pt-64 pb-6 font-sans text-[#f4e6bd] shadow-[0_-10px_30px_rgba(92,67,1,0.25)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#ebb101]/35 bg-gradient-to-r from-[#161105] via-[#221a08] to-[#0a0803] p-6 shadow-[0_15px_40px_rgba(168,124,2,0.45)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#fee505] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">🐉</span> พร้อมเปิดล็อบบี้กับ XONEBET หรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#c3ae76] md:text-base">
        สมัคร XONEBET ยูสเซอร์เดียวจบครบทุกค่ายในแดชบอร์ดเดียว ไม่ต้องสลับเว็บ ไม่ต้องโยกเงินข้ามค่าย คัดเฉพาะค่ายเกรด A อย่าง PG Soft, Pragmatic Play และ Joker Gaming เน้นเกมตัวท็อปที่โครงสร้างการจ่ายเงินโปร่งใส ฝากถอนออโต้ประมวลผลไวใน 3 วินาที
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#ebb101] bg-gradient-to-b from-[#fee505] to-[#ebb101] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#0a0803] shadow-[0_0_15px_rgba(235,177,1,0.5)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🎁</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#fee505] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={LOGO_ALT}
                widths={[101, 202, 303]}
                sizes="101px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(168,124,2,0.7)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#fee505] to-[#5c4301] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(168,124,2,0.6)]">XONEBET</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#c3ae76]">
          XONEBET เว็บตรง API แท้ ยิงสัญญาณตรงจากเซิร์ฟเวอร์หลักนอก ไม่ผ่านเอเย่นต์ ค่า RTP โปร่งใสตามมาตรฐานสากล ไม่มีการปรับแต่งเปอร์เซ็นต์การชนะ ยึดโครงสร้าง One-Stop Service เต็มรูปแบบ เชื่อมคลังเกมทุกค่ายชั้นนำและระบบการเงินไว้ในบัญชีเดียว
          คัดกรองเฉพาะค่ายใหญ่ระดับเกรด A อย่าง PG Soft, Pragmatic Play และ Joker Gaming เน้นเฉพาะเกมตัวท็อปที่โครงสร้างการจ่ายเงินโปร่งใส จังหวะฟรีสปินเข้าไว และมีอัตราคูณสะสมสูง ตัดเกมไร้คุณภาพออกทั้งหมด
          ระบบฝากถอนออโต้ประมวลผลไวใน 3 วินาที ไม่ติดเทิร์นจุกจิก ปั่นง่าย ทำกำไรได้จริงและถอนออกได้เต็มจำนวนทุกยอด
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>

          {
            BRAND_ADDRESS.lines.length > 0 && (
              <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
                <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                  <span aria-hidden="true" class="text-sm">📍</span>
                  {BRAND_ADDRESS.label}
                </p>
                {BRAND_ADDRESS.lines.map((line) => (
                  <span class="block">{line}</span>
                ))}
                {BRAND_ADDRESS.email && (
                  <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                    <span aria-hidden="true" class="text-sm">✉️</span>
                    {BRAND_ADDRESS.email}
                  </a>
                )}
              </address>
            )
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f4e6bd] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#ebb101] to-[#e9e9e9] shadow-[0_0_8px_rgba(235,177,1,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {
            quickLinks.map((item) => (
              <a href={item.path} class="group flex items-center text-[#c3ae76] transition-colors hover:text-[#fee505]">
                <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ebb101] transition-transform group-hover:rotate-45" />
                {item.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f4e6bd] uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#ebb101] to-[#e9e9e9] shadow-[0_0_8px_rgba(235,177,1,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#c3ae76]">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและ TrueMoney Wallet โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#161105] transition-colors hover:border-[#a87c02]/50" title="ตรวจบิลย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#f4e6bd]"><span aria-hidden="true" class="text-lg text-[#ebb101]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#5c4301]/30" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#9a8a5e] md:block">
      สล็อตวันสต็อปที่ตัดระบบเอเย่นต์และขั้นตอนยุ่งยากออกทั้งหมด กดเข้าหน้าเว็บปุ๊บก็พร้อมลุยปั๊บ สัญญาณเกมยิงตรงจากเซิร์ฟเวอร์หลักนอกผ่าน API แท้ ค่า RTP จึงโปร่งใสตามมาตรฐานสากล ไม่มีใครอยู่ตรงกลางให้ปรับเปอร์เซ็นต์การชนะ รวมเกมสล็อตค่ายใหญ่ครบวงจรไว้ในกระเป๋าเดียว
      ยึดโครงสร้าง One-Stop Service เต็มรูปแบบ เชื่อมต่อคลังเกมจากทุกค่ายชั้นนำและระบบการเงินไว้ในบัญชีเดียว ไม่ต้องเสียเวลาสมัครหลายยูสเซอร์ ไม่ต้องโยกเงินข้ามค่ายให้สับสน เลือกเล่น สลับเกม และจัดการถอนกำไรได้ทันทีผ่านหน้าแดชบอร์ดเดียว คัดกรองเฉพาะค่ายใหญ่ระดับเกรด A เช่น PG Soft, Pragmatic Play และ Joker Gaming
      จัดหมวดหมู่หน้าเว็บอย่างเป็นระบบ แยกตามประเภทเกม ค่ายดัง และหมวดเกมกระแสมาแรง ค้นหาเกมที่ใช่ได้ในไม่กี่คลิก ฟีเจอร์ยุคใหม่มาครบ ทั้งระบบสุ่มแจกตัวคูณทวีคูณ Multipliers สัญลักษณ์ Wild ซ้อนทับ คอมโบแตกต่อเนื่องแบบ Cascading และโหมด Buy Feature สำหรับสายใจร้อน
      อัปเกรดเซิร์ฟเวอร์หลังบ้านประมวลผลความเร็วสูง สลับค่ายเกมและโหลดหน้าอินเทอร์เฟซได้ฉับไว ไร้ปัญหาเกมค้าง กระตุก หรือเด้งหลุดกลางทาง วางระบบแสดงผลแบบ Responsive 100% รองรับทั้งมือถือ iOS, Android, แท็บเล็ต และคอมพิวเตอร์ ฝากถอนออโต้ไวใน 3 วินาที ไม่ติดเทิร์นจุกจิก ทางเข้าลิงก์ตรงอัปเดตใหม่ ทดลองเล่นฟรี สมัครสมาชิกใหม่ XONEBET
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#9a8a5e] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#fee505] uppercase">XONEBET</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#f4e6bd]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f4e6bd]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#f4e6bd] transition-all hover:border-[#a87c02] hover:bg-[#161105] hover:shadow-[0_0_15px_rgba(168,124,2,0.6)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
