---
import { BRAND_ADDRESS } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ลิงก์ด่วนชุดเดียว ใช้ .map ด้านล่าง — เดิมเขียน <a> ซ้ำหกก้อน ทำให้เพิ่ม/ลบหน้า
// ต้องไล่แก้ทีละอัน (และเป็นที่ที่ลิงก์หน้าหวยของแบรนด์ก่อนเคยค้างอยู่)
// BLACKJACK789 เป็นเว็บสล็อต/คาสิโน หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ (อยู่ใน
// src/pages-disabled/) ห้ามมีลิงก์ถึง
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "ทดลองเล่นเกมฟรี", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่นสมาชิกใหม่", path: "/promotion" },
  { name: "ทางเข้าล่าสุด", path: "/ทางเข้า" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อแอดมิน", path: "/contact-us" },
];

const LOGO_ALT =
  "โลโก้ BLACKJACK789 เป็นรูปโพดำทองคำขอบเงาวาว มีคำว่า Black Jack เขียนทับด้วยตัวอักษรโลหะสีเทากราไฟต์ขอบทองแบบมีหางโค้ง ใต้ลงมาเป็นเลข 789 สีเดียวกัน และมีประกายทองสี่แฉกอยู่สองข้าง";

// BLACKJACK789: ย้ายจากทองราชสำนักสว่างของแบรนด์ก่อนที่เคยใช้ไฟล์นี้ มาเป็นทอง
// แอนทีคอมน้ำผึ้งคู่กราไฟต์บนดำสนิทของแบรนด์นี้ — ทอง #fdf1ce / #f2cf70 /
// #d3aa4b / #b8862c / #5c4113 คู่กราไฟต์ #cfd6e0 / #8e97a6 / #454d5c บนผิว
// #050403 / #100b05 / #1e150a เนื้อความ #ede0c4 รองด้วย #c0ab84 และหมายเหตุ
// ตัวเล็ก #8b7c5c
//
// ทองมาจากตัวโพดำในโลโก้ กองชิปและไพ่ทองบนแบนเนอร์ ส่วนกราไฟต์คือตัวอักษร
// Black Jack ที่เป็นโลหะเทาขอบทอง จึงเป็นโลหะตัวที่สองจริง ใช้เป็นสีตัดของปุ่มรอง
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// หัวคอลัมน์เป็น <p> ไม่ใช่หัวข้อ — footer ขึ้นทุกหน้า ถ้าเป็น <h2>/<h3> จะกลาย
// เป็นหัวข้อของทั้งเว็บ และรายการ h1/h2 ของทุกหน้าถูก diff กับหัวข้อใน docx
//
// บล็อก <address> ด้านล่างวางตามที่ playbook กำหนดแบบคำต่อคำ — ไม่ใส่สีของแบรนด์
// ลงไป (border-white/15 + bg-black/20 + opacity ทำงานได้กับ footer ทุก variant
// ซึ่งเป็นพื้นเข้มทั้งหมด) ห้าม retype ข้อความข้างในเอง มาจาก BRAND_ADDRESS
// ซึ่งผูกกับ BRAND_NAME และ site:
---

<footer class="relative mt-32 w-full border-t border-[#5c4113]/40 bg-[#050403] pt-64 pb-6 font-sans text-[#ede0c4] shadow-[0_-10px_30px_rgba(92,65,19,0.3)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#d3aa4b]/40 bg-gradient-to-r from-[#100b05] via-[#1e150a] to-[#050403] p-6 shadow-[0_15px_40px_rgba(184,134,44,0.4)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#f2cf70] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">♠️</span> พร้อมลงสนามกับ BLACKJACK789 หรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#c0ab84] md:text-base">
        สมัคร BLACKJACK789 ยูสเซอร์เดียวจบ ครบทุกค่ายในกระเป๋าเงินเดียว ไม่ต้องโยกเครดิตข้ามค่าย คัดค่ายดังเกมแท้ระดับ A-List อย่าง PG Soft, Pragmatic Play และ Joker
        Gaming มาให้เลือกครบมือ ฝากถอนออโต้ประมวลผลเสร็จใน 3 วินาที
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#d3aa4b] bg-gradient-to-b from-[#f2cf70] to-[#b8862c] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#050403] shadow-[0_0_15px_rgba(211,170,75,0.5)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🎁</span></span>
      <span aria-hidden="true" class="absolute inset-0 block translate-y-full bg-[#f2cf70] transition-transform duration-300 group-hover:translate-y-0"></span>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={LOGO_ALT}
                widths={[94, 188, 282]}
                sizes="94px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(184,134,44,0.7)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#f2cf70] to-[#5c4113] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(184,134,44,0.6)]">BLACKJACK789</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#c0ab84]">
          BLACKJACK789 สล็อตเกมดีมีเชิง เว็บตรง API แท้ ยิงสัญญาณตรงจากเซิร์ฟเวอร์หลัก ไม่ผ่านเอเย่นต์ ไร้ประวัติล็อกยูส ค่า RTP เป็นมาตรฐานยุติธรรมตรงตามสเปกโรงงาน
          ไม่มีปรับลดเปอร์เซ็นต์ชนะ วางระบบคลังเกมอย่างมีเชิงชั้น ไม่อัดเกมขยะมาให้รกหน้าเว็บ คัดเฉพาะเกมที่มีโครงสร้างการจ่ายรางวัลโปร่งใสและจังหวะแจ็คพอตแตกจริงตามอัลกอริทึมสากล
          รวมค่ายดังระดับ A-List อย่าง PG Soft, Pragmatic Play และ Joker Gaming ครบทั้งสล็อต 3D เนื้อเรื่องเข้มข้น สายสตรีตตัวคูณโหด และคลาสสิกไลน์จ่ายน้อยแต่แตกหนัก
          พร้อมฟีเจอร์ยุคใหม่ทั้ง Multipliers, Expanding Wild, Cascading และ Bonus Buy อยู่ในกระเป๋าเงินเดียวไม่ต้องโยกเครดิต ระบบฝากถอนออโต้ทำรายการเสร็จใน 3 วินาที ถอนกำไรได้เต็มทุกยอด
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>

          {
            BRAND_ADDRESS.lines.length > 0 && (
              <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
                <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                  <span aria-hidden="true" class="text-sm">📍</span>
                  {BRAND_ADDRESS.label}
                </p>
                {BRAND_ADDRESS.lines.map((line) => (
                  <span class="block">{line}</span>
                ))}
                {BRAND_ADDRESS.email && (
                  <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                    <span aria-hidden="true" class="text-sm">✉️</span>
                    {BRAND_ADDRESS.email}
                  </a>
                )}
              </address>
            )
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#ede0c4] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#b8862c] to-[#f2cf70] shadow-[0_0_8px_rgba(211,170,75,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {
            quickLinks.map((item) => (
              <a href={item.path} class="group flex items-center text-[#c0ab84] transition-colors hover:text-[#f2cf70]">
                <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#d3aa4b] transition-transform group-hover:rotate-45" />
                {item.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#ede0c4] uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#b8862c] to-[#f2cf70] shadow-[0_0_8px_rgba(211,170,75,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#c0ab84]">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและ TrueMoney Wallet โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#100b05] transition-colors hover:border-[#b8862c]/50" title="ตรวจบิลย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#ede0c4]"><span aria-hidden="true" class="text-lg text-[#d3aa4b]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#5c4113]/35" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#8b7c5c] md:block">
      สล็อตออนไลน์วันสต็อปที่ตัดระบบเอเย่นต์และขั้นตอนยุ่งยากออกทั้งหมด กดเข้าหน้าเว็บปุ๊บก็พร้อมลุยปั๊บ สัญญาณเกมยิงตรงจากเซิร์ฟเวอร์หลักผ่าน API แท้ ค่า RTP จึงเป็นมาตรฐานยุติธรรม
      ตรงตามสเปกโรงงาน ไม่มีปรับลดเปอร์เซ็นต์ชนะ ไม่ผ่านเอเย่นต์ และไร้ประวัติล็อกยูส วางระบบคลังเกมอย่างมีเชิงชั้น ไม่เน้นอัดเกมขยะมาให้รกหน้าเว็บ
      คัดเฉพาะเกมสล็อตที่มีโครงสร้างการจ่ายรางวัลโปร่งใสและจังหวะแจ็คพอตแตกจริงตามอัลกอริทึมสากล ผู้เล่นจึงวางแผนการเดินเงินได้อย่างมีเชิง ไม่ว่าจะเบทเริ่มต้นหลักบาทหรือปรับยอดขึ้นสูง
      ขนทัพค่ายยักษ์ใหญ่ระดับ A-List อย่าง PG Soft, Pragmatic Play และ Joker Gaming มาไว้แบบครบมือ ทุกเกมผ่านการทดสอบอัตราจ่าย จ่ายเงินตรงตามมาตรฐานผู้พัฒนา กราฟิกสมูธคมชัดระดับ HD
      ลื่นไหลทุกการสปิน อัดแน่นด้วยฟีเจอร์ยุคใหม่ทั้งระบบสุ่มแจกตัวคูณทวีคูณ Multipliers สัญลักษณ์ Expanding Wild ขยายเต็มรีล คอมโบแตกต่อเนื่อง Cascading และโหมด Bonus Buy
      ซื้อฟรีสปินพุ่งตรงเข้าลุ้นรอบแจ็คพอต คลังเกมหลากหลายสไตล์ตั้งแต่สล็อต 3D เนื้อเรื่องเข้มข้น สายสตรีตเน้นตัวคูณโหด ไปจนถึงคลาสสิกไลน์จ่ายน้อยแต่แตกหนัก จัดหมวดหมู่ชัดเจน ค้นหาง่าย
      สลับเปลี่ยนฟีลได้ทันทีผ่านกระเป๋าเงินเดียว สิทธิประโยชน์จัดเต็มให้สมาชิกกดรับเองผ่านหน้าแดชบอร์ด ทั้งโบนัสต้อนรับเพิ่มทุนสปิน โปรฝากแรกของวัน และเครดิตคืนยอดเสีย Cash Back ทุกวัน
      เงื่อนไขโปร่งใส ไม่ติดเทิร์นโอเวอร์มหาโหด ระบบออโต้ไฮสปีดผ่าน Gateway ตรงทำรายการเสร็จใน 3 วินาที ไม่ต้องส่งสลิป ไม่ต้องรอแอดมินอนุมัติ ทางเข้าลิงก์ตรงอัปเดตใหม่ ทดลองเล่นฟรี
      สมัครสมาชิกใหม่ BLACKJACK789
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#8b7c5c] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#f2cf70] uppercase">BLACKJACK789</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#ede0c4]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ede0c4]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#ede0c4] transition-all hover:border-[#b8862c] hover:bg-[#100b05] hover:shadow-[0_0_15px_rgba(184,134,44,0.6)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
