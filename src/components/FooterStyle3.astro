---
import { BRAND_ADDRESS } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ลิงก์ด่วนชุดเดียว ใช้ .map ด้านล่าง — เดิมเขียน <a> ซ้ำหกก้อน ทำให้เพิ่ม/ลบหน้า
// ต้องไล่แก้ทีละอัน (และเป็นที่ที่ลิงก์หน้าหวยของแบรนด์ก่อนเคยค้างอยู่)
// AWIN8 เป็นเว็บสล็อต หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ ห้ามมีลิงก์ถึง
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "ทดลองเล่นเกมฟรี", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่นสมาชิกใหม่", path: "/promotion" },
  { name: "ทางเข้าล่าสุด", path: "/ทางเข้า" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อแอดมิน", path: "/contact-us" },
];

const LOGO_ALT =
  "โลโก้ AWIN8 เป็นตัวอักษร AWIN สีขาวโครเมียมตัดขอบน้ำเงินเข้ม ต่อด้วยเลข 8 สีส้มทองที่มีเปลวไฟพุ่งออกทางขวา ด้านบนมีมงกุฎทองห้าแฉกวางอยู่ ใต้ตัวอักษรเป็นแถบสี่เหลี่ยมมนสีน้ำเงินขอบส้มเขียนว่า ARE YOU READVE NONSTOP FUINIS JUST AROUND";

// AWIN8: ย้ายจากไฟฟีนิกซ์คู่ทองของแบรนด์ก่อน มาเป็นน้ำเงินรอยัลคู่ทองส้มของแบรนด์
// นี้ — น้ำเงิน #1f6fea / #7fb2ff / #0d3f9e / #07265e คู่ทองส้ม #ffd27a / #fca311
// บนผิว #02081c / #08172f / #0c2247 เนื้อความ #d8e6fb รองด้วย #9db4d6 และ
// หมายเหตุตัวเล็ก #7f95b8
//
// ทองส้มมาจากมงกุฎกับเปลวไฟที่เลข 8 ในโลโก้ และจากเหรียญทองที่ปลิวทั่วแบนเนอร์
// จึงใช้เป็นสีคู่ของเส้นใต้หัวคอลัมน์และหัวลูกศรลิงก์ด่วน ส่วนน้ำเงินรอยัลคุม
// โครงสร้างหลักทั้งขอบและปุ่ม CTA
//
// บล็อก <address> ด้านล่างวางตามที่ playbook กำหนดแบบคำต่อคำ — ไม่ใส่สีของแบรนด์
// ลงไป (border-white/15 + bg-black/20 + opacity ทำงานได้กับ footer ทุก variant
// ซึ่งเป็นพื้นเข้มทั้งหมด) ห้าม retype ข้อความข้างในเอง มาจาก BRAND_ADDRESS
---

<footer class="relative mt-32 w-full border-t border-[#07265e]/35 bg-[#02081c] pt-64 pb-6 font-sans text-[#d8e6fb] shadow-[0_-10px_30px_rgba(7,38,94,0.25)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#1f6fea]/35 bg-gradient-to-r from-[#08172f] via-[#07265e] to-[#02081c] p-6 shadow-[0_15px_40px_rgba(13,63,158,0.45)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#7fb2ff] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">👑</span> พร้อมขึ้นสปินกับ AWIN8 หรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#9db4d6] md:text-base">
        สมัคร AWIN8 แล้วพุ่งตรงเข้าล็อบบี้ได้ในคลิกเดียว สล็อตเกมแท้ตัวท็อปจาก PG Soft, Pragmatic Play และ Joker Gaming มาครบ คัดเฉพาะตัวที่โบนัสแตกง่าย กราฟิกคมชัด จัดโปรฮิตมาเป็นชุดให้เลือกตามจังหวะ ฝากถอนออโต้ผ่าน Gateway ตรงเสร็จในไม่กี่วินาที
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#fca311] bg-gradient-to-b from-[#ffd27a] to-[#fca311] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#02081c] shadow-[0_0_15px_rgba(252,163,17,0.5)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🎁</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#ffd27a] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={LOGO_ALT}
                widths={[101, 202, 303]}
                sizes="101px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(13,63,158,0.7)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#7fb2ff] to-[#07265e] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(13,63,158,0.6)]">AWIN8</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#9db4d6]">
          AWIN8 เชื่อมต่อสัญญาณ API ตรงจากสตูดิโอผู้พัฒนาสล็อตระดับโลก ไม่ผ่านเอเย่นต์ ค่า RTP เป็นมาตรฐานยุติธรรมตามสเปกโรงงาน ไม่มีการปรับแต่งเปอร์เซ็นต์แพ้ชนะ รันบนเซิร์ฟเวอร์เสถียรสูงที่รองรับการเดิมพันทุกระดับ
          คลังเกมกวาดเฉพาะตัวระดับ A-List จากค่ายยักษ์ใหญ่อย่าง PG Soft, Pragmatic Play และ Joker Gaming คัดกรองเฉพาะเกมที่โครงสร้างการจ่ายรางวัลโปร่งใส โบนัสแตกง่าย และกราฟิกประมวลผลคมชัดลื่นไหลไม่มีสะดุด
          ระบบฝากถอนออโต้ไฮสปีดประมวลผลผ่าน Gateway ตรง เสร็จสิ้นในไม่กี่วินาที ไม่ต้องแนบสลิป ไม่ต้องรอคิวอนุมัติจากแอดมิน ทุกโปรโมชันเงื่อนไขโปร่งใส ถอนได้จริง ไม่ติดล็อคยูส
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>

          {
            BRAND_ADDRESS.lines.length > 0 && (
              <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
                <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                  <span aria-hidden="true" class="text-sm">📍</span>
                  {BRAND_ADDRESS.label}
                </p>
                {BRAND_ADDRESS.lines.map((line) => (
                  <span class="block">{line}</span>
                ))}
                {BRAND_ADDRESS.email && (
                  <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                    <span aria-hidden="true" class="text-sm">✉️</span>
                    {BRAND_ADDRESS.email}
                  </a>
                )}
              </address>
            )
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#d8e6fb] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#1f6fea] to-[#fca311] shadow-[0_0_8px_rgba(31,111,234,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {
            quickLinks.map((item) => (
              <a href={item.path} class="group flex items-center text-[#9db4d6] transition-colors hover:text-[#7fb2ff]">
                <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fca311] transition-transform group-hover:rotate-45" />
                {item.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#d8e6fb] uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#1f6fea] to-[#fca311] shadow-[0_0_8px_rgba(31,111,234,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#9db4d6]">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและ TrueMoney Wallet โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#08172f] transition-colors hover:border-[#0d3f9e]/50" title="ตรวจบิลย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#d8e6fb]"><span aria-hidden="true" class="text-lg text-[#fca311]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#07265e]/30" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#7f95b8] md:block">
      สล็อตเกมแท้ตัวท็อปที่ตัดระบบเอเย่นต์และขั้นตอนยุ่งยากออกทั้งหมด กดเข้าหน้าเว็บปุ๊บก็พร้อมลุยปั๊บ สัญญาณเกมยิงตรงจากสตูดิโอผู้พัฒนาผ่าน API ค่า RTP จึงเป็นไปตามสเปกโรงงานทุกตัว ไม่มีใครอยู่ตรงกลางให้ปรับเปอร์เซ็นต์แพ้ชนะ ช่วยให้ทุกเบทที่กดสปินเป็นการลุยบนระบบมาตรฐานสากลของจริง
      หมดปัญหาคลังเกมตัน เพราะล็อบบี้ขยายทางเลือกให้สายสล็อตอย่างต่อเนื่อง ทั้งเกมกระแสติดอันดับชาร์ตและเกมนอกกระแสอัตราคูณโหด ตัวระบบพร้อมดึงสัญญาณเกมเข้าใหม่มาให้กดสปินทันที มีตัวเลือกหลากแนวรองรับทุกกลยุทธ์การเดินเงินอย่างอิสระ เช็กอัตราการจ่ายและทดลองเล่นในโหมดทดลองฟรีได้ก่อนตัดสินใจลงเงินจริง
      ลูกเล่นยุคใหม่ถูกรวบรวมมาไว้ครบ ทั้งระบบสุ่มแจกตัวคูณทวีคูณ Multiplier Drops สัญลักษณ์ขยายเต็มรีล Expanding Wilds และโหมดซื้อฟรีสปินแบบทันใจ ช่วยฉีกกฎการหมุนสล็อตแบบเดิมๆ เปลี่ยนความซ้ำซากให้กลายเป็นโอกาสคว้าแจ็คพอตก้อนโต ปรับสเกลหน้าจอให้อัตโนมัติทั้งมือถือ iOS, Android, แท็บเล็ต และคอมพิวเตอร์
      ไลน์อัปโปรโมชันจัดมาเป็นชุด ทั้งโบนัสสมทบทุนฝากแรก สิทธิ์คืนยอดเสีย Cash Back รายวัน และเครดิตพิเศษเฉพาะช่วงเวลา ทุกโปรกำหนดเงื่อนไขโปร่งใส ถอนได้จริง ไม่ติดล็อคยูส ยอดเงินอัปเดตเข้าคลังเกมทันทีโดยไม่ต้องแนบสลิป ทางเข้าลิงก์ตรงอัปเดตใหม่ ทดลองเล่นฟรี สมัครสมาชิกใหม่ AWIN8
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#7f95b8] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#7fb2ff] uppercase">AWIN8</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#d8e6fb]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#d8e6fb]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#d8e6fb] transition-all hover:border-[#0d3f9e] hover:bg-[#08172f] hover:shadow-[0_0_15px_rgba(13,63,158,0.6)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
