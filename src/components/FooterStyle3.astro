---
import { BRAND_ADDRESS } from "../lib/brandProfile";
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ลิงก์ด่วนชุดเดียว ใช้ .map ด้านล่าง — เดิมเขียน <a> ซ้ำหกก้อน ทำให้เพิ่ม/ลบหน้า
// ต้องไล่แก้ทีละอัน (และเป็นที่ที่ลิงก์หน้าหวยของแบรนด์ก่อนเคยค้างอยู่)
// GGPLUS88 เป็นสล็อต หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ ห้ามมีลิงก์ถึง
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "ทดลองเล่นเกมฟรี", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่นสมาชิกใหม่", path: "/promotion" },
  { name: "ทางเข้าล่าสุด", path: "/ทางเข้า" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อแอดมิน", path: "/contact-us" },
];

const LOGO_ALT =
  "โลโก้ GGPLUS88 เป็นตราหกเหลี่ยมขอบทอง ข้างในเป็นอักษร GG สีมาเจนต้าตัดเงินเมทัลลิก วางอยู่เหนือคำว่า PLUS อักษรเงินและเลข 88 สีทองบนแผ่นสี่เหลี่ยมมุมมนสีม่วงเข้ม";

// GGPLUS88: ย้ายจากหยกเขียวคู่ทองของ KANGFU1688 (#24ac6c / #7fe6b4 / #16945d /
// #0b4b2f คู่ทอง #e8b530 / #ffe6a6 / #8a6410 บนผิว #02120a / #072216 / #0d3d28
// เนื้อความ #dff3e6 รองด้วย #86b39c / #5f8672) มาเป็นม่วงลึกคู่มาเจนต้าของ
// แบรนด์นี้ — ม่วง #9b2fe0 / #d9a5ff / #5a1290 คู่มาเจนต้า #d81b7e / #ff6fb5
// คู่ทอง #f0c14b / #ffe9a8 / #a97d12 บนผิว #0b0212 / #1b0630 / #2d0a50
// เนื้อความ #ece0f7 รองด้วย #a98cc4 / #7a5f96
//
// บล็อก <address> ด้านล่างวางตามที่ playbook กำหนดแบบคำต่อคำ — ไม่ใส่สีของแบรนด์
// ลงไป (border-white/15 + bg-black/20 + opacity ทำงานได้กับ footer ทุก variant
// ซึ่งเป็นพื้นเข้มทั้งหมด) ห้าม retype ข้อความข้างในเอง มาจาก BRAND_ADDRESS
---

<footer class="relative mt-32 w-full border-t border-[#9b2fe0]/30 bg-[#0b0212] pt-64 pb-6 font-sans text-[#ece0f7] shadow-[0_-10px_30px_rgba(155,47,224,0.2)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#f0c14b]/35 bg-gradient-to-r from-[#1b0630] via-[#5a1290] to-[#0b0212] p-6 shadow-[0_15px_40px_rgba(155,47,224,0.4)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#f0c14b] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">🎰</span> พร้อมหมุนรับฟรีสปินกับ GGPLUS88 หรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#a98cc4] md:text-base">
        สมัคร GGPLUS88 แล้วเข้าล็อบบี้ได้ทันที รวมเฉพาะเกมสล็อตแตกจริงลิขสิทธิ์แท้ 100% ไม่ผ่านเอเย่นต์ ไม่ล็อคยูส ฝากถอนออโต้ไม่มีขั้นต่ำ รองรับ True Wallet ทำรายการไวใน 3 วินาที
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#f0c14b] bg-gradient-to-b from-[#ffe9a8] to-[#f0c14b] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#1a0430] shadow-[0_0_15px_rgba(240,193,75,0.5)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🎁</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#ffe9a8] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={LOGO_ALT}
                widths={[101, 202, 303]}
                sizes="101px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(155,47,224,0.65)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#ff6fb5] to-[#5a1290] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(216,27,126,0.6)]">GGPLUS88</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#a98cc4]">
          GGPLUS88 สล็อตเว็บตรงมาใหม่ล่าสุดที่คัดเฉพาะเกมแตกจริงจากค่ายชั้นนำมาไว้ครบในล็อบบี้เดียว ลิขสิทธิ์แท้ 100% ไม่ผ่านเอเย่นต์ ไม่ปรับอัตราแพ้ชนะ และไม่มีการล็อคยูสเซอร์ ทุกยูสจึงมีสิทธิ์ลุ้นแจ็กพอตเท่าเทียมกัน
          ระบบการเงินมั่นคง เล่นได้จ่ายเต็ม ไม่กั๊กยอด ไม่ปิดเว็บหนี ฝากถอนออโต้ไม่มีขั้นต่ำ รองรับทั้งบัญชีธนาคารชั้นนำและ TrueMoney Wallet ปรับยอดเองภายใน 3 วินาที ไม่ต้องส่งสลิปให้แอดมินตรวจสอบ
          พร้อมทีมงานซัพพอร์ตดูแลตลอด 24 ชั่วโมง
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>

          {
            BRAND_ADDRESS.lines.length > 0 && (
              <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
                <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                  <span aria-hidden="true" class="text-sm">📍</span>
                  {BRAND_ADDRESS.label}
                </p>
                {BRAND_ADDRESS.lines.map((line) => (
                  <span class="block">{line}</span>
                ))}
                {BRAND_ADDRESS.email && (
                  <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                    <span aria-hidden="true" class="text-sm">✉️</span>
                    {BRAND_ADDRESS.email}
                  </a>
                )}
              </address>
            )
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#ece0f7] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#d81b7e] to-[#9b2fe0] shadow-[0_0_8px_rgba(216,27,126,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {
            quickLinks.map((item) => (
              <a href={item.path} class="group flex items-center text-[#a98cc4] transition-colors hover:text-[#f0c14b]">
                <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#d81b7e] transition-transform group-hover:rotate-45" />
                {item.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#ece0f7] uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#d81b7e] to-[#9b2fe0] shadow-[0_0_8px_rgba(216,27,126,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#a98cc4]">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและ TrueMoney Wallet โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#1b0630] transition-colors hover:border-[#9b2fe0]/50" title="ตรวจบิลย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#ece0f7]"><span aria-hidden="true" class="text-lg text-[#f0c14b]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#9b2fe0]/25" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#7a5f96] md:block">
      สล็อตเว็บตรงมาใหม่ที่รวมเฉพาะเกมแตกจริงจากค่ายชั้นนำไว้ในที่เดียว ลิขสิทธิ์แท้ 100% ไม่ปรับอัตราแพ้ชนะ ทุกการหมุนจึงลุ้นทำกำไรได้จริง เป็นผู้ให้บริการเว็บตรงไม่ผ่านเอเย่นต์ที่ได้มาตรฐานสากล
      มีใบอนุญาตประกอบกิจการถูกต้องตามกฎหมาย ระบบการเงินมีความมั่นคงสูง เล่นได้จ่ายเต็ม ไม่มีการกั๊กยอดหรือปิดเว็บหนี ไม่ว่าจะทำกำไรหลักร้อยหรือหลักแสนก็การันตีโอนไว จ่ายครบทุกบาททุกสตางค์
      ล็อบบี้คัดเฉพาะเกมสล็อตแตกง่ายที่อัตราการจ่ายสูง ทุกยูสเซอร์มีสิทธิ์ลุ้นแจ็กพอตเท่าเทียมกัน ไม่มีการล็อคยูสเซอร์หรือปรับลดเปอร์เซ็นต์ชนะ ไม่ว่าจะเบทต่ำหรือเบทสูงก็เข้าโบนัสไทม์ได้ทุกรอบการหมุน
      ระบบฝาก-ถอนอัตโนมัติรุ่นใหม่ปรับยอดทันทีภายใน 3 วินาที ไม่ต้องส่งสลิป รองรับทั้งบัญชีธนาคารและ TrueMoney Wallet ไม่มีขั้นต่ำ ทางเข้าลิงก์ตรงอัปเดตใหม่ ทดลองเล่นฟรี สมัครสมาชิกใหม่ GGPLUS88
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#7a5f96] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#f0c14b] uppercase">GGPLUS88</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#ece0f7]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ece0f7]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#ece0f7] transition-all hover:border-[#9b2fe0] hover:bg-[#1b0630] hover:shadow-[0_0_15px_rgba(155,47,224,0.55)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
