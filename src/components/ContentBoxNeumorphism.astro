---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// GEN4: ย้ายชุดสีจากส้มไฟของแบรนด์ก่อน มาที่น้ำเงินอิเล็กทริกคู่แดงของแบรนด์นี้ที่
// วัดจากอาร์ตจริง — น้ำเงิน #0071d5 / #01a3f3 / #6fd2ff / #00408a บนผิวกรมท่า
// เกือบดำ #050b1a เนื้อความ #d7e7ff หัวข้อ #eaf4ff (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้
// ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก
// git history)
//
// คู่เงา neumorphic ต้องเป็นเฉดอ่อน/เข้มของสีการ์ดเอง ไม่ใช่สีแบรนด์ — เงาทอดใช้
// #01030a (เข้มกว่าพื้นหน้า) และไฮไลต์ใช้ #0b1b3a (ผิวการ์ดยกขึ้นหนึ่งขั้น) ถ้าสลับ
// ไปใช้น้ำเงินนีออน การ์ดจะกลายเป็นแสงเรืองแทนที่จะเป็นผิวนูน ซึ่งไม่ใช่สิ่งที่
// variant นี้มีไว้ทำ
//
// text-center อยู่บน <header> เท่านั้น ไม่ได้อยู่บนการ์ดหรือ <section> ถ้าย้ายขึ้นไป
// มันจะ inherit ลงไปใน slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#0071d5]/30 bg-[#050b1a] p-8 text-left text-base leading-relaxed text-[#d7e7ff] shadow-[10px_10px_20px_#01030a,-10px_-10px_20px_#0b1b3a]">
    {
      title && (
        <header class="mb-8 border-b border-[#01a3f3]/25 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#eaf4ff] via-[#01a3f3] to-[#0071d5] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
