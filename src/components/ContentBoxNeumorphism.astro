---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// AURA456: ย้ายชุดสีของ variant นี้มาที่นีออนบานเย็นคู่ฟ้าอิเล็กทริกของแบรนด์นี้ —
// บานเย็นหลัก #ff2fb0 / #ff7fd4 / #ffc9ee บนผิวครามเกือบดำ #05021a เนื้อความ
// #d8d3f0 (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history)
//
// คู่เงา neumorphic ต้องเป็นเฉดอ่อน/เข้มของสีการ์ดเอง ไม่ใช่สีแบรนด์ — เงาทอดใช้
// #03010f (เข้มกว่าพื้นหน้า) และไฮไลต์ใช้ #120a33 (ผิวการ์ดยกขึ้นหนึ่งขั้น) ถ้าสลับ
// ไปใช้บานเย็นนีออน การ์ดจะกลายเป็นแสงเรืองแทนที่จะเป็นผิวนูน ซึ่งไม่ใช่สิ่งที่
// variant นี้มีไว้ทำ
//
// text-center อยู่บน <header> เท่านั้น ไม่ได้อยู่บนการ์ดหรือ <section> ถ้าย้ายขึ้นไป
// มันจะ inherit ลงไปใน slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#ff2fb0]/30 bg-[#05021a] p-8 text-left text-base leading-relaxed text-[#d8d3f0] shadow-[10px_10px_20px_#03010f,-10px_-10px_20px_#120a33]">
    {
      title && (
        <header class="mb-8 border-b border-[#ff7fd4]/25 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#ffc9ee] via-[#ff7fd4] to-[#ff2fb0] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
