---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// AURORA688: ย้ายจากนีออนม่วงคู่ทองของ GDK88 (#a855f7 / #d8b4fe / #5b1497 คู่
// #f0b429 / #ffd85e บนผิว #1b0733 เนื้อความ #ece0ff) มาที่ทองคู่เงินของแบรนด์นี้
// — ทองหลัก #e2c443 / #ffe9a3 / #c9a13a คู่เงินโครเมียม #c3cddb / #eef2f7
// บนผิว #15120a เนื้อความ #f2ead6
//
// คู่เงา neumorphic ต้องเป็นเฉดอ่อน/เข้มของสีการ์ดเอง ไม่ใช่สีแบรนด์ — เงาทอดใช้
// #050403 (เข้มกว่าพื้นหน้า) และไฮไลต์ใช้ #262010 (ผิวการ์ดยกขึ้นหนึ่งขั้น) ถ้าสลับ
// ไปใช้ #e2c443 การ์ดจะกลายเป็นแสงเรืองแทนที่จะเป็นผิวนูน ซึ่งไม่ใช่สิ่งที่ variant
// นี้มีไว้ทำ
//
// text-center อยู่บน <header> เท่านั้น ถ้าย้ายไปวางบนการ์ดมันจะ inherit ลงไปใน
// slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#e2c443]/30 bg-[#15120a] p-8 text-left text-base leading-relaxed text-[#f2ead6] shadow-[10px_10px_20px_#050403,-10px_-10px_20px_#262010]">
    {
      title && (
        <header class="mb-8 border-b border-[#c3cddb]/25 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#eef2f7] via-[#e2c443] to-[#c9a13a] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
