---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// ROOM89: ย้ายชุดสีของ variant นี้มาที่ทองคำขัดเงาคู่เงินแพลตินัมบนดำอมน้ำตาล —
// ทอง #f7edc4 / #e6cf72 / #c9a227 / #6b5424 / #3b2c10 คู่เงิน #e8ebef / #b9c2cc /
// #7c8794 บนผิวการ์ด #161009 เนื้อความ #f0e6cf (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้
// ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจาก
// ค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// เงินแพลตินัมเป็นโลหะที่สองของแบรนด์นี้จริง (เลข 89 บนโลโก้) จึงถูกใช้ปิดท้าย
// gradient ของหัวข้อ ส่วนตัวการ์ดยังเป็นผิวทองมืดเพื่อให้ทรงนูนอ่านออก
//
// คู่เงา neumorphic ต้องเป็นเฉดอ่อน/เข้มของสีการ์ดเอง ไม่ใช่สีแบรนด์ — เงาทอดใช้
// #070502 (เข้มกว่าพื้นหน้า) และไฮไลต์ใช้ #241a0d (ผิวการ์ดยกขึ้นหนึ่งขั้น) ถ้าสลับ
// ไปใช้ทองสด การ์ดจะกลายเป็นแสงเรืองแทนที่จะเป็นผิวนูน ซึ่งไม่ใช่สิ่งที่ variant นี้
// มีไว้ทำ
//
// รอบนี้ไฟล์นี้แบกหัวข้อ docx ข้อ 2 ซึ่งเป็น <h2>
//
// text-center อยู่บน <header> เท่านั้น ไม่ได้อยู่บนการ์ดหรือ <section> ถ้าย้ายขึ้นไป
// มันจะ inherit ลงไปใน slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#c9a227]/30 bg-[#161009] p-8 text-left text-base leading-relaxed text-[#f0e6cf] shadow-[10px_10px_20px_#070502,-10px_-10px_20px_#241a0d]">
    {
      title && (
        <header class="mb-8 border-b border-[#e6cf72]/25 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#f7edc4] via-[#e6cf72] to-[#b9c2cc] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
