---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// BLACKJACK789: ย้ายชุดสีของ variant นี้มาที่ทองแอนทีค/แชมเปญบนดำเกือบสนิท — ทอง
// #fdf1ce / #f2cf70 / #d3aa4b / #b8862c / #5c4113 บนผิวการ์ด #100b05 เนื้อความ
// #ede0c4 (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิม
// ได้จาก git history)
//
// โลหะที่สองของแบรนด์นี้คือกราไฟต์/กันเมทัล แต่การ์ดใบนี้ไม่หยิบมาใช้ ถ้าอยากได้
// คอนทราสต์บนการ์ดนี้ให้ใช้ทองสว่างขึ้นหรือทองเข้มลง
//
// คู่เงา neumorphic ต้องเป็นเฉดอ่อน/เข้มของสีการ์ดเอง ไม่ใช่สีแบรนด์ — เงาทอดใช้
// #050403 (เข้มกว่าพื้นหน้า) และไฮไลต์ใช้ #1e150a (ผิวการ์ดยกขึ้นหนึ่งขั้น) ถ้าสลับ
// ไปใช้ทองสด การ์ดจะกลายเป็นแสงเรืองแทนที่จะเป็นผิวนูน ซึ่งไม่ใช่สิ่งที่ variant นี้
// มีไว้ทำ
//
// รอบนี้ไฟล์นี้ถูกใช้สองครั้งบนหน้าแรก — หัวข้อ docx ข้อ 2 และข้อ 5 ทั้งคู่เป็น <h2>
//
// text-center อยู่บน <header> เท่านั้น ไม่ได้อยู่บนการ์ดหรือ <section> ถ้าย้ายขึ้นไป
// มันจะ inherit ลงไปใน slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#d3aa4b]/30 bg-[#100b05] p-8 text-left text-base leading-relaxed text-[#ede0c4] shadow-[10px_10px_20px_#050403,-10px_-10px_20px_#1e150a]">
    {
      title && (
        <header class="mb-8 border-b border-[#f2cf70]/25 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#fdf1ce] via-[#f2cf70] to-[#b8862c] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
