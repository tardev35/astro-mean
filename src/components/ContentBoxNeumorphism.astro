---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// FAST369: ย้ายจากแดงสัญญาณ + โครมเงินของ FUSIONNEW (#e01a1a / #ff5f52 / #8c0102
// คู่ #d9dde3 บนผิว #150809 เนื้อความ #e7e3e1) มาที่แดงสัญญาณ #e40613 / #ff3b2f /
// #8f0206 คู่ทอง #ffe27a / #ffc531 บนผิว #170506 เนื้อความ #f4e7dd
//
// คู่เงา neumorphic ต้องเป็นเฉดอ่อน/เข้มของสีการ์ดเอง ไม่ใช่สีแบรนด์ — เงาทอดใช้
// #050102 (เข้มกว่าพื้นหน้า) และไฮไลต์ใช้ #240709 (ผิวการ์ดยกขึ้นหนึ่งขั้น) ถ้าสลับ
// ไปใช้ #e40613 การ์ดจะกลายเป็นแสงเรืองแทนที่จะเป็นผิวนูน ซึ่งไม่ใช่สิ่งที่ variant
// นี้มีไว้ทำ
//
// text-center อยู่บน <header> เท่านั้น ถ้าย้ายไปวางบนการ์ดมันจะ inherit ลงไปใน
// slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#e40613]/30 bg-[#170506] p-8 text-left text-base leading-relaxed text-[#f4e7dd] shadow-[10px_10px_20px_#050102,-10px_-10px_20px_#240709]">
    {
      title && (
        <header class="mb-8 border-b border-[#e40613]/25 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#ffe27a] via-[#ff3b2f] to-[#e40613] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
