---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// LONGSAP168 (มังกรทอง + ไฟ บนพื้นดำสนิท): คู่เงา neumorphic ต้องเป็นเฉดอ่อน/เข้ม
// ของสีการ์ดเอง ไม่ใช่สีแบรนด์ — เงาทอดใช้ #0a0402 (พื้นหลังหน้า) และไฮไลต์ใช้
// #24100c (ผิวการ์ดยกขึ้นหนึ่งขั้น) ถ้าสลับไปใช้ #f2b024 การ์ดจะกลายเป็นแสงเรือง
// แทนที่จะเป็นผิวนูน ซึ่งไม่ใช่สิ่งที่ variant นี้มีไว้ทำ
//
// text-center อยู่บน <header> เท่านั้น ถ้าย้ายไปวางบนการ์ดมันจะ inherit ลงไปใน
// slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#f2b024]/30 bg-[#170806] p-8 text-left text-base leading-relaxed text-[#f6e4c8] shadow-[10px_10px_20px_#0a0402,-10px_-10px_20px_#24100c]">
    {
      title && (
        <header class="mb-8 border-b border-[#f2b024]/25 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#ffd76a] via-[#f2b024] to-[#d81f26] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
