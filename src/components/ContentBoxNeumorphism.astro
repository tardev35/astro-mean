---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// FUSIONNEW: ย้ายจากทองมังกร + ไฟของ LONGSAP168 (#ffd76a / #f2b024 / #d81f26 บน
// ผิว #170806 เนื้อความ #f6e4c8) มาที่แดงสัญญาณ #e01a1a / #ff5f52 / #8c0102 คู่
// โครมเงิน #d9dde3 บนผิวเกือบดำ #150809 เนื้อความ #e7e3e1
//
// คู่เงา neumorphic ต้องเป็นเฉดอ่อน/เข้มของสีการ์ดเอง ไม่ใช่สีแบรนด์ — เงาทอดใช้
// #050203 (เข้มกว่าพื้นหน้า) และไฮไลต์ใช้ #200c0e (ผิวการ์ดยกขึ้นหนึ่งขั้น) ถ้าสลับ
// ไปใช้ #e01a1a การ์ดจะกลายเป็นแสงเรืองแทนที่จะเป็นผิวนูน ซึ่งไม่ใช่สิ่งที่ variant
// นี้มีไว้ทำ
//
// text-center อยู่บน <header> เท่านั้น ถ้าย้ายไปวางบนการ์ดมันจะ inherit ลงไปใน
// slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#e01a1a]/30 bg-[#150809] p-8 text-left text-base leading-relaxed text-[#e7e3e1] shadow-[10px_10px_20px_#050203,-10px_-10px_20px_#200c0e]">
    {
      title && (
        <header class="mb-8 border-b border-[#e01a1a]/25 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#d9dde3] via-[#ff5f52] to-[#e01a1a] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
