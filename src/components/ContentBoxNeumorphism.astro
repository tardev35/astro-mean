---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// MAHAHENG333: ย้ายจากทองมังกรไฟของกงล้อ88 (#ffcc4b / #ffe974 / #eb9a1d คู่เปลวไฟ
// #ff6a13 บนผิว #1e1105 เนื้อความ #f6e6c2) มาที่ทองคาสิโนจีนของแบรนด์นี้ —
// #e8b923 / #ffe98a / #a5760a คู่แดงมงคล #b4231c / #6d1410 บนผิว #221708 เนื้อความ
// #f3e2b8 ไม่มีส้มเปลวไฟและไม่มีเขียว/ม่วงเหลืออยู่ในไฟล์
//
// คู่เงา neumorphic ต้องเป็นเฉดอ่อน/เข้มของสีการ์ดเอง ไม่ใช่สีแบรนด์ — เงาทอดใช้
// #0a0704 (เข้มกว่าพื้นหน้า) และไฮไลต์ใช้ #33230b (ผิวการ์ดยกขึ้นหนึ่งขั้น) ถ้าสลับ
// ไปใช้ #e8b923 การ์ดจะกลายเป็นแสงเรืองแทนที่จะเป็นผิวนูน ซึ่งไม่ใช่สิ่งที่ variant
// นี้มีไว้ทำ
//
// text-center อยู่บน <header> เท่านั้น ถ้าย้ายไปวางบนการ์ดมันจะ inherit ลงไปใน
// slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#e8b923]/30 bg-[#221708] p-8 text-left text-base leading-relaxed text-[#f3e2b8] shadow-[10px_10px_20px_#0a0704,-10px_-10px_20px_#33230b]">
    {
      title && (
        <header class="mb-8 border-b border-[#e8b923]/25 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#ffe98a] via-[#e8b923] to-[#a5760a] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
