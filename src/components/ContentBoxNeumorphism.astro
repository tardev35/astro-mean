---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// DRACO65: ย้ายจากม่วงโกธิคของ PHANTOM569 (#8b5cf6 / #b794ff / #ede9fe คู่
// #6d28d9 / #4c1d95 บนผิว #1c0343 เนื้อความ #ded4f5) มาที่เขียวมังกรนีออนของ
// แบรนด์นี้ — #22c55e / #4ade80 / #dcfce7 คู่เขียวเข้ม #15803d / #14532d บนผิว
// #062011 เนื้อความ #d6ecdd ไม่มีม่วงและไม่มีทองเหลืออยู่ในไฟล์
//
// คู่เงา neumorphic ต้องเป็นเฉดอ่อน/เข้มของสีการ์ดเอง ไม่ใช่สีแบรนด์ — เงาทอดใช้
// #020805 (เข้มกว่าพื้นหน้า) และไฮไลต์ใช้ #0a3318 (ผิวการ์ดยกขึ้นหนึ่งขั้น) ถ้าสลับ
// ไปใช้ #22c55e การ์ดจะกลายเป็นแสงเรืองแทนที่จะเป็นผิวนูน ซึ่งไม่ใช่สิ่งที่ variant
// นี้มีไว้ทำ
//
// text-center อยู่บน <header> เท่านั้น ถ้าย้ายไปวางบนการ์ดมันจะ inherit ลงไปใน
// slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#22c55e]/30 bg-[#062011] p-8 text-left text-base leading-relaxed text-[#d6ecdd] shadow-[10px_10px_20px_#020805,-10px_-10px_20px_#0a3318]">
    {
      title && (
        <header class="mb-8 border-b border-[#22c55e]/25 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#dcfce7] via-[#4ade80] to-[#22c55e] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
