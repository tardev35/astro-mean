---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// เมนูชุดเดียวใช้ทั้งจอใหญ่และลิ้นชักมือถือ — ห้ามแตกเป็นสอง array อีก
// ไอคอนอยู่ในข้อมูล แล้ว render เป็น <span aria-hidden> ที่เป็น "พี่น้อง" ของ
// ข้อความ ไม่ใช่แทรกอยู่ในตัวข้อความ
//
// ลำดับ: หน้าแรก → โปรโมชั่น → (สมัคร/เข้าสู่ระบบ ถ้าเปิด cta toggle) → ที่เหลือ
// JAICHUA ปิด cta toggle เหมือนแบรนด์ก่อน (/login กับ /register ยังเป็นหน้า
// interstitial แบบ noindex) จึงไม่มีสองรายการนั้นในเมนู เหลือปุ่ม CTA มุมขวา
// ตามที่ variant นี้วางไว้ และ /ทางเข้า ยังอยู่ในเมนูตามปกติ
//
// ไม่มี /ตรวจหวย กับ /แนวทาง เพราะ JAICHUA เป็นเว็บสล็อต ไม่ใช่เว็บหวย — สองหน้า
// นั้นถูกย้ายกลับไป src/pages-disabled/ รอบนี้ จึงไม่มี route ให้ลิงก์ไปหา
//
// JAICHUA: ย้ายจากม่วงไททันคู่มงกุฎทองของแบรนด์ก่อนที่เคยใช้ไฟล์นี้ มาเป็นทองคำ
// คู่น้ำเงินรอยัลบนกรมท่าเกือบดำ — ทอง #fbeec9 / #f6d67e / #d8a83f / #a97722 /
// #6d4a12 คู่น้ำเงิน #cfe0fb / #5b8ede / #2f5fb0 / #16336b บนผิว #040915 /
// #0a1226 / #132244 เนื้อความ #dce6f8
//
// อ่านจากอาร์ตเวิร์กจริง: ตัวอักษรโลโก้เป็นทองคำนูนทั้งชุด ดาวเข็มทิศด้านบนกับ
// เหรียญจีนสองข้างก็ทอง ส่วนโล่ที่รองตัวอักษรและพื้นแบนเนอร์เป็นน้ำเงินกรมท่า —
// ทองจึงเป็นสีนำ น้ำเงินเป็นสีที่สองจริง ไม่ใช่แค่เงาของทอง (vivid ของ logo.webp
// เด่นสุดคือ #946335 กับ #533c25 ซึ่งเป็นทอง ส่วน dominant ของ banner1 เป็นน้ำตาล
// เข้ม/ดำอมน้ำเงินซึ่งคือ "พื้น" — palette.json จัดอันดับให้ แต่ไม่ตีความให้)
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// ไอคอนเลือกตามแนวคาสิโนทอง — บ้าน/ของขวัญ/สล็อต/ประตู/ชิป/แชท
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🚪" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🪙" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];

const LOGO_ALT =
  "โลโก้ JAICHUA เป็นป้ายทองคำสามมิติบนโล่สีน้ำเงินกรมท่า ตัวอักษรไทยทองนูนอ่านว่า จ่ายชัวร์888 ใต้ลงมาเป็นตัวอักษรละติน JAI CHUA คั่นกลางด้วยดาวประกายทอง และแถบล่างสุดเขียนว่า CASINO ONLINE ด้านบนป้ายเป็นดาวเข็มทิศทองบนวงกลมน้ำเงิน มุมล่างสองข้างเป็นเหรียญจีนทองรูสี่เหลี่ยม";
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav
    class="relative mx-auto flex h-[85px] w-full items-center justify-between rounded-b-2xl border-b border-[#d8a83f]/40 bg-[#040915]/85 px-4 shadow-[0_10px_30px_rgba(216,168,63,0.3)] backdrop-blur-xl xl:px-8">
    <a href="/" class="z-[110] flex-shrink-0 transition-transform duration-300 hover:scale-105 hover:drop-shadow-[0_0_15px_rgba(246,214,126,0.5)]">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt={LOGO_ALT}
            loading="eager"
            widths={[140, 280, 420]}
            sizes="(max-width: 1279px) 140px, 180px"
            class="h-[55px] w-auto xl:h-[70px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <span class="bg-gradient-to-r from-[#fbeec9] to-[#a97722] bg-clip-text text-4xl font-black tracking-widest text-transparent drop-shadow-md">
            JAI<span class="bg-gradient-to-r from-[#cfe0fb] to-[#2f5fb0] bg-clip-text text-transparent">CHUA</span>
          </span>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-6 lg:flex">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-2 px-2 text-sm font-bold tracking-widest uppercase transition-colors duration-300 xl:text-base ${isActive(item.path) ? "text-[#f6d67e]" : "text-[#dce6f8]/60 hover:text-white"}`}>
            <span aria-hidden="true" class="text-base leading-none">
              {item.icon}
            </span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[3px] w-full rounded-t-full bg-gradient-to-r from-[#fbeec9] via-[#d8a83f] to-[#2f5fb0] shadow-[0_-2px_10px_rgba(216,168,63,0.8)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden items-center justify-center rounded-full border border-[#5b8ede]/50 bg-[#040915]/60 px-7 py-2.5 text-sm font-bold text-[#dce6f8] backdrop-blur-md transition-all duration-300 hover:bg-[#132244]/70 hover:text-white hover:shadow-[0_0_15px_rgba(91,142,222,0.4)] lg:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center rounded-full bg-gradient-to-r from-[#fbeec9] via-[#d8a83f] to-[#a97722] px-7 py-2.5 text-sm font-black text-[#040915] shadow-[0_4px_15px_rgba(216,168,63,0.4)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_8px_25px_rgba(251,238,201,0.6)] lg:flex">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] rounded-full border border-[#d8a83f]/30 bg-[#040915]/60 lg:hidden"
        aria-label="เปิดเมนู">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#f6d67e] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#f6d67e] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#f6d67e] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[85px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col rounded-b-3xl border-b border-[#d8a83f]/40 bg-[#040915]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-400 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 rounded-xl px-5 py-3.5 text-lg font-bold tracking-widest uppercase transition-colors ${isActive(item.path) ? "bg-[#132244]/70 text-[#f6d67e] shadow-inner" : "text-[#dce6f8]/60 hover:bg-white/5 hover:text-white"}`}>
            <span aria-hidden="true" class="text-xl leading-none">
              {item.icon}
            </span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center rounded-full bg-gradient-to-r from-[#fbeec9] to-[#a97722] py-3.5 text-lg font-black text-[#040915] shadow-[0_5px_15px_rgba(216,168,63,0.35)]">
        สมัครสมาชิก
      </a>
      <a href="/login" class="flex w-full justify-center rounded-full border border-[#5b8ede]/50 bg-[#040915]/60 py-3.5 text-lg font-bold text-[#dce6f8]">เข้าสู่ระบบ</a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
