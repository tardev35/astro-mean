---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

const { title, faqs = [] } = Astro.props;

// DRACO65: variant นี้ผ่านมาแล้วทั้งทองอ่อนของ JUDTEM168, ทองหลวงของ IOK66,
// แดงสัญญาณ + ทองของ FAST369 และล่าสุดเขียวนีออนมาเก๊า + ทองของ MACAUBET
// (#8ef04a / #59cb13 / #2c7a08 / #0f3a11 กับ #dcffc0 และทอง #f6c445 / #c8952a
// บนผิว #041b06 / #020b01 เนื้อความ #e9f9dc) ตอนนี้เป็นเขียวมังกรนีออน + เงิน —
// #4ade80 / #22c55e / #14532d / #052e16 กับ #dcfce7 และเงิน/โครเมียม #e2e8e4
// บนผิว #062011 / #040d07 เนื้อความ #d6ecdd ไม่มีทองเหลืออยู่ในไฟล์นี้
// accordion เป็น <details>/<summary> ไม่มี <script> และให้เป็นแบบนี้ต่อไป
//
// คำถามเป็น <span> ไม่ใช่ <h3> — เป็นระดับเดิมที่ variant นี้ ship มา และห้าม
// เลื่อนขึ้นเป็นหัวข้อ docx ของแบรนด์นี้แบนราบ (H1 + H2 ล้วน ไม่มี H3 ซ้อน)
// รายการ h2/h3 ที่ build พิมพ์ออกมาถูก diff กับ checklist ของ docx ด้วยมือ
// การเพิ่ม h3 ห้าตัวที่ไม่มีใน docx จะทำให้ diff นั้นเพี้ยนทุกรอบต่อจากนี้
// ตัว <summary> เองเป็น disclosure control ที่มีชื่อให้ assistive tech อยู่แล้ว
---

<div class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div
        class="mb-8 flex items-center gap-3 border-l-4 border-[#e2e8e4] bg-gradient-to-r from-[#052e16] via-[#052e16]/60 to-transparent px-4 py-2.5"
        style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
        <h2 class="text-xl leading-normal font-black tracking-widest text-[#dcfce7] uppercase md:text-2xl">{title}</h2>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-terminal"
          class="faq-item group relative overflow-hidden border border-[#22c55e]/30 bg-[#062011]/92 backdrop-blur-sm transition-all duration-300 hover:border-[#e2e8e4]/55 hover:shadow-[0_15px_40px_rgba(226,232,228,0.28)]"
          style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#4ade80] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2 text-base leading-normal font-bold text-[#d6ecdd] transition-colors group-hover:text-[#dcfce7] md:text-lg">
              <span aria-hidden="true" class="font-mono text-[#e2e8e4]">
                &gt;_
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-[#22c55e]/40 bg-[#040d07] text-lg font-black text-[#e2e8e4] transition-all duration-300 group-hover:border-[#4ade80]/60 group-hover:text-[#4ade80]"
              style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#14532d] p-5 pt-4 text-left text-base leading-relaxed text-[#d6ecdd]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</div>

<style>
  /* The removed <style> redefined `.rotate-45` with !important — a hand-written
     rule whose selector is also a Tailwind utility, so anything in this
     component using rotate-45 for its own reasons silently got a border and a
     colour change too. Keying the open state off [open] removes both the script
     and the collision. */
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(226, 232, 228, 0.6);
    box-shadow: 0 15px 40px rgba(34, 197, 94, 0.3);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #e2e8e4;
    color: #dcfce7;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
