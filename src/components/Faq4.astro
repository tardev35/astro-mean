---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

const { title, faqs = [] } = Astro.props;

// AURA456: variant นี้ผ่านมาแล้วหลายชุดสี รอบนี้ย้ายมาที่นีออนบานเย็นคู่ฟ้า
// อิเล็กทริกของแบรนด์นี้ที่วัดจากอาร์ตจริง — บานเย็น #ff2fb0 / #ff7fd4 / #ffc9ee /
// #c81d8e คู่ฟ้า #3ba9ff กับม่วง #8b3cf7 / #4a179e บนผิว #0b0528 / #05021a ขอบ
// #1c1046 เนื้อความ #d8d3f0 หัวข้อ #f6ebff ไม่มีสีของแบรนด์ก่อนเหลืออยู่ในไฟล์นี้
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history)
// accordion เป็น <details>/<summary> ไม่มี <script> และให้เป็นแบบนี้ต่อไป
//
// สัญลักษณ์ ◈ หน้าคำถามล้อกับป้ายลำดับขั้นทรงข้าวหลามตัดบนอาร์ตของแบรนด์นี้ มันเป็น
// ของตกแต่ง จึงอยู่ใน <span aria-hidden="true"> ของตัวเอง ไม่ปนกับข้อความ
//
// คำถามเป็น <span> ไม่ใช่ <h3> — เป็นระดับเดิมที่ variant นี้ ship มา และห้าม
// เลื่อนขึ้นเป็นหัวข้อ docx ของแบรนด์นี้แบนราบ (H1 + H2 ล้วน ไม่มี H3 ซ้อน)
// ตัว <summary> เองเป็น disclosure control ที่มีชื่อให้ assistive tech อยู่แล้ว
//
// บรรทัดหัวของบล็อกเป็น <p> ไม่ใช่ <h2>: docx มี H2 หกข้อพอดี และหกข้อนั้นถูกใช้
// ครบไปแล้วกับหกบล็อกเนื้อหาบนหน้าแรก หัว FAQ จึงจะกลายเป็น h2 ตัวที่เจ็ดที่ไม่มี
// ต้นทางใน docx ทำให้ inventory หัวข้อที่ Phase 5 diff กับ checklist เพี้ยนทุกรอบ
// ต่อจากนี้ คลาสเดิมอยู่ครบบน <p> หน้าตาจึงไม่เปลี่ยน และชื่อสำหรับ assistive
// tech ย้ายไปอยู่ที่ aria-label บน <section> แทน
---

<section aria-label={title ?? "คำถามที่พบบ่อย"} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div
        class="mb-8 flex items-center gap-3 border-l-4 border-[#ff2fb0] bg-gradient-to-r from-[#1c1046] via-[#05021a]/70 to-transparent px-4 py-2.5"
        style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
        <p class="text-xl leading-normal font-black tracking-widest text-[#f6ebff] uppercase md:text-2xl">{title}</p>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-terminal"
          class="faq-item group relative overflow-hidden border border-[#ff2fb0]/30 bg-[#0b0528]/92 backdrop-blur-sm transition-all duration-300 hover:border-[#ff2fb0]/55 hover:shadow-[0_15px_40px_rgba(255,47,176,0.28)]"
          style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#ff7fd4] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2 text-base leading-normal font-bold text-[#d8d3f0] transition-colors group-hover:text-[#f6ebff] md:text-lg">
              <span aria-hidden="true" class="text-[#3ba9ff]">
                ◈
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-[#ff2fb0]/40 bg-[#05021a] text-lg font-black text-[#ff2fb0] transition-all duration-300 group-hover:border-[#ff7fd4]/60 group-hover:text-[#ff7fd4]"
              style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#1c1046] p-5 pt-4 text-left text-base leading-relaxed text-[#d8d3f0]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  /* The removed <style> redefined `.rotate-45` with !important — a hand-written
     rule whose selector is also a Tailwind utility, so anything in this
     component using rotate-45 for its own reasons silently got a border and a
     colour change too. Keying the open state off [open] removes both the script
     and the collision. */
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(255, 47, 176, 0.6);
    box-shadow: 0 15px 40px rgba(200, 29, 142, 0.35);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #ff2fb0;
    color: #ff7fd4;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
