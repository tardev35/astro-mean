---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

const { title, faqs = [] } = Astro.props;

// SETH88: variant นี้ผ่านมาแล้วหลายชุดสี รอบนี้ย้ายมาที่ทองคำอียิปต์คู่บรอนซ์บนดำ
// อมน้ำตาลของหินวิหารที่วัดจากอาร์ตจริง — ทอง #fdf3d4 / #f7d774 / #e0a92b / #a9711a
// คู่บรอนซ์ #6b4210 บนผิว #0c0703 / #1b1109 / #2a1a0d เนื้อความ #f0e3cd
// ไม่มีสีของแบรนด์ก่อนเหลืออยู่ในไฟล์นี้ (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ —
// Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มี
// ใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
// accordion เป็น <details>/<summary> ไม่มี <script> และให้เป็นแบบนี้ต่อไป
//
// สัญลักษณ์ ◈ หน้าคำถามล้อกับข้าวหลามตัดทองในลายเครื่องประดับอียิปต์ของแบรนด์นี้
// มันเป็นของตกแต่งจึงอยู่ใน <span aria-hidden="true"> ของตัวเอง ไม่ปนกับข้อความ
//
// คำถามเป็น <span> ไม่ใช่ <h3> — เป็นระดับเดิมที่ variant นี้ ship มา และห้าม
// เลื่อนขึ้นเป็นหัวข้อ h3 สามตัวเดียวที่หน้าแรกรอบนี้มีได้เป็นของ FeatureHighlights
// ตัว <summary> เองเป็น disclosure control ที่มีชื่อให้ assistive tech อยู่แล้ว
//
// บรรทัดหัวของบล็อกเป็น <p> ไม่ใช่ <h2>: docx มี H2 หกข้อพอดี และหกข้อนั้นถูกใช้
// ครบไปแล้วกับหกบล็อกเนื้อหาบนหน้าแรก หัว FAQ จึงจะกลายเป็น h2 ตัวที่เจ็ดที่ไม่มี
// ต้นทางใน docx ทำให้ inventory หัวข้อที่ Phase 5 diff กับ checklist เพี้ยนทุกรอบ
// ต่อจากนี้ คลาสเดิมอยู่ครบบน <p> หน้าตาจึงไม่เปลี่ยน และชื่อสำหรับ assistive
// tech ย้ายไปอยู่ที่ aria-label บน <section> แทน
---

<section aria-label={title ?? "คำถามที่พบบ่อย"} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div
        class="mb-8 flex items-center gap-3 border-l-4 border-[#e0a92b] bg-gradient-to-r from-[#2a1a0d] via-[#1b1109]/70 to-transparent px-4 py-2.5"
        style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
        <p class="text-xl leading-normal font-black tracking-widest text-[#fdf3d4] uppercase md:text-2xl">{title}</p>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-terminal"
          class="faq-item group relative overflow-hidden border border-[#e0a92b]/30 bg-[#1b1109]/92 backdrop-blur-sm transition-all duration-300 hover:border-[#e0a92b]/55 hover:shadow-[0_15px_40px_rgba(224,169,43,0.25)]"
          style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#f7d774] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2 text-base leading-normal font-bold text-[#f0e3cd] transition-colors group-hover:text-[#fdf3d4] md:text-lg">
              <span aria-hidden="true" class="text-[#e0a92b]">
                ◈
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-[#a9711a]/55 bg-[#0c0703] text-lg font-black text-[#e0a92b] transition-all duration-300 group-hover:border-[#f7d774]/60 group-hover:text-[#f7d774]"
              style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#6b4210] p-5 pt-4 text-left text-base leading-relaxed text-[#f0e3cd]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  /* สถานะเปิดผูกกับ [open] แทนที่จะใช้ <script> และห้ามนิยาม .rotate-45 ทับ —
     ชื่อนั้นเป็น utility ของ Tailwind การเขียนกฎชนจะไปเปลี่ยนสีกับขอบของทุก
     element ที่บังเอิญใช้คลาสนี้ด้วยเหตุผลอื่น */
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(224, 169, 43, 0.6);
    box-shadow: 0 15px 40px rgba(107, 66, 16, 0.45);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #e0a92b;
    color: #f7d774;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
