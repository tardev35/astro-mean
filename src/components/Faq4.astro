---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

const { title, faqs = [] } = Astro.props;

// GDK88: variant นี้ผ่านมาแล้วทั้งทองอ่อน, ทองหลวง, แดงสัญญาณ + ทอง,
// เขียวนีออนมาเก๊า + ทอง, เขียวมังกรนีออน + เงิน และล่าสุดชมพูกลอส + ทองของ GALA89
// (#ffe6f2 / #ff4d9c / #d41c6b / #9e154a / #5a0526 กับทอง #f0c274 บนผิว #1f0311 /
// #12010a เนื้อความ #f7dce8) ตอนนี้เป็นนีออนม่วง + ทอง — สีเน้นหลัก #f3e8ff /
// #d8b4fe / #a855f7 / #5b1497 / #3c0a6b คู่สีเน้นรองทอง #f0b429 / #ffd85e บนผิว
// #150329 / #0a0118 เนื้อความ #ece0ff ไม่มีชมพูเหลืออยู่ในไฟล์นี้
// accordion เป็น <details>/<summary> ไม่มี <script> และให้เป็นแบบนี้ต่อไป
//
// คำถามเป็น <span> ไม่ใช่ <h3> — เป็นระดับเดิมที่ variant นี้ ship มา และห้าม
// เลื่อนขึ้นเป็นหัวข้อ docx ของแบรนด์นี้แบนราบ (H1 + H2 ล้วน ไม่มี H3 ซ้อน)
// รายการ h2/h3 ที่ build พิมพ์ออกมาถูก diff กับ checklist ของ docx ด้วยมือ
// การเพิ่ม h3 ห้าตัวที่ไม่มีใน docx จะทำให้ diff นั้นเพี้ยนทุกรอบต่อจากนี้
// ตัว <summary> เองเป็น disclosure control ที่มีชื่อให้ assistive tech อยู่แล้ว
---

<div class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div
        class="mb-8 flex items-center gap-3 border-l-4 border-[#f0b429] bg-gradient-to-r from-[#5b1497] via-[#5b1497]/60 to-transparent px-4 py-2.5"
        style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
        <h2 class="text-xl leading-normal font-black tracking-widest text-[#f3e8ff] uppercase md:text-2xl">{title}</h2>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-terminal"
          class="faq-item group relative overflow-hidden border border-[#a855f7]/30 bg-[#150329]/92 backdrop-blur-sm transition-all duration-300 hover:border-[#f0b429]/55 hover:shadow-[0_15px_40px_rgba(240,180,41,0.28)]"
          style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#d8b4fe] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2 text-base leading-normal font-bold text-[#ece0ff] transition-colors group-hover:text-[#f3e8ff] md:text-lg">
              <span aria-hidden="true" class="font-mono text-[#f0b429]">
                &gt;_
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-[#a855f7]/40 bg-[#0a0118] text-lg font-black text-[#f0b429] transition-all duration-300 group-hover:border-[#d8b4fe]/60 group-hover:text-[#ffd85e]"
              style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#3c0a6b] p-5 pt-4 text-left text-base leading-relaxed text-[#ece0ff]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</div>

<style>
  /* The removed <style> redefined `.rotate-45` with !important — a hand-written
     rule whose selector is also a Tailwind utility, so anything in this
     component using rotate-45 for its own reasons silently got a border and a
     colour change too. Keying the open state off [open] removes both the script
     and the collision. */
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(240, 180, 41, 0.6);
    box-shadow: 0 15px 40px rgba(168, 85, 247, 0.3);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #f0b429;
    color: #ffd85e;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
