---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

const { title, faqs = [] } = Astro.props;

// คำถาม render เป็น <span> ไม่ใช่ <h3> — docx ของแบรนด์นี้ถูกเติมมาแบนราบ (H1 + H2
// ล้วน ไม่มี H3 เลย) และ inventory หัวข้อบนหน้าถูกไล่เทียบกับ brief ทุกรอบรีแบรนด์
// คำถาม FAQ ที่โผล่มาเป็น <h3> คือสิ่งที่ทำให้การเทียบนั้นไม่ตรง อีกอย่าง <span>
// เป็นตัวเลือกเดียวที่ปลอดภัยใน <summary> ซึ่ง content model เป็น phrasing content
// — <p> ตรงนั้นไม่ถูกต้องตามสเปก
//
// บรรทัดหัว FAQ เป็น <p> ไม่ใช่ <h2> (คลาสเดิมทั้งชุด) — FAQ เป็น widget ไม่ใช่
// section ของ docx และ docx รอบนี้มี H2 ครบหกข้อไปแล้ว ชื่อ section สำหรับ
// assistive tech จึงอยู่ที่ aria-label ของ <section> แทน ห้ามเลื่อน <p> ตัวนี้
// กลับขึ้นเป็นหัวข้อเพื่อ "แก้" เรื่องชื่อ section
//
// PHOENIX168: ไฟล์นี้มาถึงรอบนี้ในชุดม่วงคู่ทองของแบรนด์ก่อนหน้า รอบนี้ย้ายทั้งไฟล์
// มาที่ไฟฟีนิกซ์คู่ทองขนนก — ส้มไฟ #ff5a1e / #ffa14a / #ffe2c4 / #c04a12 / #7a2408
// คู่ทอง #f3ac3c / #f4dc6d และผิว #1f0a05 / #0a0402 เนื้อความ #f2ddc9
// ไม่มีสีของแบรนด์ก่อนเหลืออยู่ (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind
// สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้
// ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// ลูกศรกับเส้นคำตอบรับทองขนนก เพื่อให้สีคู่ของแบรนด์มีที่ยืนใน widget นี้ ไม่ใช่
// ส้มล้วนทุกจุด
//
// ค่า `name` ของ <details> ผูกกลุ่ม accordion เข้าด้วยกัน (เปิดได้ทีละใบ) และต้อง
// เป็นชื่อของแบรนด์ปัจจุบัน ไม่ใช่ของแบรนด์ก่อน เพราะมันติดไปกับ HTML ที่ ship
---

<section aria-label={title} class="mx-auto max-w-[950px] space-y-6 px-4 py-6 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <p class="bg-gradient-to-r from-[#ffe2c4] via-[#ff5a1e] to-[#f3ac3c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </p>
        <div class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ff5a1e] to-transparent" />
      </header>
    )
  }

  {
    faqs.map((faq) => (
      <div class="group relative bg-[#7a2408] p-[1px] [clip-path:polygon(0_0,calc(100%-20px)_0,100%_20px,100%_100%,20px_100%,0_calc(100%-20px))]">
        <div class="absolute inset-0 bg-gradient-to-r from-[#f3ac3c] via-[#ff5a1e] to-transparent opacity-40 transition-opacity group-hover:opacity-100" />

        <details name="faq-phoenix168" class="faq-item relative bg-[#1f0a05] p-4 [clip-path:polygon(0_0,calc(100%-19px)_0,100%_19px,100%_100%,19px_100%,0_calc(100%-19px))]">
          <summary class="flex w-full cursor-pointer items-center gap-4 text-left">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 shrink-0 items-center justify-center bg-gradient-to-br from-[#ffe2c4] to-[#ff5a1e] font-black text-[#0a0402] italic [clip-path:polygon(20%_0,100%_0,80%_100%,0_100%)]">
              ?
            </span>
            <span class="flex-1 text-base leading-normal font-bold tracking-tight text-[#f2ddc9]">{faq.q}</span>
            <span aria-hidden="true" class="faq-arrow shrink-0 text-[#f3ac3c] transition-transform duration-300">
              ▼
            </span>
          </summary>

          <p class="faq-answer mt-4 border-l-2 border-[#ff5a1e]/50 pl-4 text-left text-base leading-relaxed text-[#f2ddc9]/85">{faq.a}</p>
        </details>
      </div>
    ))
  }
</section>

<style>
  /* ใช้ <details> แทนปุ่ม + สคริปต์ max-height สถานะเปิด/ปิด การรับคีย์บอร์ด และ
     การประกาศ expanded/collapsed มาจากตัว element เอง จึงไม่มี JS ให้เขียนพลาด
     และไม่มีอะไรให้การรีแบรนด์ทำพังด้วยการแก้สไตล์
     สิ่งที่มันแก้: ป้ายกับลูกศรไม่ได้ aria-hidden ชื่อที่อ่านออกของทุกคำถามจึงเป็น
     "? <คำถาม> ▼" ส่วนแผงคำตอบถูกปิดด้วย max-h-0 ซึ่งยังอยู่ใน accessibility tree
     และคีย์บอร์ดเข้าถึงได้ทั้งที่มองไม่เห็น และ aria-expanded ถูกตั้งไว้โดยไม่มี
     aria-controls ให้ชี้ */
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
