---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { brandFlag, brandPick } from "../lib/brandProfile";

// สีประจำแบรนด์ธนาคารจริง — ไม่เคยถูก retheme ไปตามพาเลตของแบรนด์ปัจจุบัน
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// ไฟล์นี้เคยเป็น `<script define:vars={{ bankPool }}>` ที่สร้างห้าแถวด้วย innerHTML
// แล้วรัน setInterval ตลอดกาล — define:vars บังคับ is:inline ซึ่งตัด type/async/defer
// ทิ้งและทิ้งสคริปต์ที่บล็อก parser ไว้กลางเอกสาร tools/verify-build.mjs ฟ้อง build
// ตก ตอนนี้แถวถูก server-render ที่นี่ ลิสต์ธนาคารเดินทางเป็น JSON เฉยๆ ข้างล่าง
// และ src/lib/winnersFeed.ts (ใช้ร่วมกับ feed variant ตัวอื่น และทำงานด้วย selector
// จึงไม่ต้องแก้) รับช่วงหมุนแถวต่อ พร้อมตัวกันเรื่อง on-screen / แท็บซ่อน /
// reduced-motion
//
// ค่าที่เห็นมาจาก hash ของโดเมนแบรนด์ ไม่ใช่ Math.random(): Math.random() ใน
// frontmatter รันตอน BUILD ทุก deploy จึงจะปั่น markup ของเว็บจริงใหม่โดยไม่ได้อะไร
// brandPick()/brandFlag() ทำให้ build สองครั้งของโดเมนเดียวกันออกมาเหมือนกันไบต์ต่อไบต์
//
// การ retheme ไฟล์นี้แปลว่าแก้ markup กับคลาสเท่านั้น เก็บ data-winner-* ทุกตัวและ
// คู่ data-pending-text/data-done-text ไว้ที่เดิม — โมดูลอ่านถ้อยคำ คลาสสถานะ และ
// ตัวเลขทุกตัวที่ใช้ (interval, เพดานแถว, ช่วงยอด, รูปแบบยูสเซอร์) จาก DOM จึงไม่
// ต้องรู้จักพาเลตของแบรนด์นี้และไม่ต้องเปิด src/lib เลย
//
// ROSTY59: feed ตัวนี้เป็น inventory ที่ค้างชุดสีและชื่อแบรนด์ก่อนหน้าฝังไว้ใน JSX
// รอบนี้ย้ายมาที่ทองอำพันคู่โครเมียมเงินของแบรนด์นี้ — ทองแกน #f2a01a / #ffc94a /
// #ffeec2 คู่เงิน #dbe1e8 / #a3adba / #5d6773 กับเฉดทองเข้ม #b06a0d / #6b3f07 บนผิว
// เกือบดำ #070505 / #150e07 / #26180a ขอบ #4a2f0d เนื้อความ #ece0cc ข้อความรอง
// #bda98c (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิม
// ได้จาก git history) แถบสีธนาคารกับเขียว verified อยู่เหมือนเดิม
//
// feed นี้วางต่อท้ายหัวข้อ docx ข้อ 7 ที่พูดถึงระบบฝากถอนออโต้ผ่าน Gateway ตรง
// เป็นหลักฐานว่ารายการเดินด้วยความเร็วเท่ากันทุกช่วงเวลา
const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pickFrom = (chars: string, salt: string) => chars.charAt(brandPick(Astro.site, salt, chars.length));

const initialRows = Array.from({ length: 5 }, (_, i) => ({
  bank: bankPool[brandPick(Astro.site, `winner-bank-${i}`, bankPool.length)],
  user: `${pickFrom(LETTERS, `winner-a-${i}`)}${pickFrom(LETTERS, `winner-b-${i}`)}***${[0, 1, 2, 3].map((d) => brandPick(Astro.site, `winner-d${i}-${d}`, 10)).join("")}`,
  amount: (15000 + brandPick(Astro.site, `winner-amount-${i}`, 80001)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `winner-pending-${i}`),
}));
---

<div class="mx-auto w-full max-w-[900px] p-4 font-sans">
  <section
    aria-label="ประวัติการถอนเงินล่าสุดของสมาชิก ROSTY59"
    class="relative overflow-hidden rounded-[30px] border-2 border-[#f2a01a]/45 bg-[#150e07]/90 px-4 py-8 shadow-[0_10px_30px_rgba(242,160,26,0.25)] backdrop-blur-md md:p-10">
    <div class="pointer-events-none absolute -top-16 -right-10 h-40 w-40 rounded-full bg-[#4a2f0d]/70 blur-[60px]"></div>
    <div class="pointer-events-none absolute -bottom-16 -left-10 h-40 w-40 rounded-full bg-[#f2a01a]/35 blur-[60px]"></div>

    <div class="relative z-10 mb-8 text-center">
      <p class="bg-gradient-to-r from-[#ffeec2] via-[#ffc94a] to-[#dbe1e8] bg-clip-text text-xl font-black text-transparent md:text-3xl">ประวัติการถอนเงินของสมาชิก ROSTY59 แบบเรียลไทม์</p>
      <p class="mt-2 text-base leading-relaxed text-[#ece0cc]/80">
        ฝากถอนผ่านระบบออโต้ไฮสปีด ทำรายการเสร็จสรรพใน 3 วินาทีผ่าน Gateway ตรง รองรับทั้งธนาคารชั้นนำและวอลเล็ท ไม่ต้องส่งสลิปให้แอดมินตรวจ ไม่ต้องรอคิวอนุมัติ ถอนยอดไหนก็เงินเข้าเต็มจำนวนทันที
        และทำงานด้วยความเร็วเท่ากันตลอด 24 ชั่วโมง ตัวเลขด้านล่างเป็นข้อมูลตัวอย่างสำหรับแสดงรูปแบบรายการเท่านั้น
      </p>
    </div>

    <div
      data-winners-feed
      data-interval="4200"
      data-max-rows="5"
      data-amount-min="15000"
      data-amount-max="95000"
      data-pending-chance="0.4"
      data-user-style="letters"
      data-user-digits="4"
      class="relative z-10 ml-4 border-l-2 border-[#f2a01a]/55 pl-6 md:ml-8 md:pl-8">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row relative mb-6 transition-all duration-500 ease-out">
            <div class="absolute top-2 -left-[35px] h-4 w-4 rounded-full border-2 border-[#070505] bg-[#f2a01a] shadow-[0_0_10px_rgba(242,160,26,0.8)] md:-left-[43px]" />

            <div class="flex items-center gap-4 rounded-[20px] bg-gradient-to-r from-[#26180a]/70 to-transparent p-4 transition-colors hover:from-[#4a2f0d]/60">
              <div data-winner-bank class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${row.bank.color}`}>
                <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
              </div>

              <div class="min-w-0 flex-1">
                <div class="text-sm text-[#bda98c]">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-[#ece0cc]">
                    {row.user}
                  </span>
                </div>
                <div class="text-xl font-black text-[#ffc94a]">
                  <span data-winner-amount>{row.amount}</span> THB
                </div>
              </div>

              <div
                data-winner-status
                data-pending-text="กำลังโอน"
                data-done-text="โอนสำเร็จ"
                data-pending-class="is-pending"
                data-done-class="is-verified"
                class={`winner-status hidden shrink-0 rounded-full border px-3 py-1 text-[10px] tracking-widest md:block ${row.pending ? "is-pending" : "is-verified"}`}>
                {row.pending ? "กำลังโอน" : "โอนสำเร็จ"}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  // ไม่ใช่ `define:vars` — ตัวนั้นบังคับ is:inline ซึ่งตัด type/async/defer ทิ้งและ
  // ทิ้งสคริปต์ที่บล็อก parser ไว้กลางเอกสาร ลิสต์ธนาคารเดินทางมาเป็น JSON เฉยๆ
  // ข้างบนแทน และโมดูลนี้ถูก bundle กับ defer เหมือนโมดูลอื่นทุกตัว
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  /* สีของสถานะสองตัวเป็นคลาสแทนที่จะเป็นสตริงในโค้ด เพื่อให้ JS ใน
     src/lib/winnersFeed.ts ไม่ต้องรู้ว่าพาเลตของแบรนด์นี้คืออะไร
     สถานะ "กำลังโอน" รับเงินโครเมียมซึ่งเป็นสีที่สองของแบรนด์นี้ ส่วนเขียว
     verified เป็นสัญญาณความสำเร็จ ไม่ใช่สีแบรนด์ — มันเป็นเขียวเหมือนกัน
     ทุกแบรนด์ */
  .winner-status.is-pending {
    color: #ece0cc;
    border-color: #5d6773;
  }
  .winner-status.is-verified {
    color: oklch(79.2% 0.209 151.711);
    border-color: color-mix(in oklab, oklch(72.3% 0.219 149.579) 50%, transparent);
  }

  .winner-row.is-entering {
    transform: translateX(-1rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
