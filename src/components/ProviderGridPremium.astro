---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";
//
// ชื่อค่ายในลิสต์นี้ต้องตรงกับ "โลโก้ที่พิมพ์อยู่บนรูปจริง" เพราะ alt ถูกประกอบจาก
// ชื่อนั้น — ไฟล์ในโฟลเดอร์ providers/ อ่านออกมาได้ตามนี้ game1 = PG (Pocket Games
// Soft), game2 = SexySlot, game3 = SlotXO, game4 = Joker, game5 = JILI,
// game6 = PP SLOT (Pragmatic Play) ถ้าจะเปลี่ยนชื่อค่ายของช่องไหน ต้องเปลี่ยนไฟล์
// รูปตามด้วย ห้ามตั้งชื่อค่ายที่โฟลเดอร์นี้ไม่มีโลโก้อยู่จริง
//
// GDK88: ย้ายจากทองมังกรจีนบนดำของ MAHAHENG333 (#ffe98a / #e8b923 / #a5760a คู่แดง
// #b4231c / #6d1410 บนผิว #221708 / #15100a / #0a0704 / #33230b เนื้อความ #f3e2b8
// ข้อความรอง #c2a469) มาที่นีออนม่วงคู่ทองของแบรนด์นี้ — สีเน้นหลัก #a855f7 /
// #d8b4fe / #5b1497 คู่สีเน้นรองทอง #f0b429 / #ffd85e บนผิว #1b0733 / #0a0118 /
// #2a0f45 เนื้อความ #ece0ff ข้อความรอง #c9a6f0
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อค่ายอยู่ใน alt ของรูป ไม่ใช่หัวข้อ
const providers = [
  { alt: "PG (Pocket Games Soft)", users: "4,592", isHot: true, img: img1 },
  { alt: "SexySlot", users: "2,184", isHot: true, img: img2 },
  { alt: "SlotXO", users: "3,845", isHot: false, img: img3 },
  { alt: "Joker", users: "2,901", isHot: true, img: img4 },
  { alt: "JILI", users: "1,754", isHot: false, img: img5 },
  { alt: "Pragmatic Play", users: "3,245", isHot: true, img: img6 },
];
---

<section aria-label="ค่ายเกมฮิตที่ GDK88 ยกมารวมไว้ในล็อบบี้เดียว" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans sm:px-6 lg:px-8">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#a855f7]/30 bg-[#1b0733]/88 px-6 py-6 text-center shadow-[0_10px_30px_rgba(168,85,247,0.18)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_10px_rgba(168,85,247,0.7)]">⚡</span>
    <p class="bg-gradient-to-r from-[#f3e8ff] via-[#a855f7] to-[#f0b429] bg-clip-text text-3xl font-black tracking-wide text-transparent">
      ค่ายเกมฮิตที่ GDK88 ยกมารวมไว้ในล็อบบี้เดียว
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#c9a6f0]">
      ทุกค่ายเปิดให้เข้าใช้งานจากบัญชีเดียว อยากเปลี่ยนฟีลเปลี่ยนบรรยากาศตอนไหนก็คลิกเลือกเกมใหม่ได้ทันที ไม่ต้องโยกเงินหรือออกจากระบบ
    </p>
    <div class="mt-2 h-[2px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f0b429] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-6">
    {
      providers.map((p) => (
        <div class="group relative flex flex-col overflow-hidden rounded-2xl bg-[#1b0733] shadow-[0_10px_30px_rgba(168,85,247,0.15)] transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_15px_35px_rgba(168,85,247,0.3)]">
          <div class="pointer-events-none absolute inset-0 z-20 rounded-2xl border border-[#2a0f45] transition-all duration-500 group-hover:border-[#a855f7]/60 group-hover:shadow-[inset_0_0_20px_rgba(168,85,247,0.25)]" />

          <div class="absolute top-0 left-0 z-10 flex items-center gap-1.5 rounded-br-xl border-r border-b border-[#2a0f45] bg-[#0a0118]/85 px-3 py-1.5 text-[10px] font-medium text-[#c9a6f0] backdrop-blur-md transition-colors group-hover:text-[#f3e8ff]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
            </svg>
            {p.users}
          </div>

          {p.isHot && (
            <div class="absolute top-0 right-0 z-10 flex items-center gap-1 rounded-bl-xl border-b border-l border-[#f0b429]/60 bg-gradient-to-r from-[#ffd85e] to-[#f0b429] px-3 py-1.5 text-[10px] font-black tracking-wide text-[#0a0118] shadow-md">
              <span aria-hidden="true" class="animate-pulse">
                🔥
              </span>{" "}
              HOT
            </div>
          )}

          <Picture
            src={p.img}
            alt={`โลโก้ค่ายเกม ${p.alt} ค่ายพันธมิตรที่เปิดให้เข้าเล่นบน GDK88`}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            loading="lazy"
            fetchpriority="low"
            widths={[200, 400]}
            sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 200px"
            decoding="async"
            class="block aspect-square w-full object-cover opacity-95 transition-transform duration-700 group-hover:scale-110 group-hover:opacity-100"
          />

          <div
            aria-hidden="true"
            class="pointer-events-none absolute -bottom-10 left-0 h-20 w-full bg-gradient-to-t from-[#a855f7]/45 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
          />
        </div>
      ))
    }
  </div>
</section>
