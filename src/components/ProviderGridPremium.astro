---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";
//
// ชื่อค่ายในลิสต์นี้ต้องตรงกับ "โลโก้ที่พิมพ์อยู่บนรูปจริง" เพราะ alt ถูกประกอบจาก
// ชื่อนั้น — ไฟล์ในโฟลเดอร์ providers/ อ่านออกมาได้ตามนี้ game1 = PG (Pocket Games
// Soft) ซึ่งก็คือ PG Soft ในบรีฟ, game2 = SexySlot, game3 = SlotXO, game4 = Joker
// ซึ่งก็คือ Joker Gaming ในบรีฟ, game5 = JILI, game6 = PP SLOT ซึ่งก็คือ Pragmatic
// Play ในบรีฟ ถ้าจะเปลี่ยนชื่อค่ายของช่องไหน ต้องเปลี่ยนไฟล์รูปตามด้วย ห้ามตั้งชื่อ
// ค่ายที่โฟลเดอร์นี้ไม่มีโลโก้อยู่จริง
//
// GUESS168: feed นี้ถูกต่อเข้าหน้าแรกครั้งแรกในรอบนี้ จึงมาพร้อมชุดสีกับชื่อแบรนด์
// ของแบรนด์ก่อนฝังอยู่ใน JSX รอบนี้ย้ายมาที่ทองหลอมของแบรนด์นี้ — สีเน้นหลัก
// #fecc02 / #ffe680 / #ffd54a / #c58a00 คู่สีเน้นรองส้มไฟ #fe9c01 / #a35800
// บนผิว #140800 / #231005 / #33180a เนื้อความ #f7e7c6 ข้อความรอง #d8bb87
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย)
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อค่ายอยู่ใน alt ของรูป ไม่ใช่หัวข้อ
const providers = [
  { alt: "PG Soft (Pocket Games Soft)", users: "4,592", isHot: true, img: img1 },
  { alt: "SexySlot", users: "2,184", isHot: true, img: img2 },
  { alt: "SlotXO", users: "3,845", isHot: false, img: img3 },
  { alt: "Joker Gaming", users: "2,901", isHot: true, img: img4 },
  { alt: "JILI", users: "1,754", isHot: false, img: img5 },
  { alt: "Pragmatic Play", users: "3,245", isHot: true, img: img6 },
];
---

<section aria-label="ค่ายเกมลิขสิทธิ์ที่ GUESS168 คัดมารวมไว้ในคลังเดียว" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans sm:px-6 lg:px-8">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#c58a00]/30 bg-[#231005]/88 px-6 py-6 text-center shadow-[0_10px_30px_rgba(197,138,0,0.18)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_10px_rgba(254,204,2,0.7)]">⚡</span>
    <p class="bg-gradient-to-r from-[#fff6e0] via-[#fecc02] to-[#fe9c01] bg-clip-text text-3xl font-black tracking-wide text-transparent">ค่ายเกมลิขสิทธิ์ที่ GUESS168 คัดมารวมไว้ในคลังเดียว</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#d8bb87]">
      คัดกรองเฉพาะค่ายใหญ่มาตรฐานสากลอย่าง PG Soft, Pragmatic Play และ Joker Gaming ทุกค่ายเปิดให้เข้าใช้งานจากยูสเซอร์เดียว ทุกเกมผ่านการทดสอบอัตราจ่ายมาแล้ว อยากสลับค่ายตอนไหนก็คลิกเลือกได้ทันที
      ไม่ต้องโยกเงินหรือออกจากระบบ
    </p>
    <div class="mt-2 h-[2px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fecc02] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-6">
    {
      providers.map((p) => (
        <div class="group relative flex flex-col overflow-hidden rounded-2xl bg-[#231005] shadow-[0_10px_30px_rgba(197,138,0,0.15)] transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_15px_35px_rgba(254,204,2,0.3)]">
          <div class="pointer-events-none absolute inset-0 z-20 rounded-2xl border border-[#33180a] transition-all duration-500 group-hover:border-[#fecc02]/60 group-hover:shadow-[inset_0_0_20px_rgba(254,204,2,0.25)]" />

          <div class="absolute top-0 left-0 z-10 flex items-center gap-1.5 rounded-br-xl border-r border-b border-[#33180a] bg-[#140800]/85 px-3 py-1.5 text-[10px] font-medium text-[#d8bb87] backdrop-blur-md transition-colors group-hover:text-[#fff6e0]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
            </svg>
            {p.users}
          </div>

          {p.isHot && (
            <div class="absolute top-0 right-0 z-10 flex items-center gap-1 rounded-bl-xl border-b border-l border-[#fe9c01]/60 bg-gradient-to-r from-[#ffd54a] to-[#fe9c01] px-3 py-1.5 text-[10px] font-black tracking-wide text-[#140800] shadow-md">
              <span aria-hidden="true" class="animate-pulse">
                🔥
              </span>{" "}
              HOT
            </div>
          )}

          <Picture
            src={p.img}
            alt={`โลโก้ค่ายเกม ${p.alt} ค่ายลิขสิทธิ์ที่เปิดให้เข้าเล่นบน GUESS168`}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            loading="lazy"
            fetchpriority="low"
            widths={[200, 400]}
            sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 200px"
            decoding="async"
            class="block aspect-square w-full object-cover opacity-95 transition-transform duration-700 group-hover:scale-110 group-hover:opacity-100"
          />

          <div
            aria-hidden="true"
            class="pointer-events-none absolute -bottom-10 left-0 h-20 w-full bg-gradient-to-t from-[#fecc02]/45 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
          />
        </div>
      ))
    }
  </div>
</section>
