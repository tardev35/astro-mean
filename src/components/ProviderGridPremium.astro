---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";
//
// ชื่อค่ายในลิสต์นี้ต้องตรงกับ "โลโก้ที่พิมพ์อยู่บนรูปจริง" เพราะ alt ถูกประกอบจาก
// ชื่อนั้น — ไฟล์ในโฟลเดอร์ providers/ อ่านออกมาได้ตามนี้ game1 = PG (Pocket Games
// Soft) ซึ่งก็คือ PG Soft ในบรีฟ, game2 = SexySlot, game3 = SlotXO, game4 = Joker
// ซึ่งก็คือ Joker Gaming ในบรีฟ, game5 = JILI, game6 = PP SLOT ซึ่งก็คือ Pragmatic
// Play ในบรีฟ ถ้าจะเปลี่ยนชื่อค่ายของช่องไหน ต้องเปลี่ยนไฟล์รูปตามด้วย ห้ามตั้งชื่อ
// ค่ายที่โฟลเดอร์นี้ไม่มีโลโก้อยู่จริง
//
// PHOENIX168: กริดนี้มาถึงรอบนี้ในชุดม่วงคู่ทองของแบรนด์ก่อนหน้า พร้อมชื่อแบรนด์ก่อน
// ฝังอยู่ใน JSX สามจุด (aria-label ของ section, บรรทัดหัวกระดาน และเทมเพลต alt ของ
// ทุกช่อง) รอบนี้ย้ายทั้งไฟล์มาที่ไฟฟีนิกซ์คู่ทองขนนก — ส้มไฟ #ff5a1e / #ffa14a /
// #ffe2c4 / #c04a12 / #7a2408 คู่ทอง #f3ac3c / #f4dc6d บนผิว #0a0402 / #150703 /
// #1f0a05 เนื้อความ #f2ddc9 ข้อความรอง #c4a08a
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย)
//
// ป้าย HOT ใช้ทองขนนกเป็นพื้น เพราะเป็นจุดเดียวในกริดที่ต้องการตัวหนังสือสีเข้มบน
// พื้นสว่าง — ส้มไฟคอนทราสต์ไม่พอสำหรับตัวหนังสือเข้ม
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อค่ายอยู่ใน alt ของรูป ไม่ใช่หัวข้อ — ห้ามเลื่อนชื่อค่ายขึ้นเป็น
// <h3> เพราะ docx รอบนี้แบน H1 + H2 ล้วน และ inventory หัวข้อบนหน้าถูกไล่เทียบกับ
// brief ทุกรอบรีแบรนด์ กริดนี้เป็นภาพประกอบของหัวข้อ docx ข้อ 3 เรื่องคลังเกม
// ลิขสิทธิ์แท้หลายค่าย จึงวางต่อท้ายบล็อกนั้นทันที
const providers = [
  { alt: "PG Soft (Pocket Games Soft)", users: "4,592", isHot: true, img: img1 },
  { alt: "SexySlot", users: "2,184", isHot: true, img: img2 },
  { alt: "SlotXO", users: "3,845", isHot: false, img: img3 },
  { alt: "Joker Gaming", users: "2,901", isHot: true, img: img4 },
  { alt: "JILI", users: "1,754", isHot: false, img: img5 },
  { alt: "Pragmatic Play", users: "3,245", isHot: true, img: img6 },
];
---

<section aria-label="ค่ายเกมลิขสิทธิ์แท้ที่ PHOENIX168 ขนมาไว้ในคลังเดียว" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans sm:px-6 lg:px-8">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#c04a12]/30 bg-[#1f0a05]/88 px-6 py-6 text-center shadow-[0_10px_30px_rgba(255,90,30,0.18)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_10px_rgba(255,90,30,0.7)]">🔥</span>
    <p class="bg-gradient-to-r from-[#ffe2c4] via-[#ff5a1e] to-[#f3ac3c] bg-clip-text text-3xl font-black tracking-wide text-transparent">ค่ายเกมลิขสิทธิ์แท้ที่ PHOENIX168 ขนมาไว้ในคลังเดียว</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#c4a08a]">
      ยิงตรง API แท้จากค่ายใหญ่อย่าง PG Soft, Pragmatic Play และ Joker Gaming ทุกค่ายเปิดให้เข้าใช้งานจากยูสเซอร์เดียว คัดมาเฉพาะตัวที่แตกง่าย มีฟีเจอร์ตัวคูณหนัก ฟรีสปินเข้าไว
      อยากสลับค่ายตอนไหนก็คลิกเลือกได้ทันที กระเป๋าเดียวไม่ต้องโยกเงินหรือออกจากระบบ
    </p>
    <div class="mt-2 h-[2px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ff5a1e] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-6">
    {
      providers.map((p) => (
        <div class="group relative flex flex-col overflow-hidden rounded-2xl bg-[#1f0a05] shadow-[0_10px_30px_rgba(122,36,8,0.15)] transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_15px_35px_rgba(255,90,30,0.3)]">
          <div class="pointer-events-none absolute inset-0 z-20 rounded-2xl border border-[#7a2408] transition-all duration-500 group-hover:border-[#ff5a1e]/60 group-hover:shadow-[inset_0_0_20px_rgba(255,90,30,0.25)]" />

          <div class="absolute top-0 left-0 z-10 flex items-center gap-1.5 rounded-br-xl border-r border-b border-[#7a2408] bg-[#0a0402]/85 px-3 py-1.5 text-[10px] font-medium text-[#c4a08a] backdrop-blur-md transition-colors group-hover:text-[#ffe2c4]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
            </svg>
            {p.users}
          </div>

          {p.isHot && (
            <div class="absolute top-0 right-0 z-10 flex items-center gap-1 rounded-bl-xl border-b border-l border-[#c04a12]/60 bg-gradient-to-r from-[#f4dc6d] to-[#f3ac3c] px-3 py-1.5 text-[10px] font-black tracking-wide text-[#1f0a05] shadow-md">
              <span aria-hidden="true" class="animate-pulse">
                🔥
              </span>{" "}
              HOT
            </div>
          )}

          <Picture
            src={p.img}
            alt={`โลโก้ค่ายเกม ${p.alt} ค่ายลิขสิทธิ์ที่เปิดให้เข้าเล่นบน PHOENIX168`}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            loading="lazy"
            fetchpriority="low"
            widths={[200, 400]}
            sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 200px"
            decoding="async"
            class="block aspect-square w-full object-cover opacity-95 transition-transform duration-700 group-hover:scale-110 group-hover:opacity-100"
          />

          <div
            aria-hidden="true"
            class="pointer-events-none absolute -bottom-10 left-0 h-20 w-full bg-gradient-to-t from-[#ff5a1e]/45 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
          />
        </div>
      ))
    }
  </div>
</section>
