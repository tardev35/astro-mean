---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright } = Astro.props;

// MONACO89: ไฟล์นี้ค้างทองบนม่วงพลัมของ TANGTEM168 มา (#ffe9a8 / #fcc30b / #e09a05
// / #ce5a03 คู่ม่วง #7e3ac7 / #3c0f52 บนผิว #3c0f52 / #2a0a2e / #1c0620 เนื้อความ
// #f7e6c4) รอบนี้ย้ายมาทองแอมเบอร์–คอปเปอร์คู่แดงรอยัลบนมะฮอกกานีดำ — #ffe9b8 /
// #ffd77a / #ef8f22 / #a44516 คู่แดง #d1201a / #7e120e บนผิว #26150a / #160d05 /
// #0b0602 เนื้อความ #f6e3c0 ไม่มีม่วงเหลืออยู่ในไฟล์นี้
//
// titleleft/titlecenter/titleright เป็น <p> ป้ายคอลัมน์ (คลาสเดิม บวก
// leading-normal): มันตั้งชื่อคอลัมน์ UI ไม่ใช่ section ของ docx ถ้าปล่อยเป็น
// หัวข้อ docx หัวข้อเดียวจะกลายเป็นสี่หัวข้อบนหน้าเว็บ และ docx ของ MONACO89 แบน
// H1+H2 ล้วน หน้าเว็บจึงต้องไม่มี h3 เลย
//
// pt-40/md:pt-32 ป้ายถูกตรึงไว้ที่ -top-6 ขอบล่างของมันจึงอยู่ต่ำจากขอบบนการ์ด
// เท่ากับ (ความสูงป้าย − 24px) chrome ของป้าย = py-3 (24px) + border-2 (4px) =
// 28px คำนวณกับหัวข้อ H2 ข้อ 4 ของ docx ยาว 67 ตัวอักษร ("โบนัสแตกบ่อย ฟีเจอร์
// เด่นของเกมดังที่เพิ่มอะไรให้แต่ละรอบน่าตามขึ้น?"):
//   จอ 360px — การ์ด 328px, ป้าย w-[92%] = 302px, หัก px-5 (40px) เหลือ ~262px,
//   text-lg + tracking-widest (0.1em) ≈ 10.8px ต่อตัวอักษร → ~24 ตัวต่อบรรทัด →
//   3 บรรทัด เผื่อแย่สุด 4 บรรทัด: leading-normal ที่ 18px = 27px ต่อบรรทัด →
//   108px + 28px = 136px ขอบล่างอยู่ที่ 112px เทียบกับ pt-40 (160px) → เหลือ 48px
//   md — ป้ายถูกจำกัดที่ max-w-2xl (672px) หัก px-10 (80px) เหลือ ~592px,
//   sm:text-2xl = 36px ต่อบรรทัด และ ~41 ตัวต่อบรรทัด → 2 บรรทัด = 72px + 28px =
//   100px ขอบล่าง 76px เทียบกับ md:pt-32 (128px) → เหลือ 52px
// ป้ายเป็น w-[92%] max-w-2xl text-center ไม่มี whitespace-nowrap ซึ่งเป็นบั๊กที่
// ตระกูลนี้เคย ship มา ห้ามใส่กลับ และให้ตื้นกว่า ContentBoxFloatingBadge.astro
// เสมอ เพราะไฟล์นั้นเสียความกว้างป้ายไปกับไอคอนตกแต่งสองตัว
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div class="relative w-full max-w-7xl rounded-2xl border-2 border-[#ef8f22]/35 bg-gradient-to-b from-[#26150a] to-[#0b0602] p-8 pt-40 shadow-[0_20px_50px_rgba(11,6,2,0.6)] md:pt-32">
    {
      title && (
        <div class="absolute -top-6 left-1/2 w-[92%] max-w-2xl -translate-x-1/2 rounded-lg border-2 border-[#ef8f22]/55 bg-gradient-to-b from-[#160d05] to-[#0b0602] px-5 py-3 text-center shadow-[0_10px_20px_rgba(11,6,2,0.5)] sm:px-10">
          <HeadingTag class="bg-gradient-to-r from-[#ffe9b8] via-[#ef8f22] to-[#a44516] bg-clip-text text-lg leading-normal font-black tracking-widest text-transparent uppercase sm:text-2xl">
            {title}
          </HeadingTag>
          <div aria-hidden="true" class="absolute bottom-1 left-1/2 h-[2px] w-1/2 -translate-x-1/2 bg-[#ef8f22]/80 shadow-[0_0_5px_rgba(239,143,34,1)]" />
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f6e3c0] md:border-r md:border-[#a44516]/40 md:pr-6">
        {titleleft && <p class="text-center text-xl leading-normal font-black text-[#ef8f22] uppercase drop-shadow-md">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f6e3c0] md:border-r md:border-[#a44516]/40 md:px-4">
        {titlecenter && <p class="text-center text-xl leading-normal font-black text-[#ef8f22] uppercase drop-shadow-md">{titlecenter}</p>}
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f6e3c0] md:pl-6">
        {titleright && <p class="text-center text-xl leading-normal font-black text-[#ef8f22] uppercase drop-shadow-md">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
