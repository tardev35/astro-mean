---
export interface Props {
  title?: string;
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
}
const { title, titleleft, titlecenter, titleright } = Astro.props;

// pt-36/md:pt-28, up from the flat pt-18 (72px) this file shipped with. The
// badge is anchored at -top-6, so its bottom edge sits at (badge height − 24px)
// measured from the card's top; pt-18 was sized for a short one-line title and
// a real docx H2 wraps to three or four lines on a phone.
//
// Arithmetic for BUFFXBET's docx H2 #3, 54 Thai characters
// ("รวมเกมฮิตจากค่ายดัง เลือกเล่นสนุกได้หลากหลายไม่มีเบื่อ"), badge chrome =
// py-3 (24px) + border-2 (4px) = 28px:
//   360px phone — card 328px, badge w-[92%] = 302px, minus px-5 (40px) leaves
//   ~262px. text-lg with tracking-widest (0.1em) costs ~10.8px per Thai
//   character, so ~24 characters fit a line → 3 lines. leading-normal at 18px =
//   27px per line: 3 lines = 81px + 28px = 109px, bottom edge at 85px — which
//   is why pt-18 (72px) overlapped. A pessimistic 4 lines = 108px + 28px =
//   136px, bottom edge 112px against pt-36 (144px) → 32px of daylight.
//   md — badge capped at max-w-2xl (672px), minus px-10 (80px) leaves ~592px.
//   sm:text-2xl = 36px per line and ~41 characters fit, so 2 lines = 72px +
//   28px = 100px, bottom edge 76px against md:pt-28 (112px) → 36px.
//
// The badge is w-[92%] max-w-2xl text-center with no whitespace-nowrap — the
// long-title bug this family shipped with. Do not put it back.
//
// titleleft/titlecenter/titleright render <h3>. BUFFXBET's docx is flat
// (H1 + H2, zero H3), so index.astro passes `title` only and splits the
// paragraph across the three slots. The <h3>s stay for a future brief that
// genuinely has sub-headings.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div class="relative w-full max-w-7xl rounded-2xl border-2 border-[#3b8df1]/40 bg-gradient-to-b from-[#0a2563] to-[#02061a] p-8 pt-36 shadow-[0_20px_50px_rgba(2,6,26,0.6)] md:pt-28">
    {
      title && (
        <div class="absolute -top-6 left-1/2 w-[92%] max-w-2xl -translate-x-1/2 rounded-lg border-2 border-[#3b8df1]/60 bg-gradient-to-b from-[#051a5b] to-[#02061a] px-5 py-3 text-center shadow-[0_10px_20px_rgba(2,6,26,0.5)] sm:px-10">
          <h2 class="bg-gradient-to-r from-[#fbe57d] via-[#f5c542] to-[#7cc0ff] bg-clip-text text-lg leading-normal font-black tracking-widest text-transparent uppercase sm:text-2xl">{title}</h2>
          <div aria-hidden="true" class="absolute bottom-1 left-1/2 h-[2px] w-1/2 -translate-x-1/2 bg-[#3b8df1]/80 shadow-[0_0_5px_rgba(59,141,241,1)]" />
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#dbe7fb]/85 md:border-r md:border-[#3b8df1]/20 md:pr-6">
        {titleleft && <h3 class="text-center text-xl leading-normal font-black text-[#f5c542] uppercase drop-shadow-md">{titleleft}</h3>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#dbe7fb]/85 md:border-r md:border-[#3b8df1]/20 md:px-4">
        {titlecenter && <h3 class="text-center text-xl leading-normal font-black text-[#f5c542] uppercase drop-shadow-md">{titlecenter}</h3>}
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#dbe7fb]/85 md:pl-6">
        {titleright && <h3 class="text-center text-xl leading-normal font-black text-[#f5c542] uppercase drop-shadow-md">{titleright}</h3>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
