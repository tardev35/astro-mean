---
// ข้อความ default ต้องเป็นของแบรนด์ปัจจุบันเสมอ — หน้าย่อยเรียก <Announcement />
// เปล่าๆ กันหมด ถ้าปล่อยเป็นของแบรนด์ก่อนไว้ ทุกหน้ายกเว้นหน้าแรกจะโฆษณาแบรนด์เก่า
//
// ห้ามขึ้นต้นด้วยอิโมจิ: ข้อความถูก render ซ้ำสองรอบสำหรับ marquee และอิโมจิที่ฝัง
// อยู่ใน prop ทำ aria-hidden ไม่ได้ — screen reader จะอ่านซ้ำทุกรอบ ตัว 📢 ที่เห็น
// อยู่ในวงกลมด้านซ้ายเป็น element แยกที่ปิด aria ไว้แล้ว
const {
  message = "LONGSAP168 เว็บสล็อตครบมือ เกมดังค่ายจัดเต็ม โต๊ะสดจัดหนัก จบได้ในเว็บเดียว • รวมค่ายดังระดับโลกไว้เพียบ อัปเดตเกมใหม่ไวมาก ภาพสวย สปินลื่น แตกบ่อย • โต๊ะสดภาพคมชัดระดับ HD สตรีมเรียลไทม์ไม่มีกระตุก มีห้องให้เลือกเข้าเพียบ • ฝากถอนออโต้ไม่ต้องแคปสลิปส่งแอดมิน กดถอนปั๊บเงินเด้งเข้าบัญชีแทบจะทันที • รองรับทุกอุปกรณ์ สลับจากมือถือไปคอมก็ยังลื่นไม่เสียฟีล • ความปลอดภัยระดับมาตรฐานสากล ดูแลข้อมูลสมาชิกอย่างเป็นระบบทุกขั้นตอน",
} = Astro.props;
---

<div class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#f2b024]/35 bg-gradient-to-r from-[#7d0508]/60 to-[#0a0402] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(216,31,38,0.18)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#f2b024] bg-[#0a0402] shadow-[0_0_15px_rgba(242,176,36,0.55)]">
      <span aria-hidden="true" class="animate-pulse text-xl">📢</span>
    </div>

    <div class="mr-4 h-full w-[1px] bg-[#f2b024]/30"></div>

    <div class="flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="flex w-max animate-[scroll_25s_linear_infinite] gap-12 text-sm font-bold whitespace-nowrap text-[#ffd76a]">
        <span class="drop-shadow-[0_0_5px_rgba(216,31,38,0.5)]">{message}</span>
        <span class="drop-shadow-[0_0_5px_rgba(216,31,38,0.5)]">{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-\[scroll_25s_linear_infinite\] {
      animation: none;
    }
  }
</style>
