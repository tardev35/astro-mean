---
// ข้อความ default ต้องเป็นของแบรนด์ปัจจุบันเสมอ — หน้าย่อยเรียก <Announcement />
// เปล่าๆ กันหมด ถ้าปล่อยเป็นของแบรนด์ก่อนไว้ ทุกหน้ายกเว้นหน้าแรกจะโฆษณาแบรนด์เก่า
//
// ห้ามขึ้นต้นด้วยอิโมจิ: ข้อความถูก render ซ้ำสองรอบสำหรับ marquee และอิโมจิที่ฝัง
// อยู่ใน prop ทำ aria-hidden ไม่ได้ — screen reader จะอ่านซ้ำทุกรอบ ตัว 📢 ที่เห็น
// อยู่ในวงกลมด้านซ้ายเป็น element แยกที่ปิด aria ไว้แล้ว
const {
  message = "THUNDER87 สล็อตฟอร์มฟาด เกมครบแบบไม่หวง ระบบแรงออโต้ไว • ขนเกมค่ายดังระดับโลกมาลงแน่นในที่เดียว คัดมาแล้วทั้งงานภาพคมชัดและอัตราการจ่ายสมน้ำสมเนื้อ • รวมสล็อต คาสิโนสด และบาคาร่าไว้เต็มล็อบบี้ สลับอารมณ์เล่นได้ในยูสเซอร์เดียว • เข้าเกมคล่อง สลับค่ายไว ระบบประมวลผลแรงและเสถียร ไม่มีกระตุกไม่หลุดกลางโบนัส • จังหวะการเล่นสุดตึงพร้อมทุกช่วงเวลา เช้า สาย บ่าย ดึก มาตรฐานการจ่ายเที่ยงตรงเสมอ • ฝากถอนออโต้แม่นยำ ทำรายการไวไม่ผ่านคนกลาง ทุกบาททุกสตางค์ตรงไปตรงมา • ปักหลักเล่นเกมโปรดที่เดียวจบ ครบทั้งความสนุกและความคุ้มค่า",
} = Astro.props;
---

<div class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#fae61c]/35 bg-gradient-to-r from-[#2b2606]/60 to-[#080703] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(250,230,28,0.18)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#fae61c] bg-[#080703] shadow-[0_0_15px_rgba(250,230,28,0.55)]">
      <span aria-hidden="true" class="animate-pulse text-xl">📢</span>
    </div>

    <div class="mr-4 h-full w-[1px] bg-[#fae61c]/30"></div>

    <div class="flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="flex w-max animate-[scroll_25s_linear_infinite] gap-12 text-sm font-bold whitespace-nowrap text-[#fff89a]">
        <span class="drop-shadow-[0_0_5px_rgba(250,230,28,0.5)]">{message}</span>
        <span class="drop-shadow-[0_0_5px_rgba(250,230,28,0.5)]">{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-\[scroll_25s_linear_infinite\] {
      animation: none;
    }
  }
</style>
