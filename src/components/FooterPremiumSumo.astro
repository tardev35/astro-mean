---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// GUESS168: ย้ายจากส้มไฟคู่ทองของแบรนด์ก่อน (ดูค่าเดิมได้จาก git history —
// ห้ามพิมพ์ hex ของแบรนด์ก่อนทิ้งไว้ในคอมเมนต์ Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์) มาเป็นทองหลอมคู่ส้มไฟของแบรนด์นี้ — ทอง #fecc02 /
// #ffe680 / #ffd54a / #c58a00 คู่ส้ม #fe9c01 / #a35800 บนผิว #140800 /
// #231005 / #33180a เนื้อความ #f7e7c6 รอง #d8bb87 ส่วนครีมสว่าง #fff6e0
// ใช้เป็นสีกลางคู่กับทอง เพราะโลโก้จริงเป็นตัวอักษรทองตัดขอบเข้ม
//
// เขียว LINE (#00B900 / #009900) บนปุ่มติดต่อแอดมินไม่ใช่สีแบรนด์ — คงไว้
//
// GUESS168 เป็นเว็บสล็อต ไม่ใช่เว็บหวย จึงไม่มีลิงก์ /ตรวจหวย และ /แนวทาง ใน shortcuts
//
// บล็อก <address> มาจาก BRAND_ADDRESS — ไม่ทาสีแบรนด์โดยตั้งใจ (border-white/15,
// bg-black/20 + opacity ลงตัวกับทุก footer variant ซึ่งพื้นเข้มหมด) ห้าม retype
// ข้อความข้างในเอง และห้ามใส่ hex ลงไป
const shortcuts = [
  { name: "หน้าหลัก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#fecc02]/60 bg-[#140800] pt-16 pb-8 font-sans text-[#f7e7c6] shadow-[0_-15px_40px_rgba(254,204,2,0.25)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#fecc02]/20 blur-[100px]"></div>
  <div class="pointer-events-none absolute inset-x-0 -bottom-24 mx-auto h-[220px] w-full max-w-2xl rounded-full bg-[#a35800]/30 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#fecc02]/30 bg-[#231005] px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ GUESS168 เป็นตัวอักษรกราฟฟิตี้ลายมือเขียนว่า Guess168 สีทองไล่เฉดจากเหลืองสว่างไปส้ม ตัดขอบด้วยเส้นสีม่วงดำและเส้นขาว"
                widths={[140, 280, 420]}
                sizes="140px"
                loading="lazy"
                decoding="async"
                class="h-[50px] w-auto object-contain"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#fff6e0]">
                GUESS<span class="text-[#fecc02]">168</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#fecc02]/50 pl-4 text-sm leading-relaxed text-[#d8bb87]">
          GUESS168 สล็อตคัดเกรดที่เลือกเฉพาะเกมลิขสิทธิ์แท้จากค่ายใหญ่มาตรฐานสากล เชื่อมตรงจากเซิร์ฟเวอร์หลักด้วย API แท้ ไม่มีการดัดแปลงเปอร์เซ็นต์ชนะ ค่ายไหนปล่อยเกมใหม่อัปเดตเข้าคลังภายใน 24 ชั่วโมง
          พร้อมโหมดทดลองเล่นฟรีให้เช็กจังหวะโบนัสก่อนลงเงินจริง และระบบฝากถอนออโต้ที่ทำรายการจบในไม่กี่วินาที
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#fecc02]/40 bg-[#231005] px-4 py-1 text-xs font-medium text-[#ffe680] backdrop-blur-sm">คืนยอดเสีย Cash Back ทุกวัน</span>
          <span class="rounded-full border border-[#fff6e0]/40 bg-[#231005] px-4 py-1 text-xs font-medium text-[#fff6e0] backdrop-blur-sm">ฝากถอนออโต้ จบใน 3 วินาที</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#ffe680] uppercase drop-shadow-sm">ทางลัด</p>
        <div class="h-[1px] w-12 bg-[#fecc02]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#d8bb87]">
          {
            shortcuts.map((item) => (
              <li>
                <a href={item.path} class="transition-colors hover:text-[#fecc02]">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#ffe680] uppercase drop-shadow-sm">บริการลูกค้า 24 ชม.</p>
        <div class="h-[1px] w-12 bg-[#fecc02]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a
                  href={`mailto:${BRAND_ADDRESS.email}`}
                  class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#d8bb87] uppercase">Supported Payments</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#33180a] pt-8 text-xs font-medium tracking-wide text-[#d8bb87] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} GUESS168-GAME.COM. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#fecc02]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fecc02]">นโยบายความเป็นส่วนตัว</a>
        <a href="#top" class="transition-colors hover:text-[#fecc02]">กลับขึ้นบน</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
