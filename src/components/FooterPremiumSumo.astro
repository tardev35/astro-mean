---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// DEED888: ย้ายจากแดงสดคู่ทองของแบรนด์ก่อน (ดูค่าเดิมได้จาก git history —
// ห้ามพิมพ์ hex ของแบรนด์ก่อนทิ้งไว้ในคอมเมนต์ Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์) มาเป็นส้มเพลิงคู่ทองของแบรนด์นี้ — ส้ม #e95b0b / #ff9d4d /
// #93300a / #5c1c03 คู่ทอง #ffcf6b / #ffe3ad บนผิว #150401 / #2a0a02 / #33100a
// เนื้อความ #fbe3d0 รอง #d8b79a ส่วนครีมทอง #ffe3ad ใช้เป็นสีกลางคู่กับส้ม
// เพราะโลโก้จริงเป็นตัวอักษรทองหลอมขอบเปลวไฟ
//
// เขียว LINE (#00B900 / #009900) บนปุ่มติดต่อแอดมินไม่ใช่สีแบรนด์ — คงไว้
//
// DEED888 เป็นเว็บสล็อต/คาสิโน ไม่ใช่เว็บหวย จึงไม่มีลิงก์ /ตรวจหวย และ /แนวทาง ใน shortcuts
//
// หัวคอลัมน์เป็น <p> ไม่ใช่ <h2>/<h3> เพราะ footer เป็น chrome ไม่ใช่เนื้อบทความ
// ถ้าเป็นหัวข้อจริงจะกลายเป็นหัวข้อของ "ทุกหน้า" ทั้งเว็บ — ชื่อของภูมิภาคจึงย้าย
// ไปอยู่ที่ aria-label ของ container แทน ผลที่ตาเห็นเหมือนเดิมเป๊ะ
//
// บล็อก <address> มาจาก BRAND_ADDRESS — ไม่ทาสีแบรนด์โดยตั้งใจ (border-white/15,
// bg-black/20 + opacity ลงตัวกับทุก footer variant ซึ่งพื้นเข้มหมด) ห้าม retype
// ข้อความข้างในเอง และห้ามใส่ hex ลงไป
const shortcuts = [
  { name: "หน้าหลัก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#e95b0b]/60 bg-[#150401] pt-16 pb-8 font-sans text-[#fbe3d0] shadow-[0_-15px_40px_rgba(233,91,11,0.25)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#e95b0b]/20 blur-[100px]"></div>
  <div class="pointer-events-none absolute inset-x-0 -bottom-24 mx-auto h-[220px] w-full max-w-2xl rounded-full bg-[#5c1c03]/30 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#e95b0b]/30 bg-[#2a0a02] px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ DEED888 เป็นรูปม้าเพลิงสีแดงส้มยืนผงาดสองขาหน้า มีเปลวไฟลุกเป็นแผงคอและหาง อยู่ด้านซ้ายของคำว่า DEED888 ตัวอักษรทองหลอมขอบเปลวไฟ และมีคำว่า .COM ตัวเล็กอยู่มุมบนขวา"
                widths={[140, 280, 420]}
                sizes="140px"
                loading="lazy"
                decoding="async"
                class="h-[50px] w-auto object-contain"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#ffe3ad]">
                DEED<span class="text-[#e95b0b]">888</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#e95b0b]/50 pl-4 text-sm leading-relaxed text-[#d8b79a]">
          DEED888 สล็อตเกมแท้ตัวท็อป เชื่อมต่อสัญญาณ API ตรงจากสตูดิโอผู้พัฒนาสล็อตระดับโลก ไม่ผ่านเอเย่นต์ ค่า RTP จึงเป็นมาตรฐานยุติธรรมตามสเปกโรงงาน ไม่มีการปรับแต่งเปอร์เซ็นต์แพ้ชนะ
          คลังเกมกวาดเฉพาะตัวระดับ A-List จากค่ายยักษ์ใหญ่ และระบบทำรายการออโต้ประมวลผลไวในไม่กี่วินาที ถอนได้จริง ไม่ติดล็อคยูส
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#e95b0b]/40 bg-[#2a0a02] px-4 py-1 text-xs font-medium text-[#ffcf6b] backdrop-blur-sm">คืนยอดเสีย Cash Back รายวัน ไม่ติดล็อคยูส</span>
          <span class="rounded-full border border-[#ffe3ad]/40 bg-[#2a0a02] px-4 py-1 text-xs font-medium text-[#ffe3ad] backdrop-blur-sm">ฝากถอนออโต้ เสร็จในไม่กี่วินาที</span>
        </div>
      </div>

      <nav aria-label="ทางลัด" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#ffcf6b] uppercase drop-shadow-sm">ทางลัด</p>
        <div class="h-[1px] w-12 bg-[#e95b0b]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#d8b79a]">
          {
            shortcuts.map((item) => (
              <li>
                <a href={item.path} class="transition-colors hover:text-[#ffcf6b]">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div aria-label="บริการลูกค้า 24 ชม." class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#ffcf6b] uppercase drop-shadow-sm">บริการลูกค้า 24 ชม.</p>
        <div class="h-[1px] w-12 bg-[#e95b0b]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a
                  href={`mailto:${BRAND_ADDRESS.email}`}
                  class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#d8b79a] uppercase">Supported Payments</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#33100a] pt-8 text-xs font-medium tracking-wide text-[#d8b79a] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} DEED888PLUS.COM. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ffcf6b]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffcf6b]">นโยบายความเป็นส่วนตัว</a>
        <a href="#top" class="transition-colors hover:text-[#ffcf6b]">กลับขึ้นบน</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
