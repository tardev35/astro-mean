---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// XTOP666: ย้ายจากทองคู่เงินโครเมียมของแบรนด์ก่อน (ดูค่าเดิมได้จาก git history —
// ห้ามพิมพ์ hex ของแบรนด์ก่อนทิ้งไว้ในคอมเมนต์ Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์) มาเป็นส้มไฟคู่ทองของแบรนด์นี้ — ส้ม #fc5b02 / #ff8c3a /
// #ffd9bd / #7a2601 คู่ทอง #ffb020 / #ffd76e บนผิว #0a0503 / #1c0d05 / #2a1206
// เนื้อความ #ffe8d8 รอง #c9a68f ส่วนเงินโครเมียมของโลโก้ (#e6ecf2 / #fff3ea)
// เก็บไว้เป็นสีกลางคู่กับส้ม เพราะโลโก้จริงเป็นตัวอักษรเงินคู่ตัว X ส้ม
//
// เขียว LINE (#00B900 / #009900) บนปุ่มติดต่อแอดมินไม่ใช่สีแบรนด์ — คงไว้
//
// XTOP666 เป็นเว็บสล็อต ไม่ใช่เว็บหวย จึงไม่มีลิงก์ /ตรวจหวย และ /แนวทาง ใน shortcuts
//
// บล็อก <address> มาจาก BRAND_ADDRESS — ไม่ทาสีแบรนด์โดยตั้งใจ (border-white/15,
// bg-black/20 + opacity ลงตัวกับทุก footer variant ซึ่งพื้นเข้มหมด) ห้าม retype
// ข้อความข้างในเอง และห้ามใส่ hex ลงไป
const shortcuts = [
  { name: "หน้าหลัก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#fc5b02]/60 bg-[#0a0503] pt-16 pb-8 font-sans text-[#ffe8d8] shadow-[0_-15px_40px_rgba(252,91,2,0.25)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#fc5b02]/20 blur-[100px]"></div>
  <div class="pointer-events-none absolute inset-x-0 -bottom-24 mx-auto h-[220px] w-full max-w-2xl rounded-full bg-[#7a2601]/30 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#fc5b02]/30 bg-[#1c0d05] px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ XTOP666 ตัวอักษร T กับ P สีเงินโครเมียม มีตัว X สีส้มหลอมเหลวพาดทับตรงกลาง ใต้ลงมาเป็นคำว่า XTOP โดยตัว X เป็นสีส้ม"
                widths={[140, 280, 420]}
                sizes="140px"
                loading="lazy"
                decoding="async"
                class="h-[50px] w-auto object-contain"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#e6ecf2]">
                XTOP<span class="text-[#fc5b02]">666</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#fc5b02]/50 pl-4 text-sm leading-relaxed text-[#c9a68f]">
          XTOP666 สล็อตสปีดท็อปที่ตัดทุกความล่าช้าออกจากการปั่น ตั้งแต่การโหลดเกมที่รวดเร็วฉับไว ลิงก์ตรงทางเข้าที่พาเข้าล็อบบี้เกมค่ายดังได้ในคลิกเดียว ระบบหลังบ้านเสถียรพร้อมบวกทุกสถานการณ์
          และโบนัสที่กดรับเองได้ทันทีก่อนขึ้นสปิน ใช้งานต่อเนื่องได้ลื่นไหลเท่ากันทั้งมือถือและคอม
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#fc5b02]/40 bg-[#1c0d05] px-4 py-1 text-xs font-medium text-[#ffd9bd] backdrop-blur-sm">คืนยอดเสีย 5% รับได้ทุกวัน</span>
          <span class="rounded-full border border-[#e6ecf2]/40 bg-[#1c0d05] px-4 py-1 text-xs font-medium text-[#fff3ea] backdrop-blur-sm">แนะนำเพื่อน รับค่าคอม 1%</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#ffd9bd] uppercase drop-shadow-sm">ทางลัด</p>
        <div class="h-[1px] w-12 bg-[#fc5b02]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#c9a68f]">
          {
            shortcuts.map((item) => (
              <li>
                <a href={item.path} class="transition-colors hover:text-[#fc5b02]">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#ffd9bd] uppercase drop-shadow-sm">บริการลูกค้า 24 ชม.</p>
        <div class="h-[1px] w-12 bg-[#fc5b02]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a
                  href={`mailto:${BRAND_ADDRESS.email}`}
                  class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#c9a68f] uppercase">Supported Payments</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#2a1206] pt-8 text-xs font-medium tracking-wide text-[#c9a68f] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} XTOP666TH.COM. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#fc5b02]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fc5b02]">นโยบายความเป็นส่วนตัว</a>
        <a href="#top" class="transition-colors hover:text-[#fc5b02]">กลับขึ้นบน</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
