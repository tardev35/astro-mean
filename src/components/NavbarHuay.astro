---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// เมนูชุดเดียวถูกใช้ทั้งแถบ desktop และลิ้นชัก mobile — ห้ามแตกเป็นสองอาร์เรย์
// ลำดับ: หน้าแรก → โปรโมชั่น → หน้าหวย → หน้าอ่าน (สมัคร/เข้าสู่ระบบของ variant นี้
// เป็นปุ่ม CTA มุมขวา ไม่ใช่รายการเมนู จึงไม่อยู่ในอาร์เรย์นี้)
// ไอคอนเป็น <span aria-hidden> ที่เป็นพี่น้องกับ label ไม่ใช่อยู่ในสตริงข้อความ
const menu = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ตรวจหวย", path: "/ตรวจหวย", icon: "🔍" },
  { name: "แนวทาง", path: "/แนวทาง", icon: "🧭" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎮" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🚪" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav
    class="relative mx-auto flex h-[85px] w-full items-center justify-between border-b border-[#1e63d8]/45 bg-[#04091a]/95 px-4 shadow-[0_5px_20px_rgba(4,9,26,0.6)] backdrop-blur-xl xl:px-8">
    <a
      href="/"
      class="z-[110] flex-shrink-0 rounded-xl border border-[#5c9bf0]/30 bg-[#1e63d8]/10 px-4 py-2 backdrop-blur-sm transition-transform duration-300 hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt="โลโก้ LOTTOTAX ตัวอักษร LOTTO สีน้ำเงินไล่เฉดและ TAX สีแดงไล่เฉด ขอบขาว"
            loading="eager"
            widths={[130, 260, 390]}
            sizes="130px"
            class="h-[45px] w-auto drop-shadow-md xl:h-[55px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <p class="text-2xl font-black tracking-widest text-white italic drop-shadow-md">
            <span class="rounded-md bg-gradient-to-r from-[#5c9bf0] to-[#1e63d8] px-2 text-[#04091a]">LOTTO</span>
            <span class="text-[#e63c28]">TAX</span>
          </p>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-3 xl:flex xl:gap-5">
      {
        menu.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1.5 px-1.5 text-xs font-bold tracking-wider uppercase transition-colors xl:text-sm ${isActive(item.path) ? "text-[#5c9bf0]" : "text-[#dbeafe]/80 hover:text-white"}`}>
            <span aria-hidden="true" class="text-base leading-none">
              {item.icon}
            </span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[4px] w-full rounded-t-full bg-gradient-to-r from-[#5c9bf0] to-[#1e63d8] shadow-[0_-2px_10px_rgba(30,99,216,0.8)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden rounded-full border-2 border-[#5c9bf0]/35 bg-[#0b1b3a]/60 px-6 py-2.5 text-sm font-bold text-white backdrop-blur-md transition-all hover:border-[#5c9bf0]/70 hover:bg-[#1e63d8]/15 xl:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden rounded-full bg-gradient-to-r from-[#e63c28] via-[#e63c28] to-[#a81c04] px-6 py-2.5 text-sm font-black text-white shadow-[0_4px_15px_rgba(230,60,40,0.45)] transition-all hover:-translate-y-0.5 hover:shadow-[0_8px_20px_rgba(230,60,40,0.65)] xl:flex">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] rounded-full border border-[#1e63d8]/40 bg-[#0b1b3a]/70 xl:hidden"
        aria-label="เปิดเมนู">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#dbeafe] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#dbeafe] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#dbeafe] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[85px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col rounded-b-3xl border-b border-[#1e63d8]/50 bg-[#04091a]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-300 xl:hidden">
    <div class="flex flex-col gap-2">
      {
        menu.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 rounded-xl px-4 py-3.5 text-lg font-bold tracking-widest uppercase transition-colors ${isActive(item.path) ? "border-l-4 border-[#5c9bf0] bg-[#1e63d8]/15 text-[#5c9bf0]" : "text-[#dbeafe]/80 hover:bg-[#1e63d8]/10 hover:text-white"}`}>
            <span aria-hidden="true" class="text-xl leading-none">
              {item.icon}
            </span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center rounded-full bg-gradient-to-r from-[#e63c28] via-[#e63c28] to-[#a81c04] py-3.5 text-lg font-black text-white shadow-[0_5px_15px_rgba(230,60,40,0.45)]">
        สมัครสมาชิก
      </a>
      <a
        href="/login"
        class="flex w-full justify-center rounded-full border-2 border-[#5c9bf0]/35 bg-[#0b1b3a]/60 py-3.5 text-lg font-bold text-white">
        เข้าสู่ระบบ
      </a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
