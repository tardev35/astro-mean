---
// ROOM89: ย้ายจากทองคำคู่แดงเลือดหมูของแบรนด์ก่อน มาเป็นทองคำขัดเงาคู่เงิน
// แพลตินัมบนดำอมน้ำตาล — ทอง #f7edc4 / #e6cf72 / #c9a227 / #6b5424 บนผิว
// #0b0805 / #161009 / #1a1208 ขอบ #4a3a18 คู่เงิน #e8ebef / #b9c2cc สำหรับปุ่มรอง
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// แถบนี้เป็น chrome ล้วน ไม่มีหัวข้อ และ emoji อยู่ใน <span aria-hidden> ที่เป็น
// พี่น้องของ label ไม่ใช่แทรกอยู่ในข้อความ
---

<div
  class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#4a3a18]/85 bg-[#0b0805]/95 font-sans shadow-[0_-5px_25px_rgba(201,162,39,0.28)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href="/register"
      style="background-image: linear-gradient(in oklab to bottom, #e6cf72, #6b5424);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#0b0805] shadow-[0_0_12px_rgba(201,162,39,0.55)] transition-transform active:scale-95">
      <span aria-hidden="true">👑</span> สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#b9c2cc]/60 bg-[#1a1208] py-3.5 text-base font-bold text-[#e8ebef] shadow-[0_2px_8px_rgba(59,44,16,0.5)] transition-transform hover:bg-[#2a2f36] active:scale-95">
      <span aria-hidden="true">🔒</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<div class="h-[75px] lg:hidden"></div>
