---
// VIPSAND356: ย้ายจากทองคำอียิปต์คู่เงินขาวบนดำอมน้ำตาลของแบรนด์ก่อน มาเป็นฟ้า
// อะซูร์คู่ทองส้มบนกรมท่าเข้ม ตามโลโก้ที่คำว่า VIP เป็นฟ้าและ SANDS เป็นส้มทอง —
// ฟ้า #2a93e0 / #5dbcfe / #a2d2ef คู่ทอง #eba554 / #fcde61 / #c07c20 บนผิว
// #061c33 / #103a5f ขอบ #2a93e0 เนื้อความ #e6f2ff
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// แถบนี้เป็น chrome ล้วน ไม่มีหัวข้อ และ emoji อยู่ใน <span aria-hidden> ที่เป็น
// พี่น้องของ label ไม่ใช่แทรกอยู่ในข้อความ
---

<div
  class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#2a93e0]/85 bg-[#061c33]/95 font-sans shadow-[0_-5px_25px_rgba(42,147,224,0.3)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href="/register"
      style="background-image: linear-gradient(in oklab to bottom, #fcde61, #c07c20);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#061c33] shadow-[0_0_12px_rgba(235,165,84,0.55)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#5dbcfe]/60 bg-[#103a5f] py-3.5 text-base font-bold text-[#e6f2ff] shadow-[0_2px_8px_rgba(11,63,112,0.55)] transition-transform hover:bg-[#1465a8] active:scale-95">
      <span aria-hidden="true">🔒</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<div class="h-[75px] lg:hidden"></div>
