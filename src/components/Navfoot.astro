---
// CK1968: ย้ายจากทองแอนทีคอมน้ำผึ้งคู่กราไฟต์ของแบรนด์ก่อน มาเป็นทองคำคู่แดง
// เลือดหมูบนดำอมน้ำตาล — ทอง #ffefc4 / #ffd45c / #f0a80c / #a76806 บนผิว
// #090302 / #170806 / #2a100a ขอบ #4d1f0d คู่แดง #ff4b52 / #d4090f สำหรับปุ่มรอง
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// แถบนี้เป็น chrome ล้วน ไม่มีหัวข้อ และ emoji อยู่ใน <span aria-hidden> ที่เป็น
// พี่น้องของ label ไม่ใช่แทรกอยู่ในข้อความ
---

<div
  class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#4d1f0d]/85 bg-[#090302]/95 font-sans shadow-[0_-5px_25px_rgba(240,168,12,0.28)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href="/register"
      style="background-image: linear-gradient(in oklab to bottom, #ffd45c, #a76806);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#090302] shadow-[0_0_12px_rgba(240,168,12,0.55)] transition-transform active:scale-95">
      <span aria-hidden="true">👑</span> สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#d4090f]/60 bg-[#2a100a] py-3.5 text-base font-bold text-[#ff4b52] shadow-[0_2px_8px_rgba(93,58,5,0.5)] transition-transform hover:bg-[#3d0203] active:scale-95">
      <span aria-hidden="true">🔒</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<div class="h-[75px] lg:hidden"></div>
