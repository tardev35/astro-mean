---
// SETH88: ย้ายจากทองคำคู่น้ำเงินรอยัลของแบรนด์ก่อน มาเป็นทองคำอียิปต์คู่เงินขาว —
// ทอง #fdf3d4 / #f7d774 / #e0a92b / #a9711a คู่เงิน #d8dade บนผิว #0c0703 /
// #1b1109 ขอบ #a9711a
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// แถบนี้เป็น chrome ล้วน ไม่มีหัวข้อ และ emoji อยู่ใน <span aria-hidden> ที่เป็น
// พี่น้องของ label ไม่ใช่แทรกอยู่ในข้อความ
---

<div
  class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#a9711a]/85 bg-[#0c0703]/95 font-sans shadow-[0_-5px_25px_rgba(224,169,43,0.3)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href="/register"
      style="background-image: linear-gradient(in oklab to bottom, #f7d774, #a9711a);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#0c0703] shadow-[0_0_12px_rgba(224,169,43,0.55)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#d8dade]/60 bg-[#1b1109] py-3.5 text-base font-bold text-[#f0e3cd] shadow-[0_2px_8px_rgba(107,66,16,0.55)] transition-transform hover:bg-[#2a1a0d] active:scale-95">
      <span aria-hidden="true">🔒</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<div class="h-[75px] lg:hidden"></div>
