---
// JAICHUA: ย้ายจากน้ำเงินธงชาติคู่แดงของแบรนด์ก่อน มาเป็นทองคำคู่น้ำเงินรอยัล —
// ทอง #fbeec9 / #f6d67e / #d8a83f / #a97722 คู่น้ำเงิน #2f5fb0 / #16336b บนผิว
// #040915 / #0e1a33 ขอบ #a97722
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// แถบนี้เป็น chrome ล้วน ไม่มีหัวข้อ และ emoji อยู่ใน <span aria-hidden> ที่เป็น
// พี่น้องของ label ไม่ใช่แทรกอยู่ในข้อความ
---

<div
  class="fixed right-0 bottom-0 left-0 z-[100] border-t border-[#a97722]/85 bg-[#040915]/95 font-sans shadow-[0_-5px_25px_rgba(216,168,63,0.3)] backdrop-blur-md lg:hidden">
  <div class="flex w-full gap-1.5 p-1.5">
    <a
      href="/register"
      style="background-image: linear-gradient(in oklab to bottom, #f6d67e, #a97722);"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg py-3.5 text-base font-black text-[#040915] shadow-[0_0_12px_rgba(216,168,63,0.55)] transition-transform active:scale-95">
      <span aria-hidden="true">📝</span> สมัครสมาชิก
    </a>

    <a
      href="/login"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-[#5b8ede]/60 bg-[#0e1a33] py-3.5 text-base font-bold text-[#cfe0fb] shadow-[0_2px_8px_rgba(22,51,107,0.55)] transition-transform hover:bg-[#132244] active:scale-95">
      <span aria-hidden="true">🔒</span> เข้าสู่ระบบ
    </a>
  </div>
</div>
<div class="h-[75px] lg:hidden"></div>
