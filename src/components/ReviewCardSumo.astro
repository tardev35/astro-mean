---
// Widget ไม่ใช่ article: บรรทัดหัวของบล็อกเป็น <p> และชื่อผู้รีวิวเป็น <p> เช่นกัน
// <section> เป็นตัวถือชื่อสำหรับ assistive tech ผ่าน aria-label — ไฟล์นี้เคยปล่อย
// <h2> หนึ่งตัวกับ <h4> อีกสามตัวออกมา ซึ่งไม่มีต้นทางใน docx เลยสักตัว และทำให้
// inventory หัวข้อบนหน้าแรกที่ถูก diff กับ checklist ของ brief ทุกรอบเพี้ยน
//
// ดาวเป็นของตกแต่งล้วน จึงอยู่ในกล่อง aria-hidden แล้วใส่ข้อความ sr-only บอกคะแนน
// จริงกลับเข้าไป ไม่งั้น screen reader จะอ่าน "ดาว" ห้าครั้งต่อการ์ดโดยไม่ได้ตัวเลข
// อิโมจิของอวาตาร์ก็เป็นของตกแต่ง อยู่ใน <span aria-hidden="true"> ของตัวเอง
//
// SETH88: ไฟล์นี้เป็น inventory ที่ค้างชุดสีและชื่อแบรนด์ก่อนหน้ามา รอบนี้ถูกเขียนใหม่
// ทั้งไฟล์มาที่ทองคำอียิปต์คู่บรอนซ์บนดำอมน้ำตาลของหินวิหาร — ทอง #fdf3d4 / #f7d774 /
// #e0a92b / #a9711a คู่บรอนซ์ #6b4210 / #3a2716 บนผิว #0c0703 / #1b1109 / #2a1a0d
// ขอบ #6b4210 เนื้อความ #f0e3cd ข้อความรอง #d6c2a0
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history)
//
// เนื้อรีวิวอ้างข้อเท็จจริงชุดเดียวกับ docx ของแบรนด์นี้: เว็บตรง API แท้ยิงตรงจาก
// เซิร์ฟเวอร์หลักโดยไม่ผ่านเอเย่นต์ ไม่ล็อกยูส, ค่า RTP มาตรฐานสากลจากค่ายแม่ ไม่ปรับ
// ลดอัตราแตก, เกมคัดเกรด A-List ที่ตัดเกมล้าหลังออก, ค่าย PG Soft / Pragmatic Play /
// Joker Gaming, ฟีเจอร์ Multiplier / Expanding Wild / ซื้อฟรีสปิน, โปรฝากแรกของวันกับ
// Cash Back ทุกวัน, ฝากถอนออโต้ 3 วินาที และ SSL กับการตรวจสอบประวัติแบบเรียลไทม์
const reviews = [
  {
    name: "ทีม web develop หมีขาว",
    role: "ผู้เชี่ยวชาญด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ไล่ดูโครงสร้างหลังบ้านแล้วบอกได้ว่าเป็นเว็บตรง API แท้จริง ยิงตรงจากเซิร์ฟเวอร์หลักโดยไม่ผ่านเอเย่นต์คั่นกลาง และไม่เจอร่องรอยการล็อกยูสเลย ฝั่งความปลอดภัยเข้ารหัสด้วย SSL พร้อมระบบตรวจสอบประวัติการทำรายการแบบเรียลไทม์ หัก 1 ดาวเพราะอยากได้โหมดสว่างเพิ่ม",
    avatar: "🐻‍❄️",
  },
  {
    name: "ชุมนุม เว็บสล็อตออนไลน์",
    role: "คอมมูนิตี้รีวิวเว็บตรง",
    stars: 4,
    content:
      "ทางเพจเทสยาวหนึ่งเดือน คอนเฟิร์มว่าค่า RTP เป็นมาตรฐานสากลจากค่ายแม่ ไม่มีปรับลดอัตราแตก ล็อบบี้คัดเกมเกรดคุณภาพระดับ A-List มาให้จริง ตัดเกมล้าหลังออกจนไม่ต้องเสียเวลาวนหา ค่ายมาครบทั้ง PG Soft, Pragmatic Play และ Joker Gaming ฟีเจอร์ Multiplier กับ Expanding Wild มาเต็ม",
    avatar: "🎰",
  },
  {
    name: "อาสาสมัครนักเล่นสล็อต",
    role: "ผู้เล่นระดับ VIP",
    stars: 5,
    content:
      "ลองมาหลายเว็บสุดท้ายจบที่ SETH88 ครับ สลับจากสายตัวคูณสะสมไปสายซื้อฟรีสปินพุ่งชนโบนัส หรือแนวไวลด์ขยายเต็มรีลได้จากกระเป๋าเดียว ไม่ต้องเสียเวลาโยกเงิน โปรกดรับเองผ่านแดชบอร์ดทั้งฝากแรกของวันและ Cash Back ทุกวัน ฝากถอนออโต้เสร็จใน 3 วินาที ถอนได้เต็มทุกยอด ให้ไปเลย 5 ดาวเต็ม",
    avatar: "♠️",
  },
];
---

<section aria-label="เสียงตอบรับจากผู้ใช้งานจริงของ SETH88" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fdf3d4] via-[#f7d774] to-[#a9711a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงตอบรับจาก <span class="text-[#f7d774]">ผู้ใช้งานจริง</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e0a92b] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col justify-between rounded-3xl border border-[#6b4210]/60 bg-[#0c0703]/85 p-8 shadow-[0_10px_30px_rgba(12,7,3,0.8)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#f7d774]/60 hover:shadow-[0_15px_40px_rgba(224,169,43,0.3)]">
          <div class="pointer-events-none absolute -top-10 -left-10 -z-10 h-32 w-32 rounded-full bg-[#e0a92b]/12 blur-[50px] transition-all duration-500 group-hover:bg-[#e0a92b]/25" />

          <div class="flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#6b4210] pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#e0a92b]/60 drop-shadow-[0_0_5px_rgba(224,169,43,0.5)]">
                &ldquo;
              </span>
              <span aria-hidden="true" class="flex gap-1 text-lg">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f7d774] drop-shadow-[0_0_5px_rgba(247,215,116,0.8)]" : "text-[#3a2716]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </div>

            <p class="min-h-[100px] text-sm leading-relaxed text-[#d6c2a0] italic">{review.content}</p>
          </div>

          <div class="mt-6 flex items-center gap-4 border-t border-[#2a1a0d] pt-4">
            <span
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#e0a92b]/40 bg-gradient-to-br from-[#6b4210] to-[#0c0703] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <p class="text-base font-black text-[#f0e3cd] transition-colors group-hover:text-[#f7d774]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#d6c2a0] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
