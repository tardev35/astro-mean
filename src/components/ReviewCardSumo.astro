---
// Widget ไม่ใช่ article: บรรทัดหัวของบล็อกเป็น <p> และชื่อผู้รีวิวเป็น <p> เช่นกัน
// <section> เป็นตัวถือชื่อสำหรับ assistive tech ผ่าน aria-label — ไฟล์นี้เคยปล่อย
// <h2> หนึ่งตัวกับ <h4> อีกสามตัวออกมา ซึ่งไม่มีต้นทางใน docx เลยสักตัว และทำให้
// inventory หัวข้อบนหน้าแรกที่ถูก diff กับ checklist ของ brief ทุกรอบเพี้ยน
//
// ดาวเป็นของตกแต่งล้วน จึงอยู่ในกล่อง aria-hidden แล้วใส่ข้อความ sr-only บอกคะแนน
// จริงกลับเข้าไป ไม่งั้น screen reader จะอ่าน "ดาว" ห้าครั้งต่อการ์ดโดยไม่ได้ตัวเลข
// อิโมจิของอวาตาร์ก็เป็นของตกแต่ง อยู่ใน <span aria-hidden="true"> ของตัวเอง
//
// QUEEN189: ไฟล์นี้เป็น inventory ที่ค้างชุดสีของแบรนด์ก่อนหน้ามา รอบนี้ถูกเขียนใหม่
// ทั้งไฟล์มาที่ทองราชสำนักบนดำสนิท — ทอง #fdf3d2 / #fceb83 / #e4bb53 / #c38d29 /
// #7a5615 / #3c2505 บนผิว #0b0704 / #1a1108 / #271a0c เนื้อความ #f3e4c4 ข้อความรอง
// #c2a878 (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิม
// ได้จาก git history)
//
// เนื้อรีวิวอ้างข้อเท็จจริงชุดเดียวกับ docx ของแบรนด์นี้: เว็บตรง API แท้ยิงตรงจาก
// เซิร์ฟนอกโดยไม่ผ่านเอเย่นต์และไม่ล็อกยูส, ค่า RTP มาตรฐานสากลไร้การดัดแปลง,
// ค่าย PG Soft / Pragmatic Play / SA Gaming / Evolution, ฟีเจอร์ Multipliers ตัวคูณ
// สะสม / โหมดซื้อฟรีสปิน / Cascading, โต๊ะสด Ultra HD บาคาร่า รูเล็ต ไฮโล เสือมังกร
// ผ่านกระเป๋าเงินเดียว และฝากถอนออโต้ 3 วินาที ถอนเต็มจำนวน ไม่ติดเทิร์นโอเวอร์
// มหาโหด
const reviews = [
  {
    name: "ทีม web develop หมีขาว",
    role: "ผู้เชี่ยวชาญด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ไล่ดูโครงสร้างหลังบ้านแล้วบอกได้ว่าเป็นเว็บตรง API แท้จริง ยิงสัญญาณตรงจากเซิร์ฟนอกโดยไม่ผ่านเอเย่นต์คั่นกลางและไม่ล็อกยูส สลับจากหน้าสปินไปโต๊ะสดแล้วโหลดไว ไม่เจอค้างหรือเด้งหลุดเลย หัก 1 ดาวเพราะอยากได้โหมดสว่างเพิ่ม",
    avatar: "🐻‍❄️",
  },
  {
    name: "ชุมนุม เว็บสล็อตออนไลน์",
    role: "คอมมูนิตี้รีวิวเว็บตรง",
    stars: 4,
    content:
      "ทางเพจเทสยาวหนึ่งเดือน คอนเฟิร์มว่าค่า RTP เป็นมาตรฐานสากล ไร้การดัดแปลงระบบ คลังเกมคัดเฉพาะค่ายระดับท็อปอย่าง PG Soft, Pragmatic Play, SA Gaming และ Evolution ฟีเจอร์อย่าง Multipliers ตัวคูณสะสมกับโหมดซื้อฟรีสปินมาครบ แถมมี Cascading ให้เลือกใช้ตามจังหวะที่เล่นด้วย",
    avatar: "🎰",
  },
  {
    name: "อาสาสมัครนักเล่นสล็อต",
    role: "ผู้เล่นระดับ VIP",
    stars: 5,
    content:
      "ลองมาหลายเว็บสุดท้ายจบที่ QUEEN189 ครับ โต๊ะสดคมชัดระดับ Ultra HD ทั้งบาคาร่า รูเล็ต ไฮโล และเสือมังกร ใช้กระเป๋าเงินเดียวไม่ต้องโยกเครดิตให้สับสน ฝากถอนออโต้เสร็จใน 3 วินาที ไม่ต้องส่งสลิปและไม่ต้องรอแอดมินอนุมัติ ถอนออกได้เต็มจำนวนทุกยอด ให้ไปเลย 5 ดาวเต็ม",
    avatar: "👑",
  },
];
---

<section aria-label="เสียงตอบรับจากผู้ใช้งานจริงของ QUEEN189" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fdf3d2] via-[#fceb83] to-[#c38d29] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงตอบรับจาก <span class="text-[#fceb83]">ผู้ใช้งานจริง</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e4bb53] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col justify-between rounded-3xl border border-[#7a5615]/45 bg-[#0b0704]/85 p-8 shadow-[0_10px_30px_rgba(11,7,4,0.8)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#fceb83]/60 hover:shadow-[0_15px_40px_rgba(228,187,83,0.3)]">
          <div class="pointer-events-none absolute -top-10 -left-10 -z-10 h-32 w-32 rounded-full bg-[#e4bb53]/12 blur-[50px] transition-all duration-500 group-hover:bg-[#e4bb53]/25" />

          <div class="flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#7a5615] pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#e4bb53]/60 drop-shadow-[0_0_5px_rgba(228,187,83,0.5)]">
                &ldquo;
              </span>
              <span aria-hidden="true" class="flex gap-1 text-lg">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#fceb83] drop-shadow-[0_0_5px_rgba(252,235,131,0.8)]" : "text-[#271a0c]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </div>

            <p class="min-h-[100px] text-sm leading-relaxed text-[#c2a878] italic">{review.content}</p>
          </div>

          <div class="mt-6 flex items-center gap-4 border-t border-[#271a0c] pt-4">
            <span
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#e4bb53]/40 bg-gradient-to-br from-[#c38d29] to-[#0b0704] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <p class="text-base font-black text-[#f3e4c4] transition-colors group-hover:text-[#fceb83]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#c2a878] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
