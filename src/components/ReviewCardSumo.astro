---
// Widget ไม่ใช่ article: บรรทัดหัวของบล็อกเป็น <p> และชื่อผู้รีวิวเป็น <p> เช่นกัน
// <section> เป็นตัวถือชื่อสำหรับ assistive tech ผ่าน aria-label — ไฟล์นี้เคยปล่อย
// <h2> หนึ่งตัวกับ <h4> อีกสามตัวออกมา ซึ่งไม่มีต้นทางใน docx เลยสักตัว และทำให้
// inventory หัวข้อบนหน้าแรกที่ถูก diff กับ checklist ของ brief ทุกรอบเพี้ยน
//
// ดาวเป็นของตกแต่งล้วน จึงอยู่ในกล่อง aria-hidden แล้วใส่ข้อความ sr-only บอกคะแนน
// จริงกลับเข้าไป ไม่งั้น screen reader จะอ่าน "ดาว" ห้าครั้งต่อการ์ดโดยไม่ได้ตัวเลข
// อิโมจิของอวาตาร์ก็เป็นของตกแต่ง อยู่ใน <span aria-hidden="true"> ของตัวเอง
//
// ROOM89: ไฟล์นี้เป็น inventory ที่ค้างชุดสีของแบรนด์ก่อนหน้ามา รอบนี้ถูกเขียนใหม่
// ทั้งไฟล์มาที่ทองคำขัดเงาคู่เงินแพลตินัมบนดำอมน้ำตาล — ทอง #f7edc4 / #e6cf72 /
// #c9a227 / #6b5424 / #3b2c10 คู่เงิน #e8ebef / #b9c2cc / #7c8794 / #2a2f36 บนผิว
// #0b0805 / #161009 / #1a1208 ขอบ #4a3a18 เนื้อความ #f0e6cf ข้อความรอง #c2b493
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history)
//
// เนื้อรีวิวอ้างข้อเท็จจริงชุดเดียวกับ docx ของแบรนด์นี้: เว็บตรงตัวตึง API แท้ยิงตรง
// จากเซิร์ฟนอกโดยไม่ผ่านเอเย่นต์ ไม่ล็อกยูส, ค่า RTP เป๊ะตามสเปกโรงงาน, ล็อกเป้าคัด
// เกมเด่นมาไว้บนล็อบบี้, ค่าย PG Soft / Pragmatic Play / Joker Gaming กราฟิก 3D
// คมชัด, ฟีเจอร์ Multipliers / Expanding Wild / Cascading / Bonus Buy, เกมหลาย
// สไตล์ผ่านกระเป๋าเดียว, โบนัสฝากแรกของวันกับ Cash Back และฝากถอนออโต้ 3 วินาที
const reviews = [
  {
    name: "ทีม web develop หมีขาว",
    role: "ผู้เชี่ยวชาญด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ไล่ดูโครงสร้างหลังบ้านแล้วบอกได้ว่าเป็นเว็บตรงตัวตึง API แท้จริง ยิงตรงจากเซิร์ฟนอกโดยไม่ผ่านเอเย่นต์คั่นกลาง และไม่เจอร่องรอยการล็อกยูสเลย รันบนเซิร์ฟเวอร์ความเร็วสูงจึงลากยาว 24 ชั่วโมงได้โดยไม่ค้างไม่เด้งหลุด หัก 1 ดาวเพราะอยากได้โหมดสว่างเพิ่ม",
    avatar: "🐻‍❄️",
  },
  {
    name: "ชุมนุม เว็บสล็อตออนไลน์",
    role: "คอมมูนิตี้รีวิวเว็บตรง",
    stars: 4,
    content:
      "ทางเพจเทสยาวหนึ่งเดือน คอนเฟิร์มว่าค่า RTP เป๊ะตามสเปกโรงงาน ไม่มีปรับลดเปอร์เซ็นต์แตก ล็อบบี้ล็อกเป้าคัดเกมตัวเด่นมาให้จริง ไม่ต้องเลื่อนหาจนนิ้วล็อค ค่ายยกมาครบทั้ง PG Soft, Pragmatic Play และ Joker Gaming กราฟิก 3D ลื่นๆ ฟีเจอร์ Multipliers กับ Cascading มาครบ",
    avatar: "🎰",
  },
  {
    name: "อาสาสมัครนักเล่นสล็อต",
    role: "ผู้เล่นระดับ VIP",
    stars: 5,
    content:
      "ลองมาหลายเว็บสุดท้ายจบที่ ROOM89 ครับ สลับจากสายคอมโบแตกนอกไปสายซื้อฟีเจอร์พุ่งชนฟรีสปิน หรือแนวคลาสสิกตัวคูณหนักได้จากกระเป๋าเดียว ไม่ต้องเสียเวลาโยกเงิน โปรกดรับเองผ่านหน้าเว็บทั้งฝากแรกของวันและ Cash Back ฝากถอนออโต้เสร็จใน 3 วินาที ถอนได้เต็มทุกยอด ให้ไปเลย 5 ดาวเต็ม",
    avatar: "♠️",
  },
];
---

<section aria-label="เสียงตอบรับจากผู้ใช้งานจริงของ ROOM89" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f7edc4] via-[#e6cf72] to-[#b9c2cc] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงตอบรับจาก <span class="text-[#e6cf72]">ผู้ใช้งานจริง</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#c9a227] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col justify-between rounded-3xl border border-[#4a3a18]/60 bg-[#0b0805]/85 p-8 shadow-[0_10px_30px_rgba(11,8,5,0.8)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#e6cf72]/60 hover:shadow-[0_15px_40px_rgba(201,162,39,0.3)]">
          <div class="pointer-events-none absolute -top-10 -left-10 -z-10 h-32 w-32 rounded-full bg-[#c9a227]/12 blur-[50px] transition-all duration-500 group-hover:bg-[#c9a227]/25" />

          <div class="flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#4a3a18] pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#c9a227]/60 drop-shadow-[0_0_5px_rgba(201,162,39,0.5)]">
                &ldquo;
              </span>
              <span aria-hidden="true" class="flex gap-1 text-lg">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#e6cf72] drop-shadow-[0_0_5px_rgba(230,207,114,0.8)]" : "text-[#2a2f36]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </div>

            <p class="min-h-[100px] text-sm leading-relaxed text-[#c2b493] italic">{review.content}</p>
          </div>

          <div class="mt-6 flex items-center gap-4 border-t border-[#1a1208] pt-4">
            <span
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#c9a227]/40 bg-gradient-to-br from-[#6b5424] to-[#0b0805] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <p class="text-base font-black text-[#f0e6cf] transition-colors group-hover:text-[#e6cf72]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#c2b493] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
