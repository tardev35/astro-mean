---
// Widget ไม่ใช่ article: บรรทัดหัวของบล็อกเป็น <p> และชื่อผู้รีวิวเป็น <p> เช่นกัน
// <section> เป็นตัวถือชื่อสำหรับ assistive tech ผ่าน aria-label — ไฟล์นี้เคยปล่อย
// <h2> หนึ่งตัวกับ <h4> อีกสามตัวออกมา ซึ่งไม่มีต้นทางใน docx เลยสักตัว และทำให้
// inventory หัวข้อบนหน้าแรกที่ถูก diff กับ checklist ของ brief ทุกรอบเพี้ยน
//
// ดาวเป็นของตกแต่งล้วน จึงอยู่ในกล่อง aria-hidden แล้วใส่ข้อความ sr-only บอกคะแนน
// จริงกลับเข้าไป ไม่งั้น screen reader จะอ่าน "ดาว" ห้าครั้งต่อการ์ดโดยไม่ได้ตัวเลข
// อิโมจิของอวาตาร์ก็เป็นของตกแต่ง อยู่ใน <span aria-hidden="true"> ของตัวเอง
//
// AWIN8: ไฟล์นี้เป็น inventory ที่ค้างชุดแดงเฮงคู่ทองของแบรนด์ก่อนหน้ามา รอบนี้ถูก
// เขียนใหม่ทั้งไฟล์มาที่น้ำเงินรอยัลคู่ทองส้ม — น้ำเงิน #1f6fea / #7fb2ff /
// #0d3f9e / #07265e / #0c2247 คู่ทอง #fca311 / #ffd27a และขาวฟ้า #e8f1ff บนผิว
// #02081c / #040e22 / #08172f เนื้อความ #d8e6fb ข้อความรอง #9db4d6 (ห้ามพิมพ์ hex
// ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์
// จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// เนื้อรีวิวอ้างข้อเท็จจริงชุดเดียวกับ docx ของแบรนด์นี้: เชื่อมสัญญาณ API ตรงจาก
// สตูดิโอผู้พัฒนาโดยไม่ผ่านเอเย่นต์, RTP มาตรฐานตามสเปกโรงงานไม่ปรับแต่งเปอร์เซ็นต์,
// ฝากถอนออโต้ผ่าน Gateway ตรงจบในไม่กี่วินาทีโดยไม่ต้องแนบสลิป, โปรเป็นชุดทั้ง
// โบนัสฝากแรกและ Cash Back รายวันที่ไม่ติดล็อคยูส และฟีเจอร์ Multiplier Drops /
// Expanding Wilds / ซื้อฟรีสปิน
const reviews = [
  {
    name: "ทีม web develop หมีขาว",
    role: "ผู้เชี่ยวชาญด้านระบบเว็บไซต์",
    stars: 4,
    content:
      "ไล่ดูโครงสร้างหลังบ้านแล้วบอกได้ว่าเชื่อมสัญญาณ API ตรงจากสตูดิโอผู้พัฒนาจริง ไม่ผ่านเอเย่นต์คั่นกลาง ระบบทำรายการออโต้ยิงผ่าน Gateway ตรงจบในไม่กี่วินาทีตามที่โฆษณาไว้ ล็อบบี้อัปเดตเกมใหม่ขึ้นแถวหน้าทันทีที่เปิดตัว หัก 1 ดาวเพราะอยากได้โหมดสว่างเพิ่ม",
    avatar: "🐻‍❄️",
  },
  {
    name: "ชุมนุม เว็บสล็อตออนไลน์",
    role: "คอมมูนิตี้รีวิวเว็บตรง",
    stars: 4,
    content:
      "ทางเพจเทสยาวหนึ่งเดือน คอนเฟิร์มว่าค่า RTP เป็นมาตรฐานตามสเปกโรงงาน ไม่มีการปรับแต่งเปอร์เซ็นต์แพ้ชนะ คลังเกมกวาดเฉพาะตัวระดับ A-List จากค่ายใหญ่ ฟีเจอร์อย่าง Multiplier Drops กับ Expanding Wilds มาครบ ที่สำคัญคือไม่เจอเคสล็อกยูสเลยแม้แต่รายเดียว",
    avatar: "🎰",
  },
  {
    name: "อาสาสมัครนักเล่นสล็อต",
    role: "ผู้เล่นระดับ VIP",
    stars: 5,
    content:
      "ลองมาหลายเว็บสุดท้ายจบที่ AWIN8 ครับ โปรจัดมาเป็นชุดให้เลือกกดรับเองตามจังหวะที่เล่นวันนั้น ทั้งโบนัสสมทบทุนฝากแรกและคืนยอดเสีย Cash Back รายวัน เงื่อนไขโปร่งใส ถอนได้จริงไม่ติดล็อคยูส ยอดเข้าคลังเกมทันทีไม่ต้องแนบสลิป ให้ไปเลย 5 ดาวเต็ม",
    avatar: "👑",
  },
];
---

<section aria-label="เสียงตอบรับจากผู้ใช้งานจริงของ AWIN8" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#e8f1ff] via-[#ffd27a] to-[#1f6fea] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงตอบรับจาก <span class="text-[#fca311]">ผู้ใช้งานจริง</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#1f6fea] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col justify-between rounded-3xl border border-[#0d3f9e]/40 bg-[#040e22]/85 p-8 shadow-[0_10px_30px_rgba(2,8,28,0.8)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#7fb2ff]/60 hover:shadow-[0_15px_40px_rgba(31,111,234,0.3)]">
          <div class="pointer-events-none absolute -top-10 -left-10 -z-10 h-32 w-32 rounded-full bg-[#1f6fea]/12 blur-[50px] transition-all duration-500 group-hover:bg-[#1f6fea]/25" />

          <div class="flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#07265e] pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#1f6fea]/60 drop-shadow-[0_0_5px_rgba(31,111,234,0.5)]">
                &ldquo;
              </span>
              <span aria-hidden="true" class="flex gap-1 text-lg">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#fca311] drop-shadow-[0_0_5px_rgba(252,163,17,0.8)]" : "text-[#0c2247]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </div>

            <p class="min-h-[100px] text-sm leading-relaxed text-[#9db4d6] italic">{review.content}</p>
          </div>

          <div class="mt-6 flex items-center gap-4 border-t border-[#0c2247] pt-4">
            <span
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#1f6fea]/40 bg-gradient-to-br from-[#0d3f9e] to-[#02081c] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <p class="text-base font-black text-[#d8e6fb] transition-colors group-hover:text-[#7fb2ff]">{review.name}</p>
              <span class="text-[11px] font-bold tracking-wider text-[#fca311]/80 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
