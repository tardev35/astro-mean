---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const targetPath = imagePaths.find((path) => path.endsWith(".png")) || imagePaths.find((path) => path.endsWith(".webp")) || (imagePaths.length > 0 ? imagePaths[0] : null);
const mainLogo = targetPath ? images[targetPath].default : null;
---

<footer
  class="relative mt-12 w-full overflow-hidden rounded-t-[3rem] border-t border-[#1e63d8]/40 bg-[#081530] pt-16 pb-8 font-sans text-white shadow-[0_-10px_30px_rgba(4,9,26,0.6)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[200px] w-full max-w-4xl rounded-full bg-[#1e63d8]/15 blur-[80px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1400px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-4 md:col-span-5">
        <a
          href="/"
          class="inline-block max-w-max rounded-xl border border-[#5c9bf0]/20 bg-[#1e63d8]/10 p-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ LOTTOTAX ตัวอักษร LOTTO สีน้ำเงินไล่เฉดและ TAX สีแดงไล่เฉด ขอบขาว"
                widths={[150, 300, 450]}
                sizes="150px"
                class="h-[50px] w-auto drop-shadow-md"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="text-2xl font-black tracking-widest text-white italic">
                <span class="rounded-md bg-gradient-to-r from-[#5c9bf0] to-[#1e63d8] px-2 text-[#04091a]">LOTTO</span>
                <span class="text-[#e63c28]">TAX</span>
              </p>
            )
          }
        </a>
        <p class="mt-2 border-l-2 border-[#1e63d8]/60 pl-4 text-sm leading-relaxed text-[#dbeafe]/70">
          LOTTOTAX คลังหวยออนไลน์ ครบทุกตลาดในระบบเดียว รองรับหวยรัฐบาล หวยลาว หวยฮานอย หวยหุ้น และยี่กี ส่งโพยอัตโนมัติ ตรวจผลย้อนหลังได้ตลอด 24 ชม.
        </p>
        <div class="mt-2 flex gap-3">
          <span class="rounded-full border border-[#1e63d8]/35 bg-[#0b1b3a] px-4 py-1 text-xs font-bold text-[#dbeafe] shadow-sm">ส่งโพยอัตโนมัติ</span>
          <span class="rounded-full border border-[#e63c28]/40 bg-[#e63c28]/15 px-4 py-1 text-xs font-bold text-[#ffd9d1] shadow-sm">100% SECURE</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-12">
        <p class="border-b border-[#1e63d8]/35 pb-2 text-lg font-black tracking-widest text-white uppercase">ทางลัดหน้าเว็บ</p>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#dbeafe]/70">
          <li><a href="/" class="transition-colors hover:text-[#5c9bf0]">หน้าหลัก</a></li>
          <li><a href="/ตรวจหวย" class="transition-colors hover:text-[#5c9bf0]">ตรวจหวย</a></li>
          <li><a href="/แนวทาง" class="transition-colors hover:text-[#5c9bf0]">แนวทางหวย</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#5c9bf0]">ทางเข้าเว็บไซต์</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#5c9bf0]">โปรโมชั่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#5c9bf0]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#5c9bf0]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-4 md:col-span-4">
        <p class="border-b border-[#1e63d8]/35 pb-2 text-lg font-black tracking-widest text-white uppercase">บริการลูกค้า</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-md transition-all hover:-translate-y-1 hover:shadow-lg">
          ติดต่อทีมงาน LINE 24 ชม.
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address
              aria-label={BRAND_ADDRESS.label}
              class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a
                  href={`mailto:${BRAND_ADDRESS.email}`}
                  class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2 text-xs font-medium text-[#dbeafe]/50">ระบบฝาก-ถอนอัตโนมัติ รองรับ:</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#12357e]/70 pt-8 text-xs font-medium text-[#dbeafe]/40 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} LOTTOTAX ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-white">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-white">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>
