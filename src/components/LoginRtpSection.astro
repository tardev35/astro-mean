---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Widget ไม่ใช่ article — ทุกหัวข้อในนี้เป็น <p>/<span> และชื่อสำหรับ assistive
// tech มาจาก prop `label` ที่ส่งให้กล่องสองคอลัมน์ ไม่มีการส่ง `title` บล็อกนี้จึง
// ไม่ปล่อยหัวข้อออกมาเลย
//
// โครงสองคอลัมน์ยังชี้ที่ ContentBoxTwo.astro ตัวธรรมดา ซึ่งเป็นตัวที่ brand spec
// ล็อกไว้ให้รอบนี้ — กล่องนั้นรับ props ชุดเดียวกัน (title/as/titleleft/titleright/
// label) ถ้าจะหมุนไปตัวอื่นในรอบหน้าให้เปลี่ยนแค่ import
//
// JAICHUA: ย้ายชุดน้ำเงินธงชาติคู่แดงของแบรนด์ก่อนออกทั้งหมด มาที่ทองคำคู่น้ำเงิน
// รอยัลที่วัดจากอาร์ตจริง — ทอง #fbeec9 / #f6d67e / #d8a83f / #a97722 / #6d4a12
// คู่น้ำเงิน #cfe0fb / #5b8ede / #2f5fb0 / #16336b บนผิว #040915 / #0a1226 /
// #0e1a33 / #132244 ขอบ #6d4a12 เนื้อความ #dce6f8 ข้อความรอง #a9b7d4 ตัวหนังสือจาง
// #7d8bab เขียว LINE กับจุด live สีเขียว Tailwind เป็นสีเชิงความหมาย ไม่ถูกแตะ
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ ดูของเดิมได้จาก git history)
//
// เนื้อหาเขียนใหม่ทั้งชุดตาม brief ของแบรนด์นี้ ซึ่งเป็นสล็อตเว็บตรง API แท้ ไม่ใช่
// เว็บหวย: ยิงตรงจากคลังเกมหลักไม่ผ่านเอเย่นต์ ค่า RTP ตรงตามสเปกโรงงาน ระบบหลังบ้าน
// เสถียรไม่มีเกมค้าง ค่ายดัง PG Soft / Pragmatic Play / Joker Gaming ในกระเป๋าเดียว
// เกมใหม่เข้าคลังต่อเนื่อง ลูกเล่นโบนัส Multiplier / Expanding Wild / Cascading
// โปรที่กดรับเองผ่านแดชบอร์ด และออโต้ไฮสปีดที่รองรับธนาคารกับ TrueMoney Wallet
const menus = [
  {
    icon: "🏅",
    name: "เว็บตรง API แท้ ไม่ผ่านเอเย่นต์",
    detail: "ยิงตรงจากคลังเกมหลัก ค่า RTP ตรงตามสเปกโรงงานตามมาตรฐานสากล ชนะเท่าไหร่ถอนได้เท่านั้น ไม่มีหมกเม็ด ไม่ล็อกยูส",
    tag: "จ่ายชัวร์ไม่ต้องเดา",
  },
  {
    icon: "🛡️",
    name: "ระบบหลังบ้านเสถียรระดับสูงสุด",
    detail: "ประมวลผลแม่นยำ ไร้ปัญหาเกมค้างหรือสลีปหลุดกลางรอบ ทุกยอดชนะคำนวณเงินให้แบบเรียลไทม์ กดลุยต่อได้คล่องตัวทุกวินาที",
    tag: "ไม่ค้างไม่หลุด",
  },
  {
    icon: "🎮",
    name: "ค่ายเกมชั้นนำระดับโลกครบครัน",
    detail: "ทั้ง PG Soft, Pragmatic Play และ Joker Gaming ครบทั้งสล็อตวิดีโอ 3D สล็อตตัวคูณสะสม และสายซื้อฟีเจอร์ฟรีสปิน สลับอารมณ์ได้ผ่านกระเป๋าเดียว",
    tag: "กระเป๋าเดียวจบ",
  },
  {
    icon: "🆕",
    name: "ของใหม่น่าลองเติมมาเรื่อยๆ",
    detail: "อัปเดตรายชื่อเกมใหม่เข้าคลังทันทีที่ค่ายผู้พัฒนาปล่อยตัวเกมออกมา คัดเฉพาะตัวเด็ดแตกง่ายมาเติม ให้ได้ลองฟีเจอร์สดใหม่ก่อนใคร",
    tag: "ล็อบบี้ไม่ซ้ำซาก",
  },
  {
    icon: "✖️",
    name: "ลูกเล่นแจกโบนัสอัดแน่นทุกเกม",
    detail: "ระบบสุ่มแจกตัวคูณ Multiplier ยิ่งหมุนยิ่งคูณหนัก สัญลักษณ์ Expanding Wild ขยายเต็มจอ และคอมโบแตกต่อเนื่อง Cascading ให้ลุ้นได้ทุกวินาที",
    tag: "โบนัสมีจังหวะ",
  },
  {
    icon: "🎁",
    name: "โปรมีของ กดรับเองผ่านแดชบอร์ด",
    detail: "ทั้งโบนัสต้อนรับสมาชิกใหม่ โปรเติมเงินฝากแรกของวัน และสิทธิ์คืนยอดเสีย Cash Back ทุกวัน เงื่อนไขโปร่งใส ไม่ติดเทิร์นโอเวอร์มหาโหด",
    tag: "เลือกใช้ได้ตรงจังหวะ",
  },
  {
    icon: "⚡",
    name: "ออโต้ไฮสปีดผ่าน Gateway ตรง",
    detail: "รองรับทั้งธนาคารและ TrueMoney Wallet ทำรายการเสร็จใน 3 วินาที ยอดเงินอัปเดตเข้าเกมทันที ถอนปุ๊บเงินเข้าบัญชีปั๊บ ไม่ต้องส่งสลิป",
    tag: "เสร็จใน 3 วิ",
  },
];

const chips = ["สล็อตเว็บตรง API แท้", "RTP ตรงสเปกโรงงาน", "ไม่ล็อกยูส", "สล็อตวิดีโอ 3D", "ตัวคูณสะสม", "ซื้อฟีเจอร์ฟรีสปิน", "Cash Back ทุกวัน", "ออโต้ 3 วินาที"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ JAICHUA" titleright="ระบบและจุดเด่นของ JAICHUA ที่รวมไว้ในบัญชีเดียว" label="เข้าสู่ระบบ JAICHUA และตารางอ้างอิงระบบกับจุดเด่นภายในเว็บ">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#6d4a12]/70 bg-[#0a1226] p-6 shadow-[0_10px_30px_rgba(22,39,78,0.45)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#132244]/90 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#d8a83f]/45 bg-gradient-to-br from-[#fbeec9] via-[#d8a83f] to-[#6d4a12] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fbeec9]">ยินดีต้อนรับกลับเข้าล็อบบี้ JAICHUA</p>
          <span class="text-[11px] text-[#a9b7d4]">
            กรอกเบอร์โทรศัพท์และรหัสผ่านที่ตั้งไว้ ก็เข้าเล่นได้ครบทั้งสล็อตวิดีโอ 3D สล็อตตัวคูณสะสม และสายซื้อฟีเจอร์ฟรีสปินจากทุกค่ายในกระเป๋าเดียว พร้อมระบบฝากถอนออโต้ที่ทำรายการเสร็จใน 3 วินาที
            โดยไม่ต้องส่งสลิป
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#d8a83f]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#6d4a12] bg-[#040915] py-3 pr-4 pl-12 text-[#dce6f8] transition-all outline-none placeholder:text-[#7d8bab] focus:border-[#d8a83f] focus:ring-1 focus:ring-[#d8a83f]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#d8a83f]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#6d4a12] bg-[#040915] py-3 pr-4 pl-12 text-[#dce6f8] transition-all outline-none placeholder:text-[#7d8bab] focus:border-[#d8a83f] focus:ring-1 focus:ring-[#d8a83f]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#a9b7d4]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#6d4a12] bg-[#040915] accent-[#d8a83f]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#a9b7d4] transition-colors hover:text-[#f6d67e]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#6d4a12]/80 bg-gradient-to-r from-[#fbeec9] via-[#d8a83f] to-[#a97722] p-3.5 font-black text-[#040915] shadow-[0_10px_30px_rgba(216,168,63,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(216,168,63,0.45)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#a9b7d4]">
          <span class="h-px flex-1 bg-[#6d4a12]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#6d4a12]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#6d4a12] bg-[#040915] px-2.5 py-1 text-[10px] font-bold text-[#f6d67e]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#2f5fb0]/40 bg-[#040915] px-2.5 py-1 text-[10px] font-bold text-[#cfe0fb]"><span aria-hidden="true">🕐</span> ออโต้ตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#fbeec9] transition-colors hover:text-[#f6d67e]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#d8a83f]/30 bg-[#0a1226] p-5 shadow-[0_10px_30px_rgba(216,168,63,0.18)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#a9b7d4]">ตารางอ้างอิงระบบและจุดเด่นที่รวมไว้ในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#fbeec9] via-[#f6d67e] to-[#5b8ede] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">
            สล็อตจ่ายชัวร์ไม่ต้องเดา เกมดังเข้าฟีล ออโต้ไวไม่เสียจังหวะ
          </div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#040915] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#a9b7d4]">
        <span>ระบบ / จุดเด่นในเว็บ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#6d4a12] bg-[#040915] px-3.5 py-2.5 transition-colors hover:border-[#d8a83f]/45 hover:bg-[#132244]/90">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#dce6f8]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#d8a83f]/60 bg-[#6d4a12] px-2.5 py-0.5 text-[10px] font-bold text-[#fbeec9]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#a9b7d4]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#2f5fb0]/40 bg-[#040915] px-3 py-1 text-[10px] font-bold text-[#cfe0fb]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#7d8bab]">
        รายละเอียดทั้งหมดเป็นข้อมูลอ้างอิงสำหรับสมาชิก ควรตรวจอัตราจ่ายของแต่ละเกม เงื่อนไขการซื้อฟีเจอร์ และเงื่อนไขการรับโปรของรอบนั้นจากหน้าเกมและหน้าแดชบอร์ดจริงของ JAICHUA ก่อนลงเดิมพันทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
