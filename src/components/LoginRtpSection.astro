---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Widget ไม่ใช่ article — ทุกหัวข้อในนี้เป็น <p>/<span> และชื่อสำหรับ assistive
// tech มาจาก prop `label` ที่ส่งให้ ContentBoxTwo ไม่มีการส่ง `title` บล็อกนี้จึง
// ไม่ปล่อยหัวข้อออกมาเลย
//
// BOOST168: ย้ายจากนีออนม่วงคู่ทองของแบรนด์ก่อนหน้า (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ —
// Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มี
// ใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history) มาที่ทองบูสต์คู่น้ำเงินไฟฉาย —
// ทอง #ffe680 / #ffc233 / #b26a00 คู่น้ำเงิน #9ecbff / #3f8cff บนผิว #0e1430 /
// #050818 / #03060f / #18204a เนื้อความ #e6ecfb ข้อความรอง #9ecbff หมึกบนปุ่มทอง
// #0a0f22 เขียว LINE #00B900 กับจุด live สีเขียวเป็นสีเชิงความหมาย ไม่ถูกแตะ
//
// เนื้อหาตาม brief ของแบรนด์นี้: สล็อตเว็บตรงจัดหนัก อัปคลังเกมใหม่ไม่ขาดช่วง เกมดี
// มีบูสต์ด้วยฟีเจอร์สุ่มคูณเงินรางวัล รีสปินล็อกสัญลักษณ์ และฟรีสปิน โบนัสหลายรูปแบบ
// ทั้งโปรต้อนรับ เติมเงินรายวัน และกิจกรรมคืนกำไร ระบบไวไม่เกินจริง และระบบออโต้ที่
// ลดขั้นตอนตั้งแต่สมัครถึงฝากถอน
const menus = [
  { icon: "🎰", name: "คลังเกมใหม่อัปตัวเด็ดตามต่อไม่ขาดช่วง", detail: "ขนเกมตัวตึงจากทุกค่ายชั้นนำมารวมไว้ในล็อบบี้เดียว ทั้งแนวสตรีท แฟนตาซีเวทมนตร์ และคลาสสิกโบนัสแตกง่าย เปลี่ยนบรรยากาศได้ตลอด", tag: "อัปคลังต่อเนื่อง" },
  { icon: "🚀", name: "ฟีเจอร์สุ่มคูณเงินรางวัลในตัวเกม", detail: "เกมดีมีบูสต์ไม่ใช่แค่ภาพสวย แต่มีตัวคูณที่เข้ามาเพิ่มโอกาสทำกำไร ทำให้การหมุนวงล้อแต่ละรอบมีความหมายมากกว่าลุ้นสัญลักษณ์ธรรมดา", tag: "คูณเงินรางวัล" },
  { icon: "🔁", name: "รีสปินล็อกสัญลักษณ์และฟรีสปินออกบ่อย", detail: "ลูกเล่นเสริมที่ยกระดับความสนุกอีกขั้น ทั้งรอบรีสปินที่ล็อกสัญลักษณ์ไว้ให้ต่อยอด และโหมดฟรีสปินที่เข้าถึงได้ง่ายกว่าที่คิด", tag: "ฟีเจอร์ครบ" },
  { icon: "🎁", name: "โบนัสหลายรูปแบบยืดหยุ่นตามสไตล์การเล่น", detail: "ทั้งโปรโมชันต้อนรับสมาชิกใหม่ โบนัสเติมเงินรายวัน และกิจกรรมพิเศษคืนกำไร ช่วยเติมทุนให้ออกไปปั่นได้นานขึ้นโดยไม่ต้องใช้ทุนเยอะ", tag: "หลายรูปแบบ" },
  { icon: "⚡", name: "ระบบไวไม่เกินจริง กดเข้าเกมแล้วเข้าได้ทันที", detail: "หน้าเว็บโหลดฉับไว สัญญาณเชื่อมต่อตรงกับค่ายเกมหลักอย่างเสถียร ไม่มีอาการกระตุกหรือเกมหลุดมาทำลายบรรยากาศกลางรอบโบนัส", tag: "ตอบสนองพอดี" },
  { icon: "🤖", name: "ระบบออโต้ลดขั้นตอนตั้งแต่สมัครถึงถอน", detail: "สมัครสมาชิก กดรับโปรโมชัน ฝากและถอนเงิน จัดการเองได้ภายในไม่กี่คลิก รวดเร็ว แม่นยำ ปลอดภัย ไม่ต้องส่งสลิปหรือรอคนกลาง", tag: "ออโต้ทั้งระบบ" },
  { icon: "👛", name: "รองรับวอเลทและธนาคารชั้นนำแบบไม่กั้นทุน", detail: "ทำรายการผ่าน TrueMoney Wallet และบัญชีธนาคารหลักได้อิสระ จะเบทหลักสิบหรือล่าแจ็คพอตหลักหมื่นก็เริ่มต้นได้เหมือนกัน", tag: "ไม่กั้นทุน" },
];

const chips = ["สล็อตเว็บตรงจัดหนัก", "คลังเกมใหม่ตามต่อ", "เกมดีมีบูสต์", "โบนัสหลายรูปแบบ", "ระบบไวไม่เกินจริง", "ออโต้ไม่กี่คลิก", "เล่นได้ตลอด 24 ชั่วโมง"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ BOOST168" titleright="ระบบและสิทธิพิเศษของ BOOST168 ที่รวมไว้ในบัญชีเดียว" label="เข้าสู่ระบบ BOOST168 และตารางอ้างอิงระบบกับสิทธิพิเศษภายในเว็บ">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#ffc233]/30 bg-[#0e1430] p-6 shadow-[0_10px_30px_rgba(255,194,51,0.22)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#3f8cff]/35 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ffc233]/45 bg-gradient-to-br from-[#ffe680] via-[#ffc233] to-[#b26a00] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffe680]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#9ecbff]">กรอกเบอร์โทรศัพท์และรหัสผ่านที่ตั้งไว้ ก็เข้าล็อบบี้เกมสล็อตทุกค่ายของ BOOST168 ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ffc233]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#18204a] bg-[#03060f] py-3 pr-4 pl-12 text-[#e6ecfb] transition-all outline-none placeholder:text-[#9ecbff]/70 focus:border-[#ffc233] focus:ring-1 focus:ring-[#ffc233]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ffc233]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#18204a] bg-[#03060f] py-3 pr-4 pl-12 text-[#e6ecfb] transition-all outline-none placeholder:text-[#9ecbff]/70 focus:border-[#ffc233] focus:ring-1 focus:ring-[#ffc233]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#9ecbff]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#18204a] bg-[#03060f] accent-[#ffc233]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#9ecbff] transition-colors hover:text-[#ffe680]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#b26a00]/50 bg-gradient-to-r from-[#ffe680] via-[#ffc233] to-[#b26a00] p-3.5 font-black text-[#0a0f22] shadow-[0_10px_30px_rgba(255,194,51,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(255,194,51,0.45)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#9ecbff]">
          <span class="h-px flex-1 bg-[#18204a]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#18204a]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#ffc233]/30 bg-[#03060f] px-2.5 py-1 text-[10px] font-bold text-[#ffe680]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#18204a] bg-[#03060f] px-2.5 py-1 text-[10px] font-bold text-[#9ecbff]"><span aria-hidden="true">🕐</span> ทำรายการได้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#9ecbff] transition-colors hover:text-[#3f8cff]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#ffc233]/30 bg-[#0e1430] p-5 shadow-[0_10px_30px_rgba(255,194,51,0.22)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#9ecbff]">ตารางอ้างอิงระบบและสิทธิพิเศษที่รวมไว้ในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#fff6dd] via-[#ffc233] to-[#3f8cff] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">เกมดีมีบูสต์ ระบบไวไม่เกินจริง</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#03060f] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#9ecbff]">
        <span>ระบบ / สิทธิพิเศษในเว็บ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#18204a] bg-[#03060f] px-3.5 py-2.5 transition-colors hover:border-[#ffc233]/55 hover:bg-[#18204a]/70">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e6ecfb]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#3f8cff]/60 bg-[#ffc233] px-2.5 py-0.5 text-[10px] font-bold text-[#0a0f22]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#9ecbff]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#ffc233]/30 bg-[#03060f] px-3 py-1 text-[10px] font-bold text-[#ffe680]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#9ecbff]/80">
        รายละเอียดทั้งหมดเป็นข้อมูลอ้างอิงสำหรับผู้เล่น ควรตรวจเดิมพันขั้นต่ำและสูงสุดของแต่ละเกม เงื่อนไขการรับสิทธิ์ และเพดานถอนจากหน้าโปรโมชั่นจริงของ BOOST168 ก่อนกดรับทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
