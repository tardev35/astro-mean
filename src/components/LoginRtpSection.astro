---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Widget ไม่ใช่ article — ทุกหัวข้อในนี้เป็น <p>/<span> และชื่อสำหรับ assistive
// tech มาจาก prop `label` ที่ส่งให้ ContentBoxTwo ไม่มีการส่ง `title` บล็อกนี้จึง
// ไม่ปล่อยหัวข้อออกมาเลย
//
// VIREL168: โครงสองคอลัมน์ยังเป็น ContentBoxTwo ตัวเดิม แต่ย้ายชุดสีมาที่ทองของ
// แบรนด์นี้ที่วัดจากอาร์ตจริง — ทอง #faca4c / #ebb134 / #e2a52d / #ffeec2 /
// #855a14 คู่เงินโครเมียม #e1e1e1 / #949494 บนผิว #0a0501 / #1b0d02 ขอบ/แถบยก
// #2e1a04 / #442503 เนื้อความ #f4e7cd ข้อความรอง #c4ab7d หมึกบนปุ่มทอง #0a0501
// เขียว LINE #00B900 กับจุด live สีเขียว Tailwind เป็นสีเชิงความหมาย ไม่ถูกแตะ
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ ดูของเดิมได้จาก git history)
//
// เนื้อหาตาม brief ของแบรนด์นี้: เว็บตรงที่รวมเกมสล็อตแตกง่ายติดเทรนด์จากทุกค่าย
// ชั้นนำไว้ในล็อบบี้เดียว ระบบลื่นไหลไร้ปัญหากระตุก ไลน์อัปเกมฮิตระดับตัวตึง
// เกมนอกกระแสที่ซ่อนฟีเจอร์เด็ด โบนัสพร้อมทุกวันทั้งโปรต้อนรับ เติมเงินรายวัน
// และกิจกรรมตามเทศกาล จัดหมวดหมู่เกมเป็นระเบียบสลับค่ายได้ในไม่กี่คลิก และระบบ
// การเงินออโต้ที่กดถอนเองได้ทันทีโดยไม่ต้องส่งสลิปหรือรอแอดมินอนุมัติ
const menus = [
  {
    icon: "🎰",
    name: "เว็บตรงที่รวมเกมแตกง่ายติดเทรนด์ไว้ที่เดียว",
    detail: "รวบรวมเกมสล็อตแตกง่ายติดเทรนด์จากทุกค่ายชั้นนำมาไว้ในล็อบบี้เดียว พร้อมอัปเดตระบบการทำงานให้ลื่นไหล ไร้ปัญหากระตุก ทำกำไรได้อย่างโปร่งใสและถอนเงินได้จริงทุกยอด",
    tag: "เกมฮิตครบ",
  },
  {
    icon: "🔥",
    name: "ไลน์อัปเกมฮิตระดับตัวตึงที่สายปั่นกำลังตาม",
    detail: "ทั้งเกมสล็อตธีมผจญภัยสุดอลังการและเกมแนวแอ็กชันที่มีฟีเจอร์ตัวคูณสะสมแบบทวีคูณ ทุกเกมผ่านการคัดสรรมาแล้วว่ามีอัตราการจ่ายเงินรางวัลดีเยี่ยมและลุ้นรอบแจ็คพอตง่าย",
    tag: "มาแรงตอนนี้",
  },
  {
    icon: "🏆",
    name: "ค่ายดังครบเครื่อง เปิดครั้งเดียวเจอหลายสไตล์",
    detail: "รวมค่ายเกมยักษ์ใหญ่ระดับโลกไว้ในล็อบบี้เดียว ทั้งค่ายที่ขึ้นชื่อเรื่องภาพสวยสมจริงและค่ายที่เน้นจังหวะโบนัสระเบิดไว ไม่ต้องเสียเวลาโยกเว็บไปมาเพื่อตามหาเกมค่ายโปรด",
    tag: "ครบทุกค่าย",
  },
  {
    icon: "🔎",
    name: "เกมน่าค้นที่ซ่อนฟีเจอร์เด็ดไว้ในหน้าล็อบบี้",
    detail: "นอกจากตัวท็อปติดลมบนแล้ว ยังมีเกมนอกกระแสอีกหลายตัวที่ซ่อนลูกเล่นไว้ ทั้งระบบฟรีสปินที่ออกง่ายเกินคาดและสัญลักษณ์พิเศษที่เปลี่ยนรางวัลธรรมดาให้กลายเป็นแจ็คพอตก้อนโต",
    tag: "ฟีเจอร์ซ่อนอยู่",
  },
  {
    icon: "🎁",
    name: "โบนัสพร้อมทุกวันให้เข้ามาแล้วมีอะไรใหม่",
    detail: "ทั้งโปรโมชันต้อนรับ โบนัสเติมเงินรายวัน และกิจกรรมพิเศษตามเทศกาล ออกแบบมาเพื่อเพิ่มทุนให้ปั่นสล็อตได้นานขึ้น เพิ่มโอกาสพิชิตรางวัลใหญ่ และคืนยอดเสียให้ทุกสัปดาห์",
    tag: "คืนยอดเสีย 5%",
  },
  {
    icon: "🗂️",
    name: "จัดหมวดเลือกง่าย สลับค่ายได้ในไม่กี่คลิก",
    detail: "หน้าเว็บจัดวางหมวดหมู่เกมไว้อย่างเป็นระเบียบ แบ่งประเภทตามค่ายเกมและสไตล์การเล่นชัดเจน อยากเปลี่ยนบรรยากาศก็สลับค่ายได้ทันที ระบบตอบสนองไวโดยไม่ต้องนั่งรอโหลดนาน",
    tag: "หาเกมไม่วุ่น",
  },
  {
    icon: "⚡",
    name: "โอนไวเข้าบัญชีภายในไม่กี่วินาที",
    detail: "ระบบการเงินออโต้เชื่อมตั้งแต่ขั้นตอนการเข้าเล่นจนถึงการถอนเงิน กดถอนผ่านหน้าเว็บได้ด้วยตัวเองทันที ยอดเข้าบัญชีแม่นยำและรวดเร็ว ไม่ต้องส่งสลิปยืนยันหรือคอยแอดมินอนุมัติ",
    tag: "ออโต้ 24 ชม.",
  },
];

const chips = ["สล็อตเว็บตรงเกมฮิต", "ค่ายดังครบเครื่อง", "โบนัสพร้อมทุกวัน", "เกมน่าค้นฟีเจอร์เด็ด", "จัดหมวดเลือกง่าย", "สลับค่ายคล่อง", "โอนไวเข้าบัญชี", "ถอนได้จริงทุกยอด"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ VIREL168" titleright="ระบบและสิทธิพิเศษของ VIREL168 ที่รวมไว้ในบัญชีเดียว" label="เข้าสู่ระบบ VIREL168 และตารางอ้างอิงระบบกับสิทธิพิเศษภายในเว็บ">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#e2a52d]/30 bg-[#1b0d02] p-6 shadow-[0_10px_30px_rgba(226,165,45,0.25)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#855a14]/70 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ffeec2]/45 bg-gradient-to-br from-[#ffeec2] via-[#faca4c] to-[#855a14] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fff8e4]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#c4ab7d]">
            กรอกเบอร์โทรศัพท์และรหัสผ่านที่ตั้งไว้ ก็เข้าปั่นเกมฮิตจากทุกค่ายชั้นนำที่ VIREL168 รวมไว้ในล็อบบี้เดียวได้จากยูสเซอร์เดียว พร้อมกดถอนเองผ่านหน้าเว็บให้ยอดเข้าบัญชีภายในไม่กี่วินาที
            ตลอด 24 ชั่วโมง
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ffeec2]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#442503] bg-[#0a0501] py-3 pr-4 pl-12 text-[#f4e7cd] transition-all outline-none placeholder:text-[#949494] focus:border-[#e2a52d] focus:ring-1 focus:ring-[#e2a52d]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ffeec2]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#442503] bg-[#0a0501] py-3 pr-4 pl-12 text-[#f4e7cd] transition-all outline-none placeholder:text-[#949494] focus:border-[#e2a52d] focus:ring-1 focus:ring-[#e2a52d]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#c4ab7d]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#442503] bg-[#0a0501] accent-[#e2a52d]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#c4ab7d] transition-colors hover:text-[#ffeec2]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#855a14]/50 bg-gradient-to-r from-[#ffeec2] via-[#faca4c] to-[#855a14] p-3.5 font-black text-[#0a0501] shadow-[0_10px_30px_rgba(250,202,76,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(250,202,76,0.45)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#c4ab7d]">
          <span class="h-px flex-1 bg-[#442503]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#442503]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#e2a52d]/35 bg-[#0a0501] px-2.5 py-1 text-[10px] font-bold text-[#ffeec2]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#442503] bg-[#0a0501] px-2.5 py-1 text-[10px] font-bold text-[#c4ab7d]"><span aria-hidden="true">🕐</span> ทำรายการได้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#faca4c] transition-colors hover:text-[#e1e1e1]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#e2a52d]/30 bg-[#1b0d02] p-5 shadow-[0_10px_30px_rgba(226,165,45,0.25)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#c4ab7d]">ตารางอ้างอิงระบบและสิทธิพิเศษที่รวมไว้ในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#fff8e4] via-[#ffeec2] to-[#e2a52d] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">เว็บตรงเกมฮิต โอนไวเข้าบัญชีทันที</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#0a0501] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#c4ab7d]">
        <span>ระบบ / สิทธิพิเศษในเว็บ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#442503] bg-[#0a0501] px-3.5 py-2.5 transition-colors hover:border-[#e2a52d]/55 hover:bg-[#2e1a04]/80">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f4e7cd]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#ffeec2]/60 bg-[#faca4c] px-2.5 py-0.5 text-[10px] font-bold text-[#0a0501]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#c4ab7d]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#e2a52d]/35 bg-[#0a0501] px-3 py-1 text-[10px] font-bold text-[#ffeec2]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#949494]">
        รายละเอียดทั้งหมดเป็นข้อมูลอ้างอิงสำหรับผู้เล่น ควรตรวจอัตราการจ่ายและเงื่อนไขของแต่ละเกม เงื่อนไขการรับสิทธิ์ และเพดานถอนจากหน้าโปรโมชั่นจริงของ VIREL168 ก่อนกดรับทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
