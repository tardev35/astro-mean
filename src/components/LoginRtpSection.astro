---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Widget ไม่ใช่ article — ทุกหัวข้อในนี้เป็น <p>/<span> และชื่อสำหรับ assistive
// tech มาจาก prop `label` ที่ส่งให้ ContentBoxTwo ไม่มีการส่ง `title` บล็อกนี้จึง
// ไม่ปล่อยหัวข้อออกมาเลย ส่วนอิโมจิของป้ายคอลัมน์ใช้ค่า default ของ ContentBoxTwo
// (กุญแจ/เพชร) ซึ่งตรงกับแผงเข้าสู่ระบบและตารางสิทธิพิเศษอยู่แล้ว
//
// PAY69: ย้ายชุดสีของแบรนด์ก่อนออกทั้งหมด มาที่ทองแชมเปญเดี่ยวบนดำสนิทที่วัดจาก
// อาร์ตจริง ไม่มีสีคู่ — ทอง #e8c37a / #f7dfa5 / #fdf4e0 / #a87c2e / #6b4d15 บนผิว
// #08070a / #12100c / #1c1811 เนื้อความ #e6dac2 ข้อความรอง #a99a7d เขียว LINE
// กับจุด live สีเขียว Tailwind เป็นสีเชิงความหมาย ไม่ถูกแตะ (ห้ามพิมพ์ hex ของ
// แบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของ
// เดิมได้จาก git history)
//
// เนื้อหาตาม brief ของแบรนด์นี้ ซึ่งเป็นคาสิโนสด ไม่ใช่สล็อต: เว็บตรง API แท้
// ยิงสัญญาณสด Ultra HD จากฟลอร์คาสิโนจริงในต่างประเทศ ไม่ผ่านเอเย่นต์ ไม่ล็อคยูส
// ไม่ปรับอัตราแพ้ชนะ ค่ายสด Evolution Gaming / SA Gaming / Sexy Baccarat /
// Pragmatic Play Live โต๊ะบาคาร่าคลาสสิก บาคาร่าสายฟ้า รูเล็ต เสือมังกร ไฮโล
// วงล้อเสี่ยงโชคและเกมโชว์สด ห้องตั้งแต่หลักสิบถึง High Roller กระเป๋าเงินเดียว
// ยูสเซอร์เดียว ธนาคารชั้นนำทั่วไทยกับ TrueMoney Wallet โบนัสต้อนรับคาสิโนสด
// โปรฝากแรกของวัน Cash Back ทุกวัน คอมมิชชันชวนเพื่อน และฝากถอนออโต้ผ่าน Gateway
// ตรง เครดิตเข้าใน 3 วินาที
const menus = [
  {
    icon: "🛡️",
    name: "เว็บตรง API แท้ ไม่ผ่านเอเย่นต์",
    detail: "ยิงสัญญาณสดระดับ Ultra HD ส่งตรงจากฟลอร์คาสิโนจริงในต่างประเทศ ไม่ล็อคยูส ไม่ปรับอัตราแพ้ชนะ ถอนหลักแสนหลักล้านจ่ายครบเต็มจำนวน",
    tag: "API แท้",
  },
  {
    icon: "🎥",
    name: "โต๊ะสดแบบเต็มอารมณ์คาสิโน",
    detail: "ดีลเลอร์แจกไพ่จริงแบบเรียลไทม์ ไร้การตัดต่อหรือใช้คลิปวน มุมกล้องหลากหลายมองเห็นทุกมิติการแทง สัญญาณเสถียรไม่มีอาการกระตุก",
    tag: "ดีลเลอร์สด",
  },
  {
    icon: "🃏",
    name: "ค่ายคาสิโนชั้นนำระดับโลกครบครัน",
    detail: "ทั้ง Evolution Gaming, SA Gaming, Sexy Baccarat และ Pragmatic Play Live มีโต๊ะสดให้เลือกเพียบ ทั้งบาคาร่าคลาสสิก บาคาร่าสายฟ้า รูเล็ต เสือมังกร และไฮโล",
    tag: "โต๊ะสดค่ายดัง",
  },
  {
    icon: "👛",
    name: "กระเป๋าเงินเดียว ยูสเซอร์เดียว",
    detail: "สลับจากโต๊ะบาคาร่าไปเดิมพันรูเล็ต วงล้อเสี่ยงโชค หรือเกมโชว์สดได้ทันที ไม่ต้องย้ายเว็บและไม่ต้องโยกเงินข้ามค่ายให้เสียเวลา",
    tag: "ไม่ต้องโยกเงิน",
  },
  {
    icon: "🏦",
    name: "เว็บใหญ่ทุนหนาพร้อมเพย์",
    detail: "ฐานการเงินแข็งแกร่งระดับเว็บใหญ่ พร้อมจ่ายทุกยอดชนะทันที รองรับธนาคารชั้นนำทั่วไทยและระบบ TrueMoney Wallet เก็บข้อมูลสมาชิกเป็นความลับขั้นสุด",
    tag: "จ่ายทุกยอด",
  },
  {
    icon: "🎁",
    name: "สิทธิพิเศษอัปเดตใหม่ทุกวัน",
    detail: "โบนัสต้อนรับคาสิโนสด โปรโมชันฝากแรกของวัน คืนยอดเสียรับ Cash Back ทุกวัน และคอมมิชชันการชวนเพื่อน กดรับเองได้ทันทีผ่านหน้าแดชบอร์ด",
    tag: "Cash Back",
  },
  {
    icon: "⚡",
    name: "ฝากถอนออโต้ทันใจ",
    detail: "ประมวลผลผ่าน Gateway ตรง ฝากเงินปุ๊บเครดิตเข้าเกมใน 3 วินาที กดถอนเข้าบัญชีได้ด้วยตัวเอง ไม่ต้องส่งสลิปยืนยัน ไม่ต้องรอแอดมินอนุมัติ",
    tag: "3 วินาที",
  },
];

const chips = ["เว็บตรง API แท้", "ไม่ผ่านเอเย่นต์", "สัญญาณสด Ultra HD", "ไม่ล็อคยูส", "ไม่ปรับอัตราแพ้ชนะ", "Cash Back ทุกวัน", "ออโต้เข้าใน 3 วินาที", "กระเป๋าเงินเดียว"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ PAY69" titleright="ระบบและสิทธิพิเศษของ PAY69 ที่รวมไว้ในบัญชีเดียว" label="เข้าสู่ระบบ PAY69 และตารางอ้างอิงระบบกับสิทธิพิเศษภายในเว็บ">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#a87c2e]/35 bg-[#12100c] p-6 shadow-[0_10px_30px_rgba(107,77,21,0.28)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#1c1811]/90 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e8c37a]/45 bg-gradient-to-br from-[#fdf4e0] via-[#e8c37a] to-[#6b4d15] text-xl shadow-inner">
          🎴
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fdf4e0]">ยินดีต้อนรับกลับเข้าฟลอร์คาสิโนสด</p>
          <span class="text-[11px] text-[#a99a7d]">
            กรอกเบอร์โทรศัพท์และรหัสผ่านที่ตั้งไว้ ก็เข้าโต๊ะสดค่ายดังที่ PAY69 รวมไว้ได้จากยูสเซอร์เดียว กระเป๋าเงินเดียวสลับโต๊ะได้อิสระโดยไม่ต้องโยกเงิน พร้อมระบบฝากถอนออโต้ผ่าน Gateway ตรง
            เครดิตเข้าเกมใน 3 วินาที
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e8c37a]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#6b4d15] bg-[#08070a] py-3 pr-4 pl-12 text-[#e6dac2] transition-all outline-none placeholder:text-[#a99a7d] focus:border-[#e8c37a] focus:ring-1 focus:ring-[#e8c37a]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e8c37a]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#6b4d15] bg-[#08070a] py-3 pr-4 pl-12 text-[#e6dac2] transition-all outline-none placeholder:text-[#a99a7d] focus:border-[#e8c37a] focus:ring-1 focus:ring-[#e8c37a]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#a99a7d]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#6b4d15] bg-[#08070a] accent-[#a87c2e]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#a99a7d] transition-colors hover:text-[#f7dfa5]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#6b4d15]/70 bg-gradient-to-r from-[#fdf4e0] via-[#f7dfa5] to-[#a87c2e] p-3.5 font-black text-[#08070a] shadow-[0_10px_30px_rgba(232,195,122,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(232,195,122,0.45)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#a99a7d]">
          <span class="h-px flex-1 bg-[#1c1811]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#1c1811]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#a87c2e]/40 bg-[#08070a] px-2.5 py-1 text-[10px] font-bold text-[#e8c37a]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#f7dfa5]/30 bg-[#08070a] px-2.5 py-1 text-[10px] font-bold text-[#fdf4e0]"><span aria-hidden="true">🕐</span> ออโต้ตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#fdf4e0] transition-colors hover:text-[#f7dfa5]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#e8c37a]/30 bg-[#12100c] p-5 shadow-[0_10px_30px_rgba(232,195,122,0.18)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#a99a7d]">ตารางอ้างอิงระบบและสิทธิพิเศษที่รวมไว้ในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#fdf4e0] via-[#f7dfa5] to-[#a87c2e] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">
            คาสิโนฟลอร์ใหญ่ โต๊ะสดค่ายดัง เว็บใหญ่ทุนหนาพร้อมเปย์
          </div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#08070a] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#a99a7d]">
        <span>ระบบ / สิทธิพิเศษในเว็บ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#6b4d15] bg-[#08070a] px-3.5 py-2.5 transition-colors hover:border-[#e8c37a]/45 hover:bg-[#1c1811]/90">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e6dac2]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#fdf4e0]/60 bg-[#f7dfa5] px-2.5 py-0.5 text-[10px] font-bold text-[#08070a]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#a99a7d]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#a87c2e]/40 bg-[#08070a] px-3 py-1 text-[10px] font-bold text-[#e8c37a]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#a99a7d]">
        รายละเอียดทั้งหมดเป็นข้อมูลอ้างอิงสำหรับผู้เล่น ควรตรวจกติกาและเพดานเดิมพันของแต่ละโต๊ะ เงื่อนไขการรับสิทธิ์ และเพดานถอนจากหน้าโปรโมชั่นจริงของ PAY69 ก่อนกดรับทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
