---
import ContentBoxTwo from "./ContentBoxTwoCyberCut.astro";

// Variant rotation for PODK888: the previous brand used ContentBoxTwoPremium,
// this one uses ContentBoxTwoCyberCut.
// Widget, not article — every title in here is a <p>/<span>, and the section's
// accessible name comes from the `label` prop.
const menus = [
  { icon: "🎰", name: "เกมครบทุกสายในแพลตฟอร์มเดียว", detail: "สล็อต บาคาร่า และคาสิโนสด รวมไว้ที่เดียว ไม่ต้องจำหลายรหัสหรือสลับเว็บให้ปวดหัว", tag: "ที่เดียวจบ" },
  { icon: "🎴", name: "คาสิโนสดจากค่ายแท้ระดับโลก", detail: "ภาพสวย ดีลเลอร์แจ่ม คัดเกมเด่นจัดหมวดหมู่ไว้ให้เลือกง่าย ไม่ต้องงมหาเอง", tag: "พร้อมลั่นทันที" },
  { icon: "💥", name: "แตกโหดเต็มหน้ากระดาน", detail: "อัตราการจ่ายที่สมาชิกรีวิวกันปากต่อปาก เข้าฟีเจอร์รัวๆ ทั้งไม้เล็กและไม้ใหญ่", tag: "คนพูดถึงทุกวัน" },
  { icon: "⚡", name: "ระบบออโต้แบบใหม่ โอนไว", detail: "ทำรายการได้ไวมาก กดปุ๊บเงินเด้งปั๊บ ไม่ว่าจะยอดหลักร้อยหรือหลักล้าน", tag: "ฝากถอนไม่รอ" },
  { icon: "🔒", name: "ปลอดภัยทุกยอด ข้อมูลไม่รั่วไหล", detail: "ระบบหลังบ้านรับประกันความปลอดภัย เล่นได้ยาวๆ โดยไม่ต้องนั่งระแวง", tag: "ปลอดภัย 100%" },
  { icon: "🛡️", name: "ไม่มีประวัติโกงหรือบิดยอด", detail: "เปิดให้บริการด้วยความโปร่งใส แอดมินสแตนด์บายดูแลตั้งแต่สมัครจนถึงกดถอน", tag: "โปร่งใสทุกบิล" },
  { icon: "📘", name: "สูตรเล่นและเทคนิคอัปเดตเรื่อยๆ", detail: "มือใหม่ไม่ต้องกลัวเล่นไม่เป็น มีแนวทางวางแผนให้อ่านและปรับใช้ได้จริง", tag: "สำหรับมือใหม่" },
];

const chips = ["เว็บตรงเกมครบทุกสาย", "คาสิโนสดค่ายแท้", "แตกโหดเต็มหน้ากระดาน", "ระบบใหม่โอนไว", "ปลอดภัยทุกยอด", "ไม่มีประวัติโกง", "แจกสูตรเล่นฟรี"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ PODK888"
  titleright="ระบบและบริการของ PODK888 ที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์"
  label="เข้าสู่ระบบ PODK888 และระบบบริการที่ใช้ได้ทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#f670b7]/25 bg-[#12060f] p-6 shadow-[0_10px_30px_rgba(246,112,183,0.18)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#02dbfd]/25 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f670b7]/40 bg-gradient-to-br from-[#02dbfd] via-[#f670b7] to-[#e01e83] text-xl shadow-inner">
          🎮
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f670b7]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#d9a8c6]">บัญชีเดียวใช้เลือกสล็อต บาคาร่า และคาสิโนสดจากค่ายแท้ พร้อมฝากถอนออโต้ของ PODK888 ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f670b7]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#6a1446] bg-[#1a0a1f] py-3 pr-4 pl-12 text-[#f3d7e7] transition-all outline-none placeholder:text-[#d9a8c6]/70 focus:border-[#02dbfd] focus:ring-1 focus:ring-[#02dbfd]/45"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f670b7]">🔑</span>
          <input
            type="password"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#6a1446] bg-[#1a0a1f] py-3 pr-4 pl-12 text-[#f3d7e7] transition-all outline-none placeholder:text-[#d9a8c6]/70 focus:border-[#02dbfd] focus:ring-1 focus:ring-[#02dbfd]/45"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#d9a8c6]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#6a1446] bg-[#1a0a1f] accent-[#f670b7]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#d9a8c6] transition-colors hover:text-[#02dbfd]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#f670b7]/40 bg-gradient-to-r from-[#02dbfd] via-[#f670b7] to-[#f670b7] p-3.5 font-black text-[#12060f] shadow-[0_10px_30px_rgba(246,112,183,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(2,219,253,0.45)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#d9a8c6]">
          <span class="h-px flex-1 bg-[#6a1446]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#6a1446]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#f670b7]/30 bg-[#1a0a1f] px-2.5 py-1 text-[10px] font-bold text-[#f670b7]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#6a1446] bg-[#1a0a1f] px-2.5 py-1 text-[10px] font-bold text-[#d9a8c6]"><span aria-hidden="true">🕐</span> ระบบออโต้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#02dbfd] transition-colors hover:text-[#f670b7]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#f670b7]/25 bg-[#12060f] p-5 shadow-[0_10px_30px_rgba(246,112,183,0.18)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#d9a8c6]">ตารางอ้างอิงระบบและบริการที่รวมไว้ในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#02dbfd] via-[#f670b7] to-[#e01e83] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ออโต้ 24 ชม. • โอนไวปลอดภัยทุกยอด</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#0b2612] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#d9a8c6]">
        <span>ระบบ / บริการในเว็บ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#6a1446] bg-[#1a0a1f] px-3.5 py-2.5 transition-colors hover:border-[#f670b7]/50 hover:bg-[#2a0f2e]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f3d7e7]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#02dbfd]/35 bg-[#02dbfd] px-2.5 py-0.5 text-[10px] font-bold text-[#12060f]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#d9a8c6]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#f670b7]/30 bg-[#1a0a1f] px-3 py-1 text-[10px] font-bold text-[#f670b7]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#d9a8c6]">
        รายละเอียดทั้งหมดเป็นข้อมูลอ้างอิงสำหรับผู้เล่น ควรตรวจยอดขั้นต่ำ จำนวนเทิร์น เกมที่ร่วมรายการ และเพดานถอนจากหน้าโปรโมชั่นจริงของ PODK888 ก่อนกดรับทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
