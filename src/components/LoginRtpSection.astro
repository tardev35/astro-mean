---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Widget ไม่ใช่ article — ทุกหัวข้อในนี้เป็น <p>/<span> และชื่อสำหรับ assistive
// tech มาจาก prop `label` ที่ส่งให้ ContentBoxTwo ไม่มีการส่ง `title` บล็อกนี้จึง
// ไม่ปล่อยหัวข้อออกมาเลย ส่วนอิโมจิของป้ายคอลัมน์ใช้ค่า default ของ ContentBoxTwo
// (กุญแจ/เพชร) ซึ่งตรงกับแผงเข้าสู่ระบบและตารางสิทธิพิเศษอยู่แล้ว
//
// DEED888: ย้ายชุดสีของแบรนด์ก่อนออกทั้งหมด มาที่ส้มเพลิงคู่ทองหลอมที่วัดจากอาร์ต
// จริง — ส้ม #e95b0b / #ff9d4d / #fff4e8 / #93300a / #6b2205 คู่ทอง #f4940c /
// #ffcf6b บนผิว #150401 / #210702 / #2a0a02 เนื้อความ #fbe3d0 ข้อความรอง #d9b096
// เขียว LINE กับจุด live สีเขียว Tailwind เป็นสีเชิงความหมาย ไม่ถูกแตะ (ห้ามพิมพ์
// hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์
// ดูของเดิมได้จาก git history)
//
// เนื้อหาตาม brief ของแบรนด์นี้ ซึ่งเป็นสล็อตเกมแท้: เชื่อมต่อสัญญาณ API ตรงจาก
// สตูดิโอผู้พัฒนาระดับโลก ค่า RTP มาตรฐานยุติธรรมตามสเปกโรงงาน ไม่ผ่านเอเย่นต์
// ไม่ปรับแต่งเปอร์เซ็นต์แพ้ชนะ เกมระดับ A-List จาก PG Soft / Pragmatic Play /
// Joker Gaming เกมกระแสและตัวใหม่เติมต่อเนื่อง โปรฮิตจัดมาเป็นชุด (โบนัสสมทบทุน
// ฝากแรก, Cash Back รายวัน, เครดิตพิเศษเฉพาะช่วงเวลา) ถอนได้จริงไม่ติดล็อคยูส
// ฟีเจอร์ Multiplier Drops / Expanding Wilds / ซื้อฟรีสปิน ล็อบบี้อัปเดตพร้อม
// โหมดทดลองฟรี และฝากถอนออโต้ผ่าน Gateway ตรงที่เสร็จในไม่กี่วินาที
const menus = [
  {
    icon: "🛡️",
    name: "API ตรงจากสตูดิโอ ไม่ผ่านเอเย่นต์",
    detail: "เชื่อมต่อสัญญาณ API ตรงจากสตูดิโอผู้พัฒนาสล็อตระดับโลก ค่า RTP เป็นมาตรฐานยุติธรรมตามสเปกโรงงาน ไม่ผ่านเอเย่นต์ และไม่มีการปรับแต่งเปอร์เซ็นต์แพ้ชนะ",
    tag: "API ตรง",
  },
  {
    icon: "🎰",
    name: "เกมระดับ A-List จากค่ายยักษ์ใหญ่",
    detail: "กวาดเฉพาะเกมระดับ A-List จาก PG Soft, Pragmatic Play และ Joker Gaming คัดตัวที่โครงสร้างการจ่ายรางวัลโปร่งใส โบนัสแตกง่าย กราฟิกคมชัดลื่นไหลไม่มีสะดุด",
    tag: "A-List",
  },
  {
    icon: "🔄",
    name: "เกมกระแสและตัวใหม่เติมต่อเนื่อง",
    detail: "มีทั้งเกมกระแสติดอันดับชาร์ตและเกมนอกกระแสอัตราคูณโหด ระบบดึงสัญญาณเกมเข้าใหม่เข้ามาให้กดสปินทันที คลังเกมจึงไม่ตันและรองรับทุกกลยุทธ์การเดินเงิน",
    tag: "ไม่ตัน",
  },
  {
    icon: "🎁",
    name: "โปรฮิตจัดมาเป็นชุดให้เลือกรับ",
    detail: "ทั้งโบนัสสมทบทุนฝากแรก สิทธิ์คืนยอดเสีย Cash Back รายวัน และเครดิตพิเศษเฉพาะช่วงเวลา ทุกโปรกำหนดเงื่อนไขโปร่งใส ถอนได้จริง ไม่ติดล็อคยูส",
    tag: "เลือกตามจังหวะ",
  },
  {
    icon: "✨",
    name: "ฟีเจอร์ใหม่ที่เปลี่ยนฟีลการหมุน",
    detail: "ระบบสุ่มแจกตัวคูณทวีคูณ Multiplier Drops สัญลักษณ์ขยายเต็มรีล Expanding Wilds และโหมดซื้อฟรีสปินแบบทันใจ เปลี่ยนความซ้ำซากให้เป็นโอกาสคว้าแจ็คพอตก้อนโต",
    tag: "ลูกเล่นใหม่",
  },
  {
    icon: "🧭",
    name: "ล็อบบี้อัปเดตพร้อมโหมดทดลองฟรี",
    detail: "อัปเดตรายชื่อเกมใหม่และค่ายเกมมาแรงขึ้นแถวหน้าทันทีที่เปิดตัว เช็กอัตราการจ่าย อ่านกลไกของเกม และทดลองเล่นในโหมดทดลองฟรีได้ก่อนเลือกขึ้นสปิน",
    tag: "ทดลองฟรี",
  },
  {
    icon: "⏱️",
    name: "ฝากถอนออโต้ผ่าน Gateway ตรง",
    detail: "ทำรายการเสร็จสิ้นในไม่กี่วินาที ยอดเงินอัปเดตเข้าคลังเกมทันทีโดยไม่ต้องแนบสลิปและไม่ต้องรอคิวอนุมัติจากแอดมิน ตั้งแต่เติมทุนไปจนถึงถอนกำไรจึงลื่นไหลไร้รอยต่อ",
    tag: "ไม่กี่วินาที",
  },
];

const chips = ["API ตรงจากสตูดิโอ", "ไม่ผ่านเอเย่นต์", "RTP ตามสเปกโรงงาน", "ถอนได้จริง ไม่ล็อคยูส", "Multiplier Drops", "Expanding Wilds", "ซื้อฟรีสปิน", "ออโต้ไม่ต้องแนบสลิป"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ DEED888" titleright="ระบบและจุดเด่นของ DEED888 ที่รวมไว้ในบัญชีเดียว" label="เข้าสู่ระบบ DEED888 และตารางอ้างอิงระบบกับจุดเด่นภายในเว็บ">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#93300a]/35 bg-[#210702] p-6 shadow-[0_10px_30px_rgba(107,34,5,0.3)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#2a0a02]/90 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e95b0b]/45 bg-gradient-to-br from-[#fff4e8] via-[#e95b0b] to-[#6b2205] text-xl shadow-inner">
          👑
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fff4e8]">ยินดีต้อนรับกลับเข้าล็อบบี้ DEED888</p>
          <span class="text-[11px] text-[#d9b096]">
            กรอกเบอร์โทรศัพท์และรหัสผ่านที่ตั้งไว้ ก็เข้าเกมสล็อตเกมแท้ตัวท็อปที่ DEED888 คัดไว้ได้จากยูสเซอร์เดียว กระเป๋าเงินเดียวสลับค่ายได้อิสระโดยไม่ต้องโยกเงิน
            พร้อมระบบฝากถอนออโต้ผ่าน Gateway ตรงที่ทำรายการเสร็จในไม่กี่วินาที
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e95b0b]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#6b2205] bg-[#150401] py-3 pr-4 pl-12 text-[#fbe3d0] transition-all outline-none placeholder:text-[#d9b096] focus:border-[#e95b0b] focus:ring-1 focus:ring-[#e95b0b]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e95b0b]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#6b2205] bg-[#150401] py-3 pr-4 pl-12 text-[#fbe3d0] transition-all outline-none placeholder:text-[#d9b096] focus:border-[#e95b0b] focus:ring-1 focus:ring-[#e95b0b]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#d9b096]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#6b2205] bg-[#150401] accent-[#93300a]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#d9b096] transition-colors hover:text-[#ff9d4d]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#6b2205]/70 bg-gradient-to-r from-[#ffcf6b] via-[#f4940c] to-[#e95b0b] p-3.5 font-black text-[#150401] shadow-[0_10px_30px_rgba(233,91,11,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(233,91,11,0.45)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#d9b096]">
          <span class="h-px flex-1 bg-[#2a0a02]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#2a0a02]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#93300a]/40 bg-[#150401] px-2.5 py-1 text-[10px] font-bold text-[#ff9d4d]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#f4940c]/30 bg-[#150401] px-2.5 py-1 text-[10px] font-bold text-[#fff4e8]"><span aria-hidden="true">🕐</span> ออโต้ตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#fff4e8] transition-colors hover:text-[#ff9d4d]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#e95b0b]/30 bg-[#210702] p-5 shadow-[0_10px_30px_rgba(233,91,11,0.18)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#d9b096]">ตารางอ้างอิงระบบและจุดเด่นที่รวมไว้ในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#fff4e8] via-[#ffcf6b] to-[#e95b0b] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">
            สล็อตเกมแท้ตัวท็อป จัดโปรฮิตมาเป็นชุด ฟีเจอร์ใหม่น่าลอง
          </div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#150401] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#d9b096]">
        <span>ระบบ / จุดเด่นในเว็บ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#6b2205] bg-[#150401] px-3.5 py-2.5 transition-colors hover:border-[#e95b0b]/45 hover:bg-[#2a0a02]/90">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#fbe3d0]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#ffcf6b]/60 bg-[#f4940c] px-2.5 py-0.5 text-[10px] font-bold text-[#6b2205]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#d9b096]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#93300a]/40 bg-[#150401] px-3 py-1 text-[10px] font-bold text-[#ff9d4d]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#d9b096]">
        รายละเอียดทั้งหมดเป็นข้อมูลอ้างอิงสำหรับผู้เล่น ควรตรวจอัตราจ่ายของแต่ละเกม เงื่อนไขการรับสิทธิ์ และเพดานถอนจากหน้าโปรโมชั่นจริงของ DEED888 ก่อนกดรับทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
