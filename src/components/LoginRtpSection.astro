---
import ContentBoxTwo from "./ContentBoxTwoPremium.astro";

const menus = [
  { icon: "🎰", name: "รวมค่ายเกมชั้นนำระดับโลก", detail: "ดึงสัญญาณตรงผ่าน API ลิขสิทธิ์แท้ ไม่ผ่านคนกลาง ค่า RTP สูงตามมาตรฐานสากล", tag: "ครบจบในเว็บเดียว" },
  { icon: "⚡", name: "สมัครออโต้ด้วยตัวเองทั้งหมด", detail: "กรอกข้อมูลไม่กี่ช่อง ผูกเบอร์และบัญชีธนาคาร ใช้เวลาไม่ถึง 1 นาทีก็ได้ยูสเซอร์", tag: "ไม่ต้องทักแชท" },
  { icon: "🎁", name: "ทุนเล่นฟรี 199 บาททันที", detail: "รับทันทีที่สมัครเสร็จ นำไปหมุนสล็อตค่ายไหนเกมอะไรก็ได้บนเว็บของเรา", tag: "สมาชิกใหม่" },
  { icon: "🚫", name: "รับโบนัสโดยไม่ต้องกดแชร์", detail: "ไม่ต้องแคปรูปลงกลุ่ม ไม่ต้องส่งต่อให้เพื่อน แค่ยืนยันตัวตนผ่านระบบก็พอ", tag: "ไม่เสียความเป็นส่วนตัว" },
  { icon: "💸", name: "เทิร์นโอเวอร์ต่ำ ถอนได้ง่าย", detail: "ไม่ติดยอดเทิร์น 20-30 เท่าเหมือนที่อื่น เล่นถึงยอดที่กำหนดก็กดถอนได้เลย", tag: "ไม่อั้นยอดถอน" },
  { icon: "🖥️", name: "เซิร์ฟเวอร์รองรับหลักแสนคน", detail: "อัปเกรดระบบหลังบ้านด้วยเทคโนโลยีล่าสุด กดเบทได้แบบเรียลไทม์ไม่มีดีเลย์", tag: "ลื่นไหลไม่มีสะดุด" },
  { icon: "🔒", name: "เก็บข้อมูลสมาชิกเป็นความลับ", detail: "ข้อมูลที่กรอกตอนสมัครถูกเก็บเป็นความลับขั้นสุดยอด ปลอดภัยร้อยเปอร์เซ็นต์", tag: "ปลอดภัย 100%" },
];

const chips = ["เว็บสล็อตยอดนิยม", "API ลิขสิทธิ์แท้", "RTP สูงแตกง่าย", "ทุนเล่นฟรี 199", "ไม่ต้องแชร์", "เทิร์นต่ำถอนง่าย", "ลื่นไหลทุกอุปกรณ์"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ 9UFA"
  titleright="ระบบและบริการของ 9UFA ที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์"
  label="เข้าสู่ระบบ 9UFA และระบบบริการที่ใช้ได้ทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#0a5df1]/25 bg-[#eaf4fe] p-6 shadow-[0_10px_30px_rgba(10,93,241,0.15)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#01cbf6]/30 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#0a5df1]/40 bg-gradient-to-br from-[#01cbf6] via-[#0782f2] to-[#0a5df1] text-xl shadow-inner">
          ❄️
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#0743a8]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#3f6d99]">บัญชีเดียวใช้เลือกเกมสล็อตลิขสิทธิ์แท้ รับทุนเล่นฟรี และกดถอนออโต้ของ 9UFA ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#0a5df1]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#acddfb] bg-white py-3 pr-4 pl-12 text-[#0b3a63] transition-all outline-none placeholder:text-[#3f6d99]/70 focus:border-[#0a5df1] focus:ring-1 focus:ring-[#0a5df1]/45"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#0a5df1]">🔑</span>
          <input
            type="password"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#acddfb] bg-white py-3 pr-4 pl-12 text-[#0b3a63] transition-all outline-none placeholder:text-[#3f6d99]/70 focus:border-[#0a5df1] focus:ring-1 focus:ring-[#0a5df1]/45"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#3f6d99]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#acddfb] bg-white accent-[#0a5df1]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#3f6d99] transition-colors hover:text-[#0a5df1]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#0a5df1]/40 bg-gradient-to-r from-[#0a5df1] via-[#0782f2] to-[#01cbf6] p-3.5 font-black text-white shadow-[0_10px_30px_rgba(10,93,241,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(1,203,246,0.45)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#3f6d99]">
          <span class="h-px flex-1 bg-[#acddfb]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#acddfb]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#0a5df1]/30 bg-white px-2.5 py-1 text-[10px] font-bold text-[#0743a8]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#acddfb] bg-white px-2.5 py-1 text-[10px] font-bold text-[#3f6d99]"><span aria-hidden="true">🕐</span> ระบบออโต้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#0a5df1] transition-colors hover:text-[#0743a8]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#0a5df1]/25 bg-[#eaf4fe] p-5 shadow-[0_10px_30px_rgba(10,93,241,0.15)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#3f6d99]">ตารางอ้างอิงระบบและบริการที่รวมไว้ในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#0743a8] via-[#0a5df1] to-[#01cbf6] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ออโต้ 24 ชม. • ถอนไวจ่ายเต็มทุกบิล</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-600/40 bg-green-100 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-600 shadow-[0_0_8px_rgba(22,163,74,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-800 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#3f6d99]">
        <span>ระบบ / บริการในเว็บ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#acddfb] bg-white px-3.5 py-2.5 transition-colors hover:border-[#0a5df1]/50 hover:bg-[#dceafe]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#0b3a63]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#c9930a]/35 bg-[#ffe98a] px-2.5 py-0.5 text-[10px] font-bold text-[#062a52]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#3f6d99]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#0a5df1]/30 bg-white px-3 py-1 text-[10px] font-bold text-[#0743a8]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#3f6d99]">
        รายละเอียดทั้งหมดเป็นข้อมูลอ้างอิงสำหรับผู้เล่น ควรตรวจยอดขั้นต่ำ จำนวนเทิร์น เกมที่ร่วมรายการ และเพดานถอนจากหน้าโปรโมชั่นจริงของ 9UFA ก่อนกดรับทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
