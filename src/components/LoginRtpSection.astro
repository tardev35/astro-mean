---
import ContentBoxTwoPremium from "./ContentBoxTwoPremium.astro";

// Widget ไม่ใช่ article — ทุกหัวข้อในนี้เป็น <p>/<span> และชื่อสำหรับ assistive
// tech มาจาก prop `label` ที่ส่งให้ ContentBoxTwoPremium ไม่มีการส่ง `title`
// บล็อกนี้จึงไม่ปล่อยหัวข้อออกมาเลย
//
// LUCKYBKK: โครงสองคอลัมน์ย้ายจาก ContentBoxTwo (ตัวธรรมดา ซึ่ง AM88K ใช้อยู่)
// มาเป็น ContentBoxTwoPremium ตามการหมุน variant รอบนี้ และย้ายจากเขียวมิ้นต์
// คู่ทองของ AM88K มาที่น้ำเงินรอยัลคู่ทอง — น้ำเงิน #3f9dfb / #cfe8ff / #1f5fd0 /
// #0a2a86 คู่ทอง #f0b323 / #ffdf7e / #9a6c05 บนผิว #061442 / #030b28 ขอบ/แถบยก
// #0d2160 เนื้อความ #e4eeff หมึกบนปุ่มทอง #030b28 เขียว LINE #00B900 กับจุด live
// สีเขียวเป็นสีเชิงความหมาย ไม่ถูกแตะ (ค่า hex ของแบรนด์เก่าไม่พิมพ์ไว้ตรงนี้ —
// Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git
// history)
//
// เนื้อหาตาม brief ของแบรนด์นี้: เกมสดยิงตรงสัญญาณจากสตูดิโอชั้นนำระดับ HD
// ครบทั้งบาคาร่า รูเล็ต เสือมังกร ไฮโล ห้องเดิมพันหลายระดับตั้งแต่เบทเริ่มต้นถึง
// High Roller หน้าต่างสถิติย้อนหลัง ระบบตรงไม่ผ่านเอเย่นต์ที่ตรวจสอบได้จริง
// หลังบ้านเสถียรรองรับผู้ใช้งานพร้อมกันจำนวนมาก การเงินออโต้ที่ทำรายการเองได้
// และทีมแอดมินที่ดูแลตลอด 24 ชั่วโมง
const menus = [
  {
    icon: "📡",
    name: "เกมสดยิงตรงสัญญาณ คมชัดระดับ HD",
    detail: "ถ่ายทอดสดจากสตูดิโอชั้นนำด้วยความละเอียดสูง คมชัดทั้งภาพและเสียง ดำเนินเกมโดยดีลเลอร์มืออาชีพ ให้สัมผัสสมจริงเหมือนนั่งอยู่ในคาสิโนชั้นนำจริงๆ ตลอด 24 ชั่วโมง",
    tag: "เรียลไทม์",
  },
  {
    icon: "🃏",
    name: "ครบทั้งบาคาร่า รูเล็ต เสือมังกร และไฮโล",
    detail: "โต๊ะเดิมพันและค่ายเกมชั้นนำถูกคัดสรรมารวมไว้ในที่เดียว เลือกเกมที่ถนัดได้จากหน้าเดียวโดยไม่ต้องสลับยูสเซอร์หรือโยกเงินไปมาระหว่างค่าย",
    tag: "เกมสดครบ",
  },
  {
    icon: "💎",
    name: "ห้องเดิมพันหลายระดับ ถึงห้อง High Roller",
    detail: "มีห้องให้เลือกตั้งแต่เบทเริ่มต้นสบายๆ สำหรับคนที่เพิ่งเริ่ม ไปจนถึงห้องระดับ High Roller สำหรับสายลุยหนัก เลือกระดับเดิมพันให้พอดีกับทุนของตัวเองได้",
    tag: "เลือกได้ทุกทุน",
  },
  {
    icon: "📊",
    name: "หน้าต่างสถิติย้อนหลังที่อ่านง่ายชัดเจน",
    detail: "หน้าต่างการใช้งานถูกออกแบบมาให้แสดงผลข้อมูลและสถิติย้อนหลังได้อย่างชัดเจน ช่วยให้วางแผนเดิมพันได้ง่ายและแม่นยำยิ่งขึ้นในทุกรายละเอียด",
    tag: "วางแผนได้",
  },
  {
    icon: "🛡️",
    name: "ระบบตรงไม่ผ่านเอเย่นต์ ตรวจสอบได้จริง",
    detail: "ทุกขั้นตอนโปร่งใส ทั้งอัตราการจ่ายที่ได้มาตรฐานสากลและผลการเดิมพันที่ยุติธรรมตรงไปตรงมา ไร้การหมกเม็ด ไร้เงื่อนไขซับซ้อนให้ต้องตีความ",
    tag: "โปร่งใส",
  },
  {
    icon: "⚙️",
    name: "หลังบ้านเสถียร ไม่หน่วงไม่กระตุก",
    detail: "โครงสร้างหลังบ้านถูกปรับแต่งให้รองรับผู้เข้าใช้งานพร้อมกันจำนวนมาก สลับเปลี่ยนโต๊ะเดิมพันได้ฉับไว เข้าถึงทุกโหมดบริการได้ทันใจโดยไม่พลาดจังหวะสำคัญ",
    tag: "ลื่นไหลไร้รอยต่อ",
  },
  {
    icon: "💳",
    name: "ฝากถอนออโต้ ทำรายการเองได้ในไม่กี่ขั้นตอน",
    detail: "ยอดเงินอัปเดตไว โอนเข้าบัญชีโดยตรงอย่างแม่นยำ พร้อมหน้าต่างเช็กประวัติย้อนหลังที่เปิดดูได้ชัดเจน บริหารทุนและกำไรได้คล่องตัวโดยไม่ต้องผ่านขั้นตอนยุ่งยาก",
    tag: "การเงินคล่อง",
  },
];

const chips = ["คาสิโนอันดับต้น", "เกมสดคุณภาพ VIP", "ระบบตรงไว้ใจได้", "โต๊ะคัดมาครบ", "หลังบ้านเสถียร", "การเงินไม่ซับซ้อน", "ทีมบริการตลอดวัน"];
---

<ContentBoxTwoPremium
  titleleft="เข้าสู่ระบบ LUCKYBKK"
  titleright="ระบบและสิทธิพิเศษของ LUCKYBKK ที่รวมไว้ในบัญชีเดียว"
  label="เข้าสู่ระบบ LUCKYBKK และตารางอ้างอิงระบบกับสิทธิพิเศษภายในเว็บ">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#3f9dfb]/30 bg-[#061442] p-6 shadow-[0_10px_30px_rgba(63,157,251,0.22)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#0a2a86]/70 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f0b323]/45 bg-gradient-to-br from-[#ffdf7e] via-[#f0b323] to-[#9a6c05] text-xl shadow-inner">
          🃏
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffdf7e]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#e4eeff]/75">
            กรอกเบอร์โทรศัพท์และรหัสผ่านที่ตั้งไว้ ก็เข้าโต๊ะเกมสดของ LUCKYBKK ได้จากจุดเดียว พร้อมทำรายการฝากถอนผ่านระบบออโต้ได้ตลอด 24 ชั่วโมง
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#3f9dfb]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#0d2160] bg-[#030b28] py-3 pr-4 pl-12 text-[#e4eeff] transition-all outline-none placeholder:text-[#e4eeff]/55 focus:border-[#3f9dfb] focus:ring-1 focus:ring-[#3f9dfb]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#3f9dfb]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#0d2160] bg-[#030b28] py-3 pr-4 pl-12 text-[#e4eeff] transition-all outline-none placeholder:text-[#e4eeff]/55 focus:border-[#3f9dfb] focus:ring-1 focus:ring-[#3f9dfb]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#e4eeff]/80">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#0d2160] bg-[#030b28] accent-[#3f9dfb]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#e4eeff]/80 transition-colors hover:text-[#cfe8ff]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#9a6c05]/50 bg-gradient-to-r from-[#ffdf7e] via-[#f0b323] to-[#9a6c05] p-3.5 font-black text-[#030b28] shadow-[0_10px_30px_rgba(240,179,35,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(240,179,35,0.45)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#e4eeff]/70">
          <span class="h-px flex-1 bg-[#0d2160]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#0d2160]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#3f9dfb]/30 bg-[#030b28] px-2.5 py-1 text-[10px] font-bold text-[#cfe8ff]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#0d2160] bg-[#030b28] px-2.5 py-1 text-[10px] font-bold text-[#e4eeff]/80"><span aria-hidden="true">🕐</span> ทำรายการได้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#3f9dfb] transition-colors hover:text-[#f0b323]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#3f9dfb]/30 bg-[#061442] p-5 shadow-[0_10px_30px_rgba(63,157,251,0.22)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#e4eeff]/75">ตารางอ้างอิงระบบและสิทธิพิเศษที่รวมไว้ในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#f5f9ff] via-[#cfe8ff] to-[#f0b323] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">เกมสดคุณภาพ VIP ระบบตรงไว้ใจได้</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#030b28] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#e4eeff]/75">
        <span>ระบบ / สิทธิพิเศษในเว็บ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#0d2160] bg-[#030b28] px-3.5 py-2.5 transition-colors hover:border-[#3f9dfb]/55 hover:bg-[#0d2160]/80">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e4eeff]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#ffdf7e]/60 bg-[#f0b323] px-2.5 py-0.5 text-[10px] font-bold text-[#030b28]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#e4eeff]/75">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#3f9dfb]/30 bg-[#030b28] px-3 py-1 text-[10px] font-bold text-[#cfe8ff]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#e4eeff]/70">
        รายละเอียดทั้งหมดเป็นข้อมูลอ้างอิงสำหรับผู้เล่น ควรตรวจเดิมพันขั้นต่ำและสูงสุดของแต่ละโต๊ะ เงื่อนไขการรับสิทธิ์ และเพดานถอนจากหน้าโปรโมชั่นจริงของ LUCKYBKK ก่อนกดรับทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwoPremium>
