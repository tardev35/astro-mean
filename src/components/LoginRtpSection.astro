---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Widget ไม่ใช่ article — ทุกหัวข้อในนี้เป็น <p>/<span> และชื่อสำหรับ assistive
// tech มาจาก prop `label` ที่ส่งให้ ContentBoxTwo ไม่มีการส่ง `title` บล็อกนี้จึง
// ไม่ปล่อยหัวข้อออกมาเลย
//
// MAHAHENG333: ย้ายจากชมพูกลอสคู่ทองของ GALA89 (#ff4d9c / #d41c6b / #9e154a คู่ทอง
// #ffe0a3 / #f0c274 / #b8801f บนผิว #1f0311 / #12010a / #3c0214 เนื้อความ #f7dce8
// ข้อความรอง #f9a8cd) มาที่ทองมังกรจีนบนดำ — ทอง #ffe98a / #e8b923 / #a5760a คู่แดง
// #b4231c / #6d1410 บนผิว #221708 / #15100a / #0a0704 / #33230b เนื้อความ #f3e2b8
// ข้อความรอง #c2a469 เขียว LINE #00B900 กับจุด live สีเขียวเป็นสีเชิงความหมาย
// ไม่ถูกแตะ
//
// เนื้อหาตาม brief ของแบรนด์คาสิโนสด: ค่ายเกมสดชื่อดังในล็อบบี้เดียว, ถ่ายทอดสด
// ตรงจากคาสิโนจริงภาพ HD, ดีลเลอร์มืออาชีพ 24 ชม. ไม่มีโต๊ะเต็ม, เลือกห้องเองพร้อม
// สถิติย้อนหลังของแต่ละโต๊ะ, สลับโต๊ะคลิกเดียวไม่ต้องโยกเงิน, ฝากถอนออโต้จบใน 5
// วินาทีไม่ต้องส่งสลิป, ทีมงานดูแลตลอด 24 ชั่วโมง — ไม่มีคำว่าสล็อต/ฟรีสปิน
const menus = [
  { icon: "🎴", name: "โต๊ะบาคาร่าสดครบทุกห้อง", detail: "คัดค่ายเกมสดชื่อดังระดับโลกมารวมไว้ในล็อบบี้เดียว เข้าโต๊ะไหนก็ได้จากบัญชีเดียว", tag: "ค่ายดังครบ" },
  { icon: "🎡", name: "รูเล็ตและวงล้อลุ้นสด", detail: "มีทั้งโต๊ะสปีดเกมไวและโต๊ะบรรยากาศสบายๆ เลือกปรับให้เข้ากับสไตล์การเล่นได้ทันที", tag: "เลือกห้องเอง" },
  { icon: "🎥", name: "ถ่ายทอดสดจากคาสิโนจริง", detail: "สัญญาณคมชัดระดับ HD ไร้ดีเลย์ ได้ยินเสียงบรรยากาศในฟลอร์จริงเหมือนนั่งติดขอบโต๊ะ", tag: "ภาพ HD" },
  { icon: "🐉", name: "เสือมังกรและไฮโลพร้อมเปิด", detail: "อยากเปลี่ยนฟีลก็กดสลับห้องได้ในคลิกเดียว ไม่ต้องโยกเงินหรือออกจากระบบให้เสียจังหวะ", tag: "สลับโต๊ะไว" },
  { icon: "🎩", name: "ดีลเลอร์มืออาชีพ 24 ชั่วโมง", detail: "มีดีลเลอร์คอยเปิดไพ่และดูแลทุกโต๊ะตลอดเวลา เลือกที่นั่งได้เลยไม่มีคำว่าโต๊ะเต็ม", tag: "ไม่มีโต๊ะเต็ม" },
  { icon: "⚡", name: "ฝากถอนออโต้จบใน 5 วินาที", detail: "ทั้งเติมทุนลุยต่อและถอนกำไรก้อนโต ระบบเคลียร์ให้เสร็จภายใน 5 วิ ไม่ต้องส่งสลิปยืนยัน", tag: "ออโต้ 5 วิ" },
  { icon: "🔒", name: "ปลอดภัยทุกธุรกรรมการเงิน", detail: "ตั้งแต่สมัครสมาชิก เข้าสู่ระบบ ไปจนถึงกดถอน ผ่านการเข้ารหัสและตรวจสอบทุกขั้นตอน", tag: "ปลอดภัย" },
];

const chips = ["คาสิโนสดฟลอร์ใหญ่", "บาคาร่า–รูเล็ต", "เสือมังกร–ไฮโล", "เลือกห้องอิสระ", "สลับโต๊ะคลิกเดียว", "ฝากถอน 5 วิ", "ดูแล 24 ชั่วโมง"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ MAHAHENG333" titleright="ระบบและสิทธิพิเศษของ MAHAHENG333 ที่รวมไว้ในบัญชีเดียว" label="เข้าสู่ระบบ MAHAHENG333 และตารางอ้างอิงระบบกับสิทธิพิเศษภายในเว็บ">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#e8b923]/30 bg-[#221708] p-6 shadow-[0_10px_30px_rgba(232,185,35,0.22)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#b4231c]/45 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e8b923]/45 bg-gradient-to-br from-[#ffe98a] via-[#e8b923] to-[#a5760a] text-xl shadow-inner">
          🎴
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#e8b923]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#c2a469]">กรอกเบอร์โทรศัพท์และรหัสผ่านที่ตั้งไว้ ก็เข้าล็อบบี้โต๊ะคาสิโนสดทุกค่ายของ MAHAHENG333 ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e8b923]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#33230b] bg-[#0a0704] py-3 pr-4 pl-12 text-[#f3e2b8] transition-all outline-none placeholder:text-[#c2a469]/70 focus:border-[#e8b923] focus:ring-1 focus:ring-[#e8b923]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e8b923]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#33230b] bg-[#0a0704] py-3 pr-4 pl-12 text-[#f3e2b8] transition-all outline-none placeholder:text-[#c2a469]/70 focus:border-[#e8b923] focus:ring-1 focus:ring-[#e8b923]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#c2a469]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#33230b] bg-[#0a0704] accent-[#e8b923]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#c2a469] transition-colors hover:text-[#e8b923]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#a5760a]/50 bg-gradient-to-r from-[#ffe98a] via-[#e8b923] to-[#a5760a] p-3.5 font-black text-[#0a0704] shadow-[0_10px_30px_rgba(232,185,35,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(232,185,35,0.45)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#c2a469]">
          <span class="h-px flex-1 bg-[#33230b]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#33230b]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#e8b923]/30 bg-[#0a0704] px-2.5 py-1 text-[10px] font-bold text-[#e8b923]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#33230b] bg-[#0a0704] px-2.5 py-1 text-[10px] font-bold text-[#c2a469]"><span aria-hidden="true">🕐</span> ทำรายการได้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ffe98a] transition-colors hover:text-[#e8b923]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#e8b923]/30 bg-[#221708] p-5 shadow-[0_10px_30px_rgba(232,185,35,0.22)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#c2a469]">ตารางอ้างอิงระบบและสิทธิพิเศษที่รวมไว้ในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#ffe98a] via-[#e8b923] to-[#a5760a] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">เปิดโต๊ะมหาเฮง ฝากถอน 5 วิ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#0a0704] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#c2a469]">
        <span>ระบบ / สิทธิพิเศษในเว็บ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#33230b] bg-[#0a0704] px-3.5 py-2.5 transition-colors hover:border-[#e8b923]/55 hover:bg-[#33230b]/70">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f3e2b8]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#a5760a]/60 bg-[#e8b923] px-2.5 py-0.5 text-[10px] font-bold text-[#0a0704]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#c2a469]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#e8b923]/30 bg-[#0a0704] px-3 py-1 text-[10px] font-bold text-[#e8b923]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#9a8253]">
        รายละเอียดทั้งหมดเป็นข้อมูลอ้างอิงสำหรับผู้เล่น ควรตรวจเดิมพันขั้นต่ำและสูงสุดของแต่ละโต๊ะ เงื่อนไขการรับสิทธิ์ และเพดานถอนจากหน้าโปรโมชั่นจริงของ MAHAHENG333 ก่อนกดรับทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
