---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Widget ไม่ใช่ article — ทุกหัวข้อในนี้เป็น <p>/<span> และชื่อสำหรับ assistive
// tech มาจาก prop `label` ที่ส่งให้ ContentBoxTwo ไม่มีการส่ง `title` บล็อกนี้จึง
// ไม่ปล่อยหัวข้อออกมาเลย
//
// กงล้อ88: ย้ายจากทองบนม่วงพลัมของ TANGTEM168 (#ffe9a8 / #fcc30b / #e09a05 /
// #ce5a03 คู่ม่วง #c79bf0 / #7e3ac7 / #3c0f52 บนผิว #2a0a2e / #1c0620 เนื้อความ
// #f7e6c4 ข้อความรอง #c3a98e) มาที่ทองอร่ามคู่เปลวไฟ — #ffe974 / #ffcc4b /
// #eb9a1d / #8b4c0b คู่เปลวไฟ #ff6a13 / #ffa34d บนผิว #1e1105 / #140a02 /
// #2c1808 เนื้อความ #f6e6c2 ข้อความรอง #c9ab7a เขียว LINE #00B900 กับจุด live
// สีเขียวเป็นสีเชิงความหมาย ไม่ถูกแตะ
//
// เนื้อหาตาม brief: เว็บแท้ไม่ผ่านเอเย่นต์ไม่ล็อคยูสไม่ปรับลด RTP, โปร่งใส 100%
// ไม่หักเปอร์เซ็นต์ย้อนหลัง, ฟีเจอร์เสี่ยงทายลุ้นรางวัลใหญ่ทุกวัน, ฝากถอนออโต้
// ทำเองได้ไม่ต้องส่งสลิป, รองรับทุกธนาคารและทรูวอเลท, เกมครบทุกค่ายดัง,
// ฐานการเงินมั่นคงจ่ายเต็มถอนไม่อั้น
const menus = [
  { icon: "🐉", name: "เว็บแท้ไม่ผ่านเอเย่นต์", detail: "ไม่มีการล็อคยูสหรือปรับลดอัตราการชนะ ทุกเกมที่เข้าเล่นได้ค่า RTP ตามจริง", tag: "เว็บตรง" },
  { icon: "🎡", name: "หมุนกงล้อลุ้นรางวัลได้ทุกวัน", detail: "แค่ล็อกอินเข้ามาร่วมสนุกกับเกมโปรด ก็มีสิทธิ์ลุ้นรับรางวัลใหญ่จากกิจกรรมเสี่ยงทาย", tag: "ลุ้นทุกวัน" },
  { icon: "💠", name: "โปร่งใส 100% ไม่หักย้อนหลัง", detail: "เล่นได้เท่าไหร่รับกำไรไปเต็มๆ ไม่มีการหักเปอร์เซ็นต์ย้อนหลังทีหลัง", tag: "รับเต็ม" },
  { icon: "⚡", name: "ฝากถอนออโต้เต็มรูปแบบ", detail: "ทำรายการเองผ่านหน้าเว็บ ไม่ต้องทักแอดมินหรือส่งสลิป เงินเข้าไวในไม่กี่วินาที", tag: "ออโต้" },
  { icon: "🏦", name: "รองรับทุกธนาคารและทรูวอเลท", detail: "เลือกช่องทางที่ถนัดได้เลย ลุยต่อยอดกำไรได้แบบไม่มีสะดุดตลอดทั้งวัน", tag: "ครบทุกช่องทาง" },
  { icon: "🎰", name: "เกมครบทุกค่ายดังในที่เดียว", detail: "PG Slot, Joker Gaming, Pragmatic Play และค่ายระดับโลกอีกเพียบ ภาพคมไม่กระตุก", tag: "ทุกค่าย" },
  { icon: "🔥", name: "จ่ายเต็มถอนไม่อั้นทุกยอด", detail: "ฐานการเงินมั่นคงระดับเอเชีย ไม่มีเงื่อนไขจุกจิก ไม่อั้นถอนและไม่แบ่งจ่าย", tag: "จ่ายจริง" },
];

const chips = ["สล็อตเว็บตรงแตกหนัก", "ไม่ล็อคยูส", "หมุนกงล้อพารวย", "แจ็คพอตแตกทุกวัน", "ฝากถอนออโต้", "รองรับทรูวอเลท", "ถอนไม่อั้น"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ กงล้อ88" titleright="ระบบและสิทธิพิเศษของ กงล้อ88 ที่รวมไว้ในบัญชีเดียว" label="เข้าสู่ระบบ กงล้อ88 และตารางอ้างอิงระบบกับสิทธิพิเศษภายในเว็บ">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#ffcc4b]/30 bg-[#1e1105] p-6 shadow-[0_10px_30px_rgba(255,204,75,0.22)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#ff6a13]/45 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ffcc4b]/45 bg-gradient-to-br from-[#ffe974] via-[#ffcc4b] to-[#eb9a1d] text-xl shadow-inner">
          🎡
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffcc4b]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#c9ab7a]">กรอกเบอร์โทรศัพท์และรหัสผ่านที่ตั้งไว้ ก็เข้าล็อบบี้เกมสล็อตทุกค่ายดังของ กงล้อ88 ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ffcc4b]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#2c1808] bg-[#140a02] py-3 pr-4 pl-12 text-[#f6e6c2] transition-all outline-none placeholder:text-[#c9ab7a]/70 focus:border-[#ffcc4b] focus:ring-1 focus:ring-[#ff6a13]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ffcc4b]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#2c1808] bg-[#140a02] py-3 pr-4 pl-12 text-[#f6e6c2] transition-all outline-none placeholder:text-[#c9ab7a]/70 focus:border-[#ffcc4b] focus:ring-1 focus:ring-[#ff6a13]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#c9ab7a]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#2c1808] bg-[#140a02] accent-[#ffcc4b]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#c9ab7a] transition-colors hover:text-[#ffcc4b]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#eb9a1d]/50 bg-gradient-to-r from-[#ffe974] via-[#ffcc4b] to-[#eb9a1d] p-3.5 font-black text-[#140a02] shadow-[0_10px_30px_rgba(255,204,75,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(255,106,19,0.45)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#c9ab7a]">
          <span class="h-px flex-1 bg-[#2c1808]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#2c1808]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#ffcc4b]/30 bg-[#140a02] px-2.5 py-1 text-[10px] font-bold text-[#ffcc4b]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#2c1808] bg-[#140a02] px-2.5 py-1 text-[10px] font-bold text-[#c9ab7a]"><span aria-hidden="true">🕐</span> ทำรายการได้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ffa34d] transition-colors hover:text-[#ffcc4b]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#ffcc4b]/30 bg-[#1e1105] p-5 shadow-[0_10px_30px_rgba(255,204,75,0.22)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#c9ab7a]">ตารางอ้างอิงระบบและสิทธิพิเศษที่รวมไว้ในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#ffe974] via-[#ffcc4b] to-[#ff6a13] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">เว็บตรงแตกหนัก จ่ายเต็มทุกยอด</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#140a02] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#c9ab7a]">
        <span>ระบบ / สิทธิพิเศษในเว็บ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#2c1808] bg-[#140a02] px-3.5 py-2.5 transition-colors hover:border-[#ffcc4b]/55 hover:bg-[#2c1808]/70">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f6e6c2]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#eb9a1d]/60 bg-[#ffcc4b] px-2.5 py-0.5 text-[10px] font-bold text-[#140a02]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#c9ab7a]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#ffcc4b]/30 bg-[#140a02] px-3 py-1 text-[10px] font-bold text-[#ffcc4b]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#c9ab7a]">
        รายละเอียดทั้งหมดเป็นข้อมูลอ้างอิงสำหรับผู้เล่น ควรตรวจยอดขั้นต่ำ จำนวนเทิร์น เกมที่ร่วมรายการ และเพดานถอนจากหน้าโปรโมชั่นจริงของ กงล้อ88 ก่อนกดรับทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
