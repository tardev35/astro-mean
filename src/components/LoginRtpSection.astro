---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Widget, not article — every title in here is a <p>/<span>, and the section's
// accessible name comes from the `label` prop passed to ContentBoxTwo. No
// `title` is passed, so this block emits no heading at all.
//
// JUDTEM168: rethemed off the previous brand's blue (#3b8df1 / #0a1330 /
// #050b1e / #dbe7fb / #a8bcd8) onto gold — #feeb33 / #fac42c / #e4a434 /
// #cc8425 / #7a4a0d over #150d04 / #1e1206 / #0a0602, body #f3e3c4, muted
// #d8c49a, ink-on-gold #1a1003.
//
// Copy follows the docx brief: ทางเข้าที่เสถียรที่สุด, จ่ายจริงทุกยอด,
// ฝากถอนออโต้ไม่มีขั้นต่ำ, ถอนได้ไม่อั้น, ไม่ล็อคยูสเซอร์, วิธีเข้าสู่ระบบ.
const menus = [
  { icon: "🔗", name: "เซิร์ฟเวอร์หลักและลิงก์สำรอง", detail: "พร้อมใช้งานตลอด 24 ชั่วโมง หมดปัญหาเว็บปลิว ลิงก์เสีย หรือเข้าไม่ได้ช่วงโบนัสไทม์", tag: "เข้าได้ตลอด" },
  { icon: "📱", name: "รองรับ iOS Android และคอมพิวเตอร์", detail: "กดเข้าเกมได้ลื่นไหลไม่มีสะดุด ภาพและเสียงคมชัดระดับ Full HD ทุกอุปกรณ์", tag: "ลื่นทุกเครื่อง" },
  { icon: "🎰", name: "เกมลิขสิทธิ์แท้จากค่ายดังโดยตรง", detail: "อัตราการชนะ (RTP) สูงกว่าเว็บทั่วไป ระบบสุ่มรางวัลยุติธรรมตามมาตรฐานสากล", tag: "เว็บตรง API แท้" },
  { icon: "⚡", name: "ฝากถอนออโต้ด้วยตัวเอง", detail: "ใช้เทคโนโลยี AI จัดการทั้งหมด ประมวลผลไม่เกิน 3 วินาที ไม่ต้องส่งสลิปรอคิว", tag: "ไม่เกิน 3 วิ" },
  { icon: "🪙", name: "ไม่มีขั้นต่ำ ทุนน้อยแค่ 1 บาท", detail: "ฝากเข้ามาปั่นสล็อตได้สบายๆ เปิดโอกาสให้ทุกคนเข้าถึงความรวยได้เท่าเทียมกัน", tag: "เริ่ม 1 บาท" },
  { icon: "🏦", name: "ถอนได้ไม่อั้น ไม่จำกัดจำนวนครั้ง", detail: "เล่นได้เท่าไหร่ถอนออกไปใช้ได้ทันที จ่ายเต็มจำนวน ไม่หักเปอร์เซ็นต์หรือค่าธรรมเนียม", tag: "จ่ายเต็มยอด" },
  { icon: "🔒", name: "ความปลอดภัยเทียบเท่าแอปธนาคาร", detail: "ฐานการเงินแข็งแกร่ง รองรับสมาชิกนับแสนคนต่อวัน ข้อมูลส่วนตัวไม่มีรั่วไหล", tag: "มั่นคง 100%" },
];

const chips = ["ทางเข้าเสถียรที่สุด", "จ่ายจริงทุกยอด", "ฝากถอนออโต้ไม่มีขั้นต่ำ", "ถอนได้ไม่อั้น", "ไม่ล็อคยูสเซอร์", "เว็บตรง API แท้", "บริการ 24 ชั่วโมง"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ JUDTEM168"
  titleright="ระบบและบริการของ JUDTEM168 ที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์"
  label="เข้าสู่ระบบ JUDTEM168 และระบบบริการที่ใช้ได้ทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#e4a434]/25 bg-[#1e1206] p-6 shadow-[0_10px_30px_rgba(250,196,44,0.18)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#fac42c]/25 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e4a434]/45 bg-gradient-to-br from-[#feeb33] via-[#fac42c] to-[#7a4a0d] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fac42c]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#d8c49a]">กรอกเบอร์โทรศัพท์และรหัสผ่านที่ตั้งไว้ ก็เข้าสู่หน้าล็อบบี้เกมสล็อตค่ายโปรดของ JUDTEM168 ได้ทันทีจากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#fac42c]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#7a4a0d] bg-[#0a0602] py-3 pr-4 pl-12 text-[#f3e3c4] transition-all outline-none placeholder:text-[#d8c49a]/70 focus:border-[#feeb33] focus:ring-1 focus:ring-[#fac42c]/45"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#fac42c]">🔑</span>
          <input
            type="password"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#7a4a0d] bg-[#0a0602] py-3 pr-4 pl-12 text-[#f3e3c4] transition-all outline-none placeholder:text-[#d8c49a]/70 focus:border-[#feeb33] focus:ring-1 focus:ring-[#fac42c]/45"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#d8c49a]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#7a4a0d] bg-[#0a0602] accent-[#fac42c]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#d8c49a] transition-colors hover:text-[#feeb33]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#e4a434]/45 bg-gradient-to-r from-[#feeb33] via-[#fac42c] to-[#cc8425] p-3.5 font-black text-[#1a1003] shadow-[0_10px_30px_rgba(250,196,44,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(254,235,51,0.45)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#d8c49a]">
          <span class="h-px flex-1 bg-[#7a4a0d]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#7a4a0d]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#e4a434]/30 bg-[#0a0602] px-2.5 py-1 text-[10px] font-bold text-[#fac42c]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#7a4a0d] bg-[#0a0602] px-2.5 py-1 text-[10px] font-bold text-[#d8c49a]"><span aria-hidden="true">🕐</span> ระบบออโต้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#feeb33] transition-colors hover:text-[#e4a434]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#e4a434]/25 bg-[#1e1206] p-5 shadow-[0_10px_30px_rgba(250,196,44,0.18)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#d8c49a]">ตารางอ้างอิงระบบและบริการที่รวมไว้ในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#feeb33] via-[#fac42c] to-[#cc8425] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ออโต้ไม่เกิน 3 วิ • ถอนไม่อั้น 24 ชม.</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#0b2612] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#d8c49a]">
        <span>ระบบ / บริการในเว็บ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#7a4a0d] bg-[#0a0602] px-3.5 py-2.5 transition-colors hover:border-[#e4a434]/55 hover:bg-[#3d2205]/60">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f3e3c4]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#cc8425]/40 bg-[#fac42c] px-2.5 py-0.5 text-[10px] font-bold text-[#1a1003]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#d8c49a]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#e4a434]/30 bg-[#0a0602] px-3 py-1 text-[10px] font-bold text-[#fac42c]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#d8c49a]">
        รายละเอียดทั้งหมดเป็นข้อมูลอ้างอิงสำหรับผู้เล่น ควรตรวจยอดขั้นต่ำ จำนวนเทิร์น เกมที่ร่วมรายการ และเพดานถอนจากหน้าโปรโมชั่นจริงของ JUDTEM168 ก่อนกดรับทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
