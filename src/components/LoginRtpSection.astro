---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Widget ไม่ใช่ article — ทุกหัวข้อในนี้เป็น <p>/<span> และชื่อสำหรับ assistive
// tech มาจาก prop `label` ที่ส่งให้ ContentBoxTwo ไม่มีการส่ง `title` บล็อกนี้จึง
// ไม่ปล่อยหัวข้อออกมาเลย ส่วนอิโมจิของป้ายคอลัมน์ใช้ค่า default ของ ContentBoxTwo
// (กุญแจ/เพชร) ซึ่งตรงกับแผงเข้าสู่ระบบและตารางสิทธิพิเศษอยู่แล้ว
//
// TITANWIN168: ย้ายชุดสีของแบรนด์ก่อนออกทั้งหมด มาที่ม่วงไททันคู่มงกุฎทองที่วัดจาก
// อาร์ตจริง ทองรับป้ายและเส้นคั่นฝั่งตารางเพื่อให้สีรองมีที่ยืนจริง เขียว LINE
// กับจุด live สีเขียว Tailwind เป็นสีเชิงความหมาย ไม่ถูกแตะ (ห้ามพิมพ์ hex ของ
// แบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของ
// เดิมได้จาก git history)
//
// เนื้อหาตาม brief ของแบรนด์นี้: เว็บตรง API แท้ ยิงสัญญาณตรงจากเซิร์ฟเวอร์หลัก
// ไม่ผ่านเอเย่นต์ RTP ยุติธรรมตรงสเปกโรงงาน ไม่มีล็อกยูส ถอนเต็มจำนวน คลังเกม
// คัดเกรดที่ไม่เอาเกมอัตราจ่ายต่ำมาเปิด ค่ายชั้นนำ PG Soft / Pragmatic Play /
// Joker Gaming ครบทั้งสล็อต 3D และสตรีตสไตล์ กระเป๋าเดียวไม่ต้องโยกเงิน โบนัส
// ต้อนรับ โปรฝากแรกของวัน Cash Back คืนยอดเสีย ไม่ติดเทิร์นโอเวอร์ ฟีเจอร์
// Multipliers / Cascading / รีลขยาย Wild / Buy Feature และออโต้ทันใจไว 3 วิ
// ผ่าน Gateway ตรง
const menus = [
  {
    icon: "🛡️",
    name: "เว็บตรง API แท้ ไม่ผ่านเอเย่นต์",
    detail: "ยิงสัญญาณตรงจากเซิร์ฟเวอร์หลัก อัตราจ่าย RTP ยุติธรรมตรงตามสเปกโรงงาน ไร้ประวัติการล็อกยูส ถอนเงินออกได้เต็มจำนวนทุกยอดโดยไม่มีเงื่อนไขยุ่งยาก",
    tag: "API แท้",
  },
  {
    icon: "💎",
    name: "คลังเกมคัดเกรดคุณภาพสูงครบครัน",
    detail: "ไม่เอาเกมระบบล้าหลังหรืออัตราจ่ายต่ำมาเปิดให้บริการ ทุกเกมผ่านการคัดกรองระบบหลังบ้านว่าสปินสนุก กราฟิกคมชัด จ่ายรางวัลตามอัลกอริทึมมาตรฐานสากล",
    tag: "เกมคัดเกรด",
  },
  {
    icon: "🎰",
    name: "ค่ายชั้นนำระดับโลกยกตัวเด่นมาชน",
    detail: "ทั้ง PG Soft, Pragmatic Play, Joker Gaming และค่ายชั้นนำอีกมากมาย ครบทุกสไตล์ทั้งสล็อตภาพสวย 3D และสตรีตสไตล์เน้นคูณหนัก",
    tag: "หลายแนวให้เลือก",
  },
  {
    icon: "👛",
    name: "กระเป๋าเดียวสลับเล่นได้อิสระ",
    detail: "อยากย้ายไปปั่นค่ายไหนก็กดเปลี่ยนได้ทันที ไม่ต้องโยกเงินไปมาระหว่างค่ายให้เสียจังหวะการเล่น",
    tag: "ไม่ต้องโยกเงิน",
  },
  {
    icon: "🎁",
    name: "โปรโมชั่นใหม่พร้อมชนทุกช่วงเวลา",
    detail: "ทั้งโบนัสต้อนรับสมาชิกใหม่ โปรฝากแรกของวัน และสิทธิ์รับเครดิตคืนยอดเสีย Cash Back เงื่อนไขโปร่งใส ไม่ติดเทิร์นโอเวอร์มหาโหด กดรับเองได้ทันที",
    tag: "Cash Back",
  },
  {
    icon: "💥",
    name: "ฟีเจอร์ในเกมจัดมาให้ครบมือ",
    detail: "ทั้ง Multipliers ตัวคูณสะสมแบบทวีคูณ ระบบ Cascading สัญลักษณ์แตกต่อเนื่อง รีลขยาย Wild ซ้อนทับ ไปจนถึงโหมด Buy Feature ซื้อฟรีสปินเข้าลุ้นโบนัสก้อนใหญ่",
    tag: "Buy Feature",
  },
  {
    icon: "⚡",
    name: "ฝากถอนออโต้ทันใจไว 3 วิ",
    detail: "ประมวลผลผ่าน Gateway ตรง ฝากเงินปุ๊บยอดเข้าเกมปั๊บ ถอนกำไรเด้งเข้าบัญชีธนาคารหรือวอลเล็ททันที ไม่ต้องส่งสลิป ไม่ต้องรอคิวอนุมัติ",
    tag: "3 วินาที",
  },
];

const chips = ["เว็บตรง API แท้", "ไม่ผ่านเอเย่นต์", "RTP ตรงสเปกโรงงาน", "ไม่มีล็อกยูส", "เกมคัดเกรด", "Cash Back คืนยอดเสีย", "ออโต้ทันใจไว 3 วิ", "กระเป๋าเดียวไม่ต้องโยกเงิน"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ TITANWIN168" titleright="ระบบและสิทธิพิเศษของ TITANWIN168 ที่รวมไว้ในบัญชีเดียว" label="เข้าสู่ระบบ TITANWIN168 และตารางอ้างอิงระบบกับสิทธิพิเศษภายในเว็บ">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#6d28d9]/35 bg-[#22104a] p-6 shadow-[0_10px_30px_rgba(109,40,217,0.28)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#2e1065]/80 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#a855f7]/45 bg-gradient-to-br from-[#ede4ff] via-[#a855f7] to-[#3b0d73] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ede4ff]">ยินดีต้อนรับกลับเข้าล็อบบี้</p>
          <span class="text-[11px] text-[#a396c9]">
            กรอกเบอร์โทรศัพท์และรหัสผ่านที่ตั้งไว้ ก็เข้าคลังเกมคัดเกรดที่ TITANWIN168 รวมมาจากค่ายชั้นนำได้จากยูสเซอร์เดียว กระเป๋าเดียวสลับเล่นได้อิสระโดยไม่ต้องโยกเงิน พร้อมระบบฝากถอนออโต้ทันใจไว 3
            วิ ผ่าน Gateway ตรง
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a855f7]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#2e1065] bg-[#0a0417] py-3 pr-4 pl-12 text-[#ddd2f5] transition-all outline-none placeholder:text-[#8a7cb5] focus:border-[#a855f7] focus:ring-1 focus:ring-[#a855f7]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a855f7]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#2e1065] bg-[#0a0417] py-3 pr-4 pl-12 text-[#ddd2f5] transition-all outline-none placeholder:text-[#8a7cb5] focus:border-[#a855f7] focus:ring-1 focus:ring-[#a855f7]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#a396c9]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#2e1065] bg-[#0a0417] accent-[#7c3aed]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#a396c9] transition-colors hover:text-[#a855f7]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#3b0d73]/60 bg-gradient-to-r from-[#ede4ff] via-[#a855f7] to-[#6d28d9] p-3.5 font-black text-[#0a0417] shadow-[0_10px_30px_rgba(168,85,247,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(227,193,118,0.35)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#a396c9]">
          <span class="h-px flex-1 bg-[#2e1065]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#2e1065]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#6d28d9]/40 bg-[#0a0417] px-2.5 py-1 text-[10px] font-bold text-[#a855f7]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#e3c176]/30 bg-[#0a0417] px-2.5 py-1 text-[10px] font-bold text-[#f2dda3]"><span aria-hidden="true">🕐</span> ออโต้ตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ede4ff] transition-colors hover:text-[#a855f7]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#e3c176]/30 bg-[#22104a] p-5 shadow-[0_10px_30px_rgba(227,193,118,0.18)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#8a7cb5]">ตารางอ้างอิงระบบและสิทธิพิเศษที่รวมไว้ในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#ede4ff] via-[#f2dda3] to-[#a855f7] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">สล็อตรวมทัพเกมดัง เกมคัดเกรด ระบบออโต้ทันใจไว 3 วิ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#0a0417] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#8a7cb5]">
        <span>ระบบ / สิทธิพิเศษในเว็บ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#2e1065] bg-[#0a0417] px-3.5 py-2.5 transition-colors hover:border-[#e3c176]/45 hover:bg-[#2e1065]/80">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#ddd2f5]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#dfe4f0]/60 bg-[#f2dda3] px-2.5 py-0.5 text-[10px] font-bold text-[#0a0417]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#a396c9]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#6d28d9]/40 bg-[#0a0417] px-3 py-1 text-[10px] font-bold text-[#a855f7]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#8a7cb5]">
        รายละเอียดทั้งหมดเป็นข้อมูลอ้างอิงสำหรับผู้เล่น ควรตรวจอัตราการจ่ายและรายละเอียดฟีเจอร์ของแต่ละเกม เงื่อนไขการรับสิทธิ์ และเพดานถอนจากหน้าโปรโมชั่นจริงของ TITANWIN168 ก่อนกดรับทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
