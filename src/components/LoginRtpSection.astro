---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Widget ไม่ใช่ article — ทุกหัวข้อในนี้เป็น <p>/<span> และชื่อสำหรับ assistive
// tech มาจาก prop `label` ที่ส่งให้ ContentBoxTwo ไม่มีการส่ง `title` บล็อกนี้จึง
// ไม่ปล่อยหัวข้อออกมาเลย ส่วนอิโมจิของป้ายคอลัมน์ใช้ค่า default ของ ContentBoxTwo
// (กุญแจ/เพชร) ซึ่งตรงกับแผงเข้าสู่ระบบและตารางสิทธิพิเศษอยู่แล้ว
//
// AURA456: ย้ายชุดสีของแบรนด์ก่อนออกทั้งหมด มาที่นีออนบานเย็นคู่ฟ้าอิเล็กทริกที่วัด
// จากอาร์ตจริง ฟ้ารับป้ายและเส้นคั่นฝั่งตารางเพื่อให้สีรองมีที่ยืนจริง เขียว LINE
// กับจุด live สีเขียว Tailwind เป็นสีเชิงความหมาย ไม่ถูกแตะ (ห้ามพิมพ์ hex ของ
// แบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของ
// เดิมได้จาก git history)
//
// เนื้อหาตาม brief ของแบรนด์นี้: เว็บตรงสล็อตคัดเกรด รันบนเซิร์ฟเวอร์หลัก API แท้
// 100% ค่า RTP โปร่งใส ไม่ดัดแปลงหลังบ้าน โครงสร้างเว็บตอบสนองฉับไว ไร้ป๊อปอัป
// โฆษณา กราฟิก 3D ลื่นไม่กระตุก เกมลิขสิทธิ์แท้จาก PG Soft / Pragmatic Play /
// Joker เบทเริ่ม 1 บาท หมวด "เกมฮิตกระแสแรง" ขึ้นหน้าแรก กลไก Cascading /
// Multiplier / Wild ยืดขยาย / Bonus Buy โบนัสต้อนรับ โปรฝากแรกของวัน Cash Back
// ไม่ติดเทิร์นโอเวอร์ กระเป๋าเดียวสลับค่ายได้ และฝากถอนออโต้ 100% ใน 3-5 วินาที
const menus = [
  {
    icon: "🛡️",
    name: "เว็บตรงสล็อตคัดเกรด API แท้ 100%",
    detail: "รันบนเซิร์ฟเวอร์หลัก ค่า RTP โปร่งใส ไม่มีการดัดแปลงระบบหลังบ้าน สล็อตแตกง่าย ปั่นง่าย ทำกำไรคล่อง ไร้เงื่อนไขจุกจิก",
    tag: "API แท้ 100%",
  },
  {
    icon: "🚀",
    name: "ระบบแรง ตอบสนองฉับไวตั้งแต่คลิกแรก",
    detail: "อินเทอร์เฟซสะอาดตา ไร้ป๊อปอัปโฆษณากวนใจ โหลดตัวเกมและกราฟิก 3D ลื่นไหลไม่มีกระตุก แม้ช่วงพีคที่มีผู้เล่นหนาแน่นก็ไม่เด้งหลุด",
    tag: "โหลดไม่สะดุด",
  },
  {
    icon: "🎰",
    name: "เกมลิขสิทธิ์แท้จากค่ายยักษ์ใหญ่ทั่วโลก",
    detail: "ทั้ง PG Soft, Pragmatic Play, Joker และอีกมากมาย คัดเน้นๆ เฉพาะเกมที่มีอัตราจ่ายรางวัลเป็นธรรม จ่ายเงินจริงตามระบบอัลกอริทึมโรงงาน",
    tag: "เบทเริ่ม 1 บาท",
  },
  {
    icon: "🔥",
    name: "หมวดเกมฮิตกระแสแรงขึ้นโชว์หน้าแรก",
    detail: "ล็อบบี้จัดระเบียบไว้ให้ใช้งานง่าย ค่ายดังเปิดตัวเกมไหนหรือคนกำลังฮิตปั่นเกมอะไร ดึงมาเสิร์ฟถึงหน้าแรกให้ทันที",
    tag: "ไม่ต้องเลื่อนหา",
  },
  {
    icon: "💥",
    name: "กลไกทำเงินยุคใหม่ครบทุกแบบ",
    detail: "ทั้งระบบ Cascading คอมโบสัญลักษณ์แตกต่อเนื่อง Multiplier สุ่มแจกตัวคูณทวีคูณ สัญลักษณ์ Wild ยืดขยายทับรีล และโหมด Bonus Buy ซื้อฟรีสปิน",
    tag: "Bonus Buy",
  },
  {
    icon: "🎁",
    name: "โปรดีน่าตามที่กดรับแล้วถอนได้จริง",
    detail: "โบนัสต้อนรับสมาชิกใหม่ โปรเพิ่มทุนสำหรับยอดฝากแรกของวัน และระบบคืนยอดเสีย Cash Back เงื่อนไขตรงไปตรงมา ไม่ติดเทิร์นโอเวอร์มหาโหด",
    tag: "Cash Back",
  },
  {
    icon: "⚡",
    name: "ฝากถอนออโต้ 100% เสร็จใน 3-5 วินาที",
    detail: "เชื่อมต่อตรงกับธนาคารและแอปพลิเคชันวอลเล็ท ไม่ต้องส่งสลิปยืนยันให้แอดมิน ไม่ต้องรอคิวอนุมัติ กดถอนเข้ากระเป๋าได้ตลอด 24 ชั่วโมง",
    tag: "3-5 วินาที",
  },
];

const chips = ["เว็บตรง API แท้ 100%", "RTP โปร่งใส", "ระบบแรงไม่กระตุก", "เบทเริ่ม 1 บาท", "เกมฮิตกระแสแรง", "Cash Back คืนยอดเสีย", "ออโต้ 3-5 วินาที", "กระเป๋าเดียวสลับค่าย"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ AURA456" titleright="ระบบและสิทธิพิเศษของ AURA456 ที่รวมไว้ในบัญชีเดียว" label="เข้าสู่ระบบ AURA456 และตารางอ้างอิงระบบกับสิทธิพิเศษภายในเว็บ">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#8b3cf7]/35 bg-[#120a33] p-6 shadow-[0_10px_30px_rgba(139,60,247,0.28)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#1c1046]/80 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ff2fb0]/45 bg-gradient-to-br from-[#ffc9ee] via-[#ff2fb0] to-[#4a179e] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f6ebff]">ยินดีต้อนรับกลับเข้าล็อบบี้</p>
          <span class="text-[11px] text-[#9b93c4]">
            กรอกเบอร์โทรศัพท์และรหัสผ่านที่ตั้งไว้ ก็เข้าล็อบบี้เกมลิขสิทธิ์แท้ที่ AURA456 กวาดมาจากค่ายยักษ์ใหญ่ได้จากยูสเซอร์เดียว กระเป๋าเดียวสลับค่ายได้ทันทีโดยไม่ต้องโยกเงิน
            พร้อมระบบฝากถอนออโต้ที่ทำรายการเสร็จใน 3-5 วินาที
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ff2fb0]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#1c1046] bg-[#05021a] py-3 pr-4 pl-12 text-[#d8d3f0] transition-all outline-none placeholder:text-[#5f7fb8] focus:border-[#ff2fb0] focus:ring-1 focus:ring-[#ff2fb0]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ff2fb0]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#1c1046] bg-[#05021a] py-3 pr-4 pl-12 text-[#d8d3f0] transition-all outline-none placeholder:text-[#5f7fb8] focus:border-[#ff2fb0] focus:ring-1 focus:ring-[#ff2fb0]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#9b93c4]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#1c1046] bg-[#05021a] accent-[#c81d8e]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#9b93c4] transition-colors hover:text-[#ff2fb0]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#4a179e]/60 bg-gradient-to-r from-[#ffc9ee] via-[#ff2fb0] to-[#8b3cf7] p-3.5 font-black text-[#05021a] shadow-[0_10px_30px_rgba(255,47,176,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(59,169,255,0.35)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#9b93c4]">
          <span class="h-px flex-1 bg-[#1c1046]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#1c1046]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#8b3cf7]/40 bg-[#05021a] px-2.5 py-1 text-[10px] font-bold text-[#ff2fb0]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#3ba9ff]/30 bg-[#05021a] px-2.5 py-1 text-[10px] font-bold text-[#7fd0ff]"><span aria-hidden="true">🕐</span> ออโต้ตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ffc9ee] transition-colors hover:text-[#ff2fb0]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#3ba9ff]/30 bg-[#120a33] p-5 shadow-[0_10px_30px_rgba(59,169,255,0.18)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#5f7fb8]">ตารางอ้างอิงระบบและสิทธิพิเศษที่รวมไว้ในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#f6ebff] via-[#7fd0ff] to-[#ff2fb0] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">สล็อตตัวตึงออร่าพุ่ง ระบบแรง เกมเด็ดพร้อมลั่น โปรดีน่าตาม</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#05021a] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#5f7fb8]">
        <span>ระบบ / สิทธิพิเศษในเว็บ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#1c1046] bg-[#05021a] px-3.5 py-2.5 transition-colors hover:border-[#3ba9ff]/45 hover:bg-[#1c1046]/80">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#d8d3f0]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#d8f2ff]/60 bg-[#7fd0ff] px-2.5 py-0.5 text-[10px] font-bold text-[#05021a]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#9b93c4]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#8b3cf7]/40 bg-[#05021a] px-3 py-1 text-[10px] font-bold text-[#ff2fb0]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#5f7fb8]">
        รายละเอียดทั้งหมดเป็นข้อมูลอ้างอิงสำหรับผู้เล่น ควรตรวจอัตราการจ่ายและรายละเอียดฟีเจอร์ของแต่ละเกม เงื่อนไขการรับสิทธิ์ และเพดานถอนจากหน้าโปรโมชั่นจริงของ AURA456 ก่อนกดรับทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
