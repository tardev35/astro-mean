---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Widget ไม่ใช่ article — ทุกหัวข้อในนี้เป็น <p>/<span> และชื่อสำหรับ assistive
// tech มาจาก prop `label` ที่ส่งให้ ContentBoxTwo ไม่มีการส่ง `title` บล็อกนี้จึง
// ไม่ปล่อยหัวข้อออกมาเลย ส่วนอิโมจิของป้ายคอลัมน์ใช้ค่า default ของ ContentBoxTwo
// (กุญแจ/เพชร) ซึ่งตรงกับแผงเข้าสู่ระบบและตารางอ้างอิงอยู่แล้ว
//
// XONEBET: ย้ายชุดสีของแบรนด์ก่อนออกทั้งหมด มาที่ทองหลอมคู่เงินโครเมียมที่วัดจาก
// อาร์ตจริง — ทอง #ebb101 / #fee505 / #fff8d1 / #a87c02 / #5c4301 คู่เงิน #e9e9e9 /
// #c4c4c4 บนผิว #0a0803 / #161105 / #221a08 เนื้อความ #f4e6bd ข้อความรอง #c3ae76
// เขียว LINE กับจุด live สีเขียว Tailwind เป็นสีเชิงความหมาย ไม่ถูกแตะ (ห้ามพิมพ์
// hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์
// ดูของเดิมได้จาก git history)
//
// เนื้อหาตาม brief ของแบรนด์นี้ ซึ่งเป็นสล็อตวันสต็อปเว็บตรง API แท้: ยิงสัญญาณตรง
// จากเซิร์ฟเวอร์หลักนอกโดยไม่ผ่านเอเย่นต์ ค่า RTP โปร่งใสตามมาตรฐานสากลไม่มีปรับแต่ง
// เปอร์เซ็นต์การชนะ โครงสร้าง One-Stop Service บัญชีเดียวจบ ค่ายเกรด A อย่าง
// PG Soft / Pragmatic Play / Joker Gaming จัดหมวดหมู่หน้าเว็บเป็นระบบ ฟีเจอร์
// Multipliers / Wild ซ้อนทับ / Cascading / Buy Feature เซิร์ฟเวอร์ประมวลผลความเร็ว
// สูง Responsive 100% และฝากถอนออโต้ที่ประมวลผลไวใน 3 วินาที
const menus = [
  {
    icon: "🛡️",
    name: "เว็บตรง API แท้ ไม่ผ่านเอเย่นต์",
    detail: "ยิงสัญญาณตรงจากเซิร์ฟเวอร์หลักนอกโดยไม่ผ่านเอเย่นต์ ค่า RTP โปร่งใสตามมาตรฐานสากล ไม่มีการปรับแต่งเปอร์เซ็นต์การชนะในทุกเกมที่อยู่ในล็อบบี้",
    tag: "API แท้",
  },
  {
    icon: "👛",
    name: "One-Stop Service บัญชีเดียวจบ",
    detail: "เชื่อมคลังเกมจากทุกค่ายชั้นนำและระบบการเงินไว้ในบัญชีเดียว ไม่ต้องสมัครหลายยูสเซอร์ ไม่ต้องโยกเงินข้ามค่าย จัดการทุกอย่างผ่านหน้าแดชบอร์ดเดียว",
    tag: "บัญชีเดียว",
  },
  {
    icon: "🎰",
    name: "ค่ายใหญ่ระดับเกรด A คัดมาแล้ว",
    detail: "คัดเฉพาะ PG Soft, Pragmatic Play และ Joker Gaming เน้นเกมตัวท็อปที่โครงสร้างการจ่ายเงินโปร่งใส จังหวะฟรีสปินเข้าไว และมีอัตราคูณสะสมสูง",
    tag: "เกรด A",
  },
  {
    icon: "🗂️",
    name: "จัดหมวดหมู่หน้าเว็บอย่างเป็นระบบ",
    detail: "แยกตามประเภทเกม ค่ายดัง และหมวดเกมกระแสมาแรง ค้นหาเกมที่ใช่ได้ในไม่กี่คลิก สลับเปลี่ยนฟีลการปั่นสล็อตได้ตรงสไตล์โดยไม่ต้องค้นหาหลายรอบ",
    tag: "ไม่กี่คลิก",
  },
  {
    icon: "✨",
    name: "ฟีเจอร์ใหม่พร้อมลั่นครบทุกลูกเล่น",
    detail: "ระบบสุ่มแจกตัวคูณทวีคูณ Multipliers สัญลักษณ์ Wild ซ้อนทับ คอมโบแตกต่อเนื่องแบบ Cascading และโหมด Buy Feature สำหรับสายใจร้อน",
    tag: "ลูกเล่นใหม่",
  },
  {
    icon: "⚡",
    name: "เซิร์ฟเวอร์ประมวลผลความเร็วสูง",
    detail: "สลับค่ายเกมและโหลดหน้าอินเทอร์เฟซได้ฉับไว ไร้ปัญหาเกมค้าง กระตุก หรือเด้งหลุดกลางทาง รองรับการใช้งานพร้อมกันจำนวนมากได้อย่างเสถียร",
    tag: "ไม่ขัดจังหวะ",
  },
  {
    icon: "📱",
    name: "Responsive 100% ทุกอุปกรณ์",
    detail: "รองรับเต็มรูปแบบทั้งมือถือ iOS, Android, แท็บเล็ต และคอมพิวเตอร์ ปุ่มกดและเมนูจัดวางให้ใช้งานง่าย ภาพคมชัดเข้ากับทุกหน้าจอตลอด 24 ชั่วโมง",
    tag: "ทุกหน้าจอ",
  },
];

const chips = ["เว็บตรง API แท้", "ไม่ผ่านเอเย่นต์", "RTP โปร่งใส", "One-Stop Service", "Multipliers", "Cascading", "Buy Feature", "ออโต้ไวใน 3 วินาที"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ XONEBET" titleright="ระบบและจุดเด่นของ XONEBET ที่รวมไว้ในบัญชีเดียว" label="เข้าสู่ระบบ XONEBET และตารางอ้างอิงระบบกับจุดเด่นภายในเว็บ">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#a87c02]/35 bg-[#161105] p-6 shadow-[0_10px_30px_rgba(92,67,1,0.3)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#221a08]/90 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ebb101]/45 bg-gradient-to-br from-[#fff8d1] via-[#ebb101] to-[#5c4301] text-xl shadow-inner">
          👑
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fff8d1]">ยินดีต้อนรับกลับเข้าล็อบบี้ XONEBET</p>
          <span class="text-[11px] text-[#c3ae76]">
            กรอกเบอร์โทรศัพท์และรหัสผ่านที่ตั้งไว้ ก็เข้าเกมตัวท็อปที่ XONEBET คัดไว้ได้จากบัญชีเดียวตามโครงสร้าง One-Stop Service สลับค่ายได้อิสระโดยไม่ต้องโยกเงิน
            พร้อมระบบฝากถอนออโต้ที่ประมวลผลไวใน 3 วินาที
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ebb101]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#5c4301] bg-[#0a0803] py-3 pr-4 pl-12 text-[#f4e6bd] transition-all outline-none placeholder:text-[#c3ae76] focus:border-[#ebb101] focus:ring-1 focus:ring-[#ebb101]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ebb101]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#5c4301] bg-[#0a0803] py-3 pr-4 pl-12 text-[#f4e6bd] transition-all outline-none placeholder:text-[#c3ae76] focus:border-[#ebb101] focus:ring-1 focus:ring-[#ebb101]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#c3ae76]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#5c4301] bg-[#0a0803] accent-[#a87c02]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#c3ae76] transition-colors hover:text-[#fee505]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#5c4301]/70 bg-gradient-to-r from-[#fff8d1] via-[#fee505] to-[#ebb101] p-3.5 font-black text-[#0a0803] shadow-[0_10px_30px_rgba(235,177,1,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(235,177,1,0.45)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#c3ae76]">
          <span class="h-px flex-1 bg-[#221a08]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#221a08]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#5c4301]/40 bg-[#0a0803] px-2.5 py-1 text-[10px] font-bold text-[#fee505]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#e9e9e9]/30 bg-[#0a0803] px-2.5 py-1 text-[10px] font-bold text-[#e9e9e9]"><span aria-hidden="true">🕐</span> ออโต้ตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#fff8d1] transition-colors hover:text-[#fee505]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#ebb101]/30 bg-[#161105] p-5 shadow-[0_10px_30px_rgba(235,177,1,0.18)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#c3ae76]">ตารางอ้างอิงระบบและจุดเด่นที่รวมไว้ในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#fff8d1] via-[#fee505] to-[#e9e9e9] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">
            สล็อตวันสต็อป เกมตัวท็อปครบวงจร ระบบใหม่ไหลลื่น
          </div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#0a0803] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#c3ae76]">
        <span>ระบบ / จุดเด่นในเว็บ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#5c4301] bg-[#0a0803] px-3.5 py-2.5 transition-colors hover:border-[#ebb101]/45 hover:bg-[#221a08]/90">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f4e6bd]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#fee505]/60 bg-[#ebb101] px-2.5 py-0.5 text-[10px] font-bold text-[#0a0803]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#c3ae76]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#5c4301]/40 bg-[#0a0803] px-3 py-1 text-[10px] font-bold text-[#fee505]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#c3ae76]">
        รายละเอียดทั้งหมดเป็นข้อมูลอ้างอิงสำหรับผู้เล่น ควรตรวจอัตราจ่ายของแต่ละเกม เงื่อนไขการรับสิทธิ์ และเพดานถอนจากหน้าโปรโมชั่นจริงของ XONEBET ก่อนกดรับทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
