---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Widget ไม่ใช่ article — ทุกหัวข้อในนี้เป็น <p>/<span> และชื่อสำหรับ assistive
// tech มาจาก prop `label` ที่ส่งให้ ContentBoxTwo ไม่มีการส่ง `title` บล็อกนี้จึง
// ไม่ปล่อยหัวข้อออกมาเลย ส่วนอิโมจิของป้ายคอลัมน์ใช้ค่า default ของ ContentBoxTwo
// (กุญแจ/เพชร) ซึ่งตรงกับแผงเข้าสู่ระบบและตารางสิทธิพิเศษอยู่แล้ว
//
// GUESS168: ย้ายชุดสีของแบรนด์ก่อนออกทั้งหมด มาที่ทองหลอมคู่ส้มไฟที่วัดจากอาร์ต
// จริง เขียว LINE กับจุด live สีเขียว Tailwind เป็นสีเชิงความหมาย ไม่ถูกแตะ
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ ดูของเดิมได้จาก git history)
//
// เนื้อหาตาม brief ของแบรนด์นี้: เว็บตรง API แท้ค่า RTP สูง คลังเกมลิขสิทธิ์จาก
// PG Soft / Pragmatic Play / Joker Gaming เกมใหม่เข้าคลังใน 24 ชั่วโมงพร้อมโหมด
// ทดลองเล่นฟรี ฟีเจอร์ Multiplier / Wild ซ้อนทับ / Cascading / Bonus Buy โปรที่
// กดรับเองได้ทั้งโบนัสต้อนรับ โปรฝากแรกของวัน และ Cash Back คืนยอดเสียทุกวัน
// ฝากถอนออโต้ 3-5 วินาทีผ่าน Gateway ตรง และกระเป๋าเดียวจบบนแดชบอร์ดเดียว
const menus = [
  {
    icon: "🛡️",
    name: "เว็บตรง API แท้ ยิงตรงจากเซิร์ฟเวอร์หลัก",
    detail: "คัดเฉพาะสล็อตแตกง่ายค่า RTP สูง ไม่มีการดัดแปลงเปอร์เซ็นต์ชนะ ไร้เทิร์นโอเวอร์จุกจิก ปั่นได้เท่าไหร่ถอนออกได้ครบทุกบาท",
    tag: "API แท้",
  },
  {
    icon: "🎰",
    name: "คลังเกมลิขสิทธิ์จากค่ายใหญ่มาตรฐานสากล",
    detail: "คัดกรองเฉพาะค่ายใหญ่อย่าง PG Soft, Pragmatic Play และ Joker Gaming ทุกเกมผ่านการทดสอบอัตราจ่าย จ่ายจริงตามอัลกอริทึมโรงงาน ไม่เอาเกมไร้คุณภาพมาลงให้รกคลัง",
    tag: "เน้นตัวมีของ",
  },
  {
    icon: "💰",
    name: "เบทเริ่มต้น 1 บาทก็ลุ้นโบนัสก้อนโต",
    detail: "ไม่ต้องอัดทุนหนักตั้งแต่ไม้แรก เปิดให้เริ่มที่หนึ่งบาทแล้วค่อยไล่ระดับเบทตามจังหวะโบนัสที่จับทางได้จากการปั่นจริง",
    tag: "เริ่ม 1 บาท",
  },
  {
    icon: "🆕",
    name: "เกมใหม่เข้าคลังภายใน 24 ชั่วโมง",
    detail: "ค่ายใหญ่ปล่อยเกมไหนก็อัปเดตเข้าคลังทันที ไม่ต้องคอยกระแสซาและไม่ต้องรอระบบอนุมัติข้ามสัปดาห์ พร้อมโหมดทดลองเล่นฟรีให้เช็กกลไกเกมก่อนลงเงินจริง",
    tag: "24 ชั่วโมง",
  },
  {
    icon: "🎲",
    name: "ฟีเจอร์ในเกมอัดแน่นครบทุกลูกเล่น",
    detail: "ทั้ง Multiplier สุ่มตัวคูณหนัก ระบบ Wild ซ้อนทับ คอมโบแตกต่อเนื่อง Cascading และโหมด Bonus Buy ซื้อฟรีสปินพุ่งตรงเข้าลุ้นรางวัลใหญ่ทันที",
    tag: "ลูกเล่นครบ",
  },
  {
    icon: "🎁",
    name: "โปรกดรับเองผ่านหน้าเว็บ ไม่ติดล็อกยูส",
    detail: "โบนัสต้อนรับเพิ่มทุนสปิน โปรฝากแรกของวัน และระบบคืนยอดเสีย Cash Back ทุกวัน เงื่อนไขชัดเจน ถอนได้จริง ไม่มีเงื่อนไขหลอกลวง",
    tag: "Cash Back ทุกวัน",
  },
  {
    icon: "⚡",
    name: "ฝากถอนออโต้ผ่าน Gateway ตรง 3-5 วินาที",
    detail: "ไม่ต้องโอนสลิปให้แอดมิน ไม่ต้องคอยคิวอนุมัติ ฝากแล้วยอดเด้งเข้าเกมทันที ถอนกำไรปุ๊บเงินวิ่งเข้าบัญชีธนาคารหรือวอลเล็ททันใจ",
    tag: "ออโต้ทันใจ",
  },
];

const chips = ["สล็อตคัดเกรด", "เกมลิขสิทธิ์แน่น", "RTP สูง", "อัปเดตใหม่ 24 ชั่วโมง", "ฟีเจอร์ครบ", "Cash Back ทุกวัน", "ฝากถอนออโต้", "กระเป๋าเดียวจบ"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ GUESS168" titleright="ระบบและสิทธิพิเศษของ GUESS168 ที่รวมไว้ในบัญชีเดียว" label="เข้าสู่ระบบ GUESS168 และตารางอ้างอิงระบบกับสิทธิพิเศษภายในเว็บ">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#c58a00]/35 bg-[#231005] p-6 shadow-[0_10px_30px_rgba(197,138,0,0.28)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#33180a]/80 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#fecc02]/45 bg-gradient-to-br from-[#ffe680] via-[#fecc02] to-[#a35800] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fff6e0]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#d8bb87]">
            กรอกเบอร์โทรศัพท์และรหัสผ่านที่ตั้งไว้ ก็เข้าคลังเกมลิขสิทธิ์ที่ GUESS168 คัดจากค่ายใหญ่มาตรฐานสากลได้จากยูสเซอร์เดียว กระเป๋าเดียวจบไม่ต้องโยกเงินข้ามค่าย
            พร้อมระบบฝากถอนออโต้ที่ทำรายการเสร็จใน 3-5 วินาที
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ffd54a]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#33180a] bg-[#140800] py-3 pr-4 pl-12 text-[#f7e7c6] transition-all outline-none placeholder:text-[#a3855a] focus:border-[#fecc02] focus:ring-1 focus:ring-[#fecc02]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ffd54a]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#33180a] bg-[#140800] py-3 pr-4 pl-12 text-[#f7e7c6] transition-all outline-none placeholder:text-[#a3855a] focus:border-[#fecc02] focus:ring-1 focus:ring-[#fecc02]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#d8bb87]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#33180a] bg-[#140800] accent-[#c58a00]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#d8bb87] transition-colors hover:text-[#ffd54a]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#a35800]/60 bg-gradient-to-r from-[#ffe680] via-[#fecc02] to-[#c58a00] p-3.5 font-black text-[#140800] shadow-[0_10px_30px_rgba(254,204,2,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(254,156,1,0.45)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#d8bb87]">
          <span class="h-px flex-1 bg-[#33180a]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#33180a]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#c58a00]/40 bg-[#140800] px-2.5 py-1 text-[10px] font-bold text-[#ffd54a]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#33180a] bg-[#140800] px-2.5 py-1 text-[10px] font-bold text-[#d8bb87]"><span aria-hidden="true">🕐</span> ทำรายการได้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ffe680] transition-colors hover:text-[#fecc02]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#c58a00]/35 bg-[#231005] p-5 shadow-[0_10px_30px_rgba(197,138,0,0.28)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#d8bb87]">ตารางอ้างอิงระบบและสิทธิพิเศษที่รวมไว้ในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#fff6e0] via-[#ffd54a] to-[#fe9c01] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">สล็อตคัดเกรด เกมลิขสิทธิ์แน่น ฝากถอนออโต้ทันใจ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#140800] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#d8bb87]">
        <span>ระบบ / สิทธิพิเศษในเว็บ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#33180a] bg-[#140800] px-3.5 py-2.5 transition-colors hover:border-[#ffd54a]/55 hover:bg-[#33180a]/80">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f7e7c6]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#ffe680]/60 bg-[#fecc02] px-2.5 py-0.5 text-[10px] font-bold text-[#140800]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#d8bb87]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#c58a00]/40 bg-[#140800] px-3 py-1 text-[10px] font-bold text-[#ffd54a]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#d8bb87]">
        รายละเอียดทั้งหมดเป็นข้อมูลอ้างอิงสำหรับผู้เล่น ควรตรวจอัตราการจ่ายและรายละเอียดฟีเจอร์ของแต่ละเกม เงื่อนไขการรับสิทธิ์ และเพดานถอนจากหน้าโปรโมชั่นจริงของ GUESS168 ก่อนกดรับทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
