---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Widget ไม่ใช่ article — ทุกหัวข้อในนี้เป็น <p>/<span> และชื่อสำหรับ assistive
// tech มาจาก prop `label` ที่ส่งให้ ContentBoxTwo ไม่มีการส่ง `title` บล็อกนี้จึง
// ไม่ปล่อยหัวข้อออกมาเลย
//
// AURORA688: ย้ายจากทองบูสต์คู่น้ำเงินไฟฉายของ BOOST168 (#ffe680 / #ffc233 /
// #b26a00 คู่น้ำเงิน #9ecbff / #3f8cff บนผิว #0e1430 / #050818 / #03060f / #18204a
// เนื้อความ #e6ecfb หมึกบนปุ่มทอง #0a0f22) มาที่ทองหรูคู่เงินโครเมียม — ทองหลัก
// #ffe9a3 / #e2c443 / #c9a13a / #7d5714 คู่เงิน #eef2f7 / #c3cddb / #8d99a8 บนผิว
// #221c0d / #0a0806 / #050403 / #3a3116 เนื้อความ #f2ead6 ข้อความรอง #c8bda1
// หมึกบนปุ่มทอง #15120a เขียว LINE #00B900 กับจุด live สีเขียวเป็นสีเชิงความหมาย
// ไม่ถูกแตะ
//
// เนื้อหาตาม brief ของแบรนด์นี้: เว็บสล็อตฟีลดี คลังเกมกว่า 1,000+ จากค่ายยักษ์ใหญ่
// ทั่วโลก ล็อบบี้รวมเกมฮิตติดแสงกับเกมใหม่นอกกระแส แจ็คพอตกระจายอยู่ทุกเกมไม่ใช่แค่
// เกมยอดนิยม โปรมีให้ตามหลายจังหวะ และระบบออโต้ที่ทำรายการเองได้ในไม่กี่วินาที
const menus = [
  {
    icon: "🎰",
    name: "คลังเกมกว่า 1,000+ จากค่ายยักษ์ใหญ่ทั่วโลก",
    detail: "เลือกได้จุใจทั้งแนวแฟนตาซีตระการตา แอ็กชันสุดมันส์ และสตรีทสุดเท่ ทุกเกมคัดมาแล้วว่าภาพสวย กราฟิกอลังการ และอัตราการจ่ายรางวัลคุ้มค่า",
    tag: "1,000+ เกม",
  },
  {
    icon: "✨",
    name: "ล็อบบี้จัดวางเป็นระเบียบ หาเกมที่ใช่ได้ในหน้าเดียว",
    detail: "เกมฮิตติดแสงระดับตำนานถูกวางไว้ข้างเกมใหม่มาแรงนอกกระแสที่ซ่อนโบนัสเด็ดเอาไว้เพียบ อยากลองฟีเจอร์แปลกใหม่หรือปั่นเกมตัวตึงก็เลือกได้ทันใจ",
    tag: "ค้นเกมง่าย",
  },
  {
    icon: "💥",
    name: "แจ็คพอตแตกทุกวัน ไม่ได้ซ่อนอยู่แค่ในเกมยอดนิยม",
    detail: "รอบโบนัสและแจ็คพอตกระจายอยู่ในทุกเกมในคลัง เลือกหมุนเกมไหนก็มีจังหวะให้ลุ้นรางวัลใหญ่เสมอ ทุกวันคือโอกาสใหม่ที่พร้อมสุ่มแจกโบนัส",
    tag: "ลุ้นได้ทุกเกม",
  },
  {
    icon: "🎁",
    name: "โปรมีให้ตามหลายจังหวะตลอดทั้งเดือน",
    detail: "ทั้งสิทธิประโยชน์ต้อนรับสมาชิกใหม่ โบนัสเติมเงินประจำวัน และเครดิตพิเศษตามเทศกาล ออกแบบมาเพื่อเพิ่มทุนให้ปั่นสนุกขึ้นและยืดเวลาความเพลิดเพลิน",
    tag: "หลายจังหวะ",
  },
  {
    icon: "🤖",
    name: "ระบบออโต้พร้อมรับทุกช่วงเวลา ตลอด 24 ชั่วโมง",
    detail: "ฝากเข้าลุยต่อหรือกดถอนกำไรก้อนโตเข้าบัญชี ทำได้ด้วยตัวเองภายในไม่กี่วินาที ไม่ต้องส่งสลิปยืนยัน ไม่ต้องรอแอดมินอนุมัติให้เสียเวลา",
    tag: "ออโต้ทั้งระบบ",
  },
  {
    icon: "🕹️",
    name: "สลับฟีลการเล่นได้ทุกวันแบบไม่มีคำว่าจำเจ",
    detail: "ทุกค่ายเปิดให้เข้าใช้งานจากบัญชีเดียว เปลี่ยนบรรยากาศจากเกมชิลๆ ไปเป็นสายล่ารางวัลใหญ่ตอนไหนก็ได้ โดยไม่ต้องโยกเงินหรือออกจากระบบ",
    tag: "บัญชีเดียวจบ",
  },
  {
    icon: "👛",
    name: "รองรับวอเลทและธนาคารชั้นนำแบบไม่กั้นทุน",
    detail: "ทำรายการผ่าน TrueMoney Wallet และบัญชีธนาคารหลักได้อิสระ จะเบทหลักสิบเพลินตาหรือไล่ล่าแจ็คพอตหลักหมื่นก็เริ่มต้นได้เหมือนกัน",
    tag: "ไม่กั้นทุน",
  },
];

const chips = ["เว็บสล็อตฟีลดี", "คลังเกม 1,000+", "เกมฮิตติดแสง", "แจ็คพอตแตกทุกวัน", "โปรหลายจังหวะ", "ออโต้ไม่กี่วินาที", "เล่นได้ตลอด 24 ชั่วโมง"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ AURORA688" titleright="ระบบและสิทธิพิเศษของ AURORA688 ที่รวมไว้ในบัญชีเดียว" label="เข้าสู่ระบบ AURORA688 และตารางอ้างอิงระบบกับสิทธิพิเศษภายในเว็บ">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#e2c443]/30 bg-[#221c0d] p-6 shadow-[0_10px_30px_rgba(226,196,67,0.22)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#c3cddb]/25 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e2c443]/45 bg-gradient-to-br from-[#ffe9a3] via-[#e2c443] to-[#7d5714] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffe9a3]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#c8bda1]">กรอกเบอร์โทรศัพท์และรหัสผ่านที่ตั้งไว้ ก็เข้าล็อบบี้เกมสล็อตกว่า 1,000+ เกมของ AURORA688 ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e2c443]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#3a3116] bg-[#050403] py-3 pr-4 pl-12 text-[#f2ead6] transition-all outline-none placeholder:text-[#c8bda1]/70 focus:border-[#e2c443] focus:ring-1 focus:ring-[#e2c443]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e2c443]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#3a3116] bg-[#050403] py-3 pr-4 pl-12 text-[#f2ead6] transition-all outline-none placeholder:text-[#c8bda1]/70 focus:border-[#e2c443] focus:ring-1 focus:ring-[#e2c443]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#c8bda1]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#3a3116] bg-[#050403] accent-[#e2c443]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#c8bda1] transition-colors hover:text-[#ffe9a3]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#7d5714]/50 bg-gradient-to-r from-[#ffe9a3] via-[#e2c443] to-[#7d5714] p-3.5 font-black text-[#15120a] shadow-[0_10px_30px_rgba(226,196,67,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(226,196,67,0.45)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#c8bda1]">
          <span class="h-px flex-1 bg-[#3a3116]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#3a3116]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#e2c443]/30 bg-[#050403] px-2.5 py-1 text-[10px] font-bold text-[#ffe9a3]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#3a3116] bg-[#050403] px-2.5 py-1 text-[10px] font-bold text-[#c8bda1]"><span aria-hidden="true">🕐</span> ทำรายการได้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#c3cddb] transition-colors hover:text-[#eef2f7]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#e2c443]/30 bg-[#221c0d] p-5 shadow-[0_10px_30px_rgba(226,196,67,0.22)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#c8bda1]">ตารางอ้างอิงระบบและสิทธิพิเศษที่รวมไว้ในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#eef2f7] via-[#e2c443] to-[#c9a13a] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">เว็บสล็อตฟีลดี แจ็คพอตแตกทุกวัน</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#050403] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#c8bda1]">
        <span>ระบบ / สิทธิพิเศษในเว็บ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#3a3116] bg-[#050403] px-3.5 py-2.5 transition-colors hover:border-[#e2c443]/55 hover:bg-[#3a3116]/70">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f2ead6]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#c3cddb]/60 bg-[#e2c443] px-2.5 py-0.5 text-[10px] font-bold text-[#15120a]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#c8bda1]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#e2c443]/30 bg-[#050403] px-3 py-1 text-[10px] font-bold text-[#ffe9a3]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#c8bda1]/80">
        รายละเอียดทั้งหมดเป็นข้อมูลอ้างอิงสำหรับผู้เล่น ควรตรวจเดิมพันขั้นต่ำและสูงสุดของแต่ละเกม เงื่อนไขการรับสิทธิ์ และเพดานถอนจากหน้าโปรโมชั่นจริงของ AURORA688 ก่อนกดรับทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
