---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Widget ไม่ใช่ article — ทุกหัวข้อในนี้เป็น <p>/<span> และชื่อสำหรับ assistive
// tech มาจาก prop `label` ที่ส่งให้ ContentBoxTwo ไม่มีการส่ง `title` บล็อกนี้จึง
// ไม่ปล่อยหัวข้อออกมาเลย
//
// GEN4: โครงสองคอลัมน์ยังเป็น ContentBoxTwo ตัวเดิม แต่ย้ายชุดสีจากส้มหลอมเหลวของ
// แบรนด์ก่อน มาที่น้ำเงินอิเล็กทริกคู่แดงของแบรนด์นี้ที่วัดจากอาร์ตจริง — น้ำเงิน
// #0071d5 / #01a3f3 / #6fd2ff / #00408a คู่แดง #e8241c / #ff5a33 บนผิว #050b1a /
// #0b1b3a ขอบ/แถบยก #102a5c เนื้อความ #d7e7ff หัวข้อ #eaf4ff ข้อความรอง #8fb4e0
// หมึกบนปุ่มสว่าง #050b1a เขียว LINE #00B900 กับจุด live สีเขียว Tailwind เป็นสี
// เชิงความหมาย ไม่ถูกแตะ (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์
// เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history)
//
// เนื้อหาตาม brief ของแบรนด์นี้: แพลตฟอร์มสล็อตระดับเนกซ์เจนที่รวมเกมลิขสิทธิ์แท้
// จากค่ายชั้นนำระดับโลก คลังเกมใหญ่ที่ออกแบบมาเพื่อนักเดิมพันยุคปัจจุบัน ทีมงาน
// อัปเดตไลน์อัปเกมใหม่ต่อเนื่อง เซิร์ฟเวอร์และซอฟต์แวร์หลังบ้านอัปเกรดใหม่ทั้งหมด
// คลิกเลือกเกมแล้วพุ่งตรงเข้าหน้าสปิน และฝากถอนออโต้ตลอด 24 ชั่วโมง
const menus = [
  {
    icon: "🎮",
    name: "เกมลิขสิทธิ์แท้จากค่ายชั้นนำระดับโลก",
    detail: "GEN4 จับมือกับค่ายเกมสล็อตยักษ์ใหญ่ทั่วโลก นำเสนอลิขสิทธิ์แท้ที่ไม่ผ่านการดัดแปลงโปรแกรมใดๆ ควบคู่กับอัตราการจ่ายเงินรางวัลที่ได้มาตรฐานยุติธรรม 100% ในทุกเกม",
    tag: "ลิขสิทธิ์แท้",
  },
  {
    icon: "🗂️",
    name: "คลังเกมใหญ่ที่ออกแบบมาเพื่อยุคปัจจุบัน",
    detail: "คลังเกมสล็อตขนาดใหญ่รองรับความต้องการของนักเดิมพันยุคนี้โดยเฉพาะ ทั้งสายงานภาพกราฟิก 3D สุดอลังการ และสายกลไกเกมแปลกใหม่ที่มีอัตราคูณโบนัสสูง เลือกได้แบบไม่ตกเทรนด์",
    tag: "ไม่ตกยุค",
  },
  {
    icon: "🏆",
    name: "ล็อบบี้รวมทั้งตัวฮิตและตัวน่าลอง",
    detail: "จัดวางทั้งเกมฮิตระดับตำนานที่ขึ้นชื่อเรื่องแจ็คพอตแตกง่าย และเกมตัวน่าลองนอกกระแสที่มีฟีเจอร์เด็ดซ่อนอยู่ ช่วยกระจายความเสี่ยงและสลับบรรยากาศการทำกำไรได้ในที่เดียว",
    tag: "ครบทั้งสองสาย",
  },
  {
    icon: "🆕",
    name: "ไลน์อัปเกมใหม่เข้าระบบต่อเนื่อง",
    detail: "ทีมงานคอยอัปเดตเกมสล็อตใหม่เข้าสู่ระบบตลอด ค่ายดังเปิดตัวเกมไหนหรือมีกระแสเกมตัวไหนกำลังมาแรง คุณจะได้ทดลองเล่นเป็นกลุ่มแรกๆ เสมอ ไม่มีคำว่าหลุดลิสต์",
    tag: "ของสดตลอด",
  },
  {
    icon: "🛰️",
    name: "เซิร์ฟเวอร์และหลังบ้านอัปเกรดใหม่ทั้งหมด",
    detail: "ลดระยะเวลาโหลดหน้าเว็บและหน้าเกมลงอย่างเห็นได้ชัด เปลี่ยนค่ายเกม สลับเมนู หรือกดเลือกโหมดต่างๆ ได้ลื่นไหล รองรับสมาชิกจำนวนมากพร้อมกันโดยไม่หน่วงและไม่กระตุก",
    tag: "เข้าไวกว่าเดิม",
  },
  {
    icon: "🎯",
    name: "จากล็อบบี้ถึงหน้าสปินในไม่กี่วินาที",
    detail: "ระบบตัดขั้นตอนเปลี่ยนผ่านที่ยุ่งยากออกไปทั้งหมด ตั้งแต่คลิกเลือกเกมในล็อบบี้ก็พาพุ่งตรงเข้าหน้าสปินและพร้อมหมุนวงล้อได้เลย โฟกัสการทำกำไรจึงไม่ขาดช่วง",
    tag: "ลดจังหวะรอ",
  },
  {
    icon: "⚡",
    name: "ฝากถอนออโต้ตลอด 24 ชั่วโมง",
    detail: "ทำรายการเสร็จสรรพผ่านหน้าเว็บในไม่กี่วินาที ยอดเงินอัปเดตตรงเป๊ะเข้าบัญชีทันทีโดยไม่ต้องส่งสลิปยืนยัน และไม่ต้องเสียเวลานั่งรอแอดมินกดอนุมัติ",
    tag: "ไม่ต้องรอนาน",
  },
];

const chips = ["สล็อตเจนใหม่มีของ", "เกมลิขสิทธิ์แท้หลายค่าย", "ตัวฮิตไม่ตกเจน", "เกมใหม่ไม่หลุดลิสต์", "ระบบอัปเดตใหม่", "เข้าไวกว่าเดิม", "ลดจังหวะรอ", "ฝากถอนออโต้ไม่ต้องรอนาน"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ GEN4" titleright="ระบบและสิทธิพิเศษของ GEN4 ที่รวมไว้ในบัญชีเดียว" label="เข้าสู่ระบบ GEN4 และตารางอ้างอิงระบบกับสิทธิพิเศษภายในเว็บ">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#0071d5]/35 bg-[#0b1b3a] p-6 shadow-[0_10px_30px_rgba(0,113,213,0.28)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#00408a]/80 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#01a3f3]/45 bg-gradient-to-br from-[#6fd2ff] via-[#01a3f3] to-[#00408a] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#eaf4ff]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#8fb4e0]">
            กรอกเบอร์โทรศัพท์และรหัสผ่านที่ตั้งไว้ ก็เข้าถึงคลังเกมลิขสิทธิ์แท้ที่ GEN4 รวมไว้ในหน้าเดียวได้จากยูสเซอร์เดียว คลิกเลือกเกมแล้วพุ่งตรงเข้าหน้าสปินได้ในไม่กี่วินาที
            พร้อมฝากถอนออโต้ตลอด 24 ชั่วโมง
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#01a3f3]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#102a5c] bg-[#050b1a] py-3 pr-4 pl-12 text-[#d7e7ff] transition-all outline-none placeholder:text-[#8fb4e0] focus:border-[#01a3f3] focus:ring-1 focus:ring-[#01a3f3]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#01a3f3]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#102a5c] bg-[#050b1a] py-3 pr-4 pl-12 text-[#d7e7ff] transition-all outline-none placeholder:text-[#8fb4e0] focus:border-[#01a3f3] focus:ring-1 focus:ring-[#01a3f3]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#8fb4e0]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#102a5c] bg-[#050b1a] accent-[#0071d5]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#8fb4e0] transition-colors hover:text-[#6fd2ff]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#00408a]/60 bg-gradient-to-r from-[#6fd2ff] via-[#01a3f3] to-[#00408a] p-3.5 font-black text-[#050b1a] shadow-[0_10px_30px_rgba(1,163,243,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(1,163,243,0.45)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#8fb4e0]">
          <span class="h-px flex-1 bg-[#102a5c]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#102a5c]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#0071d5]/40 bg-[#050b1a] px-2.5 py-1 text-[10px] font-bold text-[#6fd2ff]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#102a5c] bg-[#050b1a] px-2.5 py-1 text-[10px] font-bold text-[#8fb4e0]"><span aria-hidden="true">🕐</span> ทำรายการได้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ff5a33] transition-colors hover:text-[#6fd2ff]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#0071d5]/35 bg-[#0b1b3a] p-5 shadow-[0_10px_30px_rgba(0,113,213,0.28)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#8fb4e0]">ตารางอ้างอิงระบบและสิทธิพิเศษที่รวมไว้ในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#eaf4ff] via-[#01a3f3] to-[#0071d5] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">เกมลิขสิทธิ์แท้มาเต็ม ระบบอัปเดตใหม่ เข้าไวกว่าเดิม</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#050b1a] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#8fb4e0]">
        <span>ระบบ / สิทธิพิเศษในเว็บ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#102a5c] bg-[#050b1a] px-3.5 py-2.5 transition-colors hover:border-[#01a3f3]/55 hover:bg-[#102a5c]/80">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#d7e7ff]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#6fd2ff]/60 bg-[#0071d5] px-2.5 py-0.5 text-[10px] font-bold text-[#eaf4ff]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#8fb4e0]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#0071d5]/40 bg-[#050b1a] px-3 py-1 text-[10px] font-bold text-[#6fd2ff]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#8fb4e0]">
        รายละเอียดทั้งหมดเป็นข้อมูลอ้างอิงสำหรับผู้เล่น ควรตรวจอัตราการจ่ายและรายละเอียดฟีเจอร์ของแต่ละเกม เงื่อนไขการรับสิทธิ์ และเพดานถอนจากหน้าโปรโมชั่นจริงของ GEN4 ก่อนกดรับทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
