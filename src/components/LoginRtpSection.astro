---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Widget ไม่ใช่ article — ทุกหัวข้อในนี้เป็น <p>/<span> และชื่อสำหรับ assistive
// tech มาจาก prop `label` ที่ส่งให้ ContentBoxTwo ไม่มีการส่ง `title` บล็อกนี้จึง
// ไม่ปล่อยหัวข้อออกมาเลย
//
// ASHTON168: โครงสองคอลัมน์ยังเป็น ContentBoxTwo ตัวเดิม แต่ย้ายชุดสีจากน้ำเงิน
// อิเล็กทริกคู่แดงของแบรนด์ก่อน มาที่ทองสว่างคู่เงินโครเมียมของแบรนด์นี้ที่วัดจาก
// อาร์ตจริง — ทอง #f5c518 / #ffd75e / #ffe9a3 / #c8941a / #a87908 คู่เงิน
// #e2e5e9 / #f0f2f5 บนผิว #080502 / #160e03 ขอบ/แถบยก #2a1c06 เนื้อความ #f0e6d2
// หัวข้อ #fdf6e6 ข้อความรอง #c9bda2 หมึกบนปุ่มสว่าง #080502 เขียว LINE #00B900
// กับจุด live สีเขียว Tailwind เป็นสีเชิงความหมาย ไม่ถูกแตะ (ห้ามพิมพ์ hex ของ
// แบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์
// ดูของเดิมได้จาก git history)
//
// เนื้อหาตาม brief ของแบรนด์นี้: โครงสร้างระบบหลังบ้านแน่นหนาที่เชื่อมตรงเข้า
// เซิร์ฟเวอร์หลักของค่ายเกมยักษ์ใหญ่ ล็อบบี้รวมเกมตัวตึงจากค่ายชั้นนำ การจัดหมวดหมู่
// เกมให้เจอไว ระบบออโต้ไฮสปีดที่ฝากถอนเองได้ในไม่กี่วินาที ไลน์อัปโปรโมชันสำหรับ
// ผู้เล่นทุกรูปแบบ และกิจกรรมพิเศษที่หมุนเวียนมาเติมให้ตามต่อทุกวัน
const menus = [
  {
    icon: "🛰️",
    name: "ระบบหลังบ้านแน่นหนา เชื่อมตรงเข้าค่ายเกม",
    detail: "โครงสร้างระบบเสถียรและทรงพลัง รองรับการเชื่อมต่อตรงเข้าสู่เซิร์ฟเวอร์หลักของค่ายเกมยักษ์ใหญ่ทั่วโลก จึงพร้อมรันทุกเกมสล็อตได้อย่างสมูธตั้งแต่คลิกแรก",
    tag: "ระบบแน่น",
  },
  {
    icon: "🎮",
    name: "พร้อมรันเต็มล็อบบี้แม้คนเข้าพร้อมกันเยอะ",
    detail: "แม้ในช่วงเวลาที่มีผู้เข้าใช้งานพร้อมกันจำนวนมาก กราฟิกยังแสดงผลคมชัดเต็มประสิทธิภาพ เอฟเฟกต์เสียงตื่นเต้น และไม่มีอาการเกมค้างหรือหลุดระหว่างลุ้นโบนัสก้อนโต",
    tag: "เกมพร้อมรัน",
  },
  {
    icon: "🏆",
    name: "รวมตัวฮิตจากค่ายชั้นนำไว้ครบวงจร",
    detail: "ทั้งค่ายสายภาพสวย 3D ค่ายสายแตกโหดตัวคูณเยอะ และค่ายยอดนิยมตลอดกาล ทุกเกมคัดมาแล้วว่ามีอัตราการจ่ายเงินรางวัลได้มาตรฐานยุติธรรม ลุ้นแจ็คพอตง่าย",
    tag: "ค่ายชั้นนำ",
  },
  {
    icon: "🗂️",
    name: "จัดหมวดหมู่เกมไว้เป็นระเบียบชัดเจน",
    detail: "แยกตามประเภท ค่ายเกม และหมวดเกมยอดฮิต จะเปลี่ยนแนวไปปั่นเกมใหม่หรือกลับมาเล่นเกมโปรดก็ทำได้ในไม่กี่คลิก โดยไม่ต้องค้นหลายรอบให้เสียเวลา",
    tag: "เจอตัวที่ใช่ไว",
  },
  {
    icon: "⚡",
    name: "ออโต้ไฮสปีดทำรายการเองได้ในไม่กี่วินาที",
    detail: "ฝากและถอนดำเนินการได้เองง่ายๆ ผ่านหน้าเว็บ ยอดเงินอัปเดตไว แม่นยำตรงเป๊ะ ไม่ต้องส่งสลิปยืนยัน และไม่ต้องเสียเวลารอแอดมินอนุมัติให้เสียจังหวะ",
    tag: "ออโต้ไวทันใจ",
  },
  {
    icon: "🎁",
    name: "ไลน์อัปโปรโมชันรองรับผู้เล่นทุกรูปแบบ",
    detail: "ทั้งสิทธิประโยชน์สำหรับสมาชิกใหม่ที่เพิ่งเริ่มต้น โบนัสเติมเงินรายวันสำหรับสายลุยต่อเนื่อง และสิทธิ์รับเครดิตพิเศษตามช่วงเวลา เลือกกดรับไปเพิ่มทุนได้อย่างอิสระ",
    tag: "โปรคุ้มสุด ๆ",
  },
  {
    icon: "🔄",
    name: "กิจกรรมและโบนัสใหม่หมุนเวียนเติมทุกวัน",
    detail: "ทั้งกิจกรรมคืนยอดเสียประจำวัน การแจกโค้ดเครดิตฟรีตามเทศกาล และระบบสะสมแต้มแลกรางวัล มีของใหม่ให้สมาชิกตามต่อได้อย่างไม่ขาดสาย",
    tag: "เติมทุกวัน",
  },
];

const chips = ["สล็อตระบบแน่น", "เกมพร้อมรัน", "ค่ายชั้นนำเต็มล็อบบี้", "จัดหมวดเกมให้เลือกง่าย", "ออโต้ไวทันใจ", "โปรคุ้มสุด ๆ", "โบนัสเติมทุกวัน", "ทำรายการได้ 24 ชั่วโมง"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ ASHTON168" titleright="ระบบและสิทธิพิเศษของ ASHTON168 ที่รวมไว้ในบัญชีเดียว" label="เข้าสู่ระบบ ASHTON168 และตารางอ้างอิงระบบกับสิทธิพิเศษภายในเว็บ">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#c8941a]/35 bg-[#160e03] p-6 shadow-[0_10px_30px_rgba(200,148,26,0.28)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#7a5405]/80 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f5c518]/45 bg-gradient-to-br from-[#ffe9a3] via-[#f5c518] to-[#a87908] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fdf6e6]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#c9bda2]">
            กรอกเบอร์โทรศัพท์และรหัสผ่านที่ตั้งไว้ ก็เข้าถึงล็อบบี้เกมค่ายชั้นนำที่ ASHTON168 รวมไว้ในหน้าเดียวได้จากยูสเซอร์เดียว จัดหมวดไว้ให้กดเจอตัวที่ใช่ได้ไว
            พร้อมระบบออโต้ที่ทำรายการเองได้ตลอด 24 ชั่วโมง
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f5c518]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#2a1c06] bg-[#080502] py-3 pr-4 pl-12 text-[#f0e6d2] transition-all outline-none placeholder:text-[#c9bda2] focus:border-[#f5c518] focus:ring-1 focus:ring-[#f5c518]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f5c518]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#2a1c06] bg-[#080502] py-3 pr-4 pl-12 text-[#f0e6d2] transition-all outline-none placeholder:text-[#c9bda2] focus:border-[#f5c518] focus:ring-1 focus:ring-[#f5c518]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#c9bda2]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#2a1c06] bg-[#080502] accent-[#c8941a]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#c9bda2] transition-colors hover:text-[#ffe9a3]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#a87908]/60 bg-gradient-to-r from-[#ffe9a3] via-[#f5c518] to-[#c8941a] p-3.5 font-black text-[#080502] shadow-[0_10px_30px_rgba(245,197,24,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(245,197,24,0.45)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#c9bda2]">
          <span class="h-px flex-1 bg-[#2a1c06]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#2a1c06]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#c8941a]/40 bg-[#080502] px-2.5 py-1 text-[10px] font-bold text-[#ffe9a3]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#2a1c06] bg-[#080502] px-2.5 py-1 text-[10px] font-bold text-[#c9bda2]"><span aria-hidden="true">🕐</span> ทำรายการได้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#e2e5e9] transition-colors hover:text-[#ffe9a3]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#c8941a]/35 bg-[#160e03] p-5 shadow-[0_10px_30px_rgba(200,148,26,0.28)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#c9bda2]">ตารางอ้างอิงระบบและสิทธิพิเศษที่รวมไว้ในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#fdf6e6] via-[#f5c518] to-[#c8941a] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">สล็อตระบบแน่น เกมพร้อมรัน ออโต้ไวทันใจ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#080502] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#c9bda2]">
        <span>ระบบ / สิทธิพิเศษในเว็บ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#2a1c06] bg-[#080502] px-3.5 py-2.5 transition-colors hover:border-[#f5c518]/55 hover:bg-[#2a1c06]/80">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f0e6d2]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#ffe9a3]/60 bg-[#c8941a] px-2.5 py-0.5 text-[10px] font-bold text-[#080502]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#c9bda2]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#c8941a]/40 bg-[#080502] px-3 py-1 text-[10px] font-bold text-[#ffe9a3]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#c9bda2]">
        รายละเอียดทั้งหมดเป็นข้อมูลอ้างอิงสำหรับผู้เล่น ควรตรวจอัตราการจ่ายและรายละเอียดฟีเจอร์ของแต่ละเกม เงื่อนไขการรับสิทธิ์ และเพดานถอนจากหน้าโปรโมชั่นจริงของ ASHTON168 ก่อนกดรับทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
