---
import ContentBoxTwoPremium from "./ContentBoxTwoPremium.astro";

// Widget ไม่ใช่ article — ทุกหัวข้อในนี้เป็น <p>/<span> และชื่อสำหรับ assistive
// tech มาจาก prop `label` ที่ส่งให้ ContentBoxTwoPremium ไม่มีการส่ง `title`
// บล็อกนี้จึงไม่ปล่อยหัวข้อออกมาเลย
//
// UOK789: โครงสองคอลัมน์ย้ายจาก ContentBoxTwoCyberCut (ซึ่งแบรนด์ก่อนหน้าใช้อยู่)
// มาเป็น ContentBoxTwoPremium ตามการหมุน variant รอบนี้ และย้ายจากนีออนม่วงคู่ทอง
// มาที่เขียวมรกตคู่ทองเมทัลลิก — เขียว #2fc44f / #b6ecbd / #12923a / #0a4d1c
// คู่ทอง #f6c945 / #fdf3c9 / #8a6a1c บนผิว #08290f / #04140a ขอบ/แถบยก #0c3d18
// เนื้อความ #e8f3e4 หมึกบนปุ่มทอง #04140a เขียว LINE #00B900 กับจุด live สีเขียว
// Tailwind เป็นสีเชิงความหมาย ไม่ถูกแตะ (ค่า hex ของแบรนด์เก่าไม่พิมพ์ไว้ตรงนี้ —
// Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history)
//
// เนื้อหาตาม brief ของแบรนด์นี้: สล็อตออนไลน์ค่ายแท้ที่เชื่อมตรงผ่าน API ไม่ผ่าน
// เอเย่นต์ ล็อบบี้อัปเดตเกมใหม่ต่อเนื่อง โบนัสจัดหนักทั้งเติมเงินรายวัน เครดิต
// ต้อนรับสมาชิกใหม่และคืนยอดเสีย เว็บทุนหนาจ่ายจริงถอนหลักแสนก็เต็มจำนวน ไม่ล็อกยูส
// และฝากถอนออโต้เสร็จในไม่กี่วินาทีตลอด 24 ชั่วโมง
const menus = [
  {
    icon: "🔗",
    name: "เชื่อมตรงกับเซิร์ฟเวอร์หลักของค่ายผ่าน API",
    detail: "ระบบต่อตรงกับเซิร์ฟเวอร์หลักของค่ายเกมโดยไม่ผ่านเอเย่นต์หรือคนกลาง จึงไม่มีการดัดแปลงโปรแกรม ไม่ปรับลดเปอร์เซ็นต์ชนะ และไม่ล็อกผลใดๆ ทุกสปินลื่นไหลไร้ปัญหากระตุก",
    tag: "ค่ายแท้ 100%",
  },
  {
    icon: "🎰",
    name: "ล็อบบี้อัปเดตเกมใหม่เข้ามาไม่ขาดสาย",
    detail: "มีทั้งเกมฮิตติดลมบนที่ใครๆ ก็ปั่น และเกมนอกกระแสฟีเจอร์เด็ดที่พร้อมแตกหนัก เลือกสลับเปลี่ยนเล่นได้ไม่มีซ้ำ ทำให้มีตัวเลือกหลากหลายและสดใหม่อยู่ตลอดเวลา",
    tag: "ตัวเด็ดเข้าไม่พัก",
  },
  {
    icon: "🎁",
    name: "โบนัสจัดหนักซัพพอร์ตสมาชิกทุกระดับ",
    detail: "ทั้งโปรโมชันเติมเงินรายวัน เครดิตพิเศษต้อนรับสมาชิกใหม่ และกิจกรรมคืนยอดเสียที่แจกให้อย่างต่อเนื่อง ช่วยเพิ่มทุนในการปั่นให้หมุนลุ้นรอบแจ็คพอตได้นานขึ้นโดยไม่ต้องใช้ทุนเยอะ",
    tag: "เพิ่มทุนต่อเนื่อง",
  },
  {
    icon: "💰",
    name: "เว็บทุนหนาจ่ายจริงรับยอดแบบไม่เล่นแง่",
    detail: "ถอนหลักร้อยหรือสปินแตกโบนัสใหญ่หลักแสน ทางเว็บก็อนุมัติและโอนออกให้เต็มจำนวน ไร้ประวัติการเบี้ยว ยอดไม่ค้าง และไม่มีการอ้างเงื่อนไขจุกจิกมาประวิงเวลา",
    tag: "จ่ายเต็มจำนวน",
  },
  {
    icon: "🔓",
    name: "ไม่ล็อกยูส เล่นได้เต็มสไตล์ทุกแนว",
    detail: "จะเป็นสายปรับเบทขึ้นลง สายซื้อฟีเจอร์ หรือชอบสลับเล่นหลายค่ายในวันเดียว ระบบก็รองรับอย่างโปร่งใส ไร้การควบคุมอัตราแพ้ชนะ ปล่อยให้ทุกการทำกำไรเป็นไปตามกลยุทธ์และดวงจริงๆ",
    tag: "ไร้ข้อจำกัด",
  },
  {
    icon: "⚙️",
    name: "ฝากถอนออโต้เสร็จในไม่กี่วินาที",
    detail: "ทุกรายการฝากและถอนดำเนินการผ่านระบบอัตโนมัติ ไม่ต้องส่งสลิปให้แอดมินตรวจสอบ และไม่ต้องเสียเวลานั่งคอย บริหารจัดการทุนกับถอนกำไรไปใช้ได้อย่างฉับไวไร้รอยต่อ",
    tag: "ไม่ต้องส่งสลิป",
  },
  {
    icon: "🕐",
    name: "จัดการยอดได้คล่องตลอดทั้งวัน",
    detail: "ระบบการเงินทำงานเป็นขั้นตอนตลอด 24 ชั่วโมง ลดเวลารอในทุกรายการ จะเติมทุนกลางดึกหรือถอนกำไรตอนเช้าก็ทำได้จากยูสเซอร์เดียวโดยไม่ต้องรอรอบอนุมัติของใคร",
    tag: "ทำรายการ 24 ชม.",
  },
];

const chips = ["สล็อตออนไลน์ค่ายแท้", "เชื่อมตรงผ่าน API", "ตัวเด็ดเข้าไม่พัก", "โบนัสจัดหนัก", "เว็บทุนหนาจ่ายจริง", "ไม่ล็อกยูส", "ฝากถอนออโต้"];
---

<ContentBoxTwoPremium
  titleleft="เข้าสู่ระบบ UOK789"
  titleright="ระบบและสิทธิพิเศษของ UOK789 ที่รวมไว้ในบัญชีเดียว"
  label="เข้าสู่ระบบ UOK789 และตารางอ้างอิงระบบกับสิทธิพิเศษภายในเว็บ">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#2fc44f]/30 bg-[#08290f] p-6 shadow-[0_10px_30px_rgba(47,196,79,0.22)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#0a4d1c]/70 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f6c945]/45 bg-gradient-to-br from-[#fdf3c9] via-[#f6c945] to-[#8a6a1c] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fdf3c9]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#e8f3e4]/75">
            กรอกเบอร์โทรศัพท์และรหัสผ่านที่ตั้งไว้ ก็เข้าปั่นสล็อตค่ายแท้ทุกค่ายของ UOK789 ได้จากจุดเดียว พร้อมทำรายการฝากถอนผ่านระบบออโต้ได้ตลอด 24 ชั่วโมง
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#2fc44f]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#0c3d18] bg-[#04140a] py-3 pr-4 pl-12 text-[#e8f3e4] transition-all outline-none placeholder:text-[#e8f3e4]/55 focus:border-[#2fc44f] focus:ring-1 focus:ring-[#2fc44f]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#2fc44f]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#0c3d18] bg-[#04140a] py-3 pr-4 pl-12 text-[#e8f3e4] transition-all outline-none placeholder:text-[#e8f3e4]/55 focus:border-[#2fc44f] focus:ring-1 focus:ring-[#2fc44f]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#e8f3e4]/80">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#0c3d18] bg-[#04140a] accent-[#2fc44f]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#e8f3e4]/80 transition-colors hover:text-[#b6ecbd]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#8a6a1c]/50 bg-gradient-to-r from-[#fdf3c9] via-[#f6c945] to-[#8a6a1c] p-3.5 font-black text-[#04140a] shadow-[0_10px_30px_rgba(246,201,69,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(246,201,69,0.45)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#e8f3e4]/70">
          <span class="h-px flex-1 bg-[#0c3d18]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#0c3d18]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#2fc44f]/30 bg-[#04140a] px-2.5 py-1 text-[10px] font-bold text-[#b6ecbd]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#0c3d18] bg-[#04140a] px-2.5 py-1 text-[10px] font-bold text-[#e8f3e4]/80"><span aria-hidden="true">🕐</span> ทำรายการได้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#2fc44f] transition-colors hover:text-[#f6c945]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#2fc44f]/30 bg-[#08290f] p-5 shadow-[0_10px_30px_rgba(47,196,79,0.22)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#e8f3e4]/75">ตารางอ้างอิงระบบและสิทธิพิเศษที่รวมไว้ในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#f4fdf3] via-[#b6ecbd] to-[#f6c945] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">สล็อตค่ายแท้ โบนัสจัดหนัก</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#04140a] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#e8f3e4]/75">
        <span>ระบบ / สิทธิพิเศษในเว็บ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#0c3d18] bg-[#04140a] px-3.5 py-2.5 transition-colors hover:border-[#2fc44f]/55 hover:bg-[#0c3d18]/80">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e8f3e4]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#fdf3c9]/60 bg-[#f6c945] px-2.5 py-0.5 text-[10px] font-bold text-[#04140a]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#e8f3e4]/75">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#2fc44f]/30 bg-[#04140a] px-3 py-1 text-[10px] font-bold text-[#b6ecbd]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#e8f3e4]/70">
        รายละเอียดทั้งหมดเป็นข้อมูลอ้างอิงสำหรับผู้เล่น ควรตรวจอัตราการจ่ายและเงื่อนไขฟีเจอร์ของแต่ละเกม เงื่อนไขการรับสิทธิ์ และเพดานถอนจากหน้าโปรโมชั่นจริงของ UOK789 ก่อนกดรับทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwoPremium>
