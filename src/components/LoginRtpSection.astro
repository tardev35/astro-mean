---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Widget ไม่ใช่ article — ทุกหัวข้อในนี้เป็น <p>/<span> และชื่อสำหรับ assistive
// tech มาจาก prop `label` ที่ส่งให้ ContentBoxTwo ไม่มีการส่ง `title` บล็อกนี้จึง
// ไม่ปล่อยหัวข้อออกมาเลย
//
// MONACO89: ย้ายจากชุดสีทองมังกรจีนคู่แดงบนดำของแบรนด์ก่อนหน้า (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history) มาที่ทองแอมเบอร์–คอปเปอร์คู่แดงรอยัลบนมะฮอกกานีดำ —
// ทอง #ffe9b8 / #ffd77a / #ef8f22 / #a44516 คู่แดง #d1201a / #7e120e บนผิว
// #26150a / #160d05 / #0b0602 / #3a2109 เนื้อความ #f6e3c0 ข้อความรอง #c9a06a
// เขียว LINE #00B900 กับจุด live สีเขียวเป็นสีเชิงความหมาย ไม่ถูกแตะ
//
// เนื้อหาตาม brief ของแบรนด์สล็อตพรีเมียม: กริดเกมอินเตอร์ค่ายใหญ่ในหน้าเดียว,
// ระบบตรง API แท้ส่งตรงจากเซิร์ฟเวอร์หลักไม่ผ่านเอเย่นต์, ฟีเจอร์ตัวคูณ/ฟรีสปิน/
// สุ่มแจกรางวัลใหญ่, ไม่ล็อกยูสเซอร์, ระบบหลังบ้านเข้าสู่ระบบไว สลับค่ายไร้รอยต่อ,
// ฝากถอนอัตโนมัติแม่นยำ, ทีมงานดูแล 24 ชั่วโมง — ไม่มีคำว่าโต๊ะสด/ดีลเลอร์
const menus = [
  { icon: "🎰", name: "กริดเกมอินเตอร์ครบหน้าเดียว", detail: "รวมเกมสล็อตตัวดังจากค่ายใหญ่ทั่วโลกไว้ในล็อบบี้เดียว ไม่ต้องไล่หาทีละเว็บให้เสียเวลา", tag: "ค่ายดังครบ" },
  { icon: "🔗", name: "ระบบตรง API แท้จากค่ายเกม", detail: "สัญญาณส่งตรงจากเซิร์ฟเวอร์หลัก ไม่ผ่านเอเย่นต์หรือคนกลาง ทุกสปินจึงเที่ยงตรงและลื่นไหล", tag: "ไม่ผ่านเอเย่นต์" },
  { icon: "✨", name: "ฟีเจอร์โบนัสแตกบ่อยทุกรอบ", detail: "ตัวคูณเงินรางวัลแบบทวีคูณ สัญลักษณ์พิเศษที่เข้าโหมดฟรีสปินได้ง่ายขึ้น และการสุ่มแจกรางวัลใหญ่", tag: "โบนัสแตกบ่อย" },
  { icon: "🔓", name: "ไม่ล็อกยูสเซอร์ทุกกรณี", detail: "เล่นได้กำไรมากแค่ไหนหรือเปลี่ยนสไตล์เบทบ่อยเท่าใด ก็ไม่มีการปรับลดอัตราการชนะมากวนใจ", tag: "ไม่ล็อกยูส" },
  { icon: "🔄", name: "สลับค่ายเกมแบบไร้รอยต่อ", detail: "ระบบหลังบ้านจัดการเข้าสู่ระบบให้รวดเร็ว เปลี่ยนค่ายกลางคันได้ทันทีโดยไม่ต้องโยกเงิน", tag: "สลับค่ายไว" },
  { icon: "⚡", name: "ฝากถอนอัตโนมัติจัดการยอดแม่นยำ", detail: "ทั้งเติมทุนและถอนกำไรทำได้เองแบบออโต้ ไม่ต้องส่งสลิป รองรับธนาคารและทรูวอเลท", tag: "ออโต้ทั้งระบบ" },
  { icon: "🎧", name: "ทีมงานซัพพอร์ตตลอด 24 ชั่วโมง", detail: "ติดขัดเรื่องการใช้งาน สงสัยเงื่อนไขโปรโมชัน หรืออยากได้คำแนะนำ ก็ทักถามได้ทันทีทุกเวลา", tag: "ดูแลทุกวัน" },
];

const chips = ["สล็อตพรีเมียม", "ระบบตรง API แท้", "โบนัสแตกบ่อย", "ไม่ล็อกยูส", "เบทขั้นต่ำ 1 บาท", "ถอนไวใน 10 วินาที", "ดูแล 24 ชั่วโมง"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ MONACO89" titleright="ระบบและสิทธิพิเศษของ MONACO89 ที่รวมไว้ในบัญชีเดียว" label="เข้าสู่ระบบ MONACO89 และตารางอ้างอิงระบบกับสิทธิพิเศษภายในเว็บ">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#ef8f22]/30 bg-[#26150a] p-6 shadow-[0_10px_30px_rgba(239,143,34,0.22)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#d1201a]/45 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ef8f22]/45 bg-gradient-to-br from-[#ffd77a] via-[#ef8f22] to-[#a44516] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ef8f22]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#c9a06a]">กรอกเบอร์โทรศัพท์และรหัสผ่านที่ตั้งไว้ ก็เข้าล็อบบี้เกมสล็อตทุกค่ายของ MONACO89 ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ef8f22]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#3a2109] bg-[#0b0602] py-3 pr-4 pl-12 text-[#f6e3c0] transition-all outline-none placeholder:text-[#c9a06a]/70 focus:border-[#ef8f22] focus:ring-1 focus:ring-[#ef8f22]/60"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ef8f22]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#3a2109] bg-[#0b0602] py-3 pr-4 pl-12 text-[#f6e3c0] transition-all outline-none placeholder:text-[#c9a06a]/70 focus:border-[#ef8f22] focus:ring-1 focus:ring-[#ef8f22]/60"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#c9a06a]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#3a2109] bg-[#0b0602] accent-[#ef8f22]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#c9a06a] transition-colors hover:text-[#ef8f22]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#a44516]/50 bg-gradient-to-r from-[#ffd77a] via-[#ef8f22] to-[#a44516] p-3.5 font-black text-[#1a0d03] shadow-[0_10px_30px_rgba(239,143,34,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(239,143,34,0.45)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#c9a06a]">
          <span class="h-px flex-1 bg-[#3a2109]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#3a2109]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#ef8f22]/30 bg-[#0b0602] px-2.5 py-1 text-[10px] font-bold text-[#ef8f22]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#3a2109] bg-[#0b0602] px-2.5 py-1 text-[10px] font-bold text-[#c9a06a]"><span aria-hidden="true">🕐</span> ทำรายการได้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ffd77a] transition-colors hover:text-[#ef8f22]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#ef8f22]/30 bg-[#26150a] p-5 shadow-[0_10px_30px_rgba(239,143,34,0.22)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#c9a06a]">ตารางอ้างอิงระบบและสิทธิพิเศษที่รวมไว้ในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#ffe9b8] via-[#ef8f22] to-[#a44516] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ระบบตรง API แท้ โบนัสแตกบ่อย</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#0b0602] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#c9a06a]">
        <span>ระบบ / สิทธิพิเศษในเว็บ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#3a2109] bg-[#0b0602] px-3.5 py-2.5 transition-colors hover:border-[#ef8f22]/55 hover:bg-[#3a2109]/70">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f6e3c0]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#a44516]/60 bg-[#ef8f22] px-2.5 py-0.5 text-[10px] font-bold text-[#1a0d03]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#c9a06a]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#ef8f22]/30 bg-[#0b0602] px-3 py-1 text-[10px] font-bold text-[#ef8f22]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#9c7648]">
        รายละเอียดทั้งหมดเป็นข้อมูลอ้างอิงสำหรับผู้เล่น ควรตรวจเดิมพันขั้นต่ำและสูงสุดของแต่ละเกม เงื่อนไขการรับสิทธิ์ และเพดานถอนจากหน้าโปรโมชั่นจริงของ MONACO89 ก่อนกดรับทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
