---
const {
  message = "ZEED321 เว็บสล็อตสายมันส์ จังหวะดีทุกการเล่น • เกมครบมือไว้ให้เลือกแบบไม่มีคำว่าเบื่อ สลับสไตล์ได้ตลอดเวลา • เกมเด็ดเข้าไม่พัก ค่ายแท้ครบทุกแนว อัปเดตความสนุกอยู่เสมอ • โบนัสแน่นทุกช่วงเวลา เติมสีสันให้ทุกการหมุนมีอะไรให้ลุ้นมากกว่าเดิม • ระบบเสถียรปลอดภัย ฝาก-ถอนออโต้ เล่นต่อเนื่องได้แบบไม่มีสะดุด",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div
    class="relative flex overflow-hidden border border-[#ff2f28]/55 bg-[#170506]/92 shadow-[0_0_15px_rgba(255,47,40,0.32)] backdrop-blur-md"
    style="clip-path: polygon(15px 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#8f0806] to-[#ff2f28] px-6 py-2.5 font-black text-[#ffe08a]"
      style="clip-path: polygon(0 0, 100% 0, calc(100% - 10px) 100%, 0 100%);">
      ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#170506] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#f3dede]">
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 bg-[#f5c542] shadow-[0_0_8px_rgba(245,197,66,1)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 bg-[#f5c542] shadow-[0_0_8px_rgba(245,197,66,1)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
