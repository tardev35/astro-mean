---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const targetPath = imagePaths.find((path) => path.endsWith(".webp")) || imagePaths.find((path) => path.endsWith(".png")) || (imagePaths.length > 0 ? imagePaths[0] : null);
const mainLogo = targetPath ? images[targetPath].default : null;

// PABO88: ย้ายจากชมพูนีออนของ TUNGMA168 (#ff3d9a / #ff8ec4 / #ffa6d2 /
// #fdeaf4 / #d9a7c4 / #a97b96 / #7d0f46 บนผิว #100309) มาเป็นนีออนม่วงคู่ทอง
// — ม่วง #bf3cfa / #e3b8ff / #8b1fd6 / #4a0b8f บนผิว #0a0118 เนื้อความ
// #ece0ff มิวต์ #b79ad6 / #9b7fbd คู่ทอง #f5c518 / #ffe9a3
//
// ป้ายหัวคอลัมน์เป็น <p> ไม่ใช่ heading — footer ขึ้นทุกหน้า ถ้าเป็น <h2>
// จะกลายเป็น h2 ที่ไม่ได้มาจาก docx อยู่ทุกหน้าพร้อมกัน
//
// บล็อก <address> คัดมาตรงๆ จาก SKILL.md ห้ามใส่สีของแบรนด์ลงไป — มันใช้
// border-white/15 + bg-black/20 + opacity บนสีตัวอักษรที่ inherit มา ซึ่งลง
// ตัวกับ footer ทุก variant ในคลัง (เข้มหมด) การพิมพ์ hex ของรอบนี้ใส่คือ
// วิธีที่ hex ของแบรนด์นี้จะค้างไปถึงแบรนด์หน้า
//
// PABO88 เป็นเว็บสล็อต หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ ห้ามมีลิงก์ถึง
const shortcuts = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];
---

<footer
  class="relative mt-12 w-full overflow-hidden rounded-t-[3rem] border-t-2 border-[#bf3cfa] bg-[#0a0118] pt-16 pb-8 font-sans text-[#ece0ff] shadow-[0_-10px_30px_rgba(191,60,250,0.20)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[200px] w-full max-w-4xl rounded-full bg-[#bf3cfa]/12 blur-[80px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1400px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-4 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#bf3cfa]/35 bg-[#160333] px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ PABO88 อักษร PABO สีม่วงเมทัลลิกไล่เงา ต่อด้วยเลข 88 สีเงิน"
                widths={[150, 300, 450]}
                sizes="150px"
                class="h-[50px] w-auto object-contain"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest">
                <span class="text-[#e3b8ff]">PABO</span>
                <span class="text-[#d9d9e3]">88</span>
              </span>
            )
          }
        </a>
        <p class="mt-2 border-l-2 border-[#bf3cfa] pl-4 text-sm leading-relaxed text-[#b79ad6]">
          PABO88 เว็บสล็อตคัดของดี คัดเฉพาะเกมแตกง่ายจากค่ายชั้นนำมารวมไว้ในเว็บเดียว โปรถึงโบนัสแรงทั้งสมาชิกใหม่และสมาชิกเก่า พร้อมระบบฝากถอนออโต้ที่ทำรายการเองได้ตลอด 24 ชั่วโมง
        </p>
        <div class="mt-2 flex gap-3">
          <span class="rounded-sm border border-[#bf3cfa]/35 bg-[#4a0b8f]/40 px-3 py-1 text-[10px] font-bold text-[#e3b8ff]">HTTPS / SSL</span>
          <span class="rounded-sm border border-[#f5c518]/35 bg-[#f5c518]/10 px-3 py-1 text-[10px] font-bold text-[#ffe9a3]">AUTO 24 HR</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-12">
        <p class="border-b border-[#bf3cfa]/30 pb-2 text-base font-black tracking-widest text-[#faf5ff] uppercase">ทางลัดหน้าเว็บ</p>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#b79ad6]">
          {
            shortcuts.map((item) => (
              <li>
                <a href={item.path} class="flex items-center gap-2 transition-colors hover:text-[#e3b8ff]">
                  <span aria-hidden="true" class="text-[#bf3cfa]">
                    ▸
                  </span>
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-4 md:col-span-4">
        <p class="border-b border-[#bf3cfa]/30 pb-2 text-base font-black tracking-widest text-[#faf5ff] uppercase">บริการลูกค้า 24 ชม.</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-md bg-gradient-to-r from-green-600 to-green-500 py-3 text-sm font-black text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน (LINE)
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2 text-xs font-bold text-[#9b7fbd]">รองรับทุกธนาคารและทรูมันนี่วอเลท:</div>
        <BankStrip size={32} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#bf3cfa]/15 pt-6 text-xs font-medium text-[#9b7fbd] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} PABO88-HOME.COM. ALL RIGHTS RESERVED.</p>
      <div class="mt-3 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ece0ff]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ece0ff]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>
