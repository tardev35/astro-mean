---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label } = Astro.props;

// หัวข้อสามคอลัมน์เดิมเป็น <h2> คอลัมน์ละตัว ทำให้หนึ่ง section ของ docx กลายเป็น
// สามหัวข้อบนหน้าเว็บ ทั้งสามเป็น "ป้ายคอลัมน์" ไม่ใช่ section ของ docx จึงถูกลด
// เป็น <p> (คงคลาสเดิมไว้) แล้วเพิ่ม prop `title` ตัวเดียวเป็นหัวข้อที่ component
// นี้ปล่อยออกมาได้ — วิธีเดียวกับที่ ContentBox3Three/ContentBoxTwo ทำไว้แล้ว
//
// GUESS168: variant นี้ผ่านมาหลายแบรนด์ (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind
// สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้
// ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history) รอบนี้ย้ายมาที่ทองหลอมที่วัดจาก
// อาร์ตของแบรนด์นี้ — #fecc02 / #ffd54a / #ffe680 / #fff6e0 / #c58a00 คู่ส้มไฟ
// #fe9c01 / #a35800 ที่ถือเส้นมุมฝั่งล่างขวา บนผิว #140800 เนื้อความ #f7e7c6
const sectionLabel = title ? undefined : (label ?? titleleft ?? titlecenter ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#c58a00]/40 bg-[#140800]/92 p-8 text-[#f7e7c6] shadow-[0_0_25px_rgba(254,204,2,0.25)] backdrop-blur-md transition-all duration-300 hover:border-[#ffd54a] hover:shadow-[0_0_40px_rgba(254,204,2,0.35)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#fecc02] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#fe9c01] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#fecc02] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#fe9c01] to-transparent"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#c58a00]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff6e0] via-[#fecc02] to-[#a35800] shadow-[0_0_10px_rgba(254,204,2,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff6e0] via-[#ffe680] to-[#c58a00] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#c58a00]/30 pb-6 text-left text-base leading-relaxed text-[#f7e7c6] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#fecc02] uppercase">
              <span aria-hidden="true" class="h-2 w-2 shrink-0 bg-[#ffe680] shadow-[0_0_5px_rgba(254,204,2,0.8)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#c58a00]/30 pb-6 text-left text-base leading-relaxed text-[#f7e7c6] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#fecc02] uppercase">
              <span aria-hidden="true" class="h-2 w-2 shrink-0 bg-[#ffe680] shadow-[0_0_5px_rgba(254,204,2,0.8)]" /> {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e7c6] md:pl-6">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#fecc02] uppercase">
              <span aria-hidden="true" class="h-2 w-2 shrink-0 bg-[#ffe680] shadow-[0_0_5px_rgba(254,204,2,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
