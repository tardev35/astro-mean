---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label } = Astro.props;

// หัวข้อสามคอลัมน์เดิมเป็น <h2> คอลัมน์ละตัว ทำให้หนึ่ง section ของ docx กลายเป็น
// สามหัวข้อบนหน้าเว็บ ทั้งสามเป็น "ป้ายคอลัมน์" ไม่ใช่ section ของ docx จึงถูกลด
// เป็น <p> (คงคลาสเดิมไว้) แล้วเพิ่ม prop `title` ตัวเดียวเป็นหัวข้อที่ component
// นี้ปล่อยออกมาได้ — วิธีเดียวกับที่ ContentBox3Three/ContentBoxTwo ทำไว้แล้ว
//
// BLACKJACK789: variant นี้ผ่านมาหลายแบรนด์ (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind
// สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้
// ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history) รอบนี้ย้ายมาที่ทองแอนทีค/แชมเปญคู่
// กราไฟต์ที่วัดจากอาร์ตของแบรนด์นี้ — ทอง #fdf1ce / #f2cf70 / #d3aa4b / #b8862c /
// #5c4113 คู่กราไฟต์ #cfd6e0 / #8e97a6 ที่ถือเส้นมุมฝั่งล่างขวา บนผิว #100b05
// เนื้อความ #ede0c4
//
// รอบนี้ไฟล์นี้แบกหัวข้อ docx ข้อ 3 เรื่องคัดค่ายดังเกมแท้ระดับ A-List แล้วส่งต่อให้
// ProviderGrid กางโลโก้ค่ายที่ย่อหน้าเดียวกันเอ่ยชื่อไว้
const sectionLabel = title ? undefined : (label ?? titleleft ?? titlecenter ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#5c4113]/45 bg-[#100b05]/92 p-8 text-[#ede0c4] shadow-[0_0_25px_rgba(211,170,75,0.25)] backdrop-blur-md transition-all duration-300 hover:border-[#f2cf70] hover:shadow-[0_0_40px_rgba(211,170,75,0.35)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#d3aa4b] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#cfd6e0] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#d3aa4b] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#cfd6e0] to-transparent"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#5c4113]/35 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf1ce] via-[#d3aa4b] to-[#5c4113] shadow-[0_0_10px_rgba(211,170,75,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdf1ce] via-[#f2cf70] to-[#b8862c] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#5c4113]/35 pb-6 text-left text-base leading-relaxed text-[#ede0c4] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#f2cf70] uppercase">
              <span aria-hidden="true" class="h-2 w-2 shrink-0 bg-[#cfd6e0] shadow-[0_0_5px_rgba(207,214,224,0.8)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#5c4113]/35 pb-6 text-left text-base leading-relaxed text-[#ede0c4] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#f2cf70] uppercase">
              <span aria-hidden="true" class="h-2 w-2 shrink-0 bg-[#cfd6e0] shadow-[0_0_5px_rgba(207,214,224,0.8)]" /> {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ede0c4] md:pl-6">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#f2cf70] uppercase">
              <span aria-hidden="true" class="h-2 w-2 shrink-0 bg-[#cfd6e0] shadow-[0_0_5px_rgba(207,214,224,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
