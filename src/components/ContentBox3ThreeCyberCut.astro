---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label } = Astro.props;

// หัวข้อสามคอลัมน์เดิมเป็น <h2> คอลัมน์ละตัว ทำให้หนึ่ง section ของ docx กลายเป็น
// สามหัวข้อบนหน้าเว็บ ทั้งสามเป็น "ป้ายคอลัมน์" ไม่ใช่ section ของ docx จึงถูกลด
// เป็น <p> (คงคลาสเดิมไว้) แล้วเพิ่ม prop `title` ตัวเดียวเป็นหัวข้อที่ component
// นี้ปล่อยออกมาได้ — วิธีเดียวกับที่ ContentBox3Three/ContentBoxTwo ทำไว้แล้ว
//
// UOK789: variant นี้ผ่านมาหลายแบรนด์ ตั้งแต่แดง Tailwind ล้วน ทองมังกร แดงสัญญาณ
// เขียวมังกรนีออน ทองคาสิโนจีนคู่แดงมงคล จนถึงฟ้านีออนใต้ทะเลของรอบก่อน (ค่า hex
// เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์
// จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
// รอบนี้ย้ายมาที่เขียวมรกตคู่ทองเมทัลลิก #2fc44f / #b6ecbd / #0a4d1c คู่ทอง
// #f6c945 / #fdf3c9 บนผิว #04140a เนื้อความ #e8f3e4 ไม่มีฟ้าและไม่มีแดงเหลืออยู่
const sectionLabel = title ? undefined : (label ?? titleleft ?? titlecenter ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#2fc44f]/40 bg-[#04140a]/92 p-8 text-[#e8f3e4] shadow-[0_0_25px_rgba(47,196,79,0.25)] backdrop-blur-md transition-all duration-300 hover:border-[#b6ecbd] hover:shadow-[0_0_40px_rgba(47,196,79,0.35)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#2fc44f] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#f6c945] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#2fc44f] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#f6c945] to-transparent"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#2fc44f]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#b6ecbd] via-[#2fc44f] to-[#0a4d1c] shadow-[0_0_10px_rgba(47,196,79,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f4fdf3] via-[#b6ecbd] to-[#2fc44f] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#2fc44f]/30 pb-6 text-left text-base leading-relaxed text-[#e8f3e4] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#f6c945] uppercase">
              <span aria-hidden="true" class="h-2 w-2 shrink-0 bg-[#fdf3c9] shadow-[0_0_5px_rgba(253,243,201,0.8)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#2fc44f]/30 pb-6 text-left text-base leading-relaxed text-[#e8f3e4] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#f6c945] uppercase">
              <span aria-hidden="true" class="h-2 w-2 shrink-0 bg-[#fdf3c9] shadow-[0_0_5px_rgba(253,243,201,0.8)]" /> {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8f3e4] md:pl-6">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#f6c945] uppercase">
              <span aria-hidden="true" class="h-2 w-2 shrink-0 bg-[#fdf3c9] shadow-[0_0_5px_rgba(253,243,201,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
