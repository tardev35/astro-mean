---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label } = Astro.props;

// หัวข้อสามคอลัมน์เดิมเป็น <h2> คอลัมน์ละตัว ทำให้หนึ่ง section ของ docx กลายเป็น
// สามหัวข้อบนหน้าเว็บ ทั้งสามเป็น "ป้ายคอลัมน์" ไม่ใช่ section ของ docx จึงถูกลด
// เป็น <p> (คงคลาสเดิมไว้) แล้วเพิ่ม prop `title` ตัวเดียวเป็นหัวข้อที่ component
// นี้ปล่อยออกมาได้ — วิธีเดียวกับที่ ContentBox3Three/ContentBoxTwo ทำไว้แล้ว
//
// ORCA789: variant นี้เคยเป็นแดง Tailwind ล้วน แล้วผ่านทองมังกรของ LONGSAP168,
// แดงสัญญาณของ FAST369, เขียวมังกรนีออน และรอบล่าสุดเป็นทองคาสิโนจีนคู่แดงมงคล
// ของ MAHAHENG333 (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิม
// ได้จาก git history) รอบนี้ย้ายมาที่ฟ้านีออนใต้ทะเล #00abfc / #84ccfb / #011dc4
// คู่ทอง #ffd54a / #ffe89a บนผิว #041028 เนื้อความ #dbeafe ไม่มีทองคาสิโนจีนและ
// ไม่มีแดงเหลืออยู่ในไฟล์
const sectionLabel = title ? undefined : (label ?? titleleft ?? titlecenter ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#00abfc]/40 bg-[#041028]/92 p-8 text-[#dbeafe] shadow-[0_0_25px_rgba(0,171,252,0.25)] backdrop-blur-md transition-all duration-300 hover:border-[#84ccfb] hover:shadow-[0_0_40px_rgba(0,171,252,0.35)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#00abfc] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#ffd54a] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#00abfc] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#ffd54a] to-transparent"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#00abfc]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#84ccfb] via-[#00abfc] to-[#011dc4] shadow-[0_0_10px_rgba(0,171,252,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f0f9ff] via-[#84ccfb] to-[#00abfc] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#00abfc]/30 pb-6 text-left text-base leading-relaxed text-[#dbeafe] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffd54a] uppercase">
              <span aria-hidden="true" class="h-2 w-2 shrink-0 bg-[#ffe89a] shadow-[0_0_5px_rgba(255,232,154,0.8)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#00abfc]/30 pb-6 text-left text-base leading-relaxed text-[#dbeafe] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffd54a] uppercase">
              <span aria-hidden="true" class="h-2 w-2 shrink-0 bg-[#ffe89a] shadow-[0_0_5px_rgba(255,232,154,0.8)]" /> {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbeafe] md:pl-6">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffd54a] uppercase">
              <span aria-hidden="true" class="h-2 w-2 shrink-0 bg-[#ffe89a] shadow-[0_0_5px_rgba(255,232,154,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
