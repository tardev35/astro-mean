---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// One source of truth for the menu. This file used to declare the same array
// twice — once for the desktop bar and once for the mobile drawer — which is
// how a route gets added to one and not the other. The icon rides in the data
// next to the label and is rendered as its own aria-hidden <span>, never
// concatenated into the label text (that would put "house หน้าแรก" into the
// accessible name).
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🚪" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "💎" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav
    class="relative mx-auto flex h-[80px] w-full items-center justify-between border-b border-[#f670b7]/40 bg-[#12060f]/95 px-4 shadow-[0_5px_25px_rgba(246,112,183,0.25)] backdrop-blur-xl xl:px-8"
    style="clip-path: polygon(0 0, 100% 0, 100% 100%, 20px 100%, 0 calc(100% - 20px));">
    <a href="/" class="z-[110] flex-shrink-0 transition-transform hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt="โลโก้ PODK888 ตัวการ์ตูนสาวผมชมพูสวมหูฟังเกมมิ่งบนโล่สีดำ พร้อมตัวอักษร PODK สีขาวและเลข 888 สีชมพูนีออน"
            loading="eager"
            widths={[70, 140, 210]}
            sizes="70px"
            class="h-[55px] w-auto drop-shadow-[0_0_12px_rgba(246,112,183,0.6)] xl:h-[70px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <span class="bg-gradient-to-r from-[#f670b7] to-[#e01e83] bg-clip-text text-3xl font-black tracking-wider text-transparent">PODK888</span>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-4 lg:flex xl:gap-7">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1.5 px-1 text-xs font-bold tracking-widest uppercase transition-colors xl:text-sm ${isActive(item.path) ? "text-[#f670b7] drop-shadow-[0_0_8px_rgba(246,112,183,0.8)]" : "text-white/70 hover:text-[#02dbfd]"}`}>
            <span aria-hidden="true" class="text-base">
              {item.icon}
            </span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[4px] w-full bg-[#02dbfd] shadow-[0_-2px_10px_rgba(2,219,253,0.9)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden items-center justify-center border border-[#02dbfd]/70 bg-transparent px-6 py-2 text-sm font-bold text-[#02dbfd] transition-all hover:bg-[#02dbfd]/15 lg:flex"
        style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
        เข้าระบบ
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center bg-gradient-to-r from-[#f670b7] to-[#e01e83] px-6 py-2 text-sm font-black text-[#12060f] shadow-[0_0_15px_rgba(246,112,183,0.45)] transition-all hover:scale-105 lg:flex"
        style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] border border-[#f670b7]/50 bg-[#220f29] lg:hidden"
        style="clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);"
        aria-label="เปิดเมนู"
        aria-controls="mobile-menu"
        aria-expanded="false">
        <span class="line-1 h-[2px] w-6 origin-center bg-[#f670b7] shadow-[0_0_5px_rgba(246,112,183,0.9)] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-6 origin-center bg-[#f670b7] shadow-[0_0_5px_rgba(246,112,183,0.9)] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-6 origin-center bg-[#f670b7] shadow-[0_0_5px_rgba(246,112,183,0.9)] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[80px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col border-b border-[#f670b7]/40 bg-[#12060f]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-xl transition-all duration-300 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 border-l-4 px-4 py-3 text-lg font-bold tracking-widest uppercase transition-colors ${isActive(item.path) ? "border-[#02dbfd] bg-[#e01e83]/20 text-[#f670b7]" : "border-transparent text-white/70 hover:bg-white/5 hover:text-[#02dbfd]"}`}>
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center bg-gradient-to-r from-[#f670b7] to-[#e01e83] py-3.5 text-lg font-black text-[#12060f] shadow-[0_0_15px_rgba(246,112,183,0.45)]"
        style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
        สมัครสมาชิก
      </a>
      <a
        href="/login"
        class="flex w-full justify-center border border-[#02dbfd]/70 bg-transparent py-3.5 text-lg font-bold text-[#02dbfd]"
        style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
        เข้าระบบ
      </a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    const open = hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show", open);
    hamburgerBtn.setAttribute("aria-expanded", String(open));
  });
</script>
