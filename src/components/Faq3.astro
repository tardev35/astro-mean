---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

const { title, faqs = [] } = Astro.props;

// คำถาม render เป็น <span> ไม่ใช่ <h3> — docx ของแบรนด์นี้แบนราบ (H1 ×1 + H2 ×6)
// และ h2/h3 ที่ขึ้นหน้าเว็บถูกเทียบกับ checklist ของ brief ทุกรอบรีแบรนด์ FAQ ห้า
// ข้อที่โผล่มาเป็น <h3> คือสิ่งที่ทำให้การเทียบนั้นไม่ตรง อีกอย่าง <span> เป็น
// ตัวเลือกเดียวที่ปลอดภัยใน <summary> ซึ่ง content model เป็น phrasing content —
// <p> ตรงนั้นไม่ถูกต้องตามสเปก ชื่อ section มาจาก <h2> ที่ขับด้วย prop `title`
// ซึ่งเป็นหัวข้อเดียวที่ component นี้ปล่อยออกมา ห้ามใส่ <script>:
// <details>/<summary> ทำ accordion ได้เองอยู่แล้ว
//
// AURORA688: ย้ายจากทองแอมเบอร์–คอปเปอร์คู่แดงรอยัลของ MONACO89 (#ffe9b8 /
// #ffd77a / #ef8f22 / #a44516 บนผิว #26150a / #160d05 / #0b0602 เนื้อความ #f6e3c0)
// มาที่ทองหรูคู่เงินโครเมียมของแบรนด์นี้ — ทอง #ffe9a3 / #e2c443 / #c9a13a คู่เงิน
// #eef2f7 บนผิว #221c0d / #15120a / #0a0806 เนื้อความ #f2ead6
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <h2 class="bg-gradient-to-r from-[#eef2f7] via-[#e2c443] to-[#c9a13a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </h2>
        <div class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e2c443] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details class="faq-item rounded-3xl border border-[#e2c443]/30 bg-[#15120a]/85 p-2 shadow-[0_10px_30px_rgba(10,8,6,0.8)] backdrop-blur-xl transition-all hover:border-[#e2c443]/60 hover:bg-[#221c0d]/85">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#f2ead6] transition-colors hover:text-[#e2c443]">
            <span class="flex-1 text-left text-sm leading-normal font-bold md:text-base">{faq.q}</span>
            <span aria-hidden="true" class="faq-icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl transition-transform duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#f2ead6]">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  /* The old version animated a grid-rows-[0fr] → [1fr] trick from JS by
     swapping Tailwind classes at runtime, and left the panel in the
     accessibility tree while it was visually collapsed. <details> hides it
     properly and needs no script. */
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: #e2c443;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
