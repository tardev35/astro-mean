---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

const { title, faqs = [] } = Astro.props;

// The question is an <h3> under the section's own <h2>, matching Faq2/FaqHuay.
// It was briefly flattened to <h2> to satisfy "the docx is flat H1+H2", which
// reads the rule backwards: the h2 inventory is diffed against the docx heading
// list on every rebrand, so five FAQ questions sitting at h2 put five headings
// in that diff that the brief never contained. An FAQ *is* a genuine nesting —
// one section heading, N questions beneath it. Do not add a <script>:
// <details>/<summary> handles the accordion natively.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <h2 class="bg-gradient-to-r from-[#b6f38a] via-[#7ee356] to-[#2f8f3a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </h2>
        <div class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#7ee356] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details class="faq-item rounded-3xl border border-[#7ee356]/30 bg-[#0b160d]/85 p-2 shadow-[0_10px_30px_rgba(5,10,6,0.8)] backdrop-blur-xl transition-all hover:border-[#7ee356]/60 hover:bg-[#122a16]/85">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#dcecd6] transition-colors hover:text-[#b6f38a]">
            <h3 class="text-left text-sm leading-normal font-bold md:text-base">{faq.q}</h3>
            <span aria-hidden="true" class="faq-icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl transition-transform duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#dcecd6]/85">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  /* The old version animated a grid-rows-[0fr] → [1fr] trick from JS by
     swapping Tailwind classes at runtime, and left the panel in the
     accessibility tree while it was visually collapsed. <details> hides it
     properly and needs no script. */
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: #7ee356;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
