---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

const { title, faqs = [] } = Astro.props;

// คำถาม render เป็น <span> ไม่ใช่ <h3> — docx ของแบรนด์นี้แบนราบ (H1 ×1 + H2 ×6)
// และ h2/h3 ที่ขึ้นหน้าเว็บถูกเทียบกับ checklist ของ brief ทุกรอบรีแบรนด์ FAQ ห้า
// ข้อที่โผล่มาเป็น <h3> คือสิ่งที่ทำให้การเทียบนั้นไม่ตรง อีกอย่าง <span> เป็น
// ตัวเลือกเดียวที่ปลอดภัยใน <summary> ซึ่ง content model เป็น phrasing content —
// <p> ตรงนั้นไม่ถูกต้องตามสเปก ห้ามใส่ <script>: <details>/<summary> ทำ accordion
// ได้เองอยู่แล้ว
//
// บรรทัดหัวของ section เองก็ถูกลดจาก <h2> เป็น <p> ด้วยเหตุผลเดียวกัน — มันเป็น
// ป้ายของ widget ไม่ใช่ section ของ docx ชื่อสำหรับ assistive tech ย้ายไปอยู่ที่
// aria-label บน <section> แทน หน้าตายังเหมือนเดิมเพราะขนาดกับน้ำหนักอยู่ในคลาส
//
// faqs ไม่มีค่า default เป็นเนื้อหา — หน้าเรียกต้องส่ง prop มาเสมอ ลิสต์ว่างเปล่า
// ปลอดภัยกว่าคำถามของแบรนด์ก่อนที่หลุดขึ้นหน้าเว็บ
//
// AWIN8: ย้ายจากทองแชมเปญเดี่ยวของแบรนด์ก่อนหน้ามาที่น้ำเงินรอยัลคู่ทองส้ม —
// น้ำเงิน #1f6fea / #7fb2ff / #0d3f9e / #07265e บนผิว #02081c / #040e22 / #08172f
// เนื้อความ #d8e6fb และทอง #fca311 / #ffd27a กับขาวฟ้า #e8f1ff ใช้กับไอคอนตอนกาง
// คำตอบและเส้นคั่นใต้หัวข้อ เพื่อให้มีน้ำหนักต่างจากน้ำเงินหลัก
// (ค่า hex ของแบรนด์เก่าไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้
// ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history)
---

<section aria-label={title} class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <p class="bg-gradient-to-r from-[#e8f1ff] via-[#ffd27a] to-[#1f6fea] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </p>
        <div class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fca311] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details class="faq-item rounded-3xl border border-[#0d3f9e]/30 bg-[#040e22]/90 p-2 shadow-[0_10px_30px_rgba(2,8,28,0.8)] backdrop-blur-xl transition-all hover:border-[#1f6fea]/60 hover:bg-[#08172f]/90">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#d8e6fb] transition-colors hover:text-[#7fb2ff]">
            <span class="flex-1 text-left text-sm leading-normal font-bold md:text-base">{faq.q}</span>
            <span aria-hidden="true" class="faq-icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl transition-transform duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#d8e6fb]">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  /* <details> ซ่อนแผงคำตอบให้เองทั้งจากสายตาและจาก accessibility tree จึงไม่ต้องมี
     script มาสลับคลาสเหมือนเวอร์ชันเก่า ตรงนี้เหลือแค่การซ่อนสามเหลี่ยมของเบราว์เซอร์ */
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: #fca311;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
