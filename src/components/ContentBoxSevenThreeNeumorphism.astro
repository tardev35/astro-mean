---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// สองคอลัมน์ถูก flatten แล้ว — คลาสข้อความอยู่บน <article> และ slot เป็นลูกโดยตรง
// ผู้เรียกต้องส่งหนึ่ง element ต่อหนึ่ง slot (ฝั่ง 3 ส่วนรอบนี้รับ <Picture> ใบเดียว)
//
// `title` คือหัวข้อเดียวที่ปล่อยออกมาได้ (วางเหนือคอลัมน์เนื้อความฝั่ง 7 ส่วน) ส่วน
// titleleft/titleright เป็นป้ายคอลัมน์ระดับ <p>
//
// GEN4: ย้ายชุดสีจากส้มไฟคู่ทองของแบรนด์ก่อน มาที่น้ำเงินอิเล็กทริกคู่แดงของแบรนด์
// นี้ที่วัดจากอาร์ตจริง — สีเน้นหลัก #0071d5 / #01a3f3 / #6fd2ff / #00408a คู่แดง
// #e8241c (สีของเลข 4 ในโลโก้ ใช้เป็นสีเน้นรองเท่านั้น) บนผิว #050b1a เนื้อความ
// #d7e7ff ข้อความรอง #8fb4e0 หัวข้อ #eaf4ff (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ —
// Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history)
//
// Neumorphism แปลว่าเงาสองด้านต้องเป็นเฉดเข้ม/อ่อนของสีการ์ดเอง ไม่ใช่สีแบรนด์:
// #01030a (เข้มกว่าพื้นหน้า) เป็นเงาทอด และ #0b1b3a (ผิวการ์ดยกขึ้นหนึ่งขั้น) เป็น
// ไฮไลต์ ถ้าเอาสีน้ำเงินนีออนไปแทน การ์ดจะกลายเป็นแสงเรืองแทนผิวนูน
//
// ไม่มี text-center บนการ์ดหรือ <section> โดยตั้งใจ — ถ้าใส่ มันจะ inherit ลงไปใน
// slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
const sectionLabel = title ? undefined : (label ?? titleright ?? titleleft ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#0071d5]/30 bg-[#050b1a] p-8 shadow-[10px_10px_20px_#01030a,-10px_-10px_20px_#0b1b3a] transition-all duration-300 hover:shadow-[15px_15px_30px_#01030a,-15px_-15px_30px_#12295c]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#8fb4e0]">
        {titleleft && <p class="bg-gradient-to-r from-[#eaf4ff] via-[#6fd2ff] to-[#e8241c] bg-clip-text text-2xl leading-normal font-black text-transparent">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d7e7ff] md:border-l md:border-[#0071d5]/30 md:pl-8">
        {title && <HeadingTag class="bg-gradient-to-r from-[#eaf4ff] via-[#01a3f3] to-[#00408a] bg-clip-text text-2xl leading-normal font-black text-transparent">{title}</HeadingTag>}
        {
          titleright && (
            <p class="flex items-center gap-2 text-xl leading-normal font-black text-[#eaf4ff]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#01a3f3] shadow-[0_0_5px_rgba(1,163,243,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
