---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// สองคอลัมน์ถูก flatten แล้ว — คลาสข้อความอยู่บน <article> และ slot เป็นลูกโดยตรง
// ผู้เรียกต้องส่งหนึ่ง element ต่อหนึ่ง slot
//
// `title` คือหัวข้อเดียวที่ปล่อยออกมาได้ (วางเหนือคอลัมน์เนื้อความ) ส่วน
// titleleft/titleright เป็นป้ายคอลัมน์ระดับ <p>
//
// GDK88: ย้ายจากทองคาสิโนจีนของ MAHAHENG333 (#ffe98a / #e8b923 / #a5760a คู่แดง
// มงคล #b4231c / #6d1410 บนผิว #221708 เนื้อความ #f3e2b8 ข้อความรอง #c2a469) มาที่
// นีออนม่วงคู่ทองของแบรนด์นี้ — สีเน้นหลัก #a855f7 / #d8b4fe / #5b1497 คู่สีเน้นรอง
// ทอง #f0b429 / #ffd85e บนผิว #1b0733 เนื้อความ #ece0ff ข้อความรอง #c9a6f0
//
// Neumorphism แปลว่าเงาสองด้านต้องเป็นเฉดเข้ม/อ่อนของสีการ์ดเอง ไม่ใช่สีแบรนด์:
// #0a0118 (เข้มกว่าพื้นหน้า) เป็นเงาทอด และ #2a0f45 (ผิวการ์ดยกขึ้นหนึ่งขั้น) เป็น
// ไฮไลต์ ถ้าเอา #a855f7 ไปแทน การ์ดจะกลายเป็นแสงเรืองแทนผิวนูน
const sectionLabel = title ? undefined : (label ?? titleright ?? titleleft ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#a855f7]/30 bg-[#1b0733] p-8 shadow-[10px_10px_20px_#0a0118,-10px_-10px_20px_#2a0f45] transition-all duration-300 hover:shadow-[15px_15px_30px_#0a0118,-15px_-15px_30px_#3c0a6b]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#c9a6f0]">
        {titleleft && <p class="bg-gradient-to-r from-[#ffd85e] via-[#f0b429] to-[#a855f7] bg-clip-text text-2xl leading-normal font-black text-transparent">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece0ff] md:border-l md:border-[#a855f7]/30 md:pl-8">
        {title && <HeadingTag class="bg-gradient-to-r from-[#f3e8ff] via-[#d8b4fe] to-[#a855f7] bg-clip-text text-2xl leading-normal font-black text-transparent">{title}</HeadingTag>}
        {
          titleright && (
            <p class="flex items-center gap-2 text-xl leading-normal font-black text-[#d8b4fe]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#f0b429] shadow-[0_0_5px_rgba(240,180,41,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
