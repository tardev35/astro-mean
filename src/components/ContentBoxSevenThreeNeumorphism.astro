---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// สองคอลัมน์ถูก flatten แล้ว — คลาสข้อความอยู่บน <article> และ slot เป็นลูกโดยตรง
// ผู้เรียกต้องส่งหนึ่ง element ต่อหนึ่ง slot (ฝั่ง 3 ส่วนรอบนี้รับ <Picture> ใบเดียว)
//
// `title` คือหัวข้อเดียวที่ปล่อยออกมาได้ (วางเหนือคอลัมน์เนื้อความฝั่ง 7 ส่วน) ส่วน
// titleleft/titleright เป็นป้ายคอลัมน์ระดับ <p>
//
// AURORA688: ย้ายจากม่วงนีออนคู่ทองของ GDK88 (#a855f7 / #d8b4fe / #5b1497 คู่
// #f0b429 / #ffd85e บนผิว #1b0733 เนื้อความ #ece0ff ข้อความรอง #c9a6f0) มาที่ทองหรู
// คู่เงินโครเมียมของแบรนด์นี้ — สีเน้นหลัก #e2c443 / #ffe9a3 / #c9a13a คู่สีเน้นรอง
// เงิน #c3cddb / #eef2f7 บนผิว #15120a เนื้อความ #f2ead6 ข้อความรอง #c8bda1
//
// Neumorphism แปลว่าเงาสองด้านต้องเป็นเฉดเข้ม/อ่อนของสีการ์ดเอง ไม่ใช่สีแบรนด์:
// #050403 (เข้มกว่าพื้นหน้า) เป็นเงาทอด และ #262010 (ผิวการ์ดยกขึ้นหนึ่งขั้น) เป็น
// ไฮไลต์ ถ้าเอา #e2c443 ไปแทน การ์ดจะกลายเป็นแสงเรืองแทนผิวนูน
const sectionLabel = title ? undefined : (label ?? titleright ?? titleleft ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#e2c443]/30 bg-[#15120a] p-8 shadow-[10px_10px_20px_#050403,-10px_-10px_20px_#262010] transition-all duration-300 hover:shadow-[15px_15px_30px_#050403,-15px_-15px_30px_#332b16]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#c8bda1]">
        {titleleft && <p class="bg-gradient-to-r from-[#eef2f7] via-[#c3cddb] to-[#e2c443] bg-clip-text text-2xl leading-normal font-black text-transparent">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2ead6] md:border-l md:border-[#e2c443]/30 md:pl-8">
        {title && <HeadingTag class="bg-gradient-to-r from-[#eef2f7] via-[#ffe9a3] to-[#c9a13a] bg-clip-text text-2xl leading-normal font-black text-transparent">{title}</HeadingTag>}
        {
          titleright && (
            <p class="flex items-center gap-2 text-xl leading-normal font-black text-[#ffe9a3]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#c3cddb] shadow-[0_0_5px_rgba(195,205,219,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
