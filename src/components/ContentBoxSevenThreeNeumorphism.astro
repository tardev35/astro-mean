---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// สองคอลัมน์ถูก flatten แล้ว — คลาสข้อความอยู่บน <article> และ slot เป็นลูกโดยตรง
// ผู้เรียกต้องส่งหนึ่ง element ต่อหนึ่ง slot (ฝั่ง 3 ส่วนรอบนี้รับ <Picture> ใบเดียว)
//
// `title` คือหัวข้อเดียวที่ปล่อยออกมาได้ และออกมาที่ระดับที่ prop `as` สั่ง (docx
// รอบนี้แบน H1 + H2 ล้วน ไม่มี H3) ส่วน titleleft/titleright เป็นป้ายคอลัมน์ระดับ <p>
//
// OKHENG18: ไฟล์นี้มาถึงรอบนี้ในชุดสีของแบรนด์ก่อนหน้า ย้ายทั้งไฟล์มาเป็นแดงเฮงคู่ทอง
// — แดง #ed0133 / #ff5c7a / #ffe3e8 / #a80024 คู่ทอง #ffd400 / #ffe97a บนผิว #150407
// เนื้อความ #f6dde2 ข้อความรอง #c9a3aa (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ —
// Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history)
//
// Neumorphism แปลว่าเงาสองด้านต้องเป็นเฉดเข้ม/อ่อนของสีการ์ดเอง ไม่ใช่สีแบรนด์:
// #050102 (เข้มกว่าพื้นหน้า) เป็นเงาทอด และ #2b070f (ผิวการ์ดยกขึ้นหนึ่งขั้น) เป็น
// ไฮไลต์ ถ้าเอาสีแดงสดไปแทน การ์ดจะกลายเป็นแสงเรืองแทนผิวนูน
//
// ไม่มี text-center บนการ์ดหรือ <section> โดยตั้งใจ — ถ้าใส่ มันจะ inherit ลงไปใน
// slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
const sectionLabel = title ? undefined : (label ?? titleright ?? titleleft ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#ed0133]/30 bg-[#150407] p-8 shadow-[10px_10px_20px_#050102,-10px_-10px_20px_#2b070f] transition-all duration-300 hover:shadow-[15px_15px_30px_#050102,-15px_-15px_30px_#3d0a18]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#c9a3aa]">
        {titleleft && <p class="bg-gradient-to-r from-[#ffe3e8] via-[#ff5c7a] to-[#ed0133] bg-clip-text text-2xl leading-normal font-black text-transparent">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6dde2] md:border-l md:border-[#ed0133]/30 md:pl-8">
        {title && <HeadingTag class="bg-gradient-to-r from-[#ffe3e8] via-[#ff5c7a] to-[#ffd400] bg-clip-text text-2xl leading-normal font-black text-transparent">{title}</HeadingTag>}
        {
          titleright && (
            <p class="flex items-center gap-2 text-xl leading-normal font-black text-[#ffe3e8]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#ffd400] shadow-[0_0_5px_rgba(255,212,0,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
