---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// สองคอลัมน์ถูก flatten แล้ว — คลาสข้อความอยู่บน <article> และ slot เป็นลูกโดยตรง
// ผู้เรียกต้องส่งหนึ่ง element ต่อหนึ่ง slot (ฝั่ง 3 ส่วนรอบนี้รับ <Picture> ใบเดียว)
//
// `title` คือหัวข้อเดียวที่ปล่อยออกมาได้ (วางเหนือคอลัมน์เนื้อความฝั่ง 7 ส่วน) ส่วน
// titleleft/titleright เป็นป้ายคอลัมน์ระดับ <p>
//
// PROFIT55: ย้ายจากหยกเขียวคู่ทองของ KANGFU1688 (ซึ่งก่อนหน้านั้นเป็นนีออนม่วงคู่ทอง
// ของ PABO88 ฟ้านีออนใต้ทะเลของ ORCA789 ทองคู่เงินโครเมียมของ AURORA688 และม่วงนีออน
// ของ GDK88 — ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history) มาที่ทองคู่เงินโครเมียมของ
// แบรนด์นี้ — สีเน้นหลัก #e3ac22 / #f6d24a / #a97d12 คู่เงิน #cfd8e2 / #eef3f8
// บนผิว #0a0702 เนื้อความ #f3e6c4 ข้อความรอง #cbbb92
//
// Neumorphism แปลว่าเงาสองด้านต้องเป็นเฉดเข้ม/อ่อนของสีการ์ดเอง ไม่ใช่สีแบรนด์:
// #030100 (เข้มกว่าพื้นหน้า) เป็นเงาทอด และ #2a1d05 (ผิวการ์ดยกขึ้นหนึ่งขั้น) เป็น
// ไฮไลต์ ถ้าเอา #e3ac22 ไปแทน การ์ดจะกลายเป็นแสงเรืองแทนผิวนูน
//
// ไม่มี text-center บนการ์ดหรือ <section> โดยตั้งใจ — ถ้าใส่ มันจะ inherit ลงไปใน
// slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
const sectionLabel = title ? undefined : (label ?? titleright ?? titleleft ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#e3ac22]/30 bg-[#0a0702] p-8 shadow-[10px_10px_20px_#030100,-10px_-10px_20px_#2a1d05] transition-all duration-300 hover:shadow-[15px_15px_30px_#030100,-15px_-15px_30px_#3a2705]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cbbb92]">
        {titleleft && <p class="bg-gradient-to-r from-[#fffaf0] via-[#e3ac22] to-[#cfd8e2] bg-clip-text text-2xl leading-normal font-black text-transparent">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e6c4] md:border-l md:border-[#e3ac22]/30 md:pl-8">
        {title && <HeadingTag class="bg-gradient-to-r from-[#fffaf0] via-[#f6d24a] to-[#a97d12] bg-clip-text text-2xl leading-normal font-black text-transparent">{title}</HeadingTag>}
        {
          titleright && (
            <p class="flex items-center gap-2 text-xl leading-normal font-black text-[#cfd8e2]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#e3ac22] shadow-[0_0_5px_rgba(227,172,34,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
