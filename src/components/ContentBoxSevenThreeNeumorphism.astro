---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// สองคอลัมน์ถูก flatten แล้ว — คลาสข้อความอยู่บน <article> และ slot เป็นลูกโดยตรง
// ผู้เรียกต้องส่งหนึ่ง element ต่อหนึ่ง slot (ฝั่ง 3 ส่วนรอบนี้รับ <Picture> ใบเดียว)
//
// `title` คือหัวข้อเดียวที่ปล่อยออกมาได้ และออกมาที่ระดับที่ prop `as` สั่ง (docx
// รอบนี้แบน H1 + H2 ล้วน ไม่มี H3) ส่วน titleleft/titleright เป็นป้ายคอลัมน์ระดับ <p>
// รอบนี้ไฟล์นี้เป็น SevenThree ใบที่สองในสองใบของเพดาน playbook คู่กับ slide1
// (อาร์ต "ขาใหญ่ ใจถึง! ฝากต่อเนื่องประจำเดือน ฝาก 20,000 ขึ้นไป รับโบนัสสูงสุด
// 30,000") กับหัวข้อ docx ข้อ 7 เรื่องระบบลั่นพร้อมออโต้ที่ตัดขั้นตอนฝากถอนออกทั้งหมด
//
// 9KPLUS: ไฟล์นี้มาถึงรอบนี้ในชุดสีทองของแบรนด์ก่อนหน้า ย้ายทั้งไฟล์มาเป็นแดงนีออน
// คู่ชมพูบานเย็นบนพื้นเกือบดำ — ชมพูขาว #ffd8e7 / ชมพู #ff4fa3 / แดง #f5003e /
// แดงเข้ม #b3022c / ชมพูเข้ม #7c1040 บนผิว #1f0611 เนื้อความ #ffe3ee ข้อความรอง
// #f0b9cd (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history)
//
// Neumorphism แปลว่าเงาสองด้านต้องเป็นเฉดเข้ม/อ่อนของสีการ์ดเอง ไม่ใช่สีแบรนด์:
// #080104 (เข้มกว่าพื้นหน้า) เป็นเงาทอด และ #350c1e (ผิวการ์ดยกขึ้นหนึ่งขั้น) เป็น
// ไฮไลต์ ถ้าเอาแดงนีออนไปแทน การ์ดจะกลายเป็นแสงเรืองแทนผิวนูน
//
// ไม่มี text-center บนการ์ดหรือ <section> โดยตั้งใจ — ถ้าใส่ มันจะ inherit ลงไปใน
// slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
const sectionLabel = title ? undefined : (label ?? titleright ?? titleleft ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#f5003e]/30 bg-[#1f0611] p-8 shadow-[10px_10px_20px_#080104,-10px_-10px_20px_#350c1e] transition-all duration-300 hover:shadow-[15px_15px_30px_#080104,-15px_-15px_30px_#421026]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0b9cd]">
        {titleleft && <p class="bg-gradient-to-r from-[#ffd8e7] via-[#ff4fa3] to-[#b3022c] bg-clip-text text-2xl leading-normal font-black text-transparent">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ffe3ee] md:border-l md:border-[#7c1040]/45 md:pl-8">
        {title && <HeadingTag class="bg-gradient-to-r from-[#ffd8e7] via-[#ff4fa3] to-[#f5003e] bg-clip-text text-2xl leading-normal font-black text-transparent">{title}</HeadingTag>}
        {
          titleright && (
            <p class="flex items-center gap-2 text-xl leading-normal font-black text-[#ffd8e7]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#ff4fa3] shadow-[0_0_5px_rgba(255,79,163,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
