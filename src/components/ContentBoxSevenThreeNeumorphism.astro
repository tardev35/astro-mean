---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// สองคอลัมน์ถูก flatten แล้ว — คลาสข้อความอยู่บน <article> และ slot เป็นลูกโดยตรง
// ผู้เรียกต้องส่งหนึ่ง element ต่อหนึ่ง slot
//
// เดิม titleleft กับ rightHeading render เป็น <h2> ทั้งคู่ ทำให้หนึ่ง section ของ
// docx ออกมาเป็นสองหัวข้อ ตอนนี้ `title` คือหัวข้อเดียวที่ปล่อยออกมาได้ (วางเหนือ
// คอลัมน์เนื้อความ) ส่วน titleleft/titleright เป็นป้ายคอลัมน์ระดับ <p>
//
// FAST369: ย้ายจากทองมังกร + ไฟของ LONGSAP168 (#ffd76a / #f2b024 / #d81f26 บนผิว
// #170806 เนื้อความ #f6e4c8 ข้อความรอง #e3c9ab) มาที่แดงสัญญาณ #e40613 / #ff3b2f
// คู่ทอง #ffe27a / #ffc531 / #a8720a บนผิว #170506 เนื้อความ #f4e7dd ข้อความรอง
// #cdb9b2
//
// Neumorphism แปลว่าเงาสองด้านต้องเป็นเฉดเข้ม/อ่อนของสีการ์ดเอง ไม่ใช่สีแบรนด์:
// #050102 (เข้มกว่าพื้นหน้า) เป็นเงาทอด และ #240709 (ผิวการ์ดยกขึ้นหนึ่งขั้น) เป็น
// ไฮไลต์ ถ้าเอา #e40613 ไปแทน การ์ดจะกลายเป็นแสงเรืองแทนผิวนูน
const sectionLabel = title ? undefined : (label ?? titleright ?? titleleft ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#e40613]/30 bg-[#170506] p-8 shadow-[10px_10px_20px_#050102,-10px_-10px_20px_#240709] transition-all duration-300 hover:shadow-[15px_15px_30px_#030101,-15px_-15px_30px_#2e0a0d]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cdb9b2]">
        {titleleft && <p class="bg-gradient-to-r from-[#ffe27a] via-[#ffc531] to-[#e40613] bg-clip-text text-2xl leading-normal font-black text-transparent">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4e7dd] md:border-l md:border-[#e40613]/30 md:pl-8">
        {title && <HeadingTag class="bg-gradient-to-r from-[#ffe27a] via-[#ffc531] to-[#e40613] bg-clip-text text-2xl leading-normal font-black text-transparent">{title}</HeadingTag>}
        {
          titleright && (
            <p class="flex items-center gap-2 text-xl leading-normal font-black text-[#ffc531]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#e40613] shadow-[0_0_5px_rgba(228,6,19,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
