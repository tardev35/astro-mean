---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// สองคอลัมน์ถูก flatten แล้ว — คลาสข้อความอยู่บน <article> และ slot เป็นลูกโดยตรง
// ผู้เรียกต้องส่งหนึ่ง element ต่อหนึ่ง slot (ฝั่ง 3 ส่วนรอบนี้รับ <Picture> ใบเดียว)
//
// `title` คือหัวข้อเดียวที่ปล่อยออกมาได้ (วางเหนือคอลัมน์เนื้อความฝั่ง 7 ส่วน) ส่วน
// titleleft/titleright เป็นป้ายคอลัมน์ระดับ <p>
//
// ORCA789: ย้ายจากทองคู่เงินโครเมียมของ AURORA688 (#e2c443 / #ffe9a3 / #c9a13a คู่
// #c3cddb / #eef2f7 บนผิว #15120a เนื้อความ #f2ead6 ข้อความรอง #c8bda1 ซึ่งก่อนหน้า
// นั้นเป็นม่วงนีออนของ GDK88) มาที่ฟ้านีออนใต้ทะเลของแบรนด์นี้ — สีเน้นหลัก #00abfc
// / #84ccfb / #011dc4 คู่ทอง #ffd54a บนผิว #041028 เนื้อความ #dbeafe ข้อความรอง
// #9dc3e6
//
// Neumorphism แปลว่าเงาสองด้านต้องเป็นเฉดเข้ม/อ่อนของสีการ์ดเอง ไม่ใช่สีแบรนด์:
// #010614 (เข้มกว่าพื้นหน้า) เป็นเงาทอด และ #08203f (ผิวการ์ดยกขึ้นหนึ่งขั้น) เป็น
// ไฮไลต์ ถ้าเอา #00abfc ไปแทน การ์ดจะกลายเป็นแสงเรืองแทนผิวนูน
//
// ไม่มี text-center บนการ์ดหรือ <section> โดยตั้งใจ — ถ้าใส่ มันจะ inherit ลงไปใน
// slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
const sectionLabel = title ? undefined : (label ?? titleright ?? titleleft ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#00abfc]/30 bg-[#041028] p-8 shadow-[10px_10px_20px_#010614,-10px_-10px_20px_#08203f] transition-all duration-300 hover:shadow-[15px_15px_30px_#010614,-15px_-15px_30px_#0b2c58]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#9dc3e6]">
        {titleleft && <p class="bg-gradient-to-r from-[#f0f9ff] via-[#84ccfb] to-[#ffd54a] bg-clip-text text-2xl leading-normal font-black text-transparent">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbeafe] md:border-l md:border-[#00abfc]/30 md:pl-8">
        {title && <HeadingTag class="bg-gradient-to-r from-[#f0f9ff] via-[#84ccfb] to-[#00abfc] bg-clip-text text-2xl leading-normal font-black text-transparent">{title}</HeadingTag>}
        {
          titleright && (
            <p class="flex items-center gap-2 text-xl leading-normal font-black text-[#ffd54a]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#84ccfb] shadow-[0_0_5px_rgba(132,204,251,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
