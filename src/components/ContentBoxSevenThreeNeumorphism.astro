---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// สองคอลัมน์ถูก flatten แล้ว — คลาสข้อความอยู่บน <article> และ slot เป็นลูกโดยตรง
// ผู้เรียกต้องส่งหนึ่ง element ต่อหนึ่ง slot (ฝั่ง 3 ส่วนรอบนี้รับ <Picture> ใบเดียว)
//
// `title` คือหัวข้อเดียวที่ปล่อยออกมาได้ และออกมาที่ระดับที่ prop `as` สั่ง (docx
// รอบนี้แบน H1 + H2 ล้วน ไม่มี H3) ส่วน titleleft/titleright เป็นป้ายคอลัมน์ระดับ <p>
// รอบนี้ไฟล์นี้เป็น SevenThree ใบที่สองในสองใบของเพดาน playbook คู่กับ slide2
// (อาร์ต "ฝาก-ถอน ระบบอัตโนมัติ รวดเร็ว / ปลอดภัย มั่นใจ 100%") กับหัวข้อ docx ข้อ 6
// เรื่องออโต้ทันใจที่ตัดช่วงรออนุมัติออกทั้งหมด
//
// SETH88: ไฟล์นี้มาถึงรอบนี้ในชุดสีของแบรนด์ก่อนหน้า ย้ายทั้งไฟล์มาเป็นทองคำอียิปต์
// คู่บรอนซ์บนดำอมน้ำตาลของหินวิหาร — ทอง #fdf3d4 / #f7d774 / #e0a92b / #a9711a /
// #6b4210 บนผิว #1b1109 เนื้อความ #f0e3cd ข้อความรอง #d6c2a0 (ห้ามพิมพ์ hex ของแบรนด์
// ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้
// จาก git history)
//
// Neumorphism แปลว่าเงาสองด้านต้องเป็นเฉดเข้ม/อ่อนของสีการ์ดเอง ไม่ใช่สีแบรนด์:
// #060301 (เข้มกว่าพื้นหน้า) เป็นเงาทอด และ #2c1d10 (ผิวการ์ดยกขึ้นหนึ่งขั้น) เป็น
// ไฮไลต์ ถ้าเอาทองสดไปแทน การ์ดจะกลายเป็นแสงเรืองแทนผิวนูน
//
// ไม่มี text-center บนการ์ดหรือ <section> โดยตั้งใจ — ถ้าใส่ มันจะ inherit ลงไปใน
// slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
const sectionLabel = title ? undefined : (label ?? titleright ?? titleleft ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#e0a92b]/30 bg-[#1b1109] p-8 shadow-[10px_10px_20px_#060301,-10px_-10px_20px_#2c1d10] transition-all duration-300 hover:shadow-[15px_15px_30px_#060301,-15px_-15px_30px_#3a2716]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d6c2a0]">
        {titleleft && <p class="bg-gradient-to-r from-[#fdf3d4] via-[#f7d774] to-[#a9711a] bg-clip-text text-2xl leading-normal font-black text-transparent">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e3cd] md:border-l md:border-[#6b4210]/45 md:pl-8">
        {title && <HeadingTag class="bg-gradient-to-r from-[#fdf3d4] via-[#f7d774] to-[#e0a92b] bg-clip-text text-2xl leading-normal font-black text-transparent">{title}</HeadingTag>}
        {
          titleright && (
            <p class="flex items-center gap-2 text-xl leading-normal font-black text-[#fdf3d4]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#f7d774] shadow-[0_0_5px_rgba(247,215,116,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
