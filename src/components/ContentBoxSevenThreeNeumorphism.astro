---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// สองคอลัมน์ถูก flatten แล้ว — คลาสข้อความอยู่บน <article> และ slot เป็นลูกโดยตรง
// ผู้เรียกต้องส่งหนึ่ง element ต่อหนึ่ง slot
//
// `title` คือหัวข้อเดียวที่ปล่อยออกมาได้ (วางเหนือคอลัมน์เนื้อความ) ส่วน
// titleleft/titleright เป็นป้ายคอลัมน์ระดับ <p>
//
// MAHAHENG333: ย้ายจากแดงสัญญาณ #e40613 ของ FAST369 แล้ว SGD88 พาไปม่วงบานเย็น
// #e879f9 / #bc07e2 แล้ว DRACO65 พาไปเขียวมังกรนีออน #4ade80 / #22c55e และรอบก่อน
// เป็นทองอร่ามคู่เปลวไฟ #ffe974 / #ffcc4b / #eb9a1d คู่ #ff6a13 / #ffa34d บนผิว
// #1e1105 เนื้อความ #f6e6c2 ข้อความรอง #c9ab7a — รอบนี้เป็นทองคาสิโนจีน #ffe98a /
// #e8b923 / #a5760a คู่แดงมงคล #b4231c / #6d1410 บนผิว #221708 เนื้อความ #f3e2b8
// ข้อความรอง #c2a469
//
// Neumorphism แปลว่าเงาสองด้านต้องเป็นเฉดเข้ม/อ่อนของสีการ์ดเอง ไม่ใช่สีแบรนด์:
// #0a0704 (เข้มกว่าพื้นหน้า) เป็นเงาทอด และ #33230b (ผิวการ์ดยกขึ้นหนึ่งขั้น) เป็น
// ไฮไลต์ ถ้าเอา #e8b923 ไปแทน การ์ดจะกลายเป็นแสงเรืองแทนผิวนูน
const sectionLabel = title ? undefined : (label ?? titleright ?? titleleft ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#e8b923]/30 bg-[#221708] p-8 shadow-[10px_10px_20px_#0a0704,-10px_-10px_20px_#33230b] transition-all duration-300 hover:shadow-[15px_15px_30px_#050301,-15px_-15px_30px_#3f2c0e]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#c2a469]">
        {titleleft && <p class="bg-gradient-to-r from-[#ffe98a] via-[#e8b923] to-[#a5760a] bg-clip-text text-2xl leading-normal font-black text-transparent">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e2b8] md:border-l md:border-[#e8b923]/30 md:pl-8">
        {title && <HeadingTag class="bg-gradient-to-r from-[#ffe98a] via-[#e8b923] to-[#a5760a] bg-clip-text text-2xl leading-normal font-black text-transparent">{title}</HeadingTag>}
        {
          titleright && (
            <p class="flex items-center gap-2 text-xl leading-normal font-black text-[#e8b923]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#b4231c] shadow-[0_0_5px_rgba(180,35,28,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
