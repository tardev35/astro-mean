---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// สองคอลัมน์ถูก flatten แล้ว — คลาสข้อความอยู่บน <article> และ slot เป็นลูกโดยตรง
// ผู้เรียกต้องส่งหนึ่ง element ต่อหนึ่ง slot
//
// `title` คือหัวข้อเดียวที่ปล่อยออกมาได้ (วางเหนือคอลัมน์เนื้อความ) ส่วน
// titleleft/titleright เป็นป้ายคอลัมน์ระดับ <p>
//
// กงล้อ88: ย้ายจากแดงสัญญาณ #e40613 ของ FAST369 แล้ว SGD88 พาไปม่วงบานเย็นนีออน
// #e879f9 / #bc07e2 แล้ว DRACO65 พาไปเขียวมังกรนีออน #dcfce7 / #4ade80 / #22c55e
// คู่ #15803d / #14532d บนผิว #062011 เนื้อความ #d6ecdd ข้อความรอง #9dbfa8 —
// รอบนี้เป็นทองอร่ามคู่เปลวไฟ #ffe974 / #ffcc4b / #eb9a1d / #8b4c0b คู่เปลวไฟ
// #ff6a13 / #ffa34d บนผิว #1e1105 เนื้อความ #f6e6c2 ข้อความรอง #c9ab7a
//
// Neumorphism แปลว่าเงาสองด้านต้องเป็นเฉดเข้ม/อ่อนของสีการ์ดเอง ไม่ใช่สีแบรนด์:
// #0a0501 (เข้มกว่าพื้นหน้า) เป็นเงาทอด และ #2c1808 (ผิวการ์ดยกขึ้นหนึ่งขั้น) เป็น
// ไฮไลต์ ถ้าเอา #ffcc4b ไปแทน การ์ดจะกลายเป็นแสงเรืองแทนผิวนูน
const sectionLabel = title ? undefined : (label ?? titleright ?? titleleft ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#ffcc4b]/30 bg-[#1e1105] p-8 shadow-[10px_10px_20px_#0a0501,-10px_-10px_20px_#2c1808] transition-all duration-300 hover:shadow-[15px_15px_30px_#050200,-15px_-15px_30px_#3a2009]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#c9ab7a]">
        {titleleft && <p class="bg-gradient-to-r from-[#ffe974] via-[#ffcc4b] to-[#ff6a13] bg-clip-text text-2xl leading-normal font-black text-transparent">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e6c2] md:border-l md:border-[#ffcc4b]/30 md:pl-8">
        {title && <HeadingTag class="bg-gradient-to-r from-[#ffe974] via-[#ffcc4b] to-[#ff6a13] bg-clip-text text-2xl leading-normal font-black text-transparent">{title}</HeadingTag>}
        {
          titleright && (
            <p class="flex items-center gap-2 text-xl leading-normal font-black text-[#ffa34d]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#ff6a13] shadow-[0_0_5px_rgba(255,106,19,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
