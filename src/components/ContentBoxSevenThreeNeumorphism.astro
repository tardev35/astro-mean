---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// สองคอลัมน์ถูก flatten แล้ว — คลาสข้อความอยู่บน <article> และ slot เป็นลูกโดยตรง
// ผู้เรียกต้องส่งหนึ่ง element ต่อหนึ่ง slot
//
// เดิม titleleft กับ rightHeading render เป็น <h2> ทั้งคู่ ทำให้หนึ่ง section ของ
// docx ออกมาเป็นสองหัวข้อ ตอนนี้ `title` คือหัวข้อเดียวที่ปล่อยออกมาได้ (วางเหนือ
// คอลัมน์เนื้อความ) ส่วน titleleft/titleright เป็นป้ายคอลัมน์ระดับ <p>
//
// DRACO65: ย้ายจากแดงสัญญาณ #e40613 คู่ทอง #ffc531 ของ FAST369 แล้ว SGD88 พาไป
// ม่วงบานเย็นนีออน #f7d0ff / #e879f9 / #bc07e2 คู่ #930ac5 / #4c0a6b บนผิว
// #1b0d2e เนื้อความ #f3e8ff ข้อความรอง #cbb5e6 — รอบนี้มาที่เขียวมังกรนีออน
// #dcfce7 / #4ade80 / #22c55e คู่เขียวเข้ม #15803d / #14532d บนผิว #062011
// เนื้อความ #d6ecdd ข้อความรอง #9dbfa8
//
// Neumorphism แปลว่าเงาสองด้านต้องเป็นเฉดเข้ม/อ่อนของสีการ์ดเอง ไม่ใช่สีแบรนด์:
// #020805 (เข้มกว่าพื้นหน้า) เป็นเงาทอด และ #0a3318 (ผิวการ์ดยกขึ้นหนึ่งขั้น) เป็น
// ไฮไลต์ ถ้าเอา #22c55e ไปแทน การ์ดจะกลายเป็นแสงเรืองแทนผิวนูน
const sectionLabel = title ? undefined : (label ?? titleright ?? titleleft ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#22c55e]/30 bg-[#062011] p-8 shadow-[10px_10px_20px_#020805,-10px_-10px_20px_#0a3318] transition-all duration-300 hover:shadow-[15px_15px_30px_#010402,-15px_-15px_30px_#0e4a22]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#9dbfa8]">
        {titleleft && <p class="bg-gradient-to-r from-[#dcfce7] via-[#4ade80] to-[#22c55e] bg-clip-text text-2xl leading-normal font-black text-transparent">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d6ecdd] md:border-l md:border-[#22c55e]/30 md:pl-8">
        {title && <HeadingTag class="bg-gradient-to-r from-[#dcfce7] via-[#4ade80] to-[#22c55e] bg-clip-text text-2xl leading-normal font-black text-transparent">{title}</HeadingTag>}
        {
          titleright && (
            <p class="flex items-center gap-2 text-xl leading-normal font-black text-[#4ade80]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#22c55e] shadow-[0_0_5px_rgba(34,197,94,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
