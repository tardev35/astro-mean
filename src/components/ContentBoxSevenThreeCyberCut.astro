---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// DRACO65: ไฟล์นี้ผ่านมาหลายแบรนด์ — FLASH789 แดง (#ff2b2b / #c1121f / #8f0806),
// JUDTEM168 ทอง (#feeb33 / #fac42c / #e4a434), FUSIONNEW แดงคู่โครมเงิน, FAST369
// แดงสัญญาณ #e40613 คู่ทอง, SGD88 ม่วงบานเย็นนีออน #bc07e2 และรอบก่อนม่วงโกธิค
// #8b5cf6 / #b794ff / #ede9fe คู่ #6d28d9 / #4c1d95 บนผิว #1c0343 เนื้อความ
// #ded4f5 ข้อความรอง #a99ac9 — รอบนี้เป็นเขียวมังกรนีออน #22c55e / #4ade80 /
// #dcfce7 คู่เขียวเข้ม #15803d / #14532d บนผิว #062011 เนื้อความ #d6ecdd ข้อความ
// รอง #9dbfa8 เก็บมุมตัดสไตล์ cyber-cut ของ variant นี้ไว้เหมือนเดิม
//
// เดิม titleleft/titleright render เป็น <h2> คนละอัน ทำให้ section เดียวของ docx
// ปล่อยหัวข้อออกมาสองอัน ตอนนี้ทั้งคู่เป็น <p> เพราะมันตั้งชื่อคอลัมน์ ไม่ใช่
// section ของ docx ส่วน prop `title` ที่เพิ่มเข้ามาคือหัวข้อเดียวที่ component นี้
// ปล่อยได้ (แบบเดียวกับ ContentBox.astro / ContentBoxTwo.astro)
//
// คอลัมน์ซ้าย 3fr คือช่องรูป คอลัมน์ขวา 7fr คือเนื้อความ — ส่งรูปหนึ่งใบเข้า
// slot="left" และย่อหน้าเดียวเข้า slot="right"
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#22c55e]/25 bg-[#062011]/92 p-8 text-[#d6ecdd] shadow-[0_10px_30px_rgba(34,197,94,0.25)] backdrop-blur-md transition-all duration-300 hover:border-[#4ade80]/55 hover:shadow-[0_15px_40px_rgba(74,222,128,0.35)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#22c55e] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#14532d] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#22c55e] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#14532d] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-[#22c55e] pl-6">
          <HeadingTag class="bg-gradient-to-r from-[#dcfce7] via-[#4ade80] to-[#22c55e] bg-clip-text text-xl leading-normal font-black text-transparent md:text-2xl">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d6ecdd]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#22c55e]/25 pb-2">
              <span aria-hidden="true" class="font-mono text-[#4ade80]">
                &gt;_
              </span>
              <p class="text-xl leading-normal font-black text-[#dcfce7]">{titleleft}</p>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d6ecdd] md:border-l md:border-[#22c55e]/25 md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#22c55e]/25 pb-2">
              <span aria-hidden="true" class="font-mono text-[#4ade80]">
                &gt;_
              </span>
              <p class="text-xl leading-normal font-black text-[#dcfce7]">{titleright}</p>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
