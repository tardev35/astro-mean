---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// GEN4: ไฟล์นี้ผ่านมาหลายแบรนด์ (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind
// สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้
// ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
// รอบนี้เป็นชุดน้ำเงินอิเล็กทริกคู่แดงที่วัดจากอาร์ตของแบรนด์นี้เอง — น้ำเงิน
// #0071d5 / #01a3f3 / #6fd2ff / #00408a บนผิว #050b1a เนื้อความ #d7e7ff
// ข้อความรอง #8fb4e0 หัวข้อ #eaf4ff ส่วนแดง #e8241c (สีของเลข 4 ในโลโก้) เป็นสี
// เน้นรองที่ถือเส้นมุมฝั่งล่างขวา — ทรงเดียวกับ ContentBoxCyberCut ที่เป็นพี่น้อง
// กัน เก็บมุมตัดสไตล์ cyber-cut ของ variant นี้ไว้เหมือนเดิม
//
// titleleft/titleright เป็น <p> เพราะมันตั้งชื่อคอลัมน์ ไม่ใช่ section ของ docx
// ส่วน prop `title` คือหัวข้อเดียวที่ component นี้ปล่อยได้ (แบบเดียวกับ
// ContentBox.astro / ContentBoxTwo.astro)
//
// คอลัมน์ซ้าย 3fr คือช่องรูป คอลัมน์ขวา 7fr คือเนื้อความ — ส่งรูปหนึ่งใบเข้า
// slot="left" และย่อหน้าเดียวเข้า slot="right"
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#0071d5]/35 bg-[#050b1a]/92 p-8 text-[#d7e7ff] shadow-[0_10px_30px_rgba(0,113,213,0.28)] backdrop-blur-md transition-all duration-300 hover:border-[#01a3f3]/55 hover:shadow-[0_15px_40px_rgba(1,163,243,0.32)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#01a3f3] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#e8241c] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#01a3f3] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#e8241c] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-[#01a3f3] pl-6">
          <HeadingTag class="bg-gradient-to-r from-[#eaf4ff] via-[#6fd2ff] to-[#00408a] bg-clip-text text-xl leading-normal font-black text-transparent md:text-2xl">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d7e7ff]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#0071d5]/30 pb-2">
              <span aria-hidden="true" class="font-mono text-[#8fb4e0]">
                &gt;_
              </span>
              <p class="text-xl leading-normal font-black text-[#eaf4ff]">{titleleft}</p>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d7e7ff] md:border-l md:border-[#0071d5]/30 md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#0071d5]/30 pb-2">
              <span aria-hidden="true" class="font-mono text-[#8fb4e0]">
                &gt;_
              </span>
              <p class="text-xl leading-normal font-black text-[#eaf4ff]">{titleright}</p>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
