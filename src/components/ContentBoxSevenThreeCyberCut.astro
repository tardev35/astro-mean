---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// PROFIT55: ไฟล์นี้ผ่านมาหลายแบรนด์ (ล่าสุดเป็นหยกเขียวคู่ทองของ KANGFU1688 ก่อนหน้า
// นั้นเป็นนีออนม่วงคู่ทอง ฟ้านีออนใต้ทะเล ทองบูสต์คู่น้ำเงินไฟฟ้า แดงสัญญาณ ทองอร่าม
// เขียวมังกร และทองคาสิโนจีน — ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์
// เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS
// ตาย ดูของเดิมได้จาก git history)
// รอบนี้เป็นทองคู่เงินโครเมียม — ทองหลัก #e3ac22 / #f6d24a / #a97d12 บนผิว #0a0702
// เนื้อความ #f3e6c4 ข้อความรอง #cbbb92 ส่วนเงินโครเมียม #cfd8e2 เป็นสีเน้นรองที่ถือ
// เส้นมุมฝั่งล่างขวาและป้ายคอลัมน์ — ทรงเดียวกับ ContentBoxCyberCut ที่เป็นพี่น้องกัน
// เก็บมุมตัดสไตล์ cyber-cut ของ variant นี้ไว้เหมือนเดิม
//
// titleleft/titleright เป็น <p> เพราะมันตั้งชื่อคอลัมน์ ไม่ใช่ section ของ docx
// ส่วน prop `title` คือหัวข้อเดียวที่ component นี้ปล่อยได้ (แบบเดียวกับ
// ContentBox.astro / ContentBoxTwo.astro)
//
// คอลัมน์ซ้าย 3fr คือช่องรูป คอลัมน์ขวา 7fr คือเนื้อความ — ส่งรูปหนึ่งใบเข้า
// slot="left" และย่อหน้าเดียวเข้า slot="right"
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#e3ac22]/30 bg-[#0a0702]/92 p-8 text-[#f3e6c4] shadow-[0_10px_30px_rgba(227,172,34,0.25)] backdrop-blur-md transition-all duration-300 hover:border-[#f6d24a]/55 hover:shadow-[0_15px_40px_rgba(207,216,226,0.3)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#e3ac22] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#cfd8e2] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#e3ac22] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#cfd8e2] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-[#e3ac22] pl-6">
          <HeadingTag class="bg-gradient-to-r from-[#fffaf0] via-[#f6d24a] to-[#a97d12] bg-clip-text text-xl leading-normal font-black text-transparent md:text-2xl">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e6c4]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#e3ac22]/25 pb-2">
              <span aria-hidden="true" class="font-mono text-[#cbbb92]">
                &gt;_
              </span>
              <p class="text-xl leading-normal font-black text-[#cfd8e2]">{titleleft}</p>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e6c4] md:border-l md:border-[#e3ac22]/25 md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#e3ac22]/25 pb-2">
              <span aria-hidden="true" class="font-mono text-[#cbbb92]">
                &gt;_
              </span>
              <p class="text-xl leading-normal font-black text-[#cfd8e2]">{titleright}</p>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
