---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// MAHAHENG333: ไฟล์นี้ผ่านมาหลายแบรนด์ — FLASH789 แดง (#ff2b2b / #c1121f / #8f0806),
// JUDTEM168 ทอง (#feeb33 / #fac42c / #e4a434), FUSIONNEW แดงคู่โครมเงิน, FAST369
// แดงสัญญาณ #e40613 คู่ทอง, SGD88 ม่วงบานเย็นนีออน #bc07e2, PHANTOM569 ม่วงโกธิค
// #8b5cf6, DRACO65 เขียวมังกรนีออน #22c55e และรอบก่อนเป็นทองอร่ามคู่เปลวไฟ #ffe974 /
// #ffcc4b / #eb9a1d / #8b4c0b คู่ #ff6a13 / #ffa34d บนผิว #1e1105 เนื้อความ #f6e6c2
// ข้อความรอง #c9ab7a — รอบนี้เป็นทองคาสิโนจีน #ffe98a / #e8b923 / #a5760a คู่แดง
// มงคล #b4231c / #6d1410 บนผิว #221708 เนื้อความ #f3e2b8 ข้อความรอง #c2a469
// เก็บมุมตัดสไตล์ cyber-cut ของ variant นี้ไว้เหมือนเดิม
//
// titleleft/titleright เป็น <p> เพราะมันตั้งชื่อคอลัมน์ ไม่ใช่ section ของ docx
// ส่วน prop `title` คือหัวข้อเดียวที่ component นี้ปล่อยได้ (แบบเดียวกับ
// ContentBox.astro / ContentBoxTwo.astro)
//
// คอลัมน์ซ้าย 3fr คือช่องรูป คอลัมน์ขวา 7fr คือเนื้อความ — ส่งรูปหนึ่งใบเข้า
// slot="left" และย่อหน้าเดียวเข้า slot="right"
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#e8b923]/25 bg-[#221708]/92 p-8 text-[#f3e2b8] shadow-[0_10px_30px_rgba(232,185,35,0.25)] backdrop-blur-md transition-all duration-300 hover:border-[#ffe98a]/55 hover:shadow-[0_15px_40px_rgba(180,35,28,0.35)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#e8b923] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#a5760a] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#e8b923] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#a5760a] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-[#b4231c] pl-6">
          <HeadingTag class="bg-gradient-to-r from-[#ffe98a] via-[#e8b923] to-[#a5760a] bg-clip-text text-xl leading-normal font-black text-transparent md:text-2xl">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e2b8]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#e8b923]/25 pb-2">
              <span aria-hidden="true" class="font-mono text-[#c2a469]">
                &gt;_
              </span>
              <p class="text-xl leading-normal font-black text-[#ffe98a]">{titleleft}</p>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e2b8] md:border-l md:border-[#e8b923]/25 md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#e8b923]/25 pb-2">
              <span aria-hidden="true" class="font-mono text-[#c2a469]">
                &gt;_
              </span>
              <p class="text-xl leading-normal font-black text-[#ffe98a]">{titleright}</p>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
