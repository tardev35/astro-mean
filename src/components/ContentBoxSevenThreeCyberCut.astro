---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// กงล้อ88: ไฟล์นี้ผ่านมาหลายแบรนด์ — FLASH789 แดง (#ff2b2b / #c1121f / #8f0806),
// JUDTEM168 ทอง (#feeb33 / #fac42c / #e4a434), FUSIONNEW แดงคู่โครมเงิน, FAST369
// แดงสัญญาณ #e40613 คู่ทอง, SGD88 ม่วงบานเย็นนีออน #bc07e2, PHANTOM569 ม่วงโกธิค
// #8b5cf6 และรอบก่อนเป็นเขียวมังกรนีออน #22c55e / #4ade80 / #dcfce7 คู่ #15803d /
// #14532d บนผิว #062011 เนื้อความ #d6ecdd ข้อความรอง #9dbfa8 — รอบนี้เป็นทอง
// อร่ามคู่เปลวไฟ #ffe974 / #ffcc4b / #eb9a1d / #8b4c0b คู่เปลวไฟ #ff6a13 /
// #ffa34d บนผิว #1e1105 / #140a02 เนื้อความ #f6e6c2 ข้อความรอง #c9ab7a เก็บมุมตัด
// สไตล์ cyber-cut ของ variant นี้ไว้เหมือนเดิม
//
// titleleft/titleright เป็น <p> เพราะมันตั้งชื่อคอลัมน์ ไม่ใช่ section ของ docx
// ส่วน prop `title` คือหัวข้อเดียวที่ component นี้ปล่อยได้ (แบบเดียวกับ
// ContentBox.astro / ContentBoxTwo.astro)
//
// คอลัมน์ซ้าย 3fr คือช่องรูป คอลัมน์ขวา 7fr คือเนื้อความ — ส่งรูปหนึ่งใบเข้า
// slot="left" และย่อหน้าเดียวเข้า slot="right"
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#ffcc4b]/25 bg-[#1e1105]/92 p-8 text-[#f6e6c2] shadow-[0_10px_30px_rgba(255,204,75,0.25)] backdrop-blur-md transition-all duration-300 hover:border-[#ffa34d]/55 hover:shadow-[0_15px_40px_rgba(255,106,19,0.35)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#ffcc4b] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#8b4c0b] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#ffcc4b] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#8b4c0b] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-[#ff6a13] pl-6">
          <HeadingTag class="bg-gradient-to-r from-[#ffe974] via-[#ffcc4b] to-[#ff6a13] bg-clip-text text-xl leading-normal font-black text-transparent md:text-2xl">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e6c2]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#ffcc4b]/25 pb-2">
              <span aria-hidden="true" class="font-mono text-[#ffa34d]">
                &gt;_
              </span>
              <p class="text-xl leading-normal font-black text-[#ffe974]">{titleleft}</p>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e6c2] md:border-l md:border-[#ffcc4b]/25 md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#ffcc4b]/25 pb-2">
              <span aria-hidden="true" class="font-mono text-[#ffa34d]">
                &gt;_
              </span>
              <p class="text-xl leading-normal font-black text-[#ffe974]">{titleright}</p>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
