---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// QUEEN189: ไฟล์นี้ผ่านมาหลายแบรนด์ (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind
// สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้
// ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
// รอบนี้เป็นทองราชสำนักที่วัดจากอาร์ตของแบรนด์นี้เอง — ทอง #fdf3d2 / #fceb83 /
// #e4bb53 / #c38d29 / #7a5615 บนผิว #0b0704 เนื้อความ #f3e4c4 ข้อความรอง #c2a878
// แบรนด์นี้เป็นทองวรรณะเดียวไล่ระดับ เส้นมุมฝั่งบนซ้ายรับทองสว่าง ฝั่งล่างขวารับ
// ทองเข้ม ไม่มีสีที่สองมาตัด ทรงเดียวกับ ContentBoxCyberCut ที่เป็นพี่น้องกัน เก็บ
// มุมตัดสไตล์ cyber-cut ของ variant นี้ไว้
//
// titleleft/titleright เป็น <p> เพราะมันตั้งชื่อคอลัมน์ ไม่ใช่ section ของ docx
// ส่วน prop `title` คือหัวข้อเดียวที่ component นี้ปล่อยได้ (แบบเดียวกับ
// ContentBox / ContentBoxTwo) รอบนี้แบกหัวข้อ docx ข้อ 4 เรื่องสล็อตตัวท็อป
//
// คอลัมน์ซ้าย 3fr คือช่องรูป คอลัมน์ขวา 7fr คือเนื้อความ — ส่งรูปหนึ่งใบเข้า
// slot="left" และย่อหน้าเดียวเข้า slot="right"
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#e4bb53]/35 bg-[#0b0704]/92 p-8 text-[#f3e4c4] shadow-[0_10px_30px_rgba(228,187,83,0.28)] backdrop-blur-md transition-all duration-300 hover:border-[#fceb83]/55 hover:shadow-[0_15px_40px_rgba(252,235,131,0.22)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#fceb83] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#c38d29] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#fceb83] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#c38d29] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-[#fceb83] pl-6">
          <HeadingTag class="bg-gradient-to-r from-[#fdf3d2] via-[#fceb83] to-[#c38d29] bg-clip-text text-xl leading-normal font-black text-transparent md:text-2xl">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e4c4]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#7a5615]/45 pb-2">
              <span aria-hidden="true" class="font-mono text-[#c2a878]">
                &gt;_
              </span>
              <p class="text-xl leading-normal font-black text-[#fdf3d2]">{titleleft}</p>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e4c4] md:border-l md:border-[#7a5615]/45 md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#7a5615]/45 pb-2">
              <span aria-hidden="true" class="font-mono text-[#c2a878]">
                &gt;_
              </span>
              <p class="text-xl leading-normal font-black text-[#fdf3d2]">{titleright}</p>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
