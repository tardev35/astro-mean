---
export interface Props {
  titleleft?: string;
  titleright?: string;
}
const { titleleft, titleright } = Astro.props;

// JUDTEM168: arrived from FLASH789 on red (#ff2b2b / #c1121f / #8f0806) over
// #170506 / #f7ddd8. Remapped onto gold — #feeb33 / #fac42c / #e4a434 /
// #cc8425 / #7a4a0d over #150d04, body text #f3e3c4.
//
// Pass ONE of titleleft/titleright — passing both emits a second <h2> for a
// single docx heading.
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#e4a434]/25 bg-[#150d04]/92 p-8 text-[#f3e3c4] shadow-[0_10px_30px_rgba(250,196,44,0.16)] backdrop-blur-md transition-all duration-300 hover:border-[#feeb33]/55 hover:shadow-[0_15px_40px_rgba(254,235,51,0.26)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#fac42c] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#feeb33] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#fac42c] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#feeb33] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e3c4]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#e4a434]/25 pb-2">
              <span aria-hidden="true" class="font-mono text-[#feeb33]">
                &gt;_
              </span>
              <h2 class="text-xl leading-normal font-black text-[#fac42c]">{titleleft}</h2>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e3c4] md:border-l md:border-[#e4a434]/25 md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#e4a434]/25 pb-2">
              <span aria-hidden="true" class="font-mono text-[#feeb33]">
                &gt;_
              </span>
              <h2 class="text-xl leading-normal font-black text-[#fac42c]">{titleright}</h2>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
