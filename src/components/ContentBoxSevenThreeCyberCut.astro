---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// BOOST168: ไฟล์นี้ผ่านมาหลายแบรนด์ (แดงสัญญาณ ทองอร่าม ม่วงนีออน เขียวมังกร และ
// รอบก่อนเป็นทองคาสิโนจีนคู่แดงมงคล — ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้
// เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่
// ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history) รอบนี้เป็นทองบูสต์คู่
// น้ำเงินไฟฟ้าบนพื้นดำน้ำเงิน — ทอง #ffe680 / #ffc233 / #b26a00 คู่น้ำเงิน #3f8cff
// บนผิว #0e1430 เนื้อความ #e6ecfb ข้อความรอง #9ecbff
// เก็บมุมตัดสไตล์ cyber-cut ของ variant นี้ไว้เหมือนเดิม
//
// titleleft/titleright เป็น <p> เพราะมันตั้งชื่อคอลัมน์ ไม่ใช่ section ของ docx
// ส่วน prop `title` คือหัวข้อเดียวที่ component นี้ปล่อยได้ (แบบเดียวกับ
// ContentBox.astro / ContentBoxTwo.astro)
//
// คอลัมน์ซ้าย 3fr คือช่องรูป คอลัมน์ขวา 7fr คือเนื้อความ — ส่งรูปหนึ่งใบเข้า
// slot="left" และย่อหน้าเดียวเข้า slot="right"
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#ffc233]/25 bg-[#0e1430]/92 p-8 text-[#e6ecfb] shadow-[0_10px_30px_rgba(255,194,51,0.25)] backdrop-blur-md transition-all duration-300 hover:border-[#ffe680]/55 hover:shadow-[0_15px_40px_rgba(63,140,255,0.35)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#ffc233] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#b26a00] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#ffc233] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#b26a00] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-[#3f8cff] pl-6">
          <HeadingTag class="bg-gradient-to-r from-[#ffe680] via-[#ffc233] to-[#b26a00] bg-clip-text text-xl leading-normal font-black text-transparent md:text-2xl">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6ecfb]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#ffc233]/25 pb-2">
              <span aria-hidden="true" class="font-mono text-[#9ecbff]">
                &gt;_
              </span>
              <p class="text-xl leading-normal font-black text-[#ffe680]">{titleleft}</p>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6ecfb] md:border-l md:border-[#ffc233]/25 md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#ffc233]/25 pb-2">
              <span aria-hidden="true" class="font-mono text-[#9ecbff]">
                &gt;_
              </span>
              <p class="text-xl leading-normal font-black text-[#ffe680]">{titleright}</p>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
