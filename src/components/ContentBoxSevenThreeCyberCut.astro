---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// AURA456: ไฟล์นี้ผ่านมาหลายแบรนด์ (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind
// สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้
// ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
// รอบนี้เป็นชุดนีออนบานเย็นคู่ฟ้าอิเล็กทริกที่วัดจากอาร์ตของแบรนด์นี้เอง — บานเย็น
// #ff2fb0 / #ff7fd4 / #ffc9ee / #c81d8e บนผิว #0b0528 เนื้อความ #d8d3f0 ข้อความรอง
// #9b93c4 หัวข้อ #f6ebff ส่วนฟ้า #3ba9ff / #7fd0ff กับม่วง #8b3cf7 เป็นสีเน้นรองที่
// ถือเส้นมุมฝั่งล่างขวา — ทรงเดียวกับ ContentBoxCyberCut ที่เป็นพี่น้องกัน เก็บมุมตัด
// สไตล์ cyber-cut ของ variant นี้ไว้เหมือนเดิม
//
// titleleft/titleright เป็น <p> เพราะมันตั้งชื่อคอลัมน์ ไม่ใช่ section ของ docx
// ส่วน prop `title` คือหัวข้อเดียวที่ component นี้ปล่อยได้ (แบบเดียวกับ
// ContentBox.astro / ContentBoxTwo.astro)
//
// คอลัมน์ซ้าย 3fr คือช่องรูป คอลัมน์ขวา 7fr คือเนื้อความ — ส่งรูปหนึ่งใบเข้า
// slot="left" และย่อหน้าเดียวเข้า slot="right"
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#ff2fb0]/35 bg-[#0b0528]/92 p-8 text-[#d8d3f0] shadow-[0_10px_30px_rgba(255,47,176,0.28)] backdrop-blur-md transition-all duration-300 hover:border-[#ff7fd4]/55 hover:shadow-[0_15px_40px_rgba(59,169,255,0.32)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#ff7fd4] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#3ba9ff] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#ff7fd4] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#3ba9ff] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-[#ff7fd4] pl-6">
          <HeadingTag class="bg-gradient-to-r from-[#f6ebff] via-[#ff7fd4] to-[#8b3cf7] bg-clip-text text-xl leading-normal font-black text-transparent md:text-2xl">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d8d3f0]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#ff2fb0]/30 pb-2">
              <span aria-hidden="true" class="font-mono text-[#9b93c4]">
                &gt;_
              </span>
              <p class="text-xl leading-normal font-black text-[#f6ebff]">{titleleft}</p>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d8d3f0] md:border-l md:border-[#ff2fb0]/30 md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#ff2fb0]/30 pb-2">
              <span aria-hidden="true" class="font-mono text-[#9b93c4]">
                &gt;_
              </span>
              <p class="text-xl leading-normal font-black text-[#f6ebff]">{titleright}</p>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
