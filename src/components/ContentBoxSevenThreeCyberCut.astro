---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// FAST369: ไฟล์นี้ผ่านมาหลายแบรนด์ — FLASH789 แดง (#ff2b2b / #c1121f / #8f0806),
// JUDTEM168 ทอง (#feeb33 / #fac42c / #e4a434), FUSIONNEW แดงคู่โครมเงิน
// (#e01a1a / #ff5f52 / #8c0102 กับ #d9dde3 / #97a0a8 / #4a5157 บนผิว #150809
// เนื้อความ #e7e3e1) — รอบนี้เป็นแดงสัญญาณ #e40613 / #ff3b2f / #8f0206 คู่กับทอง
// #ffe27a / #ffc531 / #a8720a บนผิว #170506 เนื้อความ #f4e7dd ข้อความรอง #cdb9b2
// เก็บมุมตัดสไตล์ cyber-cut ของ variant นี้ไว้เหมือนเดิม
//
// เดิม titleleft/titleright render เป็น <h2> คนละอัน ทำให้ section เดียวของ docx
// ปล่อยหัวข้อออกมาสองอัน ตอนนี้ทั้งคู่เป็น <p> เพราะมันตั้งชื่อคอลัมน์ ไม่ใช่
// section ของ docx ส่วน prop `title` ที่เพิ่มเข้ามาคือหัวข้อเดียวที่ component นี้
// ปล่อยได้ (แบบเดียวกับ ContentBox.astro / ContentBoxTwo.astro)
//
// คอลัมน์ซ้าย 3fr คือช่องรูป คอลัมน์ขวา 7fr คือเนื้อความ — ส่งรูปหนึ่งใบเข้า
// slot="left" และย่อหน้าเดียวเข้า slot="right"
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#e40613]/25 bg-[#170506]/92 p-8 text-[#f4e7dd] shadow-[0_10px_30px_rgba(228,6,19,0.16)] backdrop-blur-md transition-all duration-300 hover:border-[#ff3b2f]/55 hover:shadow-[0_15px_40px_rgba(255,197,49,0.26)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#e40613] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#ffc531] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#e40613] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#ffc531] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-[#e40613] pl-6">
          <HeadingTag class="bg-gradient-to-r from-[#ffe27a] via-[#ff3b2f] to-[#e40613] bg-clip-text text-xl leading-normal font-black text-transparent md:text-2xl">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4e7dd]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#e40613]/25 pb-2">
              <span aria-hidden="true" class="font-mono text-[#ff3b2f]">
                &gt;_
              </span>
              <p class="text-xl leading-normal font-black text-[#ffe27a]">{titleleft}</p>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4e7dd] md:border-l md:border-[#e40613]/25 md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#e40613]/25 pb-2">
              <span aria-hidden="true" class="font-mono text-[#ff3b2f]">
                &gt;_
              </span>
              <p class="text-xl leading-normal font-black text-[#ffe27a]">{titleright}</p>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
