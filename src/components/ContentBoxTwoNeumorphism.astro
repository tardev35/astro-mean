---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// XONEBET: variant นี้ผ่านมาหลายแบรนด์ และมาถึงรอบนี้ในชุดสีของแบรนด์ก่อนหน้า
// (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็น
// คอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git
// history) รอบนี้ย้ายมาที่ทองหลอมคู่เงินโครเมียม — ทอง #ebb101 / #fee505 /
// #fff8d1 / #a87c02 คู่เงิน #e9e9e9 / #c4c4c4 บนผิวยก #221a08 เนื้อความ #f4e6bd
//
// คู่เงา neumorphic ต้องเป็นเฉดอ่อน/เข้มของสีการ์ดเอง ไม่ใช่สีแบรนด์ — เงาทอดใช้
// #0a0803 (เข้มกว่าผิวการ์ด) ไฮไลต์ใช้ #2e2409 (ผิวการ์ดยกขึ้นหนึ่งขั้น) ถ้าเอา
// ทองสดมาใส่ การ์ดจะกลายเป็นแสงเรืองแทนที่จะเป็นผิวนูน
//
// titleleft/titleright เป็น <p> เพราะมันตั้งชื่อคอลัมน์ UI ไม่ใช่ section ของ docx
// ส่วน prop `title` คือหัวข้อเดียวที่ component นี้ปล่อยได้ และออกมาที่ระดับที่ prop
// `as` สั่ง — docx รอบนี้แบน H1 + H2 ล้วน ป้ายซ้ายรับทองซึ่งเป็นสีนำ ป้ายขวารับ
// เงินซึ่งเป็นสีคู่ รอบนี้ไฟล์นี้แบกหัวข้อ docx ข้อ 7 เรื่องรองรับทุกอุปกรณ์
//
// text-center อยู่บน <header> เท่านั้น ถ้าย้ายไปวางบนการ์ดมันจะ inherit ลงไปใน
// slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#ebb101]/25 bg-[#221a08] p-8 shadow-[10px_10px_20px_#0a0803,-10px_-10px_20px_#2e2409] transition-all duration-300 hover:shadow-[15px_15px_30px_#0a0803,-15px_-15px_30px_#3a2e0c]">
    {
      title && (
        <header class="mb-8 border-b border-[#ebb101]/25 pb-4 text-center">
          <HeadingTag class="bg-gradient-to-r from-[#fff8d1] via-[#fee505] to-[#e9e9e9] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4e6bd]">
        {titleleft && <p class="text-2xl leading-normal font-black tracking-wide text-[#fee505]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4e6bd] md:border-l md:border-[#ebb101]/20 md:pl-8">
        {titleright && <p class="text-2xl leading-normal font-black tracking-wide text-[#e9e9e9]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
