---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// VIPSAND356: variant นี้ผ่านมาหลายแบรนด์ และมาถึงรอบนี้ในชุดสีของแบรนด์ก่อน
// (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็น
// คอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history) รอบนี้ย้ายมาที่ฟ้าอะซูร์คู่ทองส้ม — ฟ้า #eaf6ff / #a2d2ef /
// #5dbcfe / #2a93e0 / #1465a8 คู่ทอง #fcde61 / #eba554 / #c07c20 บนผิวยก #103a5f
// เนื้อความ #e6f2ff
//
// คู่เงา neumorphic ต้องเป็นเฉดอ่อน/เข้มของสีการ์ดเอง ไม่ใช่สีแบรนด์ — เงาทอดใช้
// #061c33 (เข้มกว่าผิวการ์ด) ไฮไลต์ใช้ #17517f (ผิวการ์ดยกขึ้นหนึ่งขั้น) ถ้าเอา
// ฟ้าสดมาใส่ การ์ดจะกลายเป็นแสงเรืองแทนที่จะเป็นผิวนูน
//
// titleleft/titleright เป็น <p> เพราะมันตั้งชื่อคอลัมน์ UI ไม่ใช่ section ของ docx
// ส่วน prop `title` คือหัวข้อเดียวที่ component นี้ปล่อยได้ และออกมาที่ระดับที่ prop
// `as` สั่ง — docx รอบนี้แบน H1 + H2 ล้วน ป้ายซ้ายรับฟ้าสว่างซึ่งเป็นสีนำ (คำว่า VIP
// บนป้ายโลโก้) ป้ายขวารับทองซึ่งเป็นสีที่สอง (คำว่า SANDS กับกรอบทอง)
// รอบนี้ไฟล์นี้แบกหัวข้อ docx ข้อ 7 เรื่องบริการระดับ VIP ที่ดูแลครบตั้งแต่เริ่ม
// ใช้งาน
//
// ไฟล์นี้ยังถูก LoginRtpSection.astro อ้างถึงในคอมเมนต์เป็นทางเลือกโครงสองคอลัมน์
// รอบถัดไป (รอบนี้ widget ตัวนั้นใช้ ContentBoxTwo.astro ตัวธรรมดา)
//
// text-center อยู่บน <header> เท่านั้น ถ้าย้ายไปวางบนการ์ดมันจะ inherit ลงไปใน
// slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#2a93e0]/30 bg-[#103a5f] p-8 shadow-[10px_10px_20px_#061c33,-10px_-10px_20px_#17517f] transition-all duration-300 hover:shadow-[15px_15px_30px_#061c33,-15px_-15px_30px_#1c5c8d]">
    {
      title && (
        <header class="mb-8 border-b border-[#2a93e0]/30 pb-4 text-center">
          <HeadingTag class="bg-gradient-to-r from-[#eaf6ff] via-[#a2d2ef] to-[#fcde61] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6f2ff]">
        {titleleft && <p class="text-2xl leading-normal font-black tracking-wide text-[#5dbcfe]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6f2ff] md:border-l md:border-[#eba554]/25 md:pl-8">
        {titleright && <p class="text-2xl leading-normal font-black tracking-wide text-[#eba554]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
