---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// QUEEN189: variant นี้ผ่านมาหลายแบรนด์ และมาถึงรอบนี้ในชุดสีของแบรนด์ก่อนหน้า
// (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็น
// คอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git
// history) รอบนี้ย้ายมาที่ทองราชสำนักบนดำสนิท — ทอง #fdf3d2 / #fceb83 / #e4bb53 /
// #c38d29 บนผิวยก #271a0c เนื้อความ #f3e4c4
//
// คู่เงา neumorphic ต้องเป็นเฉดอ่อน/เข้มของสีการ์ดเอง ไม่ใช่สีแบรนด์ — เงาทอดใช้
// #0b0704 (เข้มกว่าผิวการ์ด) ไฮไลต์ใช้ #3c2505 (ผิวการ์ดยกขึ้นหนึ่งขั้น) ถ้าเอา
// ทองสดมาใส่ การ์ดจะกลายเป็นแสงเรืองแทนที่จะเป็นผิวนูน
//
// titleleft/titleright เป็น <p> เพราะมันตั้งชื่อคอลัมน์ UI ไม่ใช่ section ของ docx
// ส่วน prop `title` คือหัวข้อเดียวที่ component นี้ปล่อยได้ และออกมาที่ระดับที่ prop
// `as` สั่ง — docx รอบนี้แบน H1 + H2 ล้วน ป้ายซ้ายรับทองสว่าง ป้ายขวารับทองเข้ม
// ลงหนึ่งขั้น (แบรนด์นี้เป็นทองวรรณะเดียว ห้ามหยิบสีที่สองมาแยกคอลัมน์)
// รอบนี้ไฟล์นี้แบกหัวข้อ docx ข้อ 5 เรื่องโต๊ะสดไลฟ์ Ultra HD
//
// text-center อยู่บน <header> เท่านั้น ถ้าย้ายไปวางบนการ์ดมันจะ inherit ลงไปใน
// slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#e4bb53]/25 bg-[#271a0c] p-8 shadow-[10px_10px_20px_#0b0704,-10px_-10px_20px_#3c2505] transition-all duration-300 hover:shadow-[15px_15px_30px_#0b0704,-15px_-15px_30px_#4a2f07]">
    {
      title && (
        <header class="mb-8 border-b border-[#e4bb53]/25 pb-4 text-center">
          <HeadingTag class="bg-gradient-to-r from-[#fdf3d2] via-[#fceb83] to-[#c38d29] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e4c4]">
        {titleleft && <p class="text-2xl leading-normal font-black tracking-wide text-[#fceb83]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e4c4] md:border-l md:border-[#e4bb53]/20 md:pl-8">
        {titleright && <p class="text-2xl leading-normal font-black tracking-wide text-[#c38d29]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
