---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// กงล้อ88: การ์ดใบนี้ผ่านมือหลายแบรนด์ — เคยเป็นแผงสว่าง (white/85), เคยเป็นทอง
// #f2b024 บนผิว #170806 ของ LONGSAP168, เคยเป็นแดง #e01a1a ของ FUSIONNEW, เคยเป็น
// ม่วงโกธิค #8b5cf6 และรอบก่อนเป็นเขียวมังกรนีออน #22c55e / #4ade80 / #dcfce7 คู่
// #15803d / #14532d บนผิว #062011 เนื้อความ #d6ecdd — รอบนี้เป็นทองมังกรไฟ
// #ffcc4b / #ffe974 / #eb9a1d คู่เปลวไฟ #ff6a13 / #8b4c0b บนผิว #1e1105 เนื้อความ
// #f6e6c2 เก็บไว้แค่มุมตัดสไตล์ cyber-cut ของ variant นี้
//
// การ์ดเป็น `isolate` และเลเยอร์ตกแต่งทุกชิ้นเป็น `-z-10` เนื้อความจึงอยู่เหนือ
// เส้นมุมได้โดยไม่ต้องมี wrapper ครอบ slot
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#ffcc4b]/35 bg-[#1e1105]/92 p-8 text-left text-base leading-relaxed text-[#f6e6c2] shadow-[0_10px_30px_rgba(255,204,75,0.25)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#ffcc4b] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#ff6a13] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#ffcc4b] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#ff6a13] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-[#ffcc4b] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#ffe974] via-[#ffcc4b] to-[#eb9a1d] bg-clip-text ${headingSize} leading-normal font-black text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
