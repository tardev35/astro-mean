---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// AURORA688: การ์ดใบนี้ผ่านมือมาหลายแบรนด์ (แผงสว่างของ LONGSAP168, แดง FUSIONNEW,
// เขียวมังกร, ทองคาสิโนจีนของ MAHAHENG333 และรอบล่าสุดเป็นม่วงนีออนของ GDK88 —
// #a855f7 / #d8b4fe / #f3e8ff คู่ทองโลโก้ #f0b429 บนผิว #1b0733 เนื้อความ #ece0ff)
// รอบนี้เป็นทองหรูคู่เงินโครเมียม — ทองหลัก #e2c443 / #ffe9a3 / #c9a13a เป็นสีเน้น
// หลักและเส้นมุมฝั่งบนซ้าย ส่วนเงิน #c3cddb / #eef2f7 เป็นสีเน้นรองที่ถือเส้นมุม
// ฝั่งล่างขวา บนผิว #15120a เนื้อความ #f2ead6 เก็บไว้แค่ทรงมุมตัดสไตล์ cyber-cut
// ซึ่งเป็นเอกลักษณ์เดียวของ variant นี้
//
// การ์ดเป็น `isolate` และเลเยอร์ตกแต่งทุกชิ้นเป็น `-z-10` เนื้อความจึงลอยอยู่เหนือ
// เส้นมุมได้เองโดยไม่ต้องมี wrapper `relative z-10` ครอบ slot ห้ามใส่กลับเข้ามา
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#e2c443]/35 bg-[#15120a]/92 p-8 text-left text-base leading-relaxed text-[#f2ead6] shadow-[0_10px_30px_rgba(226,196,67,0.25)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#e2c443] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#c3cddb] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#e2c443] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#c3cddb] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-[#e2c443] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#eef2f7] via-[#ffe9a3] to-[#c9a13a] bg-clip-text ${headingSize} leading-normal font-black text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
