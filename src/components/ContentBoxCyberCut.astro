---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// VIPSAND356: การ์ดใบนี้ผ่านมือมาหลายแบรนด์ (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ
// Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มี
// ใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// รอบนี้เป็นฟ้าอะซูร์คู่ทองส้มบนกรมท่าเข้ม ตามป้ายโลโก้ที่คำว่า VIP เป็นฟ้าใสและ
// SANDS เป็นส้มทองในกรอบทอง — ฟ้า #eaf6ff / #a2d2ef / #5dbcfe / #2a93e0 / #1465a8 /
// #0b3f70 คู่ทอง #fcde61 / #eba554 / #c07c20 / #8d520c บนผิว #0a2b4a เนื้อความ
// #e6f2ff เส้นมุมฝั่งบนซ้ายรับทองซึ่งเป็นสีที่สองของแบรนด์ ฝั่งล่างขวารับฟ้าอะซูร์
// ซึ่งเป็นสีนำ — คอนทราสต์สองมุมจึงมาจากคู่สีจริงของอาร์ตเวิร์ก
// เก็บไว้แค่ทรงมุมตัดสไตล์ cyber-cut ซึ่งเป็นเอกลักษณ์เดียวของ variant นี้
//
// วอลเปเปอร์รอบนี้เป็นฟ้าสว่าง (bg.png ท้องฟ้าการ์ตูนกับเมฆขาว) การ์ดจึงเป็นกรมท่า
// เข้มลอยอยู่บนพื้นสว่าง และต้องประกาศสีเนื้อความ #e6f2ff บนตัวการ์ดเสมอ เพราะ
// BRAND_TEXT รอบนี้เป็นกรมท่าเข้มสำหรับหน้าที่วางเนื้อความบนวอลเปเปอร์ตรงๆ
//
// รอบนี้ไฟล์นี้ถูก render จากหน้าแรกหน้าเดียว (หน้าย่อยทุกหน้าใช้ ContentBox.astro
// ตัวธรรมดาตามที่ brand spec ล็อกไว้) จึง retheme ทับได้เลย และแบกหัวข้อ docx ข้อ 1
// ซึ่งเป็น <h1> ตัวเดียวของหน้าแรก
//
// การ์ดเป็น `isolate` และเลเยอร์ตกแต่งทุกชิ้นเป็น `-z-10` เนื้อความจึงลอยอยู่เหนือ
// เส้นมุมได้เองโดยไม่ต้องมี wrapper `relative z-10` ครอบ slot ห้ามใส่กลับเข้ามา
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#eba554]/40 bg-[#0a2b4a]/92 p-8 text-left text-base leading-relaxed text-[#e6f2ff] shadow-[0_10px_30px_rgba(42,147,224,0.3)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#fcde61] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#5dbcfe] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#fcde61] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#0b3f70] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-[#eba554] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#eaf6ff] via-[#a2d2ef] to-[#5dbcfe] bg-clip-text ${headingSize} leading-normal font-black text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
