---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// XTOP666: การ์ดใบนี้ผ่านมือมาหลายแบรนด์ (รอบล่าสุดเป็นนีออนฟ้าคู่บานเย็น ก่อนหน้า
// นั้นเป็นม่วงลึกคู่มาเจนต้า แดงส้มคู่ทอง ฟ้านีออนใต้ทะเล ทองคาสิโนจีน ฯลฯ — ค่า hex
// เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์
// จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
// รอบนี้เป็นส้มไฟคู่ทองของแบรนด์ — ส้ม #fc5b02 / #ff8c3a / #ffd9bd / #7a2601 เป็นสี
// เน้นหลักและถือเส้นมุมฝั่งบนซ้าย ส่วนทอง #ffb020 / #ffd76e เป็นสีเน้นรองที่ถือ
// เส้นมุมฝั่งล่างขวา บนผิวเกือบดำ #0a0503 เนื้อความ #ffe8d8 เก็บไว้แค่ทรงมุมตัด
// สไตล์ cyber-cut ซึ่งเป็นเอกลักษณ์เดียวของ variant นี้
//
// รอบนี้บล็อกนี้แบกหัวข้อ H1 ของ docx บนหน้าแรก
//
// การ์ดเป็น `isolate` และเลเยอร์ตกแต่งทุกชิ้นเป็น `-z-10` เนื้อความจึงลอยอยู่เหนือ
// เส้นมุมได้เองโดยไม่ต้องมี wrapper `relative z-10` ครอบ slot ห้ามใส่กลับเข้ามา
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#fc5b02]/35 bg-[#0a0503]/92 p-8 text-left text-base leading-relaxed text-[#ffe8d8] shadow-[0_10px_30px_rgba(252,91,2,0.25)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#fc5b02] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#ffb020] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#fc5b02] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#ffd76e] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-[#ffb020] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#fff3ea] via-[#ff8c3a] to-[#7a2601] bg-clip-text ${headingSize} leading-normal font-black text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
