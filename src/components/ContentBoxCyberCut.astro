---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// PHOENIX168: การ์ดใบนี้ผ่านมือมาหลายแบรนด์ (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ
// Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มี
// ใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// รอบนี้เป็นไฟฟีนิกซ์คู่ทองขนนกบนถ่านเกือบดำ — ส้มไฟ #ff5a1e / #ffa14a / #ffe2c4 /
// #c04a12 เป็นสีเน้นหลักและถือเส้นมุมฝั่งบนซ้าย ส่วนทองขนนก #f3ac3c / #f4dc6d กับ
// เฉดถ่านแดง #7a2408 เป็นสีคู่ที่ถือเส้นมุมฝั่งล่างขวา บนผิว #150703 เนื้อความ
// #f2ddc9 เก็บไว้แค่ทรงมุมตัดสไตล์ cyber-cut ซึ่งเป็นเอกลักษณ์เดียวของ variant นี้
//
// รอบนี้ไฟล์นี้ถูก render จากหน้าแรกหน้าเดียว (หน้าย่อยทุกหน้าใช้ ContentBox.astro
// ตัวธรรมดาตามที่ brand spec ล็อกไว้) จึง retheme ทับได้เลย
//
// การ์ดเป็น `isolate` และเลเยอร์ตกแต่งทุกชิ้นเป็น `-z-10` เนื้อความจึงลอยอยู่เหนือ
// เส้นมุมได้เองโดยไม่ต้องมี wrapper `relative z-10` ครอบ slot ห้ามใส่กลับเข้ามา
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#ff5a1e]/35 bg-[#150703]/92 p-8 text-left text-base leading-relaxed text-[#f2ddc9] shadow-[0_10px_30px_rgba(255,90,30,0.25)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#ff5a1e] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#f3ac3c] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#ff5a1e] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#7a2408] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-[#f3ac3c] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#ffe2c4] via-[#ff5a1e] to-[#7a2408] bg-clip-text ${headingSize} leading-normal font-black text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
