---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { brandPick, brandFlag } from "../lib/brandProfile";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// แถวชุดแรก render จากฝั่งเซิร์ฟเวอร์ และ src/lib/winnersFeed.ts เป็นตัวรับช่วงต่อ
// — ห้ามย้ายลอจิกกลับมาเป็น `<script define:vars={{ bankPool }}>` ตัวนั้นบังคับ
// is:inline ซึ่งตัด type/async/defer ทิ้ง แล้วเหลือสคริปต์ที่บล็อก parser อยู่กลาง
// เอกสาร และห้าม render กล่องเปล่าแล้วเติมด้วย JS: crawler จะไม่เห็นอะไรเลย
//
// variant นี้เป็นตัวเดียวที่ไม่ได้แทรกแถวใหม่ไว้หน้าสุดเสมอ — pill ใหม่จะลงตำแหน่ง
// สุ่มใกล้ๆ หัวแถวเพื่อให้อ่านเป็นกลุ่มคน ไม่ใช่คิว `data-insert="scatter"` บน feed
// เป็นตัวขอพฤติกรรมนั้น
//
// ค่าเริ่มต้นมาจาก hash ของโดเมนแบรนด์ (brandPick / brandFlag) ไม่ใช่ Math.random()
// — frontmatter รันตอน build และเกทจะทำให้ build ล้มถ้ามีการเรียกสุ่มตรงนี้
//
// ถ้อยคำของสถานะอยู่บน data-pending-text / data-done-text (คู่กับ -class) ของแถว
// เอง เพราะโมดูลกลางไม่รู้จัก palette และไม่รู้จักคำของแบรนด์ไหนทั้งนั้น
//
// สี่ swatch `bg-[#…]` ข้างบนเป็นสีโลโก้ธนาคารจริง ไม่ใช่สีแบรนด์ — ห้ามรีธีมตาม
// palette เปลี่ยนได้แค่ผิวรอบๆ มัน
//
// VIREL168: ย้ายชุดสีมาที่ทองของแบรนด์นี้ที่วัดจากอาร์ตจริง — ทอง #faca4c /
// #ebb134 / #e2a52d / #ffeec2 / #855a14 คู่เงินโครเมียม #e1e1e1 / #949494 บนผิว
// #1b0d02 / #0a0501 ขอบ #442503 เนื้อความ #f4e7cd ข้อความรอง #c4ab7d (ห้ามพิมพ์
// hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็น
// คอมเมนต์ ดูของเดิมได้จาก git history)
const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);

const PENDING_TEXT = "กำลังโอน";
const DONE_TEXT = "เข้าบัญชีแล้ว";
const PENDING_CLASS = "text-[#c4ab7d]";
const DONE_CLASS = "text-[#faca4c]";

const initialRows = Array.from({ length: 8 }, (_, i) => ({
  bank: bankPool[pick(`pill-bank-${i}`, bankPool.length)],
  user: `${LETTERS.charAt(pick(`pill-a-${i}`, 26))}${LETTERS.charAt(pick(`pill-b-${i}`, 26))}***`,
  amount: (15000 + pick(`pill-amount-${i}`, 80001)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `pill-pending-${i}`),
}));
---

<div class="mx-auto w-full max-w-[1000px] p-4 font-sans">
  <section
    aria-label="รายการถอนเงินล่าสุดของสมาชิก VIREL168"
    class="relative overflow-hidden rounded-[30px] border-2 border-[#e2a52d]/30 bg-[#1b0d02]/88 px-4 py-8 shadow-[0_15px_40px_rgba(226,165,45,0.2)] backdrop-blur-md">
    <div class="mb-6 text-center">
      <p class="bg-gradient-to-b from-[#ffeec2] to-[#e2a52d] bg-clip-text text-xl font-black text-transparent md:text-2xl">
        <span aria-hidden="true">⚡</span> VIREL168 กดถอนเองผ่านหน้าเว็บ ยอดโอนเข้าบัญชีภายในไม่กี่วินาที
      </p>
    </div>

    <div data-winners-feed data-interval="3000" data-max-rows="12" data-user-digits="0" data-insert="scatter" class="relative z-10 flex flex-wrap justify-center gap-3">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-pill transition-all duration-500 ease-out">
            <div class="flex items-center gap-3 rounded-full border border-[#e2a52d]/40 bg-[#0a0501] py-1.5 pr-4 pl-1.5 shadow-[0_4px_12px_rgba(226,165,45,0.18)] hover:border-[#e1e1e1]/70">
              <div data-winner-bank class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full ${row.bank.color}`}>
                <img data-winner-icon src={row.bank.icon} alt="" width="16" height="16" loading="lazy" decoding="async" class="h-4 w-4 object-contain" />
              </div>
              <div data-winner-user class="text-sm font-bold text-[#f4e7cd]">
                {row.user}
              </div>
              <div class="text-sm font-black text-[#ffeec2]">
                +<span data-winner-amount>{row.amount}</span> ฿
              </div>
              <span
                data-winner-status
                data-pending-text={PENDING_TEXT}
                data-done-text={DONE_TEXT}
                data-pending-class={PENDING_CLASS}
                data-done-class={DONE_CLASS}
                class={`border-l border-[#442503] pl-3 text-[10px] font-bold tracking-wide ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                {row.pending ? PENDING_TEXT : DONE_TEXT}
              </span>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .winner-pill.is-entering {
    transform: scale(0.9);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-pill {
      transition: none;
    }
  }
</style>
