---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// LOTTOTAX: การ์ดใบนี้เคยเป็นทองคู่กรมท่าของแบรนด์หวยก่อนหน้า รอบนี้ย้ายมาที่
// น้ำเงินธงชาติเป็นสีนำ แดงเป็นสีรอง บนผิวกรมท่าเข้ม — น้ำเงิน #dbeafe /
// #5c9bf0 / #1e63d8 / #12357e / #0d2559 คู่แดง #e63c28 / #a81c04 บนผิว
// #04091a / #081530 / #0b1b3a เนื้อความ #e6eefb
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// การ์ดใบนี้ flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่
// wrapper <div class="relative z-10"> กลับเข้ามา และ text-center ต้องอยู่บน
// header/heading เท่านั้น — เคยหลุดขึ้นไปอยู่บนการ์ดจนย่อหน้าถูกจัดกึ่งกลางทั้งใบ
// ตัวการ์ดจึงถือ text-left text-base leading-relaxed ให้ slot มาแล้ว
//
// ผู้เรียกใช้ตอนนี้คือ /ตรวจหวย และ /แนวทาง — สองหน้าหวยของแบรนด์นี้
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#1e63d8]/35 bg-[#0b1b3a]/95 p-8 text-left text-base leading-relaxed text-[#e6eefb] shadow-[0_10px_30px_rgba(30,99,216,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#1e63d8]/60 hover:shadow-[0_15px_40px_rgba(30,99,216,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#1e63d8]/25 blur-[50px] transition-all duration-500 group-hover:bg-[#1e63d8]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#a81c04]/45 blur-[50px] transition-all duration-500 group-hover:bg-[#e63c28]/55"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#1e63d8]/35 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#5c9bf0] via-[#1e63d8] to-[#12357e] shadow-[0_0_10px_rgba(30,99,216,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#dbeafe] via-[#5c9bf0] to-[#1e63d8] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
