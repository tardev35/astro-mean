---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// XTOP666: ย้ายชุดสีมาที่ส้มเรซซิ่งคู่แดงหลอมของแบรนด์นี้ (ค่า hex เดิมไม่พิมพ์ไว้
// ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาส
// จากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history) — ส้ม #fc5b03
// / #ff8a3d / #ffc9a3 / #a33200 คู่แดง #e11212 / #ff5a4d บนผิว #1a0603 / #0a0403
// เนื้อความ #f6e5dc และ #fff0e6 เป็นหัวไล่สีของป้าย ไม่มีทองเหลืออยู่
//
// ป้ายหัวข้อเป็น w-[92%] max-w-2xl text-center — ห้ามใส่ whitespace-nowrap กลับมา
// ตัวนั้นคือสิ่งที่เคยดันป้ายทะลุขอบจอมือถือแล้วทำให้ทั้งหน้าเลื่อนแนวนอนได้
//
// pt-32/md:pt-28 คงไว้ ป้ายถูกตรึงที่ -top-6 ขอบล่างจึงอยู่ที่ (ความสูงป้าย − 24px)
// นับจากขอบบนการ์ด คิดกับหัวข้อ H2 ข้อ 5 ของ docx XTOP666 ที่ไฟล์นี้รับ ยาว 63
// ตัวอักษร ("ระบบพร้อมบวก วางทุกเมนูให้หยิบใช้คล่องโดยไม่ต้องวนหาให้เสียเวลา")
// chrome ของป้าย = py-2.5 (20px) + border-2 (4px) = 24px:
//   จอ 360px — การ์ด 328px, ป้าย w-[92%] = 302px, หัก px-4 (32px) กับ ✦ สองตัว
//   บวก gap-2 (~42px) เหลือพื้นที่ข้อความ ~228px, text-base + tracking-tighter
//   ≈ 7.5px ต่อตัวอักษร → ~30 ตัวต่อบรรทัด หัวข้อ 63 ตัวจึงตัดเป็น 3 บรรทัด เผื่อ
//   แบบแย่สุด 4 บรรทัด: leading-normal ที่ 16px = 24px ต่อบรรทัด → 96px + 24px =
//   120px ขอบล่างอยู่ที่ 96px เทียบกับ pt-32 (128px) → เหลือช่องว่าง 32px
//   md — ป้ายถูกจำกัดที่ max-w-2xl (672px) หัก px-8 (64px) กับคู่ ✦ เหลือ ~566px,
//   md:text-2xl = 36px ต่อบรรทัด ใส่ได้ ~43 ตัวต่อบรรทัด → 2 บรรทัด = 72px + 24px
//   = 96px ขอบล่างอยู่ที่ 72px เทียบกับ md:pt-28 (112px) → เหลือ 40px
// ให้ไฟล์นี้ตื้นกว่า ContentBoxFloatingBadge (pt-44/md:pt-36) เสมอ
//
// ✦ สองตัวเป็น sibling ที่ aria-hidden ไม่ได้อยู่ในข้อความของหัวข้อ
//
// titleleft/titleright render เป็น <p> ป้ายคอลัมน์ เพราะ docx ของแบรนด์นี้แบน
// H1 + H2 ล้วน ไม่มี H3 เลย หัวข้อ section รับผ่าน `title` + `as` ตัวเดียว
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div class="relative w-full max-w-7xl rounded-2xl border-2 border-[#fc5b03]/40 bg-gradient-to-b from-[#1a0603] to-[#0a0403] p-8 pt-32 shadow-[0_10px_40px_rgba(10,4,3,0.6)] md:pt-28">
    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#e11212]/50 bg-[#0a0403] px-4 py-2.5 text-center shadow-[0_5px_15px_rgba(225,18,18,0.25)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#ff5a4d]">
            ✦
          </span>
          <HeadingTag class="bg-gradient-to-r from-[#fff0e6] via-[#ff8a3d] to-[#fc5b03] bg-clip-text text-base leading-normal font-black tracking-tighter text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#ff5a4d]">
            ✦
          </span>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e5dc]/90">
        {titleleft && <p class="text-2xl leading-normal font-bold text-[#ff5a4d] drop-shadow-[0_0_5px_rgba(225,18,18,0.3)]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e5dc]/90 md:border-l md:border-[#fc5b03]/30 md:pl-10">
        {titleright && <p class="text-2xl leading-normal font-bold text-[#ff5a4d] drop-shadow-[0_0_5px_rgba(225,18,18,0.3)]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
