---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// เมนูชุดเดียว ใช้ทั้งเดสก์ท็อปและเมนูวงกลมบนมือถือ
//
// icon แยกเป็น <span aria-hidden="true"> ของตัวเอง เป็นพี่น้องกับ label ห้ามต่อ
// เข้าไปในข้อความ เพราะ emoji จะกลายเป็นส่วนหนึ่งของ accessible name —
// tools/verify-build.mjs ตรวจข้อนี้ build จะแดงถ้าพลาด
//
// ลำดับ: หน้าแรก → โปรโมชั่น → ที่เหลือ แบรนด์นี้ปิดสวิตช์หน้า cta
// (/login กับ /register ยังเป็นหน้า forward แบบ noindex) เมนูจึงไม่มีรายการ
// สมัครสมาชิก/เข้าสู่ระบบ ให้จัดลำดับ และ /ทางเข้า ยังอยู่ในเมนูตามเดิม
//
// ROOM89 เป็นเว็บสล็อต/คาสิโน หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ (อยู่ใน
// src/pages-disabled/) ห้ามมีลิงก์ถึง
//
// ไอคอนเลือกให้ตรงกับอาร์ตของแบรนด์ — 👑 คือมงกุฎทองที่ประดับอยู่เหนือเลข 8
// ในโลโก้และบนศีรษะนางแบบในแบนเนอร์ ใช้แทนหน้าเกี่ยวกับเรา 🎰 คือตู้สล็อตเลข
// 777 สีทองมุมขวาของแบนเนอร์ ใช้แทนหน้าทดลองเล่น 🎁 แทนหน้าโปรโมชั่น ส่วน 🚪
// แทนลิงก์ตรงทางเข้าเว็บหลัก
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🚪" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "👑" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];

// โลโก้เคยไม่มี widths/sizes เลย = ส่งไฟล์ต้นฉบับ 1080px ไปวาดในกล่องสูง 50px
// และเคยใส่ fetchpriority="high" แย่ง priority กับ hero banner ที่เป็น LCP จริง
const LOGO_WIDTHS = [112, 224, 336];

const LOGO_ALT =
  "โลโก้ ROOM89 เป็นตัวอักษรทรงเหลี่ยมนูนสามมิติ คำว่า ROOM เป็นทองคำขัดเงาขอบเข้ม ต่อด้วยเลข 89 สีเงินแพลตินัมไล่เงา และมีมงกุฎทองห้าแฉกประดับอยู่เหนือเลข 8";

// ROOM89: ย้ายจากส้มเพลิงคู่ทองของแบรนด์ก่อน (ดูค่าเดิมได้จาก git history —
// ห้ามพิมพ์ hex ของแบรนด์ก่อนทิ้งไว้ในคอมเมนต์ Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์) มาเป็นทองคำคู่เงินแพลตินัมบนดำอมน้ำตาล ตามโลโก้ที่คำว่า
// ROOM เป็นทองและเลข 89 เป็นเงิน — ทอง #c9a227 / #e6cf72 / #f7edc4 / #6b5424
// คู่เงิน #b9c2cc / #e8ebef / #7c8794 บนผิว #0b0805 / #161009 / #1a1208
// เนื้อความ #f0e6cf รอง #c4b696
// (วัดจาก palette.json: vivid ของโลโก้คือ #f6ebbc / #ebdd93 / #e3d36c / #6b5424
// ส่วน dominant ของแบนเนอร์เป็นดำอมน้ำตาล #030201 / #140b04 และ dominant ของ
// โลโก้ให้เทาเงิน #ebebeb / #e4e4e4 ซึ่งเป็นที่มาของคู่เงิน)
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-50 w-full border-b border-[#c9a227]/35 bg-gradient-to-r from-[#0b0805] via-[#1a1208] to-[#0b0805] shadow-[0_4px_25px_rgba(0,0,0,0.75)]">
    <div class="mx-auto flex h-[70px] w-full max-w-[1600px] items-center justify-between px-4 lg:h-[85px] lg:px-8">
      <div class="flex items-center">
        <a href="/" class="relative flex-shrink-0 transition-transform hover:scale-105">
          <div aria-hidden="true" class="absolute inset-0 rounded-full bg-[#c9a227]/25 blur-xl"></div>
          <Picture
            src={mainLogo!}
            alt={LOGO_ALT}
            loading="eager"
            widths={LOGO_WIDTHS}
            sizes="112px"
            class="relative h-[40px] w-auto drop-shadow-[0_0_8px_rgba(201,162,39,0.6)] lg:h-[50px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-2 lg:flex xl:gap-4">
        {
          links.map((link) => (
            <a
              href={link.path}
              class={`group relative flex h-full items-center gap-2 px-4 text-sm font-bold transition-all duration-300 xl:px-6 xl:text-base ${isActive(link.path) ? "text-[#f7edc4]" : "text-[#f0e6cf]/80 hover:text-[#f7edc4]"}`}>
              <div
                aria-hidden="true"
                class={`absolute inset-0 bg-gradient-to-b from-transparent to-[#6b5424]/45 transition-opacity duration-300 ${isActive(link.path) ? "opacity-100" : "opacity-0 group-hover:opacity-100"}`}
              />
              <span aria-hidden="true" class="relative z-10 text-base">
                {link.icon}
              </span>
              <span class="relative z-10">{link.name}</span>
              <div
                class={`absolute bottom-0 left-1/2 h-[3px] -translate-x-1/2 bg-gradient-to-r from-[#c9a227] to-[#f7edc4] transition-all duration-300 ${isActive(link.path) ? "w-full" : "w-0 group-hover:w-full"}`}
              />
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-3 md:gap-4">
        <a
          href="/login"
          class="hidden items-center justify-center rounded-full border border-[#b9c2cc]/70 px-6 py-2.5 text-sm font-bold text-[#e8ebef] shadow-[0_0_10px_rgba(185,194,204,0.3)] transition-all hover:bg-[#e8ebef] hover:text-[#0b0805] lg:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/register"
          class="hidden items-center justify-center rounded-full bg-gradient-to-r from-[#e6cf72] via-[#c9a227] to-[#6b5424] px-6 py-2.5 text-sm font-extrabold text-[#0b0805] shadow-[0_0_20px_rgba(201,162,39,0.5)] transition-all hover:scale-105 hover:brightness-110 lg:flex">
          สมัครสมาชิก
        </a>

        <button
          id="hamburger-btn"
          class="relative z-[60] flex h-10 w-10 flex-col items-center justify-center overflow-hidden rounded-full border-2 border-[#1a1208] bg-gradient-to-tr from-[#c9a227] to-[#f7edc4] shadow-[0_0_15px_rgba(201,162,39,0.55)] lg:hidden"
          aria-label="Menu">
          <span class="hamburger-line absolute h-[2px] w-5 -translate-y-1.5 transform rounded-full bg-[#0b0805] transition-all duration-300"></span>
          <span class="hamburger-line absolute h-[2px] w-5 rounded-full bg-[#0b0805] transition-all duration-300"></span>
          <span class="hamburger-line absolute h-[2px] w-5 translate-y-1.5 transform rounded-full bg-[#0b0805] transition-all duration-300"></span>
        </button>
      </div>
    </div>
  </nav>

  <div id="mobile-circular-menu" class="pointer-events-none fixed inset-0 z-40 flex flex-col items-center justify-center bg-[#0b0805]/98 backdrop-blur-2xl lg:hidden">
    <div class="flex w-full flex-col items-center space-y-6 px-6">
      <Picture
        src={mainLogo!}
        alt=""
        widths={LOGO_WIDTHS}
        sizes="112px"
        loading="lazy"
        decoding="async"
        class="menu-item mb-6 h-[50px] w-auto opacity-0 drop-shadow-[0_0_15px_rgba(201,162,39,0.6)]"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
      />

      {
        links.map((link) => (
          <a
            href={link.path}
            class={`menu-item flex items-center gap-3 text-3xl font-black tracking-wider uppercase opacity-0 transition-all duration-300 ${isActive(link.path) ? "text-[#f7edc4] drop-shadow-[0_0_8px_rgba(247,237,196,0.85)]" : "text-[#f0e6cf]/80 hover:text-[#f7edc4]"}`}>
            <span aria-hidden="true" class="text-2xl">
              {link.icon}
            </span>
            {link.name}
          </a>
        ))
      }

      <div class="menu-item mt-4 flex w-full max-w-[280px] flex-col gap-4 border-t border-[#c9a227]/40 pt-8 opacity-0">
        <a
          href="/register"
          class="flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#e6cf72] via-[#c9a227] to-[#6b5424] py-3.5 text-lg font-extrabold text-[#0b0805] shadow-[0_0_20px_rgba(201,162,39,0.5)]">
          <span aria-hidden="true">🎁</span> สมัครสมาชิก
        </a>
        <a href="/login" class="flex w-full items-center justify-center rounded-full border border-[#b9c2cc]/50 py-3.5 text-lg font-bold text-[#e8ebef] hover:bg-[#b9c2cc]/10">เข้าสู่ระบบ</a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  /* อนิเมชั่น Hamburger กลายเป็น X (ตัวเส้นเป็น absolute เลยต้องกำหนดองศาใหม่) */
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(0) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(0) rotate(-45deg);
  }

  /* Circular Reveal ด้วย clip-path — วงกลมเริ่มที่มุมขวาบน (ซ่อนไว้ขนาด 0%) */
  #mobile-circular-menu {
    clip-path: circle(0% at calc(100% - 35px) 35px);
    transition: clip-path 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* เมื่อใส่คลาส open วงกลมจะขยายตัวเป็น 150% กินพื้นที่เต็มจอ */
  #mobile-circular-menu.menu-open {
    clip-path: circle(150% at calc(100% - 35px) 35px);
    pointer-events: auto;
  }

  /* อนิเมชั่นเด้งไล่ระดับของเมนู (ลอยขึ้นมาจากข้างล่าง) */
  .menu-item {
    transform: translateY(30px);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .menu-item.item-show {
    opacity: 1 !important; /* บังคับทับ opacity-0 ของ Tailwind */
    transform: translateY(0);
  }

  /* หน่วงเวลาให้ข้อความเด้งขึ้นมาทีละอัน — 1 = โลโก้, 2-7 = เมนู 6 รายการ,
     8 = กล่องปุ่ม ถ้าเพิ่ม/ลดรายการเมนูต้องไล่แก้ช่วงนี้ให้ครบด้วย */
  .menu-item:nth-child(1) {
    transition-delay: 0.2s;
  }
  .menu-item:nth-child(2) {
    transition-delay: 0.25s;
  }
  .menu-item:nth-child(3) {
    transition-delay: 0.3s;
  }
  .menu-item:nth-child(4) {
    transition-delay: 0.35s;
  }
  .menu-item:nth-child(5) {
    transition-delay: 0.4s;
  }
  .menu-item:nth-child(6) {
    transition-delay: 0.45s;
  }
  .menu-item:nth-child(7) {
    transition-delay: 0.5s;
  }
  .menu-item:nth-child(8) {
    transition-delay: 0.55s;
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-circular-menu,
    .menu-item {
      transition: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const circularMenu = document.getElementById("mobile-circular-menu");
  const menuItems = document.querySelectorAll(".menu-item");

  const toggleCircularMenu = () => {
    hamburgerBtn?.classList.toggle("active");
    circularMenu?.classList.toggle("menu-open");

    if (circularMenu?.classList.contains("menu-open")) {
      document.body.style.overflow = "hidden";
      menuItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      menuItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleCircularMenu);

  // ปิดเมนูเวลากดเลือกลิงก์
  menuItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (circularMenu?.classList.contains("menu-open")) {
        toggleCircularMenu();
      }
    });
  });
</script>
