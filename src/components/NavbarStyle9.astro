---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// เมนูชุดเดียว ใช้ทั้งเดสก์ท็อปและเมนูวงกลมบนมือถือ
//
// icon แยกเป็น <span aria-hidden="true"> ของตัวเอง เป็นพี่น้องกับ label ห้ามต่อ
// เข้าไปในข้อความ เพราะ emoji จะกลายเป็นส่วนหนึ่งของ accessible name —
// tools/verify-build.mjs ตรวจข้อนี้ build จะแดงถ้าพลาด
//
// ลำดับ: หน้าแรก → โปรโมชั่น → ที่เหลือ แบรนด์นี้ปิดสวิตช์หน้า cta
// (/login กับ /register ยังเป็นหน้า forward แบบ noindex) เมนูจึงไม่มีรายการ
// สมัครสมาชิก/เข้าสู่ระบบ ให้จัดลำดับ และ /ทางเข้า ยังอยู่ในเมนูตามเดิม
//
// XTOP666 เป็นเว็บสล็อต หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ ห้ามมีลิงก์ถึง
//
// ไอคอนเลือกให้ตรงกับแถบไอคอนห้าช่องบนแบนเนอร์ของแบรนด์ — 🎰 คือตู้สล็อตที่หน้าจอ
// โทรศัพท์ในภาพ ใช้แทนหน้าทดลองเล่น 🚪 แทนลิงก์ตรงทางเข้าเว็บหลัก และ 🛡️ คือโล่
// "ปลอดภัย 100% มั่นคง เชื่อถือได้" ใช้แทนหน้าเกี่ยวกับเรา
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🚪" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🛡️" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];

// โลโก้เคยไม่มี widths/sizes เลย = ส่งไฟล์ต้นฉบับ 1080px ไปวาดในกล่องสูง 50px
// และเคยใส่ fetchpriority="high" แย่ง priority กับ hero banner ที่เป็น LCP จริง
const LOGO_WIDTHS = [112, 224, 336];

const LOGO_ALT =
  "โลโก้ XTOP666 ตัวอักษร T กับ P สีเงินโครเมียมขนาดใหญ่ มีตัว X สีส้มหลอมเหลวพาดทับตรงกลางเป็นรูปกากบาทสี่แฉก ซ้อนด้วยตัว X สีเงินอีกชั้นตรงจุดตัด ใต้ลงมาเป็นคำว่า XTOP โดยตัว X เป็นสีส้ม";

// XTOP666: ย้ายจากแดงส้มคู่ทองของแบรนด์ก่อน (ดูค่าเดิมได้จาก git history — ห้าม
// พิมพ์ hex ของแบรนด์ก่อนทิ้งไว้ในคอมเมนต์ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้
// ว่าเป็นคอมเมนต์) มาเป็นส้มไฟคู่ทองของแบรนด์นี้ — ส้ม #fc5b02 / #ff8c3a /
// #ffd9bd / #7a2601 คู่ทอง #ffb020 / #ffd76e บนผิว #0a0503 / #1c0d05 / #2a1206
// เนื้อความ #ffe8d8 (วัดจาก palette.json: vivid ของโลโก้คือ #fc5b02 / #fa5302 /
// #fd6302 / #f54c03 / #fe6b02 ส่วน dominant ของแบนเนอร์เป็นดำอมน้ำตาล #020101)
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-50 w-full border-b border-[#fc5b02]/35 bg-gradient-to-r from-[#0a0503] via-[#2a1206] to-[#0a0503] shadow-[0_4px_25px_rgba(10,5,3,0.75)]">
    <div class="mx-auto flex h-[70px] w-full max-w-[1600px] items-center justify-between px-4 lg:h-[85px] lg:px-8">
      <div class="flex items-center">
        <a href="/" class="relative flex-shrink-0 transition-transform hover:scale-105">
          <div aria-hidden="true" class="absolute inset-0 rounded-full bg-[#fc5b02]/25 blur-xl"></div>
          <Picture
            src={mainLogo!}
            alt={LOGO_ALT}
            loading="eager"
            widths={LOGO_WIDTHS}
            sizes="112px"
            class="relative h-[40px] w-auto drop-shadow-[0_0_8px_rgba(252,91,2,0.6)] lg:h-[50px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-2 lg:flex xl:gap-4">
        {
          links.map((link) => (
            <a
              href={link.path}
              class={`group relative flex h-full items-center gap-2 px-4 text-sm font-bold transition-all duration-300 xl:px-6 xl:text-base ${isActive(link.path) ? "text-[#ffd9bd]" : "text-[#ffe8d8]/80 hover:text-[#ffd9bd]"}`}>
              <div
                aria-hidden="true"
                class={`absolute inset-0 bg-gradient-to-b from-transparent to-[#fc5b02]/45 transition-opacity duration-300 ${isActive(link.path) ? "opacity-100" : "opacity-0 group-hover:opacity-100"}`}
              />
              <span aria-hidden="true" class="relative z-10 text-base">
                {link.icon}
              </span>
              <span class="relative z-10">{link.name}</span>
              <div
                class={`absolute bottom-0 left-1/2 h-[3px] -translate-x-1/2 bg-gradient-to-r from-[#ffb020] to-[#fc5b02] transition-all duration-300 ${isActive(link.path) ? "w-full" : "w-0 group-hover:w-full"}`}
              />
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-3 md:gap-4">
        <a
          href="/login"
          class="hidden items-center justify-center rounded-full border border-[#fc5b02]/70 px-6 py-2.5 text-sm font-bold text-[#ffd9bd] shadow-[0_0_10px_rgba(252,91,2,0.3)] transition-all hover:bg-[#fc5b02] hover:text-[#0a0503] lg:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/register"
          class="hidden items-center justify-center rounded-full bg-gradient-to-r from-[#ffd76e] via-[#ffb020] to-[#fc5b02] px-6 py-2.5 text-sm font-extrabold text-[#2a1206] shadow-[0_0_20px_rgba(252,91,2,0.5)] transition-all hover:scale-105 hover:brightness-110 lg:flex">
          สมัครสมาชิก
        </a>

        <button
          id="hamburger-btn"
          class="relative z-[60] flex h-10 w-10 flex-col items-center justify-center overflow-hidden rounded-full border-2 border-[#2a1206] bg-gradient-to-tr from-[#fc5b02] to-[#ffb020] shadow-[0_0_15px_rgba(252,91,2,0.55)] lg:hidden"
          aria-label="Menu">
          <span class="hamburger-line absolute h-[2px] w-5 -translate-y-1.5 transform rounded-full bg-[#0a0503] transition-all duration-300"></span>
          <span class="hamburger-line absolute h-[2px] w-5 rounded-full bg-[#0a0503] transition-all duration-300"></span>
          <span class="hamburger-line absolute h-[2px] w-5 translate-y-1.5 transform rounded-full bg-[#0a0503] transition-all duration-300"></span>
        </button>
      </div>
    </div>
  </nav>

  <div id="mobile-circular-menu" class="pointer-events-none fixed inset-0 z-40 flex flex-col items-center justify-center bg-[#0a0503]/98 backdrop-blur-2xl lg:hidden">
    <div class="flex w-full flex-col items-center space-y-6 px-6">
      <Picture
        src={mainLogo!}
        alt=""
        widths={LOGO_WIDTHS}
        sizes="112px"
        loading="lazy"
        decoding="async"
        class="menu-item mb-6 h-[50px] w-auto opacity-0 drop-shadow-[0_0_15px_rgba(252,91,2,0.6)]"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
      />

      {
        links.map((link) => (
          <a
            href={link.path}
            class={`menu-item flex items-center gap-3 text-3xl font-black tracking-wider uppercase opacity-0 transition-all duration-300 ${isActive(link.path) ? "text-[#ffd9bd] drop-shadow-[0_0_8px_rgba(252,91,2,0.85)]" : "text-[#ffe8d8]/80 hover:text-white"}`}>
            <span aria-hidden="true" class="text-2xl">
              {link.icon}
            </span>
            {link.name}
          </a>
        ))
      }

      <div class="menu-item mt-4 flex w-full max-w-[280px] flex-col gap-4 border-t border-[#fc5b02]/40 pt-8 opacity-0">
        <a
          href="/register"
          class="flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#ffd76e] via-[#ffb020] to-[#fc5b02] py-3.5 text-lg font-extrabold text-[#2a1206] shadow-[0_0_20px_rgba(252,91,2,0.5)]">
          <span aria-hidden="true">🎁</span> สมัครสมาชิก
        </a>
        <a href="/login" class="flex w-full items-center justify-center rounded-full border border-[#fc5b02]/50 py-3.5 text-lg font-bold text-[#ffd9bd] hover:bg-[#fc5b02]/10">เข้าสู่ระบบ</a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  /* อนิเมชั่น Hamburger กลายเป็น X (ตัวเส้นเป็น absolute เลยต้องกำหนดองศาใหม่) */
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(0) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(0) rotate(-45deg);
  }

  /* Circular Reveal ด้วย clip-path — วงกลมเริ่มที่มุมขวาบน (ซ่อนไว้ขนาด 0%) */
  #mobile-circular-menu {
    clip-path: circle(0% at calc(100% - 35px) 35px);
    transition: clip-path 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* เมื่อใส่คลาส open วงกลมจะขยายตัวเป็น 150% กินพื้นที่เต็มจอ */
  #mobile-circular-menu.menu-open {
    clip-path: circle(150% at calc(100% - 35px) 35px);
    pointer-events: auto;
  }

  /* อนิเมชั่นเด้งไล่ระดับของเมนู (ลอยขึ้นมาจากข้างล่าง) */
  .menu-item {
    transform: translateY(30px);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .menu-item.item-show {
    opacity: 1 !important; /* บังคับทับ opacity-0 ของ Tailwind */
    transform: translateY(0);
  }

  /* หน่วงเวลาให้ข้อความเด้งขึ้นมาทีละอัน — 1 = โลโก้, 2-7 = เมนู 6 รายการ,
     8 = กล่องปุ่ม ถ้าเพิ่ม/ลดรายการเมนูต้องไล่แก้ช่วงนี้ให้ครบด้วย */
  .menu-item:nth-child(1) {
    transition-delay: 0.2s;
  }
  .menu-item:nth-child(2) {
    transition-delay: 0.25s;
  }
  .menu-item:nth-child(3) {
    transition-delay: 0.3s;
  }
  .menu-item:nth-child(4) {
    transition-delay: 0.35s;
  }
  .menu-item:nth-child(5) {
    transition-delay: 0.4s;
  }
  .menu-item:nth-child(6) {
    transition-delay: 0.45s;
  }
  .menu-item:nth-child(7) {
    transition-delay: 0.5s;
  }
  .menu-item:nth-child(8) {
    transition-delay: 0.55s;
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-circular-menu,
    .menu-item {
      transition: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const circularMenu = document.getElementById("mobile-circular-menu");
  const menuItems = document.querySelectorAll(".menu-item");

  const toggleCircularMenu = () => {
    hamburgerBtn?.classList.toggle("active");
    circularMenu?.classList.toggle("menu-open");

    if (circularMenu?.classList.contains("menu-open")) {
      document.body.style.overflow = "hidden";
      menuItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      menuItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleCircularMenu);

  // ปิดเมนูเวลากดเลือกลิงก์
  menuItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (circularMenu?.classList.contains("menu-open")) {
        toggleCircularMenu();
      }
    });
  });
</script>
