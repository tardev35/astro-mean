---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label } = Astro.props;

// JUDTEM168: this variant arrived on an unrelated brand's emerald palette
// (emerald-400/500, #021207, gray-400). Remapped onto gold — #feeb33 / #fac42c
// / #e4a434 / #cc8425 on #150d04, body #f3e3c4, muted #d8c49a.
//
// HEADINGS: the three column titles used to be <h2> each, so one docx section
// rendered as three headings. They are column LABELS, not docx sections, so
// they are <p> now. The single `title` prop is the one heading this component
// can emit; it carries the docx H2 for the section.
const sectionLabel = title ? undefined : (label ?? titleleft ?? titlecenter ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative w-full overflow-hidden rounded-3xl border border-[#e4a434]/30 bg-[#150d04]/88 p-8 text-[#f3e3c4] shadow-[0_10px_30px_rgba(250,196,44,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#feeb33]/55 md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#7a4a0d]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#cc8425]/50"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#fac42c]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#feeb33]/35"></div>

    {
      title && (
        <header class="relative z-10 mb-8 flex items-center gap-4 border-b border-[#e4a434]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#feeb33] via-[#e4a434] to-[#7a4a0d] shadow-[0_0_10px_rgba(250,196,44,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#feeb33] via-[#fac42c] to-[#cc8425] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="relative z-10 grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#7a4a0d]/60 pb-8 text-left text-base leading-relaxed text-[#f3e3c4] transition-all hover:-translate-y-1 md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#fac42c] uppercase">
              <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(250,196,44,0.8)]">
                🎯
              </span>{" "}
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#7a4a0d]/60 pb-8 text-left text-base leading-relaxed text-[#f3e3c4] transition-all hover:-translate-y-1 md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#fac42c] uppercase">
              <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(250,196,44,0.8)]">
                ⚡
              </span>{" "}
              {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f3e3c4] transition-all hover:-translate-y-1 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#fac42c] uppercase">
              <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(250,196,44,0.8)]">
                🚀
              </span>{" "}
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
