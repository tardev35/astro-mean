---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label } = Astro.props;

// ASHTON168: ย้ายชุดสีของแบรนด์ก่อนออกทั้งหมด (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ
// Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มี
// ใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history) มาที่ทองสว่างคู่เงิน
// โครเมียม — ทอง #f5c518 / #ffd75e / #ffe9a3 / #c8941a / #a87908 / #7a5405
// คู่เงิน #e2e5e9 / #f0f2f5 บนผิว #160e03 / #080502 / #2a1c06 เนื้อความ #f0e6d2
// ข้อความรอง #c9bda2
//
// HEADINGS: หัวคอลัมน์ทั้งสามเป็น <p> ไม่ใช่หัวข้อ — มันตั้งชื่อคอลัมน์ ไม่ใช่
// section ของ docx ส่วน prop `title` คือหัวข้อเดียวที่ component นี้ปล่อยออกมาได้
// รอบนี้บล็อกนี้แบกหัวข้อ docx ข้อ 6 (โปรคุ้มสุด ๆ มีหลายจังหวะให้เลือกใช้ได้ตรง
// สไตล์) ไอคอนสามใบจึงเป็นของขวัญ เงินทุน และคูปองเครดิต
const sectionLabel = title ? undefined : (label ?? titleleft ?? titlecenter ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f5c518]/30 bg-[#160e03]/88 p-8 text-[#f0e6d2] shadow-[0_10px_30px_rgba(245,197,24,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#e2e5e9]/55 md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#7a5405]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#f5c518]/50"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#2a1c06]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#e2e5e9]/30"></div>

    {
      title && (
        <header class="relative z-10 mb-8 flex items-center gap-4 border-b border-[#f5c518]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a3] via-[#f5c518] to-[#7a5405] shadow-[0_0_10px_rgba(245,197,24,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe9a3] via-[#f5c518] to-[#e2e5e9] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="relative z-10 grid grid-cols-1 gap-8 md:grid-cols-3">
      <article
        class="flex flex-col gap-3 border-b border-[#7a5405]/60 pb-8 text-left text-base leading-relaxed text-[#f0e6d2] transition-all hover:-translate-y-1 md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffd75e] uppercase">
              <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(245,197,24,0.8)]">
                🎁
              </span>
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article
        class="flex flex-col gap-3 border-b border-[#7a5405]/60 pb-8 text-left text-base leading-relaxed text-[#f0e6d2] transition-all hover:-translate-y-1 md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffd75e] uppercase">
              <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(245,197,24,0.8)]">
                💰
              </span>
              {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f0e6d2] transition-all hover:-translate-y-1 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffd75e] uppercase">
              <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(245,197,24,0.8)]">
                🎟️
              </span>
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
