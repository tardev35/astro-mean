---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label } = Astro.props;

// FUSIONNEW: ย้ายจากทองของแบรนด์ก่อน (#feeb33 / #fac42c / #e4a434 / #cc8425 /
// #7a4a0d บนผิว #150d04 เนื้อความ #f3e3c4 ข้อความรอง #d8c49a) มาที่แดงสัญญาณ +
// โครมเงิน — #ff5f52 / #e01a1a / #8c0102 คู่กับ #d9dde3 / #97a0a8 / #4a5157
// บนผิว #150809 / #1f0c0d / #0a0405 เนื้อความ #e7e3e1 ข้อความรอง #c3bcb9
//
// HEADINGS: หัวคอลัมน์ทั้งสามเป็น <p> ไม่ใช่หัวข้อ — มันตั้งชื่อคอลัมน์ ไม่ใช่
// section ของ docx ส่วน prop `title` คือหัวข้อเดียวที่ component นี้ปล่อยออกมาได้
const sectionLabel = title ? undefined : (label ?? titleleft ?? titlecenter ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#e01a1a]/30 bg-[#150809]/88 p-8 text-[#e7e3e1] shadow-[0_10px_30px_rgba(224,26,26,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff5f52]/55 md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#8c0102]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#e01a1a]/50"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#4a5157]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#d9dde3]/30"></div>

    {
      title && (
        <header class="relative z-10 mb-8 flex items-center gap-4 border-b border-[#e01a1a]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff5f52] via-[#e01a1a] to-[#8c0102] shadow-[0_0_10px_rgba(224,26,26,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#d9dde3] via-[#ff5f52] to-[#e01a1a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="relative z-10 grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#4a5157]/60 pb-8 text-left text-base leading-relaxed text-[#e7e3e1] transition-all hover:-translate-y-1 md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ff5f52] uppercase">
              <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(224,26,26,0.8)]">
                🎯
              </span>{" "}
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#4a5157]/60 pb-8 text-left text-base leading-relaxed text-[#e7e3e1] transition-all hover:-translate-y-1 md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ff5f52] uppercase">
              <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(224,26,26,0.8)]">
                ⚡
              </span>{" "}
              {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e7e3e1] transition-all hover:-translate-y-1 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ff5f52] uppercase">
              <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(224,26,26,0.8)]">
                🚀
              </span>{" "}
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
