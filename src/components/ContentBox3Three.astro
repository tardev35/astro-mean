---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label } = Astro.props;

// PAY69: ย้ายชุดสีของแบรนด์ก่อนออกทั้งหมด (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ
// Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มี
// ใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history) มาที่ทองแชมเปญเดี่ยวบนดำ
// สนิท ไม่มีสีคู่ — ทอง #e8c37a / #f7dfa5 / #fdf4e0 / #a87c2e / #6b4d15 บนผิว
// #08070a / #12100c / #1c1811 เนื้อความ #e6dac2 ข้อความรอง #a99a7d
//
// HEADINGS: หัวคอลัมน์ทั้งสามเป็น <p> ไม่ใช่หัวข้อ — มันตั้งชื่อคอลัมน์ ไม่ใช่
// section ของ docx ส่วน prop `title` คือหัวข้อเดียวที่ component นี้ปล่อยออกมาได้
// รอบนี้บล็อกนี้แบกหัวข้อ docx ข้อ 4 (เกมหลายหมวดพร้อมสลับฟีล) ไอคอนสามใบจึงเป็น
// ไพ่บาคาร่า กระเป๋าเงินใบเดียว และนาฬิกาจับเวลาที่ไม่ต้องเสียไปกับการโยกเงิน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titlecenter ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#a87c2e]/35 bg-[#12100c]/90 p-8 text-[#e6dac2] shadow-[0_10px_30px_rgba(107,77,21,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#e8c37a]/55 md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#1c1811]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#a87c2e]/45"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#12100c]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#6b4d15]/50"></div>

    {
      title && (
        <header class="relative z-10 mb-8 flex items-center gap-4 border-b border-[#a87c2e]/35 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf4e0] via-[#e8c37a] to-[#6b4d15] shadow-[0_0_10px_rgba(232,195,122,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdf4e0] via-[#f7dfa5] to-[#e8c37a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="relative z-10 grid grid-cols-1 gap-8 md:grid-cols-3">
      <article
        class="flex flex-col gap-3 border-b border-[#6b4d15]/70 pb-8 text-left text-base leading-relaxed text-[#e6dac2] transition-all hover:-translate-y-1 md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#f7dfa5] uppercase">
              <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(232,195,122,0.8)]">
                🃏
              </span>
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article
        class="flex flex-col gap-3 border-b border-[#6b4d15]/70 pb-8 text-left text-base leading-relaxed text-[#e6dac2] transition-all hover:-translate-y-1 md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#f7dfa5] uppercase">
              <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(232,195,122,0.8)]">
                👛
              </span>
              {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e6dac2] transition-all hover:-translate-y-1 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#f7dfa5] uppercase">
              <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(232,195,122,0.8)]">
                ⏱️
              </span>
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
