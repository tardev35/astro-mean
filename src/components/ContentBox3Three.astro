---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label } = Astro.props;

// AURA456: ย้ายชุดสีของแบรนด์ก่อนออกทั้งหมด (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ
// Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มี
// ใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history) มาที่นีออนบานเย็นคู่ฟ้า
// อิเล็กทริก — บานเย็น #ff2fb0 / #ff7fd4 / #ffc9ee / #c81d8e คู่ฟ้า #3ba9ff /
// #7fd0ff กับม่วง #8b3cf7 / #4a179e บนผิว #0b0528 / #05021a / #1c1046 เนื้อความ
// #d8d3f0 ข้อความรอง #9b93c4
//
// HEADINGS: หัวคอลัมน์ทั้งสามเป็น <p> ไม่ใช่หัวข้อ — มันตั้งชื่อคอลัมน์ ไม่ใช่
// section ของ docx ส่วน prop `title` คือหัวข้อเดียวที่ component นี้ปล่อยออกมาได้
// รอบนี้บล็อกนี้แบกหัวข้อ docx ข้อ 3 (เกมเด็ดพร้อมลั่นจากหลายค่าย) ไอคอนสามใบจึงเป็น
// จอยเกม ตราชั่งอัตราจ่าย และเหรียญเบทเริ่มต้น
const sectionLabel = title ? undefined : (label ?? titleleft ?? titlecenter ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#ff2fb0]/30 bg-[#0b0528]/88 p-8 text-[#d8d3f0] shadow-[0_10px_30px_rgba(255,47,176,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#3ba9ff]/55 md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#4a179e]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#ff2fb0]/50"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#1c1046]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#3ba9ff]/30"></div>

    {
      title && (
        <header class="relative z-10 mb-8 flex items-center gap-4 border-b border-[#ff2fb0]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffc9ee] via-[#ff2fb0] to-[#4a179e] shadow-[0_0_10px_rgba(255,47,176,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffc9ee] via-[#ff2fb0] to-[#3ba9ff] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="relative z-10 grid grid-cols-1 gap-8 md:grid-cols-3">
      <article
        class="flex flex-col gap-3 border-b border-[#4a179e]/60 pb-8 text-left text-base leading-relaxed text-[#d8d3f0] transition-all hover:-translate-y-1 md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ff7fd4] uppercase">
              <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(255,47,176,0.8)]">
                🎮
              </span>
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article
        class="flex flex-col gap-3 border-b border-[#4a179e]/60 pb-8 text-left text-base leading-relaxed text-[#d8d3f0] transition-all hover:-translate-y-1 md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ff7fd4] uppercase">
              <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(255,47,176,0.8)]">
                ⚖️
              </span>
              {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#d8d3f0] transition-all hover:-translate-y-1 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ff7fd4] uppercase">
              <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_8px_rgba(255,47,176,0.8)]">
                🪙
              </span>
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
