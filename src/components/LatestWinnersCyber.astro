---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { brandFlag, brandPick } from "../lib/brandProfile";

// สีในลิสต์นี้เป็นสีโลโก้ธนาคารจริง ไม่ใช่สีแบรนด์ — ห้ามรีธีมตาม palette
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// แถวชุดแรก render จากฝั่งเซิร์ฟเวอร์ เดิมมันถูกสร้างด้วย inline script ซึ่งทิ้ง
// กล่องว่างไว้ใน HTML: ไม่มีอะไรให้ crawler อ่าน ไม่มีอะไรเลยถ้าไม่มี JS และ
// การันตี layout shift ทันทีที่สคริปต์ทำงาน ตอนนี้หน้าเว็บ ship พร้อมแถว แล้ว JS
// แค่มาแทนที่
//
// ค่าพวกนี้มาจาก hash ของโดเมนแบรนด์ ไม่ใช่ Math.random() — brandProfile.ts เขียน
// กติกาไว้ตรงๆ ว่าโดเมนเดิมต้อง build ออกมาได้ byte เดียวกันทุกครั้ง ไม่งั้นทุก
// deploy จะไปกวน markup ของเว็บจริงโดยไม่มีเหตุผล
const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pickFrom = (chars: string, salt: string) => chars.charAt(brandPick(Astro.site, salt, chars.length));

const initialRows = Array.from({ length: 5 }, (_, i) => ({
  bank: bankPool[brandPick(Astro.site, `winner-bank-${i}`, bankPool.length)],
  user: `${pickFrom(LETTERS, `winner-a-${i}`)}${pickFrom(LETTERS, `winner-b-${i}`)}***${[0, 1, 2, 3].map((d) => brandPick(Astro.site, `winner-d${i}-${d}`, 10)).join("")}`,
  amount: (15000 + brandPick(Astro.site, `winner-amount-${i}`, 80001)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `winner-pending-${i}`),
}));
---

<div class="mx-auto w-full max-w-[1300px] p-4">
  <section
    aria-label="รายการฝาก-ถอนล่าสุดผ่านระบบออโต้ของ LONGSAP168"
    class="relative border-r-4 border-l-4 border-[#f2b024] bg-[#170806]/85 px-4 py-8 shadow-[0_0_30px_rgba(242,176,36,0.22)] md:p-10"
    style="clip-path: polygon(20px 0, calc(100% - 20px) 0, 100% 20px, 100% calc(100% - 20px), calc(100% - 20px) 100%, 20px 100%, 0 calc(100% - 20px), 0 20px);">
    <div class="absolute top-0 left-0 h-[1px] w-full bg-gradient-to-r from-transparent via-[#f2b024] to-transparent"></div>
    <div class="absolute bottom-0 left-0 h-[1px] w-full bg-gradient-to-r from-transparent via-[#d81f26] to-transparent"></div>

    <div class="relative z-10 mb-8 flex items-center justify-between border-b border-[#f2b024]/30 pb-4">
      <p class="text-xl font-black tracking-[0.2em] text-[#f2b024] drop-shadow-[0_0_8px_rgba(242,176,36,0.8)]">/// LONGSAP168_AUTO_TRANSACTIONS</p>
      <span class="animate-pulse border border-[#d81f26]/60 px-2 py-1 text-xs font-bold tracking-widest text-[#e3c9ab]">ONLINE</span>
    </div>

    <div
      data-winners-feed
      data-interval="4000"
      data-max-rows="5"
      data-amount-min="15000"
      data-amount-max="95000"
      data-pending-chance="0.4"
      data-user-style="letters"
      data-user-digits="4"
      class="relative z-10 flex flex-col gap-3">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row origin-left transform transition-all duration-500 ease-out">
            <div class="flex items-center justify-between border-l-2 border-[#d81f26] bg-gradient-to-r from-[#7d0508]/40 to-transparent p-3 backdrop-blur-sm transition-colors hover:bg-[#7d0508]/55">
              <div class="flex items-center gap-4">
                <div data-winner-bank class={`flex h-8 w-8 items-center justify-center border border-white/10 bg-black/50 mix-blend-screen ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="20" height="20" loading="lazy" decoding="async" class="h-5 w-5 object-contain grayscale" />
                </div>
                <div class="font-mono text-sm text-[#f6e4c8]">
                  USR_ID:{" "}
                  <span data-winner-user class="font-bold text-[#ffd76a]">
                    {row.user}
                  </span>
                </div>
              </div>
              <div class="flex items-center gap-6">
                <div
                  data-winner-status
                  data-pending-text="[กำลังทำรายการ]"
                  data-done-text="[เงินเข้าแล้ว]"
                  data-pending-class="is-pending"
                  data-done-class="is-verified"
                  class={`winner-status font-mono text-[10px] tracking-widest ${row.pending ? "is-pending" : "is-verified"}`}>
                  {row.pending ? "[กำลังทำรายการ]" : "[เงินเข้าแล้ว]"}
                </div>
                <div class="font-mono text-xl font-black text-[#f2b024] drop-shadow-[0_0_8px_rgba(242,176,36,0.5)]">
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs text-[#a86a0c]">THB</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  // ไม่ใช่ `define:vars` — ตัวนั้นบังคับ is:inline ซึ่งตัด type/async/defer ทิ้ง
  // แล้วเหลือสคริปต์ที่บล็อก parser อยู่กลางเอกสาร รายชื่อธนาคารส่งมาเป็น JSON
  // เฉยๆ ข้างบนแทน และโมดูลนี้ถูก bundle + defer เหมือนโมดูลอื่น
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .font-mono {
    font-family: monospace;
  }

  /* สองสถานะเป็นคลาส ไม่ใช่สตริงใน JS เพื่อให้สคริปต์ไม่ต้องรู้จัก palette ของ
     แบรนด์นี้เลย */
  .winner-status.is-pending {
    color: #e3c9ab;
    border-color: #7d0508;
  }
  .winner-status.is-verified {
    color: oklch(79.2% 0.209 151.711);
    border-color: color-mix(in oklab, oklch(72.3% 0.219 149.579) 50%, transparent);
  }

  .winner-row.is-entering {
    transform: scaleX(0.95);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
