---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// ป้ายชื่อถูกตรึงไว้ที่ -top-6 (24px เหนือขอบบนการ์ด) ขอบล่างของป้ายจึงอยู่ที่
// (ความสูงป้าย − 24px) นับจากขอบบนการ์ด หัวข้อ H1/H2 ภาษาไทยแบบเต็มประโยคทำให้
// ป้ายตัดบรรทัดหลายบรรทัด แล้วบรรทัดสุดท้ายไปทับบรรทัดแรกของเนื้อความ
//
// ไฟล์นี้ลึกกว่า ContentBoxSevenThreeFloatingBadge (pt-36/md:pt-28) กับ
// ContentBox3ThreeFloatingBadge (pt-40/md:pt-32) โดยตั้งใจ — หัวข้อในไฟล์นี้ใช้
// text-lg/text-xl ซึ่งสูงกว่าอีกสองไฟล์หนึ่งสเต็ป และป้ายยังเสียความกว้างให้ไอคอน
// สองตัวข้างหัวข้ออีก ~52px จึงคง pt-44/md:pt-36 ไว้ ให้ไฟล์นี้ลึกกว่าอีกสอง
// *FloatingBadge เสมอ อย่าทำให้เท่ากัน
//
// คำนวณกับหัวข้อ H1 ที่ยาวที่สุดใน docx ของ LUCKYBKK (56 ตัวอักษร) chrome ของป้าย
// = py-2.5 (20px) + border-2 (4px) = 24px:
//   จอ 360px — การ์ด 328px, ป้าย w-[92%] = 302px, หัก px-4 (32px) กับไอคอนสองตัว
//   บวก gap-2 (~42px) เหลือพื้นที่ข้อความ ~228px, text-xl ≈ 9.5px ต่อตัวอักษร
//   → ~24 ตัวต่อบรรทัด หัวข้อจึงตัดเป็น 3 บรรทัด เผื่อแย่สุด 4 บรรทัด:
//   leading-normal ที่ 20px = 30px ต่อบรรทัด → 120px + 24px = 144px ขอบล่างอยู่ที่
//   120px เทียบกับ pt-44 (176px) → เหลือช่องว่าง 56px
//   md — ป้ายถูกจำกัดที่ max-w-2xl (672px) หัก px-8 (64px) กับคู่ไอคอน เหลือ ~556px,
//   text-3xl/leading-normal = 45px ต่อบรรทัด, 2 บรรทัด = 90px + 24px = 114px
//   ขอบล่างอยู่ที่ 90px เทียบกับ md:pt-36 (144px) → เหลือ 54px
// ตัวป้ายเองเป็น w-[92%] max-w-2xl text-center — ห้ามใส่ whitespace-nowrap ซึ่งเป็น
// ตัวที่เคยดันป้ายทะลุขอบจอ
//
// LUCKYBKK: ย้ายจากชมพูกลอสคู่ทองของ GALA89 (#d41c6b / #ff4d9c / #9e154a คู่ทอง
// #ffe0a3 / #f0c274 / #b8801f บนผิว #3c0214 / #12010a เนื้อความ #f7dce8 และเพชร
// ชมพูสองข้างป้าย) มาที่น้ำเงินรอยัลคู่ทอง — น้ำเงิน #3f9dfb / #cfe8ff / #1f5fd0 /
// #0a2a86 กับทอง #ffdf7e / #f0b323 / #9a6c05 บนผิว #061442 / #030b28 เนื้อความ
// #e4eeff โดยไอคอนสองข้างป้ายเปลี่ยนเป็นโพดำตามโลโก้ ไม่มีชมพูเหลืออยู่ในไฟล์นี้
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#f0b323]/30 bg-[#061442]/88 p-8 pt-44 text-left text-base leading-relaxed text-[#e4eeff] shadow-[0_10px_30px_rgba(240,179,35,0.18)] backdrop-blur-md md:pt-36">
    <div class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#3f9dfb]/45 blur-[60px]"></div>
    <div class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#f0b323]/30 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#ffdf7e]/55 bg-[#030b28] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(240,179,35,0.4)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#3f9dfb]">
            ♠
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#ffdf7e] via-[#f0b323] to-[#3f9dfb] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent`}>{title}</HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#3f9dfb]">
            ♠
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
