---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// ป้ายชื่อถูกตรึงไว้ที่ -top-6 (24px เหนือขอบบนการ์ด) ขอบล่างของป้ายจึงอยู่ที่
// (ความสูงป้าย − 24px) นับจากขอบบนการ์ด หัวข้อ H1/H2 ภาษาไทยแบบเต็มประโยคทำให้
// ป้ายตัดบรรทัดหลายบรรทัด แล้วบรรทัดสุดท้ายไปทับบรรทัดแรกของเนื้อความ
//
// ไฟล์นี้ลึกกว่า ContentBoxSevenThreeFloatingBadge (pt-36/md:pt-28) กับ
// ContentBox3ThreeFloatingBadge (pt-40/md:pt-32) โดยตั้งใจ — หัวข้อในไฟล์นี้ใช้
// text-lg/text-xl ซึ่งสูงกว่าอีกสองไฟล์หนึ่งสเต็ป และป้ายยังเสียความกว้างให้ไอคอน
// สองตัวข้างหัวข้ออีก ~52px จึงคง pt-44/md:pt-36 ไว้ ให้ไฟล์นี้ลึกกว่าอีกสอง
// *FloatingBadge เสมอ อย่าทำให้เท่ากัน
//
// คำนวณกับหัวข้อ H2 ข้อ 3 ของ docx GUESS168 ที่ไฟล์นี้รับรอบนี้ (67 ตัวอักษร —
// "เกมอัปเดตใหม่มีอะไรให้ตาม? GUESS168 เติมตัวน่าลองเข้าลิสต์ต่อเนื่อง") ยาวกว่าเคส
// ที่เคยคำนวณไว้เล็กน้อย chrome ของป้าย = py-2.5 (20px) + border-2 (4px) = 24px:
//   จอ 360px — การ์ด 328px, ป้าย w-[92%] = 302px, หัก px-4 (32px) กับไอคอนสองตัว
//   บวก gap-2 (~42px) เหลือพื้นที่ข้อความ ~228px, text-lg ≈ 9px ต่อตัวอักษร
//   → ~25 ตัวต่อบรรทัด หัวข้อ 67 ตัวจึงตัดเป็น 3 บรรทัด เผื่อแย่สุด 4 บรรทัด:
//   leading-normal ที่ 18px = 27px ต่อบรรทัด → 108px + 24px = 132px ขอบล่างอยู่ที่
//   108px เทียบกับ pt-44 (176px) → เหลือช่องว่าง 68px ไม่ต้องดัน pt ขึ้น
//   md — ป้ายถูกจำกัดที่ max-w-2xl (672px) หัก px-8 (64px) กับคู่ไอคอน เหลือ ~566px,
//   md:text-2xl/leading-normal = 36px ต่อบรรทัด, 2 บรรทัด = 72px + 24px = 96px
//   ขอบล่างอยู่ที่ 72px เทียบกับ md:pt-36 (144px) → เหลือ 72px
// ตัวป้ายเองเป็น w-[92%] max-w-2xl text-center — ห้ามใส่ whitespace-nowrap ซึ่งเป็น
// ตัวที่เคยดันป้ายทะลุขอบจอ
//
// GUESS168: ย้ายมาที่ทองหลอมคู่ส้มไฟของแบรนด์นี้ที่วัดจากอาร์ตจริง — ทอง #fecc02 /
// #ffe680 / #ffd54a / #fff6e0 / #c58a00 คู่ส้ม #fe9c01 / #a35800 ซึ่งเป็นสีเน้นรอง
// บนผิว #231005 / #140800 เนื้อความ #f7e7c6 ไอคอนสองข้างป้ายยังเป็นข้าวหลามตัด
// ตามเดิม (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิม
// ได้จาก git history)
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#fecc02]/35 bg-[#231005]/88 p-8 pt-44 text-left text-base leading-relaxed text-[#f7e7c6] shadow-[0_10px_30px_rgba(254,204,2,0.22)] backdrop-blur-md md:pt-36">
    <div class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#fe9c01]/40 blur-[60px]"></div>
    <div class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#a35800]/30 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#ffd54a]/55 bg-[#140800] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(254,204,2,0.4)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#fe9c01]">
            ◆
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#fff6e0] via-[#ffe680] to-[#fe9c01] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent`}>{title}</HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#fe9c01]">
            ◆
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
