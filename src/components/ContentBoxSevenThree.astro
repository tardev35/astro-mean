---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// สองคอลัมน์ถูก flatten แล้ว: คลาสข้อความอยู่บน <article> และ slot เป็นลูกโดยตรง
// ผู้เรียกจึงต้องส่ง "หนึ่ง element ต่อหนึ่ง slot" เท่านั้น (ฝั่ง 3 ส่วนรอบนี้รับ
// <Picture> ใบเดียว)
//
// titleleft/titleright เป็นป้ายคอลัมน์จึงเป็น <p> ส่วนหัวข้อ docx รับผ่าน prop
// `title` + `as` ตัวเดียว หัวข้อจะไปอยู่เหนือคอลัมน์เนื้อความ (ฝั่ง 7 ส่วน) ซึ่ง
// กว้างพอรับหัวข้อยาวของ docx ได้โดยไม่ล้นออกนอกการ์ด
//
// AURORA688: ย้ายจากทองแอมเบอร์–คอปเปอร์คู่แดงรอยัลของ MONACO89 (#ffe9b8 / #ffd77a
// / #ef8f22 / #a44516 / #7e120e บนผิว #26150a / #160d05 / #0b0602 เนื้อความ
// #f6e3c0) มาที่ทองหรูคู่เงินโครเมียมของแบรนด์นี้ — #ffe9a3 / #e2c443 / #c9a13a /
// #7d5714 คู่เงิน #c3cddb / #eef2f7 บนผิว #221c0d / #15120a / #0a0806 เนื้อความ
// #f2ead6 (ข้อความรอง #f2ead6/70)
const sectionLabel = title ? undefined : (label ?? titleright ?? titleleft ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#e2c443]/25 bg-[#15120a]/88 p-8 text-[#f2ead6] shadow-[0_10px_30px_rgba(226,196,67,0.15)] backdrop-blur-xl transition-all duration-500 hover:border-[#e2c443]/50 md:p-10">
    <div class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#7d5714]/50 blur-[60px]"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#e2c443]/25 pb-6 text-left text-base leading-relaxed text-[#f2ead6]/70 md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {titleleft && <p class="bg-gradient-to-r from-[#ffe9a3] via-[#e2c443] to-[#7d5714] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f2ead6] md:pl-6">
        {title && <HeadingTag class="bg-gradient-to-r from-[#eef2f7] via-[#e2c443] to-[#c9a13a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>}
        {
          titleright && (
            <p class="flex items-center gap-2 text-xl leading-normal font-black text-[#e2c443]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#c3cddb] shadow-[0_0_5px_rgba(226,196,67,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
