---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// DEED888: ย้ายจากชุดน้ำเงินรอยัลของแบรนด์ก่อนหน้า มาเป็นส้มเพลิงคู่ทองหลอม —
// ส้ม #e95b0b / #ff9d4d / #93300a / #6b2205 คู่ทอง #f4940c / #ffcf6b บนผิว
// #2a0a02 / #210702 / #150401 เนื้อความ #fbe3d0 ตัวอักษรสว่าง #fff4e8 (ค่า hex ของ
// แบรนด์ก่อนไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็น
// คอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git
// history)
//
// ป้ายคอลัมน์รูปรับครีมสว่างไล่ไปหาส้มเข้ม ส่วนหัวข้อฝั่งเนื้อความรับครีม ->
// ส้มเพลิง -> ทองหลอม สองฝั่งจึงแยกกันออกด้วยสีของแบรนด์เอง และทองยังโผล่ที่ออร่า
// มุมขวาล่างตอน hover
//
// titleleft เป็น <p> ป้ายคอลัมน์ ไม่ใช่หัวข้อ docx ส่วนหัวข้อจริงออกมาที่ระดับที่
// prop `as` สั่ง ผ่าน rightHeading — ไม่มี <h3> ฝังตายในไฟล์นี้ (docx รอบนี้แบน
// H1 + H2 ล้วน)
//
// ส่งหัวข้อเดียวเสมอ — title หรือ titleright — ไม่งั้นหน้าจะได้หัวข้อเกินมาหนึ่งตัว
// ที่ไม่มีหัวข้อ docx รองรับ
//
// คอลัมน์ซ้าย 3fr คือช่องรูป คอลัมน์ขวา 7fr คือเนื้อความ — ส่งรูปหนึ่งใบเข้า
// slot="left" และย่อหน้าเดียวเข้า slot="right" รอบนี้บล็อกนี้เป็น SevenThree ใบที่สอง
// ในสองใบของเพดาน playbook คู่กับ slide4 (แผ่นป้ายทองเปิดกล่องสุ่มลุ้นเครดิตฟรี
// สูงสุด 1,000) และหัวข้อ docx ข้อ 7 เรื่องฝากถอนออโต้ทันใจ
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#93300a]/35 bg-gradient-to-br from-[#2a0a02]/92 to-[#150401]/88 p-8 text-[#fbe3d0] shadow-[0_10px_30px_rgba(233,91,11,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#e95b0b]/65 hover:shadow-[0_15px_40px_rgba(244,148,12,0.26)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#6b2205]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#e95b0b]/40"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#210702]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#f4940c]/25"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe3d0]">
        {
          titleleft && (
            <p class="bg-gradient-to-r from-[#fff4e8] via-[#ff9d4d] to-[#93300a] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe3d0] md:border-l md:border-[#93300a]/50 md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#fff4e8] via-[#e95b0b] to-[#f4940c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
