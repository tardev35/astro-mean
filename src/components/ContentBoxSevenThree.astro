---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// JAICHUA: ย้ายจากชุดสีของแบรนด์ก่อนหน้า มาเป็นทองคำคู่น้ำเงินรอยัล — ทอง #fbeec9 /
// #f6d67e / #d8a83f / #a97722 / #6d4a12 คู่น้ำเงิน #cfe0fb / #5b8ede / #2f5fb0 /
// #16336b บนผิว #0e1a33 / #0a1226 / #040915 เนื้อความ #dce6f8 ตัวอักษรสว่าง #fdf8ec
// (ค่า hex ของแบรนด์ก่อนไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิม
// ได้จาก git history)
//
// ป้ายคอลัมน์รูปรับครีมอุ่นสว่างไล่ไปหาน้ำเงินรอยัล ส่วนหัวข้อฝั่งเนื้อความรับครีม
// -> ทองหลัก -> ทองสว่าง สองฝั่งจึงแยกกันออกด้วยสีของแบรนด์เอง และน้ำเงินยังโผล่ที่
// ออร่ามุมขวาล่างตอน hover
//
// titleleft เป็น <p> ป้ายคอลัมน์ ไม่ใช่หัวข้อ docx ส่วนหัวข้อจริงออกมาที่ระดับที่
// prop `as` สั่ง ผ่าน rightHeading — ไม่มีหัวข้อระดับสามฝังตายในไฟล์นี้ (docx รอบนี้
// แบน H1 + H2 ล้วน)
//
// ส่งหัวข้อเดียวเสมอ — title หรือ titleright — ไม่งั้นหน้าจะได้หัวข้อเกินมาหนึ่งตัว
// ที่ไม่มีหัวข้อ docx รองรับ
//
// คอลัมน์ซ้าย 3fr คือช่องรูป คอลัมน์ขวา 7fr คือเนื้อความ — ส่งรูปหนึ่งใบเข้า
// slot="left" และย่อหน้าเดียวเข้า slot="right" รอบนี้บล็อกนี้เป็น SevenThree ใบแรก
// ในสองใบของเพดาน playbook คู่กับ slide1 (แบนเนอร์ รับยอดเสีย 5% ทุกวัน) และหัวข้อ
// docx ข้อ 6 เรื่องโปรมีของที่มีสิทธิ์คืนยอดเสีย Cash Back ทุกวัน
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#a97722]/35 bg-gradient-to-br from-[#0e1a33]/92 to-[#040915]/88 p-8 text-[#dce6f8] shadow-[0_10px_30px_rgba(216,168,63,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#d8a83f]/65 hover:shadow-[0_15px_40px_rgba(47,95,176,0.26)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#6d4a12]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#d8a83f]/40"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#0a1226]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#2f5fb0]/25"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dce6f8]">
        {
          titleleft && (
            <p class="bg-gradient-to-r from-[#fdf8ec] via-[#f6d67e] to-[#2f5fb0] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dce6f8] md:border-l md:border-[#a97722]/50 md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#fdf8ec] via-[#d8a83f] to-[#f6d67e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
