---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// สองคอลัมน์ถูก flatten แล้ว: คลาสข้อความอยู่บน <article> และ slot เป็นลูกโดยตรง
// ผู้เรียกจึงต้องส่ง "หนึ่ง element ต่อหนึ่ง slot" เท่านั้น
//
// เดิม titleleft/titleright ถูก render เป็น <h2> คนละตัว หนึ่ง section ของ docx
// จึงกลายเป็นสองหัวข้อ ทั้งคู่เป็นป้ายคอลัมน์ ไม่ใช่ section จึงเป็น <p> แล้ว และ
// เพิ่ม prop `title` ตัวเดียวไว้รับหัวข้อ docx — แบบเดียวกับ ContentBoxTwo /
// ContentBox3Three หัวข้อจะไปอยู่เหนือคอลัมน์เนื้อความ (ฝั่ง 7 ส่วน)
//
// LONGSAP168: การ์ดใบนี้เคยเป็นแผงสว่างของแบรนด์เก่า รอบนี้เป็นผิวมืด #170806
// ขอบทอง #f2b024 เนื้อความ #f6e4c8 ข้อความรอง #e3c9ab
const sectionLabel = title ? undefined : (label ?? titleright ?? titleleft ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f2b024]/25 bg-[#170806]/88 p-8 text-[#f6e4c8] shadow-[0_10px_30px_rgba(242,176,36,0.15)] backdrop-blur-xl transition-all duration-500 hover:border-[#f2b024]/50 md:p-10">
    <div class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#7d0508]/50 blur-[60px]"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#f2b024]/25 pb-6 text-left text-base leading-relaxed text-[#e3c9ab] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {titleleft && <p class="bg-gradient-to-r from-[#ffd76a] via-[#f2b024] to-[#d81f26] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f6e4c8] md:pl-6">
        {title && <HeadingTag class="bg-gradient-to-r from-[#ffd76a] via-[#f2b024] to-[#d81f26] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>}
        {
          titleright && (
            <p class="flex items-center gap-2 text-xl leading-normal font-black text-[#f2b024]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#d81f26] shadow-[0_0_5px_rgba(216,31,38,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
