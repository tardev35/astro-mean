---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// VIPSAND356: ย้ายจากชุดสีของแบรนด์ก่อนหน้า มาเป็นฟ้าอะซูร์คู่ทองส้ม — ฟ้า #eaf6ff /
// #a2d2ef / #5dbcfe / #2a93e0 / #1465a8 / #0b3f70 คู่ทอง #fcde61 / #eba554 / #c07c20 /
// #8d520c บนผิว #103a5f / #0a2b4a / #061c33 เนื้อความ #e6f2ff
// (ค่า hex ของแบรนด์ก่อนไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิม
// ได้จาก git history)
//
// ป้ายคอลัมน์รูปรับฟ้าสว่างไล่ไปหาทองส้ม ส่วนหัวข้อฝั่งเนื้อความรับฟ้าขาวไล่ไปหา
// ฟ้าอะซูร์ สองฝั่งจึงแยกกันออกด้วยคู่สีจริงของแบรนด์ และทองยังโผล่ที่ออร่ามุมซ้ายบน
// ตอน hover
//
// titleleft เป็น <p> ป้ายคอลัมน์ ไม่ใช่หัวข้อ docx ส่วนหัวข้อจริงออกมาที่ระดับที่
// prop `as` สั่ง ผ่าน rightHeading — ไม่มีหัวข้อระดับสามฝังตายในไฟล์นี้ (docx รอบนี้
// แบน H1 + H2 ล้วน)
//
// ส่งหัวข้อเดียวเสมอ — title หรือ titleright — ไม่งั้นหน้าจะได้หัวข้อเกินมาหนึ่งตัว
// ที่ไม่มีหัวข้อ docx รองรับ
//
// คอลัมน์ซ้าย 3fr คือช่องรูป คอลัมน์ขวา 7fr คือเนื้อความ — ส่งรูปหนึ่งใบเข้า
// slot="left" และย่อหน้าเดียวเข้า slot="right" รอบนี้บล็อกนี้เป็น SevenThree ใบแรก
// ในสองใบของเพดาน playbook คู่กับ slide2 (แบนเนอร์ ชนะ 11 ไม้ รับ iPhone 17 Pro Max)
// และหัวข้อ docx ข้อ 4 เรื่องเกมดังพร้อมฟีเจอร์ใหม่ทุกรอบ
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#1465a8]/45 bg-gradient-to-br from-[#103a5f]/92 to-[#061c33]/88 p-8 text-[#e6f2ff] shadow-[0_10px_30px_rgba(42,147,224,0.26)] backdrop-blur-xl transition-all duration-500 hover:border-[#eba554]/65 hover:shadow-[0_15px_40px_rgba(93,188,254,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#0b3f70]/75 blur-[60px] transition-all duration-500 group-hover:bg-[#eba554]/35"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#0a2b4a]/75 blur-[60px] transition-all duration-500 group-hover:bg-[#2a93e0]/30"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6f2ff]">
        {
          titleleft && (
            <p class="bg-gradient-to-r from-[#eaf6ff] via-[#5dbcfe] to-[#eba554] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6f2ff] md:border-l md:border-[#1465a8]/55 md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#eaf6ff] via-[#a2d2ef] to-[#5dbcfe] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
