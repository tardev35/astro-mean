---
export interface Props {
  titleleft?: string;
  titleright?: string;
}
const { titleleft, titleright } = Astro.props;

// Both columns are flattened: the text classes live on the <article> and the
// slot is a direct child, so a consumer passes exactly ONE element per slot.
//
// This file used to be a white "premium light" card left over from an older
// brand. BUFFXBET is a dark navy surface, so the card is now the same
// translucent #0a1330 panel the rest of the page uses — a light card in the
// middle of the page was the tell that this variant had not been rethemed.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#3b8df1]/25 bg-[#0a1330]/88 p-8 text-[#dbe7fb] shadow-[0_10px_30px_rgba(59,141,241,0.15)] backdrop-blur-xl transition-all duration-500 hover:border-[#3b8df1]/50 md:p-10">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#3b8df1]/25 pb-6 text-left text-base leading-relaxed text-[#a8bcd8] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <h2 class="bg-gradient-to-r from-[#7cc0ff] via-[#3b8df1] to-[#f5c542] bg-clip-text text-3xl leading-normal font-black tracking-wide text-transparent">{titleleft}</h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#dbe7fb] md:pl-6">
        {
          titleright && (
            <h2 class="flex items-center gap-2 bg-gradient-to-r from-[#7cc0ff] via-[#3b8df1] to-[#f5c542] bg-clip-text text-2xl leading-normal font-black text-transparent">{titleright}</h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
