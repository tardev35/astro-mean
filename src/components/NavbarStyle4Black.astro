---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// BLACKJACK789: ย้ายจากทองราชสำนักสว่างของแบรนด์ก่อนที่เคยใช้ไฟล์นี้ มาเป็นทอง
// แอนทีคเข้มคู่กราไฟต์บนดำสนิทของแบรนด์นี้ — ทอง #fdf1ce / #f2cf70 / #d3aa4b /
// #b8862c / #5c4113 คู่กราไฟต์ #cfd6e0 / #8e97a6 / #454d5c บนผิว #050403 /
// #100b05 / #1e150a / #2c2011 เนื้อความ #ede0c4 รองด้วย #c0ab84
//
// ทองมาจากตัวโพดำในโลโก้กับกองชิป-ไพ่ทองบนแบนเนอร์ ส่วนกราไฟต์คือตัวอักษร
// Black Jack ที่เป็นโลหะเทาขอบทอง — เป็นโลหะตัวที่สองจริง ไม่ใช่เงาของทอง
// ทองรอบนี้อมเหลืองน้ำผึ้ง (โทนแอนทีค) ไม่ใช่ทองส้มสว่างแบบแบรนด์ก่อน
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// เมนูชุดเดียวใช้ .map ทั้งฝั่งเดสก์ท็อปและลิ้นชักมือถือ — เดิมไฟล์นี้เขียน <a> ซ้ำ
// สองชุดคนละที่ ทำให้เพิ่ม/ลบเมนูต้องไล่แก้สองรอบและหลุดง่าย
//
// BLACKJACK789 เป็นเว็บสล็อต/คาสิโน หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ (อยู่ใน
// src/pages-disabled/) ห้ามมีลิงก์ถึง ส่วน /register กับ /login รอบนี้ยังเป็นหน้า
// ส่งต่อแบบ noindex (ไม่ได้เปิด toggle หน้าปุ่ม) จึงไม่มีเมนูสองตัวนั้นให้จัดลำดับ
// ตามกฎ "สมัครสมาชิก/เข้าสู่ระบบ ต่อจากโปรโมชั่น" และ /ทางเข้า ยังอยู่ในเมนูตามเดิม
//
// ไอคอนเลือกให้ตรงกับอาร์ตของแบรนด์ — ♠️ คือโพดำทองที่เป็นตัวโลโก้ ใช้แทนหน้า
// เกี่ยวกับเรา 🃏 คือไพ่ที่นางแบบถือบนแบนเนอร์ ใช้แทนหน้าทดลองเล่น 🎁 แทน
// โปรโมชั่น และ 🚪 แทนลิงก์ตรงทางเข้าเว็บหลัก
//
// ห้ามเขียน isActive เองในไฟล์นี้ — Astro.url.pathname ถูก percent-encode ทำให้
// /ทดลองเล่น กับ /ทางเข้า ไม่เคยไฮไลต์เลย ตัวที่รู้กติกานั้นคือ isActivePath ใน lib/nav
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🃏" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🚪" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "♠️" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];

const LOGO_ALT =
  "โลโก้ BLACKJACK789 เป็นรูปโพดำทองคำขอบเงาวาว มีคำว่า Black Jack เขียนทับด้วยตัวอักษรโลหะสีเทากราไฟต์ขอบทองแบบมีหางโค้ง ใต้ลงมาเป็นเลข 789 สีเดียวกัน และมีประกายทองสี่แฉกอยู่สองข้าง";
---

<nav class="sticky top-0 z-50 w-full border-b border-[#d3aa4b]/40 bg-[#050403] font-sans shadow-[0_0_20px_rgba(211,170,75,0.18)]">
  <div class="flex h-[75px] w-full items-center justify-between px-4 xl:px-8">
    <div class="z-50 flex items-center">
      <a href="/" class="group relative flex items-center">
        <div aria-hidden="true" class="absolute inset-0 scale-0 rounded-full bg-[#d3aa4b]/20 blur-xl transition-transform duration-500 group-hover:scale-150"></div>
        {
          mainLogo ? (
            <Picture
              src={mainLogo}
              alt={LOGO_ALT}
              loading="eager"
              fetchpriority="high"
              widths={[94, 188, 282]}
              sizes="94px"
              height={45}
              class="relative h-[40px] w-auto drop-shadow-[0_0_10px_rgba(242,207,112,0.35)] transition-transform group-hover:scale-105 xl:h-[45px]"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
            />
          ) : (
            <p class="relative bg-gradient-to-b from-[#fdf1ce] via-[#d3aa4b] to-[#5c4113] bg-clip-text text-2xl font-black tracking-wider text-transparent uppercase">BLACKJACK789</p>
          )
        }
      </a>
    </div>

    <div class="z-10 hidden items-center gap-2 lg:gap-4 xl:flex">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative px-5 py-2.5 skew-x-[-15deg] overflow-hidden border transition-all duration-300 ${isActive(item.path) ? "bg-[#d3aa4b]/15 border-[#d3aa4b] shadow-[0_0_15px_rgba(211,170,75,0.4)]" : "bg-white/5 border-[#5c4113]/40 hover:border-[#d3aa4b]/70"}`}>
            <span
              aria-hidden="true"
              class={`absolute inset-0 block bg-gradient-to-r from-[#b8862c] to-[#d3aa4b] translate-y-full transition-transform duration-300 ${isActive(item.path) ? "translate-y-0 opacity-20" : "group-hover:translate-y-0 opacity-30"}`}
            />
            <span class={`block skew-x-[15deg] relative z-10 font-bold tracking-wide transition-colors ${isActive(item.path) ? "text-[#f2cf70]" : "text-[#c0ab84] group-hover:text-[#fdf1ce]"}`}>
              <span aria-hidden="true" class="mr-1">
                {item.icon}
              </span>
              {item.name}
            </span>
          </a>
        ))
      }
    </div>

    <div class="z-50 flex items-center gap-2">
      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center space-y-1.5 rounded-md border border-[#d3aa4b]/40 bg-[#1e150a] p-2 transition-all hover:bg-[#2c2011] xl:hidden"
        aria-label="เปิด-ปิดเมนู">
        <span class="hamburger-line h-[2px] w-6 origin-center bg-[#d3aa4b] transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 bg-[#d3aa4b] transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 origin-center bg-[#d3aa4b] transition-all duration-300"></span>
      </button>
    </div>
  </div>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-30 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 xl:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-40 h-screen w-[280px] translate-x-full transform overflow-y-auto border-l border-[#d3aa4b]/40 bg-[#050403] shadow-[-10px_0_30px_rgba(0,0,0,0.8)] transition-transform duration-300 ease-out xl:hidden">
    <div class="flex flex-col space-y-3 px-6 pt-24 pb-10">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`sidebar-item flex items-center px-4 py-3.5 rounded-lg border transition-all ${isActive(item.path) ? "bg-[#d3aa4b]/15 border-[#d3aa4b] text-[#f2cf70] shadow-[inset_4px_0_0_rgba(211,170,75,1)]" : "bg-white/5 border-transparent text-[#c0ab84] hover:bg-[#1e150a] hover:text-[#fdf1ce]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {item.icon}
            </span>
            <span class="text-sm font-bold">{item.name}</span>
          </a>
        ))
      }
    </div>
  </div>
</nav>

<style is:global>
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }

  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      transition: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleMenu = () => {
    hamburgerBtn?.classList.toggle("active");

    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");

    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleMenu);
  overlay?.addEventListener("click", toggleMenu);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleMenu();
      }
    });
  });
</script>
