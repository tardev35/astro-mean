---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright } = Astro.props;

// GGPLUS88: ไฟล์นี้ผ่านมาหลายแบรนด์ (ล่าสุดเป็นแดงส้มคู่ทอง ก่อนหน้านั้นเป็นนีออน
// ม่วงคู่ทอง เขียวมิ้นต์คู่ทอง ทองบูสต์คู่น้ำเงินไฟฟ้า และชมพูกลอสคู่ทอง — ค่า hex
// เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์
// จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
// รอบนี้เป็นม่วงลึกคู่มาเจนต้า ตัดทองเฉพาะจุด — ม่วง #9b2fe0 / #d9a5ff / #5a1290
// คู่มาเจนต้า #d81b7e / #ff6fb5 คู่ทอง #f0c14b / #ffe9a8 บนผิว #0b0212 / #1b0630 /
// #2d0a50 เนื้อความ #ece0f7 ตัวอักษรสว่าง #f6ecff
//
// ป้ายสามคอลัมน์เป็น <p> (คลาสเดิม ไม่ใช่ <h3>) เพราะ docx ของแบรนด์นี้แบน
// H1 + H2 ล้วน หัวข้อ section รับผ่าน `title` + `as` ตัวเดียว รอบนี้บล็อกนี้แบก
// หัวข้อ docx ข้อ 5 (สมัครเล่นสล็อตเว็บตรง ฟรีไม่มีค่าธรรมเนียม อนุมัติไว)
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#9b2fe0]/30 bg-[#0b0212]/88 p-8 text-[#ece0f7] shadow-[0_10px_30px_rgba(155,47,224,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#d9a5ff]/60 hover:shadow-[0_15px_40px_rgba(216,27,126,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#2d0a50]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#d81b7e]/40"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#9b2fe0]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a8] via-[#f0c14b] to-[#d81b7e] shadow-[0_0_10px_rgba(240,193,75,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f6ecff] via-[#d9a5ff] to-[#9b2fe0] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#2d0a50] pb-8 text-left text-base leading-relaxed text-[#ece0f7] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#d9a5ff] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#d81b7e] shadow-[0_0_8px_rgba(216,27,126,0.9)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#2d0a50] pb-8 text-left text-base leading-relaxed text-[#ece0f7] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#d9a5ff] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#d81b7e] shadow-[0_0_8px_rgba(216,27,126,0.9)]" /> {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ece0f7] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#d9a5ff] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#d81b7e] shadow-[0_0_8px_rgba(216,27,126,0.9)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
