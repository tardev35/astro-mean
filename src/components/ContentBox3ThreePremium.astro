---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright } = Astro.props;

// XTOP666: ไฟล์นี้ผ่านมาหลายแบรนด์ (ล่าสุดเป็นนีออนฟ้าคู่บานเย็น ก่อนหน้านั้นเป็น
// ม่วงลึกคู่มาเจนต้า แดงส้มคู่ทอง นีออนม่วงคู่ทอง เขียวมิ้นต์คู่ทอง และชมพูกลอส
// คู่ทอง — ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิม
// ได้จาก git history)
// รอบนี้เป็นส้มไฟคู่ทอง — ส้ม #fc5b02 / #ff8c3a / #ffd9bd / #7a2601 คู่ทอง
// #ffb020 / #ffd76e / #8a5a00 บนผิว #0a0503 / #1c0d05 / #2a1206 เนื้อความ
// #ffe8d8 ตัวอักษรสว่าง #fff3ea
//
// ป้ายสามคอลัมน์เป็น <p> (คลาสเดิม ไม่ใช่ <h3>) เพราะ docx ของแบรนด์นี้แบน
// H1 + H2 ล้วน หัวข้อ section รับผ่าน `title` + `as` ตัวเดียว รอบนี้บล็อกนี้แบก
// หัวข้อ docx ข้อ 4 (เกมค่ายดังไม่ได้มาแค่ให้ครบ คัดหลายแนวให้เลือกตามสไตล์) โดย
// แบ่งย่อหน้าเดียวของ docx ลงสามคอลัมน์ตามลำดับประโยคเดิม ไม่มีการตัดหรือย่อ
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#fc5b02]/30 bg-[#0a0503]/88 p-8 text-[#ffe8d8] shadow-[0_10px_30px_rgba(252,91,2,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff8c3a]/60 hover:shadow-[0_15px_40px_rgba(255,176,32,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#2a1206]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#ffb020]/40"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#fc5b02]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd9bd] via-[#ffd76e] to-[#ffb020] shadow-[0_0_10px_rgba(255,176,32,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff3ea] via-[#ff8c3a] to-[#fc5b02] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#2a1206] pb-8 text-left text-base leading-relaxed text-[#ffe8d8] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ff8c3a] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#ffb020] shadow-[0_0_8px_rgba(255,176,32,0.9)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#2a1206] pb-8 text-left text-base leading-relaxed text-[#ffe8d8] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ff8c3a] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#ffb020] shadow-[0_0_8px_rgba(255,176,32,0.9)]" /> {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ffe8d8] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ff8c3a] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#ffb020] shadow-[0_0_8px_rgba(255,176,32,0.9)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
