---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright } = Astro.props;

// SETH88: ไฟล์นี้ผ่านมาหลายแบรนด์ และมาถึงรอบนี้ในชุดสีของแบรนด์ก่อนหน้า (ค่า hex
// เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์
// จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
// รอบนี้เป็นทองคำอียิปต์คู่บรอนซ์ — ทอง #fdf3d4 / #f7d774 / #e0a92b / #a9711a /
// #6b4210 บนผิว #0c0703 / #1b1109 / #2a1a0d ขอบ #6b4210 เนื้อความ #f0e3cd
//
// จุดคั่นสามคอลัมน์รับบรอนซ์เข้ม #a9711a เพื่อให้แกนสีที่สองมีที่ยืนจริงในการ์ด
// ไม่ใช่ทองสว่างล้วนทั้งใบ ส่วนทองซีดสว่างอยู่ที่สต็อปแรกของไล่เฉดหัวข้อ
//
// ป้ายสามคอลัมน์เป็น <p> (คลาสเดิม ไม่ใช่ <h3>) เพราะ docx ของแบรนด์นี้เป็น H1 + H2
// ล้วน ส่วน H3 สามตัวเดียวที่หน้าแรกมีได้อยู่ที่ FeatureHighlights หัวข้อ section
// รับผ่าน `title` + `as` ตัวเดียว
// รอบนี้บล็อกนี้แบกหัวข้อ docx ข้อ 3 (เกมลิขสิทธิ์แท้จากค่ายยักษ์ใหญ่ระดับโลก) แล้ว
// ต่อด้วย ProviderGrid ซึ่งกางรายชื่อค่ายที่ย่อหน้าเดียวกันระบุไว้ตรงๆ
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#6b4210]/60 bg-[#0c0703]/88 p-8 text-[#f0e3cd] shadow-[0_10px_30px_rgba(224,169,43,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#e0a92b]/60 hover:shadow-[0_15px_40px_rgba(169,113,26,0.35)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#2a1a0d]/85 blur-[60px] transition-all duration-500 group-hover:bg-[#e0a92b]/40"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#6b4210]/60 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf3d4] via-[#e0a92b] to-[#6b4210] shadow-[0_0_10px_rgba(224,169,43,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdf3d4] via-[#f7d774] to-[#a9711a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#6b4210] pb-8 text-left text-base leading-relaxed text-[#f0e3cd] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#f7d774] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#a9711a] shadow-[0_0_8px_rgba(169,113,26,0.9)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#6b4210] pb-8 text-left text-base leading-relaxed text-[#f0e3cd] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#f7d774] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#a9711a] shadow-[0_0_8px_rgba(169,113,26,0.9)]" /> {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f0e3cd] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#f7d774] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#a9711a] shadow-[0_0_8px_rgba(169,113,26,0.9)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
