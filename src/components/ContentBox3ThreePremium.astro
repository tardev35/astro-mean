---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright } = Astro.props;

// DEED888: ไฟล์นี้ผ่านมาหลายแบรนด์ และมาถึงรอบนี้ในชุดน้ำเงินรอยัลของแบรนด์ก่อนหน้า
// (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git
// history)
// รอบนี้เป็นส้มเพลิงคู่ทองหลอม — ส้ม #e95b0b / #ff9d4d / #93300a / #6b2205
// คู่ทอง #f4940c / #ffcf6b บนผิว #150401 / #210702 / #2a0a02 เนื้อความ #fbe3d0
// ตัวอักษรสว่าง #fff4e8
//
// จุดคั่นสามคอลัมน์ใช้ทองหลอม เพื่อให้สีคู่มีที่ยืนจริงในการ์ด ไม่ใช่ส้มล้วนทั้งใบ
// ส่วนครีมสว่างอยู่ที่สต็อปแรกของไล่เฉดหัวข้อ
//
// ป้ายสามคอลัมน์เป็น <p> (คลาสเดิม ไม่ใช่ <h3>) เพราะ docx ของแบรนด์นี้แบน
// H1 + H2 ล้วน ไม่มี H3 เลย หัวข้อ section รับผ่าน `title` + `as` ตัวเดียว
// รอบนี้บล็อกนี้แบกหัวข้อ docx ข้อ 2 (คัดของเด่นจากค่ายดังมาไว้แบบไม่หลุดกระแส)
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#93300a]/35 bg-[#150401]/88 p-8 text-[#fbe3d0] shadow-[0_10px_30px_rgba(233,91,11,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#e95b0b]/60 hover:shadow-[0_15px_40px_rgba(244,148,12,0.24)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#6b2205]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#e95b0b]/40"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#93300a]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffcf6b] via-[#e95b0b] to-[#6b2205] shadow-[0_0_10px_rgba(233,91,11,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff4e8] via-[#e95b0b] to-[#f4940c] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#6b2205] pb-8 text-left text-base leading-relaxed text-[#fbe3d0] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ff9d4d] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#f4940c] shadow-[0_0_8px_rgba(244,148,12,0.85)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#6b2205] pb-8 text-left text-base leading-relaxed text-[#fbe3d0] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ff9d4d] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#f4940c] shadow-[0_0_8px_rgba(244,148,12,0.85)]" /> {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#fbe3d0] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ff9d4d] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#f4940c] shadow-[0_0_8px_rgba(244,148,12,0.85)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
