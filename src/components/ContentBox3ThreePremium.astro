---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright } = Astro.props;

// MACAUBET: remapped off THUNDER87's electric yellow (#fff89a / #fae61c /
// #dcb309 / #ffd60a / #8a7405 over #17150a / #080703, body #f0ead6) onto this
// brand's Macau neon green — #dcffc0 / #8ef04a / #59cb13 / #3b9b0d / #0f3a11
// over #0a2c0d / #020b01, body text #e9f9dc, with gold #f6c445 on the column
// bullets as the brief's second colour
//
// ป้ายสามคอลัมน์เป็น <p> (คลาสเดิม ไม่ใช่ <h3>) เพราะ docx ของแบรนด์นี้แบน
// H1 + H2 ล้วน หัวข้อ section รับผ่าน `title` + `as` ตัวเดียว
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#59cb13]/30 bg-[#0a2c0d]/88 p-8 text-[#e9f9dc] shadow-[0_10px_30px_rgba(89,203,19,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#dcffc0]/60 hover:shadow-[0_15px_40px_rgba(59,155,13,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#0f3a11]/60 blur-[60px] transition-all duration-500 group-hover:bg-[#3b9b0d]/45"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#59cb13]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#dcffc0] via-[#8ef04a] to-[#0f3a11] shadow-[0_0_10px_rgba(89,203,19,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#dcffc0] via-[#8ef04a] to-[#3b9b0d] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#2c7a08] pb-8 text-left text-base leading-relaxed text-[#e9f9dc] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#8ef04a] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#f6c445] shadow-[0_0_8px_rgba(246,196,69,0.9)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#2c7a08] pb-8 text-left text-base leading-relaxed text-[#e9f9dc] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#8ef04a] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#f6c445] shadow-[0_0_8px_rgba(246,196,69,0.9)]" /> {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e9f9dc] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#8ef04a] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#f6c445] shadow-[0_0_8px_rgba(246,196,69,0.9)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
