---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright } = Astro.props;

// MONEY777: ไฟล์นี้ผ่านมาหลายแบรนด์ (ล่าสุดเป็นนีออนม่วงคู่ทองของ PABO88 ก่อนหน้า
// นั้นเป็นเขียวมิ้นต์คู่ทอง ทองบูสต์คู่น้ำเงินไฟฟ้า และชมพูกลอสคู่ทอง — ค่า hex เดิม
// ไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์
// จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
// รอบนี้เป็นแดงส้มคู่ทอง — แดง #e0330a / #ff6a2b / #8b1406 คู่ทอง #f6c945 /
// #ffe08a / #a3760a บนผิว #0b0101 / #3c0c03 เนื้อความ #ffe6d8 ตัวอักษรสว่าง
// #fff4ec ไม่มีม่วงเหลืออยู่ในไฟล์นี้
//
// ป้ายสามคอลัมน์เป็น <p> (คลาสเดิม ไม่ใช่ <h3>) เพราะ docx ของแบรนด์นี้แบน
// H1 + H2 ล้วน หัวข้อ section รับผ่าน `title` + `as` ตัวเดียว รอบนี้บล็อกนี้แบก
// หัวข้อ docx ข้อ 3 (เปิดลิสต์เกมดีรีวิวแน่น) แล้วต่อด้วย GameRankingBoard
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f6c945]/30 bg-[#0b0101]/88 p-8 text-[#ffe6d8] shadow-[0_10px_30px_rgba(246,201,69,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffe08a]/60 hover:shadow-[0_15px_40px_rgba(224,51,10,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#3c0c03]/60 blur-[60px] transition-all duration-500 group-hover:bg-[#e0330a]/45"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f6c945]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe08a] via-[#f6c945] to-[#e0330a] shadow-[0_0_10px_rgba(246,201,69,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff4ec] via-[#f6c945] to-[#e0330a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#3c0c03] pb-8 text-left text-base leading-relaxed text-[#ffe6d8] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#f6c945] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#e0330a] shadow-[0_0_8px_rgba(224,51,10,0.9)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#3c0c03] pb-8 text-left text-base leading-relaxed text-[#ffe6d8] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#f6c945] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#e0330a] shadow-[0_0_8px_rgba(224,51,10,0.9)]" /> {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ffe6d8] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#f6c945] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#e0330a] shadow-[0_0_8px_rgba(224,51,10,0.9)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
