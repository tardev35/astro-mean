---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright } = Astro.props;

// THUNDER87: remapped off 249UP's single-hue gold (#ffe9a8 / #ffd86b / #f5b626 /
// #c98a12 / #8a5c08 over #150e05 / #1e1409, body #f0e4cd) onto this brand's
// electric-yellow lightning on near-black — #fff89a / #fae61c / #dcb309 /
// #ffd60a / #8a7405 over #17150a / #080703, body text #f0ead6
//
// ป้ายสามคอลัมน์เป็น <p> (คลาสเดิม ไม่ใช่ <h3>) เพราะ docx ของแบรนด์นี้แบน
// H1 + H2 ล้วน หัวข้อ section รับผ่าน `title` + `as` ตัวเดียว
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#fae61c]/30 bg-[#17150a]/88 p-8 text-[#f0ead6] shadow-[0_10px_30px_rgba(250,230,28,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#fff89a]/60 hover:shadow-[0_15px_40px_rgba(220,179,9,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#8a7405]/50 blur-[60px] transition-all duration-500 group-hover:bg-[#dcb309]/45"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#fae61c]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff89a] via-[#fae61c] to-[#8a7405] shadow-[0_0_10px_rgba(250,230,28,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff89a] via-[#fae61c] to-[#dcb309] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#8a7405] pb-8 text-left text-base leading-relaxed text-[#f0ead6] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#fae61c] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#fae61c] shadow-[0_0_8px_rgba(250,230,28,0.9)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#8a7405] pb-8 text-left text-base leading-relaxed text-[#f0ead6] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#fae61c] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#fae61c] shadow-[0_0_8px_rgba(250,230,28,0.9)]" /> {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f0ead6] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#fae61c] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#fae61c] shadow-[0_0_8px_rgba(250,230,28,0.9)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
