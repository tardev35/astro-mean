---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright } = Astro.props;

// ASHTON168: ไฟล์นี้ผ่านมาหลายแบรนด์ (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind
// สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้
// ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
// รอบนี้เป็นทองสว่างคู่เงินโครเมียม — ทอง #f5c518 / #ffd75e / #ffe9a3 / #c8941a /
// #a87908 คู่เงิน #e2e5e9 / #f0f2f5 บนผิว #080502 / #160e03 / #2a1c06 เนื้อความ
// #f0e6d2 ตัวอักษรสว่าง #fdf6e6
//
// ป้ายสามคอลัมน์เป็น <p> (คลาสเดิม ไม่ใช่ <h3>) เพราะ docx ของแบรนด์นี้แบน
// H1 + H2 ล้วน หัวข้อ section รับผ่าน `title` + `as` ตัวเดียว รอบนี้บล็อกนี้แบก
// หัวข้อ docx ข้อ 4 (จัดหมวดเกมให้เลือกง่าย เจอตัวที่ใช่ไวโดยไม่ต้องค้นหลายรอบ) โดย
// แบ่งย่อหน้าเดียวของ docx ลงสามคอลัมน์ตามลำดับประโยคเดิม ไม่มีการตัดหรือย่อ
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f5c518]/30 bg-[#080502]/88 p-8 text-[#f0e6d2] shadow-[0_10px_30px_rgba(245,197,24,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffd75e]/60 hover:shadow-[0_15px_40px_rgba(226,229,233,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#2a1c06]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#e2e5e9]/40"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f5c518]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a3] via-[#f0f2f5] to-[#e2e5e9] shadow-[0_0_10px_rgba(226,229,233,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdf6e6] via-[#ffd75e] to-[#c8941a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#2a1c06] pb-8 text-left text-base leading-relaxed text-[#f0e6d2] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffd75e] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#e2e5e9] shadow-[0_0_8px_rgba(226,229,233,0.9)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#2a1c06] pb-8 text-left text-base leading-relaxed text-[#f0e6d2] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffd75e] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#e2e5e9] shadow-[0_0_8px_rgba(226,229,233,0.9)]" /> {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f0e6d2] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffd75e] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#e2e5e9] shadow-[0_0_8px_rgba(226,229,233,0.9)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
