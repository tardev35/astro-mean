---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright } = Astro.props;

// HAPPYSUPERWIN: ไฟล์นี้ผ่านมาหลายแบรนด์ และมาถึงรอบนี้ในชุดส้มเพลิงของแบรนด์ก่อน
// หน้า (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git
// history)
// รอบนี้เป็นแคนดี้มาเจนต้าคู่เหลืองลูกอม — มาเจนต้า #ff5ae6 / #e11ccc / #8a1f9e /
// #4c0d6b คู่เหลือง #ffd83d / #f0b429 บนผิว #0e0119 / #190430 / #280747
// เนื้อความ #f7e2ff ตัวอักษรสว่าง #fff0fc
//
// จุดคั่นสามคอลัมน์ใช้เหลืองลูกอม เพื่อให้สีคู่มีที่ยืนจริงในการ์ด ไม่ใช่มาเจนต้าล้วน
// ทั้งใบ ส่วนชมพูขาวสว่างอยู่ที่สต็อปแรกของไล่เฉดหัวข้อ
//
// ป้ายสามคอลัมน์เป็น <p> (คลาสเดิม ไม่ใช่ <h3>) เพราะ docx ของแบรนด์นี้เป็น H1 + H2
// ล้วน ส่วน H3 สามตัวเดียวที่หน้าแรกมีได้อยู่ที่ FeatureHighlights หัวข้อ section
// รับผ่าน `title` + `as` ตัวเดียว
// รอบนี้บล็อกนี้แบกหัวข้อ docx ข้อ 3 (เกมดังค่ายชั้นนำมีอะไรน่าตาม)
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8a1f9e]/35 bg-[#0e0119]/88 p-8 text-[#f7e2ff] shadow-[0_10px_30px_rgba(225,28,204,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#e11ccc]/60 hover:shadow-[0_15px_40px_rgba(240,180,41,0.24)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#4c0d6b]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#e11ccc]/40"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#8a1f9e]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd83d] via-[#ff5ae6] to-[#4c0d6b] shadow-[0_0_10px_rgba(225,28,204,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff0fc] via-[#ff5ae6] to-[#ffd83d] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#4c0d6b] pb-8 text-left text-base leading-relaxed text-[#f7e2ff] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ff5ae6] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#f0b429] shadow-[0_0_8px_rgba(240,180,41,0.85)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#4c0d6b] pb-8 text-left text-base leading-relaxed text-[#f7e2ff] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ff5ae6] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#f0b429] shadow-[0_0_8px_rgba(240,180,41,0.85)]" /> {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f7e2ff] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ff5ae6] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#f0b429] shadow-[0_0_8px_rgba(240,180,41,0.85)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
