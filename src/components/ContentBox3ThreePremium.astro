---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright } = Astro.props;

// BOOST168: ไฟล์นี้ผ่านมาหลายแบรนด์ (ล่าสุดเป็นชมพูกลอสคู่ทอง ก่อนหน้านั้นเป็น
// เขียวมังกรนีออน — ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind
// สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้
// ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history) รอบนี้เป็นทองบูสต์คู่น้ำเงินไฟฟ้า
// บนพื้นดำน้ำเงิน — ทอง #fff6dd / #ffe680 / #ffc233 คู่น้ำเงิน #3f8cff / #12306e
// บนผิว #0e1430 / #18204a เนื้อความ #e6ecfb ไม่มีชมพู/เขียวเหลืออยู่ในไฟล์นี้
//
// ป้ายสามคอลัมน์เป็น <p> (คลาสเดิม ไม่ใช่ <h3>) เพราะ docx ของแบรนด์นี้แบน
// H1 + H2 ล้วน หัวข้อ section รับผ่าน `title` + `as` ตัวเดียว
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#ffc233]/30 bg-[#0e1430]/88 p-8 text-[#e6ecfb] shadow-[0_10px_30px_rgba(255,194,51,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffe680]/60 hover:shadow-[0_15px_40px_rgba(63,140,255,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#12306e]/60 blur-[60px] transition-all duration-500 group-hover:bg-[#3f8cff]/45"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#ffc233]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe680] via-[#ffc233] to-[#3f8cff] shadow-[0_0_10px_rgba(255,194,51,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff6dd] via-[#ffc233] to-[#3f8cff] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#18204a] pb-8 text-left text-base leading-relaxed text-[#e6ecfb] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffc233] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#3f8cff] shadow-[0_0_8px_rgba(63,140,255,0.9)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#18204a] pb-8 text-left text-base leading-relaxed text-[#e6ecfb] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffc233] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#3f8cff] shadow-[0_0_8px_rgba(63,140,255,0.9)]" /> {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#e6ecfb] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffc233] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#3f8cff] shadow-[0_0_8px_rgba(63,140,255,0.9)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
