---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright } = Astro.props;

// ROSTY59: ไฟล์นี้ผ่านมาหลายแบรนด์ และมาถึงรอบนี้ในชุดแคนดี้มาเจนต้าคู่เหลืองลูกอม
// ของแบรนด์ก่อนหน้า (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของ
// เดิมได้จาก git history)
// รอบนี้เป็นทองอำพันคู่โครเมียมเงิน — ทอง #ffeec2 / #ffc94a / #f2a01a / #b06a0d /
// #6b3f07 คู่เงิน #dbe1e8 / #a3adba บนผิว #070505 / #150e07 / #26180a ขอบ #4a2f0d
// เนื้อความ #ece0cc
//
// จุดคั่นสามคอลัมน์ใช้เงินโครเมียม เพื่อให้สีที่สองมีที่ยืนจริงในการ์ด ไม่ใช่ทองล้วน
// ทั้งใบ ส่วนทองซีดสว่างอยู่ที่สต็อปแรกของไล่เฉดหัวข้อ
//
// ป้ายสามคอลัมน์เป็น <p> (คลาสเดิม ไม่ใช่ <h3>) เพราะ docx ของแบรนด์นี้เป็น H1 + H2
// ล้วน ส่วน H3 สี่ตัวเดียวที่หน้าแรกมีได้อยู่ที่ FeatureHighlights หัวข้อ section
// รับผ่าน `title` + `as` ตัวเดียว
// รอบนี้บล็อกนี้แบกหัวข้อ docx ข้อ 4 (หลายหมวดให้เลือก เปลี่ยนสไตล์การเล่นได้)
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#4a2f0d]/60 bg-[#070505]/88 p-8 text-[#ece0cc] shadow-[0_10px_30px_rgba(242,160,26,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#f2a01a]/60 hover:shadow-[0_15px_40px_rgba(219,225,232,0.2)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#26180a]/85 blur-[60px] transition-all duration-500 group-hover:bg-[#f2a01a]/40"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#4a2f0d]/60 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#dbe1e8] via-[#f2a01a] to-[#6b3f07] shadow-[0_0_10px_rgba(242,160,26,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffeec2] via-[#ffc94a] to-[#dbe1e8] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#4a2f0d] pb-8 text-left text-base leading-relaxed text-[#ece0cc] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffc94a] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#dbe1e8] shadow-[0_0_8px_rgba(219,225,232,0.85)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#4a2f0d] pb-8 text-left text-base leading-relaxed text-[#ece0cc] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffc94a] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#dbe1e8] shadow-[0_0_8px_rgba(219,225,232,0.85)]" /> {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ece0cc] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffc94a] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#dbe1e8] shadow-[0_0_8px_rgba(219,225,232,0.85)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
