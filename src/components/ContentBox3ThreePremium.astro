---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright } = Astro.props;

// 9KPLUS: ไฟล์นี้ผ่านมาหลายแบรนด์ และมาถึงรอบนี้ในชุดสีของแบรนด์ก่อนหน้า (ค่า hex
// เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์
// จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
// รอบนี้เป็นแดงนีออนคู่ชมพูบานเย็น — ชมพูขาว #ffd8e7 / ชมพู #ff4fa3 / แดง #f5003e /
// แดงเข้ม #b3022c / ชมพูเข้ม #7c1040 บนผิว #120309 / #1f0611 / #4d012c
// ขอบ #7c1040 เนื้อความ #ffe3ee
//
// จุดคั่นสามคอลัมน์รับแดงเข้ม #b3022c เพื่อให้แกนสีที่สองมีที่ยืนจริงในการ์ด ไม่ใช่
// ชมพูสว่างล้วนทั้งใบ ส่วนชมพูขาวอยู่ที่สต็อปแรกของไล่เฉดหัวข้อ
//
// ป้ายสามคอลัมน์เป็น <p> (คลาสเดิม ไม่ใช่ <h3>) เพราะ docx ของแบรนด์นี้เป็น H1 + H2
// ล้วน ส่วน H3 สี่ตัวเดียวที่หน้าแรกมีได้อยู่ที่ FeatureHighlights หัวข้อ section
// รับผ่าน `title` + `as` ตัวเดียว
// รอบนี้บล็อกนี้แบกหัวข้อ docx ข้อ 2 (เปิดเกมหลายฟีลให้สายไหนก็เจอจังหวะที่ใช่) —
// ย่อหน้าเดียวถูกแบ่งลงสามคอลัมน์ตามลำดับประโยคเดิม ไม่มีการย่อหรือรวบประโยค
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#7c1040]/60 bg-[#120309]/88 p-8 text-[#ffe3ee] shadow-[0_10px_30px_rgba(245,0,62,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5003e]/60 hover:shadow-[0_15px_40px_rgba(179,2,44,0.35)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#4d012c]/85 blur-[60px] transition-all duration-500 group-hover:bg-[#f5003e]/40"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#7c1040]/60 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd8e7] via-[#f5003e] to-[#7c1040] shadow-[0_0_10px_rgba(245,0,62,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffd8e7] via-[#ff4fa3] to-[#b3022c] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#7c1040] pb-8 text-left text-base leading-relaxed text-[#ffe3ee] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ff4fa3] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#b3022c] shadow-[0_0_8px_rgba(179,2,44,0.9)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#7c1040] pb-8 text-left text-base leading-relaxed text-[#ffe3ee] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ff4fa3] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#b3022c] shadow-[0_0_8px_rgba(179,2,44,0.9)]" /> {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ffe3ee] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ff4fa3] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#b3022c] shadow-[0_0_8px_rgba(179,2,44,0.9)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
