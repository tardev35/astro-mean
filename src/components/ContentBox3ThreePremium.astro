---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright } = Astro.props;

// CK1968: ไฟล์นี้ผ่านมาหลายแบรนด์ และมาถึงรอบนี้ในชุดทองอำพันคู่โครเมียมเงินของ
// แบรนด์ก่อนหน้า (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของ
// เดิมได้จาก git history)
// รอบนี้เป็นทองคำคู่แดงเลือดหมู — ทอง #ffefc4 / #ffd45c / #f0a80c / #a76806 /
// #5d3a05 คู่แดง #ff4b52 / #d4090f / #8c0206 บนผิว #090302 / #170806 / #2a100a
// ขอบ #4d1f0d เนื้อความ #f6e4c0
//
// จุดคั่นสามคอลัมน์ใช้แดงเลือดหมู เพื่อให้สีที่สองมีที่ยืนจริงในการ์ด ไม่ใช่ทองล้วน
// ทั้งใบ ส่วนทองซีดสว่างอยู่ที่สต็อปแรกของไล่เฉดหัวข้อ
//
// ป้ายสามคอลัมน์เป็น <p> (คลาสเดิม ไม่ใช่ <h3>) เพราะ docx ของแบรนด์นี้เป็น H1 + H2
// ล้วน ส่วน H3 สี่ตัวเดียวที่หน้าแรกมีได้อยู่ที่ FeatureHighlights หัวข้อ section
// รับผ่าน `title` + `as` ตัวเดียว
// รอบนี้บล็อกนี้แบกหัวข้อ docx ข้อ 5 (อิสระทางการเงินพร้อมเงื่อนไขฝากถอนไม่มีขั้นต่ำ)
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#4d1f0d]/60 bg-[#090302]/88 p-8 text-[#f6e4c0] shadow-[0_10px_30px_rgba(240,168,12,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#f0a80c]/60 hover:shadow-[0_15px_40px_rgba(212,9,15,0.25)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#2a100a]/85 blur-[60px] transition-all duration-500 group-hover:bg-[#f0a80c]/40"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#4d1f0d]/60 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#d4090f] via-[#f0a80c] to-[#5d3a05] shadow-[0_0_10px_rgba(240,168,12,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffefc4] via-[#ffd45c] to-[#ff4b52] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#4d1f0d] pb-8 text-left text-base leading-relaxed text-[#f6e4c0] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffd45c] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#ff4b52] shadow-[0_0_8px_rgba(212,9,15,0.9)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#4d1f0d] pb-8 text-left text-base leading-relaxed text-[#f6e4c0] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffd45c] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#ff4b52] shadow-[0_0_8px_rgba(212,9,15,0.9)]" /> {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f6e4c0] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffd45c] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#ff4b52] shadow-[0_0_8px_rgba(212,9,15,0.9)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
