---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// AM88K: ไฟล์นี้ค้างชุดสีของแบรนด์ก่อนหน้ามา (ทองคู่แดงของ DEKDDD — ค่า hex เดิม
// ไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์
// จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
// รอบนี้ย้ายมาเขียวมิ้นต์คู่ทองของแบรนด์นี้ — มิ้นต์ #d6fbe8 / #8cdcad / #4cb783 /
// #1d6f47 คู่ทอง #f3db6b / #e4b314 / #a8790a บนผิว #08200f / #04120a เนื้อความ
// #e6f6ec ไม่มีแดง/ทองแบบเดิมเหลืออยู่ในไฟล์นี้
//
// titleleft เป็น <p> ป้ายคอลัมน์ ไม่ใช่หัวข้อ docx ส่วนหัวข้อจริงรับผ่าน `title`
// + `as` แบบเดียวกับ ContentBox / ContentBoxTwo / ContentBoxSevenThree
//
// ส่งหัวข้อเดียวเสมอ — title หรือ titleright — ไม่งั้นหน้าจะได้ h2 เกินมาหนึ่งตัว
// ที่ไม่มีหัวข้อ docx รองรับ
//
// คอลัมน์ซ้าย 3fr คือช่องรูป คอลัมน์ขวา 7fr คือเนื้อความ — ส่งรูปหนึ่งใบเข้า
// slot="left" และย่อหน้าเดียวเข้า slot="right"
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#e4b314]/30 bg-gradient-to-br from-[#08200f]/92 to-[#04120a]/88 p-8 text-[#e6f6ec] shadow-[0_10px_30px_rgba(228,179,20,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#f3db6b]/65 hover:shadow-[0_15px_40px_rgba(76,183,131,0.38)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#1d6f47]/55 blur-[60px] transition-all duration-500 group-hover:bg-[#e4b314]/35"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#0e3319]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#a8790a]/45"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6f6ec]">
        {
          titleleft && (
            <p class="bg-gradient-to-r from-[#f4fdf8] via-[#e4b314] to-[#4cb783] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6f6ec] md:border-l md:border-[#4cb783]/60 md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#f4fdf8] via-[#e4b314] to-[#4cb783] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
