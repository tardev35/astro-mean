---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// สองคอลัมน์ถูก flatten แล้ว: คลาสข้อความอยู่บน <article> และ slot เป็นลูกโดยตรง
// ผู้เรียกจึงต้องส่ง "หนึ่ง element ต่อหนึ่ง slot" เท่านั้น (ฝั่ง 3 ส่วนรอบนี้รับ
// <Picture> ใบเดียว)
//
// titleleft/titleright เป็นป้ายคอลัมน์จึงเป็น <p> ส่วนหัวข้อ docx รับผ่าน prop
// `title` + `as` ตัวเดียว หัวข้อจะไปอยู่เหนือคอลัมน์เนื้อความ (ฝั่ง 7 ส่วน) ซึ่ง
// กว้างพอรับหัวข้อยาวของ docx ได้โดยไม่ล้นออกนอกการ์ด
//
// DEED888: ย้ายจากน้ำเงินรอยัลของแบรนด์ก่อนมาที่ส้มเพลิงคู่ทองหลอม — ส้ม #e95b0b /
// #ff9d4d / #93300a / #6b2205 คู่ทอง #f4940c / #ffcf6b บนผิว #150401 / #210702 /
// #2a0a02 เนื้อความ #fbe3d0 ข้อความรอง #d9b096 ตัวอักษรสว่าง #fff4e8
// (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็น
// คอมเมนต์ ดูของเดิมได้จาก git history)
//
// รอบนี้บล็อกนี้เป็น SevenThree ใบแรกในสองใบของเพดาน playbook คู่กับ slide1
// (แผ่นป้ายทองโบนัสสมาชิกใหม่ 30% สูงสุด 1,000 บาท) กับหัวข้อ docx ข้อ 4
// เรื่องจัดโปรฮิตมาเป็นชุด
const sectionLabel = title ? undefined : (label ?? titleright ?? titleleft ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#93300a]/35 bg-[#210702]/90 p-8 text-[#fbe3d0] shadow-[0_10px_30px_rgba(107,34,5,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#e95b0b]/55 md:p-10">
    <div class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#2a0a02]/80 blur-[60px]"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#93300a]/30 pb-6 text-left text-base leading-relaxed text-[#d9b096] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {titleleft && <p class="bg-gradient-to-r from-[#fff4e8] via-[#f4940c] to-[#93300a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#fbe3d0] md:pl-6">
        {title && <HeadingTag class="bg-gradient-to-r from-[#fff4e8] via-[#ff9d4d] to-[#e95b0b] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>}
        {
          titleright && (
            <p class="flex items-center gap-2 text-xl leading-normal font-black text-[#ff9d4d]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#e95b0b] shadow-[0_0_5px_rgba(233,91,11,0.85)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
