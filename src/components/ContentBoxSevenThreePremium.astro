---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// สองคอลัมน์ถูก flatten แล้ว: คลาสข้อความอยู่บน <article> และ slot เป็นลูกโดยตรง
// ผู้เรียกจึงต้องส่ง "หนึ่ง element ต่อหนึ่ง slot" เท่านั้น (ฝั่ง 3 ส่วนรอบนี้รับ
// <Picture> ใบเดียว)
//
// titleleft/titleright เป็นป้ายคอลัมน์จึงเป็น <p> ส่วนหัวข้อ docx รับผ่าน prop
// `title` + `as` ตัวเดียว หัวข้อจะไปอยู่เหนือคอลัมน์เนื้อความ (ฝั่ง 7 ส่วน) ซึ่ง
// กว้างพอรับหัวข้อยาวของ docx ได้โดยไม่ล้นออกนอกการ์ด
//
// ROSTY59: ย้ายจากแคนดี้มาเจนต้าคู่เหลืองลูกอมของแบรนด์ก่อนมาที่ทองอำพันคู่โครเมียม
// เงิน — ทอง #ffeec2 / #ffc94a / #f2a01a / #b06a0d / #6b3f07 คู่เงิน #dbe1e8 /
// #a3adba บนผิว #070505 / #150e07 / #26180a ขอบ #4a2f0d เนื้อความ #ece0cc
// ข้อความรอง #bda98c — ป้ายคอลัมน์รูปรับเงินโครเมียมเพื่อให้สีที่สองมีที่ยืนจริง
// (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็น
// คอมเมนต์ ดูของเดิมได้จาก git history)
//
// รอบนี้บล็อกนี้เป็น SevenThree ใบแรกในสองใบของเพดาน playbook คู่กับ slide1
// (อาร์ต "เว็บตรง ลิขสิทธิ์แท้ / ฝาก-ถอน AUTO 3 นาที / ระบบเกมดีสุดใน ASIA")
// กับหัวข้อ docx ข้อ 3 เรื่องเกมแท้ลิขสิทธิ์จากค่ายดังที่ค้นหาได้ง่าย
const sectionLabel = title ? undefined : (label ?? titleright ?? titleleft ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#4a2f0d]/65 bg-[#150e07]/90 p-8 text-[#ece0cc] shadow-[0_10px_30px_rgba(107,63,7,0.35)] backdrop-blur-xl transition-all duration-500 hover:border-[#f2a01a]/55 md:p-10">
    <div class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#26180a]/85 blur-[60px]"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#4a2f0d]/55 pb-6 text-left text-base leading-relaxed text-[#bda98c] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {titleleft && <p class="bg-gradient-to-r from-[#ffeec2] via-[#dbe1e8] to-[#a3adba] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#ece0cc] md:pl-6">
        {title && <HeadingTag class="bg-gradient-to-r from-[#ffeec2] via-[#ffc94a] to-[#f2a01a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>}
        {
          titleright && (
            <p class="flex items-center gap-2 text-xl leading-normal font-black text-[#ffc94a]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#f2a01a] shadow-[0_0_5px_rgba(242,160,26,0.85)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
