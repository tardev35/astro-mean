---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// FLASH789: this variant arrived on a magenta/orange palette from an older
// brand. Remapped onto red (#ff2b2b / #c1121f / #8f0806) + gold
// (#ffe27a / #ffc531) on the near-black card surface.
// Pass ONE heading — title OR titleleft OR titleright — or the page gains an h2.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#ff2b2b]/30 bg-gradient-to-br from-[#2a0806]/92 to-[#170506]/88 p-8 text-[#f7ddd8] shadow-[0_10px_30px_rgba(255,43,43,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff2b2b]/60 hover:shadow-[0_15px_40px_rgba(255,43,43,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#ff2b2b]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#ffc531]/30"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#8f0806]/55 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe27a]/35"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7ddd8]">
        {
          titleleft && (
            <h2 class="bg-gradient-to-r from-[#ffe27a] via-[#ffc531] to-[#ff2b2b] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7ddd8] md:border-l md:border-[#8f0806] md:pl-10">
        {
          rightHeading && (
            <h2 class="mb-2 bg-gradient-to-r from-[#ffe27a] via-[#ffc531] to-[#ff2b2b] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
