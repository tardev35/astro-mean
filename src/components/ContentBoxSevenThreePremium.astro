---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// MONACO89: ย้ายจากชุดสีชมพูกลอสคู่ทองของแบรนด์เก่ากว่า (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
// มาที่ทองแอมเบอร์–คอปเปอร์คู่แดงรอยัลบนมะฮอกกานีดำ — ทอง #ffe9b8 / #ffd77a /
// #ef8f22 / #a44516 คู่แดง #d1201a / #7e120e บนผิว #26150a / #160d05 / #0b0602
// เนื้อความ #f6e3c0 ไม่มีชมพู/โรสเหลืออยู่ในไฟล์นี้
//
// titleleft เคย render เป็น <h2> คู่กับ rightHeading ทำให้ docx หนึ่งหัวข้อกลาย
// เป็นสองหัวข้อ ตอนนี้เป็น <p> ป้ายคอลัมน์ (คลาสเดิม) ส่วนหัวข้อจริงรับผ่าน
// `title` + `as` แบบเดียวกับ ContentBox / ContentBoxTwo / ContentBoxSevenThree
//
// ส่งหัวข้อเดียวเสมอ — title หรือ titleright — ไม่งั้นหน้าจะได้ h2 เกินมาหนึ่งตัว
// ที่ไม่มีหัวข้อ docx รองรับ
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#ef8f22]/30 bg-gradient-to-br from-[#26150a]/92 to-[#0b0602]/88 p-8 text-[#f6e3c0] shadow-[0_10px_30px_rgba(239,143,34,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffd77a]/65 hover:shadow-[0_15px_40px_rgba(209,32,26,0.38)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#d1201a]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#ef8f22]/35"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#7e120e]/65 blur-[60px] transition-all duration-500 group-hover:bg-[#a44516]/40"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e3c0]">
        {
          titleleft && (
            <p class="bg-gradient-to-r from-[#ffe9b8] via-[#ef8f22] to-[#d1201a] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e3c0] md:border-l md:border-[#d1201a]/50 md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#ffe9b8] via-[#ef8f22] to-[#d1201a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
