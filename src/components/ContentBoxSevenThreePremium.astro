---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// ASHTON168: ทองสว่างคู่เงินโครเมียม — ทอง #f5c518 / #ffd75e / #ffe9a3 / #c8941a /
// #a87908 / #7a5405 คู่เงิน #e2e5e9 / #f0f2f5 บนผิว #080502 / #160e03 / #2a1c06
// เนื้อความ #f0e6d2 ตัวอักษรสว่าง #fdf6e6 (ค่า hex ของแบรนด์ก่อนไม่พิมพ์ไว้ตรงนี้
// เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่
// ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// titleleft เป็น <p> ป้ายคอลัมน์ ไม่ใช่หัวข้อ docx ส่วนหัวข้อจริงรับผ่าน `title`
// + `as` แบบเดียวกับ ContentBox / ContentBoxTwo / ContentBoxSevenThree
//
// ส่งหัวข้อเดียวเสมอ — title หรือ titleright — ไม่งั้นหน้าจะได้ h2 เกินมาหนึ่งตัว
// ที่ไม่มีหัวข้อ docx รองรับ
//
// คอลัมน์ซ้าย 3fr คือช่องรูป คอลัมน์ขวา 7fr คือเนื้อความ — ส่งรูปหนึ่งใบเข้า
// slot="left" และย่อหน้าเดียวเข้า slot="right" รอบนี้บล็อกนี้เป็น SevenThree ใบ
// แรกในสองใบของเพดาน playbook คู่กับ slide1 (เว็บตรง ลิขสิทธิ์แท้ ฝาก-ถอน AUTO
// 3 นาที) และหัวข้อ docx ข้อ 5 เรื่องออโต้ไวทันใจที่ทำรายการคล่องไม่เสียจังหวะ
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f5c518]/30 bg-gradient-to-br from-[#160e03]/92 to-[#080502]/88 p-8 text-[#f0e6d2] shadow-[0_10px_30px_rgba(245,197,24,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffd75e]/65 hover:shadow-[0_15px_40px_rgba(226,229,233,0.35)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#2a1c06]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#f5c518]/35"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#7a5405]/60 blur-[60px] transition-all duration-500 group-hover:bg-[#e2e5e9]/40"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6d2]">
        {
          titleleft && (
            <p class="bg-gradient-to-r from-[#fdf6e6] via-[#f0f2f5] to-[#e2e5e9] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6d2] md:border-l md:border-[#f5c518]/55 md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#fdf6e6] via-[#ffd75e] to-[#c8941a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
