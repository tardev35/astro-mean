---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// TITANWIN168: ย้ายจากชุดทองคู่แพลทินัมของแบรนด์ก่อนหน้า มาเป็นม่วงไททันคู่มงกุฎทอง
// — ม่วง #a855f7 / #c084fc / #ede4ff / #7c3aed / #6d28d9 คู่ทองมงกุฎ #e3c176 /
// #f2dda3 และโครเมียมเงิน #dfe4f0 / #b9c0d0 บนผิว #22104a / #160a2b / #07030f /
// #2e1065 เนื้อความ #ddd2f5 (ค่า hex ของแบรนด์ก่อนไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind
// สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้
// ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// ป้ายคอลัมน์รูปรับโครเมียมเงินไล่ไปหาม่วง ส่วนหัวข้อฝั่งเนื้อความรับโครเมียม -> ม่วง
// -> ทอง สองฝั่งจึงแยกกันออกด้วยสีของแบรนด์เอง และทองมงกุฎยังโผล่ที่ออร่ามุมขวาล่าง
// ตอน hover
//
// titleleft เป็น <p> ป้ายคอลัมน์ ไม่ใช่หัวข้อ docx ส่วนหัวข้อจริงออกมาที่ระดับที่
// prop `as` สั่ง ผ่าน rightHeading — ไม่มี <h3> ฝังตายในไฟล์นี้ (docx รอบนี้แบน
// H1 + H2 ล้วน)
//
// ส่งหัวข้อเดียวเสมอ — title หรือ titleright — ไม่งั้นหน้าจะได้หัวข้อเกินมาหนึ่งตัว
// ที่ไม่มีหัวข้อ docx รองรับ
//
// คอลัมน์ซ้าย 3fr คือช่องรูป คอลัมน์ขวา 7fr คือเนื้อความ — ส่งรูปหนึ่งใบเข้า
// slot="left" และย่อหน้าเดียวเข้า slot="right" รอบนี้บล็อกนี้เป็น SevenThree ใบแรก
// ในสองใบของเพดาน playbook คู่กับ slide2 (แบนเนอร์คืนยอดเสียสูงสุด 12%) และหัวข้อ
// docx ข้อ 4 เรื่องโปรโมชั่นใหม่พร้อมชนทุกเวลา
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#6d28d9]/35 bg-gradient-to-br from-[#22104a]/92 to-[#07030f]/88 p-8 text-[#ddd2f5] shadow-[0_10px_30px_rgba(124,58,237,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#a855f7]/65 hover:shadow-[0_15px_40px_rgba(223,228,240,0.26)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#2e1065]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#7c3aed]/40"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#160a2b]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#e3c176]/25"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ddd2f5]">
        {
          titleleft && (
            <p class="bg-gradient-to-r from-[#dfe4f0] via-[#b9c0d0] to-[#6d28d9] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ddd2f5] md:border-l md:border-[#6d28d9]/50 md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#dfe4f0] via-[#c084fc] to-[#e3c176] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
