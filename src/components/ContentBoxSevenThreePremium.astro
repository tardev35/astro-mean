---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// BOOST168: ย้ายจากชุดทองแอมเบอร์–คอปเปอร์คู่แดงรอยัลบนมะฮอกกานีดำของแบรนด์ก่อน
// (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็น
// คอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git
// history) มาที่ทองบูสต์คู่น้ำเงินไฟฟ้าบนพื้นดำน้ำเงิน — ทอง #fff6dd / #ffe680 /
// #ffc233 / #b26a00 คู่น้ำเงิน #3f8cff / #12306e บนผิว #0e1430 / #03060f
// เนื้อความ #e6ecfb ไม่มีส้ม/แดงของแบรนด์เก่าเหลืออยู่ในไฟล์นี้
//
// titleleft เคย render เป็น <h2> คู่กับ rightHeading ทำให้ docx หนึ่งหัวข้อกลาย
// เป็นสองหัวข้อ ตอนนี้เป็น <p> ป้ายคอลัมน์ (คลาสเดิม) ส่วนหัวข้อจริงรับผ่าน
// `title` + `as` แบบเดียวกับ ContentBox / ContentBoxTwo / ContentBoxSevenThree
//
// ส่งหัวข้อเดียวเสมอ — title หรือ titleright — ไม่งั้นหน้าจะได้ h2 เกินมาหนึ่งตัว
// ที่ไม่มีหัวข้อ docx รองรับ
//
// คอลัมน์ซ้าย 3fr คือช่องรูป คอลัมน์ขวา 7fr คือเนื้อความ — ส่งรูปหนึ่งใบเข้า
// slot="left" และย่อหน้าเดียวเข้า slot="right"
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#ffc233]/30 bg-gradient-to-br from-[#0e1430]/92 to-[#03060f]/88 p-8 text-[#e6ecfb] shadow-[0_10px_30px_rgba(255,194,51,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffe680]/65 hover:shadow-[0_15px_40px_rgba(63,140,255,0.38)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#3f8cff]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#ffc233]/35"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#12306e]/65 blur-[60px] transition-all duration-500 group-hover:bg-[#b26a00]/40"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6ecfb]">
        {
          titleleft && (
            <p class="bg-gradient-to-r from-[#fff6dd] via-[#ffc233] to-[#3f8cff] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6ecfb] md:border-l md:border-[#3f8cff]/50 md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#fff6dd] via-[#ffc233] to-[#3f8cff] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
