---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// MACAUBET: remapped off THUNDER87's electric yellow (#fff89a / #fae61c /
// #dcb309 / #ffd60a / #8a7405 over #17150a / #080703, body #f0ead6) onto this
// brand's Macau neon green with a gold second colour — #dcffc0 / #8ef04a /
// #59cb13 / #3b9b0d / #0f3a11 over #0a2c0d / #020b01, body text #e9f9dc, gold
// #f6c445 on the hover border only. No yellow survives here.
//
// titleleft เคย render เป็น <h2> คู่กับ rightHeading ทำให้ docx หนึ่งหัวข้อกลาย
// เป็นสองหัวข้อ ตอนนี้เป็น <p> ป้ายคอลัมน์ (คลาสเดิม) ส่วนหัวข้อจริงรับผ่าน
// `title` + `as` แบบเดียวกับ ContentBox / ContentBoxTwo / ContentBoxSevenThree
//
// ส่งหัวข้อเดียวเสมอ — title หรือ titleright — ไม่งั้นหน้าจะได้ h2 เกินมาหนึ่งตัว
// ที่ไม่มีหัวข้อ docx รองรับ
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#59cb13]/30 bg-gradient-to-br from-[#0a2c0d]/92 to-[#020b01]/88 p-8 text-[#e9f9dc] shadow-[0_10px_30px_rgba(89,203,19,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#f6c445]/60 hover:shadow-[0_15px_40px_rgba(59,155,13,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#59cb13]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#8ef04a]/30"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#0f3a11]/60 blur-[60px] transition-all duration-500 group-hover:bg-[#3b9b0d]/40"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9f9dc]">
        {
          titleleft && (
            <p class="bg-gradient-to-r from-[#dcffc0] via-[#8ef04a] to-[#3b9b0d] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e9f9dc] md:border-l md:border-[#2c7a08] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#dcffc0] via-[#8ef04a] to-[#3b9b0d] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
