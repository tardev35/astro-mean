---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// IOK66: remapped off JUDTEM168's light gold (#feeb33 / #fac42c / #e4a434 /
// #cc8425 / #7a4a0d over #150d04 / #1e1206, body #f3e3c4) onto this brand's
// royal gold + crimson — #ffe9a3 / #f0cd6a / #e3b64a / #b8862c / #5c3a10 over
// #150c07 / #1c110a with a #5c0a0c glow, body text #f2e2c4.
//
// Pass ONE heading — title OR titleleft OR titleright — or the page gains an
// extra h2 that no docx heading backs.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#e3b64a]/30 bg-gradient-to-br from-[#1c110a]/92 to-[#150c07]/88 p-8 text-[#f2e2c4] shadow-[0_10px_30px_rgba(227,182,74,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffe9a3]/60 hover:shadow-[0_15px_40px_rgba(184,134,44,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#e3b64a]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe9a3]/30"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#5c0a0c]/55 blur-[60px] transition-all duration-500 group-hover:bg-[#a3161c]/40"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2e2c4]">
        {
          titleleft && (
            <h2 class="bg-gradient-to-r from-[#ffe9a3] via-[#e3b64a] to-[#b8862c] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2e2c4] md:border-l md:border-[#5c3a10] md:pl-10">
        {
          rightHeading && (
            <h2 class="mb-2 bg-gradient-to-r from-[#ffe9a3] via-[#e3b64a] to-[#b8862c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
