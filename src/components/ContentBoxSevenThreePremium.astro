---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// NEOCLUB88: ทองคลับคู่แพลทินัม — ทอง #f2cc53 / #ffe89a / #f6d977 / #c39b3c /
// #a8842c / #8a6415 คู่แพลทินัม #eef1f5 / #c6ccd4 / #8d949e บนผิว #241303 /
// #140b02 / #0a0602 เนื้อความ #ede0c4 หัวข้อ #fbf4e4 (ค่า hex ของแบรนด์ก่อนไม่
// พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง
// gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// ป้ายคอลัมน์รูปรับคู่แพลทินัม ส่วนหัวข้อฝั่งเนื้อความรับคู่ทอง สองฝั่งจึงแยกกัน
// ออกด้วยสีของแบรนด์เอง
//
// titleleft เป็น <p> ป้ายคอลัมน์ ไม่ใช่หัวข้อ docx ส่วนหัวข้อจริงรับผ่าน `title`
// + `as` แบบเดียวกับ ContentBox / ContentBoxTwo / ContentBoxSevenThree
//
// ส่งหัวข้อเดียวเสมอ — title หรือ titleright — ไม่งั้นหน้าจะได้ h2 เกินมาหนึ่งตัว
// ที่ไม่มีหัวข้อ docx รองรับ
//
// คอลัมน์ซ้าย 3fr คือช่องรูป คอลัมน์ขวา 7fr คือเนื้อความ — ส่งรูปหนึ่งใบเข้า
// slot="left" และย่อหน้าเดียวเข้า slot="right" รอบนี้บล็อกนี้เป็น SevenThree ใบ
// แรกในสองใบของเพดาน playbook คู่กับ slide3 (โปรฟรีสปินสุดคุ้ม ฝาก 100-400 ลุ้นรับ
// ฟรีสปินทันที) และหัวข้อ docx ข้อ 3 เรื่องเกมคัดพิเศษจากค่ายพรีเมียม
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#a8842c]/35 bg-gradient-to-br from-[#241303]/92 to-[#0a0602]/88 p-8 text-[#ede0c4] shadow-[0_10px_30px_rgba(195,155,60,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#f2cc53]/65 hover:shadow-[0_15px_40px_rgba(230,236,243,0.26)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#33230b]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#c39b3c]/40"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#140b02]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#c6ccd4]/25"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ede0c4]">
        {
          titleleft && (
            <p class="bg-gradient-to-r from-[#eef1f5] via-[#c6ccd4] to-[#8d949e] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ede0c4] md:border-l md:border-[#a8842c]/50 md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#fbf4e4] via-[#c6ccd4] to-[#f2cc53] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
