---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// สองคอลัมน์ถูก flatten แล้ว: คลาสข้อความอยู่บน <article> และ slot เป็นลูกโดยตรง
// ผู้เรียกจึงต้องส่ง "หนึ่ง element ต่อหนึ่ง slot" เท่านั้น (ฝั่ง 3 ส่วนรอบนี้รับ
// <Picture> ใบเดียว)
//
// titleleft/titleright เป็นป้ายคอลัมน์จึงเป็น <p> ส่วนหัวข้อ docx รับผ่าน prop
// `title` + `as` ตัวเดียว หัวข้อจะไปอยู่เหนือคอลัมน์เนื้อความ (ฝั่ง 7 ส่วน) ซึ่ง
// กว้างพอรับหัวข้อยาวของ docx ได้โดยไม่ล้นออกนอกการ์ด
//
// HAPPYSUPERWIN: ย้ายจากส้มเพลิงคู่ทองหลอมของแบรนด์ก่อนมาที่แคนดี้มาเจนต้าคู่เหลือง
// ลูกอม — มาเจนต้า #ff5ae6 / #e11ccc / #8a1f9e / #4c0d6b คู่เหลือง #ffd83d /
// #f0b429 บนผิว #0e0119 / #190430 / #280747 เนื้อความ #f7e2ff ข้อความรอง #cfa5e6
// ตัวอักษรสว่าง #fff0fc
// (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็น
// คอมเมนต์ ดูของเดิมได้จาก git history)
//
// รอบนี้บล็อกนี้เป็น SevenThree ใบแรกในสองใบของเพดาน playbook คู่กับ slide4
// (แผ่นป้าย "เล่นที่นี่ ดียังไง?" ที่กางข้อดีเป็นชิปแปดอัน) กับหัวข้อ docx ข้อ 2
// เรื่องคัดเกมน่าเล่นมาให้แบบไม่ต้องเสียเวลาหา
const sectionLabel = title ? undefined : (label ?? titleright ?? titleleft ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8a1f9e]/35 bg-[#190430]/90 p-8 text-[#f7e2ff] shadow-[0_10px_30px_rgba(76,13,107,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#e11ccc]/55 md:p-10">
    <div class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#280747]/80 blur-[60px]"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#8a1f9e]/30 pb-6 text-left text-base leading-relaxed text-[#cfa5e6] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {titleleft && <p class="bg-gradient-to-r from-[#fff0fc] via-[#f0b429] to-[#8a1f9e] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f7e2ff] md:pl-6">
        {title && <HeadingTag class="bg-gradient-to-r from-[#fff0fc] via-[#ff5ae6] to-[#e11ccc] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>}
        {
          titleright && (
            <p class="flex items-center gap-2 text-xl leading-normal font-black text-[#ff5ae6]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#e11ccc] shadow-[0_0_5px_rgba(225,28,204,0.85)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
