---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// DRACO65: ไฟล์นี้เคยเป็นเขียวนีออนมาเก๊า + ทองของ MACAUBET (#dcffc0 / #8ef04a /
// #59cb13 / #3b9b0d / #2c7a08 / #0f3a11 บนผิว #0a2c0d / #020b01 เนื้อความ
// #e9f9dc และทอง #f6c445 บนเส้นขอบตอน hover) ตอนนี้ย้ายมาเขียวมังกรนีออน —
// #dcfce7 / #4ade80 / #22c55e / #15803d / #14532d / #052e16 บนผิว #0a3318 /
// #040d07 เนื้อความ #d6ecdd โดยสีรองเป็นเงิน/โครเมียม #e2e8e4 ไม่มีทองเหลืออยู่
//
// titleleft เคย render เป็น <h2> คู่กับ rightHeading ทำให้ docx หนึ่งหัวข้อกลาย
// เป็นสองหัวข้อ ตอนนี้เป็น <p> ป้ายคอลัมน์ (คลาสเดิม) ส่วนหัวข้อจริงรับผ่าน
// `title` + `as` แบบเดียวกับ ContentBox / ContentBoxTwo / ContentBoxSevenThree
//
// ส่งหัวข้อเดียวเสมอ — title หรือ titleright — ไม่งั้นหน้าจะได้ h2 เกินมาหนึ่งตัว
// ที่ไม่มีหัวข้อ docx รองรับ
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#22c55e]/30 bg-gradient-to-br from-[#0a3318]/92 to-[#040d07]/88 p-8 text-[#d6ecdd] shadow-[0_10px_30px_rgba(34,197,94,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#e2e8e4]/60 hover:shadow-[0_15px_40px_rgba(21,128,61,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#22c55e]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#4ade80]/30"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#052e16]/60 blur-[60px] transition-all duration-500 group-hover:bg-[#15803d]/40"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d6ecdd]">
        {
          titleleft && (
            <p class="bg-gradient-to-r from-[#dcfce7] via-[#4ade80] to-[#15803d] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d6ecdd] md:border-l md:border-[#14532d] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#dcfce7] via-[#4ade80] to-[#15803d] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
