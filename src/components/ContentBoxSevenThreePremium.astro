---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// สองคอลัมน์ถูก flatten แล้ว: คลาสข้อความอยู่บน <article> และ slot เป็นลูกโดยตรง
// ผู้เรียกจึงต้องส่ง "หนึ่ง element ต่อหนึ่ง slot" เท่านั้น (ฝั่ง 3 ส่วนรอบนี้รับ
// <Picture> ใบเดียว)
//
// titleleft/titleright เป็นป้ายคอลัมน์จึงเป็น <p> ส่วนหัวข้อ docx รับผ่าน prop
// `title` + `as` ตัวเดียว หัวข้อจะไปอยู่เหนือคอลัมน์เนื้อความ (ฝั่ง 7 ส่วน) ซึ่ง
// กว้างพอรับหัวข้อยาวของ docx ได้โดยไม่ล้นออกนอกการ์ด
//
// SETH88: ย้ายจากชุดสีของแบรนด์ก่อนมาที่ทองคำอียิปต์คู่บรอนซ์ — ทอง #fdf3d4 /
// #f7d774 / #e0a92b / #a9711a คู่บรอนซ์ #6b4210 บนผิว #0c0703 / #1b1109 / #2a1a0d
// ขอบ #6b4210 เนื้อความ #f0e3cd ข้อความรอง #d6c2a0 — ป้ายคอลัมน์รูปรับไล่เฉดทองไปหา
// บรอนซ์ เพื่อให้เฉดลึกของโลหะมีที่ยืนจริง แบรนด์นี้ไม่มีสีคู่ตรงข้าม
// (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็น
// คอมเมนต์ ดูของเดิมได้จาก git history)
//
// รอบนี้บล็อกนี้เป็น SevenThree ใบแรกในสองใบของเพดาน playbook คู่กับ slide3
// (อาร์ต "ยอดเสีย คืนสูงสุด 10% / เล่นเสีย รับคืนทุกวัน ไม่ต้องลุ้น") กับหัวข้อ docx
// ข้อ 5 เรื่องโปรน่าสนใจเติมต่อเนื่องที่มีสิทธิ์คืนยอดเสีย Cash Back ทุกวัน
const sectionLabel = title ? undefined : (label ?? titleright ?? titleleft ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#6b4210]/65 bg-[#1b1109]/90 p-8 text-[#f0e3cd] shadow-[0_10px_30px_rgba(107,66,16,0.45)] backdrop-blur-xl transition-all duration-500 hover:border-[#e0a92b]/55 md:p-10">
    <div class="pointer-events-none absolute -top-24 -right-24 -z-10 h-48 w-48 rounded-full bg-[#2a1a0d]/85 blur-[60px]"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#6b4210]/55 pb-6 text-left text-base leading-relaxed text-[#d6c2a0] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {titleleft && <p class="bg-gradient-to-r from-[#fdf3d4] via-[#f7d774] to-[#a9711a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f0e3cd] md:pl-6">
        {title && <HeadingTag class="bg-gradient-to-r from-[#fdf3d4] via-[#f7d774] to-[#e0a92b] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>}
        {
          titleright && (
            <p class="flex items-center gap-2 text-xl leading-normal font-black text-[#f7d774]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full bg-[#a9711a] shadow-[0_0_5px_rgba(169,113,26,0.9)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
