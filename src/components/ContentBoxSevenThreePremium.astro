---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// UOK789: ไฟล์นี้ค้างชุดเขียวมิ้นต์คู่ทองของแบรนด์ก่อนหน้ามา (ค่า hex เดิมไม่พิมพ์
// ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen
// คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history) รอบนี้
// ย้ายมาเขียวมรกตคู่ทองเมทัลลิกของแบรนด์นี้ — เขียว #b6ecbd / #2fc44f / #12923a /
// #0a4d1c คู่ทอง #fdf3c9 / #f6c945 / #8a6a1c บนผิว #08290f / #04140a เนื้อความ
// #e8f3e4 ไม่มีมิ้นต์เฉดเดิมเหลืออยู่ในไฟล์นี้
//
// titleleft เป็น <p> ป้ายคอลัมน์ ไม่ใช่หัวข้อ docx ส่วนหัวข้อจริงรับผ่าน `title`
// + `as` แบบเดียวกับ ContentBox / ContentBoxTwo / ContentBoxSevenThree
//
// ส่งหัวข้อเดียวเสมอ — title หรือ titleright — ไม่งั้นหน้าจะได้ h2 เกินมาหนึ่งตัว
// ที่ไม่มีหัวข้อ docx รองรับ
//
// คอลัมน์ซ้าย 3fr คือช่องรูป คอลัมน์ขวา 7fr คือเนื้อความ — ส่งรูปหนึ่งใบเข้า
// slot="left" และย่อหน้าเดียวเข้า slot="right"
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f6c945]/30 bg-gradient-to-br from-[#08290f]/92 to-[#04140a]/88 p-8 text-[#e8f3e4] shadow-[0_10px_30px_rgba(246,201,69,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdf3c9]/65 hover:shadow-[0_15px_40px_rgba(18,146,58,0.38)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#0a4d1c]/55 blur-[60px] transition-all duration-500 group-hover:bg-[#f6c945]/35"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#0c3d18]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#8a6a1c]/45"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8f3e4]">
        {
          titleleft && (
            <p class="bg-gradient-to-r from-[#f4fdf3] via-[#f6c945] to-[#2fc44f] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8f3e4] md:border-l md:border-[#12923a]/60 md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#f4fdf3] via-[#f6c945] to-[#2fc44f] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
