---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// 249UP: remapped off IOK66's royal gold + crimson (#ffe9a3 / #f0cd6a / #e3b64a
// / #b8862c / #5c3a10 over #150c07 / #1c110a with a #5c0a0c / #a3161c glow,
// body #f2e2c4) onto this brand's single-hue gold on near-black —
// #ffe9a8 / #ffd86b / #f5b626 / #c98a12 / #8a5c08 over #150e05 / #1e1409,
// body text #f0e4cd. ไม่มีสีแดงเหลืออยู่ในไฟล์นี้แล้ว โลโก้ 249UP เป็นทองล้วน
//
// titleleft เคย render เป็น <h2> คู่กับ rightHeading ทำให้ docx หนึ่งหัวข้อกลาย
// เป็นสองหัวข้อ ตอนนี้เป็น <p> ป้ายคอลัมน์ (คลาสเดิม) ส่วนหัวข้อจริงรับผ่าน
// `title` + `as` แบบเดียวกับ ContentBox / ContentBoxTwo / ContentBoxSevenThree
//
// ส่งหัวข้อเดียวเสมอ — title หรือ titleright — ไม่งั้นหน้าจะได้ h2 เกินมาหนึ่งตัว
// ที่ไม่มีหัวข้อ docx รองรับ
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f5b626]/30 bg-gradient-to-br from-[#1e1409]/92 to-[#150e05]/88 p-8 text-[#f0e4cd] shadow-[0_10px_30px_rgba(245,182,38,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffe9a8]/60 hover:shadow-[0_15px_40px_rgba(201,138,18,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#f5b626]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe9a8]/30"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#8a5c08]/55 blur-[60px] transition-all duration-500 group-hover:bg-[#c98a12]/40"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e4cd]">
        {
          titleleft && (
            <p class="bg-gradient-to-r from-[#ffe9a8] via-[#f5b626] to-[#c98a12] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e4cd] md:border-l md:border-[#8a5c08] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#ffe9a8] via-[#f5b626] to-[#c98a12] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
