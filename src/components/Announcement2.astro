---
const {
  message = "PODK888 เว็บตรงเกมครบทุกสาย รวมสล็อต บาคาร่า และคาสิโนสดไว้ในแพลตฟอร์มเดียว ไม่ต้องสลับเว็บให้ปวดหัว • คัดเฉพาะค่ายแท้ ภาพคมชัดไม่มีสะดุด ดีลเลอร์ไลฟ์สดพร้อมลั่นตลอด 24 ชั่วโมง • แตกโหดเต็มหน้ากระดาน เข้าฟีเจอร์รัวๆ อัตราการจ่ายที่คนพูดถึงกันปากต่อปาก • ระบบใหม่โอนไว กดปุ๊บเงินเด้งปั๊บ ปลอดภัยทุกยอด ข้อมูลไม่รั่วไหล • ไม่มีประวัติโกงแม้แต่บาทเดียว แอดมินสแตนด์บายดูแลตั้งแต่สมัครจนถึงถอน",
} = Astro.props;
---

<div class="relative mx-auto flex h-[42px] max-w-[900px] items-center overflow-hidden rounded-sm bg-[#12060f] shadow-[0_4px_15px_rgba(0,0,0,0.5)]">
  <div class="relative z-10 flex h-full items-center bg-gradient-to-r from-[#e01e83] to-[#f670b7] px-6 pl-4 [clip-path:polygon(0_0,100%_0,85%_100%,0_100%)] md:px-8">
    <div class="flex items-center gap-2">
      <span class="relative flex h-2.5 w-2.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#12060f] opacity-75"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[#12060f]"></span>
      </span>
      <span class="font-black tracking-widest text-[#12060f] italic drop-shadow-md">HOT</span>
    </div>
  </div>

  <div class="relative flex-1 overflow-hidden">
    <div class="absolute inset-y-0 left-0 z-10 w-8 bg-gradient-to-r from-[#12060f] to-transparent"></div>
    <div class="absolute inset-y-0 right-0 z-10 w-8 bg-gradient-to-l from-[#12060f] to-transparent"></div>

    <div class="marquee flex w-max animate-[scroll_20s_linear_infinite] items-center gap-10 pl-4 text-sm font-bold whitespace-nowrap text-[#f3d7e7]/90 md:text-base">
      <span>{message}</span>
      <span aria-hidden="true">{message}</span>
      <span aria-hidden="true">{message}</span>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-[#f670b7] via-[#02dbfd] to-transparent"></div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      animation: none;
    }
  }
</style>
