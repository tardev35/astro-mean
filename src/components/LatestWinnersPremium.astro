---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { brandPick } from "../lib/brandProfile";

// Real bank brand colours — deliberately NOT rethemed to the brand palette.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// The rotation is driven by src/lib/winnersFeed.ts — never a
// `<script define:vars>`, never an empty container filled by JS. The first five
// rows are server-rendered so a crawler and a JS-less visitor see real rows,
// and the module only takes over the updating.
//
// Two independent row states, both configured from the markup so the shared
// module never learns this brand's palette or wording:
//   data-winner-status  pending vs done — text + classes
//   data-winner-big     over BIG_WIN the row gets the bright-gold treatment
//
// The HUD totals are server-rendered and the module continues from them via
// data-seed — otherwise the figures would visibly reset to zero the moment JS
// ran, then climb again.
//
// Values come from the domain hash (brandPick), never Math.random():
// frontmatter runs at build time, and the gate fails the build on a random call
// there. data-pending-chance is 0.2, so the server-rendered rows mirror it with
// a 1-in-5 draw rather than brandFlag's 50/50.
//
// 249UP: rethemed off IOK66's royal gold (#ffe9a3 / #f0cd6a / #e3b64a / #b8862c
// / #5c3a10 over #150c07 / #1c110a / #0d0705, body #f2e2c4, muted #ddc8a4) onto
// this brand's warm gold-luxury — #ffe9a8 / #ffd86b / #f5b626 / #c98a12 /
// #8a5c08 / #3a2606 over #150e05 / #1e1409 / #0b0703, body #f0e4cd, muted
// #f0e4cd at 60–70% opacity.
const BIG_WIN = 40000;
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const initialRows = Array.from({ length: 5 }, (_, i) => {
  const amount = 100 + pick(`up-amount-${i}`, 48901);
  return {
    bank: bankPool[pick(`up-bank-${i}`, bankPool.length)],
    user: `0${pick(`up-p-${i}`, 2) === 0 ? "8" : "9"}***${digits(`up-u${i}`, 4)}`,
    amount,
    big: amount > BIG_WIN,
    pending: pick(`up-s-${i}`, 5) === 0,
  };
});

const seedTotal = initialRows.reduce((sum, row) => sum + row.amount, 0);

const ROW_NORMAL = "border-[#f5b626]/20";
const ROW_BIG = "border-[#ffe9a8]/55 shadow-[0_0_15px_rgba(245,182,38,0.25)]";
const STATUS_PENDING = "text-[#f5b626] font-bold";
const STATUS_DONE = "text-green-400 font-bold";
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <section
    aria-label="รายการถอนเงินล่าสุดของสมาชิก 249UP"
    class="relative overflow-hidden rounded-3xl border border-[#f5b626]/35 bg-[#150e05]/88 shadow-[0_10px_40px_rgba(11,7,3,0.85)] backdrop-blur-xl">
    <div class="relative z-10 flex flex-col gap-4 border-b border-[#f5b626]/30 px-5 py-5 sm:flex-row sm:items-center sm:justify-between md:px-8">
      <div class="flex items-center gap-3">
        <span aria-hidden="true" class="flex h-10 w-10 items-center justify-center rounded-full border border-[#f5b626]/35 bg-[#3a2606] text-2xl text-[#ffe9a8]">🏆</span>
        <div class="flex flex-col">
          <p class="text-2xl font-black tracking-widest text-[#f0e4cd] drop-shadow-sm">
            รายการถอนเงินล่าสุด 249<span class="text-[#ffe9a8]">UP</span>
          </p>
          <span class="text-[11px] font-medium tracking-wide text-[#f0e4cd]/70">ระบบโอนไวเข้าบัญชีเลย ทำรายการเองได้แบบออโต้ ไม่ต้องส่งสลิป ไม่ต้องรอทีมงานอนุมัติให้เสียอารมณ์</span>
        </div>
      </div>
      <div class="flex items-center gap-2 self-start rounded-full border border-green-500/40 bg-green-900/20 px-3 py-1.5 sm:self-auto">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.8)]"></span>
        <span class="text-[10px] font-bold tracking-widest text-green-400 uppercase">Live</span>
      </div>
    </div>

    <div class="relative z-10 grid grid-cols-2 gap-px overflow-hidden border-b border-[#f5b626]/20 bg-[#3a2606]/40 sm:grid-cols-3">
      <div class="flex flex-col items-center gap-1 bg-[#150e05] px-4 py-4">
        <span class="text-[11px] font-medium tracking-wide text-[#f0e4cd]/70">ยอดถอนรวมวันนี้</span>
        <span
          data-winners-total
          data-prefix="฿"
          data-seed={seedTotal}
          class="bg-gradient-to-r from-[#ffe9a8] to-[#c98a12] bg-clip-text font-mono text-lg font-black text-transparent sm:text-xl">
          ฿{seedTotal.toLocaleString("en-US")}
        </span>
      </div>
      <div class="flex flex-col items-center gap-1 bg-[#150e05] px-4 py-4">
        <span class="text-[11px] font-medium tracking-wide text-[#f0e4cd]/70">รายการสำเร็จวันนี้</span>
        <span data-winners-count data-seed={initialRows.length} class="font-mono text-lg font-black text-[#f0e4cd] sm:text-xl">{initialRows.length}</span>
      </div>
      <div class="col-span-2 flex flex-col items-center gap-1 bg-[#150e05] px-4 py-4 sm:col-span-1">
        <span class="text-[11px] font-medium tracking-wide text-[#f0e4cd]/70">หักค่าธรรมเนียมการถอน</span>
        <span class="font-mono text-lg font-black text-[#f0e4cd] sm:text-xl">0% จ่ายเต็มทุกยอด</span>
      </div>
    </div>

    <div class="relative z-10 hidden grid-cols-[2fr_1.3fr_1fr_0.8fr] gap-4 px-8 pt-4 text-[11px] font-bold tracking-widest text-[#f0e4cd]/70 uppercase sm:grid">
      <span>ผู้ใช้งาน</span>
      <span>สถานะ</span>
      <span class="text-right">จำนวนเงิน</span>
      <span class="text-right">เวลา</span>
    </div>

    <div
      data-winners-feed
      data-interval="3500"
      data-max-rows="5"
      data-amount-min="100"
      data-amount-max="49000"
      data-user-style="phone"
      data-pending-chance="0.2"
      data-big-win-above={BIG_WIN}
      class="relative z-10 flex h-[380px] flex-col gap-2 overflow-hidden px-4 py-4 md:px-8">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row origin-top transition-all duration-500 ease-out">
            <div
              data-winner-big
              data-normal-class={ROW_NORMAL}
              data-big-class={ROW_BIG}
              class={`grid grid-cols-[auto_1fr] items-center gap-4 rounded-xl border bg-[#1e1409]/88 p-3.5 shadow-sm transition-colors duration-300 hover:border-[#ffe9a8]/60 hover:bg-[#3a2606] sm:grid-cols-[2fr_1.3fr_1fr_0.8fr] ${row.big ? ROW_BIG : ROW_NORMAL}`}>
              <div class="col-span-2 flex items-center gap-3 sm:col-span-1">
                <div data-winner-bank class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="20" height="20" loading="lazy" decoding="async" class="h-5 w-5 object-contain grayscale" />
                </div>
                <span data-winner-user class="font-mono text-sm font-bold text-[#f0e4cd]">{row.user}</span>
              </div>
              <div class="flex items-center gap-1.5 text-[11px] tracking-wide sm:text-xs">
                <span data-winner-big data-normal-text="✓" data-big-text="👑" aria-hidden="true" class="shrink-0">
                  {row.big ? "👑" : "✓"}
                </span>
                <span
                  data-winner-status
                  data-pending-text="กำลังโอนเข้าบัญชี"
                  data-done-text="ถอนสำเร็จ จ่ายเต็มจำนวน"
                  data-pending-class={STATUS_PENDING}
                  data-done-class={STATUS_DONE}
                  class={row.pending ? STATUS_PENDING : STATUS_DONE}>
                  {row.pending ? "กำลังโอนเข้าบัญชี" : "ถอนสำเร็จ จ่ายเต็มจำนวน"}
                </span>
              </div>
              <div class="bg-gradient-to-r from-[#ffe9a8] to-[#c98a12] bg-clip-text text-right font-mono text-base font-black text-transparent sm:text-lg">
                ฿<span data-winner-amount>{row.amount.toLocaleString("en-US")}</span>
              </div>
              <div class="text-right text-[11px] font-medium text-[#f0e4cd]/70 sm:text-xs">เมื่อสักครู่</div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .font-mono {
    font-family: var(--font-sans);
  }

  .winner-row.is-entering {
    transform: translateY(-0.75rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
