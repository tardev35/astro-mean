  { name: "WM Casino", desc: "เสือมังกรและไฮโลจังหวะกระชับรู้ผลไว เหมาะกับคนที่ชอบเกมสั้นตัดสินเร็ว", tag: "เสือมังกร ไฮโล", icon: "🐉" },
  { name: "Big Gaming", desc: "สลับเปลี่ยนโต๊ะเดิมพันได้ฉับไวด้วยระบบตรงที่เสถียร ไม่หน่วงไม่กระตุก", tag: "สลับโต๊ะไว", icon: "🎲" },
];
---

<section aria-label="ค่ายเกมสดที่ LUCKYBKK คัดมารวมไว้ในที่เดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f5f9ff] via-[#f0b323] to-[#3f9dfb] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมสดที่ <span class="text-[#f0b323]">LUCKYBKK</span> คัดมารวมไว้ในที่เดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f0b323] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#f0b323]/30 bg-[#061442]/92 p-5 shadow-[0_10px_30px_rgba(240,179,35,0.2)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#f0b323]/60 hover:bg-[#0d2160]/95 hover:shadow-[0_15px_40px_rgba(63,157,251,0.35)]">
          <div class="pointer-events-none absolute inset-0 bg-[#0a2a86]/40 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffdf7e] to-[#f0b323] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#030b28] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#e4eeff] transition-colors group-hover:text-[#f0b323]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#e4eeff]/75">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#f0b323]/30 bg-[#030b28] py-1.5 text-center text-[11px] font-bold text-[#f0b323] shadow-inner transition-colors duration-300 group-hover:border-[#ffdf7e]/60 group-hover:bg-gradient-to-r group-hover:from-[#ffdf7e] group-hover:to-[#f0b323] group-hover:text-[#030b28]">
            เข้าดูโต๊ะเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
