---
const providers = [
  { name: "PG Soft", desc: "สล็อตฟีเจอร์แน่น กราฟิกจัดเต็ม โหลดไว เป็นค่ายที่สายปั่นเลือกบ่อยที่สุด", tag: "ค่ายหลัก", icon: "🎰" },
  { name: "Pragmatic Play", desc: "เกมใหม่มาแรง ฟรีสปินตัวคูณสูง รองรับทั้งไม้เล็กและไม้ใหญ่", tag: "ยอดฮิต", icon: "🔥" },
  { name: "JILI", desc: "สล็อตจังหวะไว รอบสั้น ฟีเจอร์แตกง่าย เหมาะกับคนชอบปั่นต่อเนื่อง", tag: "รอบไว", icon: "🐾" },
  { name: "Evolution", desc: "เกมโต๊ะไลฟ์สดจากสตูดิโอจริง เดินรอบแบบเรียลไทม์ทุกช่วงเวลา", tag: "ไลฟ์สด", icon: "🎴" },
  { name: "เกม RTP สูงคัดมาแล้ว", desc: "คัดเฉพาะเกมฮิตติดชาร์ตที่โบนัสไทม์แตกบ่อย ไม่ต้องซื้อฟรีสปินแพงๆ", tag: "แตกง่าย", icon: "💥" },
  { name: "API ลิขสิทธิ์แท้ตรงค่าย", desc: "ดึงสัญญาณเกมจากผู้พัฒนาโดยตรง ไม่ผ่านคนกลาง ไร้การแทรกแซงหลังบ้าน", tag: "เว็บตรง 100%", icon: "⚡" },
  { name: "เล่นลื่นทุกอุปกรณ์", desc: "ไม่ค้างไม่หน่วง จะใช้มือถือ แท็บเล็ต หรือคอมก็ลุ้นสแคทเตอร์ได้เต็มฟีล", tag: "ไม่สะดุด", icon: "📱" },
];
---

<section aria-label="ค่ายเกมสล็อตและระบบที่ NEKOATK รวมไว้ในบัญชีเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffb457] via-[#fd841b] to-[#fb0660] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมสล็อตที่ <span class="text-[#c77dff]">NEKOATK</span> รวมไว้ในบัญชีเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fb0660] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#fb0660]/25 bg-[#1f0524]/92 p-5 shadow-[0_10px_30px_rgba(251,6,96,0.18)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#fb0660]/50 hover:bg-[#2c0733]/95 hover:shadow-[0_15px_40px_rgba(251,6,96,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#fb0660]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffb457] via-[#fd841b] to-[#fb0660] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#2a0210] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f6dfec] transition-colors group-hover:text-[#ffb457]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#c8a3bd]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#fb0660]/25 bg-[#160318] py-1.5 text-center text-[11px] font-bold text-[#fb0660] shadow-inner transition-colors duration-300 group-hover:border-[#fb0660]/50 group-hover:bg-gradient-to-r group-hover:from-[#ffb457] group-hover:via-[#fd841b] group-hover:to-[#fb0660] group-hover:text-[#2a0210]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
