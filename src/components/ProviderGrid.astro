---
// Widget ไม่ใช่ article: หัวข้อ render เป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech เนื้อหาตาม brief ของ DRACO65 — ล็อบบี้อัดแน่นด้วยค่ายสล็อตชั้นนำ
// ระดับโลก คัดมาเฉพาะเกมตัวตึง เกมฮิตติดเทรนด์ และเกมแตกดี กดเลือกเกมใหม่ลุยต่อ
// ได้ทันทีโดยไม่ต้องเสียเวลาค้นหานาน
//
// DRACO65: ย้ายจากม่วงโกธิคของ PHANTOM569 (#ede9fe / #b794ff / #8b5cf6 /
// #6d28d9 / #4c1d95 / #2a0a52 บนผิว #1c0343 / #12002b เนื้อความ #ded4f5
// ข้อความรอง #a99ac9 ทอง #f6c445) มาที่เขียวมังกรนีออน — #dcfce7 / #4ade80 /
// #22c55e / #15803d / #14532d / #0a3318 บนผิว #062011 / #04150a เนื้อความ
// #d6ecdd ข้อความรอง #9dbfa8 โดยป้ายมุมการ์ดรับสีรองของแบรนด์คือเงิน/โครเมียม
// #e2e8e4 / #9dbfa8
const providers = [
  { name: "PG Soft", desc: "เกมตัวตึงที่โหมดฟรีสปินออกบ่อย กราฟิกไหลลื่นไม่มีกระตุกตั้งแต่สปินแรก", tag: "ฟรีสปินบ่อย", icon: "🐲" },
  { name: "Pragmatic Play", desc: "ตัวคูณรางวัลพร้อมระเบิดแจ็คพอตต่อเนื่อง เปลี่ยนเบทเบาๆ ให้เป็นกำไรก้อนใหญ่", tag: "ตัวคูณดุ", icon: "💥" },
  { name: "JILI", desc: "เกมฮิตติดเทรนด์ที่คนไทยเล่นเยอะ รอบสั้นตัดสินไว เหมาะกับสายจังหวะเร็ว", tag: "ฮิตติดเทรนด์", icon: "🔥" },
  { name: "Joker Gaming", desc: "กติกาไม่ซับซ้อน กดเข้าเล่นได้ทันที เหมาะกับคนเพิ่งเริ่มจับสล็อตเว็บตรง", tag: "เล่นง่าย", icon: "🃏" },
  { name: "Relax Gaming", desc: "สายเกมแตกดีที่สัญลักษณ์พิเศษช่วยให้เข้าถึงรอบโบนัสได้ง่ายกว่าเดิม", tag: "เข้าโบนัสไว", icon: "🎁" },
  { name: "Habanero", desc: "คอนเซปต์เกมหลากหลาย สลับสับเปลี่ยนเล่นได้ไม่มีเบื่อในบัญชีเดียว", tag: "เกมหลากหลาย", icon: "🎨" },
  { name: "Nolimit City", desc: "ฟีเจอร์ดุดันสำหรับสายลุยเต็มสปีด ลุ้นระทึกได้ทุกจังหวะการหมุน", tag: "ฟีเจอร์ดุ", icon: "⚡" },
];
---

<section aria-label="ค่ายเกมสล็อตชั้นนำที่ DRACO65 รวมไว้เต็มล็อบบี้" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#dcfce7] via-[#4ade80] to-[#22c55e] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมสล็อตชั้นนำที่ <span class="text-[#e2e8e4]">DRACO65</span> รวมไว้เต็มล็อบบี้
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#22c55e] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#22c55e]/30 bg-[#062011]/92 p-5 shadow-[0_10px_30px_rgba(34,197,94,0.2)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#22c55e]/60 hover:bg-[#0a3318]/95 hover:shadow-[0_15px_40px_rgba(74,222,128,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#14532d]/45 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#e2e8e4] to-[#9dbfa8] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#04150a] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#d6ecdd] transition-colors group-hover:text-[#4ade80]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#9dbfa8]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#22c55e]/30 bg-[#04150a] py-1.5 text-center text-[11px] font-bold text-[#4ade80] shadow-inner transition-colors duration-300 group-hover:border-[#dcfce7]/60 group-hover:bg-gradient-to-r group-hover:from-[#dcfce7] group-hover:to-[#4ade80] group-hover:text-[#04150a]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
