---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// Widget ไม่ใช่ article: หัวข้อ render เป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ห้ามเลื่อน <p> ขึ้นเป็น <h2> เพราะจำนวน h2 บนหน้าแรกถูก diff กับ
// checklist ของ docx และชื่อค่ายในการ์ดก็ห้ามเป็น <h3> ด้วยเหตุผลเดียวกัน
//
// ชื่อค่ายในลิสต์นี้ต้องตรงกับ "โลโก้ที่พิมพ์อยู่บนรูปจริง" เพราะ alt ถูกประกอบจาก
// ชื่อนั้น — ไฟล์ในโฟลเดอร์ providers/ อ่านออกมาได้ตามนี้ game1 = PG (Pocket Games
// Soft) ซึ่งก็คือ PG Soft ในบรีฟ, game2 = SexySlot, game3 = SlotXO, game4 = Joker
// ซึ่งก็คือ Joker Gaming ในบรีฟ, game5 = JILI, game6 = PP SLOT ซึ่งก็คือ Pragmatic
// Play ในบรีฟ ถ้าจะเปลี่ยนชื่อค่ายของช่องไหน ต้องเปลี่ยนไฟล์รูปตามด้วย ห้ามตั้งชื่อ
// ค่ายที่โฟลเดอร์นี้ไม่มีโลโก้อยู่จริง
//
// เนื้อหาตาม brief ของ XONEBET ซึ่งเป็นสล็อตเว็บตรง API แท้: คัดกรองเฉพาะค่ายใหญ่
// ระดับเกรด A เช่น PG Soft, Pragmatic Play และ Joker Gaming เน้นเกมตัวท็อปที่มี
// โครงสร้างการจ่ายเงินโปร่งใส จังหวะฟรีสปินเข้าไว และอัตราคูณสะสมสูง ตัดเกมไร้
// คุณภาพออกทั้งหมด กริดนี้จึงเป็นภาพประกอบของหัวข้อ docx ข้อ 3 โดยตรงและวางต่อท้าย
// บล็อกนั้นทันที สามช่องแรกเรียงตามลำดับชื่อค่ายที่ย่อหน้านั้นเอ่ยถึง
//
// XONEBET: ชุดสีเป็นทองหลอมคู่เงินโครเมียมบนดำสนิท — ทอง #ebb101 / #fee505 /
// #a87c02 / #5c4301 คู่เงิน #e9e9e9 / #c4c4c4 และครีมทอง #fff8d1 บนผิว #0a0803 /
// #161105 / #221a08 เนื้อความ #f4e6bd ข้อความรอง #c3ae76 ป้ายมุมบนขวารับทองเพื่อ
// ให้ตัวหนังสือสีเข้มอ่านออกบนพื้นสว่าง (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ —
// Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มี
// ใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
const providers = [
  { name: "PG Soft (Pocket Games Soft)", desc: "ค่ายใหญ่ระดับเกรด A ที่ยิงสัญญาณตรงจากเซิร์ฟเวอร์หลัก โครงสร้างการจ่ายเงินโปร่งใส จังหวะฟรีสปินเข้าไว", tag: "ฟรีสปินเข้าไว", img: img1 },
  { name: "Pragmatic Play", desc: "เกมตัวท็อปที่อัตราคูณสะสมสูง มาพร้อมตัวคูณทวีคูณและโหมด Buy Feature สำหรับสายใจร้อน", tag: "อัตราคูณสะสมสูง", img: img6 },
  { name: "Joker Gaming", desc: "ค่ายยักษ์ใหญ่ที่คนไทยคุ้นเคย คัดเฉพาะเกมตัวท็อป ตัดเกมไร้คุณภาพออกทั้งหมดก่อนลงล็อบบี้", tag: "คัดของเด่นเท่านั้น", img: img4 },
  { name: "SlotXO", desc: "หมวดเกมสายคลาสสิกที่กดเข้าเล่นจากล็อบบี้เดียวได้ทันที ไม่ต้องสลับเว็บและไม่ต้องโยกเงิน", tag: "เข้าเกมไม่สะดุด", img: img3 },
  { name: "JILI", desc: "เกมทำเงินไซซ์กะทัดรัด รอบสปินสั้น เหมาะกับคนที่อยากได้จังหวะลุ้นเร็วในช่วงเวลาจำกัด", tag: "รอบสปินสั้น", img: img5 },
  { name: "SexySlot", desc: "เติมความหลากหลายให้คลังเกม เปิดใช้งานจากบัญชีเดียวตามโครงสร้าง One-Stop Service", tag: "บัญชีเดียวจบ", img: img2 },
];
---

<section aria-label="ค่ายเกมใหญ่ระดับเกรด A ที่ XONEBET คัดลงล็อบบี้ให้เลือกตั้งแต่เปิดหน้าแรก" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fff8d1] via-[#fee505] to-[#e9e9e9] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมใหญ่ระดับเกรด A ที่ <span class="text-[#fee505]">XONEBET</span> คัดลงล็อบบี้ให้เลือกตั้งแต่เปิดหน้าแรก
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#c3ae76]">
      คลังเกมคัดกรองเฉพาะค่ายใหญ่ระดับเกรด A อย่าง PG Soft, Pragmatic Play และ Joker Gaming เน้นเฉพาะเกมตัวท็อปที่มีโครงสร้างการจ่ายเงินโปร่งใส จังหวะฟรีสปินเข้าไว และมีอัตราคูณสะสมสูง
      ตัดเกมไร้คุณภาพออกทั้งหมดเพื่อให้ทุกสปินมีโอกาสทำเงินได้จริงตั้งแต่เปิดล็อบบี้
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ebb101] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#5c4301]/45 bg-[#0a0803]/92 p-5 pt-9 shadow-[0_10px_30px_rgba(92,67,1,0.3)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#fee505]/60 hover:bg-[#161105]/95 hover:shadow-[0_15px_40px_rgba(235,177,1,0.32)]">
          <div class="pointer-events-none absolute inset-0 bg-[#0a0803]/55 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fee505] to-[#ebb101] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#0a0803] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <Picture
            src={provider.img}
            alt={`โลโก้ค่ายเกม ${provider.name} บนการ์ดค่ายเกมลิขสิทธิ์แท้ในล็อบบี้ของ XONEBET`}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            loading="lazy"
            fetchpriority="low"
            widths={[112, 224]}
            sizes="112px"
            decoding="async"
            quality={70}
            class="relative z-10 mb-3 block h-28 w-28 rounded-xl border border-[#5c4301]/55 object-cover transition-transform duration-500 group-hover:scale-110"
          />

          <p class="relative z-10 text-center text-sm font-black text-[#f4e6bd] transition-colors group-hover:text-[#fff8d1]">{provider.name}</p>
          <p class="relative z-10 mt-1 text-center text-[11px] leading-relaxed text-[#c3ae76]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#5c4301]/55 bg-[#0a0803] py-1.5 text-center text-[11px] font-bold text-[#fee505] shadow-inner transition-colors duration-300 group-hover:border-[#e9e9e9]/60 group-hover:bg-gradient-to-r group-hover:from-[#5c4301] group-hover:to-[#a87c02] group-hover:text-[#fff8d1]">
            เข้าดูเกมทั้งหมดในค่ายนี้
          </span>
        </a>
      ))
    }
  </div>
</section>
