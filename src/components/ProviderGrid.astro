---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// Widget ไม่ใช่ article: หัวข้อ render เป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ห้ามเลื่อน <p> ขึ้นเป็น <h2> เพราะจำนวน h2 บนหน้าแรกถูก diff กับ
// checklist ของ docx และชื่อค่ายในการ์ดก็ห้ามเป็น <h3> ด้วยเหตุผลเดียวกัน
//
// ชื่อค่ายในลิสต์นี้ต้องตรงกับ "โลโก้ที่พิมพ์อยู่บนรูปจริง" เพราะ alt ถูกประกอบจาก
// ชื่อนั้น — ไฟล์ในโฟลเดอร์ providers/ อ่านออกมาได้ตามนี้ game1 = PG (Pocket Games
// Soft) ซึ่งก็คือ PG Soft ในบรีฟ, game2 = SexySlot, game3 = SlotXO, game4 = Joker
// ซึ่งก็คือ Joker Gaming ในบรีฟ, game5 = JILI, game6 = PP SLOT ซึ่งก็คือ Pragmatic
// Play ในบรีฟ ถ้าจะเปลี่ยนชื่อค่ายของช่องไหน ต้องเปลี่ยนไฟล์รูปตามด้วย ห้ามตั้งชื่อ
// ค่ายที่โฟลเดอร์นี้ไม่มีโลโก้อยู่จริง
//
// เนื้อหาตาม brief ของ BLACKJACK789 ซึ่งเป็นสล็อตเว็บตรง API แท้: ดึงเฉพาะสัญญาณ
// เกมลิขสิทธิ์แท้จากค่ายยักษ์ใหญ่ระดับ A-List ทั้ง PG Soft, Pragmatic Play และ
// Joker Gaming เข้าสู่ระบบโดยตรง ทุกเกมผ่านการทดสอบอัตราจ่าย กราฟิกสมูธ คมชัดระดับ
// HD กริดนี้จึงเป็นภาพประกอบของหัวข้อ docx ข้อ 3 โดยตรงและวางต่อท้ายบล็อกนั้นทันที
// สามช่องแรกเรียงตามลำดับชื่อค่ายที่ย่อหน้านั้นเอ่ยถึง
//
// BLACKJACK789: ชุดสีเป็นทองแอนทีค/แชมเปญบนดำเกือบสนิท — ทอง #fdf1ce / #f2cf70 /
// #d3aa4b / #b8862c / #5c4113 / #2c2011 บนผิว #050403 / #100b05 / #1e150a เนื้อความ
// #ede0c4 ข้อความรอง #c0ab84 ป้ายมุมบนขวารับทองสว่างเพื่อให้ตัวหนังสือสีเข้มอ่านออก
// บนพื้นสว่าง (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของ
// เดิมได้จาก git history)
const providers = [
  {
    name: "PG Soft (Pocket Games Soft)",
    desc: "ค่ายระดับ A-List ที่ยิงสัญญาณลิขสิทธิ์แท้เข้าระบบโดยตรง ผ่านการทดสอบอัตราจ่ายทุกเกม กราฟิกสมูธคมชัดระดับ HD ลื่นไหลทุกการสปิน",
    tag: "ลิขสิทธิ์แท้ยิงตรง",
    img: img1,
  },
  { name: "Pragmatic Play", desc: "เกมสายฟีเจอร์แน่น ทั้งระบบสุ่มแจกตัวคูณทวีคูณ Multipliers และคอมโบแตกต่อเนื่อง Cascading มาครบในตัวเดียว", tag: "ฟีเจอร์มาครบ", img: img6 },
  { name: "Joker", desc: "คลังเกมที่คนไทยคุ้นมือ จ่ายเงินตรงตามมาตรฐานผู้พัฒนา ไม่มีการปรับลดเปอร์เซ็นต์ชนะระหว่างทาง", tag: "จ่ายตามสเปกโรงงาน", img: img4 },
  { name: "SlotXO", desc: "หมวดสล็อตแนวคลาสสิกไลน์จ่ายน้อยแต่แตกหนัก กดเข้าเล่นจากล็อบบี้เดียวผ่านกระเป๋าเงินเดียว ไม่ต้องโยกเงินข้ามค่าย", tag: "คลาสสิกแตกหนัก", img: img3 },
  { name: "JILI", desc: "เกมไซซ์กะทัดรัดที่เบทเริ่มต้นหลักบาทก็ลุ้นได้ สปินลื่นไม่กระตุก เหมาะกับการวางแผนเดินเงินยาวๆ", tag: "เบทเบาก็ลุ้นได้", img: img5 },
  { name: "SexySlot", desc: "เติมความหลากหลายให้คลังเกม สลับสไตล์การเล่นได้ทันทีในบัญชีเดียว จัดหมวดหมู่ชัดเจนค้นหาง่าย", tag: "สลับฟีลได้ทันที", img: img2 },
];
---

<section aria-label="ค่ายดังเกมแท้ระดับ A-List ที่ BLACKJACK789 ดึงสัญญาณเข้าระบบโดยตรง" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fdf1ce] via-[#f2cf70] to-[#b8862c] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายดังเกมแท้ระดับ A-List ที่ <span class="text-[#f2cf70]">BLACKJACK789</span> ดึงสัญญาณเข้าระบบโดยตรง
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#c0ab84]">
      ไม่ได้วัดกันที่จำนวนเกม แต่วัดกันที่คุณภาพของสัญญาณ ทุกค่ายในกริดนี้เป็นลิขสิทธิ์แท้ที่เชื่อมเข้าระบบโดยตรง ผ่านการทดสอบอัตราจ่ายก่อนลงคลัง จ่ายเงินตรงตามมาตรฐานผู้พัฒนา
      และเปิดให้สลับเล่นข้ามค่ายได้จากกระเป๋าเงินเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#d3aa4b] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#5c4113]/45 bg-[#050403]/92 p-5 pt-9 shadow-[0_10px_30px_rgba(92,65,19,0.3)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#f2cf70]/60 hover:bg-[#100b05]/95 hover:shadow-[0_15px_40px_rgba(211,170,75,0.32)]">
          <div class="pointer-events-none absolute inset-0 bg-[#050403]/55 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#f2cf70] to-[#d3aa4b] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#050403] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <Picture
            src={provider.img}
            alt={`โลโก้ค่ายเกม ${provider.name} บนการ์ดค่ายเกมลิขสิทธิ์แท้ในล็อบบี้ของ BLACKJACK789`}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            loading="lazy"
            fetchpriority="low"
            widths={[112, 224]}
            sizes="112px"
            decoding="async"
            quality={70}
            class="relative z-10 mb-3 block h-28 w-28 rounded-xl border border-[#5c4113]/55 object-cover transition-transform duration-500 group-hover:scale-110"
          />

          <p class="relative z-10 text-center text-sm font-black text-[#ede0c4] transition-colors group-hover:text-[#fdf1ce]">{provider.name}</p>
          <p class="relative z-10 mt-1 text-center text-[11px] leading-relaxed text-[#c0ab84]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#5c4113]/55 bg-[#050403] py-1.5 text-center text-[11px] font-bold text-[#f2cf70] shadow-inner transition-colors duration-300 group-hover:border-[#d3aa4b]/60 group-hover:bg-gradient-to-r group-hover:from-[#2c2011] group-hover:to-[#5c4113] group-hover:text-[#fdf1ce]">
            เข้าดูเกมทั้งหมดในค่ายนี้
          </span>
        </a>
      ))
    }
  </div>
</section>
