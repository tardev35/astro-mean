---
// Widget ไม่ใช่ article: หัวข้อ render เป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ห้ามเลื่อน <p> ขึ้นเป็น <h2> เพราะจำนวน h2 บนหน้าแรกถูก diff กับ
// checklist ของ docx และชื่อค่ายในการ์ดก็ห้ามเป็น <h3> ด้วยเหตุผลเดียวกัน
//
// เนื้อหาตาม brief ของ ASHTON168 — ล็อบบี้รวมเกมสล็อตตัวตึงกระแสแรงจากค่ายชั้นนำ
// ระดับโลกไว้ครบวงจร ทั้งค่ายสายภาพสวย 3D ค่ายสายแตกโหดตัวคูณเยอะ และค่ายยอดนิยม
// ตลอดกาล ทุกเกมคัดมาแล้วว่าจ่ายได้มาตรฐานยุติธรรม กริดนี้จึงเป็นภาพประกอบของหัวข้อ
// docx เรื่องค่ายชั้นนำมีอะไรน่าเล่นโดยตรง
//
// ASHTON168: ชุดสีเป็นทองสว่างคู่เงินโครเมียมบนดำอมน้ำตาลตามอาร์ตจริง — ทอง
// #f5c518 / #ffd75e / #ffe9a3 / #c8941a / #a87908 คู่เงิน #e2e5e9 / #f0f2f5
// (ใช้เป็นสีเน้นรองบนป้ายมุมการ์ดเท่านั้น) บนผิว #080502 / #160e03 / #2a1c06
// เนื้อความ #f0e6d2 หัวข้อ #fdf6e6 ข้อความรอง #c9bda2 (ห้ามพิมพ์ hex ของแบรนด์ก่อน
// ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาส
// จากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
const providers = [
  { name: "PG SOFT", desc: "ค่ายเกมสายภาพสวย 3D งานกราฟิกคมชัดเต็มประสิทธิภาพ เอฟเฟกต์เสียงตื่นเต้น", tag: "สายภาพสวย 3D", icon: "🎰" },
  { name: "JOKER", desc: "ค่ายเกมยอดนิยมตลอดกาล เกมตัวตึงกระแสแรงที่กดเลือกทำเงินได้ทันที", tag: "ยอดนิยมตลอดกาล", icon: "🃏" },
  { name: "JILI", desc: "ค่ายเกมสายแตกโหดตัวคูณเยอะ ลุ้นแจ็คพอตง่ายด้วยอัตราจ่ายที่ได้มาตรฐาน", tag: "ตัวคูณเยอะ", icon: "🐉" },
  { name: "Microgaming", desc: "เชื่อมต่อตรงเข้าเซิร์ฟเวอร์หลักของค่ายเกมยักษ์ใหญ่ระดับโลกโดยไม่ผ่านคนกลาง", tag: "เชื่อมตรงค่าย", icon: "🌐" },
  { name: "Pragmatic Play", desc: "ระบบพร้อมรันได้สมูธแม้ช่วงที่มีผู้เข้าใช้งานพร้อมกันจำนวนมาก ไม่ค้าง ไม่หลุด", tag: "รันลื่นไม่สะดุด", icon: "💥" },
  { name: "Habanero", desc: "เกมคัดมาแล้วว่ามีอัตราการจ่ายเงินรางวัลได้มาตรฐานยุติธรรม ลุ้นแจ็คพอตง่าย", tag: "จ่ายยุติธรรม", icon: "💠" },
  { name: "Red Tiger", desc: "อยู่ในหมวดเกมยอดฮิตที่จัดไว้ให้กดเจอไว ไม่ต้องไล่หาจากหลายเว็บให้เสียเวลา", tag: "หมวดเกมยอดฮิต", icon: "🔥" },
];
---

<section aria-label="ค่ายชั้นนำที่ ASHTON168 รวมตัวฮิตไว้ให้เลือกในล็อบบี้เดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fdf6e6] via-[#f5c518] to-[#c8941a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายชั้นนำที่ <span class="text-[#ffe9a3]">ASHTON168</span> รวมตัวฮิตไว้ให้เลือก
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5c518] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#c8941a]/40 bg-[#160e03]/92 p-5 shadow-[0_10px_30px_rgba(200,148,26,0.25)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#f5c518]/60 hover:bg-[#2a1c06]/95 hover:shadow-[0_15px_40px_rgba(245,197,24,0.38)]">
          <div class="pointer-events-none absolute inset-0 bg-[#7a5405]/55 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#f0f2f5] to-[#e2e5e9] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#080502] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f0e6d2] transition-colors group-hover:text-[#ffe9a3]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#c9bda2]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#c8941a]/50 bg-[#080502] py-1.5 text-center text-[11px] font-bold text-[#ffe9a3] shadow-inner transition-colors duration-300 group-hover:border-[#f5c518]/60 group-hover:bg-gradient-to-r group-hover:from-[#f5c518] group-hover:to-[#c8941a] group-hover:text-[#080502]">
            เข้าดูเกมทั้งหมด
          </span>
        </a>
      ))
    }
  </div>
</section>
