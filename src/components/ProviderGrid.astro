---
// Widget ไม่ใช่ article: หัวข้อ render เป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech เนื้อหาตาม brief ของ THUNDER87 — ขนรายชื่อค่ายเกมชั้นนำระดับโลก
// มาไว้ในที่เดียว ทั้งค่ายใหญ่ในกระแสและค่ายดังเฉพาะกลุ่ม คัดสรรมาอย่างพิถีพิถัน
// เพื่องานภาพคมชัดและอัตราการจ่ายที่สมน้ำสมเนื้อ พร้อมคาสิโนสดและบาคาร่าในล็อบบี้
// เดียวกัน สลับได้ในยูสเซอร์เดียว
//
// THUNDER87: ย้ายจากแดงสัญญาณของ FAST369 (#e40613 / #ff3b2f / #8f0206 คู่ทอง
// #ffe27a / #ffc531 / #a8720a บนผิว #170506 / #240709 / #0a0304 เนื้อความ
// #f4e7dd ข้อความรอง #cdb9b2) มาที่เหลืองสายฟ้าไฟฟ้าล้วน — #fff89a / #fae61c /
// #dcb309 / #ffd60a / #8a7405 บนผิว #17150a / #2b2606 / #080703 เนื้อความ
// #f0ead6 ข้อความรอง #c9c2a6
const providers = [
  { name: "PG Soft", desc: "สล็อตแนวแฟนตาซี งานภาพคมชัด ฟีเจอร์จัดเต็ม สปินต่อกันได้ลื่นไหลไม่มีกระตุก", tag: "ค่ายใหญ่ในกระแส", icon: "🎰" },
  { name: "Pragmatic Play", desc: "ตัวคูณสะสมกับโหมดฟรีสปินพร้อมทำงานทุกช่วงเวลา อัตราการจ่ายสมน้ำสมเนื้อ", tag: "จ่ายสมน้ำสมเนื้อ", icon: "⚡" },
  { name: "JILI", desc: "รอบสั้นจังหวะไว เข้าฟีเจอร์รัวๆ ตอบโจทย์สายสปินที่ชอบความตึงแบบไม่ต้องรอ", tag: "จังหวะสุดตึง", icon: "🔥" },
  { name: "Joker Gaming", desc: "ค่ายดังเฉพาะกลุ่มแนวคลาสสิกกดง่าย สลับมาเล่นได้ทันทีโดยไม่ต้องปรับตัวใหม่", tag: "ค่ายดังเฉพาะกลุ่ม", icon: "🃏" },
  { name: "Evolution โต๊ะสด", desc: "คาสิโนสดถ่ายทอดตรงจากสตูดิโอ ภาพคมชัดระดับ HD มีห้องให้เลือกเข้าเพียบ", tag: "คาสิโนสด", icon: "🎴" },
  { name: "บาคาร่าเต็มล็อบบี้", desc: "สลับอารมณ์จากการปั่นวงล้อไปลุ้นหน้าไพ่ได้ทันทีในยูสเซอร์เดียว ไม่ต้องโยกเงิน", tag: "ยูสเซอร์เดียว", icon: "♠️" },
  { name: "เล่นลื่นทุกอุปกรณ์", desc: "ไถจอมือถือหรือนั่งจอใหญ่ผ่านคอมพิวเตอร์ ระบบก็ยังแรงและเสถียรเท่ากันทุกเครื่อง", tag: "เสถียรทุกจอ", icon: "📱" },
];
---

<section aria-label="ค่ายเกมและโต๊ะสดที่ THUNDER87 ขนมาลงแน่นในล็อบบี้เดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fff89a] via-[#fae61c] to-[#dcb309] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมและโต๊ะสดที่ <span class="text-[#fae61c]">THUNDER87</span> ขนมาลงแน่นในล็อบบี้เดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fae61c] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#fae61c]/30 bg-[#17150a]/92 p-5 shadow-[0_10px_30px_rgba(250,230,28,0.2)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#fae61c]/60 hover:bg-[#2b2606]/95 hover:shadow-[0_15px_40px_rgba(250,230,28,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#8a7405]/45 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fff89a] via-[#fae61c] to-[#8a7405] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#080703] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f0ead6] transition-colors group-hover:text-[#fae61c]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#c9c2a6]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#fae61c]/30 bg-[#080703] py-1.5 text-center text-[11px] font-bold text-[#fae61c] shadow-inner transition-colors duration-300 group-hover:border-[#fff89a]/60 group-hover:bg-gradient-to-r group-hover:from-[#fff89a] group-hover:via-[#fae61c] group-hover:to-[#8a7405] group-hover:text-[#080703]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
