---
// Widget, not article: the title renders as <p> and the <section> carries the
// accessible name. The copy follows BUFFXBET's brief — รวมเกมฮิตจากค่ายดัง,
// เลือกเล่นสนุกได้หลากหลายไม่มีเบื่อ, ภาพคมชัดระดับไฮเอนด์.
const providers = [
  { name: "PG Soft", desc: "สล็อตแนวแฟนตาซี ภาพคมชัดระดับไฮเอนด์ ฟีเจอร์แน่น เป็นค่ายที่สายปั่นเลือกบ่อยที่สุด", tag: "ค่ายหลัก", icon: "🎰" },
  { name: "Pragmatic Play", desc: "โบนัสตัวคูณและฟรีสปินมาบ่อย ลุ้นกำไรพุ่งกระฉูดได้ไม่อั้น", tag: "โบนัสเน้น", icon: "🎁" },
  { name: "JILI", desc: "จังหวะไว รอบสั้น เข้าฟีเจอร์รัวๆ เหมาะกับคนชอบปั่นต่อเนื่อง", tag: "รอบไว", icon: "⚡" },
  { name: "Joker Gaming", desc: "สไตล์คลาสสิกกดง่าย เล่นเพลินจนลืมเวลา สลับกี่เกมก็ยังสนุกเหมือนเดิม", tag: "เล่นง่าย", icon: "🃏" },
  { name: "Relax Gaming", desc: "แนวแอคชั่นที่คัดมาแล้วเน้นๆ ลุ้นมันส์ทุกจังหวะ ไม่มีเบื่อแน่นอน", tag: "สายแอคชั่น", icon: "🔥" },
  { name: "ค่ายดัง เว็บตรงทุกเกม", desc: "ดึงสัญญาณตรงจากผู้พัฒนา ไม่ผ่านคนกลาง เหมาค่ายท็อปฮิตมารวมไว้ที่เดียวจบ", tag: "เว็บตรง 100%", icon: "🛡️" },
  { name: "เล่นลื่นทุกอุปกรณ์", desc: "มือถือรุ่นไหนหรือคอมพิวเตอร์ก็รองรับ ระบบออโต้ลื่นไม่มีค้างหรือหน่วง", tag: "ไม่สะดุด", icon: "📱" },
];
---

<section aria-label="ค่ายเกมสล็อตที่ BUFFXBET รวมไว้ครบทุกแนว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#7cc0ff] via-[#3b8df1] to-[#f5c542] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมสล็อตที่ <span class="text-[#f5c542]">BUFFXBET</span> รวมไว้ครบทุกแนว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#3b8df1] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#3b8df1]/25 bg-[#0a1330]/92 p-5 shadow-[0_10px_30px_rgba(59,141,241,0.18)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#3b8df1]/55 hover:bg-[#0a2563]/95 hover:shadow-[0_15px_40px_rgba(245,197,66,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#3b8df1]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fbe57d] via-[#f5c542] to-[#3b8df1] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#02061a] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#dbe7fb] transition-colors group-hover:text-[#f5c542]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#a8bcd8]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#3b8df1]/30 bg-[#050b1e] py-1.5 text-center text-[11px] font-bold text-[#3b8df1] shadow-inner transition-colors duration-300 group-hover:border-[#f5c542]/60 group-hover:bg-gradient-to-r group-hover:from-[#fbe57d] group-hover:via-[#f5c542] group-hover:to-[#3b8df1] group-hover:text-[#02061a]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
