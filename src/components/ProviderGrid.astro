---
// Widget ไม่ใช่ article: หัวข้อ render เป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech เนื้อหาตาม brief ของ DEKDDD — สล็อตสายเอ็นจอย เกมฮิตติดล็อบบี้
// พร้อมตัวใหม่สลับมาให้ลองแบบไม่จำเจ ระบบตอบสนองไวสลับเกมได้สมูธไร้รอยต่อ และ
// ฟีเจอร์เด่นทั้งตัวคูณรางวัลกับฟรีสปินที่ออกบ่อย
//
// DEKDDD: ย้ายจากชุดสีของแบรนด์ก่อนหน้ามาที่ทองคู่แดง — ทอง #ffe08a / #eebb1a /
// #a3760a คู่แดง #e01f26 / #a80d10 / #5c0201 บนผิว #2a0806 / #1a0503 / #0b0100
// เนื้อความ #f7e7c8 หมึกบนปุ่มทอง #1a0503 (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ —
// Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มี
// ใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// ป้ายมุมการ์ดใช้ไล่สีทองล้วนกับหมึกเข้ม เพราะทองอ่อนบนทองเข้มอ่านไม่ออก
const providers = [
  { name: "PG Slot", desc: "ตัวเต็งที่ติดล็อบบี้ตลอด สายเอ็นจอยกดเข้าเล่นได้เลยไม่ต้องสลับเว็บ", tag: "ฮิตติดล็อบบี้", icon: "🎰" },
  { name: "Pragmatic Play", desc: "เกมฮิตระดับโลก ฟีเจอร์จัดเต็มทั้งฟรีสปินที่ออกบ่อยและตัวคูณรางวัลสุดพิเศษ", tag: "ฟีเจอร์เด่น", icon: "✨" },
  { name: "Nolimit City", desc: "สายลุ้นหนัก สัญลักษณ์พิเศษเยอะ พลิกจังหวะได้ในสปินเดียวแบบไม่ต้องรอนาน", tag: "ลุ้นทุกสปิน", icon: "⚡" },
  { name: "Play'n GO", desc: "ธีมแฟนตาซีภาพสวย เกมลิขสิทธิ์แท้จากค่ายชั้นนำ กติกาตรงไปตรงมาอ่านง่าย", tag: "ภาพสวยจัด", icon: "🐉" },
  { name: "JILI", desc: "เกมสไตล์เอเชียที่รอบสั้นตัดสินไว เหมาะกับคนที่ชอบปั่นชิลๆ แบบไม่ต้องเครียด", tag: "ปั่นชิลได้", icon: "🏮" },
  { name: "Relax Gaming", desc: "ตัวใหม่สลับเข้ามาให้ลองเรื่อยๆ เปลี่ยนบรรยากาศได้ทั้งวันโดยระบบไม่มีสะดุด", tag: "ตัวใหม่ตลอด", icon: "🎧" },
  { name: "Habanero", desc: "แนวคลาสสิกธีมหลากหลาย อยากเปลี่ยนฟีลเมื่อไหร่ก็คลิกเลือกเกมใหม่ได้ทันที", tag: "เปลี่ยนฟีลไว", icon: "🎨" },
];
---

<section aria-label="ค่ายเกมสล็อตที่ DEKDDD คัดมาไว้ในล็อบบี้เดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fff6dd] via-[#eebb1a] to-[#e01f26] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมสล็อตที่ <span class="text-[#eebb1a]">DEKDDD</span> คัดมาไว้ในล็อบบี้เดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#eebb1a] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#eebb1a]/30 bg-[#1a0503]/92 p-5 shadow-[0_10px_30px_rgba(238,187,26,0.2)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#eebb1a]/60 hover:bg-[#2a0806]/95 hover:shadow-[0_15px_40px_rgba(168,13,16,0.35)]">
          <div class="pointer-events-none absolute inset-0 bg-[#a80d10]/30 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffe08a] to-[#eebb1a] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#1a0503] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f7e7c8] transition-colors group-hover:text-[#eebb1a]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#f7e7c8]/75">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#eebb1a]/30 bg-[#0b0100] py-1.5 text-center text-[11px] font-bold text-[#eebb1a] shadow-inner transition-colors duration-300 group-hover:border-[#ffe08a]/60 group-hover:bg-gradient-to-r group-hover:from-[#ffe08a] group-hover:to-[#eebb1a] group-hover:text-[#1a0503]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
