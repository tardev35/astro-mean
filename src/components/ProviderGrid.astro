---
// Widget, not article: the title renders as <p> and the <section> carries the
// accessible name. The copy follows PODK888's brief — เว็บตรงเกมครบทุกสาย,
// ค่ายแท้คัดเกมเด่น, ระบบใหม่โอนไว.
const providers = [
  { name: "PG Soft", desc: "สล็อตฟีเจอร์แน่น กราฟิกคมชัด โหลดไว เป็นค่ายที่สายปั่นเลือกบ่อยที่สุด", tag: "ค่ายหลัก", icon: "🎰" },
  { name: "Pragmatic Play", desc: "เกมใหม่มาแรง ฟรีสปินตัวคูณสูง รองรับทั้งไม้เล็กและไม้ใหญ่", tag: "ยอดฮิต", icon: "🔥" },
  { name: "JILI", desc: "สล็อตจังหวะไว รอบสั้น เข้าฟีเจอร์รัวๆ เหมาะกับคนชอบปั่นต่อเนื่อง", tag: "รอบไว", icon: "🐾" },
  { name: "Evolution", desc: "คาสิโนสดจากสตูดิโอจริง ภาพสวย ดีลเลอร์แจ่ม เดินรอบแบบเรียลไทม์", tag: "ไลฟ์สด", icon: "🎴" },
  { name: "บาคาร่าและเกมโต๊ะ", desc: "จัดหมวดหมู่เกมเด่นไว้ให้เลือกง่าย ไม่ต้องงมหาเอง เข้าปุ๊บพร้อมลั่นทันที", tag: "เลือกง่าย", icon: "🃏" },
  { name: "ค่ายแท้ เว็บตรงทุกเกม", desc: "ดึงสัญญาณตรงจากผู้พัฒนา ไม่ผ่านคนกลาง ไม่มีประวัติโกงหรือบิดยอด", tag: "เว็บตรง 100%", icon: "⚡" },
  { name: "เล่นลื่นทุกอุปกรณ์", desc: "ภาพคมชัดไม่มีสะดุด สลับจากสล็อตไปลุ้นไพ่ได้เลย ไม่ต้องสลับเว็บ", tag: "ไม่สะดุด", icon: "📱" },
];
---

<section aria-label="ค่ายเกมและคาสิโนสดที่ PODK888 รวมไว้ในแพลตฟอร์มเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#02dbfd] via-[#f670b7] to-[#e01e83] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมและคาสิโนสดที่ <span class="text-[#02dbfd]">PODK888</span> รวมไว้ในแพลตฟอร์มเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f670b7] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#f670b7]/25 bg-[#1a0a1f]/92 p-5 shadow-[0_10px_30px_rgba(246,112,183,0.18)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#f670b7]/55 hover:bg-[#2a0f2e]/95 hover:shadow-[0_15px_40px_rgba(2,219,253,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#f670b7]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#02dbfd] via-[#f670b7] to-[#f670b7] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#12060f] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f3d7e7] transition-colors group-hover:text-[#02dbfd]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#d9a8c6]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#f670b7]/30 bg-[#12060f] py-1.5 text-center text-[11px] font-bold text-[#f670b7] shadow-inner transition-colors duration-300 group-hover:border-[#02dbfd]/60 group-hover:bg-gradient-to-r group-hover:from-[#02dbfd] group-hover:via-[#f670b7] group-hover:to-[#f670b7] group-hover:text-[#12060f]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
