---
// Widget, not article: the title renders as <p> and the <section> carries the
// accessible name. The copy follows FLASH789's brief — สล็อตเว็บตรงมาแรง,
// เกมดีทุกตาจากค่ายดังครบทุกแนว, อัปเดตเกมใหม่ต่อเนื่อง.
const providers = [
  { name: "PG Soft", desc: "สล็อตภาพสวยฟีลผจญภัย ฟีเจอร์แน่น โหลดไว เป็นค่ายที่สายปั่นเลือกบ่อยที่สุด", tag: "ค่ายหลัก", icon: "🎰" },
  { name: "Pragmatic Play", desc: "เกมใหม่มาแรง ฟรีสปินตัวคูณสูง สายซื้อฟรีสปินต้องลอง", tag: "ยอดฮิต", icon: "🔥" },
  { name: "JILI", desc: "จังหวะไว รอบสั้น เข้าฟีเจอร์รัวๆ เหมาะกับคนชอบปั่นต่อเนื่อง", tag: "รอบไว", icon: "⚡" },
  { name: "Joker Gaming", desc: "สายมินิมอลกดง่าย เล่นเพลิน เกมคลาสสิกที่แตกง่ายลุ้นสนุกได้ทุกตา", tag: "เล่นง่าย", icon: "🃏" },
  { name: "Relax Gaming", desc: "เกมแนวใหม่ที่อัปเดตเข้ามาต่อเนื่อง มีอะไรกำลังเป็นกระแสได้เล่นก่อนใคร", tag: "ของใหม่มาไว", icon: "🆕" },
  { name: "ค่ายดัง เว็บตรงทุกเกม", desc: "ดึงสัญญาณตรงจากผู้พัฒนา ไม่ผ่านคนกลาง คัดมาเน้นๆ แต่เกมคุณภาพ", tag: "เว็บตรง 100%", icon: "🛡️" },
  { name: "เล่นลื่นทุกอุปกรณ์", desc: "มือถือรุ่นไหนหรือคอมพิวเตอร์ก็รองรับหมด ไวทุกคลิกไม่มีสะดุด", tag: "ไม่สะดุด", icon: "📱" },
];
---

<section aria-label="ค่ายเกมสล็อตที่ FLASH789 รวมไว้ครบทุกแนว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffc531] via-[#ff2b2b] to-[#c1121f] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมสล็อตที่ <span class="text-[#ffc531]">FLASH789</span> รวมไว้ครบทุกแนว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ff2b2b] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#ff2b2b]/25 bg-[#170506]/92 p-5 shadow-[0_10px_30px_rgba(255,43,43,0.18)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#ff2b2b]/55 hover:bg-[#2a0806]/95 hover:shadow-[0_15px_40px_rgba(255,197,49,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#ff2b2b]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffc531] via-[#ff2b2b] to-[#c1121f] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#170506] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f7ddd8] transition-colors group-hover:text-[#ffc531]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#e0b9b3]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#ff2b2b]/30 bg-[#0b0203] py-1.5 text-center text-[11px] font-bold text-[#ff2b2b] shadow-inner transition-colors duration-300 group-hover:border-[#ffc531]/60 group-hover:bg-gradient-to-r group-hover:from-[#ffc531] group-hover:via-[#ff2b2b] group-hover:to-[#c1121f] group-hover:text-[#170506]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
