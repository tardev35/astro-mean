---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

const gameCategories = ["สล็อตออนไลน์ (Slot)", "ซื้อฟรีสปิน (Buy Feature)", "สล็อตผลไม้คลาสสิก (Classic)", "เกมแจ็กพอต (Jackpot)", "เกมมาใหม่ (New Release)"];
---

<footer class="relative w-full overflow-hidden border-t-[3px] border-[#f1d42c] bg-[#062a52] pt-16 pb-8 font-sans text-[#f0f9ff] shadow-[0_-10px_30px_rgba(10,93,241,0.28)]">
  <div class="pointer-events-none absolute top-0 right-0 h-96 w-96 rounded-full bg-[#01cbf6]/20 blur-[100px]"></div>
  <div class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[#0a5df1]/40 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ 9UFA เลข 9 สีทองสวมมงกุฎ ต่อด้วยตัวอักษร UFA.com ไล่สีน้ำเงินไปฟ้า"
                class="h-[50px] w-auto drop-shadow-[0_0_15px_rgba(1,203,246,0.5)]"
                widths={[120, 150]}
                sizes="150px"
                loading="lazy"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-b from-[#ffe98a] to-[#f1d42c] bg-clip-text text-4xl font-black text-transparent drop-shadow-[0_0_10px_rgba(241,212,44,0.45)]">9UFA</span>
            )
          }
        </a>
        <p class="text-base leading-relaxed text-[#c9e6fb]">
          9UFA เว็บสล็อตยอดนิยม รวมค่ายเกมชั้นนำที่ต่อตรงผ่าน API ลิขสิทธิ์แท้ไม่ผ่านคนกลาง สมัครสมาชิกใหม่รับทุนเล่นฟรี 199 บาททันที ไม่ต้องแชร์ ไม่ต้องทำเทิร์นสูง
          พร้อมระบบฝากถอนออโต้ที่รองรับ PromptPay TrueMoney Wallet และธนาคารไทยหลายแห่ง ตลอด 24 ชั่วโมง
        </p>
        <div class="mt-2 flex items-center gap-3">
          <div class="flex items-center gap-1.5 rounded border border-[#f1d42c]/50 bg-[#f1d42c]/15 px-3 py-1.5 text-xs font-bold text-[#ffe98a] shadow-[0_0_10px_rgba(241,212,44,0.25)]">
            <span aria-hidden="true" class="text-base">🛡️</span> SSL/TLS 256-BIT
          </div>
          <div class="flex items-center gap-1.5 rounded border border-[#01cbf6]/60 bg-[#0a5df1]/40 px-3 py-1.5 text-xs font-bold text-[#c9e6fb]">
            <span aria-hidden="true" class="text-base">⚡</span> AUTO 24H
          </div>
        </div>
      </div>

      <nav aria-label="เมนูหลัก" class="flex flex-col gap-4 lg:pl-8">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffe98a]">
          <span class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#ffe98a] to-[#f1d42c]"></span> เมนูหลัก
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.path} class="group flex items-center text-[#c9e6fb] transition-all hover:text-[#ffe98a]">
                  <span aria-hidden="true" class="mr-2 -ml-4 text-[#01cbf6] opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">
                    ➤
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="หมวดหมู่เกม" class="flex flex-col gap-4">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffe98a]">
          <span class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#ffe98a] to-[#f1d42c]"></span> หมวดหมู่เกม
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            gameCategories.map((game) => (
              <li>
                <a href="/register" class="group flex items-center text-[#c9e6fb] transition-all hover:text-[#ffe98a]">
                  <span class="mr-3 h-1.5 w-1.5 rounded-full bg-[#01cbf6] transition-colors group-hover:bg-[#f1d42c] group-hover:shadow-[0_0_8px_rgba(241,212,44,0.85)]" />
                  {game}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffe98a]">
          <span class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#ffe98a] to-[#f1d42c]"></span> บริการลูกค้า
        </p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#00B900] py-3 font-bold text-white shadow-[0_0_15px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
          <span class="text-xl font-black">LINE</span> @9UFA
        </a>

        <div class="mt-2">
          <p class="mb-3 text-xs font-bold tracking-wider text-[#01cbf6] uppercase">รองรับทุกธนาคาร & True Wallet</p>
          <BankStrip size={26} />
        </div>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap justify-center gap-4 border-y border-[#f1d42c]/25 py-6 opacity-60 grayscale transition-all duration-500 hover:opacity-100 hover:grayscale-0 md:gap-8">
      <span class="text-lg font-black text-[#c9e6fb] italic md:text-2xl">PG<span class="text-[#f1d42c]">SOFT</span></span>
      <span class="text-lg font-black text-[#c9e6fb] italic md:text-2xl">PRAGMATIC<span class="text-[#f1d42c]">PLAY</span></span>
      <span class="text-lg font-black text-[#c9e6fb] italic md:text-2xl">EVO<span class="text-[#f1d42c]">LUTION</span></span>
      <span class="text-lg font-black text-[#c9e6fb] italic md:text-2xl">JILI<span class="text-[#f1d42c]">GAMES</span></span>
      <span class="text-lg font-black text-[#c9e6fb] italic md:text-2xl">MICRO<span class="text-[#f1d42c]">GAMING</span></span>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 text-xs text-[#9fc6e8] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold text-[#ffe98a]">9UFA</span>. All rights reserved. เว็บสล็อตยอดนิยม เครดิตฟรี 199 ฝากถอนออโต้</p>
      <div class="flex gap-4">
        <a href="/terms/" class="transition-colors hover:text-[#ffe98a]">เงื่อนไขการให้บริการ</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffe98a]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
