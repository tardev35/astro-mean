---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt =
  "โลโก้ PAY69 เป็นตัวอักษร PAY สีทองแชมเปญวางอยู่ในกรอบสี่เหลี่ยมมนสีดำสามช่อง ต่อท้ายด้วยวงกลมสีดำที่มีเลข 69 สีทองไขว้ซ้อนกันอยู่ข้างใน";

const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

const gameCategories = ["บาคาร่าคลาสสิก (Baccarat)", "บาคาร่าสายฟ้า (Lightning)", "รูเล็ตออนไลน์ (Roulette)", "เสือมังกร (Dragon Tiger)", "ไฮโลและเกมโชว์สด (Game Show)"];

// PAY69: ย้ายจากทองคู่เงินโครเมียมของแบรนด์ก่อน มาเป็นทองแชมเปญเดี่ยวบนดำสนิท
// ไม่มีสีคู่ — ทอง #e8c37a / #f7dfa5 / #fdf4e0 / #a87c2e / #6b4d15 บนผิว
// #08070a / #12100c / #1c1811 เนื้อความ #e6dac2 รอง #a99a7d
// (palette.json: vivid ของโลโก้เป็นทองแชมเปญ #ecdbb4 / #f2dcbb / #e5cca5)
//
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// บล็อก <address> ด้านล่างจงใจไม่มีสีของแบรนด์เลย (border-white/15 + bg-black/20
// + opacity) เพราะ footer ทุก variant ในคลังเป็นพื้นเข้มหมด ห้าม retheme
---

<footer class="relative w-full overflow-hidden border-t-[3px] border-[#a87c2e] bg-[#08070a] pt-16 pb-8 font-sans text-[#e6dac2] shadow-[0_-10px_30px_rgba(232,195,122,0.28)]">
  <div class="pointer-events-none absolute top-0 right-0 h-96 w-96 rounded-full bg-[#e8c37a]/15 blur-[100px]"></div>
  <div class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[#6b4d15]/45 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                class="h-[50px] w-auto drop-shadow-[0_0_15px_rgba(232,195,122,0.5)]"
                widths={[120, 150]}
                sizes="150px"
                loading="lazy"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-b from-[#f7dfa5] to-[#6b4d15] bg-clip-text text-4xl font-black text-transparent drop-shadow-[0_0_10px_rgba(232,195,122,0.45)]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="text-base leading-relaxed text-[#e6dac2]/70">
          {BRAND_NAME} คาสิโนสดเว็บตรง API แท้ ยิงสัญญาณสดระดับ Ultra HD ตรงจากฟลอร์คาสิโนจริงในต่างประเทศ ไม่ผ่านเอเย่นต์ รวมโต๊ะสดค่ายดังระดับพรีเมียมไว้ครบทั้งบาคาร่า รูเล็ต เสือมังกร
          และไฮโล เลือกห้องเล่นได้ตามงบเบท พร้อมกระเป๋าเงินเดียวที่สลับเกมได้อิสระและระบบฝากถอนออโต้
        </p>
        <div class="mt-2 flex items-center gap-3">
          <div class="flex items-center gap-1.5 rounded border border-[#a87c2e]/50 bg-[#e8c37a]/12 px-3 py-1.5 text-xs font-bold text-[#f7dfa5] shadow-[0_0_10px_rgba(232,195,122,0.25)]">
            <span aria-hidden="true" class="text-base">🛡️</span> SSL/TLS 256-BIT
          </div>
          <div class="flex items-center gap-1.5 rounded border border-[#1c1811] bg-[#12100c] px-3 py-1.5 text-xs font-bold text-[#e8c37a]">
            <span aria-hidden="true" class="text-base">⚡</span> AUTO 24H
          </div>
        </div>
      </div>

      <nav aria-label="เมนูหลัก" class="flex flex-col gap-4 lg:pl-8">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#f7dfa5]">
          <span class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#f7dfa5] to-[#6b4d15]"></span> เมนูหลัก
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.path} class="group flex items-center text-[#e6dac2]/70 transition-all hover:text-[#f7dfa5]">
                  <span aria-hidden="true" class="mr-2 -ml-4 text-[#a87c2e] opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">
                    ➤
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="หมวดหมู่เกม" class="flex flex-col gap-4">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#f7dfa5]">
          <span class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#f7dfa5] to-[#6b4d15]"></span> หมวดหมู่เกม
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            gameCategories.map((game) => (
              <li>
                <a href="/register" class="group flex items-center text-[#e6dac2]/70 transition-all hover:text-[#f7dfa5]">
                  <span class="mr-3 h-1.5 w-1.5 rounded-full bg-[#6b4d15] transition-colors group-hover:bg-[#e8c37a] group-hover:shadow-[0_0_8px_rgba(232,195,122,0.85)]" />
                  {game}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#f7dfa5]">
          <span class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#f7dfa5] to-[#6b4d15]"></span> บริการลูกค้า
        </p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#00B900] py-3 font-bold text-white shadow-[0_0_15px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
          <span class="text-xl font-black">LINE</span> OFFICIAL
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2">
          <p class="mb-3 text-xs font-bold tracking-wider text-[#e8c37a] uppercase">รองรับทุกธนาคาร & True Wallet</p>
          <BankStrip size={26} />
        </div>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap justify-center gap-4 border-y border-[#a87c2e]/25 py-6 opacity-60 grayscale transition-all duration-500 hover:opacity-100 hover:grayscale-0 md:gap-8">
      <span class="text-lg font-black text-[#e6dac2]/70 italic md:text-2xl">EVOLUTION<span class="text-[#e8c37a]">GAMING</span></span>
      <span class="text-lg font-black text-[#e6dac2]/70 italic md:text-2xl">SA<span class="text-[#e8c37a]">GAMING</span></span>
      <span class="text-lg font-black text-[#e6dac2]/70 italic md:text-2xl">SEXY<span class="text-[#e8c37a]">BACCARAT</span></span>
      <span class="text-lg font-black text-[#e6dac2]/70 italic md:text-2xl">PRAGMATIC<span class="text-[#e8c37a]">PLAY LIVE</span></span>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 text-xs text-[#e6dac2]/70 md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold text-[#f7dfa5]">{BRAND_NAME}</span>. All rights reserved. คาสิโนฟลอร์ใหญ่ โต๊ะสดค่ายดัง เว็บใหญ่ทุนหนาพร้อมเปย์</p>
      <div class="flex gap-4">
        <a href="/terms/" class="transition-colors hover:text-[#f7dfa5]">เงื่อนไขการให้บริการ</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f7dfa5]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
