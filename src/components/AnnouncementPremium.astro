---
// ห้ามขึ้นต้น message ด้วย emoji — marquee นี้ render ข้อความซ้ำสองรอบ (ไม่มีรอยต่อ)
// emoji ที่ฝังในข้อความจะถูกอ่านออกเสียงซ้ำและ mark aria-hidden ไม่ได้
// badge ด้านซ้ายมีไอคอนของมันเองอยู่แล้ว
//
// default ต้องเป็นคำโฆษณาของแบรนด์ปัจจุบันเสมอ — หน้าย่อยเรียก <Announcement />
// เปล่าๆ ไม่ส่ง prop จึงตกมาใช้บรรทัดนี้ ถ้าปล่อยเป็นของแบรนด์ก่อนหน้าจะหลุด
// ขึ้นทุกหน้าย่อยโดยที่หน้าแรกดูปกติดี — ข้อความชุดนี้ตรงกับที่ index.astro
// ส่งเข้ามาเป๊ะ ticker ทั้งเว็บจึงวิ่งข้อความเดียวกัน
//
// TITANWIN168: ย้ายจากทองหลอมคู่ส้มไฟของแบรนด์ก่อน มาเป็นม่วงไททันคู่มงกุฎทอง
// ของแบรนด์นี้ — ม่วง #a855f7 / #c084fc / #ede4ff / #7c3aed คู่ทอง #e3c176 /
// #f2dda3 บนผิว #160a2b เนื้อความ #ddd2f5
const {
  message = "TITANWIN168 สล็อตรวมทัพเกมดัง เกมคัดเกรด ระบบออโต้ทันใจไว 3 วิ • เว็บตรง API แท้ ยิงสัญญาณตรงจากเซิร์ฟเวอร์หลัก ไม่ผ่านเอเย่นต์ คัดสรรเกมสล็อตแตกง่าย อัตราจ่าย RTP ยุติธรรมตรงตามสเปกโรงงาน ไร้ประวัติการล็อกยูส ถอนเงินออกได้เต็มจำนวนทุกยอด • รวบรวมคลังเกมคัดเกรดคุณภาพสูงไว้ครบครัน ไม่เอาเกมระบบล้าหลังหรืออัตราจ่ายต่ำมาเปิดให้บริการ ทุกเกมสปินสนุก กราฟิกคมชัด จ่ายรางวัลตามอัลกอริทึมมาตรฐานสากล • ยกทัพค่ายเกมยักษ์ใหญ่ระดับโลกมาประชันแบบจัดเต็ม ทั้ง PG Soft Pragmatic Play Joker Gaming และค่ายชั้นนำอีกมากมาย ครบทุกสไตล์ทั้งสล็อตภาพสวย 3D และสตรีตสไตล์เน้นคูณหนัก สลับเล่นอิสระกระเป๋าเดียวไม่ต้องโยกเงิน • อัปเดตโปรโมชั่นใหม่พร้อมชนทุกช่วงเวลา ทั้งโบนัสต้อนรับสมาชิกใหม่ โปรฝากแรกของวัน และสิทธิ์รับเครดิตคืนยอดเสีย Cash Back เงื่อนไขโปร่งใส ไม่ติดเทิร์นโอเวอร์มหาโหด กดรับเองได้ทันที • คัดเฉพาะเกมตัวเด่นที่มีทรงโบนัสแตกดี จังหวะเข้ารอบฟรีสปินไว โครงสร้างการแจกรางวัลน่าสนใจ ให้ลุ้นกำไรก้อนโตแบบมีทิศทาง • ฟีเจอร์ครบมือทั้ง Multipliers ตัวคูณสะสมทวีคูณ ระบบ Cascading สัญลักษณ์แตกต่อเนื่อง รีลขยาย Wild ซ้อนทับ และโหมด Buy Feature ซื้อฟรีสปิน • ระบบการเงินฝากถอนออโต้ทันใจไว 3 วิ ประมวลผลผ่าน Gateway ตรง ฝากเงินปุ๊บยอดเข้าเกมปั๊บ ไม่ต้องส่งสลิป ไม่ต้องรอคิวอนุมัติ ถอนกำไรเด้งเข้าบัญชีธนาคารหรือวอลเล็ททันที",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#a855f7]/40 bg-[#160a2b]/90 shadow-[0_8px_20px_rgba(168,85,247,0.22)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(227,193,118,0.35)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#3b0d73] via-[#a855f7] to-[#ede4ff] px-8 py-2.5 font-black text-[#07030f] shadow-[4px_0_15px_rgba(168,85,247,0.35)]">
      <span aria-hidden="true" class="mr-2 text-lg">👑</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#160a2b] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#ddd2f5]">
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#e3c176] shadow-[0_0_8px_rgba(227,193,118,0.8)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#e3c176] shadow-[0_0_8px_rgba(227,193,118,0.8)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
