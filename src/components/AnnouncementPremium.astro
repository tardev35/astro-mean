---
// ห้ามขึ้นต้น message ด้วย emoji — marquee นี้ render ข้อความซ้ำสองรอบ (ไม่มีรอยต่อ)
// emoji ที่ฝังในข้อความจะถูกอ่านออกเสียงซ้ำและ mark aria-hidden ไม่ได้
// badge ด้านซ้ายมีไอคอนของมันเองอยู่แล้ว
//
// default ต้องเป็นคำโฆษณาของแบรนด์ปัจจุบันเสมอ — หน้าย่อยเรียก <Announcement />
// เปล่าๆ ไม่ส่ง prop จึงตกมาใช้บรรทัดนี้ ถ้าปล่อยเป็นของแบรนด์ก่อนหน้าจะหลุด
// ขึ้นทุกหน้าย่อยโดยที่หน้าแรกดูปกติดี — ข้อความชุดนี้ตรงกับที่ index.astro
// ส่งเข้ามาเป๊ะ ticker ทั้งเว็บจึงวิ่งข้อความเดียวกัน
//
// JAICHUA: ย้ายจากทองราชสำนักบนดำสนิทของแบรนด์ก่อนที่เคยใช้ไฟล์นี้ มาเป็นทองคำ
// คู่น้ำเงินรอยัลบนกรมท่าเกือบดำ — ทอง #fbeec9 / #f6d67e / #d8a83f / #a97722 /
// #6d4a12 คู่น้ำเงิน #2f5fb0 บนผิว #040915 / #0a1226 เนื้อความ #dce6f8
const {
  message = "JAICHUA สล็อตจ่ายชัวร์ไม่ต้องเดา เกมดังเข้าฟีล ออโต้ไวไม่เสียจังหวะ • เว็บตรง API แท้ ยิงตรงจากคลังเกมหลัก ไม่ผ่านเอเย่นต์ ค่า RTP ตรงตามสเปกโรงงาน ชนะเท่าไหร่ถอนได้เท่านั้น ไม่มีหมกเม็ด ไม่ล็อกยูส • วางโครงสร้างระบบหลังบ้านให้เสถียรระดับสูงสุด ประมวลผลแม่นยำ ไร้ปัญหาเกมค้างหรือสลีปหลุด ทุกยอดชนะคำนวณเงินให้แบบเรียลไทม์ • ขนทัพค่ายเกมชั้นนำระดับโลกมาครบครัน ทั้ง PG Soft, Pragmatic Play และ Joker Gaming ครบทั้งสล็อตวิดีโอ 3D สล็อตตัวคูณสะสมโหด และสายซื้อฟีเจอร์ฟรีสปิน สลับเล่นได้ผ่านกระเป๋าเดียว • อัปเดตรายชื่อเกมใหม่เข้าคลังต่อเนื่องทันทีที่ค่ายผู้พัฒนาปล่อยตัวเกมออกมา คัดเฉพาะตัวเด็ดแตกง่ายมาเติมคลังให้ค้นหาต่อได้ไม่รู้จบ • ลูกเล่นแจกโบนัสอัดแน่นทุกเกม ทั้งระบบสุ่มแจกตัวคูณ Multiplier สัญลักษณ์ Expanding Wild ขยายเต็มจอ และคอมโบแตกต่อเนื่อง Cascading • โปรมีของให้กดรับเองผ่านหน้าแดชบอร์ด ทั้งโบนัสต้อนรับสมาชิกใหม่ โปรเติมเงินฝากแรกของวัน และสิทธิ์คืนยอดเสีย Cash Back ทุกวัน เงื่อนไขโปร่งใส ไม่ติดเทิร์นโอเวอร์มหาโหด • ฝาก-ถอนผ่าน Gateway ตรง รองรับทั้งธนาคารและ TrueMoney Wallet ทำรายการเสร็จใน 3 วินาที ไม่ต้องส่งสลิป ไม่ต้องผ่านแอดมิน",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#d8a83f]/40 bg-[#040915]/90 shadow-[0_8px_20px_rgba(216,168,63,0.2)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(246,214,126,0.35)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#6d4a12] via-[#a97722] to-[#f6d67e] px-8 py-2.5 font-black text-[#040915] shadow-[4px_0_15px_rgba(169,119,34,0.4)]">
      <span aria-hidden="true" class="mr-2 text-lg">🪙</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#040915] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#dce6f8]">
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#d8a83f] shadow-[0_0_8px_rgba(216,168,63,0.8)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#d8a83f] shadow-[0_0_8px_rgba(216,168,63,0.8)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
