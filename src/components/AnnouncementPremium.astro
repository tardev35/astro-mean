---
// ห้ามขึ้นต้น message ด้วย emoji — marquee นี้ render ข้อความซ้ำสองรอบ (ไม่มีรอยต่อ)
// emoji ที่ฝังในข้อความจะถูกอ่านออกเสียงซ้ำและ mark aria-hidden ไม่ได้
// badge ด้านซ้ายมีไอคอนของมันเองอยู่แล้ว
const {
  message = "9UFA เว็บสล็อตยอดนิยม รวมค่ายเกมลิขสิทธิ์แท้ต่อตรง API ไม่ผ่านคนกลาง • สมัครสมาชิกใหม่รับทุนเล่นฟรี 199 บาททันที ไม่ต้องแชร์ ไม่ต้องส่งหลักฐาน • เทิร์นโอเวอร์ต่ำ ถอนได้ง่าย ไม่มีอั้นยอดถอนต่อวัน • ระบบออโต้สมัครเองได้ในไม่ถึง 1 นาที • เซิร์ฟเวอร์ลื่นไหลไม่มีสะดุด รองรับทุกรุ่นทุกเครือข่าย",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#0a5df1]/30 bg-white/90 shadow-[0_8px_20px_rgba(10,93,241,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(1,203,246,0.32)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#0a5df1] via-[#0782f2] to-[#01cbf6] px-8 py-2.5 font-black text-[#f0f9ff] shadow-[4px_0_15px_rgba(10,93,241,0.3)]">
      <span aria-hidden="true" class="mr-2 text-lg">❄️</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-white to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#0b3a63]">
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#f1d42c] shadow-[0_0_8px_rgba(241,212,44,0.8)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#f1d42c] shadow-[0_0_8px_rgba(241,212,44,0.8)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
