---
// ห้ามขึ้นต้น message ด้วย emoji — marquee นี้ render ข้อความซ้ำสองรอบ (ไม่มีรอยต่อ)
// emoji ที่ฝังในข้อความจะถูกอ่านออกเสียงซ้ำและ mark aria-hidden ไม่ได้
// badge ด้านซ้ายมีไอคอนของมันเองอยู่แล้ว
//
// default ต้องเป็นคำโฆษณาของแบรนด์ปัจจุบันเสมอ — หน้าย่อยเรียก <Announcement />
// เปล่าๆ ไม่ส่ง prop จึงตกมาใช้บรรทัดนี้ ถ้าปล่อยเป็นของแบรนด์ก่อนหน้าจะหลุด
// ขึ้นทุกหน้าย่อยโดยที่หน้าแรกดูปกติดี — ข้อความชุดนี้ตรงกับที่ index.astro
// ส่งเข้ามาเป๊ะ ticker ทั้งเว็บจึงวิ่งข้อความเดียวกัน
//
// QUEEN189: ย้ายจากน้ำเงินรอยัลคู่ทองส้มของแบรนด์ก่อนที่เคยใช้ไฟล์นี้ มาเป็นทอง
// ราชสำนักบนดำสนิทของแบรนด์นี้ — ทอง #fdf3d2 / #fceb83 / #e4bb53 / #c38d29 /
// #7a5615 บนผิว #0b0704 / #1a1108 เนื้อความ #f3e4c4
const {
  message = "QUEEN189 คาสิโนมงลงทุกสปิน เกมเด็ดของดีมีครบ โปรแน่นต้องลอง • เว็บตรง API แท้ ยิงตรงจากเซิร์ฟนอก ปั่นง่ายแตกจริงด้วยค่า RTP มาตรฐานสากล ไร้การดัดแปลงระบบ ไม่ผ่านเอเย่นต์ ไม่ล็อกยูส • ยกระดับความปังด้วยเกมคัดเกรด รวมเฉพาะสล็อตแตกง่ายและคาสิโนสดอัตราจ่ายสูงไว้ในที่เดียว ไม่เอาเกมล้าหลังหรือเปอร์เซ็นต์แตกต่ำมาลงคลัง ทุกเกมผ่านการทดสอบอัลกอริทึมว่าแจกโบนัสตรงตามมาตรฐานโรงงาน • ขนทัพค่ายระดับท็อปของโลกอย่าง PG Soft, Pragmatic Play, SA Gaming และ Evolution มาไว้แบบครบมือ เน้นเกมตัวเด่นที่โครงสร้างการจ่ายเงินโปร่งใส ฟีเจอร์แตกโหด และสัญญาณไลฟ์สดความคมชัดสูง • สล็อตตัวท็อปอัดแน่นด้วยระบบ Multipliers ตัวคูณสะสม โหมดซื้อฟรีสปิน และคอมโบแตกต่อเนื่อง Cascading สปินลื่น กราฟิกสมูธ ไม่มีกระตุก เบทเริ่มต้นเบา ๆ แต่พร้อมแตกรางวัลใหญ่ • โต๊ะสดพร้อมลุย เชื่อมสัญญาณไลฟ์ระดับ Ultra HD ส่งตรงจากคาสิโนจริง ทั้งบาคาร่า รูเล็ต ไฮโล และเสือมังกร ร่วมกับดีลเลอร์มืออาชีพแบบเรียลไทม์ ผ่านกระเป๋าเงินเดียวไม่ต้องโยกเครดิต • โปรแน่นต้องลอง ทั้งโบนัสต้อนรับเพิ่มทุนสปิน โปรฝากแรกของวัน และระบบคืนยอดเสีย Cash Back ทุกวัน เงื่อนไขชัดเจน โปร่งใส ไม่ติดเทิร์นโอเวอร์มหาโหด • ระบบออโต้ลั่นไวไม่รอนาน ทำรายการเสร็จสรรพใน 3 วินาที ตัดขั้นตอนรอแอดมินอนุมัติและการส่งสลิปออกทั้งหมด ถอนยอดไหนก็เงินเข้าเต็มจำนวนทันที",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#e4bb53]/40 bg-[#0b0704]/90 shadow-[0_8px_20px_rgba(228,187,83,0.2)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(252,235,131,0.35)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#7a5615] via-[#c38d29] to-[#fceb83] px-8 py-2.5 font-black text-[#0b0704] shadow-[4px_0_15px_rgba(195,141,41,0.4)]">
      <span aria-hidden="true" class="mr-2 text-lg">👑</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#0b0704] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#f3e4c4]">
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#e4bb53] shadow-[0_0_8px_rgba(228,187,83,0.8)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#e4bb53] shadow-[0_0_8px_rgba(228,187,83,0.8)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
