---
// ห้ามขึ้นต้น message ด้วย emoji — marquee นี้ render ข้อความซ้ำสองรอบ (ไม่มีรอยต่อ)
// emoji ที่ฝังในข้อความจะถูกอ่านออกเสียงซ้ำและ mark aria-hidden ไม่ได้
// badge ด้านซ้ายมีไอคอนของมันเองอยู่แล้ว
//
// default ต้องเป็นคำโฆษณาของแบรนด์ปัจจุบันเสมอ — หน้าย่อยเรียก <Announcement />
// เปล่าๆ ไม่ส่ง prop จึงตกมาใช้บรรทัดนี้ ถ้าปล่อยเป็นของแบรนด์ก่อนหน้าจะหลุด
// ขึ้นทุกหน้าย่อยโดยที่หน้าแรกดูปกติดี — ข้อความชุดนี้ตรงกับที่ index.astro
// ส่งเข้ามาเป๊ะ ticker ทั้งเว็บจึงวิ่งข้อความเดียวกัน
//
// PROFIT55: ย้ายจากเขียวมรกตคู่ทองของ UOK789 (ทอง #f6c945 / #fdf3c9 / #8a6a1c
// คู่เขียว #2fc44f / #b6ecbd บนผิว #04140a เนื้อความ #e8f3e4) มาเป็นทองคู่เงิน
// โครเมียมของแบรนด์นี้ — ทอง #e3ac22 / #f6d24a / #ffe9a8 / #a97d12 คู่เงิน
// #cfd8e2 บนผิว #0a0702 เนื้อความ #f3e6c4
const {
  message = "PROFIT55 คาสิโนออนไลน์ระดับโปร รวมค่ายชั้นนำ เว็บเดียวครบทุกฟีล • รวบรวมค่ายเกมชั้นนำทั่วโลกไว้ในแพลตฟอร์มเดียว ครบทั้งสายไพ่ สายปั่นสล็อต และสายแทงบอลจบในที่เดียว • เกมลิขสิทธิ์แท้ อัตราการจ่ายเงินรางวัลเป็นธรรม พร้อมโครงสร้างระบบหลังบ้านที่แน่นหนาและปลอดภัยในทุกมิติ • ล็อบบี้จัดหมวดหมู่ไว้เป็นระเบียบ ทั้งแยกตามค่ายเกม หมวดเกมยอดนิยม และคาสิโนสด หาเกมที่อยากเล่นเจอในไม่กี่คลิก • จบเกมบาคาร่าสดแล้วสลับไปเช็กราคาค่าน้ำและวางเดิมพันฟุตบอลคู่โปรดได้ทันทีภายในยูสเซอร์เดียว • ระบบกระเป๋าเงินเดียวใช้ได้ทุกหมวดเดิมพัน ไม่ต้องกดโยกเงินไปมาให้เสียเวลาหรือเสี่ยงยอดตกค้าง • เซิร์ฟเวอร์รองรับสมาชิกเข้าใช้งานพร้อมกันจำนวนมาก ฝากถอนออโต้ประมวลผลไวในไม่กี่วินาที เปิดให้เข้ามาทำกำไรได้ตลอด 24 ชั่วโมง",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#e3ac22]/40 bg-[#0a0702]/90 shadow-[0_8px_20px_rgba(227,172,34,0.22)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(207,216,226,0.35)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#a97d12] via-[#e3ac22] to-[#ffe9a8] px-8 py-2.5 font-black text-[#0a0702] shadow-[4px_0_15px_rgba(227,172,34,0.35)]">
      <span aria-hidden="true" class="mr-2 text-lg">👑</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#0a0702] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#f3e6c4]">
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#cfd8e2] shadow-[0_0_8px_rgba(207,216,226,0.8)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#cfd8e2] shadow-[0_0_8px_rgba(207,216,226,0.8)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
