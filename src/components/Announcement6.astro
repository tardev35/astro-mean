---
const {
  // ห้ามขึ้นต้นข้อความด้วย emoji — ป้ายด้านซ้ายมี glyph ของตัวเองอยู่แล้ว และ
  // emoji ที่ฝังมากับ prop ตัวหนังสือ mark aria-hidden จากตรงนี้ไม่ได้ มันจะ
  // ถูกอ่านออกเสียงนำหน้าประโยค ซ้ำสามรอบตามจำนวนสำเนาของ marquee
  //
  // ค่า default ต้องเป็นคำของแบรนด์ปัจจุบันเสมอ — หน้าย่อยเรียก <Announcement />
  // เปล่าๆ ไม่ส่ง message มา ถ้าปล่อยค่าเดิมไว้ ทุกหน้าย่อยจะวิ่งสโลแกนของ
  // แบรนด์ก่อนหน้าอยู่บนหัวเว็บใหม่
  message = "PABO88 เว็บสล็อตคัดของดี เกมเด็ดเกินเรื่อง โปรถึงโบนัสแรง ถอนไว • คัดเฉพาะเกมสล็อตคุณภาพสูง อัตราการจ่ายยุติธรรม ธีมน่าสนใจ มารวมไว้ครบจบในเว็บเดียว • งานภาพระดับ HD กราฟิกสีสันสดใส เอฟเฟกต์อลังการ พร้อมอัตราคูณโบนัสก้อนโตที่สุ่มแจกต่อเนื่อง • โบนัสต้อนรับสมาชิกใหม่ สิทธิพิเศษเพิ่มทุนรายวัน และเครดิตคืนยอดเสีย • ฟรีสปินออกบ่อย สัญลักษณ์พิเศษ และตัวคูณสะสมแบบทวีคูณ • ระบบออโต้เต็มรูปแบบ เข้าสู่ระบบ เลือกค่ายเกม และฝากเงินเองได้ในไม่กี่คลิก • ถอนออโต้โอนไว ยอดเข้าตรงเป๊ะ ไม่ต้องรอแอดมินอนุมัติ ตลอด 24 ชั่วโมง",
} = Astro.props;

// PABO88: ย้ายจากแชมเปญทองของ UFAG8 (#dcb96b / #f2dca4 / #ac893a / #b9bcc4
// บนผิว #191712 / #0a0a09) มาเป็นนีออนม่วงคู่ทอง — ม่วง #bf3cfa / #e3b8ff /
// #8b1fd6 บนผิว #160333 / #0a0118 ป้ายซ้ายเป็นทอง #ffe9a3 / #f5c518 / #8f6205
// บนตัวอักษร #1a0430 และประกายคั่นเป็นเงิน #d9d9e3
---

<div class="mx-auto max-w-[900px] p-2">
  <div
    class="group relative flex h-[50px] items-center overflow-hidden rounded-full border border-[#bf3cfa]/40 bg-gradient-to-b from-[#160333] via-[#0a0118] to-[#160333] p-1 shadow-[0_5px_20px_rgba(191,60,250,0.18),inset_0_1px_1px_rgba(255,255,255,0.08)]">
    <div class="pointer-events-none absolute -top-6 left-10 h-16 w-16 rounded-full bg-[#bf3cfa]/25 blur-[30px]"></div>
    <div class="pointer-events-none absolute right-16 -bottom-6 h-16 w-16 rounded-full bg-[#d9d9e3]/15 blur-[30px]"></div>

    <div
      class="relative z-10 flex h-full shrink-0 items-center gap-1.5 rounded-full border border-[#ffe9a3]/40 bg-gradient-to-b from-[#ffe9a3] via-[#f5c518] to-[#8f6205] px-3.5 shadow-[inset_0_1px_1px_rgba(255,255,255,0.6)] md:px-4">
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#1a0430] shadow-[0_0_6px_rgba(26,4,48,0.8)]"></span>
      <span class="text-xs font-black tracking-wider text-[#1a0430] uppercase md:text-sm"><span aria-hidden="true">🎰</span> PABO88</span>
    </div>

    <div class="relative z-10 flex-1 overflow-hidden px-4">
      <div class="flex w-max animate-[scroll_18s_linear_infinite] gap-10 text-sm font-bold whitespace-nowrap text-[#e3b8ff]/90">
        <span>{message}</span>
        <span aria-hidden="true" class="text-[#d9d9e3]/80">✨</span>
        {/* สำเนาที่ 2 และ 3 มีไว้ให้ marquee ไม่มีรอยต่อ อ่านออกเสียงแค่ชุดแรก
            ชุดหลังเป็น aria-hidden ไม่งั้น screen reader จะอ่านประกาศทั้งอัน
            ซ้ำสามรอบติดกัน */}
        <span aria-hidden="true">{message}</span>
        <span aria-hidden="true" class="text-[#d9d9e3]/80">✨</span>
        <span aria-hidden="true">{message}</span>
      </div>
    </div>

    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[2px] bg-gradient-to-r from-transparent via-[#bf3cfa]/70 to-transparent opacity-70"></div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13.33px));
    }
  }
</style>
