---
// ROSTY59: ชุดสีย้ายจากทองราชสำนักวรรณะเดียวของแบรนด์ก่อน มาเป็นทองอำพันคู่โครเมียม
// เงินบนดำสนิทตามอาร์ตจริง — ทอง #ffeec2 / #ffc94a / #f2a01a / #b06a0d / #6b3f07
// คู่เงิน #dbe1e8 / #a3adba / #5d6773 บนผิว #070505 / #150e07 / #26180a ขอบ #4a2f0d
// เนื้อความ #ece0cc ข้อความรอง #bda98c แถวอันดับหนึ่งรับผิวยกระดับขึ้นหนึ่งขั้นและ
// ขอบทองสว่างเพื่อให้ตัดกับแถวที่เหลือ จุด live สีเขียว Tailwind เป็นสีเชิงความหมาย
// ไม่ถูกแตะ
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history)
//
// ไม่มีรูปโลโก้ค่ายในแถวไหนเลย และไม่ import src/assets/providers/game* — โลโก้ค่าย
// อยู่ที่ ProviderGridPremium ซึ่งเป็นที่ของมัน กระดานนี้กางหมวดหมู่ในล็อบบี้ ไม่ใช่
// รายชื่อค่าย การเอาโลโก้ค่ายมาแปะข้างชื่อหมวดแล้วเขียน alt ให้เป็นอย่างอื่นคือ alt
// ที่ไม่ตรงกับรูป และรูปที่ import แต่ไม่ได้ใช้คือรูปที่ถูก emit ลง dist/ ฟรีๆ ช่องรูป
// จึงเป็นไอคอนกรอบทองที่เป็น aria-hidden แทน
//
// ไม่ผูกหมวดกับชื่อค่ายรายแถว: docx เอ่ยค่าย (PG Soft, Pragmatic Play, Joker Gaming)
// กับคุณสมบัติของเกมไว้คนละประโยค การจับคู่ว่าคุณสมบัติไหนเป็นของค่ายไหนเป็นข้อมูลที่
// brief ไม่ได้ให้ ช่องขวาของแต่ละแถวจึงบอก "จุดเด่นของหมวด" ซึ่งเป็นข้อเท็จจริงที่
// docx ให้ไว้ตรงๆ แทน
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อแถวก็เป็น <p> เช่นกัน — ไม่มีตัวไหนเป็นหัวข้อจาก docx
// กระดานนี้เป็น widget ปลายหน้า วางรวมกับชุด widget อื่นหลังหัวข้อ docx ข้อสุดท้าย
//
// อันดับ 1–3 แสดงเหรียญ "แทน" ตัวเลข ถ้าซ่อนอิโมจิเฉยๆ สามแถวนั้นจะไม่เหลืออันดับ
// ให้อ่านเลย ข้อความ sr-only จึงใส่กลับเข้าไปคู่กับ aria-hidden
const games = [
  {
    rank: 1,
    name: "หมวดสล็อตวิดีโอ 3D ภาพสวย",
    type: "กราฟิกสามมิติเต็มจอจากค่ายลิขสิทธิ์แท้ โหลดหน้าเกมไว ไร้ป๊อปอัปและองค์ประกอบรกตา ทุกการกดสปินลื่นไหลไม่ค้างแม้ช่วงคนเข้าพร้อมกันหนาแน่น",
    focus: "โหลดไว ไม่มีอาการค้าง",
    menus: ["ภาพ 3D", "สปินลื่น"],
    players: 5124,
    icon: "🎮",
  },
  {
    rank: 2,
    name: "หมวดสล็อตตัวคูณหนัก",
    type: "รวมเกมที่วางระบบ Multiplier ให้สะสมตัวคูณทวีคูณระหว่างรอบหมุน ยิ่งต่อคอมโบยาวยิ่งดันยอดรางวัลขึ้นจากเบทเดิมโดยไม่ต้องเพิ่มทุน",
    focus: "สะสมตัวคูณทวีคูณ",
    menus: ["Multiplier", "คอมโบยาว"],
    players: 3842,
    icon: "✖️",
  },
  {
    rank: 3,
    name: "หมวดสายซื้อฟีเจอร์",
    type: "โหมด Bonus Buy ให้เลือกซื้อฟรีสปินพุ่งตรงเข้าลุ้นแจ็คพอตใหญ่ได้ทันที ไม่ต้องรอสัญลักษณ์ครบเอง เหมาะกับคนที่อยากเข้าจังหวะโบนัสให้ตรงรอบ",
    focus: "พุ่งชนโบนัสได้ทันที",
    menus: ["Bonus Buy", "ฟรีสปิน"],
    players: 3517,
    icon: "🎟️",
  },
  {
    rank: 4,
    name: "หมวดสล็อตคลาสสิกไลน์จ่าย",
    type: "ไลน์จ่ายเข้าใจง่ายแบบดั้งเดิม อ่านตารางรางวัลได้ในรอบเดียว เหมาะกับคนที่อยากเล่นยาวโดยไม่ต้องจำเงื่อนไขฟีเจอร์ซับซ้อน",
    focus: "อ่านไลน์จ่ายได้ในรอบเดียว",
    menus: ["คลาสสิก", "เข้าใจง่าย"],
    players: 2905,
    icon: "🍀",
  },
  {
    rank: 5,
    name: "หมวดสิทธิ์และโปรโมชัน",
    type: "กดรับเองผ่านหน้าเว็บ ทั้งโบนัสต้อนรับเพิ่มทุนสปิน โปรโมชันฝากแรกของวัน และสิทธิ์คืนยอดเสีย Cash Back ที่คำนวณยอดตรงไปตรงมา",
    focus: "ไม่ติดเทิร์นโอเวอร์ซับซ้อน",
    menus: ["โบนัสต้อนรับ", "Cash Back"],
    players: 2431,
    icon: "🎁",
  },
  {
    rank: 6,
    name: "หมวดฝากถอนออโต้ 3 วินาที",
    type: "ระบบออโต้ไฮสปีดผ่าน Gateway ตรง รองรับทั้งธนาคารชั้นนำและวอลเล็ท ไม่ต้องส่งสลิปให้แอดมินตรวจ ไม่ต้องรอคิวอนุมัติ",
    focus: "ถอนเต็มจำนวนทันที",
    menus: ["Gateway ตรง", "ไม่ต้องส่งสลิป"],
    players: 2108,
    icon: "⚡",
  },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดเกมในคลังที่ ROSTY59 แยกไว้ให้เปลี่ยนสไตล์การเล่นได้จากที่เดียว" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#4a2f0d]/70 bg-[#150e07]/90 px-6 py-6 text-center shadow-[0_10px_30px_rgba(107,63,7,0.35)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">🎰</span>
    <p class="bg-gradient-to-r from-[#ffeec2] via-[#ffc94a] to-[#dbe1e8] bg-clip-text text-2xl font-black tracking-wide text-transparent">
      หมวดเกมในคลังที่ ROSTY59 แยกไว้ให้เปลี่ยนสไตล์การเล่นได้จากที่เดียว
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#bda98c]">
      กางให้เห็นครบในหน้าเดียว ทั้งหมวดสล็อตวิดีโอ 3D หมวดสล็อตตัวคูณหนัก หมวดสายซื้อฟีเจอร์ หมวดสล็อตคลาสสิกไลน์จ่าย หมวดสิทธิ์และโปรโมชัน และหมวดฝากถอนออโต้ 3 วินาที
      ทุกหมวดใช้กระเป๋าเดียวไม่ต้องโยกเงินข้ามค่าย ลำดับความนิยมเปลี่ยนได้ตามช่วงเวลา ควรเปิดดูอัตราจ่ายและเงื่อนไขของแต่ละเกมจากหน้าเกมจริงอีกครั้งก่อนลงเดิมพัน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f2a01a] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#ffc94a]/55 bg-gradient-to-r from-[#26180a]/90 via-[#150e07]/92 to-[#070505]/90 shadow-[0_15px_40px_rgba(242,160,26,0.2)]"
                : "border-[#4a2f0d]/60 bg-[#150e07]/90 shadow-[0_10px_30px_rgba(107,63,7,0.25)] hover:border-[#f2a01a]/55 hover:shadow-[0_15px_40px_rgba(242,160,26,0.28)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#26180a]/80 blur-[40px] transition-all duration-500 group-hover:bg-[#6b3f07]/50" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#f2a01a] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div
              aria-hidden="true"
              class={`relative z-10 flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border bg-[#070505] text-2xl transition-transform duration-500 group-hover:scale-110 sm:h-16 sm:w-16 sm:text-3xl ${
                top ? "border-[#ffc94a]/60" : "border-[#4a2f0d]"
              }`}>
              {g.icon}
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#ece0cc] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#f2a01a]/70 bg-gradient-to-r from-[#ffc94a] to-[#b06a0d] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#070505] sm:inline">
                    หมวดที่คนเข้ามากที่สุด
                  </span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#bda98c] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                <span class="rounded-full border border-[#dbe1e8]/40 bg-[#26180a] px-2.5 py-0.5 text-[10px] font-bold text-[#dbe1e8]">{g.focus}</span>
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#4a2f0d] bg-[#26180a] px-2.5 py-0.5 text-[10px] font-bold text-[#ffc94a]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#bda98c]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ffc94a] to-[#b06a0d] text-[#070505] shadow-[0_10px_30px_rgba(242,160,26,0.35)]"
                    : "border border-[#4a2f0d] bg-[#26180a] text-[#ffc94a] hover:border-[#f2a01a] hover:bg-[#6b3f07] hover:text-[#ffeec2]"
                }`}>
                เข้าเล่นเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // ตัวกันเรื่อง visibility, แท็บพื้นหลัง และ reduced-motion อยู่ใน
  // src/lib/liveCounter.ts ซึ่งเป็นไฟล์ที่การรีแบรนด์ไม่เขียนทับ ห้ามเอา
  // setTimeout เปล่าๆ กลับมาไว้ตรงนี้ — ตัวนับอยู่ในกล่อง `hidden sm:flex`
  // ถ้าไม่มีตัวกัน มันจะปลุก main thread บนมือถือทุกเครื่องเพื่ออัปเดตข้อความ
  // ที่ไม่มีใครมองเห็น
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
