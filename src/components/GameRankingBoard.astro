---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// รูปในแต่ละแถวคือ "โลโก้ค่ายพันธมิตร" ไม่ใช่ภาพของเกมนั้น alt จึงบรรยายโลโก้ตาม
// ตัวอักษรที่พิมพ์อยู่บนรูปจริง — game1 = PG (Pocket Games Soft), game2 = SexySlot,
// game3 = SlotXO, game4 = Joker, game5 = JILI, game6 = PP SLOT (Pragmatic Play)
// ห้ามเปลี่ยนค่า `brand` ของแถวโดยไม่เปลี่ยนไฟล์รูปตาม สลับลำดับแถวได้เพราะรูปกับ
// ชื่อค่ายเดินทางไปด้วยกันในอ็อบเจกต์เดียว ส่วน `name`/`type` เป็นชื่อห้องเกมสล็อต
// ซึ่งไม่ได้ผูกกับรูป จึงเปลี่ยนได้อิสระ
//
// AURORA688: ย้ายจากทองบูสต์คู่น้ำเงินไฟฉายของ BOOST168 (#ffe680 / #ffc233 /
// #b26a00 คู่น้ำเงิน #9ecbff / #3f8cff / #12306e บนผิว #0e1430 / #050818 / #03060f
// / #18204a เนื้อความ #e6ecfb ข้อความรอง #9ecbff) มาที่ทองหรูคู่เงินโครเมียม —
// ทองหลัก #ffe9a3 / #e2c443 / #c9a13a / #7d5714 คู่เงิน #eef2f7 / #c3cddb / #8d99a8
// บนผิว #221c0d / #0a0806 / #050403 / #3a3116 เนื้อความ #f2ead6 ข้อความรอง #c8bda1
// ทองยังเป็นสีหลักของกริดเหมือนเดิม ส่วนแถวอันดับหนึ่งรับคู่เงินโครเมียมเพื่อให้ตัด
// กับแถวที่เหลือ จุด live สีเขียวเป็นสีเชิงความหมาย ไม่ถูกแตะ
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อแถวก็เป็น <p> เช่นกัน — ไม่มีตัวไหนเป็นหัวข้อจาก docx
// กระดานนี้เน้นความหลากหลายของคลังเกมกว่า 1,000+ และจังหวะลุ้นแจ็คพอตที่กระจายอยู่
// ทุกเกมตาม brief ของแบรนด์นี้ ไม่ใช่การชูอัตราจ่ายของเกมใดเกมหนึ่ง
//
// อันดับ 1–3 แสดงเหรียญ "แทน" ตัวเลข ถ้าซ่อนอิโมจิเฉยๆ สามแถวนั้นจะไม่เหลืออันดับ
// ให้อ่านเลย ข้อความ sr-only จึงใส่กลับเข้าไปคู่กับ aria-hidden
const games = [
  {
    rank: 1,
    name: "ห้องเกมฮิตติดแสงระดับตำนาน",
    type: "สล็อตยอดนิยม • เกมที่ทุกคนต้องรู้จัก",
    brand: "PP SLOT (Pragmatic Play)",
    menus: ["ภาพสวยกราฟิกอลังการ", "จังหวะลุ้นแจ็คพอตมาถี่"],
    players: 5124,
    img: img6,
  },
  {
    rank: 2,
    name: "ห้องแฟนตาซีตระการตา",
    type: "สล็อตแฟนตาซี • โลกเวทมนตร์เต็มจอ",
    brand: "Joker",
    menus: ["ภาพจัดเต็มแต่ยังลื่นไหล", "รอบโบนัสเข้าถึงได้ง่าย"],
    players: 3842,
    img: img4,
  },
  {
    rank: 3,
    name: "ห้องแอ็กชันสุดมันส์จังหวะกระชับ",
    type: "สล็อตแอ็กชัน • รู้ผลไวไม่ต้องรอนาน",
    brand: "JILI",
    menus: ["เข้าหน้าสปินแทบไม่ต้องรอ", "เหมาะกับสายเบทเบาเล่นชิล"],
    players: 3517,
    img: img5,
  },
  {
    rank: 4,
    name: "ห้องเกมใหม่มาแรงนอกกระแส",
    type: "สล็อตมาใหม่ • ซ่อนโบนัสเด็ดเอาไว้เพียบ",
    brand: "SexySlot",
    menus: ["ค้นฟีเจอร์แปลกใหม่ได้ทุกวัน", "อัปตัวเลือกเข้าคลังต่อเนื่อง"],
    players: 2905,
    img: img2,
  },
  {
    rank: 5,
    name: "ห้องสล็อตแนวสตรีทสุดเท่",
    type: "สล็อตสไตล์สตรีท • อัตราจ่ายคุ้มค่า",
    brand: "PG (Pocket Games Soft)",
    menus: ["กติกาตรงไปตรงมา", "เหมาะกับสายวางแผนทุน"],
    players: 2431,
    img: img1,
  },
  {
    rank: 6,
    name: "ห้องเกมตัวตึงทำเงินคัดมาแล้ว",
    type: "สล็อตคัดพิเศษ • รอบโบนัสกระจายทุกเกม",
    brand: "SlotXO",
    menus: ["เปิดให้เข้าตลอดทั้งวัน", "ความเสถียรอยู่ระดับสูง"],
    players: 2108,
    img: img3,
  },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="ห้องเกมสล็อตมาแรงที่สมาชิก AURORA688 กำลังปั่นอยู่ตอนนี้" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#e2c443]/35 bg-[#221c0d]/88 px-6 py-6 text-center shadow-[0_10px_30px_rgba(226,196,67,0.22)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">🎰</span>
    <p class="bg-gradient-to-r from-[#eef2f7] via-[#e2c443] to-[#c9a13a] bg-clip-text text-2xl font-black tracking-wide text-transparent">ห้องเกมสล็อตมาแรงที่สมาชิก AURORA688 กำลังปั่นอยู่ตอนนี้</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#c8bda1]">
      กระดานนี้จับห้องเกมที่คนเข้าเยอะที่สุดจากคลังกว่า 1,000+ เกมมาเรียงไว้ในล็อบบี้เดียว กดสลับค่ายได้ตลอดทั้งวันในบัญชีเดียวโดยไม่ต้องโยกเงินหรือออกจากระบบ รายชื่อห้องมาแรงเปลี่ยนได้ตามช่วงเวลา
      ควรเปิดดูเบทขั้นต่ำและเงื่อนไขฟีเจอร์ของแต่ละเกมจากหน้าเกมจริงอีกครั้งก่อนลงเดิมพัน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e2c443] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#c3cddb]/60 bg-gradient-to-r from-[#3a3116]/75 via-[#221c0d]/92 to-[#050403]/88 shadow-[0_15px_40px_rgba(195,205,219,0.25)]"
                : "border-[#e2c443]/30 bg-[#221c0d]/88 shadow-[0_10px_30px_rgba(226,196,67,0.18)] hover:border-[#e2c443]/55 hover:shadow-[0_15px_40px_rgba(226,196,67,0.32)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#c3cddb]/20 blur-[40px] transition-all duration-500 group-hover:bg-[#e2c443]/35" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#e2c443] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#c3cddb]/60" : "border-[#e2c443]/35"}`}>
              <Picture
                src={g.img}
                alt={`โลโก้ค่ายเกมพันธมิตร ${g.brand} ที่อยู่ในล็อบบี้เกมสล็อตของ AURORA688`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#f2ead6] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#eef2f7]/70 bg-gradient-to-r from-[#eef2f7] to-[#c3cddb] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#050403] sm:inline">
                    มาแรงสูงสุด
                  </span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#c8bda1] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#e2c443]/30 bg-[#050403] px-2.5 py-0.5 text-[10px] font-bold text-[#ffe9a3]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#c8bda1]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#eef2f7] to-[#c3cddb] text-[#050403] shadow-[0_10px_30px_rgba(195,205,219,0.35)]"
                    : "border border-[#e2c443]/60 bg-[#050403] text-[#ffe9a3] hover:border-[#c3cddb] hover:bg-[#3a3116] hover:text-[#eef2f7]"
                }`}>
                เข้าดูเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // ตัวกันเรื่อง visibility, แท็บพื้นหลัง และ reduced-motion อยู่ใน
  // src/lib/liveCounter.ts ซึ่งเป็นไฟล์ที่การรีแบรนด์ไม่เขียนทับ ห้ามเอา
  // setTimeout เปล่าๆ กลับมาไว้ตรงนี้ — ตัวนับอยู่ในกล่อง `hidden sm:flex`
  // ถ้าไม่มีตัวกัน มันจะปลุก main thread บนมือถือทุกเครื่องเพื่ออัปเดตข้อความ
  // ที่ไม่มีใครมองเห็น
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
