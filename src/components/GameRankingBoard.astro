---
// QUEEN189: ชุดสีย้ายมาที่ทองราชสำนักบนดำสนิทตามอาร์ตจริง — ทอง #fdf3d2 /
// #fceb83 / #e4bb53 / #c38d29 / #7a5615 บนผิว #0b0704 / #1a1108 / #271a0c /
// #3c2505 เนื้อความ #f3e4c4 ข้อความรอง #c2a878 แถวอันดับหนึ่งรับผิวทองเข้มสว่างขึ้น
// หนึ่งระดับเพื่อให้ตัดกับแถวที่เหลือ จุด live สีเขียว Tailwind เป็นสีเชิงความหมาย
// ไม่ถูกแตะ
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history)
//
// ไม่มีรูปโลโก้ค่ายในแถวไหนเลย และไม่ import src/assets/providers/game* — โลโก้ค่าย
// อยู่ที่ ProviderGrid ซึ่งเป็นที่ของมัน กระดานนี้กางหมวดหมู่ในล็อบบี้ ไม่ใช่รายชื่อ
// ค่าย การเอาโลโก้ค่ายมาแปะข้างชื่อหมวดแล้วเขียน alt ให้เป็นอย่างอื่นคือ alt ที่ไม่
// ตรงกับรูป และรูปที่ import แต่ไม่ได้ใช้คือรูปที่ถูก emit ลง dist/ ฟรีๆ ช่องรูปจึง
// เป็นไอคอนกรอบทองที่เป็น aria-hidden แทน
//
// ไม่ผูกหมวดกับชื่อค่ายรายแถว: docx เอ่ยค่าย (PG Soft, Pragmatic Play, SA Gaming,
// Evolution) กับคุณสมบัติของเกมไว้คนละประโยค การจับคู่ว่าคุณสมบัติไหนเป็นของค่ายไหน
// เป็นข้อมูลที่ brief ไม่ได้ให้ ช่องขวาของแต่ละแถวจึงบอก "จุดเด่นของหมวด" ซึ่งเป็น
// ข้อเท็จจริงที่ docx ให้ไว้ตรงๆ แทน
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อแถวก็เป็น <p> เช่นกัน — ไม่มีตัวไหนเป็นหัวข้อจาก docx
// กระดานนี้เป็น widget ปลายหน้า วางรวมกับชุด widget อื่นหลังหัวข้อ docx ข้อสุดท้าย
//
// อันดับ 1–3 แสดงเหรียญ "แทน" ตัวเลข ถ้าซ่อนอิโมจิเฉยๆ สามแถวนั้นจะไม่เหลืออันดับ
// ให้อ่านเลย ข้อความ sr-only จึงใส่กลับเข้าไปคู่กับ aria-hidden
const games = [
  {
    rank: 1,
    name: "หมวดสล็อตตัวท็อป",
    type: "รวมเกมกระแสแรงที่มีระบบ Multipliers ตัวคูณสะสม โหมดซื้อฟรีสปิน และคอมโบแตกต่อเนื่อง Cascading สปินลื่น กราฟิกสมูธ ไม่มีกระตุก",
    focus: "เบทเบา ๆ ก็ลุ้นรางวัลใหญ่",
    menus: ["ตัวคูณสะสม", "ซื้อฟรีสปิน"],
    players: 5124,
    icon: "🎰",
  },
  {
    rank: 2,
    name: "หมวดโต๊ะสด Ultra HD",
    type: "เชื่อมสัญญาณไลฟ์สดระดับ Ultra HD ส่งตรงจากคาสิโนจริง ทั้งบาคาร่า รูเล็ต ไฮโล และเสือมังกร ร่วมกับดีลเลอร์มืออาชีพแบบเรียลไทม์",
    focus: "สลับจากหน้าสปินได้ทันที",
    menus: ["บาคาร่า รูเล็ต", "ไฮโล เสือมังกร"],
    players: 3842,
    icon: "🃏",
  },
  {
    rank: 3,
    name: "หมวดแยกตามค่ายชั้นนำ",
    type: "แยกตามค่ายระดับท็อปของโลกทั้ง PG Soft, Pragmatic Play, SA Gaming และ Evolution เลือกค่ายที่ถนัดแล้วเข้าเล่นได้จากกระเป๋าเงินเดียว",
    focus: "ไม่ต้องโยกเครดิตข้ามค่าย",
    menus: ["ค่ายชั้นนำ", "กระเป๋าเงินเดียว"],
    players: 3517,
    icon: "👑",
  },
  {
    rank: 4,
    name: "หมวดเกมคัดเกรดแตกง่าย",
    type: "รวมเฉพาะสล็อตแตกง่ายและคาสิโนสดอัตราจ่ายสูง ไม่เอาเกมล้าหลังหรือเปอร์เซ็นต์แตกต่ำมาลงคลัง ทุกเกมผ่านการทดสอบอัลกอริทึมก่อนเปิดให้เล่น",
    focus: "ผ่านทดสอบอัลกอริทึม",
    menus: ["คัดเกรด", "อัตราจ่ายสูง"],
    players: 2905,
    icon: "💎",
  },
  {
    rank: 5,
    name: "หมวดสิทธิ์และโปรโมชั่น",
    type: "กดรับเองผ่านหน้าแดชบอร์ด ทั้งโบนัสต้อนรับเพิ่มทุนสปิน โปรฝากแรกของวัน และระบบคืนยอดเสีย Cash Back ทุกวัน เงื่อนไขชัดเจนโปร่งใส",
    focus: "ไม่ติดเทิร์นโอเวอร์มหาโหด",
    menus: ["โบนัสต้อนรับ", "Cash Back"],
    players: 2431,
    icon: "🎁",
  },
  {
    rank: 6,
    name: "หมวดฝากถอนออโต้ 3 วินาที",
    type: "ระบบออโต้ไฮสปีดทำรายการเสร็จสรรพใน 3 วินาที ตัดขั้นตอนรอแอดมินอนุมัติและการส่งสลิปออกทั้งหมด ถอนยอดไหนก็เงินเข้าเต็มจำนวน",
    focus: "ถอนเต็มจำนวนทันที",
    menus: ["ออโต้ 3 วินาที", "ไม่ต้องส่งสลิป"],
    players: 2108,
    icon: "⚡",
  },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดเกมในฟลอร์ที่ QUEEN189 แยกไว้ให้สลับเล่นได้ต่อเนื่องจากที่เดียว" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#7a5615]/45 bg-[#1a1108]/90 px-6 py-6 text-center shadow-[0_10px_30px_rgba(122,86,21,0.3)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">👑</span>
    <p class="bg-gradient-to-r from-[#fdf3d2] via-[#fceb83] to-[#c38d29] bg-clip-text text-2xl font-black tracking-wide text-transparent">
      หมวดเกมในฟลอร์ที่ QUEEN189 แยกไว้ให้สลับเล่นได้ต่อเนื่องจากที่เดียว
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#c2a878]">
      กางให้เห็นครบในหน้าเดียว ทั้งหมวดสล็อตตัวท็อป หมวดโต๊ะสด Ultra HD หมวดแยกตามค่ายชั้นนำ หมวดเกมคัดเกรดแตกง่าย หมวดสิทธิ์และโปรโมชั่น และหมวดฝากถอนออโต้ 3 วินาที ลำดับความนิยมเปลี่ยนได้ตามช่วงเวลา
      ควรเปิดดูอัตราจ่ายและเงื่อนไขของแต่ละเกมจากหน้าเกมจริงอีกครั้งก่อนลงเดิมพัน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e4bb53] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#fceb83]/55 bg-gradient-to-r from-[#3c2505]/85 via-[#1a1108]/92 to-[#0b0704]/90 shadow-[0_15px_40px_rgba(228,187,83,0.2)]"
                : "border-[#7a5615]/35 bg-[#1a1108]/90 shadow-[0_10px_30px_rgba(122,86,21,0.2)] hover:border-[#e4bb53]/55 hover:shadow-[0_15px_40px_rgba(228,187,83,0.28)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#271a0c]/80 blur-[40px] transition-all duration-500 group-hover:bg-[#7a5615]/40" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#e4bb53] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div
              aria-hidden="true"
              class={`relative z-10 flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border bg-[#0b0704] text-2xl transition-transform duration-500 group-hover:scale-110 sm:h-16 sm:w-16 sm:text-3xl ${
                top ? "border-[#fceb83]/60" : "border-[#7a5615]/45"
              }`}>
              {g.icon}
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#f3e4c4] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#e4bb53]/70 bg-gradient-to-r from-[#fceb83] to-[#c38d29] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#0b0704] sm:inline">
                    หมวดที่คนเข้ามากที่สุด
                  </span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#c2a878] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                <span class="rounded-full border border-[#7a5615] bg-[#271a0c] px-2.5 py-0.5 text-[10px] font-bold text-[#fceb83]">{g.focus}</span>
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#7a5615]/40 bg-[#271a0c] px-2.5 py-0.5 text-[10px] font-bold text-[#e4bb53]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#c2a878]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#fceb83] to-[#c38d29] text-[#0b0704] shadow-[0_10px_30px_rgba(228,187,83,0.35)]"
                    : "border border-[#7a5615]/60 bg-[#271a0c] text-[#e4bb53] hover:border-[#fceb83] hover:bg-[#3c2505] hover:text-[#fdf3d2]"
                }`}>
                เข้าเล่นเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // ตัวกันเรื่อง visibility, แท็บพื้นหลัง และ reduced-motion อยู่ใน
  // src/lib/liveCounter.ts ซึ่งเป็นไฟล์ที่การรีแบรนด์ไม่เขียนทับ ห้ามเอา
  // setTimeout เปล่าๆ กลับมาไว้ตรงนี้ — ตัวนับอยู่ในกล่อง `hidden sm:flex`
  // ถ้าไม่มีตัวกัน มันจะปลุก main thread บนมือถือทุกเครื่องเพื่ออัปเดตข้อความ
  // ที่ไม่มีใครมองเห็น
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
