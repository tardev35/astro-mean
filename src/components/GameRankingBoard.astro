---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// รูปในแต่ละแถวคือ "โลโก้ค่ายพันธมิตร" ไม่ใช่ภาพของเกมนั้น alt จึงบรรยายโลโก้ตาม
// ตัวอักษรที่พิมพ์อยู่บนรูปจริง — game1 = PG (Pocket Games Soft), game2 = SexySlot,
// game3 = SlotXO, game4 = Joker, game5 = JILI, game6 = PP SLOT (Pragmatic Play)
// ห้ามเปลี่ยนค่า `brand` ของแถวโดยไม่เปลี่ยนไฟล์รูปตาม สลับลำดับแถวได้เพราะรูปกับ
// ชื่อค่ายเดินทางไปด้วยกันในอ็อบเจกต์เดียว ส่วน `name`/`type` เป็นชื่อโหมดเกม
// ซึ่งไม่ได้ผูกกับรูป จึงเปลี่ยนได้อิสระ
//
// UOK789: ย้ายจากนีออนม่วงคู่ทองของแบรนด์ก่อนหน้ามาที่เขียวมรกตคู่ทองเมทัลลิก —
// เขียว #2fc44f / #b6ecbd / #12923a / #0a4d1c คู่ทอง #f6c945 / #fdf3c9 / #8a6a1c
// บนผิว #08290f / #04140a ขอบ/แถบยก #0c3d18 เนื้อความ #e8f3e4 เขียวเป็นสีหลักของ
// กระดาน ส่วนแถวอันดับหนึ่งรับคู่ทองเพื่อให้ตัดกับแถวที่เหลือ จุด live สีเขียว
// Tailwind เป็นสีเชิงความหมาย ไม่ถูกแตะ (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind
// สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้
// ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อแถวก็เป็น <p> เช่นกัน — ไม่มีตัวไหนเป็นหัวข้อจาก docx
// กระดานนี้เป็นภาพประกอบของหัวข้อ docx ข้อ 3 (ตัวเด็ดเข้าไม่พัก) จึงเน้นทั้งเกม
// ฮิตติดลมบนและเกมนอกกระแสฟีเจอร์เด็ดที่ล็อบบี้อัปเดตเข้ามาต่อเนื่อง
//
// อันดับ 1–3 แสดงเหรียญ "แทน" ตัวเลข ถ้าซ่อนอิโมจิเฉยๆ สามแถวนั้นจะไม่เหลืออันดับ
// ให้อ่านเลย ข้อความ sr-only จึงใส่กลับเข้าไปคู่กับ aria-hidden
const games = [
  {
    rank: 1,
    name: "สล็อตเกมกระแสที่คนปั่นเยอะสุดวันนี้",
    type: "เกมฮิตติดลมบน • เชื่อมตรงกับเซิร์ฟเวอร์หลักของค่ายผ่าน API",
    brand: "PP SLOT (Pragmatic Play)",
    menus: ["ทุกสปินลื่นไหลไม่กระตุก", "เปิดปั่นได้ตลอด 24 ชั่วโมง"],
    players: 5124,
    img: img6,
  },
  {
    rank: 2,
    name: "สล็อตตัวใหม่ที่เพิ่งเข้าล็อบบี้",
    type: "อัปเดตเข้ามาต่อเนื่อง • ฟีเจอร์เด็ดพร้อมแตกหนัก",
    brand: "Joker",
    menus: ["สลับเปลี่ยนเล่นได้ไม่มีซ้ำ", "เก็บรอบสั้นรู้ผลไว"],
    players: 3842,
    img: img4,
  },
  {
    rank: 3,
    name: "สล็อตนอกกระแสฟีเจอร์เด็ด",
    type: "ตัวเลือกสดใหม่ตลอดเวลา • ซื้อฟีเจอร์ได้ไม่ถูกจำกัด",
    brand: "JILI",
    menus: ["ไม่ล็อกยูสไม่ล็อกผล", "เหมาะกับสายลองของใหม่"],
    players: 3517,
    img: img5,
  },
  {
    rank: 4,
    name: "สล็อตทุนน้อยสำหรับมือใหม่",
    type: "ปรับเบทขึ้นลงได้อิสระ • ทำความคุ้นเคยกับวงล้อได้ไม่กดดัน",
    brand: "SexySlot",
    menus: ["กติกาตรงไปตรงมา", "เลือกไลน์เดิมพันให้พอดีทุน"],
    players: 2905,
    img: img2,
  },
  {
    rank: 5,
    name: "สล็อตแจ็คพอตใหญ่สำหรับสายลุยหนัก",
    type: "เพดานรางวัลกว้าง • ถอนหลักแสนก็อนุมัติเต็มจำนวน",
    brand: "PG (Pocket Games Soft)",
    menus: ["ยอดไม่ค้างไม่มีเงื่อนไขจุกจิก", "ถอนออโต้เสร็จในไม่กี่วินาที"],
    players: 2431,
    img: img1,
  },
  {
    rank: 6,
    name: "สล็อตหลายค่ายรวมในยูสเดียว",
    type: "สลับหลายค่ายในวันเดียวได้เต็มสไตล์ • ไม่ต้องโยกเงิน",
    brand: "SlotXO",
    menus: ["อัตราการออกรางวัลแม่นยำ", "ฝากถอนออโต้ไม่ต้องส่งสลิป"],
    players: 2108,
    img: img3,
  },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="เกมสล็อตมาแรงที่สมาชิก UOK789 กำลังปั่นอยู่ตอนนี้" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#2fc44f]/35 bg-[#08290f]/88 px-6 py-6 text-center shadow-[0_10px_30px_rgba(47,196,79,0.22)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">🎰</span>
    <p class="bg-gradient-to-r from-[#f4fdf3] via-[#b6ecbd] to-[#f6c945] bg-clip-text text-2xl font-black tracking-wide text-transparent">เกมสล็อตมาแรงที่สมาชิก UOK789 กำลังปั่นอยู่ตอนนี้</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#e8f3e4]/80">
      กระดานนี้จับเกมสล็อตที่คนเข้าเยอะที่สุดมาเรียงไว้ในหน้าเดียว ทั้งเกมกระแสและตัวใหม่ที่เพิ่งเข้าล็อบบี้ กดสลับค่ายเกมได้ตลอดทั้งวันในยูสเซอร์เดียวโดยไม่ต้องโยกเงินหรือออกจากระบบ
      รายชื่อเกมมาแรงเปลี่ยนได้ตามช่วงเวลา ควรเปิดดูอัตราการจ่ายและเงื่อนไขฟีเจอร์ของแต่ละเกมจากหน้าเกมจริงอีกครั้งก่อนลงเดิมพัน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#2fc44f] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#f6c945]/60 bg-gradient-to-r from-[#0c3d18]/80 via-[#08290f]/92 to-[#04140a]/88 shadow-[0_15px_40px_rgba(246,201,69,0.28)]"
                : "border-[#2fc44f]/30 bg-[#08290f]/88 shadow-[0_10px_30px_rgba(47,196,79,0.18)] hover:border-[#2fc44f]/55 hover:shadow-[0_15px_40px_rgba(47,196,79,0.32)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#0a4d1c]/45 blur-[40px] transition-all duration-500 group-hover:bg-[#2fc44f]/35" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#2fc44f] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#f6c945]/60" : "border-[#2fc44f]/35"}`}>
              <Picture
                src={g.img}
                alt={`โลโก้ค่ายเกมสล็อตพันธมิตร ${g.brand} ที่อยู่ในลิสต์ค่ายเกมของ UOK789`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#e8f3e4] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#fdf3c9]/70 bg-gradient-to-r from-[#fdf3c9] to-[#f6c945] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#04140a] sm:inline">
                    มาแรงสูงสุด
                  </span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#e8f3e4]/75 sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#2fc44f]/30 bg-[#04140a] px-2.5 py-0.5 text-[10px] font-bold text-[#b6ecbd]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#e8f3e4]/75">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#fdf3c9] to-[#f6c945] text-[#04140a] shadow-[0_10px_30px_rgba(246,201,69,0.35)]"
                    : "border border-[#2fc44f]/60 bg-[#04140a] text-[#b6ecbd] hover:border-[#f6c945] hover:bg-[#0c3d18] hover:text-[#f4fdf3]"
                }`}>
                เข้าเล่นเกมสล็อต
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // ตัวกันเรื่อง visibility, แท็บพื้นหลัง และ reduced-motion อยู่ใน
  // src/lib/liveCounter.ts ซึ่งเป็นไฟล์ที่การรีแบรนด์ไม่เขียนทับ ห้ามเอา
  // setTimeout เปล่าๆ กลับมาไว้ตรงนี้ — ตัวนับอยู่ในกล่อง `hidden sm:flex`
  // ถ้าไม่มีตัวกัน มันจะปลุก main thread บนมือถือทุกเครื่องเพื่ออัปเดตข้อความ
  // ที่ไม่มีใครมองเห็น
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
