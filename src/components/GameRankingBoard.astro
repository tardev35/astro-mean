---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// แต่ละแถวผูกกับโลโก้ค่ายที่เป็นเจ้าของเกมนั้นจริง (game1 PG Soft, game2 Joker,
// game3 JILI, game4 Evolution, game5 SA Gaming, game6 Sexy Baccarat) ข้อความ alt
// จึงบรรยายรูปได้ตรง — ห้ามเปลี่ยนชื่อ/ค่ายของแถวโดยไม่เปลี่ยนรูปตาม
//
// FUSIONNEW: ย้ายจากทองหลวง + แดงชาดของ IOK66 (#ffe9a3 / #f0cd6a / #e3b64a /
// #b8862c / #5c3a10 คู่กับ #a3161c / #5c0a0c บนผิว #1c110a / #150c07 / #0d0705
// เนื้อความ #f2e2c4 ข้อความรอง #ddc8a4) มาที่แดงสัญญาณ + โครมเงิน — #ff5f52 /
// #e01a1a / #8c0102 คู่กับ #d9dde3 / #97a0a8 / #4a5157 บนผิว #150809 / #1f0c0d /
// #0a0405 เนื้อความ #e7e3e1 ข้อความรอง #c3bcb9
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อแถวก็เป็น <p> เช่นกัน — ไม่มีตัวไหนเป็นหัวข้อจาก docx
// เรียงสล็อตขึ้นก่อนเพราะ brief ของแบรนด์นี้เป็นเว็บสล็อต แล้วปิดท้ายด้วยคาสิโนสด
const games = [
  { rank: 1, name: "Mahjong Ways 2", type: "PG Soft • สล็อต", menus: ["กราฟิกอลังการ", "ตัวคูณจัดหนัก"], players: 5124, img: img1 },
  { rank: 2, name: "Roma X", type: "Joker Gaming • สล็อต", menus: ["แนวคลาสสิกกดง่าย", "เล่นเพลินลืมเวลา"], players: 3842, img: img2 },
  { rank: 3, name: "Fortune Gems", type: "JILI • สล็อต", menus: ["รอบสั้นจังหวะไว", "ฟรีสปินเข้าถึงง่าย"], players: 3517, img: img3 },
  { rank: 4, name: "Lightning Roulette", type: "Evolution • คาสิโนสด", menus: ["สตรีมไม่มีดรอป", "ห้องให้เลือกเพียบ"], players: 2905, img: img4 },
  { rank: 5, name: "Dragon Tiger", type: "SA Gaming • คาสิโนสด", menus: ["ภาพคมชัด HD", "สลับฟีลได้ไว"], players: 2431, img: img5 },
  { rank: 6, name: "เซ็กซี่ บาคาร่า", type: "Sexy Baccarat • คาสิโนสด", menus: ["เกมมาใหม่ล่าสุด", "เล่นล่าสุด"], players: 2108, img: img6 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="เกมมาแรงที่สมาชิก FUSIONNEW กำลังปั่นอยู่ตอนนี้" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#e01a1a]/30 bg-[#150809]/88 px-6 py-6 text-center shadow-[0_10px_30px_rgba(224,26,26,0.18)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">🏁</span>
    <p class="bg-gradient-to-r from-[#d9dde3] via-[#ff5f52] to-[#e01a1a] bg-clip-text text-2xl font-black tracking-wide text-transparent">เกมมาแรงที่สมาชิก FUSIONNEW กำลังปั่นอยู่ตอนนี้</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#c3bcb9]">
      กระดานนี้จับเกมฮิตติดระดับตำนานมาโคจรพบกับเกมมาใหม่ล่าสุด ให้สลับอารมณ์เล่นได้ตลอดทั้งวันโดยไม่ต้องเปลี่ยนเว็บ จังหวะสปินต่อเนื่องไม่มีดรอปแม้ช่วงที่มีผู้เล่นเข้าใช้งานพร้อมกันเยอะ
      รายชื่อเกมมาแรงเปลี่ยนได้ตามช่วงเวลา ควรเปิดดูเดิมพันเริ่มต้นและฟีเจอร์โบนัสจากหน้าเกมจริงอีกครั้งก่อนกดเล่น
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e01a1a] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#d9dde3]/50 bg-gradient-to-r from-[#8c0102]/90 via-[#150809]/92 to-[#0a0405]/88 shadow-[0_15px_40px_rgba(224,26,26,0.28)]"
                : "border-[#e01a1a]/25 bg-[#150809]/88 shadow-[0_10px_30px_rgba(224,26,26,0.16)] hover:border-[#ff5f52]/55 hover:shadow-[0_15px_40px_rgba(255,95,82,0.28)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#8c0102]/35 blur-[40px] transition-all duration-500 group-hover:bg-[#e01a1a]/45" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {/* อันดับ 1–3 แสดงเหรียญ "แทน" ตัวเลข ถ้าซ่อนอิโมจิเฉยๆ สามแถวนั้นจะไม่
                  เหลืออันดับให้อ่านเลย ข้อความ sr-only จึงใส่กลับเข้าไป */}
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#ff5f52] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#d9dde3]/55" : "border-[#e01a1a]/30"}`}>
              <Picture
                src={g.img}
                alt={`โลโก้ค่ายเกมของ ${g.name} ในกระดานเกมมาแรงของ FUSIONNEW`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#e7e3e1] sm:text-lg">{g.name}</p>
                {top && <span class="hidden shrink-0 rounded-full border border-[#d9dde3]/60 bg-[#e01a1a] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#0a0405] sm:inline">มาแรงสูงสุด</span>}
              </div>
              <p class="truncate text-[11px] text-[#c3bcb9] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#e01a1a]/30 bg-[#0a0405] px-2.5 py-0.5 text-[10px] font-bold text-[#ff5f52]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#c3bcb9]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ff5f52] to-[#e01a1a] text-[#0a0405] shadow-[0_10px_30px_rgba(224,26,26,0.35)]"
                    : "border border-[#e01a1a]/60 bg-[#0a0405] text-[#ff5f52] hover:border-[#d9dde3] hover:bg-[#8c0102] hover:text-[#d9dde3]"
                }`}>
                เข้าดูเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // ตัวกันเรื่อง visibility, แท็บพื้นหลัง และ reduced-motion อยู่ใน
  // src/lib/liveCounter.ts ซึ่งเป็นไฟล์ที่การรีแบรนด์ไม่เขียนทับ ห้ามเอา
  // setTimeout เปล่าๆ กลับมาไว้ตรงนี้ — ตัวนับอยู่ในกล่อง `hidden sm:flex`
  // ถ้าไม่มีตัวกัน มันจะปลุก main thread บนมือถือทุกเครื่องเพื่ออัปเดตข้อความ
  // ที่ไม่มีใครมองเห็น
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
