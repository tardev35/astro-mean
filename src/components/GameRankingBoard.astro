---
// CK1968: ชุดสีย้ายจากทองแอนทีคคู่กราไฟต์ของแบรนด์ก่อน มาเป็นทองคำคู่แดงเลือดหมู
// บนดำอมน้ำตาลตามอาร์ตจริง — ทอง #ffefc4 / #ffd45c / #f0a80c / #a76806 / #5d3a05
// คู่แดง #ff4b52 / #d4090f / #8c0206 / #3d0203 บนผิว #090302 / #170806 / #2a100a
// ขอบ #4d1f0d เนื้อความ #f6e4c0 ข้อความรอง #cdb494 แถวอันดับหนึ่งรับผิวยกระดับขึ้น
// หนึ่งขั้นและขอบทองสว่างเพื่อให้ตัดกับแถวที่เหลือ จุด live สีเขียว Tailwind เป็นสี
// เชิงความหมาย ไม่ถูกแตะ
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history)
//
// ไม่มีรูปโลโก้ค่ายในแถวไหนเลย และไม่ import src/assets/providers/game* — โลโก้ค่าย
// อยู่ที่ ProviderGridPremium ซึ่งเป็นที่ของมัน กระดานนี้กางหมวดหมู่ในล็อบบี้ ไม่ใช่
// รายชื่อค่าย การเอาโลโก้ค่ายมาแปะข้างชื่อหมวดแล้วเขียน alt ให้เป็นอย่างอื่นคือ alt
// ที่ไม่ตรงกับรูป และรูปที่ import แต่ไม่ได้ใช้คือรูปที่ถูก emit ลง dist/ ฟรีๆ ช่องรูป
// จึงเป็นไอคอนกรอบทองที่เป็น aria-hidden แทน
//
// เนื้อของทุกแถวมาจากข้อเท็จจริงที่ docx รอบนี้ให้ไว้ตรงๆ (API แท้จากเซิร์ฟเวอร์หลัก,
// RTP มาตรฐานสากล, ไม่ล็อคยูสเซอร์, ระบบ AI ทำธุรกรรมอัตโนมัติ, ฝากถอนไม่มีขั้นต่ำ,
// ฟีเจอร์ใหม่อัปเดตก่อนใคร, โอนจ่ายเต็มจำนวนไม่หักค่าธรรมเนียม) ไม่ผูกหมวดกับชื่อค่าย
// รายแถว เพราะ brief ไม่ได้ให้ข้อมูลว่าคุณสมบัติไหนเป็นของค่ายไหน
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อแถวก็เป็น <p> เช่นกัน — ไม่มีตัวไหนเป็นหัวข้อจาก docx
// กระดานนี้เป็น widget ปลายหน้า วางรวมกับชุด widget อื่นหลังหัวข้อ docx ข้อสุดท้าย
//
// อันดับ 1–3 แสดงเหรียญ "แทน" ตัวเลข ถ้าซ่อนอิโมจิเฉยๆ สามแถวนั้นจะไม่เหลืออันดับ
// ให้อ่านเลย ข้อความ sr-only จึงใส่กลับเข้าไปคู่กับ aria-hidden
const games = [
  {
    rank: 1,
    name: "หมวดเกมลิขสิทธิ์แท้จากค่ายดังทั่วโลก",
    type: "นำเข้าระบบ API แท้จากเซิร์ฟเวอร์หลักของค่ายเกมโดยตรง อัตราการแตก RTP จึงเป็นมาตรฐานสากลจริง ไม่มีการแอบปรับลดเปอร์เซ็นต์การชนะระหว่างทาง",
    focus: "RTP มาตรฐานสากล",
    menus: ["API แท้", "ลิขสิทธิ์แท้"],
    players: 5124,
    icon: "🎰",
  },
  {
    rank: 2,
    name: "หมวดเกมที่เล่นลื่นไม่หลุดจังหวะฟรีสปิน",
    type: "ระบบหลังบ้านเสถียรสูงมาก รองรับผู้ใช้งานพร้อมกันนับหมื่นคนได้โดยที่เว็บไม่อืด เล่นลื่นไหลไม่มีอาการกระตุกหรือหลุดออกจากเกมในจังหวะเข้าฟรีสปิน",
    focus: "รองรับนับหมื่นคนพร้อมกัน",
    menus: ["ไม่กระตุก", "ไม่หลุดเกม"],
    players: 3842,
    icon: "⚡",
  },
  {
    rank: 3,
    name: "หมวดฝากถอนออโต้ด้วยระบบ AI",
    type: "ลืมการส่งสลิปให้แอดมินตรวจไปได้เลย กดทำรายการแล้วระบบประมวลผลยอดเงินให้เข้ากระเป๋าภายในเวลาไม่กี่วินาที จะฝากตอนดึกหรือถอนช่วงเช้าตรู่ก็ไม่มีสะดุด",
    focus: "เข้ากระเป๋าในไม่กี่วินาที",
    menus: ["ระบบ AI", "ไม่ต้องส่งสลิป"],
    players: 3517,
    icon: "🤖",
  },
  {
    rank: 4,
    name: "หมวดฝากถอนไม่มีขั้นต่ำ",
    type: "ทุนหลักสิบหรือหลักหมื่นก็ร่วมสนุกและลุ้นรางวัลใหญ่ได้เท่าเทียมกัน อยากฝากแค่ 1 บาทเพื่อปั่นเล่นขำๆ หรือถอนยอดเล็กๆ ออกไปใช้ก่อนก็ทำรายการเองได้ทันที",
    focus: "ไม่มีเงื่อนไขผูกมัด",
    menus: ["ฝาก 1 บาท", "ถอนยอดเล็ก"],
    players: 2905,
    icon: "💰",
  },
  {
    rank: 5,
    name: "หมวดฟีเจอร์เกมใหม่ที่อัปเดตก่อนใคร",
    type: "เกมที่นี่แตกง่ายจริงตามสถิติ แถมยังมีฟีเจอร์ตัวเกมใหม่ๆ ทยอยอัปเดตเข้าคลังให้สมาชิกได้เล่นก่อนใคร เป็นเหตุผลหลักที่มืออาชีพเลือกปักหลักทำกำไรต่อเนื่อง",
    focus: "แตกง่ายจริงตามสถิติ",
    menus: ["ฟีเจอร์ใหม่", "เล่นก่อนใคร"],
    players: 2431,
    icon: "🃏",
  },
  {
    rank: 6,
    name: "หมวดถอนจริงเต็มจำนวนทุกบิล",
    type: "แจ็คพอตแตกหลักหมื่น หลักแสน หรือทะลุหลักล้าน ก็มีทุนสำรองมหาศาลพร้อมโอนจ่ายเต็มจำนวนทุกบาททุกสตางค์ ไม่หักค่าธรรมเนียมและไม่แบ่งจ่ายเป็นงวดๆ",
    focus: "ไม่หักเปอร์เซ็นต์",
    menus: ["จ่ายเต็มจำนวน", "ไม่แบ่งงวด"],
    players: 2108,
    icon: "👑",
  },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดเกมและบริการในคลังที่ CK1968 แยกไว้ให้ดูครบจากที่เดียว" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#4d1f0d]/70 bg-[#170806]/90 px-6 py-6 text-center shadow-[0_10px_30px_rgba(93,58,5,0.35)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">🎰</span>
    <p class="bg-gradient-to-r from-[#ffefc4] via-[#ffd45c] to-[#ff4b52] bg-clip-text text-2xl font-black tracking-wide text-transparent">หมวดเกมและบริการในคลังที่ CK1968 แยกไว้ให้ดูครบจากที่เดียว</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#cdb494]">
      กางให้เห็นครบในหน้าเดียว ทั้งหมวดเกมลิขสิทธิ์แท้จากค่ายดังทั่วโลก หมวดเกมที่เล่นลื่นไม่หลุดจังหวะฟรีสปิน หมวดฝากถอนออโต้ด้วยระบบ AI หมวดฝากถอนไม่มีขั้นต่ำ หมวดฟีเจอร์เกมใหม่ที่อัปเดตก่อนใคร
      และหมวดถอนจริงเต็มจำนวนทุกบิล ลำดับความนิยมเปลี่ยนได้ตามช่วงเวลา ควรเปิดดูอัตราจ่ายและเงื่อนไขของแต่ละเกมจากหน้าเกมจริงอีกครั้งก่อนลงเดิมพัน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f0a80c] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#ffd45c]/55 bg-gradient-to-r from-[#2a100a]/90 via-[#170806]/92 to-[#090302]/90 shadow-[0_15px_40px_rgba(240,168,12,0.2)]"
                : "border-[#4d1f0d]/60 bg-[#170806]/90 shadow-[0_10px_30px_rgba(93,58,5,0.25)] hover:border-[#f0a80c]/55 hover:shadow-[0_15px_40px_rgba(240,168,12,0.28)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#2a100a]/80 blur-[40px] transition-all duration-500 group-hover:bg-[#8c0206]/50" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#f0a80c] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div
              aria-hidden="true"
              class={`relative z-10 flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border bg-[#090302] text-2xl transition-transform duration-500 group-hover:scale-110 sm:h-16 sm:w-16 sm:text-3xl ${
                top ? "border-[#ffd45c]/60" : "border-[#4d1f0d]"
              }`}>
              {g.icon}
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#f6e4c0] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#f0a80c]/70 bg-gradient-to-r from-[#ffd45c] to-[#a76806] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#090302] sm:inline">
                    หมวดที่คนเข้ามากที่สุด
                  </span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#cdb494] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                <span class="rounded-full border border-[#d4090f]/50 bg-[#2a100a] px-2.5 py-0.5 text-[10px] font-bold text-[#ff4b52]">{g.focus}</span>
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#4d1f0d] bg-[#2a100a] px-2.5 py-0.5 text-[10px] font-bold text-[#ffd45c]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#cdb494]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ffd45c] to-[#a76806] text-[#090302] shadow-[0_10px_30px_rgba(240,168,12,0.35)]"
                    : "border border-[#4d1f0d] bg-[#2a100a] text-[#ffd45c] hover:border-[#d4090f] hover:bg-[#8c0206] hover:text-[#ffefc4]"
                }`}>
                เข้าเล่นเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // ตัวกันเรื่อง visibility, แท็บพื้นหลัง และ reduced-motion อยู่ใน
  // src/lib/liveCounter.ts ซึ่งเป็นไฟล์ที่การรีแบรนด์ไม่เขียนทับ ห้ามเอา
  // setTimeout เปล่าๆ กลับมาไว้ตรงนี้ — ตัวนับอยู่ในกล่อง `hidden sm:flex`
  // ถ้าไม่มีตัวกัน มันจะปลุก main thread บนมือถือทุกเครื่องเพื่ออัปเดตข้อความ
  // ที่ไม่มีใครมองเห็น
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
