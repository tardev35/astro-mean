---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// Each game keeps the cover art it was paired with, so the alt text still
// describes the picture. The order is slot-first because this brand's brief is
// a slot site; the two live tables sit at the bottom of the board.
const games = [
  { rank: 1, name: "Mahjong Ways 2", type: "PG Soft • สล็อต", menus: ["RTP สูง", "โบนัสไทม์แตกบ่อย"], players: 5124, img: img1 },
  { rank: 2, name: "Gates of Olympus", type: "Pragmatic Play • สล็อต", menus: ["ยอดนิยม", "ตัวคูณจัดหนัก"], players: 3842, img: img2 },
  { rank: 3, name: "Fortune Gems", type: "JILI • สล็อต", menus: ["รอบไว", "ทุนน้อยก็ลุยได้"], players: 3517, img: img4 },
  { rank: 4, name: "Super Ace", type: "JILI • สล็อต", menus: ["เกมใหม่", "เข้ามือบ่อย"], players: 2905, img: img5 },
  { rank: 5, name: "บาคาร่า ห้อง Live สด", type: "Evolution • เกมโต๊ะไลฟ์", menus: ["ไลฟ์สด", "รายการโปรด"], players: 2431, img: img6 },
  { rank: 6, name: "รูเล็ต โต๊ะไลฟ์", type: "Evolution • เกมโต๊ะไลฟ์", menus: ["ไลฟ์สด", "เล่นล่าสุด"], players: 2108, img: img3 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="เกมสล็อตมาแรงที่สมาชิก 9UFA กำลังปั่นอยู่ตอนนี้" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#0a5df1]/25 bg-white/85 px-6 py-6 text-center shadow-[0_10px_30px_rgba(10,93,241,0.15)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="bg-gradient-to-r from-[#0743a8] via-[#0a5df1] to-[#01cbf6] bg-clip-text text-2xl font-black tracking-wide text-transparent">เกมสล็อตมาแรงที่สมาชิก 9UFA กำลังปั่นอยู่ตอนนี้</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#3f6d99]">
      ทุกเกมในกระดานนี้ดึงสัญญาณตรงผ่าน API ลิขสิทธิ์แท้จากค่ายผู้พัฒนาโดยตรง ไม่ผ่านคนกลาง ภาพกราฟิกคมชัดลื่นไหล กดเบทได้แบบเรียลไทม์ และคัดมาเฉพาะตัวที่ค่า RTP สูง
      รายชื่อเกมมาแรงเปลี่ยนได้ตามช่วงเวลา ควรเปิดดูเดิมพันเริ่มต้นและฟีเจอร์โบนัสจากหน้าเกมจริงอีกครั้งก่อนกดสปิน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#0a5df1] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#c9930a]/45 bg-gradient-to-r from-[#ffe98a]/60 via-white/90 to-white/85 shadow-[0_15px_40px_rgba(241,212,44,0.3)]"
                : "border-[#0a5df1]/25 bg-white/85 shadow-[0_10px_30px_rgba(10,93,241,0.15)] hover:border-[#0a5df1]/55 hover:shadow-[0_15px_40px_rgba(1,203,246,0.28)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#01cbf6]/25 blur-[40px] transition-all duration-500 group-hover:bg-[#01cbf6]/40" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {/* Ranks 1–3 show a medal INSTEAD of the number, so hiding the
                  emoji on its own would leave those three rows with no rank at
                  all. The visually-hidden text puts it back. */}
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#0a5df1] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#c9930a]/45" : "border-[#acddfb]"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกเกม ${g.name} ในกระดานเกมสล็อตมาแรงของ 9UFA`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#0b3a63] sm:text-lg">{g.name}</p>
                {top && <span class="hidden shrink-0 rounded-full border border-[#c9930a]/40 bg-[#ffe98a] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#062a52] sm:inline">มาแรงสูงสุด</span>}
              </div>
              <p class="truncate text-[11px] text-[#3f6d99] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#0a5df1]/30 bg-[#eaf4fe] px-2.5 py-0.5 text-[10px] font-bold text-[#0743a8]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#3f6d99]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-600 shadow-[0_0_6px_rgba(22,163,74,0.6)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#f1d42c] to-[#ffe98a] text-[#062a52] shadow-[0_10px_30px_rgba(241,212,44,0.35)]"
                    : "border border-[#0a5df1]/60 bg-white text-[#0a5df1] hover:border-[#0a5df1] hover:bg-[#eaf4fe]"
                }`}>
                เข้าดูเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // Guards for visibility, background tabs and reduced-motion live in
  // src/lib/liveCounter.ts — a file no rebrand rewrites. Do not reinstate a
  // bare setTimeout loop here; the counters sit inside a `hidden sm:flex`
  // container, so an unguarded one wakes the main thread on every phone to
  // update text nobody can see.
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
