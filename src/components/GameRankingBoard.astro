---
// HAPPYSUPERWIN: ชุดสีย้ายมาที่แคนดี้มาเจนต้าคู่เหลืองลูกอมตามอาร์ตจริง — มาเจนต้า
// #e11ccc / #ff5ae6 / #fff0fc / #8a1f9e / #4c0d6b คู่เหลือง #ffd83d / #f0b429
// บนผิว #190430 / #280747 / #380a5f เนื้อความ #f7e2ff ข้อความรอง #cfa5e6 แถวอันดับ
// หนึ่งรับผิวม่วงสว่างขึ้นหนึ่งระดับ (#4a1078) เพื่อให้ตัดกับแถวที่เหลือ จุด live
// สีเขียว Tailwind เป็นสีเชิงความหมาย ไม่ถูกแตะ
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history)
//
// ไม่มีรูปโลโก้ค่ายในแถวไหนเลย และไม่ import src/assets/providers/game* — โลโก้ค่าย
// อยู่ที่ ProviderGridPremium ซึ่งเป็นที่ของมัน กระดานนี้กางหมวดหมู่ในล็อบบี้ ไม่ใช่
// รายชื่อค่าย การเอาโลโก้ค่ายมาแปะข้างชื่อหมวดแล้วเขียน alt ให้เป็นอย่างอื่นคือ alt
// ที่ไม่ตรงกับรูป และรูปที่ import แต่ไม่ได้ใช้คือรูปที่ถูก emit ลง dist/ ฟรีๆ
// ช่องรูปจึงเป็นไอคอนกรอบมาเจนต้าที่เป็น aria-hidden แทน
//
// ไม่ผูกหมวดกับชื่อค่ายรายแถว: docx เอ่ยค่าย (PG Soft, Pragmatic Play, Joker Gaming)
// กับคุณสมบัติของเกมไว้คนละประโยค การจับคู่ว่าคุณสมบัติไหนเป็นของค่ายไหนเป็นข้อมูล
// ที่ brief ไม่ได้ให้ ช่องขวาของแต่ละแถวจึงบอก "จุดเด่นของหมวด" ซึ่งเป็นข้อเท็จจริง
// ที่ docx ให้ไว้ตรงๆ แทน
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อแถวก็เป็น <p> เช่นกัน — ไม่มีตัวไหนเป็นหัวข้อจาก docx
// กระดานนี้เป็น widget ปลายหน้า วางรวมกับชุด widget อื่นหลังหัวข้อ docx ข้อสุดท้าย
//
// อันดับ 1–3 แสดงเหรียญ "แทน" ตัวเลข ถ้าซ่อนอิโมจิเฉยๆ สามแถวนั้นจะไม่เหลืออันดับ
// ให้อ่านเลย ข้อความ sr-only จึงใส่กลับเข้าไปคู่กับ aria-hidden
const games = [
  {
    rank: 1,
    name: "หมวดเกมดังคัดมาดี",
    type: "คัดกรองเฉพาะเกมที่มีอัตราการจ่ายรางวัลสูงและโบนัสแตกบ่อยที่สุดมาไว้ในหน้าแรก ไม่ต้องเสียเวลาลองสุ่มเล่นเกมไร้คุณภาพ",
    focus: "เบทเบาๆ ก็ลุ้นแจ็คพอต",
    menus: ["จ่ายรางวัลสูง", "โบนัสแตกบ่อย"],
    players: 5124,
    icon: "🍭",
  },
  {
    rank: 2,
    name: "หมวดแยกตามค่ายชั้นนำ",
    type: "แยกตามค่ายเกมระดับโลกทั้ง PG Soft, Pragmatic Play และ Joker Gaming เลือกค่ายที่ถนัดแล้วเข้าเล่นได้ทันทีจากกระเป๋าเดียว",
    focus: "ไม่ต้องโยกเงินข้ามค่าย",
    menus: ["ค่ายชั้นนำ", "กระเป๋าเดียว"],
    players: 3842,
    icon: "🏷️",
  },
  {
    rank: 3,
    name: "หมวดเกมใหม่เข้าล็อบบี้",
    type: "เติมเกมใหม่ทันทีที่ค่ายผู้พัฒนาปล่อยไฟล์ออกจากสตูดิโอ ได้ทดลองเล่นฟีเจอร์เด็ดและอ่านจังหวะโบนัสก่อนใครแบบไม่ตกเทรนด์",
    focus: "ของใหม่ไม่ต้องรอนาน",
    menus: ["อัปเดตต่อเนื่อง", "เล่นก่อนใคร"],
    players: 3517,
    icon: "🎁",
  },
  {
    rank: 4,
    name: "หมวด Cascading คอมโบแตกต่อเนื่อง",
    type: "รวมเกมที่สัญลักษณ์แตกแล้วร่วงต่อเป็นคอมโบในรอบเดียว ต่อยอดรางวัลให้ยาวขึ้นโดยไม่ต้องกดสปินใหม่",
    focus: "คอมโบยาวในสปินเดียว",
    menus: ["Cascading", "คอมโบต่อเนื่อง"],
    players: 2905,
    icon: "🔁",
  },
  {
    rank: 5,
    name: "หมวด Multiplier ตัวคูณหนัก",
    type: "เกมที่มีระบบสุ่มแจกตัวคูณระหว่างรอบหมุน ดันยอดรางวัลที่ออกให้ทบขึ้นจากเบทเดิมโดยไม่ต้องเพิ่มทุน",
    focus: "ทบรางวัลจากเบทเดิม",
    menus: ["Multiplier", "ตัวคูณสุ่มแจก"],
    players: 2431,
    icon: "✖️",
  },
  {
    rank: 6,
    name: "หมวด Wild ซ้อนทับ",
    type: "เกมที่มีสัญลักษณ์ Wild ซ้อนทับกันบนหน้าจอ เปิดโอกาสเรียงไลน์รางวัลได้กว้างกว่าการหมุนแบบปกติในตาเดียวกัน",
    focus: "เรียงไลน์ได้กว้างขึ้น",
    menus: ["Wild ซ้อนทับ", "ไลน์กว้าง"],
    players: 2108,
    icon: "🃏",
  },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดเกมในล็อบบี้ที่ HAPPYSUPERWIN แยกไว้ให้สลับเล่นได้ต่อเนื่องจากที่เดียว" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#4c0d6b]/45 bg-[#280747]/90 px-6 py-6 text-center shadow-[0_10px_30px_rgba(76,13,107,0.3)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">🎰</span>
    <p class="bg-gradient-to-r from-[#fff0fc] via-[#ff5ae6] to-[#ffd83d] bg-clip-text text-2xl font-black tracking-wide text-transparent">
      หมวดเกมในล็อบบี้ที่ HAPPYSUPERWIN แยกไว้ให้สลับเล่นได้ต่อเนื่องจากที่เดียว
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#cfa5e6]">
      กางให้เห็นครบในหน้าเดียว ทั้งหมวดเกมดังคัดมาดี หมวดแยกตามค่ายชั้นนำ หมวดเกมใหม่เข้าล็อบบี้ หมวด Cascading คอมโบแตกต่อเนื่อง หมวด Multiplier ตัวคูณหนัก และหมวด Wild ซ้อนทับ
      ลำดับความนิยมเปลี่ยนได้ตามช่วงเวลา ควรเปิดดูอัตราจ่ายและเงื่อนไขของแต่ละเกมจากหน้าเกมจริงอีกครั้งก่อนลงเดิมพัน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e11ccc] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#ff5ae6]/55 bg-gradient-to-r from-[#4a1078]/85 via-[#280747]/92 to-[#190430]/90 shadow-[0_15px_40px_rgba(225,28,204,0.2)]"
                : "border-[#4c0d6b]/35 bg-[#280747]/90 shadow-[0_10px_30px_rgba(76,13,107,0.2)] hover:border-[#e11ccc]/55 hover:shadow-[0_15px_40px_rgba(225,28,204,0.28)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#380a5f]/80 blur-[40px] transition-all duration-500 group-hover:bg-[#8a1f9e]/40" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#e11ccc] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div
              aria-hidden="true"
              class={`relative z-10 flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border bg-[#190430] text-2xl transition-transform duration-500 group-hover:scale-110 sm:h-16 sm:w-16 sm:text-3xl ${
                top ? "border-[#ff5ae6]/60" : "border-[#4c0d6b]/45"
              }`}>
              {g.icon}
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#f7e2ff] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#e11ccc]/70 bg-gradient-to-r from-[#ff5ae6] to-[#e11ccc] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#190430] sm:inline">
                    หมวดที่คนเข้ามากที่สุด
                  </span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#cfa5e6] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                <span class="rounded-full border border-[#4c0d6b] bg-[#380a5f] px-2.5 py-0.5 text-[10px] font-bold text-[#ffd83d]">{g.focus}</span>
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#4c0d6b]/40 bg-[#380a5f] px-2.5 py-0.5 text-[10px] font-bold text-[#ff5ae6]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#cfa5e6]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ff5ae6] to-[#e11ccc] text-[#190430] shadow-[0_10px_30px_rgba(225,28,204,0.35)]"
                    : "border border-[#4c0d6b]/60 bg-[#380a5f] text-[#ff5ae6] hover:border-[#ffd83d] hover:bg-[#4c0d6b] hover:text-[#fff0fc]"
                }`}>
                เข้าเล่นเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // ตัวกันเรื่อง visibility, แท็บพื้นหลัง และ reduced-motion อยู่ใน
  // src/lib/liveCounter.ts ซึ่งเป็นไฟล์ที่การรีแบรนด์ไม่เขียนทับ ห้ามเอา
  // setTimeout เปล่าๆ กลับมาไว้ตรงนี้ — ตัวนับอยู่ในกล่อง `hidden sm:flex`
  // ถ้าไม่มีตัวกัน มันจะปลุก main thread บนมือถือทุกเครื่องเพื่ออัปเดตข้อความ
  // ที่ไม่มีใครมองเห็น
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
