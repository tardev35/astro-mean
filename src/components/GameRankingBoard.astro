---
// JAICHUA: ชุดสีย้ายจากน้ำเงินธงชาติคู่แดงของแบรนด์ก่อน มาเป็นทองคำคู่น้ำเงินรอยัล
// บนกรมท่าเกือบดำตามอาร์ตจริง — ทอง #fbeec9 / #f6d67e / #d8a83f / #a97722 /
// #6d4a12 คู่น้ำเงิน #cfe0fb / #5b8ede / #2f5fb0 / #16336b บนผิว #040915 /
// #0a1226 / #0e1a33 / #132244 ขอบ #6d4a12 เนื้อความ #dce6f8 ข้อความรอง #a9b7d4
// แถวอันดับหนึ่งรับผิวยกระดับขึ้นหนึ่งขั้นและขอบทองสว่างเพื่อให้ตัดกับแถวที่เหลือ
// จุด live สีเขียว Tailwind เป็นสีเชิงความหมาย ไม่ถูกแตะ
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history)
//
// ไม่มีรูปโลโก้ในแถวไหนเลย และไม่ import src/assets/providers/game* — กระดานนี้กาง
// แนวเกมกับระบบที่เปิดใช้ ไม่ใช่รายชื่อค่าย (รายชื่อค่ายอยู่ที่ ProviderGridPremium
// ซึ่งมีโลโก้จริงประกบอยู่แล้ว) การเอารูปมาแปะข้างชื่อแถวแล้วเขียน alt ให้เป็น
// อย่างอื่นคือ alt ที่ไม่ตรงกับรูป และรูปที่ import แต่ไม่ได้ใช้คือรูปที่ถูก emit ลง
// dist/ ฟรีๆ ช่องรูปจึงเป็นไอคอนกรอบทองที่เป็น aria-hidden
//
// เนื้อของทุกแถวมาจากข้อเท็จจริงที่ docx รอบนี้ให้ไว้ตรงๆ (สล็อตวิดีโอ 3D, สล็อต
// ตัวคูณสะสม, สายซื้อฟีเจอร์ฟรีสปิน, เกมใหม่ที่อัปเดตเข้าคลังต่อเนื่อง, ลูกเล่น
// Expanding Wild กับ Cascading, ระบบออโต้ไฮสปีดผ่าน Gateway ตรง) ไม่ผูกตัวเลข RTP
// รายแถว เพราะ brief พูดถึง RTP ตามสเปกโรงงานโดยรวม ไม่ได้ให้ตัวเลขรายเกม
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อแถวก็เป็น <p> เช่นกัน — ไม่มีตัวไหนเป็นหัวข้อจาก docx
// กระดานนี้เป็น widget ปลายหน้า วางรวมกับชุด widget อื่นหลังหัวข้อ docx ข้อสุดท้าย
//
// อันดับ 1–3 แสดงเหรียญ "แทน" ตัวเลข ถ้าซ่อนอิโมจิเฉยๆ สามแถวนั้นจะไม่เหลืออันดับ
// ให้อ่านเลย ข้อความ sr-only จึงใส่กลับเข้าไปคู่กับ aria-hidden
const games = [
  {
    rank: 1,
    name: "สล็อตวิดีโอ 3D ภาพสวย",
    type: "แนวที่สมาชิกเปิดเล่นมากที่สุดในคลัง งานภาพและเอฟเฟกต์ระดับค่ายใหญ่ ประมวลผลลื่นไหลไม่มีอาการเกมค้างหรือสลีปหลุดกลางรอบ",
    focus: "งานภาพระดับค่ายใหญ่",
    menus: ["วิดีโอสล็อต", "เล่นลื่นไม่กระตุก"],
    players: 5124,
    icon: "🎰",
  },
  {
    rank: 2,
    name: "สล็อตตัวคูณสะสมโหด",
    type: "ระบบสุ่มแจกตัวคูณ Multiplier ยิ่งหมุนยิ่งคูณหนัก เหมาะกับสายที่ยอมปั่นยาวเพื่อรอจังหวะตัวคูณสะสมขึ้นไปทะลุเพดาน",
    focus: "ยิ่งหมุนยิ่งคูณหนัก",
    menus: ["Multiplier", "สะสมข้ามรอบ"],
    players: 3842,
    icon: "✖️",
  },
  {
    rank: 3,
    name: "สายซื้อฟีเจอร์ฟรีสปิน",
    type: "กดซื้อฟีเจอร์เข้าโหมดฟรีสปินได้ทันทีโดยไม่ต้องรอสัญลักษณ์ครบเอง เหมาะกับคนที่อ่านจังหวะโบนัสออกและอยากลัดเข้าไปเก็บรอบแจก",
    focus: "เข้าฟีเจอร์ได้ทันที",
    menus: ["Buy Feature", "ฟรีสปิน"],
    players: 3517,
    icon: "🛒",
  },
  {
    rank: 4,
    name: "เกมใหม่ที่เพิ่งเข้าคลัง",
    type: "อัปเดตรายชื่อเกมใหม่เข้าคลังต่อเนื่องทันทีที่ค่ายผู้พัฒนาปล่อยตัวเกมออกมา คัดเฉพาะตัวเด็ดแตกง่ายมาเติม ให้ได้ลองฟีเจอร์สดใหม่ก่อนใคร",
    focus: "ของใหม่มาเรื่อยๆ",
    menus: ["เกมมาใหม่", "คัดตัวเด็ด"],
    players: 2905,
    icon: "🆕",
  },
  {
    rank: 5,
    name: "Expanding Wild และ Cascading",
    type: "สัญลักษณ์ไวลด์ขยายเต็มจอกับคอมโบแตกต่อเนื่อง เปลี่ยนการกดหมุนธรรมดาให้กลายเป็นจังหวะทำเงินที่ลุ้นได้ยาวกว่าหนึ่งตาปกติ",
    focus: "ลุ้นต่อเนื่องหลายชั้น",
    menus: ["Expanding Wild", "Cascading"],
    players: 2431,
    icon: "🌟",
  },
  {
    rank: 6,
    name: "ระบบฝากถอนออโต้ไฮสปีด",
    type: "ทำรายการผ่าน Gateway ตรง รองรับทั้งธนาคารและ TrueMoney Wallet ยอดเงินอัปเดตเข้าเกมทันที ไม่ต้องส่งสลิปและไม่ต้องผ่านแอดมิน",
    focus: "เสร็จใน 3 วินาที",
    menus: ["ธนาคาร", "TrueMoney Wallet"],
    players: 2108,
    icon: "⚡",
  },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="แนวเกมและระบบในคลังที่ JAICHUA แยกไว้ให้ดูครบจากที่เดียว" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#6d4a12]/70 bg-[#0a1226]/90 px-6 py-6 text-center shadow-[0_10px_30px_rgba(22,39,78,0.45)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">🎮</span>
    <p class="bg-gradient-to-r from-[#fbeec9] via-[#f6d67e] to-[#5b8ede] bg-clip-text text-2xl font-black tracking-wide text-transparent">แนวเกมและระบบในคลังที่ JAICHUA แยกไว้ให้ดูครบจากที่เดียว</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#a9b7d4]">
      กางให้เห็นครบในหน้าเดียว ทั้งสล็อตวิดีโอ 3D สล็อตตัวคูณสะสม สายซื้อฟีเจอร์ฟรีสปิน เกมใหม่ที่เพิ่งเข้าคลัง ลูกเล่น Expanding Wild กับ Cascading และระบบฝากถอนออโต้ไฮสปีด
      ลำดับความนิยมเปลี่ยนได้ตามช่วงเวลา ควรเปิดดูอัตราจ่าย เงื่อนไขฟีเจอร์ และรายละเอียดโบนัสของแต่ละเกมจากหน้าเกมจริงอีกครั้งก่อนลงเดิมพัน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#d8a83f] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#f6d67e]/55 bg-gradient-to-r from-[#132244]/90 via-[#0a1226]/92 to-[#040915]/90 shadow-[0_15px_40px_rgba(216,168,63,0.2)]"
                : "border-[#6d4a12]/60 bg-[#0a1226]/90 shadow-[0_10px_30px_rgba(22,39,78,0.35)] hover:border-[#d8a83f]/55 hover:shadow-[0_15px_40px_rgba(216,168,63,0.28)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#132244]/80 blur-[40px] transition-all duration-500 group-hover:bg-[#2f5fb0]/45" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#d8a83f] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div
              aria-hidden="true"
              class={`relative z-10 flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border bg-[#040915] text-2xl transition-transform duration-500 group-hover:scale-110 sm:h-16 sm:w-16 sm:text-3xl ${
                top ? "border-[#f6d67e]/60" : "border-[#6d4a12]"
              }`}>
              {g.icon}
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#dce6f8] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#d8a83f]/70 bg-gradient-to-r from-[#f6d67e] to-[#a97722] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#040915] sm:inline">
                    แนวที่คนเข้าเล่นมากที่สุด
                  </span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#a9b7d4] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                <span class="rounded-full border border-[#2f5fb0]/50 bg-[#16336b]/30 px-2.5 py-0.5 text-[10px] font-bold text-[#cfe0fb]">{g.focus}</span>
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#6d4a12] bg-[#132244] px-2.5 py-0.5 text-[10px] font-bold text-[#f6d67e]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#a9b7d4]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#f6d67e] to-[#a97722] text-[#040915] shadow-[0_10px_30px_rgba(216,168,63,0.35)]"
                    : "border border-[#6d4a12] bg-[#132244] text-[#f6d67e] hover:border-[#2f5fb0] hover:bg-[#16336b]/40 hover:text-[#cfe0fb]"
                }`}>
                เข้าเล่นเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // ตัวกันเรื่อง visibility, แท็บพื้นหลัง และ reduced-motion อยู่ใน
  // src/lib/liveCounter.ts ซึ่งเป็นไฟล์ที่การรีแบรนด์ไม่เขียนทับ ห้ามเอา
  // setTimeout เปล่าๆ กลับมาไว้ตรงนี้ — ตัวนับอยู่ในกล่อง `hidden sm:flex`
  // ถ้าไม่มีตัวกัน มันจะปลุก main thread บนมือถือทุกเครื่องเพื่ออัปเดตข้อความ
  // ที่ไม่มีใครมองเห็น
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
