---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// รูปในแต่ละแถวคือ "โลโก้ค่ายพันธมิตร" ไม่ใช่ภาพของโต๊ะนั้น alt จึงบรรยายโลโก้ตาม
// ตัวอักษรที่พิมพ์อยู่บนรูปจริง — game1 = PG (Pocket Games Soft), game2 = SexySlot,
// game3 = SlotXO, game4 = Joker, game5 = JILI, game6 = PP SLOT (Pragmatic Play)
// ห้ามเปลี่ยนค่า `brand` ของแถวโดยไม่เปลี่ยนไฟล์รูปตาม สลับลำดับแถวได้เพราะรูปกับ
// ชื่อค่ายเดินทางไปด้วยกันในอ็อบเจกต์เดียว ส่วน `name`/`type` เป็นชื่อโต๊ะเดิมพันสด
// ซึ่งไม่ได้ผูกกับรูป จึงเปลี่ยนได้อิสระ
//
// MAHAHENG333: ย้ายจากชมพูกลอสคู่ทองของ GALA89 (#ff4d9c / #d41c6b / #9e154a คู่ทอง
// #ffe0a3 / #f0c274 / #b8801f บนผิว #1f0311 / #12010a / #3c0214 เนื้อความ #f7dce8
// ข้อความรอง #f9a8cd) มาที่ทองมังกรจีนบนดำ — ทอง #ffe98a / #e8b923 / #a5760a คู่แดง
// #b4231c / #6d1410 บนผิว #221708 / #15100a / #0a0704 / #33230b เนื้อความ #f3e2b8
// ข้อความรอง #c2a469 โดยแถวอันดับหนึ่งรับแดงมงคล #b4231c / #6d1410 คู่ขอบทอง
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อแถวก็เป็น <p> เช่นกัน — ไม่มีตัวไหนเป็นหัวข้อจาก docx
// กระดานนี้ต่อท้าย section ของ docx เรื่องบาคาร่า/รูเล็ตเลือกห้องได้ตามสไตล์ จึงเน้น
// ประเภทโต๊ะและจังหวะเกมของแต่ละห้อง
const games = [
  { rank: 1, name: "บาคาร่าห้องมหาเฮง", type: "บาคาร่าสด • โต๊ะสปีดเกมไว", brand: "PP SLOT (Pragmatic Play)", menus: ["ดีลเลอร์สดตลอด 24 ชม.", "มีสถิติเค้าไพ่ย้อนหลัง"], players: 5124, img: img6 },
  { rank: 2, name: "รูเล็ตวงล้อทองคำ", type: "รูเล็ตสด • ลุ้นวงล้อเรียลไทม์", brand: "Joker", menus: ["ภาพคมชัดระดับ HD", "เลือกโต๊ะได้ไม่มีเต็ม"], players: 3842, img: img4 },
  { rank: 3, name: "เสือมังกรตัดสินไว", type: "เสือมังกร • รอบสั้นรู้ผลเร็ว", brand: "JILI", menus: ["กติกาไม่ซับซ้อน", "สลับโต๊ะได้ในคลิกเดียว"], players: 3517, img: img5 },
  { rank: 4, name: "ไฮโลเขย่าสดหน้าโต๊ะ", type: "ไฮโลสด • เห็นการเขย่าทุกตา", brand: "SexySlot", menus: ["สตรีมไร้ดีเลย์", "เสียงบรรยากาศฟลอร์จริง"], players: 2905, img: img2 },
  { rank: 5, name: "บาคาร่าห้องบรรยากาศสบาย", type: "บาคาร่าสด • โต๊ะจังหวะช้า", brand: "PG (Pocket Games Soft)", menus: ["เหมาะกับสายวางแผน", "ดูสถิติก่อนลงเดิมพัน"], players: 2431, img: img1 },
  { rank: 6, name: "โต๊ะรวมมิตรเกมสด", type: "เกมสดหลายสไตล์ • เปลี่ยนฟีลได้ไว", brand: "SlotXO", menus: ["ไม่ต้องโยกเงินข้ามห้อง", "เปิดให้เข้าตลอดทั้งวัน"], players: 2108, img: img3 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="โต๊ะเกมสดมาแรงที่สมาชิก MAHAHENG333 กำลังนั่งอยู่ตอนนี้" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#e8b923]/35 bg-[#221708]/88 px-6 py-6 text-center shadow-[0_10px_30px_rgba(232,185,35,0.22)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">🎴</span>
    <p class="bg-gradient-to-r from-[#ffe98a] via-[#e8b923] to-[#a5760a] bg-clip-text text-2xl font-black tracking-wide text-transparent">
      โต๊ะเกมสดมาแรงที่สมาชิก MAHAHENG333 กำลังนั่งอยู่ตอนนี้
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#c2a469]">
      กระดานนี้จับโต๊ะเดิมพันสดที่คนเข้าเยอะที่สุดมาเรียงไว้ในล็อบบี้เดียว กดสลับห้องได้ตลอดทั้งวันในบัญชีเดียวโดยไม่ต้องโยกเงินหรือออกจากระบบ รายชื่อโต๊ะมาแรงเปลี่ยนได้ตามช่วงเวลา
      ควรเปิดดูเดิมพันขั้นต่ำและกติกาของแต่ละโต๊ะจากหน้าห้องจริงอีกครั้งก่อนลงเดิมพัน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e8b923] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#ffe98a]/60 bg-gradient-to-r from-[#6d1410]/60 via-[#221708]/92 to-[#0a0704]/88 shadow-[0_15px_40px_rgba(232,185,35,0.28)]"
                : "border-[#e8b923]/30 bg-[#221708]/88 shadow-[0_10px_30px_rgba(232,185,35,0.18)] hover:border-[#e8b923]/55 hover:shadow-[0_15px_40px_rgba(232,185,35,0.32)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#b4231c]/35 blur-[40px] transition-all duration-500 group-hover:bg-[#e8b923]/35" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {/* อันดับ 1–3 แสดงเหรียญ "แทน" ตัวเลข ถ้าซ่อนอิโมจิเฉยๆ สามแถวนั้นจะไม่
                  เหลืออันดับให้อ่านเลย ข้อความ sr-only จึงใส่กลับเข้าไป */}
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#e8b923] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#ffe98a]/60" : "border-[#e8b923]/35"}`}>
              <Picture
                src={g.img}
                alt={`โลโก้ค่ายเกมพันธมิตร ${g.brand} ที่อยู่ในล็อบบี้คาสิโนสดของ MAHAHENG333`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#f3e2b8] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#ffe98a]/70 bg-gradient-to-r from-[#ffe98a] to-[#e8b923] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#0a0704] sm:inline">
                    มาแรงสูงสุด
                  </span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#c2a469] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#e8b923]/30 bg-[#0a0704] px-2.5 py-0.5 text-[10px] font-bold text-[#e8b923]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#c2a469]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ffe98a] to-[#e8b923] text-[#0a0704] shadow-[0_10px_30px_rgba(232,185,35,0.35)]"
                    : "border border-[#e8b923]/60 bg-[#0a0704] text-[#e8b923] hover:border-[#ffe98a] hover:bg-[#33230b] hover:text-[#ffe98a]"
                }`}>
                เข้าดูโต๊ะ
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // ตัวกันเรื่อง visibility, แท็บพื้นหลัง และ reduced-motion อยู่ใน
  // src/lib/liveCounter.ts ซึ่งเป็นไฟล์ที่การรีแบรนด์ไม่เขียนทับ ห้ามเอา
  // setTimeout เปล่าๆ กลับมาไว้ตรงนี้ — ตัวนับอยู่ในกล่อง `hidden sm:flex`
  // ถ้าไม่มีตัวกัน มันจะปลุก main thread บนมือถือทุกเครื่องเพื่ออัปเดตข้อความ
  // ที่ไม่มีใครมองเห็น
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
