---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// รูปในแต่ละแถวคือ "โลโก้ค่ายพันธมิตร" ไม่ใช่ภาพของเกมนั้น alt จึงบรรยายโลโก้ตาม
// ตัวอักษรที่พิมพ์อยู่บนรูปจริง — game1 = PG (Pocket Games Soft), game2 = SexySlot,
// game3 = SlotXO, game4 = Joker, game5 = JILI, game6 = PP SLOT (Pragmatic Play)
// ห้ามเปลี่ยนค่า `brand` ของแถวโดยไม่เปลี่ยนไฟล์รูปตาม สลับลำดับแถวได้เพราะรูปกับ
// ชื่อค่ายเดินทางไปด้วยกันในอ็อบเจกต์เดียว ส่วน `name`/`type` เป็นชื่อห้องเกมสล็อต
// ซึ่งไม่ได้ผูกกับรูป จึงเปลี่ยนได้อิสระ
//
// DEKDDD: ย้ายจากชุดสีของแบรนด์ก่อนหน้ามาที่ทองคู่แดง — ทองหลัก #ffe08a / #eebb1a
// / #a3760a คู่แดง #e01f26 / #a80d10 / #5c0201 บนผิว #2a0806 / #1a0503 / #0b0100
// เนื้อความ #f7e7c8 ทองยังเป็นสีหลักของกริดเหมือนเดิม ส่วนแถวอันดับหนึ่งรับคู่แดง
// เพื่อให้ตัดกับแถวที่เหลือ จุด live สีเขียวเป็นสีเชิงความหมาย ไม่ถูกแตะ (ค่า hex
// เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์
// จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อแถวก็เป็น <p> เช่นกัน — ไม่มีตัวไหนเป็นหัวข้อจาก docx
// กระดานนี้เน้นเกมฮิตติดล็อบบี้กับตัวใหม่ที่สลับเข้ามาให้ลอง ตามที่ brief ของ
// แบรนด์นี้พูดไว้ ไม่ใช่การชูอัตราจ่ายของเกมใดเกมหนึ่ง
//
// อันดับ 1–3 แสดงเหรียญ "แทน" ตัวเลข ถ้าซ่อนอิโมจิเฉยๆ สามแถวนั้นจะไม่เหลืออันดับ
// ให้อ่านเลย ข้อความ sr-only จึงใส่กลับเข้าไปคู่กับ aria-hidden
const games = [
  {
    rank: 1,
    name: "ห้องเกมฮิตติดล็อบบี้ระดับตำนาน",
    type: "สล็อตยอดฮิต • ตัวเต็งที่เปิดเข้ามาก็เจอ",
    brand: "PP SLOT (Pragmatic Play)",
    menus: ["ภาพสวยเล่นลื่นไม่มีสะดุด", "โบนัสมาแบบสม่ำเสมอ"],
    players: 5124,
    img: img6,
  },
  {
    rank: 2,
    name: "ห้องแฟนตาซีสายเอ็นจอย",
    type: "สล็อตแฟนตาซี • บรรยากาศสบายตาเล่นได้ยาว",
    brand: "Joker",
    menus: ["ดีไซน์อ่านง่ายไม่กดดัน", "รอบโบนัสเข้าถึงได้ง่าย"],
    players: 3842,
    img: img4,
  },
  {
    rank: 3,
    name: "ห้องรอบสั้นตัดสินไว",
    type: "สล็อตจังหวะกระชับ • รู้ผลไวไม่ต้องรอนาน",
    brand: "JILI",
    menus: ["สลับเข้าเกมได้แทบไม่ต้องรอ", "เหมาะกับสายปั่นชิลๆ"],
    players: 3517,
    img: img5,
  },
  {
    rank: 4,
    name: "ห้องเกมมาใหม่ล่าสุดจากค่ายชั้นนำ",
    type: "สล็อตมาใหม่ • สลับสับเปลี่ยนเข้ามาตลอด",
    brand: "SexySlot",
    menus: ["มีตัวใหม่ให้ลองไม่จำเจ", "เปลี่ยนบรรยากาศได้ทั้งวัน"],
    players: 2905,
    img: img2,
  },
  {
    rank: 5,
    name: "ห้องฟรีสปินและตัวคูณรางวัล",
    type: "สล็อตฟีเจอร์เด่น • โหมดฟรีสปินออกบ่อย",
    brand: "PG (Pocket Games Soft)",
    menus: ["ตัวคูณรางวัลสุดพิเศษ", "จังหวะหมุนน่าลุ้นขึ้น"],
    players: 2431,
    img: img1,
  },
  {
    rank: 6,
    name: "ห้องเลือกเกมให้ตรงสไตล์",
    type: "สล็อตคัดพิเศษ • ทั้งสายภาพสวยและสายรางวัลใหญ่",
    brand: "SlotXO",
    menus: ["เปิดให้เข้าตลอดทั้งวัน", "ระบบตอบสนองไวไร้รอยต่อ"],
    players: 2108,
    img: img3,
  },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="ห้องเกมสล็อตมาแรงที่สมาชิก DEKDDD กำลังปั่นอยู่ตอนนี้" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#eebb1a]/35 bg-[#1a0503]/88 px-6 py-6 text-center shadow-[0_10px_30px_rgba(238,187,26,0.22)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">🎰</span>
    <p class="bg-gradient-to-r from-[#fff6dd] via-[#eebb1a] to-[#e01f26] bg-clip-text text-2xl font-black tracking-wide text-transparent">ห้องเกมสล็อตมาแรงที่สมาชิก DEKDDD กำลังปั่นอยู่ตอนนี้</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#f7e7c8]/80">
      กระดานนี้จับห้องเกมที่คนเข้าเยอะที่สุดในล็อบบี้มาเรียงไว้ในหน้าเดียว กดสลับค่ายได้ตลอดทั้งวันในบัญชีเดียวโดยไม่ต้องโยกเงินหรือออกจากระบบ รายชื่อห้องมาแรงเปลี่ยนได้ตามช่วงเวลา
      ควรเปิดดูเบทขั้นต่ำและเงื่อนไขฟีเจอร์ของแต่ละเกมจากหน้าเกมจริงอีกครั้งก่อนลงเดิมพัน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#eebb1a] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#e01f26]/60 bg-gradient-to-r from-[#5c0201]/80 via-[#1a0503]/92 to-[#0b0100]/88 shadow-[0_15px_40px_rgba(168,13,16,0.35)]"
                : "border-[#eebb1a]/30 bg-[#1a0503]/88 shadow-[0_10px_30px_rgba(238,187,26,0.18)] hover:border-[#eebb1a]/55 hover:shadow-[0_15px_40px_rgba(238,187,26,0.32)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#a80d10]/35 blur-[40px] transition-all duration-500 group-hover:bg-[#eebb1a]/35" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#eebb1a] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#e01f26]/60" : "border-[#eebb1a]/35"}`}>
              <Picture
                src={g.img}
                alt={`โลโก้ค่ายเกมพันธมิตร ${g.brand} ที่อยู่ในล็อบบี้เกมสล็อตของ DEKDDD`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#f7e7c8] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#ffe08a]/70 bg-gradient-to-r from-[#ffe08a] to-[#eebb1a] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#1a0503] sm:inline">
                    มาแรงสูงสุด
                  </span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#f7e7c8]/75 sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#eebb1a]/30 bg-[#0b0100] px-2.5 py-0.5 text-[10px] font-bold text-[#ffe08a]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#f7e7c8]/75">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ffe08a] to-[#eebb1a] text-[#1a0503] shadow-[0_10px_30px_rgba(238,187,26,0.35)]"
                    : "border border-[#eebb1a]/60 bg-[#0b0100] text-[#ffe08a] hover:border-[#e01f26] hover:bg-[#2a0806] hover:text-[#fff6dd]"
                }`}>
                เข้าดูเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // ตัวกันเรื่อง visibility, แท็บพื้นหลัง และ reduced-motion อยู่ใน
  // src/lib/liveCounter.ts ซึ่งเป็นไฟล์ที่การรีแบรนด์ไม่เขียนทับ ห้ามเอา
  // setTimeout เปล่าๆ กลับมาไว้ตรงนี้ — ตัวนับอยู่ในกล่อง `hidden sm:flex`
  // ถ้าไม่มีตัวกัน มันจะปลุก main thread บนมือถือทุกเครื่องเพื่ออัปเดตข้อความ
  // ที่ไม่มีใครมองเห็น
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
