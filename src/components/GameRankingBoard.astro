---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// รูปในแต่ละแถวคือ "โลโก้ค่ายพันธมิตร" ไม่ใช่ภาพของเกมนั้น alt จึงบรรยายโลโก้ตาม
// ตัวอักษรที่พิมพ์อยู่บนรูปจริง — game1 = PG (Pocket Games Soft), game2 = SexySlot,
// game3 = SlotXO, game4 = Joker, game5 = JILI, game6 = PP SLOT (Pragmatic Play)
// ห้ามเปลี่ยนค่า `brand` ของแถวโดยไม่เปลี่ยนไฟล์รูปตาม สลับลำดับแถวได้เพราะรูปกับ
// ชื่อค่ายเดินทางไปด้วยกันในอ็อบเจกต์เดียว ส่วน `name`/`type` เป็นชื่อหมวดเกม
// ซึ่งไม่ได้ผูกกับรูป จึงเปลี่ยนได้อิสระ
//
// XTOP666: ชุดสีเป็นส้มเรซซิ่งคู่แดงหลอมเหลวบนดำอมแดงตามอาร์ตจริง ส้มเป็นสีหลัก
// ของกระดาน ส่วนแถวอันดับหนึ่งรับคู่แดงเพื่อให้ตัดกับแถวที่เหลือ จุด live สีเขียว
// Tailwind เป็นสีเชิงความหมาย ไม่ถูกแตะ (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ —
// Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มี
// ใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อแถวก็เป็น <p> เช่นกัน — ไม่มีตัวไหนเป็นหัวข้อจาก docx
// กระดานนี้เป็นภาพประกอบของหัวข้อ docx เรื่องระบบพร้อมบวกที่วางทุกเมนูให้หยิบใช้
// คล่อง จึงกางเมนูหมวดเกมที่ล็อบบี้แยกไว้ทั้งหมดให้เห็นในหน้าเดียวว่าไม่ต้องคลิกวนหา
//
// อันดับ 1–3 แสดงเหรียญ "แทน" ตัวเลข ถ้าซ่อนอิโมจิเฉยๆ สามแถวนั้นจะไม่เหลืออันดับ
// ให้อ่านเลย ข้อความ sr-only จึงใส่กลับเข้าไปคู่กับ aria-hidden
const games = [
  {
    rank: 1,
    name: "หมวดเกมมาแรงประจำรอบ",
    type: "รวมเกมที่คนกดเข้ามากที่สุดในรอบนี้ • วางไว้หน้าสุดให้หยิบใช้ได้ทันทีโดยไม่ต้องคลิกวนหา",
    brand: "PP SLOT (Pragmatic Play)",
    menus: ["มาแรงประจำรอบ", "กดใช้ได้ทันที"],
    players: 5124,
    img: img6,
  },
  {
    rank: 2,
    name: "หมวดแยกตามค่ายเกมดัง",
    type: "จัดเรียงตามค่ายชั้นนำที่ลิงก์ตรงพาเข้าถึงได้ในคลิกเดียว อยากเล่นค่ายไหนกดเข้าหมวดนั้นได้เลย",
    brand: "Joker",
    menus: ["แยกตามค่าย", "เข้าถึงในคลิกเดียว"],
    players: 3842,
    img: img4,
  },
  {
    rank: 3,
    name: "หมวดสายสะสมตัวคูณ",
    type: "สำหรับคนที่เล็งตัวคูณสูงเป็นหลัก • ไล่รอบสปินยาวได้โดยจังหวะเกมไม่มีสะดุด",
    brand: "JILI",
    menus: ["สะสมตัวคูณ", "สปินต่อเนื่อง"],
    players: 3517,
    img: img5,
  },
  {
    rank: 4,
    name: "หมวดแฟนตาซีภาพ 3D",
    type: "กราฟิกแสดงผลเต็มตาอลังการ เอฟเฟกต์ครบ แต่ยังโหลดเข้าเกมได้ไวตั้งแต่คลิกแรก",
    brand: "SexySlot",
    menus: ["ภาพ 3D", "โหลดไว"],
    players: 2905,
    img: img2,
  },
  {
    rank: 5,
    name: "หมวดเกมมาใหม่ที่เพิ่งเข้าล็อบบี้",
    type: "ไว้สำหรับวันที่อยากเปลี่ยนแนวไปปั่นเกมใหม่ ไม่ต้องเลื่อนหาเองทีละค่าย",
    brand: "PG (Pocket Games Soft)",
    menus: ["ของใหม่ล่าสุด", "เปลี่ยนแนวได้ไว"],
    players: 2431,
    img: img1,
  },
  {
    rank: 6,
    name: "หมวดเกมโปรดที่กลับมาเล่นซ้ำ",
    type: "กลับมาเล่นเกมประจำได้ในไม่กี่คลิก ไม่ต้องคลิกวนหาหลายชั้นให้เสียเวลา",
    brand: "SlotXO",
    menus: ["กลับมาเล่นซ้ำ", "ไม่กี่คลิก"],
    players: 2108,
    img: img3,
  },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดหมู่เกมที่ XTOP666 วางไว้ในล็อบบี้ให้หยิบใช้ได้คล่อง" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#d94a02]/40 bg-[#1a0603]/88 px-6 py-6 text-center shadow-[0_10px_30px_rgba(252,91,3,0.28)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">🎰</span>
    <p class="bg-gradient-to-r from-[#fff0e6] via-[#fc5b03] to-[#d94a02] bg-clip-text text-2xl font-black tracking-wide text-transparent">หมวดหมู่เกมในล็อบบี้ XTOP666 ที่กดหยิบใช้ได้คล่องโดยไม่ต้องวนหา</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#c9a394]">
      อินเทอร์เฟซวางตำแหน่งเมนูสำคัญไว้อย่างเป็นระเบียบชัดเจน แยกตามประเภทเกม ค่ายเกม และหมวดที่กำลังมาแรง กางไว้ในหน้าเดียวให้เลื่อนดูได้ครบ ทั้งหมวดแฟนตาซีภาพ 3D หมวดสายสะสมตัวคูณ
      หมวดของมาใหม่ และหมวดเกมโปรดที่กลับมาเล่นซ้ำ ลำดับความนิยมเปลี่ยนได้ตามช่วงเวลา ควรเปิดดูอัตราการจ่ายและรายละเอียดฟีเจอร์ของแต่ละเกมจากหน้าเกมจริงอีกครั้งก่อนลงเดิมพัน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fc5b03] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#ff5a4d]/60 bg-gradient-to-r from-[#2e0c04]/80 via-[#1a0603]/92 to-[#0a0403]/88 shadow-[0_15px_40px_rgba(225,18,18,0.25)]"
                : "border-[#d94a02]/35 bg-[#1a0603]/88 shadow-[0_10px_30px_rgba(252,91,3,0.2)] hover:border-[#fc5b03]/55 hover:shadow-[0_15px_40px_rgba(252,91,3,0.32)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#7a0101]/70 blur-[40px] transition-all duration-500 group-hover:bg-[#fc5b03]/35" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#ffc9a3] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#ff5a4d]/60" : "border-[#d94a02]/40"}`}>
              <Picture
                src={g.img}
                alt={`โลโก้ค่ายเกมพันธมิตร ${g.brand} ที่อยู่ในลิสต์ค่ายดังของ XTOP666`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#f6e5dc] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#ff5a4d]/70 bg-gradient-to-r from-[#ffb9b0] to-[#ff5a4d] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#0a0403] sm:inline">
                    มาแรงสูงสุด
                  </span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#c9a394] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#d94a02]/40 bg-[#0a0403] px-2.5 py-0.5 text-[10px] font-bold text-[#ffc9a3]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#c9a394]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ffb9b0] to-[#ff5a4d] text-[#0a0403] shadow-[0_10px_30px_rgba(225,18,18,0.35)]"
                    : "border border-[#d94a02]/60 bg-[#0a0403] text-[#ffc9a3] hover:border-[#fc5b03] hover:bg-[#2e0c04] hover:text-[#fff0e6]"
                }`}>
                เข้าเล่นเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // ตัวกันเรื่อง visibility, แท็บพื้นหลัง และ reduced-motion อยู่ใน
  // src/lib/liveCounter.ts ซึ่งเป็นไฟล์ที่การรีแบรนด์ไม่เขียนทับ ห้ามเอา
  // setTimeout เปล่าๆ กลับมาไว้ตรงนี้ — ตัวนับอยู่ในกล่อง `hidden sm:flex`
  // ถ้าไม่มีตัวกัน มันจะปลุก main thread บนมือถือทุกเครื่องเพื่ออัปเดตข้อความ
  // ที่ไม่มีใครมองเห็น
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
