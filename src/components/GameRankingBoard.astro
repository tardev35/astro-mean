---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// รูปในแต่ละแถวคือ "โลโก้ค่ายพันธมิตร" ไม่ใช่ภาพของเกมนั้น alt จึงบรรยายโลโก้ตาม
// ตัวอักษรที่พิมพ์อยู่บนรูปจริง — game1 = PG (Pocket Games Soft) ซึ่งก็คือ PG Soft
// ในบรีฟ, game2 = SexySlot, game3 = SlotXO, game4 = Joker ซึ่งก็คือ Joker Gaming,
// game5 = JILI, game6 = PP SLOT ซึ่งก็คือ Pragmatic Play
// ห้ามเปลี่ยนค่า `brand` ของแถวโดยไม่เปลี่ยนไฟล์รูปตาม สลับลำดับแถวได้เพราะรูปกับ
// ชื่อค่ายเดินทางไปด้วยกันในอ็อบเจกต์เดียว ส่วน `name`/`type` เป็นชื่อหมวดเกม
// ซึ่งไม่ได้ผูกกับรูป จึงเปลี่ยนได้อิสระ
//
// TITANWIN168: ชุดสีย้ายมาที่ม่วงไททันคู่มงกุฎทองตามอาร์ตจริง ม่วงเป็นสีหลักของ
// กระดาน ส่วนแถวอันดับหนึ่งรับคู่ทองเพื่อให้ตัดกับแถวที่เหลือ จุด live สีเขียว
// Tailwind เป็นสีเชิงความหมาย ไม่ถูกแตะ (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ —
// Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มี
// ใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อแถวก็เป็น <p> เช่นกัน — ไม่มีตัวไหนเป็นหัวข้อจาก docx
// กระดานนี้เป็นภาพประกอบของหัวข้อ docx ข้อ 5 เรื่องโบนัสแตกดีมีทรงให้ลุ้น จึงกางเกม
// ตัวเด่นที่มีทรงโบนัสดีกับฟีเจอร์ที่พาไปถึงโบนัสให้เห็นครบในหน้าเดียว
//
// อันดับ 1–3 แสดงเหรียญ "แทน" ตัวเลข ถ้าซ่อนอิโมจิเฉยๆ สามแถวนั้นจะไม่เหลืออันดับ
// ให้อ่านเลย ข้อความ sr-only จึงใส่กลับเข้าไปคู่กับ aria-hidden
const games = [
  {
    rank: 1,
    name: "หมวดเกมตัวเด่นทรงโบนัสแตกดี",
    type: "คัดเฉพาะเกมที่มีทรงโบนัสแตกดีและโครงสร้างการแจกรางวัลน่าสนใจ • ให้ลุ้นกำไรก้อนโตแบบมีทิศทาง ไม่ใช่หมุนวงล้อไปเรื่อยๆ",
    brand: "Pragmatic Play",
    menus: ["ทรงโบนัสแตกดี", "ลุ้นแบบมีทิศทาง"],
    players: 5124,
    img: img6,
  },
  {
    rank: 2,
    name: "หมวดจังหวะเข้ารอบฟรีสปินไว",
    type: "รวมเกมที่กดเข้ารอบฟรีสปินได้ไว ไม่ต้องนั่งสปินเปล่ายาวกว่าจะได้ลุ้นรอบโบนัสสักที",
    brand: "Joker Gaming",
    menus: ["ฟรีสปินเข้าไว", "ไม่ต้องรอนาน"],
    players: 3842,
    img: img4,
  },
  {
    rank: 3,
    name: "หมวดฟีเจอร์ Multipliers ตัวคูณสะสม",
    type: "รวมเกมที่มีตัวคูณสะสมแบบทวีคูณ • ยิ่งต่อยอดในรอบเดียวกัน ยอดรางวัลยิ่งถูกคูณขึ้นไปอีกชั้น",
    brand: "JILI",
    menus: ["Multipliers", "ตัวคูณสะสม"],
    players: 3517,
    img: img5,
  },
  {
    rank: 4,
    name: "หมวดระบบ Cascading สัญลักษณ์แตกต่อเนื่อง",
    type: "สัญลักษณ์แตกต่อเนื่องภายในสปินเดียว ยิ่งต่อยาวยิ่งได้ลุ้นรางวัลก้อนโตแบบไม่ต้องเริ่มรอบใหม่",
    brand: "SexySlot",
    menus: ["Cascading", "แตกต่อเนื่อง"],
    players: 2905,
    img: img2,
  },
  {
    rank: 5,
    name: "หมวดรีลขยาย Wild ซ้อนทับ",
    type: "Wild ขยายซ้อนทับคลุมรีลทั้งแถบ เปิดโอกาสให้ไลน์รางวัลเข้าพร้อมกันได้หลายเส้นในสปินเดียว",
    brand: "PG Soft (Pocket Games Soft)",
    menus: ["รีลขยาย Wild", "ซ้อนทับทั้งรีล"],
    players: 2431,
    img: img1,
  },
  {
    rank: 6,
    name: "หมวดโหมด Buy Feature ซื้อฟรีสปิน",
    type: "สายใจร้อนกดซื้อฟรีสปินพุ่งตรงเข้าลุ้นโบนัสก้อนใหญ่ได้ทันที ไม่ต้องรอสุ่มเข้าฟีเจอร์เอง",
    brand: "SlotXO",
    menus: ["Buy Feature", "ซื้อฟรีสปิน"],
    players: 2108,
    img: img3,
  },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="เกมตัวเด่นทรงโบนัสแตกดีที่ TITANWIN168 คัดมาไว้ในคลัง" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#6d28d9]/40 bg-[#22104a]/88 px-6 py-6 text-center shadow-[0_10px_30px_rgba(109,40,217,0.28)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">🔥</span>
    <p class="bg-gradient-to-r from-[#ede4ff] via-[#f2dda3] to-[#a855f7] bg-clip-text text-2xl font-black tracking-wide text-transparent">เกมตัวเด่นทรงโบนัสแตกดีที่ TITANWIN168 คัดมาไว้ในคลัง</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#a396c9]">
      กางให้เห็นครบในหน้าเดียว ทั้งหมวดเกมตัวเด่นทรงโบนัสแตกดี หมวดจังหวะเข้ารอบฟรีสปินไว หมวดฟีเจอร์ Multipliers ตัวคูณสะสม หมวดระบบ Cascading สัญลักษณ์แตกต่อเนื่อง หมวดรีลขยาย Wild ซ้อนทับ
      และหมวดโหมด Buy Feature ซื้อฟรีสปิน เลื่อนดูได้ครบทุกแนว ลำดับความนิยมเปลี่ยนได้ตามช่วงเวลา ควรเปิดดูอัตราการจ่ายและรายละเอียดฟีเจอร์ของแต่ละเกมจากหน้าเกมจริงอีกครั้งก่อนลงเดิมพัน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e3c176] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#e3c176]/55 bg-gradient-to-r from-[#2e1065]/80 via-[#22104a]/92 to-[#0a0417]/88 shadow-[0_15px_40px_rgba(227,193,118,0.18)]"
                : "border-[#6d28d9]/35 bg-[#22104a]/88 shadow-[0_10px_30px_rgba(109,40,217,0.2)] hover:border-[#a855f7]/55 hover:shadow-[0_15px_40px_rgba(168,85,247,0.3)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#2e1065]/70 blur-[40px] transition-all duration-500 group-hover:bg-[#7c3aed]/35" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#a855f7] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#e3c176]/60" : "border-[#6d28d9]/40"}`}>
              <Picture
                src={g.img}
                alt={`โลโก้ค่ายเกมลิขสิทธิ์ ${g.brand} ที่อยู่ในคลังเกมของ TITANWIN168`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#ddd2f5] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#e3c176]/70 bg-gradient-to-r from-[#dfe4f0] to-[#f2dda3] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#0a0417] sm:inline">
                    ทรงโบนัสมาแรงล่าสุด
                  </span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#a396c9] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#6d28d9]/40 bg-[#160a2b] px-2.5 py-0.5 text-[10px] font-bold text-[#a855f7]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#a396c9]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#c084fc] to-[#7c3aed] text-[#0a0417] shadow-[0_10px_30px_rgba(168,85,247,0.35)]"
                    : "border border-[#6d28d9]/60 bg-[#160a2b] text-[#a855f7] hover:border-[#e3c176] hover:bg-[#2e1065] hover:text-[#ede4ff]"
                }`}>
                เข้าเล่นเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // ตัวกันเรื่อง visibility, แท็บพื้นหลัง และ reduced-motion อยู่ใน
  // src/lib/liveCounter.ts ซึ่งเป็นไฟล์ที่การรีแบรนด์ไม่เขียนทับ ห้ามเอา
  // setTimeout เปล่าๆ กลับมาไว้ตรงนี้ — ตัวนับอยู่ในกล่อง `hidden sm:flex`
  // ถ้าไม่มีตัวกัน มันจะปลุก main thread บนมือถือทุกเครื่องเพื่ออัปเดตข้อความ
  // ที่ไม่มีใครมองเห็น
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
