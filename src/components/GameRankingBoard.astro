---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// รูปในแต่ละแถวคือ "โลโก้ค่ายพันธมิตร" ไม่ใช่ภาพของเกมนั้น alt จึงบรรยายโลโก้ตาม
// ตัวอักษรที่พิมพ์อยู่บนรูปจริง — game1 = PG (Pocket Games Soft), game2 = SexySlot,
// game3 = SlotXO, game4 = Joker, game5 = JILI, game6 = PP SLOT (Pragmatic Play)
// ห้ามเปลี่ยนค่า `brand` ของแถวโดยไม่เปลี่ยนไฟล์รูปตาม สลับลำดับแถวได้เพราะรูปกับ
// ชื่อค่ายเดินทางไปด้วยกันในอ็อบเจกต์เดียว ส่วน `name`/`type` เป็นชื่อโหมดเกม
// ซึ่งไม่ได้ผูกกับรูป จึงเปลี่ยนได้อิสระ
//
// VIREL168: ย้ายชุดสีมาที่ทองของแบรนด์นี้ที่วัดจากอาร์ตจริง — ทอง #faca4c /
// #ebb134 / #e2a52d / #ffeec2 / #855a14 คู่เงินโครเมียม #e1e1e1 / #949494 บนผิว
// #0a0501 / #1b0d02 ขอบ/แถบยก #2e1a04 / #442503 เนื้อความ #f4e7cd ข้อความรอง
// #c4ab7d หมึกบนป้ายทอง #0a0501 ทองเป็นสีหลักของกระดาน ส่วนแถวอันดับหนึ่งรับทอง
// สว่างเต็มเพื่อให้ตัดกับแถวที่เหลือ จุด live สีเขียว Tailwind เป็นสีเชิงความหมาย
// ไม่ถูกแตะ (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของ
// เดิมได้จาก git history)
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อแถวก็เป็น <p> เช่นกัน — ไม่มีตัวไหนเป็นหัวข้อจาก docx
// กระดานนี้เป็นภาพประกอบของหัวข้อ docx ข้อ 1 (เกมฮิตมาแรงตัวไหนควรเก็บเข้าลิสต์)
// จึงเน้นไลน์อัปเกมฮิตระดับตัวตึงที่สายปั่นกำลังตามอยู่ตอนนี้
//
// อันดับ 1–3 แสดงเหรียญ "แทน" ตัวเลข ถ้าซ่อนอิโมจิเฉยๆ สามแถวนั้นจะไม่เหลืออันดับ
// ให้อ่านเลย ข้อความ sr-only จึงใส่กลับเข้าไปคู่กับ aria-hidden
const games = [
  {
    rank: 1,
    name: "เกมฮิตระดับตัวตึงที่สายปั่นตามมากที่สุด",
    type: "อัตราการจ่ายเงินรางวัลดีเยี่ยม ลุ้นรอบแจ็คพอตง่าย • เป็นลิสต์เกมเด็ดที่ควรเซฟไว้ในใจ",
    brand: "PP SLOT (Pragmatic Play)",
    menus: ["คนเข้าปั่นเยอะที่สุด", "ลุ้นแจ็คพอตง่าย"],
    players: 5124,
    img: img6,
  },
  {
    rank: 2,
    name: "เกมแนวแอ็กชันฟีเจอร์ตัวคูณสะสมทวีคูณ",
    type: "จังหวะโบนัสระเบิดไวสำหรับสายเก็บกำไรสั้น • ตัวคูณสะสมทบขึ้นเรื่อยๆ ในรอบเดียว",
    brand: "Joker",
    menus: ["ตัวคูณสะสมทวีคูณ", "โบนัสระเบิดไว"],
    players: 3842,
    img: img4,
  },
  {
    rank: 3,
    name: "สล็อตธีมผจญภัยสุดอลังการงานภาพจัดเต็ม",
    type: "ค่ายที่ขึ้นชื่อเรื่องภาพสวยสมจริง • เปิดล็อบบี้เดียวสลับสไตล์เกมได้อิสระ",
    brand: "JILI",
    menus: ["ธีมผจญภัยอลังการ", "ภาพสวยสมจริง"],
    players: 3517,
    img: img5,
  },
  {
    rank: 4,
    name: "เกมน่าค้นที่ฟรีสปินออกง่ายเกินคาด",
    type: "เกมนอกกระแสที่ซ่อนลูกเล่นไว้ • สัญลักษณ์พิเศษเปลี่ยนรางวัลธรรมดาเป็นก้อนโต",
    brand: "SexySlot",
    menus: ["ฟรีสปินออกง่าย", "สัญลักษณ์พิเศษ"],
    players: 2905,
    img: img2,
  },
  {
    rank: 5,
    name: "หมวดเกมมาใหม่ที่เข้าล็อบบี้ต่อเนื่อง",
    type: "ค่ายชั้นนำส่งเกมใหม่เข้าเรื่อยๆ ตลอดปี • ระบบลื่นไหลไร้ปัญหากระตุกทุกรอบหมุน",
    brand: "PG (Pocket Games Soft)",
    menus: ["เกมใหม่เข้าต่อเนื่อง", "ระบบลื่นไหลไม่กระตุก"],
    players: 2431,
    img: img1,
  },
  {
    rank: 6,
    name: "รวมทุกค่ายไว้ในยูสเซอร์เดียวกัน",
    type: "จัดหมวดหมู่ชัดเจน สลับค่ายได้ในไม่กี่คลิก • โอนเข้าบัญชีภายในไม่กี่วินาที",
    brand: "SlotXO",
    menus: ["สลับค่ายคล่อง", "โอนไวเข้าบัญชี"],
    players: 2108,
    img: img3,
  },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="เกมฮิตที่สมาชิก VIREL168 กำลังตามปั่นอยู่ตอนนี้" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#e2a52d]/35 bg-[#1b0d02]/88 px-6 py-6 text-center shadow-[0_10px_30px_rgba(226,165,45,0.25)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">🎰</span>
    <p class="bg-gradient-to-r from-[#fff8e4] via-[#ffeec2] to-[#e2a52d] bg-clip-text text-2xl font-black tracking-wide text-transparent">เกมฮิตที่สมาชิก VIREL168 กำลังตามปั่นอยู่ตอนนี้</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#c4ab7d]">
      กระดานนี้จับไลน์อัปเกมฮิตที่กำลังเป็นกระแสในหมู่สายปั่นมาเรียงไว้ในหน้าเดียว ทั้งสล็อตธีมผจญภัยสุดอลังการ เกมแนวแอ็กชันที่มีฟีเจอร์ตัวคูณสะสมแบบทวีคูณ และเกมน่าค้นที่ซ่อนฟีเจอร์เด็ดเอาไว้
      รายชื่อที่กำลังมาแรงเปลี่ยนได้ตามช่วงเวลา ควรเปิดดูอัตราการจ่ายและเงื่อนไขของแต่ละเกมจากหน้าเกมจริงอีกครั้งก่อนลงเดิมพัน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e2a52d] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#faca4c]/60 bg-gradient-to-r from-[#2e1a04]/80 via-[#1b0d02]/92 to-[#0a0501]/88 shadow-[0_15px_40px_rgba(250,202,76,0.25)]"
                : "border-[#e2a52d]/30 bg-[#1b0d02]/88 shadow-[0_10px_30px_rgba(226,165,45,0.18)] hover:border-[#e2a52d]/55 hover:shadow-[0_15px_40px_rgba(225,225,225,0.3)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#855a14]/55 blur-[40px] transition-all duration-500 group-hover:bg-[#faca4c]/35" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#ffeec2] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#faca4c]/60" : "border-[#e2a52d]/35"}`}>
              <Picture
                src={g.img}
                alt={`โลโก้ค่ายเกมพันธมิตร ${g.brand} ที่อยู่ในลิสต์ค่ายเกมของ VIREL168`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#f4e7cd] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#ffeec2]/70 bg-gradient-to-r from-[#ffeec2] to-[#faca4c] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#0a0501] sm:inline">
                    มาแรงสูงสุด
                  </span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#c4ab7d] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#e2a52d]/35 bg-[#0a0501] px-2.5 py-0.5 text-[10px] font-bold text-[#ffeec2]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#c4ab7d]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ffeec2] to-[#faca4c] text-[#0a0501] shadow-[0_10px_30px_rgba(250,202,76,0.35)]"
                    : "border border-[#e2a52d]/60 bg-[#0a0501] text-[#ffeec2] hover:border-[#e1e1e1] hover:bg-[#2e1a04] hover:text-[#fff8e4]"
                }`}>
                เข้าเล่นเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // ตัวกันเรื่อง visibility, แท็บพื้นหลัง และ reduced-motion อยู่ใน
  // src/lib/liveCounter.ts ซึ่งเป็นไฟล์ที่การรีแบรนด์ไม่เขียนทับ ห้ามเอา
  // setTimeout เปล่าๆ กลับมาไว้ตรงนี้ — ตัวนับอยู่ในกล่อง `hidden sm:flex`
  // ถ้าไม่มีตัวกัน มันจะปลุก main thread บนมือถือทุกเครื่องเพื่ออัปเดตข้อความ
  // ที่ไม่มีใครมองเห็น
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
