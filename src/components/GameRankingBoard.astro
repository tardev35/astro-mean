---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// แต่ละแถวผูกกับโลโก้ค่ายที่เป็นเจ้าของเกมนั้นจริง (game1 PG Soft, game2 Joker,
// game3 JILI, game4 Evolution, game5 SA Gaming, game6 Sexy Baccarat) ข้อความ alt
// จึงบรรยายรูปได้ตรง — ห้ามเปลี่ยนชื่อ/ค่ายของแถวโดยไม่เปลี่ยนรูปตาม
//
// MACAUBET: ย้ายจากม่วงบานเย็นนีออนของ SGD88 (#f7d0ff / #e879f9 / #bc07e2 /
// #930ac5 / #7a06a0 / #4c0a6b บนผิว #1b0d2e / #2a1145 / #050118 เนื้อความ #f3e8ff
// ข้อความรอง #cbb5e6) มาที่เขียวนีออนมาเก๊า + ทอง — #dcffc0 / #8ef04a / #59cb13 /
// #3b9b0d / #2c7a08 / #0f3a11 บนผิว #0a2c0d / #041b06 / #020b01 เนื้อความ #e9f9dc
// ข้อความรอง #a8c99a ทอง #f6c445 อยู่บนป้ายและปุ่มของแถวอันดับหนึ่ง
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อแถวก็เป็น <p> เช่นกัน — ไม่มีตัวไหนเป็นหัวข้อจาก docx
// กระดานนี้ต่อท้ายหัวข้อ docx เรื่องล็อบบี้เกมดัง จึงเรียงสล็อตตัวฮิตขึ้นก่อน แล้ว
// ปิดท้ายด้วยโต๊ะคาสิโนสดซึ่งเป็นหัวข้อถัดไปของ docx
const games = [
  { rank: 1, name: "Mahjong Ways 2", type: "PG Soft • สล็อต", menus: ["เกมในกระแส", "ฟีเจอร์อลังการ"], players: 5124, img: img1 },
  { rank: 2, name: "Fortune Gems", type: "JILI • สล็อต", menus: ["รอบสั้นจังหวะไว", "กดแล้วตอบสนองทันที"], players: 3842, img: img3 },
  { rank: 3, name: "Roma X", type: "Joker Gaming • สล็อต", menus: ["คลาสสิกเล่นง่าย", "กติกาไม่ซับซ้อน"], players: 3517, img: img2 },
  { rank: 4, name: "Lightning Roulette", type: "Evolution • คาสิโนสด", menus: ["ถ่ายทอดสด HD", "ฟีลมาเก๊าเต็มจอ"], players: 2905, img: img4 },
  { rank: 5, name: "เซ็กซี่ บาคาร่า", type: "Sexy Baccarat • บาคาร่า", menus: ["ดีลเลอร์มืออาชีพ", "สลับเข้าได้ทันที"], players: 2431, img: img6 },
  { rank: 6, name: "Dragon Tiger", type: "SA Gaming • คาสิโนสด", menus: ["เรียลไทม์ 24 ชม.", "ไม่ต้องเปลี่ยนยูสเซอร์"], players: 2108, img: img5 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="เกมมาแรงที่สมาชิก MACAUBET กำลังเล่นอยู่ตอนนี้" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#59cb13]/35 bg-[#0a2c0d]/88 px-6 py-6 text-center shadow-[0_10px_30px_rgba(89,203,19,0.22)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">🎲</span>
    <p class="bg-gradient-to-r from-[#dcffc0] via-[#8ef04a] to-[#f6c445] bg-clip-text text-2xl font-black tracking-wide text-transparent">เกมมาแรงที่สมาชิก MACAUBET กำลังเล่นอยู่ตอนนี้</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#a8c99a]">
      กระดานนี้จับสล็อตตัวฮิตจากค่ายดังและโต๊ะคาสิโนสดมาวางเรียงไว้ในล็อบบี้เดียว สลับอารมณ์จากหน้าสปินไปลุ้นไพ่ได้ตลอดทั้งวันโดยไม่ต้องเปลี่ยนยูสเซอร์ รายชื่อเกมมาแรงเปลี่ยนได้ตามช่วงเวลา
      ควรเปิดดูเดิมพันเริ่มต้นและฟีเจอร์โบนัสจากหน้าเกมจริงอีกครั้งก่อนกดเล่น
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#59cb13] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#f6c445]/55 bg-gradient-to-r from-[#2c7a08]/70 via-[#0a2c0d]/92 to-[#020b01]/88 shadow-[0_15px_40px_rgba(246,196,69,0.24)]"
                : "border-[#59cb13]/30 bg-[#0a2c0d]/88 shadow-[0_10px_30px_rgba(89,203,19,0.18)] hover:border-[#59cb13]/55 hover:shadow-[0_15px_40px_rgba(142,240,74,0.28)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#2c7a08]/45 blur-[40px] transition-all duration-500 group-hover:bg-[#59cb13]/50" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {/* อันดับ 1–3 แสดงเหรียญ "แทน" ตัวเลข ถ้าซ่อนอิโมจิเฉยๆ สามแถวนั้นจะไม่
                  เหลืออันดับให้อ่านเลย ข้อความ sr-only จึงใส่กลับเข้าไป */}
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#8ef04a] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#f6c445]/55" : "border-[#59cb13]/35"}`}>
              <Picture
                src={g.img}
                alt={`โลโก้ค่ายเกมของ ${g.name} ในกระดานเกมมาแรงของ MACAUBET`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#e9f9dc] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#f6c445]/60 bg-gradient-to-r from-[#f6c445] to-[#c8952a] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#020b01] sm:inline">
                    มาแรงสูงสุด
                  </span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#a8c99a] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#59cb13]/30 bg-[#020b01] px-2.5 py-0.5 text-[10px] font-bold text-[#8ef04a]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#a8c99a]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#f6c445] to-[#c8952a] text-[#020b01] shadow-[0_10px_30px_rgba(246,196,69,0.35)]"
                    : "border border-[#59cb13]/60 bg-[#020b01] text-[#8ef04a] hover:border-[#dcffc0] hover:bg-[#0f3a11] hover:text-[#dcffc0]"
                }`}>
                เข้าดูเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // ตัวกันเรื่อง visibility, แท็บพื้นหลัง และ reduced-motion อยู่ใน
  // src/lib/liveCounter.ts ซึ่งเป็นไฟล์ที่การรีแบรนด์ไม่เขียนทับ ห้ามเอา
  // setTimeout เปล่าๆ กลับมาไว้ตรงนี้ — ตัวนับอยู่ในกล่อง `hidden sm:flex`
  // ถ้าไม่มีตัวกัน มันจะปลุก main thread บนมือถือทุกเครื่องเพื่ออัปเดตข้อความ
  // ที่ไม่มีใครมองเห็น
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
