---
// XONEBET: ชุดสีย้ายมาที่ทองหลอมคู่เงินโครเมียมตามอาร์ตจริง — ทอง #ebb101 /
// #fee505 / #fff8d1 / #a87c02 / #5c4301 คู่เงิน #e9e9e9 / #c4c4c4 บนผิว #0a0803 /
// #161105 / #221a08 เนื้อความ #f4e6bd ข้อความรอง #c3ae76 แถวอันดับหนึ่งรับผิวทอง
// สว่างขึ้นหนึ่งระดับ (#332703) เพื่อให้ตัดกับแถวที่เหลือ จุด live สีเขียว Tailwind
// เป็นสีเชิงความหมาย ไม่ถูกแตะ
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history)
//
// ไม่มีรูปโลโก้ค่ายในแถวไหนเลย และไม่ import src/assets/providers/game* — โลโก้ค่าย
// อยู่ที่ ProviderGrid ซึ่งเป็นที่ของมัน กระดานนี้กางหมวดหมู่ในล็อบบี้ ไม่ใช่รายชื่อ
// ค่าย การเอาโลโก้ค่ายมาแปะข้างชื่อหมวดแล้วเขียน alt ให้เป็นอย่างอื่นคือ alt ที่ไม่
// ตรงกับรูป และรูปที่ import แต่ไม่ได้ใช้คือรูปที่ถูก emit ลง dist/ ฟรีๆ ช่องรูปจึง
// เป็นไอคอนกรอบทองที่เป็น aria-hidden แทน
//
// ไม่ผูกหมวดกับชื่อค่ายรายแถว: docx เอ่ยค่าย (PG Soft, Pragmatic Play, Joker Gaming)
// กับคุณสมบัติของเกมไว้คนละประโยค การจับคู่ว่าคุณสมบัติไหนเป็นของค่ายไหนเป็นข้อมูล
// ที่ brief ไม่ได้ให้ ช่องขวาของแต่ละแถวจึงบอก "จุดเด่นของหมวด" ซึ่งเป็นข้อเท็จจริง
// ที่ docx ให้ไว้ตรงๆ แทน
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อแถวก็เป็น <p> เช่นกัน — ไม่มีตัวไหนเป็นหัวข้อจาก docx
// กระดานนี้เป็นภาพประกอบของหัวข้อ docx ข้อ 6 เรื่องสลับเกมได้ต่อเนื่องไม่ขัดจังหวะ
// จึงกางหมวดที่ล็อบบี้แยกไว้ให้เห็นครบในหน้าเดียวว่าสลับไปมาได้จากที่เดียว
//
// อันดับ 1–3 แสดงเหรียญ "แทน" ตัวเลข ถ้าซ่อนอิโมจิเฉยๆ สามแถวนั้นจะไม่เหลืออันดับ
// ให้อ่านเลย ข้อความ sr-only จึงใส่กลับเข้าไปคู่กับ aria-hidden
const games = [
  {
    rank: 1,
    name: "หมวดเกมกระแสมาแรง",
    type: "รวมเกมที่กำลังมาแรงในแต่ละช่วงไว้เป็นหมวดของตัวเอง กดเข้าได้จากหน้าเว็บโดยไม่ต้องเลื่อนไล่หาเอง",
    focus: "เจอของฮิตในไม่กี่คลิก",
    menus: ["กระแสมาแรง", "ไม่ต้องไล่หา"],
    players: 5124,
    icon: "📈",
  },
  {
    rank: 2,
    name: "หมวดแยกตามค่ายดังเกรด A",
    type: "แยกตามค่ายดังระดับเกรด A ทั้ง PG Soft, Pragmatic Play และ Joker Gaming เลือกค่ายที่ถนัดแล้วเข้าเล่นได้ทันที",
    focus: "เลือกค่ายที่ถนัดได้เลย",
    menus: ["ค่ายเกรด A", "บัญชีเดียวจบ"],
    players: 3842,
    icon: "🏷️",
  },
  {
    rank: 3,
    name: "หมวดแยกตามประเภทเกม",
    type: "จัดหมวดหมู่ตามประเภทเกมอย่างเป็นระบบ ช่วยให้สลับเปลี่ยนฟีลการปั่นสล็อตได้ตรงสไตล์โดยไม่ต้องค้นหาหลายรอบ",
    focus: "เลือกได้ตรงฟีล",
    menus: ["แยกตามประเภท", "สลับฟีลได้ไว"],
    players: 3517,
    icon: "🗂️",
  },
  {
    rank: 4,
    name: "หมวดตัวคูณทวีคูณ Multipliers",
    type: "รวมเกมที่มีระบบสุ่มแจกตัวคูณทวีคูณ ดันยอดรางวัลที่ออกให้ทบขึ้นจากเบทเดิมในรอบเดียวกัน",
    focus: "อัตราคูณสะสมสูง",
    menus: ["Multipliers", "ทบจากเบทเดิม"],
    players: 2905,
    icon: "✖️",
  },
  {
    rank: 5,
    name: "หมวด Wild ซ้อนทับและ Cascading",
    type: "เกมที่มีสัญลักษณ์ Wild ซ้อนทับและคอมโบแตกต่อเนื่องแบบ Cascading เปลี่ยนการหมุนธรรมดาให้ลุ้นได้ยาวขึ้น",
    focus: "คอมโบแตกต่อเนื่อง",
    menus: ["Wild ซ้อนทับ", "Cascading"],
    players: 2431,
    icon: "🃏",
  },
  {
    rank: 6,
    name: "หมวด Buy Feature สายใจร้อน",
    type: "โหมดซื้อฟรีสปินสำหรับสายใจร้อน กดเข้ารอบพิเศษได้ทันทีบนเกมที่จังหวะฟรีสปินเข้าไวอยู่แล้ว",
    focus: "เข้ารอบพิเศษได้ทันที",
    menus: ["Buy Feature", "ฟรีสปินเข้าไว"],
    players: 2108,
    icon: "🎁",
  },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดเกมในล็อบบี้ที่ XONEBET แยกไว้ให้สลับเล่นได้ต่อเนื่องจากที่เดียว" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#5c4301]/45 bg-[#161105]/90 px-6 py-6 text-center shadow-[0_10px_30px_rgba(92,67,1,0.3)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">🎰</span>
    <p class="bg-gradient-to-r from-[#fff8d1] via-[#fee505] to-[#e9e9e9] bg-clip-text text-2xl font-black tracking-wide text-transparent">
      หมวดเกมในล็อบบี้ที่ XONEBET แยกไว้ให้สลับเล่นได้ต่อเนื่องจากที่เดียว
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#c3ae76]">
      กางให้เห็นครบในหน้าเดียว ทั้งหมวดเกมกระแสมาแรง หมวดแยกตามค่ายดังเกรด A หมวดแยกตามประเภทเกม หมวดตัวคูณทวีคูณ Multipliers หมวด Wild ซ้อนทับกับ Cascading และหมวด Buy Feature
      สำหรับสายใจร้อน ลำดับความนิยมเปลี่ยนได้ตามช่วงเวลา ควรเปิดดูอัตราจ่ายและเงื่อนไขของแต่ละเกมจากหน้าเกมจริงอีกครั้งก่อนลงเดิมพัน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ebb101] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#fee505]/55 bg-gradient-to-r from-[#332703]/85 via-[#161105]/92 to-[#0a0803]/90 shadow-[0_15px_40px_rgba(235,177,1,0.2)]"
                : "border-[#5c4301]/35 bg-[#161105]/90 shadow-[0_10px_30px_rgba(92,67,1,0.2)] hover:border-[#ebb101]/55 hover:shadow-[0_15px_40px_rgba(235,177,1,0.28)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#221a08]/80 blur-[40px] transition-all duration-500 group-hover:bg-[#a87c02]/40" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#ebb101] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div
              aria-hidden="true"
              class={`relative z-10 flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border bg-[#0a0803] text-2xl transition-transform duration-500 group-hover:scale-110 sm:h-16 sm:w-16 sm:text-3xl ${
                top ? "border-[#fee505]/60" : "border-[#5c4301]/45"
              }`}>
              {g.icon}
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#f4e6bd] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#ebb101]/70 bg-gradient-to-r from-[#fee505] to-[#ebb101] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#0a0803] sm:inline">
                    หมวดที่คนเข้ามากที่สุด
                  </span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#c3ae76] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                <span class="rounded-full border border-[#5c4301] bg-[#221a08] px-2.5 py-0.5 text-[10px] font-bold text-[#e9e9e9]">{g.focus}</span>
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#5c4301]/40 bg-[#221a08] px-2.5 py-0.5 text-[10px] font-bold text-[#fee505]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#c3ae76]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#fee505] to-[#ebb101] text-[#0a0803] shadow-[0_10px_30px_rgba(235,177,1,0.35)]"
                    : "border border-[#5c4301]/60 bg-[#221a08] text-[#fee505] hover:border-[#e9e9e9] hover:bg-[#5c4301] hover:text-[#fff8d1]"
                }`}>
                เข้าเล่นเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // ตัวกันเรื่อง visibility, แท็บพื้นหลัง และ reduced-motion อยู่ใน
  // src/lib/liveCounter.ts ซึ่งเป็นไฟล์ที่การรีแบรนด์ไม่เขียนทับ ห้ามเอา
  // setTimeout เปล่าๆ กลับมาไว้ตรงนี้ — ตัวนับอยู่ในกล่อง `hidden sm:flex`
  // ถ้าไม่มีตัวกัน มันจะปลุก main thread บนมือถือทุกเครื่องเพื่ออัปเดตข้อความ
  // ที่ไม่มีใครมองเห็น
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
