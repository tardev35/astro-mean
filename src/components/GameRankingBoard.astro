---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// แต่ละแถวผูกกับโลโก้ค่ายที่เป็นเจ้าของเกมนั้นจริง (game1 PG Soft, game2 Joker,
// game3 JILI, game4 Evolution, game5 SA Gaming, game6 Sexy Baccarat) ข้อความ alt
// จึงบรรยายรูปได้ตรง — ห้ามเปลี่ยนชื่อ/ค่ายของแถวโดยไม่เปลี่ยนรูปตาม สลับลำดับได้
// เพราะรูปเดินทางไปกับแถวของมันเอง รอบนี้ยกสล็อตขึ้นก่อนตามแบรนด์สล็อตเว็บตรง
//
// DRACO65: ย้ายจากม่วงโกธิคของ PHANTOM569 (#ede9fe / #b794ff / #8b5cf6 /
// #6d28d9 / #4c1d95 / #2a0a52 บนผิว #1c0343 / #12002b เนื้อความ #ded4f5
// ข้อความรอง #a99ac9 ทอง #f6c445 / #c8952a) มาที่เขียวมังกรนีออน — #dcfce7 /
// #4ade80 / #22c55e / #15803d / #14532d / #0a3318 บนผิว #062011 / #04150a
// เนื้อความ #d6ecdd ข้อความรอง #9dbfa8 โดยแถวอันดับหนึ่งรับสีรองของแบรนด์คือ
// เงิน/โครเมียม #e2e8e4 / #9dbfa8
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อแถวก็เป็น <p> เช่นกัน — ไม่มีตัวไหนเป็นหัวข้อจาก docx
// กระดานนี้ต่อท้ายหัวข้อ docx เรื่องฟีเจอร์ดุครบเครื่อง จึงเรียงตามฟีเจอร์ของเกม
const games = [
  { rank: 1, name: "Mahjong Ways 2", type: "PG Soft • สล็อต", menus: ["ฟรีสปินออกบ่อย", "ตัวคูณต่อเนื่อง"], players: 5124, img: img1 },
  { rank: 2, name: "Fortune Gems", type: "JILI • สล็อต", menus: ["รอบสั้นตัดสินไว", "เข้าโบนัสง่าย"], players: 3842, img: img3 },
  { rank: 3, name: "Roma X", type: "Joker Gaming • สล็อต", menus: ["กติกาไม่ซับซ้อน", "กดเล่นได้ทันที"], players: 3517, img: img2 },
  { rank: 4, name: "Lightning Roulette", type: "Evolution • คาสิโนสด", menus: ["ตัวคูณระเบิดแจ็คพอต", "สลับเล่นในบัญชีเดียว"], players: 2905, img: img4 },
  { rank: 5, name: "Dragon Tiger", type: "SA Gaming • เสือมังกร", menus: ["จังหวะไวไม่สะดุด", "ปั่นต่อเนื่องยาวๆ"], players: 2431, img: img5 },
  { rank: 6, name: "เซ็กซี่ บาคาร่า", type: "Sexy Baccarat • บาคาร่า", menus: ["สลับเปลี่ยนค่ายไว", "เปิดโต๊ะ 24 ชั่วโมง"], players: 2108, img: img6 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="เกมมาแรงที่สมาชิก DRACO65 กำลังปั่นอยู่ตอนนี้" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#22c55e]/35 bg-[#062011]/88 px-6 py-6 text-center shadow-[0_10px_30px_rgba(34,197,94,0.22)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">🐉</span>
    <p class="bg-gradient-to-r from-[#dcfce7] via-[#4ade80] to-[#e2e8e4] bg-clip-text text-2xl font-black tracking-wide text-transparent">เกมมาแรงที่สมาชิก DRACO65 กำลังปั่นอยู่ตอนนี้</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#9dbfa8]">
      กระดานนี้จับเกมตัวตึงและเกมฮิตติดเทรนด์จากค่ายดังมาวางเรียงไว้ในล็อบบี้เดียว กดสลับเข้าเล่นได้ตลอดทั้งวันในบัญชีเดียวโดยไม่ต้องสมัครใหม่ รายชื่อเกมมาแรงเปลี่ยนได้ตามช่วงเวลา
      ควรเปิดดูเดิมพันเริ่มต้นและกติกาของแต่ละเกมจากหน้าเกมจริงอีกครั้งก่อนกดสปิน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#22c55e] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#e2e8e4]/55 bg-gradient-to-r from-[#14532d]/70 via-[#062011]/92 to-[#04150a]/88 shadow-[0_15px_40px_rgba(226,232,228,0.24)]"
                : "border-[#22c55e]/30 bg-[#062011]/88 shadow-[0_10px_30px_rgba(34,197,94,0.18)] hover:border-[#22c55e]/55 hover:shadow-[0_15px_40px_rgba(74,222,128,0.28)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#14532d]/45 blur-[40px] transition-all duration-500 group-hover:bg-[#22c55e]/50" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {/* อันดับ 1–3 แสดงเหรียญ "แทน" ตัวเลข ถ้าซ่อนอิโมจิเฉยๆ สามแถวนั้นจะไม่
                  เหลืออันดับให้อ่านเลย ข้อความ sr-only จึงใส่กลับเข้าไป */}
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#4ade80] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#e2e8e4]/55" : "border-[#22c55e]/35"}`}>
              <Picture
                src={g.img}
                alt={`โลโก้ค่ายเกมของ ${g.name} ในกระดานเกมมาแรงของ DRACO65`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#d6ecdd] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#e2e8e4]/60 bg-gradient-to-r from-[#e2e8e4] to-[#9dbfa8] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#04150a] sm:inline">
                    มาแรงสูงสุด
                  </span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#9dbfa8] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#22c55e]/30 bg-[#04150a] px-2.5 py-0.5 text-[10px] font-bold text-[#4ade80]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#9dbfa8]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#e2e8e4] to-[#9dbfa8] text-[#04150a] shadow-[0_10px_30px_rgba(226,232,228,0.35)]"
                    : "border border-[#22c55e]/60 bg-[#04150a] text-[#4ade80] hover:border-[#dcfce7] hover:bg-[#0a3318] hover:text-[#dcfce7]"
                }`}>
                เข้าดูเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // ตัวกันเรื่อง visibility, แท็บพื้นหลัง และ reduced-motion อยู่ใน
  // src/lib/liveCounter.ts ซึ่งเป็นไฟล์ที่การรีแบรนด์ไม่เขียนทับ ห้ามเอา
  // setTimeout เปล่าๆ กลับมาไว้ตรงนี้ — ตัวนับอยู่ในกล่อง `hidden sm:flex`
  // ถ้าไม่มีตัวกัน มันจะปลุก main thread บนมือถือทุกเครื่องเพื่ออัปเดตข้อความ
  // ที่ไม่มีใครมองเห็น
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
