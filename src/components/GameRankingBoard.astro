---
// BLACKJACK789: ชุดสีย้ายจากทองอำพันคู่โครเมียมของแบรนด์ก่อน มาเป็นทองแอนทีค/แชมเปญ
// คู่กราไฟต์บนดำเกือบสนิทตามอาร์ตจริง — ทอง #fdf1ce / #f2cf70 / #d3aa4b / #8c6623 /
// #5c4113 คู่กราไฟต์ #cfd6e0 / #8e97a6 / #454d5c บนผิว #050403 / #100b05 / #1e150a
// ขอบ #3a2a11 เนื้อความ #ede0c4 ข้อความรอง #c0ab84 แถวอันดับหนึ่งรับผิวยกระดับขึ้น
// หนึ่งขั้นและขอบทองสว่างเพื่อให้ตัดกับแถวที่เหลือ จุด live สีเขียว Tailwind เป็นสี
// เชิงความหมาย ไม่ถูกแตะ
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history)
//
// ไม่มีรูปโลโก้ค่ายในแถวไหนเลย และไม่ import src/assets/providers/game* — โลโก้ค่าย
// อยู่ที่ ProviderGrid ซึ่งเป็นที่ของมัน กระดานนี้กางหมวดหมู่ในล็อบบี้ ไม่ใช่รายชื่อ
// ค่าย การเอาโลโก้ค่ายมาแปะข้างชื่อหมวดแล้วเขียน alt ให้เป็นอย่างอื่นคือ alt ที่ไม่
// ตรงกับรูป และรูปที่ import แต่ไม่ได้ใช้คือรูปที่ถูก emit ลง dist/ ฟรีๆ ช่องรูปจึง
// เป็นไอคอนกรอบทองที่เป็น aria-hidden แทน
//
// ไม่ผูกหมวดกับชื่อค่ายรายแถว: docx เอ่ยค่าย (PG Soft, Pragmatic Play, Joker Gaming)
// กับคุณสมบัติของเกมไว้คนละประโยค การจับคู่ว่าคุณสมบัติไหนเป็นของค่ายไหนเป็นข้อมูลที่
// brief ไม่ได้ให้ ช่องขวาของแต่ละแถวจึงบอก "จุดเด่นของหมวด" ซึ่งเป็นข้อเท็จจริงที่
// docx ให้ไว้ตรงๆ แทน
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อแถวก็เป็น <p> เช่นกัน — ไม่มีตัวไหนเป็นหัวข้อจาก docx
// กระดานนี้เป็น widget ปลายหน้า วางรวมกับชุด widget อื่นหลังหัวข้อ docx ข้อสุดท้าย
//
// อันดับ 1–3 แสดงเหรียญ "แทน" ตัวเลข ถ้าซ่อนอิโมจิเฉยๆ สามแถวนั้นจะไม่เหลืออันดับ
// ให้อ่านเลย ข้อความ sr-only จึงใส่กลับเข้าไปคู่กับ aria-hidden
const games = [
  {
    rank: 1,
    name: "หมวดสล็อต 3D เนื้อเรื่องเข้มข้น",
    type: "กราฟิกสมูธคมชัดระดับ HD จากค่ายลิขสิทธิ์แท้ที่ยิงสัญญาณเข้าระบบโดยตรง เดินเรื่องยาวได้ทั้งรอบ สปินลื่นไม่มีอาการค้างหรือเด้งหลุดกลางทาง",
    focus: "คมชัดระดับ HD",
    menus: ["สล็อต 3D", "สปินลื่น"],
    players: 5124,
    icon: "🎮",
  },
  {
    rank: 2,
    name: "หมวดสล็อตสายสตรีตตัวคูณโหด",
    type: "รวมเกมที่วางระบบสุ่มแจกตัวคูณทวีคูณ Multipliers ไว้เต็มมือ ยิ่งต่อคอมโบยาวยิ่งดันยอดรางวัลขึ้นจากเบทเดิมโดยไม่ต้องเพิ่มทุนกลางรอบ",
    focus: "ตัวคูณทวีคูณ",
    menus: ["Multipliers", "คอมโบยาว"],
    players: 3842,
    icon: "✖️",
  },
  {
    rank: 3,
    name: "หมวดสายซื้อฟีเจอร์ Bonus Buy",
    type: "โหมด Bonus Buy ให้เลือกซื้อฟรีสปินพุ่งตรงเข้าลุ้นรอบแจ็คพอตได้ทันที ไม่ต้องรอสัญลักษณ์ครบเอง เหมาะกับคนที่อยากคุมงบต่อรอบให้ชัด",
    focus: "พุ่งเข้ารอบแจ็คพอตทันที",
    menus: ["Bonus Buy", "ฟรีสปิน"],
    players: 3517,
    icon: "🎟️",
  },
  {
    rank: 4,
    name: "หมวดสล็อตคลาสสิกไลน์จ่ายน้อยแต่แตกหนัก",
    type: "ไลน์จ่ายอ่านง่ายแบบดั้งเดิม จบตารางรางวัลได้ในรอบเดียว เหมาะกับคนที่วางแผนเดินเงินยาวตั้งแต่เบทหลักบาทไปจนถึงเบทสูง",
    focus: "อ่านไลน์จ่ายได้ในรอบเดียว",
    menus: ["คลาสสิก", "แตกหนัก"],
    players: 2905,
    icon: "🍀",
  },
  {
    rank: 5,
    name: "หมวดโปรเด็ดและสิทธิ์คืนยอดเสีย",
    type: "กดรับเองผ่านหน้าแดชบอร์ด ทั้งโบนัสต้อนรับเพิ่มทุนสปิน โปรฝากแรกของวัน และเครดิตคืนยอดเสีย Cash Back ทุกวัน เงื่อนไขโปร่งใส",
    focus: "ไม่ติดเทิร์นโอเวอร์มหาโหด",
    menus: ["โบนัสต้อนรับ", "Cash Back"],
    players: 2431,
    icon: "🎁",
  },
  {
    rank: 6,
    name: "หมวดฝากถอนออโต้ 3 วินาที",
    type: "ระบบออโต้ผ่าน Gateway ตรง ทำรายการเสร็จใน 3 วินาที ไม่ต้องส่งสลิป ไม่ต้องรอแอดมินอนุมัติ ถอนกำไรได้เต็มทุกยอด",
    focus: "ถอนเต็มทุกยอด",
    menus: ["Gateway ตรง", "ไม่ต้องส่งสลิป"],
    players: 2108,
    icon: "⚡",
  },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดเกมในคลังที่ BLACKJACK789 แยกไว้ให้เปลี่ยนฟีลการเล่นได้จากที่เดียว" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#3a2a11]/70 bg-[#100b05]/90 px-6 py-6 text-center shadow-[0_10px_30px_rgba(92,65,19,0.35)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">🎰</span>
    <p class="bg-gradient-to-r from-[#fdf1ce] via-[#f2cf70] to-[#cfd6e0] bg-clip-text text-2xl font-black tracking-wide text-transparent">
      หมวดเกมในคลังที่ BLACKJACK789 แยกไว้ให้เปลี่ยนฟีลการเล่นได้จากที่เดียว
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#c0ab84]">
      กางให้เห็นครบในหน้าเดียว ทั้งหมวดสล็อต 3D เนื้อเรื่องเข้มข้น หมวดสายสตรีตตัวคูณโหด หมวดสายซื้อฟีเจอร์ หมวดคลาสสิกไลน์จ่ายน้อยแต่แตกหนัก หมวดโปรเด็ดและสิทธิ์คืนยอดเสีย และหมวดฝากถอนออโต้ 3 วินาที
      ทุกหมวดใช้กระเป๋าเงินเดียวไม่ต้องโยกเงินข้ามค่าย ลำดับความนิยมเปลี่ยนได้ตามช่วงเวลา ควรเปิดดูอัตราจ่ายและเงื่อนไขของแต่ละเกมจากหน้าเกมจริงอีกครั้งก่อนลงเดิมพัน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#d3aa4b] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#f2cf70]/55 bg-gradient-to-r from-[#1e150a]/90 via-[#100b05]/92 to-[#050403]/90 shadow-[0_15px_40px_rgba(211,170,75,0.2)]"
                : "border-[#3a2a11]/60 bg-[#100b05]/90 shadow-[0_10px_30px_rgba(92,65,19,0.25)] hover:border-[#d3aa4b]/55 hover:shadow-[0_15px_40px_rgba(211,170,75,0.28)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#1e150a]/80 blur-[40px] transition-all duration-500 group-hover:bg-[#5c4113]/50" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#d3aa4b] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div
              aria-hidden="true"
              class={`relative z-10 flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border bg-[#050403] text-2xl transition-transform duration-500 group-hover:scale-110 sm:h-16 sm:w-16 sm:text-3xl ${
                top ? "border-[#f2cf70]/60" : "border-[#3a2a11]"
              }`}>
              {g.icon}
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#ede0c4] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#d3aa4b]/70 bg-gradient-to-r from-[#f2cf70] to-[#8c6623] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#050403] sm:inline">
                    หมวดที่คนเข้ามากที่สุด
                  </span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#c0ab84] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                <span class="rounded-full border border-[#cfd6e0]/40 bg-[#1e150a] px-2.5 py-0.5 text-[10px] font-bold text-[#cfd6e0]">{g.focus}</span>
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#3a2a11] bg-[#1e150a] px-2.5 py-0.5 text-[10px] font-bold text-[#f2cf70]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#c0ab84]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#f2cf70] to-[#8c6623] text-[#050403] shadow-[0_10px_30px_rgba(211,170,75,0.35)]"
                    : "border border-[#3a2a11] bg-[#1e150a] text-[#f2cf70] hover:border-[#d3aa4b] hover:bg-[#5c4113] hover:text-[#fdf1ce]"
                }`}>
                เข้าเล่นเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // ตัวกันเรื่อง visibility, แท็บพื้นหลัง และ reduced-motion อยู่ใน
  // src/lib/liveCounter.ts ซึ่งเป็นไฟล์ที่การรีแบรนด์ไม่เขียนทับ ห้ามเอา
  // setTimeout เปล่าๆ กลับมาไว้ตรงนี้ — ตัวนับอยู่ในกล่อง `hidden sm:flex`
  // ถ้าไม่มีตัวกัน มันจะปลุก main thread บนมือถือทุกเครื่องเพื่ออัปเดตข้อความ
  // ที่ไม่มีใครมองเห็น
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
