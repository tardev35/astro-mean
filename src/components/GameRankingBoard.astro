---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// รูปในแต่ละแถวคือ "โลโก้ค่ายพันธมิตร" ไม่ใช่ภาพของเกมนั้น alt จึงบรรยายโลโก้ตาม
// ตัวอักษรที่พิมพ์อยู่บนรูปจริง — game1 = PG (Pocket Games Soft), game2 = SexySlot,
// game3 = SlotXO, game4 = Joker, game5 = JILI, game6 = PP SLOT (Pragmatic Play)
// ห้ามเปลี่ยนค่า `brand` ของแถวโดยไม่เปลี่ยนไฟล์รูปตาม สลับลำดับแถวได้เพราะรูปกับ
// ชื่อค่ายเดินทางไปด้วยกันในอ็อบเจกต์เดียว ส่วน `name`/`type` เป็นชื่อห้องเดิมพัน
// ซึ่งไม่ได้ผูกกับรูป จึงเปลี่ยนได้อิสระ
//
// LUCKYBKK: ย้ายจากเขียวมิ้นต์คู่ทองของ AM88K มาที่น้ำเงินรอยัลคู่ทอง — น้ำเงิน
// #3f9dfb / #cfe8ff / #1f5fd0 / #0a2a86 คู่ทอง #f0b323 / #ffdf7e / #9a6c05 บนผิว
// #061442 / #030b28 ขอบ/แถบยก #0d2160 เนื้อความ #e4eeff น้ำเงินเป็นสีหลักของกริด
// ส่วนแถวอันดับหนึ่งรับคู่ทองเพื่อให้ตัดกับแถวที่เหลือ จุด live สีเขียวเป็นสีเชิง
// ความหมาย ไม่ถูกแตะ (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย
// ดูของเดิมได้จาก git history)
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อแถวก็เป็น <p> เช่นกัน — ไม่มีตัวไหนเป็นหัวข้อจาก docx
// กระดานนี้เน้นห้องเดิมพันสดที่คัดมาให้ครบ ตั้งแต่เบทเริ่มต้นถึงห้อง High Roller
// ตามที่ brief ของแบรนด์นี้พูดไว้ ไม่ใช่การชูอัตราจ่ายของโต๊ะใดโต๊ะหนึ่ง
//
// อันดับ 1–3 แสดงเหรียญ "แทน" ตัวเลข ถ้าซ่อนอิโมจิเฉยๆ สามแถวนั้นจะไม่เหลืออันดับ
// ให้อ่านเลย ข้อความ sr-only จึงใส่กลับเข้าไปคู่กับ aria-hidden
const games = [
  {
    rank: 1,
    name: "ห้องบาคาร่าสดคมชัดระดับ HD",
    type: "ยิงตรงสัญญาณสด • ดีลเลอร์มืออาชีพประจำโต๊ะ",
    brand: "PP SLOT (Pragmatic Play)",
    menus: ["สถิติย้อนหลังอ่านง่าย", "เปิดให้เข้าตลอด 24 ชั่วโมง"],
    players: 5124,
    img: img6,
  },
  {
    rank: 2,
    name: "ห้องรูเล็ตดีลเลอร์สด",
    type: "วงล้อสดเรียลไทม์ • ภาพและเสียงคมชัดเต็มจอ",
    brand: "Joker",
    menus: ["ดูผลย้อนหลังได้ทุกตา", "จังหวะเดิมพันชัดเจน"],
    players: 3842,
    img: img4,
  },
  {
    rank: 3,
    name: "ห้องเสือมังกรรู้ผลไว",
    type: "เกมสดจังหวะกระชับ • ตัดสินเร็วในไม่กี่วินาที",
    brand: "JILI",
    menus: ["สลับโต๊ะได้แทบไม่ต้องรอ", "เหมาะกับสายเล่นรอบสั้น"],
    players: 3517,
    img: img5,
  },
  {
    rank: 4,
    name: "ห้องเบทเริ่มต้นสำหรับมือใหม่",
    type: "โต๊ะเบทสบายๆ • เริ่มต้นทำความคุ้นเคยได้ไม่กดดัน",
    brand: "SexySlot",
    menus: ["กติกาตรงไปตรงมา", "เลือกระดับเดิมพันให้พอดีทุน"],
    players: 2905,
    img: img2,
  },
  {
    rank: 5,
    name: "ห้อง High Roller สำหรับสายลุยหนัก",
    type: "โต๊ะเบทสูง • เพดานเดิมพันกว้างกว่าห้องทั่วไป",
    brand: "PG (Pocket Games Soft)",
    menus: ["ดูแลระดับ VIP", "ทำรายการการเงินได้คล่องตัว"],
    players: 2431,
    img: img1,
  },
  {
    rank: 6,
    name: "ห้องไฮโลไทยสไตล์คลาสสิก",
    type: "เกมสดคุ้นมือ • เปิดเล่นได้ลื่นไม่มีสะดุด",
    brand: "SlotXO",
    menus: ["อ่านเกมง่ายไม่ซับซ้อน", "ระบบตรงตรวจสอบได้"],
    players: 2108,
    img: img3,
  },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="ห้องเดิมพันสดมาแรงที่สมาชิก LUCKYBKK กำลังเล่นอยู่ตอนนี้" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#3f9dfb]/35 bg-[#061442]/88 px-6 py-6 text-center shadow-[0_10px_30px_rgba(63,157,251,0.22)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">🎴</span>
    <p class="bg-gradient-to-r from-[#f5f9ff] via-[#cfe8ff] to-[#f0b323] bg-clip-text text-2xl font-black tracking-wide text-transparent">ห้องเดิมพันสดมาแรงที่สมาชิก LUCKYBKK กำลังเล่นอยู่ตอนนี้</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#e4eeff]/80">
      กระดานนี้จับห้องเดิมพันสดที่คนเข้าเยอะที่สุดมาเรียงไว้ในหน้าเดียว กดสลับโต๊ะได้ตลอดทั้งวันในยูสเซอร์เดียวโดยไม่ต้องโยกเงินหรือออกจากระบบ รายชื่อห้องมาแรงเปลี่ยนได้ตามช่วงเวลา
      ควรเปิดดูเบทขั้นต่ำและเงื่อนไขของแต่ละโต๊ะจากหน้าเกมจริงอีกครั้งก่อนลงเดิมพัน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#3f9dfb] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#f0b323]/60 bg-gradient-to-r from-[#0d2160]/80 via-[#061442]/92 to-[#030b28]/88 shadow-[0_15px_40px_rgba(240,179,35,0.28)]"
                : "border-[#3f9dfb]/30 bg-[#061442]/88 shadow-[0_10px_30px_rgba(63,157,251,0.18)] hover:border-[#3f9dfb]/55 hover:shadow-[0_15px_40px_rgba(63,157,251,0.32)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#0a2a86]/45 blur-[40px] transition-all duration-500 group-hover:bg-[#3f9dfb]/35" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#3f9dfb] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#f0b323]/60" : "border-[#3f9dfb]/35"}`}>
              <Picture
                src={g.img}
                alt={`โลโก้ค่ายเกมพันธมิตร ${g.brand} ที่อยู่ในลิสต์ค่ายเกมของ LUCKYBKK`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#e4eeff] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#ffdf7e]/70 bg-gradient-to-r from-[#ffdf7e] to-[#f0b323] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#030b28] sm:inline">
                    มาแรงสูงสุด
                  </span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#e4eeff]/75 sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#3f9dfb]/30 bg-[#030b28] px-2.5 py-0.5 text-[10px] font-bold text-[#cfe8ff]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#e4eeff]/75">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ffdf7e] to-[#f0b323] text-[#030b28] shadow-[0_10px_30px_rgba(240,179,35,0.35)]"
                    : "border border-[#3f9dfb]/60 bg-[#030b28] text-[#cfe8ff] hover:border-[#f0b323] hover:bg-[#0d2160] hover:text-[#f5f9ff]"
                }`}>
                เข้าดูโต๊ะเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // ตัวกันเรื่อง visibility, แท็บพื้นหลัง และ reduced-motion อยู่ใน
  // src/lib/liveCounter.ts ซึ่งเป็นไฟล์ที่การรีแบรนด์ไม่เขียนทับ ห้ามเอา
  // setTimeout เปล่าๆ กลับมาไว้ตรงนี้ — ตัวนับอยู่ในกล่อง `hidden sm:flex`
  // ถ้าไม่มีตัวกัน มันจะปลุก main thread บนมือถือทุกเครื่องเพื่ออัปเดตข้อความ
  // ที่ไม่มีใครมองเห็น
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
