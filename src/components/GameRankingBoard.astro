---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// รูปในแต่ละแถวคือ "โลโก้ค่ายพันธมิตร" ไม่ใช่ภาพของเกมนั้น alt จึงบรรยายโลโก้ตาม
// ตัวอักษรที่พิมพ์อยู่บนรูปจริง — game1 = PG (Pocket Games Soft), game2 = SexySlot,
// game3 = SlotXO, game4 = Joker, game5 = JILI, game6 = PP SLOT (Pragmatic Play)
// ห้ามเปลี่ยนค่า `brand` ของแถวโดยไม่เปลี่ยนไฟล์รูปตาม สลับลำดับแถวได้เพราะรูปกับ
// ชื่อค่ายเดินทางไปด้วยกันในอ็อบเจกต์เดียว ส่วน `name`/`type` เป็นชื่อโหมดเกม
// ซึ่งไม่ได้ผูกกับรูป จึงเปลี่ยนได้อิสระ
//
// PROFIT55: กลับด้านชุดสีจากแดงส้มคู่ทองของแบรนด์ก่อนหน้า มาเป็นทองคู่เงินโครเมียม —
// ทอง #e3ac22 / #f6d24a / #ffe9a8 / #8a6410 คู่เงิน #cfd8e2 / #eef3f8 / #8b96a4
// บนผิว #161004 / #0a0702 ขอบ/แถบยก #2a1d05 เนื้อความ #f3e6c4 ทองเป็นสีหลักของ
// กระดาน ส่วนแถวอันดับหนึ่งรับเงินโครเมียมเพื่อให้ตัดกับแถวที่เหลือ จุด live สีเขียว
// Tailwind เป็นสีเชิงความหมาย ไม่ถูกแตะ (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind
// สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้
// ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อแถวก็เป็น <p> เช่นกัน — ไม่มีตัวไหนเป็นหัวข้อจาก docx
// กระดานนี้เป็นภาพประกอบของหัวข้อ docx ข้อ 5 (เลือกเกมไม่ต้องไล่หานาน จัดหมวดให้
// ตัวน่าเล่นเข้าถึงง่ายขึ้น) จึงเน้นหมวดที่ล็อบบี้จัดไว้และตัวที่คนกำลังตามเล่น
//
// อันดับ 1–3 แสดงเหรียญ "แทน" ตัวเลข ถ้าซ่อนอิโมจิเฉยๆ สามแถวนั้นจะไม่เหลืออันดับ
// ให้อ่านเลย ข้อความ sr-only จึงใส่กลับเข้าไปคู่กับ aria-hidden
const games = [
  {
    rank: 1,
    name: "หมวดเกมยอดนิยมที่คนกำลังตามเล่นมากที่สุด",
    type: "ล็อบบี้จัดไว้ให้กดเข้าได้ในไม่กี่คลิก • เปิดใช้งานได้ตลอดทั้งวัน",
    brand: "PP SLOT (Pragmatic Play)",
    menus: ["คนเข้าเล่นเยอะที่สุด", "ยูสเซอร์เดียวเล่นได้ทุกหมวด"],
    players: 5124,
    img: img6,
  },
  {
    rank: 2,
    name: "โต๊ะคาสิโนสดสตรีมมิ่งความคมชัดระดับ HD",
    type: "เห็นดีลเลอร์แจกไพ่ทุกจังหวะแบบเรียลไทม์ • เลือกโต๊ะได้ตามสไตล์การเดิมพัน",
    brand: "Joker",
    menus: ["สายไพ่มาทางนี้", "ภาพคมชัดระดับ HD"],
    players: 3842,
    img: img4,
  },
  {
    rank: 3,
    name: "สล็อตลิขสิทธิ์แท้สำหรับสายเปลี่ยนธีมบ่อย",
    type: "อัตราจ่ายเป็นธรรมและระบบหลังบ้านแน่นหนา • สลับค่ายได้โดยไม่ต้องออกจากระบบ",
    brand: "JILI",
    menus: ["เกมลิขสิทธิ์แท้", "สลับค่ายไม่ต้องโยกเงิน"],
    players: 3517,
    img: img5,
  },
  {
    rank: 4,
    name: "บาคาร่าสดสำหรับคนเข้าเร็วออกเร็ว",
    type: "โต๊ะเปิดใหม่ต่อเนื่องตลอดวัน • วางเดิมพันแล้วรู้ผลภายในไม่กี่วินาที",
    brand: "SexySlot",
    menus: ["โต๊ะเยอะเลือกได้", "กระเป๋าเงินเดียวจบ"],
    players: 2905,
    img: img2,
  },
  {
    rank: 5,
    name: "หมวดเกมมาใหม่จากค่ายชั้นนำระดับโลก",
    type: "ค่ายชั้นนำส่งเกมใหม่เข้าล็อบบี้ต่อเนื่อง • หาเจอได้จากหมวดที่จัดไว้ให้แล้ว",
    brand: "PG (Pocket Games Soft)",
    menus: ["เกมใหม่เข้าต่อเนื่อง", "จัดหมวดให้หาง่าย"],
    players: 2431,
    img: img1,
  },
  {
    rank: 6,
    name: "รวมหลายค่ายไว้ในยูสเซอร์เดียวกัน",
    type: "สลับเล่นข้ามค่ายได้โดยไม่ต้องโยกเงิน • ฝากถอนออโต้เสร็จในไม่กี่วินาที",
    brand: "SlotXO",
    menus: ["ไม่ต้องโยกเงินข้ามหมวด", "ฝากถอนออโต้ 24 ชั่วโมง"],
    players: 2108,
    img: img3,
  },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดเกมที่สมาชิก PROFIT55 กำลังตามเล่นอยู่ตอนนี้" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#e3ac22]/35 bg-[#161004]/88 px-6 py-6 text-center shadow-[0_10px_30px_rgba(227,172,34,0.22)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">🎰</span>
    <p class="bg-gradient-to-r from-[#fffaf0] via-[#ffe9a8] to-[#cfd8e2] bg-clip-text text-2xl font-black tracking-wide text-transparent">หมวดเกมที่สมาชิก PROFIT55 กำลังตามเล่นอยู่ตอนนี้</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#f3e6c4]/80">
      กระดานนี้จับหมวดที่คนเข้าเยอะที่สุดในล็อบบี้มาเรียงไว้ในหน้าเดียว ตั้งแต่โต๊ะบาคาร่าสดและคาสิโนสดสตรีมมิ่ง HD ไปจนถึงสล็อตจากค่ายชั้นนำทั่วโลก
      กดสลับหมวดได้ตลอดทั้งวันด้วยยูสเซอร์เดียวและกระเป๋าเงินเดียว ไม่ต้องโยกเงินหรือออกจากระบบ รายชื่อที่กำลังมาแรงเปลี่ยนได้ตามช่วงเวลา
      ควรเปิดดูอัตราการจ่ายและเงื่อนไขของแต่ละเกมจากหน้าเกมจริงอีกครั้งก่อนลงเดิมพัน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e3ac22] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#cfd8e2]/60 bg-gradient-to-r from-[#2a1d05]/80 via-[#161004]/92 to-[#0a0702]/88 shadow-[0_15px_40px_rgba(207,216,226,0.28)]"
                : "border-[#e3ac22]/30 bg-[#161004]/88 shadow-[0_10px_30px_rgba(227,172,34,0.18)] hover:border-[#e3ac22]/55 hover:shadow-[0_15px_40px_rgba(227,172,34,0.32)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#8a6410]/45 blur-[40px] transition-all duration-500 group-hover:bg-[#e3ac22]/35" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#e3ac22] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#cfd8e2]/60" : "border-[#e3ac22]/35"}`}>
              <Picture
                src={g.img}
                alt={`โลโก้ค่ายเกมพันธมิตร ${g.brand} ที่อยู่ในลิสต์ค่ายเกมของ PROFIT55`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#f3e6c4] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#eef3f8]/70 bg-gradient-to-r from-[#eef3f8] to-[#cfd8e2] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#0a0702] sm:inline">
                    มาแรงสูงสุด
                  </span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#f3e6c4]/75 sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#e3ac22]/30 bg-[#0a0702] px-2.5 py-0.5 text-[10px] font-bold text-[#ffe9a8]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#f3e6c4]/75">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#eef3f8] to-[#cfd8e2] text-[#0a0702] shadow-[0_10px_30px_rgba(207,216,226,0.35)]"
                    : "border border-[#e3ac22]/60 bg-[#0a0702] text-[#ffe9a8] hover:border-[#cfd8e2] hover:bg-[#2a1d05] hover:text-[#fffaf0]"
                }`}>
                เข้าเล่นเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // ตัวกันเรื่อง visibility, แท็บพื้นหลัง และ reduced-motion อยู่ใน
  // src/lib/liveCounter.ts ซึ่งเป็นไฟล์ที่การรีแบรนด์ไม่เขียนทับ ห้ามเอา
  // setTimeout เปล่าๆ กลับมาไว้ตรงนี้ — ตัวนับอยู่ในกล่อง `hidden sm:flex`
  // ถ้าไม่มีตัวกัน มันจะปลุก main thread บนมือถือทุกเครื่องเพื่ออัปเดตข้อความ
  // ที่ไม่มีใครมองเห็น
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
