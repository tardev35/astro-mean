---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// รูปในแต่ละแถวคือ "โลโก้ค่ายพันธมิตร" ไม่ใช่ภาพของเกมนั้น alt จึงบรรยายโลโก้ตาม
// ตัวอักษรที่พิมพ์อยู่บนรูปจริง — game1 = PG (Pocket Games Soft) ซึ่งก็คือ PG Soft
// ในบรีฟ, game2 = SexySlot, game3 = SlotXO, game4 = Joker ซึ่งก็คือ Joker Gaming,
// game5 = JILI, game6 = PP SLOT ซึ่งก็คือ Pragmatic Play
// ห้ามเปลี่ยนค่า `brand` ของแถวโดยไม่เปลี่ยนไฟล์รูปตาม สลับลำดับแถวได้เพราะรูปกับ
// ชื่อค่ายเดินทางไปด้วยกันในอ็อบเจกต์เดียว ส่วน `name`/`type` เป็นชื่อหมวดเกม
// ซึ่งไม่ได้ผูกกับรูป จึงเปลี่ยนได้อิสระ
//
// GUESS168: ชุดสีเป็นทองหลอมคู่ส้มไฟตามอาร์ตจริง ทองเป็นสีหลักของกระดาน ส่วนแถว
// อันดับหนึ่งรับคู่ส้มเพื่อให้ตัดกับแถวที่เหลือ จุด live สีเขียว Tailwind เป็นสี
// เชิงความหมาย ไม่ถูกแตะ (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกน
// ไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมา
// เป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อแถวก็เป็น <p> เช่นกัน — ไม่มีตัวไหนเป็นหัวข้อจาก docx
// กระดานนี้เป็นภาพประกอบของหัวข้อ docx เรื่องเกมอัปเดตใหม่ที่เติมเข้าลิสต์ต่อเนื่อง
// จึงกางลิสต์ตัวน่าลองให้เห็นในหน้าเดียวว่ามีอะไรเพิ่งเข้าคลังบ้าง
//
// อันดับ 1–3 แสดงเหรียญ "แทน" ตัวเลข ถ้าซ่อนอิโมจิเฉยๆ สามแถวนั้นจะไม่เหลืออันดับ
// ให้อ่านเลย ข้อความ sr-only จึงใส่กลับเข้าไปคู่กับ aria-hidden
const games = [
  {
    rank: 1,
    name: "ลิสต์เกมเข้าคลังใหม่ภายใน 24 ชั่วโมง",
    type: "ค่ายใหญ่ปล่อยเกมไหนก็อัปเดตเข้าคลังทันที ไม่ต้องรอระบบอนุมัติข้ามสัปดาห์ • วางไว้หน้าสุดให้เข้าถึงได้ก่อนใคร",
    brand: "Pragmatic Play",
    menus: ["เข้าคลังใน 24 ชม.", "ไม่ต้องรอกระแสซา"],
    players: 5124,
    img: img6,
  },
  {
    rank: 2,
    name: "หมวดโหมดทดลองเล่นฟรี",
    type: "เช็กจังหวะโบนัสและกลไกเกมก่อนลงเงินจริง จับทางเกมใหม่ได้โดยไม่ต้องเสี่ยงทุนตั้งแต่ไม้แรก",
    brand: "Joker Gaming",
    menus: ["ทดลองเล่นฟรี", "เช็กจังหวะโบนัส"],
    players: 3842,
    img: img4,
  },
  {
    rank: 3,
    name: "หมวดฟีเจอร์ Multiplier สุ่มตัวคูณหนัก",
    type: "รวมเกมที่สุ่มแจกตัวคูณ • ตัวคูณสะสมที่เปลี่ยนเบทเริ่มต้น 1 บาทให้ลุ้นโบนัสก้อนโตได้ทันที",
    brand: "JILI",
    menus: ["Multiplier", "เบทเริ่ม 1 บาท"],
    players: 3517,
    img: img5,
  },
  {
    rank: 4,
    name: "หมวดระบบ Wild ซ้อนทับ",
    type: "สัญลักษณ์ไวลด์ซ้อนกันเป็นชั้นในสปินเดียว เปิดทางให้แนวรางวัลเกิดพร้อมกันหลายเส้น",
    brand: "SexySlot",
    menus: ["Wild ซ้อนทับ", "ลุ้นหลายเส้น"],
    players: 2905,
    img: img2,
  },
  {
    rank: 5,
    name: "หมวดคอมโบแตกต่อเนื่อง Cascading",
    type: "สัญลักษณ์แตกแล้วร่วงต่อกันเป็นชุด ทุกการหมุนมีจังหวะให้ลุ้นยาว ไม่ปล่อยให้เสียจังหวะฟรี",
    brand: "PG Soft (Pocket Games Soft)",
    menus: ["Cascading", "ลุ้นต่อเนื่อง"],
    players: 2431,
    img: img1,
  },
  {
    rank: 6,
    name: "หมวดโหมด Bonus Buy ซื้อฟรีสปิน",
    type: "ซื้อฟรีสปินพุ่งตรงเข้าลุ้นรางวัลใหญ่ทันที สำหรับสายที่ไม่อยากรอจังหวะเข้าโบนัสเอง",
    brand: "SlotXO",
    menus: ["Bonus Buy", "เข้ารอบใหญ่ไว"],
    players: 2108,
    img: img3,
  },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="ลิสต์เกมอัปเดตใหม่และฟีเจอร์น่าลองที่ GUESS168 เติมเข้าคลังต่อเนื่อง" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#c58a00]/40 bg-[#231005]/88 px-6 py-6 text-center shadow-[0_10px_30px_rgba(197,138,0,0.28)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">🆕</span>
    <p class="bg-gradient-to-r from-[#fff6e0] via-[#ffd54a] to-[#fe9c01] bg-clip-text text-2xl font-black tracking-wide text-transparent">ลิสต์เกมอัปเดตใหม่ในคลัง GUESS168 ที่น่าลองตาม</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#d8bb87]">
      ค่ายใหญ่ปล่อยเกมไหนก็อัปเดตเข้าคลังภายใน 24 ชั่วโมง ทั้งหมวดของใหม่ล่าสุด หมวดโหมดทดลองเล่นฟรี หมวดฟีเจอร์ Multiplier หมวดระบบ Wild ซ้อนทับ หมวดคอมโบแตกต่อเนื่อง Cascading และหมวดโหมด Bonus Buy
      กางไว้ในหน้าเดียวให้เลื่อนดูได้ครบ ลำดับความนิยมเปลี่ยนได้ตามช่วงเวลา ควรเปิดดูอัตราการจ่ายและรายละเอียดฟีเจอร์ของแต่ละเกมจากหน้าเกมจริงอีกครั้งก่อนลงเดิมพัน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fecc02] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#fe9c01]/60 bg-gradient-to-r from-[#33180a]/80 via-[#231005]/92 to-[#140800]/88 shadow-[0_15px_40px_rgba(254,156,1,0.22)]"
                : "border-[#c58a00]/35 bg-[#231005]/88 shadow-[0_10px_30px_rgba(197,138,0,0.2)] hover:border-[#ffd54a]/55 hover:shadow-[0_15px_40px_rgba(254,204,2,0.32)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#33180a]/70 blur-[40px] transition-all duration-500 group-hover:bg-[#c58a00]/35" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#ffd54a] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#fe9c01]/60" : "border-[#c58a00]/40"}`}>
              <Picture
                src={g.img}
                alt={`โลโก้ค่ายเกมลิขสิทธิ์ ${g.brand} ที่อยู่ในคลังเกมของ GUESS168`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#f7e7c6] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#fe9c01]/70 bg-gradient-to-r from-[#ffd54a] to-[#fe9c01] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#140800] sm:inline">
                    เข้าคลังล่าสุด
                  </span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#d8bb87] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#c58a00]/40 bg-[#140800] px-2.5 py-0.5 text-[10px] font-bold text-[#ffd54a]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#d8bb87]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ffd54a] to-[#fe9c01] text-[#140800] shadow-[0_10px_30px_rgba(254,156,1,0.35)]"
                    : "border border-[#c58a00]/60 bg-[#140800] text-[#ffd54a] hover:border-[#fecc02] hover:bg-[#33180a] hover:text-[#fff6e0]"
                }`}>
                เข้าเล่นเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // ตัวกันเรื่อง visibility, แท็บพื้นหลัง และ reduced-motion อยู่ใน
  // src/lib/liveCounter.ts ซึ่งเป็นไฟล์ที่การรีแบรนด์ไม่เขียนทับ ห้ามเอา
  // setTimeout เปล่าๆ กลับมาไว้ตรงนี้ — ตัวนับอยู่ในกล่อง `hidden sm:flex`
  // ถ้าไม่มีตัวกัน มันจะปลุก main thread บนมือถือทุกเครื่องเพื่ออัปเดตข้อความ
  // ที่ไม่มีใครมองเห็น
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
