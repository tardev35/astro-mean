---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// แต่ละแถวผูกกับโลโก้ค่ายที่เป็นเจ้าของเกมนั้นจริง (game1 PG Soft, game2 Joker,
// game3 JILI, game4 Evolution, game5 SA Gaming, game6 Sexy Baccarat) ข้อความ alt
// จึงบรรยายรูปได้ตรง — ห้ามเปลี่ยนชื่อ/ค่ายของแถวโดยไม่เปลี่ยนรูปตาม สลับลำดับได้
// เพราะรูปเดินทางไปกับแถวของมันเอง รอบนี้ยกสล็อตขึ้นก่อนตามแบรนด์สล็อตเว็บตรง
//
// กงล้อ88: ย้ายจากทองบนม่วงพลัมของ TANGTEM168 (#ffe9a8 / #fcc30b / #e09a05 /
// #ce5a03 คู่ม่วง #c79bf0 / #7e3ac7 / #3c0f52 บนผิว #2a0a2e / #1c0620 เนื้อความ
// #f7e6c4 ข้อความรอง #c3a98e) มาที่ทองอร่ามคู่เปลวไฟ — #ffe974 / #ffcc4b /
// #eb9a1d / #8b4c0b คู่เปลวไฟ #ff6a13 / #ffa34d บนผิว #1e1105 / #140a02 /
// #2c1808 เนื้อความ #f6e6c2 ข้อความรอง #c9ab7a โดยแถวอันดับหนึ่งรับสีรองของแบรนด์
// คือเปลวไฟ #ff6a13 / #ffa34d
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อแถวก็เป็น <p> เช่นกัน — ไม่มีตัวไหนเป็นหัวข้อจาก docx
// กระดานนี้ต่อท้ายหัวข้อ docx เรื่องเว็บแท้ไม่ผ่านเอเย่นต์ จึงเน้นความโปร่งใสของ
// อัตราการชนะและการไม่ล็อคยูส
const games = [
  { rank: 1, name: "Mahjong Ways 2", type: "PG Soft • สล็อต", menus: ["ตัวฮิตติดล็อบบี้", "ภาพคมไม่กระตุก"], players: 5124, img: img1 },
  { rank: 2, name: "Fortune Gems", type: "JILI • สล็อต", menus: ["รอบสั้นตัดสินไว", "เกมแตกง่าย"], players: 3842, img: img3 },
  { rank: 3, name: "Roma X", type: "Joker Gaming • สล็อต", menus: ["แนวคลาสสิกเล่นง่าย", "กติกาไม่ซับซ้อน"], players: 3517, img: img2 },
  { rank: 4, name: "Lightning Roulette", type: "Evolution • คาสิโนสด", menus: ["ไม่ล็อคยูส", "สลับเล่นในบัญชีเดียว"], players: 2905, img: img4 },
  { rank: 5, name: "Dragon Tiger", type: "SA Gaming • เสือมังกร", menus: ["จังหวะไวไม่สะดุด", "ปั่นต่อเนื่องยาวๆ"], players: 2431, img: img5 },
  { rank: 6, name: "เซ็กซี่ บาคาร่า", type: "Sexy Baccarat • บาคาร่า", menus: ["เปลี่ยนบรรยากาศได้ไว", "เปิดโต๊ะ 24 ชั่วโมง"], players: 2108, img: img6 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="เกมมาแรงที่สมาชิก กงล้อ88 กำลังปั่นอยู่ตอนนี้" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#ffcc4b]/35 bg-[#1e1105]/88 px-6 py-6 text-center shadow-[0_10px_30px_rgba(255,204,75,0.22)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">🎡</span>
    <p class="bg-gradient-to-r from-[#ffe974] via-[#ffcc4b] to-[#ff6a13] bg-clip-text text-2xl font-black tracking-wide text-transparent">เกมมาแรงที่สมาชิก กงล้อ88 กำลังปั่นอยู่ตอนนี้</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#c9ab7a]">
      กระดานนี้จับเกมตัวเด็ดจากค่ายดังมาวางเรียงไว้ในล็อบบี้เดียว กดสลับเข้าเล่นได้ตลอดทั้งวันในบัญชีเดียวโดยไม่ต้องโยกเงินหรือสลับเว็บ รายชื่อเกมมาแรงเปลี่ยนได้ตามช่วงเวลา
      ควรเปิดดูเดิมพันเริ่มต้นและกติกาของแต่ละเกมจากหน้าเกมจริงอีกครั้งก่อนกดสปิน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ffcc4b] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#ffa34d]/60 bg-gradient-to-r from-[#8b4c0b]/60 via-[#1e1105]/92 to-[#140a02]/88 shadow-[0_15px_40px_rgba(255,106,19,0.28)]"
                : "border-[#ffcc4b]/30 bg-[#1e1105]/88 shadow-[0_10px_30px_rgba(255,204,75,0.18)] hover:border-[#ffcc4b]/55 hover:shadow-[0_15px_40px_rgba(255,106,19,0.32)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#ff6a13]/35 blur-[40px] transition-all duration-500 group-hover:bg-[#ffcc4b]/35" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {/* อันดับ 1–3 แสดงเหรียญ "แทน" ตัวเลข ถ้าซ่อนอิโมจิเฉยๆ สามแถวนั้นจะไม่
                  เหลืออันดับให้อ่านเลย ข้อความ sr-only จึงใส่กลับเข้าไป */}
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#ffcc4b] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#ffa34d]/60" : "border-[#ffcc4b]/35"}`}>
              <Picture
                src={g.img}
                alt={`โลโก้ค่ายเกมของ ${g.name} ในกระดานเกมมาแรงของ กงล้อ88`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#f6e6c2] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#ffe974]/70 bg-gradient-to-r from-[#ffe974] to-[#ffcc4b] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#140a02] sm:inline">
                    มาแรงสูงสุด
                  </span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#c9ab7a] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#ffcc4b]/30 bg-[#140a02] px-2.5 py-0.5 text-[10px] font-bold text-[#ffcc4b]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#c9ab7a]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ffe974] to-[#ffcc4b] text-[#140a02] shadow-[0_10px_30px_rgba(255,204,75,0.35)]"
                    : "border border-[#ffcc4b]/60 bg-[#140a02] text-[#ffcc4b] hover:border-[#ffe974] hover:bg-[#2c1808] hover:text-[#ffe974]"
                }`}>
                เข้าดูเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // ตัวกันเรื่อง visibility, แท็บพื้นหลัง และ reduced-motion อยู่ใน
  // src/lib/liveCounter.ts ซึ่งเป็นไฟล์ที่การรีแบรนด์ไม่เขียนทับ ห้ามเอา
  // setTimeout เปล่าๆ กลับมาไว้ตรงนี้ — ตัวนับอยู่ในกล่อง `hidden sm:flex`
  // ถ้าไม่มีตัวกัน มันจะปลุก main thread บนมือถือทุกเครื่องเพื่ออัปเดตข้อความ
  // ที่ไม่มีใครมองเห็น
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
