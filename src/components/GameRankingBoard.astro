---
// PHOENIX168: ชุดสีย้ายมาที่ไฟฟีนิกซ์คู่ทองขนนกตามอาร์ตจริง — ส้มไฟ #ff5a1e /
// #ffa14a / #ffe2c4 / #c04a12 / #7a2408 คู่ทอง #f3ac3c / #f4dc6d บนผิว #0a0402 /
// #150703 / #1f0a05 เนื้อความ #f2ddc9 ข้อความรอง #c4a08a แถวอันดับหนึ่งรับครีมสว่าง
// เพื่อให้ตัดกับแถวที่เหลือ จุด live สีเขียว Tailwind เป็นสีเชิงความหมาย ไม่ถูกแตะ
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history)
//
// ไม่มีรูปโลโก้ค่ายในแถวไหนเลย และไม่ import src/assets/providers/game* — โลโก้ค่าย
// อยู่ที่ ProviderGridPremium ซึ่งเป็นที่ของมัน กระดานนี้กางหมวดหมู่เกมในล็อบบี้
// ไม่ใช่รายชื่อค่าย การเอาโลโก้ค่ายมาแปะข้างชื่อหมวดแล้วเขียน alt ให้เป็นอย่างอื่น
// คือ alt ที่ไม่ตรงกับรูป และรูปที่ import แต่ไม่ได้ใช้คือรูปที่ถูก emit ลง dist/
// ฟรีๆ ช่องรูปจึงเป็นไอคอนกรอบไฟที่เป็น aria-hidden แทน
//
// ไม่ผูกหมวดเกมกับชื่อค่ายรายแถว: docx เอ่ยค่าย (PG Soft, Pragmatic Play, Joker
// Gaming) กับแนวเกมไว้คนละประโยค การจับคู่ว่าแนวไหนเป็นของค่ายไหนเป็นข้อมูลที่ brief
// ไม่ได้ให้ ช่องขวาของแต่ละแถวจึงบอก "จุดเด่นของหมวด" ซึ่งเป็นข้อเท็จจริงที่ docx
// ให้ไว้ตรงๆ แทน
//
// Widget ไม่ใช่ article: หัวข้อกระดานเป็น <p> และ <section> เป็นตัวถือชื่อสำหรับ
// assistive tech ชื่อแถวก็เป็น <p> เช่นกัน — ไม่มีตัวไหนเป็นหัวข้อจาก docx
// กระดานนี้เป็นภาพประกอบของหัวข้อ docx ข้อ 4 เรื่องเปิดล็อบบี้เดียวก็เจอเกมหลายแนว
// จึงกางหมวดเกมที่กดสลับได้ในกระเป๋าเดียวให้เห็นครบในหน้าเดียว
//
// อันดับ 1–3 แสดงเหรียญ "แทน" ตัวเลข ถ้าซ่อนอิโมจิเฉยๆ สามแถวนั้นจะไม่เหลืออันดับ
// ให้อ่านเลย ข้อความ sr-only จึงใส่กลับเข้าไปคู่กับ aria-hidden
const games = [
  {
    rank: 1,
    name: "สล็อตสายภาพสวย 3D",
    type: "หมวดที่กราฟิกแสดงผลคมชัดที่สุดในล็อบบี้ • ตัวเกมประมวลผลสมูธ ไม่มีอาการกระตุกหรือหลุดออกจากเกมให้เสียจังหวะ",
    focus: "กราฟิกคมชัด ประมวลผลสมูธ",
    menus: ["ภาพ 3D", "เล่นลื่นไม่สะดุด"],
    players: 5124,
    icon: "🎨",
  },
  {
    rank: 2,
    name: "สล็อตสายซื้อฟีเจอร์",
    type: "พุ่งชนโบนัสได้ทันทีโดยไม่ต้องรอจังหวะ เหมาะกับคนที่อยากได้ฟีลสปีดตั้งแต่สปินแรก",
    focus: "ซื้อฟีเจอร์พุ่งชนโบนัส",
    menus: ["เข้าโบนัสไว", "สายสปีด"],
    players: 3842,
    icon: "🛒",
  },
  {
    rank: 3,
    name: "สล็อตสตรีตนำโชค",
    type: "หมวดยอดฮิตของคนไทยที่กดเข้าเล่นได้ทันทีในกระเป๋าเดียว ไม่ต้องย้ายเว็บและไม่ต้องโยกเงิน",
    focus: "กระเป๋าเดียวกดเลือกได้ทันที",
    menus: ["ไม่ต้องย้ายเว็บ", "ยูสเซอร์เดียว"],
    players: 3517,
    icon: "🏮",
  },
  {
    rank: 4,
    name: "สล็อตฟีเจอร์ตัวคูณหนัก",
    type: "เกมที่คัดมาเฉพาะตัวที่มีตัวคูณหนัก เปิดโอกาสให้ทุกการหมุนลุ้นแจ็คพอตก้อนโตได้จริง",
    focus: "ตัวคูณหนัก ลุ้นแจ็คพอต",
    menus: ["ตัวคูณหนัก", "แจ็คพอตก้อนโต"],
    players: 2905,
    icon: "💥",
  },
  {
    rank: 5,
    name: "สล็อตฟรีสปินเข้าไว",
    type: "หมวดที่เข้าฟรีสปินถี่ที่สุด เหมาะกับคนที่ชอบให้เกมเดินเรื่องเร็วและไม่อยากรอนาน",
    focus: "ฟรีสปินเข้าไว",
    menus: ["ฟรีสปินถี่", "จังหวะไว"],
    players: 2431,
    icon: "🌀",
  },
  {
    rank: 6,
    name: "สล็อตแตกง่ายอัตราจ่ายยุติธรรม",
    type: "ยิงตรง API แท้จากค่ายใหญ่ โบนัสแตกตามอัตราจ่ายจริงของเกม ไม่มีการดัดแปลงเปอร์เซ็นต์ชนะ",
    focus: "อัตราจ่ายจริงจากค่าย",
    menus: ["API แท้", "ไม่ดัดแปลงอัตราชนะ"],
    players: 2108,
    icon: "💎",
  },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดเกมสล็อตที่ PHOENIX168 จัดไว้ให้กดสลับได้ในล็อบบี้เดียว" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div
    class="mb-8 flex w-full flex-col items-center justify-center gap-2 rounded-3xl border border-[#c04a12]/40 bg-[#150703]/90 px-6 py-6 text-center shadow-[0_10px_30px_rgba(122,36,8,0.28)] backdrop-blur-md">
    <span aria-hidden="true" class="text-2xl">🎰</span>
    <p class="bg-gradient-to-r from-[#ffe2c4] via-[#ffa14a] to-[#ff5a1e] bg-clip-text text-2xl font-black tracking-wide text-transparent">
      หมวดเกมสล็อตที่ PHOENIX168 จัดไว้ให้กดสลับได้ในล็อบบี้เดียว
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#c4a08a]">
      กางให้เห็นครบในหน้าเดียว ทั้งสล็อตสายภาพสวย 3D สล็อตสายซื้อฟีเจอร์ สล็อตสตรีตนำโชค สล็อตฟีเจอร์ตัวคูณหนัก สล็อตฟรีสปินเข้าไว และหมวดแตกง่ายที่จ่ายตามอัตราจริงของค่าย
      อยากเล่นแนวไหนก็กดเลือกได้ทันทีในกระเป๋าเดียว ลำดับความนิยมเปลี่ยนได้ตามช่วงเวลา ควรเปิดดูอัตราจ่ายและเงื่อนไขของแต่ละเกมจากหน้าเกมจริงอีกครั้งก่อนลงเดิมพัน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ff5a1e] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#ffa14a]/55 bg-gradient-to-r from-[#1f0a05]/85 via-[#150703]/92 to-[#0a0402]/90 shadow-[0_15px_40px_rgba(255,90,30,0.2)]"
                : "border-[#c04a12]/35 bg-[#150703]/90 shadow-[0_10px_30px_rgba(122,36,8,0.2)] hover:border-[#ff5a1e]/55 hover:shadow-[0_15px_40px_rgba(255,90,30,0.28)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#1f0a05]/80 blur-[40px] transition-all duration-500 group-hover:bg-[#c04a12]/40" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#ff5a1e] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div
              aria-hidden="true"
              class={`relative z-10 flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border bg-[#0a0402] text-2xl transition-transform duration-500 group-hover:scale-110 sm:h-16 sm:w-16 sm:text-3xl ${
                top ? "border-[#ffa14a]/60" : "border-[#c04a12]/45"
              }`}>
              {g.icon}
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#f2ddc9] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#ffa14a]/70 bg-gradient-to-r from-[#f4dc6d] to-[#ff5a1e] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#0a0402] sm:inline">
                    หมวดที่คนเข้ามากที่สุด
                  </span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#c4a08a] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                <span class="rounded-full border border-[#7a2408]/70 bg-[#1f0a05] px-2.5 py-0.5 text-[10px] font-bold text-[#ffa14a]">{g.focus}</span>
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#c04a12]/40 bg-[#1f0a05] px-2.5 py-0.5 text-[10px] font-bold text-[#ff5a1e]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#c4a08a]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#f4dc6d] to-[#c04a12] text-[#0a0402] shadow-[0_10px_30px_rgba(255,90,30,0.35)]"
                    : "border border-[#c04a12]/60 bg-[#1f0a05] text-[#ff5a1e] hover:border-[#ffa14a] hover:bg-[#7a2408] hover:text-[#ffe2c4]"
                }`}>
                เข้าเล่นเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  // ตัวกันเรื่อง visibility, แท็บพื้นหลัง และ reduced-motion อยู่ใน
  // src/lib/liveCounter.ts ซึ่งเป็นไฟล์ที่การรีแบรนด์ไม่เขียนทับ ห้ามเอา
  // setTimeout เปล่าๆ กลับมาไว้ตรงนี้ — ตัวนับอยู่ในกล่อง `hidden sm:flex`
  // ถ้าไม่มีตัวกัน มันจะปลุก main thread บนมือถือทุกเครื่องเพื่ออัปเดตข้อความ
  // ที่ไม่มีใครมองเห็น
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
