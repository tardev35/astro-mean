---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// MONACO89: ย้ายจากชุดสีชมพูกลอสคู่ทองของแบรนด์เก่ากว่า (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history) มาที่ทองแอมเบอร์–คอปเปอร์คู่แดงรอยัลบนมะฮอกกานีดำ — ทอง
// #ffe9b8 / #ffd77a / #ef8f22 / #a44516 คู่แดง #d1201a / #7e120e บนผิว #26150a /
// #160d05 / #0b0602 เนื้อความ #f6e3c0 ไม่มีชมพู/โรสเหลืออยู่ในไฟล์นี้
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้ให้บล็อกนี้แบก
// section ของ docx ได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น <p>: มันตั้งชื่อแผง UI
// ไม่ใช่ section ของ docx การเลื่อนขึ้นเป็นหัวข้อจะเพิ่มระดับหัวข้อที่ brief
// ไม่เคยขอ — เป็นการแบ่งชุดเดียวกับที่ ContentBoxTwo.astro ใช้
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ
// ถ้าไม่มี title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#ef8f22]/25 bg-[#26150a]/90 p-8 text-[#f6e3c0] shadow-[0_10px_30px_rgba(239,143,34,0.15)] backdrop-blur-xl transition-all duration-500 hover:border-[#ef8f22]/55 hover:shadow-[0_15px_40px_rgba(209,32,26,0.32)] md:p-10">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#160d05]/70 to-transparent opacity-80"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#ef8f22]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd77a] via-[#ef8f22] to-[#d1201a] shadow-[0_0_10px_rgba(239,143,34,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe9b8] via-[#ef8f22] to-[#d1201a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e3c0]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#ef8f22]/25 pb-3 text-xl leading-normal font-black tracking-wide text-[#ef8f22]">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd77a] via-[#ef8f22] to-[#d1201a] shadow-[0_0_10px_rgba(239,143,34,0.5)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e3c0] md:border-l md:border-[#d1201a]/50 md:pl-10">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#ef8f22]/25 pb-3 text-xl leading-normal font-black tracking-wide text-[#ef8f22]">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#d1201a] via-[#a44516] to-[#7e120e] shadow-[0_0_10px_rgba(209,32,26,0.5)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
