---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// LUCKYBKK: ย้ายจากทองคู่แดงของ DEKDDD (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind
// สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้
// ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history) มาเป็นน้ำเงินรอยัลคู่ทองของ
// แบรนด์นี้ — ทอง #ffdf7e / #f0b323 / #9a6c05 คู่น้ำเงิน #3f9dfb / #1f5fd0 /
// #0a2a86 บนผิว #0d2160 / #061442 / #030b28 เนื้อความ #e4eeff
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้ให้บล็อกนี้แบก
// section ของ docx ได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น <p>: มันตั้งชื่อแผง UI
// ไม่ใช่ section ของ docx การเลื่อนขึ้นเป็นหัวข้อจะเพิ่มระดับหัวข้อที่ brief
// ไม่เคยขอ — เป็นการแบ่งชุดเดียวกับที่ ContentBoxTwo.astro ใช้ รอบนี้ผู้เรียก
// เดียวคือ LoginRtpSection ซึ่งเป็น widget จึงส่งแค่ `label` ไม่ส่ง `title`
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ
// ถ้าไม่มี title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f0b323]/25 bg-[#061442]/90 p-8 text-[#e4eeff] shadow-[0_10px_30px_rgba(240,179,35,0.15)] backdrop-blur-xl transition-all duration-500 hover:border-[#f0b323]/55 hover:shadow-[0_15px_40px_rgba(31,95,208,0.35)] md:p-10">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#0d2160]/70 to-transparent opacity-80"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f0b323]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffdf7e] via-[#f0b323] to-[#1f5fd0] shadow-[0_0_10px_rgba(240,179,35,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f5f9ff] via-[#f0b323] to-[#3f9dfb] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e4eeff]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#f0b323]/25 pb-3 text-xl leading-normal font-black tracking-wide text-[#f0b323]">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffdf7e] via-[#f0b323] to-[#9a6c05] shadow-[0_0_10px_rgba(240,179,35,0.5)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e4eeff] md:border-l md:border-[#1f5fd0]/60 md:pl-10">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#f0b323]/25 pb-3 text-xl leading-normal font-black tracking-wide text-[#f0b323]">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#3f9dfb] via-[#1f5fd0] to-[#0a2a86] shadow-[0_0_10px_rgba(31,95,208,0.5)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
