---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titleright, label } = Astro.props;

// Both column titles are deliberately <p>, not headings: they label UI panels
// (a login form, a reference table), not docx sections, so promoting them would
// add heading levels the brief never asked for. The section carries its own
// accessible name instead, which is what `label` is for.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#0a5df1]/25 bg-white/85 p-8 text-[#0b3a63] shadow-[0_10px_30px_rgba(10,93,241,0.15)] backdrop-blur-xl transition-all duration-500 hover:border-[#0a5df1]/50 hover:shadow-[0_15px_40px_rgba(1,203,246,0.28)] md:p-10">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#dceafe]/70 to-transparent opacity-80"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#0b3a63]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#0a5df1]/25 pb-3 text-xl leading-normal font-black tracking-wide text-[#0743a8]">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f1d42c] via-[#01cbf6] to-[#0a5df1] shadow-[0_0_10px_rgba(10,93,241,0.45)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#0b3a63] md:border-l md:border-[#acddfb] md:pl-10">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#0a5df1]/25 pb-3 text-xl leading-normal font-black tracking-wide text-[#0743a8]">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f1d42c] via-[#01cbf6] to-[#0a5df1] shadow-[0_0_10px_rgba(10,93,241,0.45)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
