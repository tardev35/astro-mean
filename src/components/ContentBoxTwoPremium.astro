---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// DEED888: ไฟล์นี้มาถึงรอบนี้ในชุดน้ำเงินรอยัลของแบรนด์ก่อนหน้า ย้ายทั้งไฟล์มาเป็น
// ส้มเพลิงคู่ทองหลอม — ส้ม #e95b0b / #ff9d4d / #fff4e8 / #93300a / #6b2205
// คู่ทอง #f4940c / #ffcf6b / #a35c02 บนผิว #2a0a02 / #3a1004 / #150401
// เนื้อความ #fbe3d0 ข้อความรอง #d9b096
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิม
// ได้จาก git history)
//
// การ์ดใบนี้ออกแบบให้อ่านเป็น "คู่สี" ไม่ใช่แถบสีเดียวกันสองแถบ รอบนี้คู่สีคือ
// ส้มเพลิงกับทองหลอม: ป้ายคอลัมน์ซ้ายรับส้มซึ่งเป็นสีนำ ป้ายคอลัมน์ขวารับทองซึ่ง
// เป็นสีคู่ ส่วนครีมสว่าง (ขอบไฟของ wordmark) ไปอยู่ที่ไล่เฉดหัวข้อกับแถบขีดหัวข้อ
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้ให้บล็อกนี้แบก
// section ของ docx ได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น <p>: มันตั้งชื่อแผง UI
// ไม่ใช่ section ของ docx การเลื่อนขึ้นเป็นหัวข้อจะเพิ่มระดับหัวข้อที่ brief
// ไม่เคยขอ — docx รอบนี้แบน H1 + H2 ล้วน ไม่มี H3 เลย
//
// รอบนี้บล็อกนี้แบกหัวข้อ docx ข้อ 3 เรื่องเกมกระแสมีครบ ตัวใหม่ก็พร้อมมา
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ
// ถ้าไม่มี title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#6b2205]/60 bg-[#2a0a02]/90 p-8 text-[#fbe3d0] shadow-[0_10px_30px_rgba(147,48,10,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#e95b0b]/55 hover:shadow-[0_15px_40px_rgba(244,148,12,0.24)] md:p-10">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#3a1004]/70 to-transparent opacity-80"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#6b2205]/60 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffcf6b] via-[#fff4e8] to-[#6b2205] shadow-[0_0_10px_rgba(233,91,11,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff4e8] via-[#ff9d4d] to-[#f4940c] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe3d0]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#6b2205]/50 pb-3 text-xl leading-normal font-black tracking-wide text-[#ff9d4d]">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff4e8] via-[#ff9d4d] to-[#6b2205] shadow-[0_0_10px_rgba(233,91,11,0.5)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe3d0] md:border-l md:border-[#f4940c]/35 md:pl-10">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#f4940c]/25 pb-3 text-xl leading-normal font-black tracking-wide text-[#f4940c]">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffcf6b] via-[#f4940c] to-[#a35c02] shadow-[0_0_10px_rgba(244,148,12,0.45)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
