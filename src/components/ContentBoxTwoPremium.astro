---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// CK1968: ไฟล์นี้มาถึงรอบนี้ในชุดทองอำพันคู่โครเมียมเงินของแบรนด์ก่อนหน้า ย้ายทั้ง
// ไฟล์มาเป็นทองคำคู่แดงเลือดหมู — ทอง #ffefc4 / #ffd45c / #f0a80c / #a76806 /
// #5d3a05 คู่แดง #ff4b52 / #d4090f / #8c0206 / #3d0203 บนผิว #090302 / #170806 /
// #2a100a ขอบ #4d1f0d เนื้อความ #f6e4c0
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิม
// ได้จาก git history)
//
// การ์ดใบนี้ออกแบบให้อ่านเป็น "คู่สี" ไม่ใช่แถบสีเดียวกันสองแถบ รอบนี้คู่สีคือทองคำ
// กับแดงเลือดหมู: ป้ายคอลัมน์ซ้ายรับทองซึ่งเป็นสีนำ ป้ายคอลัมน์ขวารับแดงซึ่งเป็น
// สีคู่ (ตัว K ในโลโก้ ทับทิมบนมงกุฎ ไพ่ชุดแดงและลูกเต๋าแดง) ส่วนทองซีดสว่างไปอยู่
// ที่ไล่เฉดหัวข้อกับแถบขีดหัวข้อ
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้ให้บล็อกนี้แบก
// section ของ docx ได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น <p>: มันตั้งชื่อแผง UI
// ไม่ใช่ section ของ docx การเลื่อนขึ้นเป็นหัวข้อจะเพิ่มระดับหัวข้อที่ brief
// ไม่เคยขอ — docx รอบนี้เป็น H1 + H2 ล้วน ส่วน H3 สี่ตัวเดียวของหน้าแรกอยู่ที่
// FeatureHighlights
//
// รอบนี้บล็อกนี้แบกหัวข้อ docx ข้อ 4 เรื่องนวัตกรรมระบบออโต้ที่ออกแบบมาเพื่อความ
// รวดเร็วทันใจ
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ
// ถ้าไม่มี title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#4d1f0d]/70 bg-[#170806]/90 p-8 text-[#f6e4c0] shadow-[0_10px_30px_rgba(93,58,5,0.35)] backdrop-blur-xl transition-all duration-500 hover:border-[#f0a80c]/55 hover:shadow-[0_15px_40px_rgba(212,9,15,0.25)] md:p-10">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#2a100a]/70 to-transparent opacity-80"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#4d1f0d]/70 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#d4090f] via-[#ffefc4] to-[#5d3a05] shadow-[0_0_10px_rgba(240,168,12,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffefc4] via-[#ffd45c] to-[#ff4b52] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e4c0]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#4d1f0d]/60 pb-3 text-xl leading-normal font-black tracking-wide text-[#ffd45c]">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffefc4] via-[#f0a80c] to-[#5d3a05] shadow-[0_0_10px_rgba(240,168,12,0.5)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e4c0] md:border-l md:border-[#d4090f]/30 md:pl-10">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#d4090f]/25 pb-3 text-xl leading-normal font-black tracking-wide text-[#ff4b52]">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff4b52] via-[#d4090f] to-[#3d0203] shadow-[0_0_10px_rgba(212,9,15,0.5)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
