---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// TANGTEM168: ไฟล์นี้เคยเป็นเขียวมังกรนีออนของ DRACO65 (#dcfce7 / #4ade80 /
// #22c55e / #15803d / #14532d / #052e16 บนผิว #0a3318 / #062011 เนื้อความ
// #d6ecdd และเงิน/โครเมียม #e2e8e4) ตอนนี้ย้ายมาทองบนม่วงพลัม — #ffe9a8 /
// #fcc30b / #e09a05 / #ce5a03 คู่กับม่วง #7e3ac7 / #3c0f52 บนผิว #3c0f52 /
// #2a0a2e เนื้อความ #f7e6c4 ไม่มีเขียวเหลืออยู่ในไฟล์นี้
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้ให้บล็อกนี้แบก
// section ของ docx ได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น <p>: มันตั้งชื่อแผง UI
// ไม่ใช่ section ของ docx การเลื่อนขึ้นเป็นหัวข้อจะเพิ่มระดับหัวข้อที่ brief
// ไม่เคยขอ — เป็นการแบ่งชุดเดียวกับที่ ContentBoxTwo.astro ใช้
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ
// ถ้าไม่มี title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#fcc30b]/25 bg-[#3c0f52]/90 p-8 text-[#f7e6c4] shadow-[0_10px_30px_rgba(252,195,11,0.15)] backdrop-blur-xl transition-all duration-500 hover:border-[#fcc30b]/55 hover:shadow-[0_15px_40px_rgba(126,58,199,0.32)] md:p-10">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#2a0a2e]/70 to-transparent opacity-80"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#fcc30b]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a8] via-[#fcc30b] to-[#7e3ac7] shadow-[0_0_10px_rgba(252,195,11,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe9a8] via-[#fcc30b] to-[#ce5a03] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e6c4]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#fcc30b]/25 pb-3 text-xl leading-normal font-black tracking-wide text-[#fcc30b]">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a8] via-[#fcc30b] to-[#7e3ac7] shadow-[0_0_10px_rgba(252,195,11,0.5)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e6c4] md:border-l md:border-[#7e3ac7]/50 md:pl-10">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#fcc30b]/25 pb-3 text-xl leading-normal font-black tracking-wide text-[#fcc30b]">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#c79bf0] via-[#7e3ac7] to-[#3c0f52] shadow-[0_0_10px_rgba(199,155,240,0.5)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
