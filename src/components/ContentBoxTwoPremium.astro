---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titleright, label } = Astro.props;

// Both column titles are deliberately <p>, not headings: they label UI panels
// (a login form, a reference table), not docx sections, so promoting them would
// add heading levels the brief never asked for. The section carries its own
// accessible name instead, which is what `label` is for.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#fcda3d]/30 bg-[#12071f]/92 p-8 text-[#efe3f7] shadow-[0_10px_30px_rgba(11,6,22,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fcda3d]/55 hover:shadow-[0_15px_40px_rgba(252,218,61,0.24)] md:p-10">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#5b0374]/45 to-transparent opacity-70"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#efe3f7]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#fcda3d]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe98a] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe98a] via-[#fcda3d] to-[#a9760d] shadow-[0_0_10px_rgba(252,218,61,0.45)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#efe3f7] md:border-l md:border-[#5b0374] md:pl-10">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#fcda3d]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe98a] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe98a] via-[#fcda3d] to-[#a9760d] shadow-[0_0_10px_rgba(252,218,61,0.45)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
