---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// SBOGOOL: น้ำเงินรอยัลสนามไฟคู่ทอง — น้ำเงิน #1e4bb8 / #2f6fe4 / #5b9cff / #7fb0ff /
// #0b1f52 คู่ทอง #f5c518 / #ffe07a / #a87908 คู่เงินโครเมียมจากตัวอักษรโลโก้
// #e8eefc / #c3cfe6 บนผิว #030b22 / #071433 / #0d1f4d เนื้อความ #dce7fb
// (ค่า hex ของแบรนด์ก่อนไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิม
// ได้จาก git history)
//
// ป้ายคอลัมน์ซ้ายรับคู่น้ำเงินอิเล็กทริก ป้ายคอลัมน์ขวารับคู่ทอง ทั้งการ์ดจึงอ่าน
// เป็นคู่สีของแบรนด์ ไม่ใช่แถบสีเดียวกันสองแถบ
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้ให้บล็อกนี้แบก
// section ของ docx ได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น <p>: มันตั้งชื่อแผง UI
// ไม่ใช่ section ของ docx การเลื่อนขึ้นเป็นหัวข้อจะเพิ่มระดับหัวข้อที่ brief
// ไม่เคยขอ — เป็นการแบ่งชุดเดียวกับที่ ContentBoxTwo.astro ใช้ รอบนี้บล็อกนี้
// แบกหัวข้อ docx ข้อ 2 (มีอะไรเด็ดซ่อนอยู่ในล็อบบี้บ้าง)
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ
// ถ้าไม่มี title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#1e4bb8]/25 bg-[#071433]/90 p-8 text-[#dce7fb] shadow-[0_10px_30px_rgba(30,75,184,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#5b9cff]/55 hover:shadow-[0_15px_40px_rgba(245,197,24,0.28)] md:p-10">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#0d1f4d]/70 to-transparent opacity-80"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#1e4bb8]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#7fb0ff] via-[#2f6fe4] to-[#f5c518] shadow-[0_0_10px_rgba(47,111,228,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#e8eefc] via-[#7fb0ff] to-[#f5c518] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dce7fb]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#1e4bb8]/25 pb-3 text-xl leading-normal font-black tracking-wide text-[#7fb0ff]">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#5b9cff] via-[#2f6fe4] to-[#0b1f52] shadow-[0_0_10px_rgba(47,111,228,0.5)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dce7fb] md:border-l md:border-[#f5c518]/45 md:pl-10">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#f5c518]/25 pb-3 text-xl leading-normal font-black tracking-wide text-[#ffe07a]">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe07a] via-[#f5c518] to-[#a87908] shadow-[0_0_10px_rgba(245,197,24,0.5)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
