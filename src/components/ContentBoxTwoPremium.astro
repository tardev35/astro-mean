---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// ASHTON168: ทองสว่างคู่เงินโครเมียม — ทอง #f5c518 / #ffd75e / #ffe9a3 / #c8941a /
// #a87908 คู่เงิน #e2e5e9 / #f0f2f5 / #5f6469 บนผิว #080502 / #160e03 / #2a1c06
// เนื้อความ #f0e6d2 ตัวอักษรสว่าง #fdf6e6 (ค่า hex ของแบรนด์เก่าไม่พิมพ์ไว้ตรงนี้
// เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่
// ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// ป้ายคอลัมน์ซ้ายรับคู่ทอง ป้ายคอลัมน์ขวารับคู่เงินโครเมียม ทั้งการ์ดจึงอ่านเป็น
// คู่สีของแบรนด์ ไม่ใช่แถบสีเดียวกันสองแถบ
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้ให้บล็อกนี้แบก
// section ของ docx ได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น <p>: มันตั้งชื่อแผง UI
// ไม่ใช่ section ของ docx การเลื่อนขึ้นเป็นหัวข้อจะเพิ่มระดับหัวข้อที่ brief
// ไม่เคยขอ — เป็นการแบ่งชุดเดียวกับที่ ContentBoxTwo.astro ใช้ รอบนี้บล็อกนี้
// แบกหัวข้อ docx ข้อ 2 (สล็อตระบบแน่น พร้อมรันเกมค่ายชั้นนำแบบเต็มล็อบบี้)
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ
// ถ้าไม่มี title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f5c518]/25 bg-[#160e03]/90 p-8 text-[#f0e6d2] shadow-[0_10px_30px_rgba(245,197,24,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5c518]/55 hover:shadow-[0_15px_40px_rgba(226,229,233,0.32)] md:p-10">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#2a1c06]/70 to-transparent opacity-80"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f5c518]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd75e] via-[#f5c518] to-[#e2e5e9] shadow-[0_0_10px_rgba(245,197,24,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdf6e6] via-[#ffd75e] to-[#c8941a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6d2]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#f5c518]/25 pb-3 text-xl leading-normal font-black tracking-wide text-[#ffd75e]">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd75e] via-[#f5c518] to-[#7a5405] shadow-[0_0_10px_rgba(245,197,24,0.5)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6d2] md:border-l md:border-[#e2e5e9]/55 md:pl-10">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#e2e5e9]/25 pb-3 text-xl leading-normal font-black tracking-wide text-[#e2e5e9]">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f0f2f5] via-[#e2e5e9] to-[#5f6469] shadow-[0_0_10px_rgba(226,229,233,0.5)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
