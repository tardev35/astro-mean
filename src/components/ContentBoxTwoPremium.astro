---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// UOK789: ย้ายจากน้ำเงินรอยัลคู่ทองของแบรนด์ก่อนหน้า (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้
// — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มี
// ใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history) มาเป็นเขียวมรกตคู่ทอง
// เมทัลลิกของแบรนด์นี้ — ทอง #fdf3c9 / #f6c945 / #8a6a1c คู่เขียว #2fc44f /
// #12923a / #0a4d1c บนผิว #0c3d18 / #04140a / #08290f เนื้อความ #e8f3e4
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้ให้บล็อกนี้แบก
// section ของ docx ได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น <p>: มันตั้งชื่อแผง UI
// ไม่ใช่ section ของ docx การเลื่อนขึ้นเป็นหัวข้อจะเพิ่มระดับหัวข้อที่ brief
// ไม่เคยขอ — เป็นการแบ่งชุดเดียวกับที่ ContentBoxTwo.astro ใช้ รอบนี้ผู้เรียก
// เดียวคือ LoginRtpSection ซึ่งเป็น widget จึงส่งแค่ `label` ไม่ส่ง `title`
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ
// ถ้าไม่มี title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f6c945]/25 bg-[#04140a]/90 p-8 text-[#e8f3e4] shadow-[0_10px_30px_rgba(246,201,69,0.15)] backdrop-blur-xl transition-all duration-500 hover:border-[#f6c945]/55 hover:shadow-[0_15px_40px_rgba(18,146,58,0.35)] md:p-10">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#0c3d18]/70 to-transparent opacity-80"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f6c945]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf3c9] via-[#f6c945] to-[#12923a] shadow-[0_0_10px_rgba(246,201,69,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f4fdf3] via-[#f6c945] to-[#2fc44f] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8f3e4]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#f6c945]/25 pb-3 text-xl leading-normal font-black tracking-wide text-[#f6c945]">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf3c9] via-[#f6c945] to-[#8a6a1c] shadow-[0_0_10px_rgba(246,201,69,0.5)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8f3e4] md:border-l md:border-[#12923a]/60 md:pl-10">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#f6c945]/25 pb-3 text-xl leading-normal font-black tracking-wide text-[#f6c945]">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#2fc44f] via-[#12923a] to-[#0a4d1c] shadow-[0_0_10px_rgba(18,146,58,0.5)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
