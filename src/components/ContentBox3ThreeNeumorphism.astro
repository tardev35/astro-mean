---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label } = Astro.props;

// AWIN8: ไฟล์นี้ผ่านมาหลายแบรนด์ และมาถึงรอบนี้ในชุดสีของแบรนด์ก่อนหน้า รอบนี้ย้าย
// ทั้งไฟล์มาเป็นน้ำเงินรอยัลคู่ทองส้ม — น้ำเงิน #1f6fea / #7fb2ff / #0d3f9e /
// #07265e คู่ทอง #fca311 / #ffd27a และขาวฟ้า #e8f1ff บนผิว #0c2247 เนื้อความ
// #d8e6fb (ค่า hex ของแบรนด์เก่าไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิม
// ได้จาก git history)
//
// ทองส้มถือคอลัมน์กลางกับเส้นใต้หัวข้อ เพื่อให้สีคู่ของแบรนด์มีที่ยืนจริง ไม่ใช่
// น้ำเงินล้วนทั้งใบ
//
// Neumorphism แปลว่าเงาสองด้านต้องเป็นเฉดเข้ม/อ่อนของสีการ์ดเอง ไม่ใช่สีแบรนด์:
// #02081c (เข้มกว่าพื้นหน้า) เป็นเงาทอด และ #123561 (ผิวการ์ดยกขึ้นหนึ่งขั้น) เป็น
// ไฮไลต์ ถ้าเอาน้ำเงินนีออนไปแทน การ์ดจะกลายเป็นแสงเรืองแทนผิวนูน
//
// `title` คือหัวข้อเดียวที่ปล่อยออกมาได้ (แบก section ของ docx ที่ระดับที่ prop `as`
// สั่ง) ส่วน titleleft/titlecenter/titleright เป็น <p> เพราะมันตั้งชื่อคอลัมน์
// ไม่ใช่ section — docx รอบนี้แบน H1 + H2 ล้วน มี h3 ได้เฉพาะใน FeatureHighlights
//
// text-center อยู่บน <header> ซึ่งเป็นพี่น้องของกริด ไม่ใช่บนการ์ด ถ้าย้ายขึ้นไป
// วางบนการ์ดมันจะ inherit ลงไปใน slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
const sectionLabel = title ? undefined : (label ?? titleleft ?? titlecenter ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#0d3f9e]/30 bg-[#0c2247] p-8 shadow-[10px_10px_20px_#02081c,-10px_-10px_20px_#123561] transition-all duration-300 hover:shadow-[15px_15px_30px_#02081c,-15px_-15px_30px_#17427a]">
    {
      title && (
        <header class="mb-8 border-b border-[#fca311]/30 pb-4 text-center">
          <HeadingTag class="bg-gradient-to-r from-[#e8f1ff] via-[#7fb2ff] to-[#fca311] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#0d3f9e]/25 pb-6 text-left text-base leading-relaxed text-[#d8e6fb] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {titleleft && <p class="text-xl leading-normal font-bold text-[#7fb2ff]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#0d3f9e]/25 pb-6 text-left text-base leading-relaxed text-[#d8e6fb] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {titlecenter && <p class="text-xl leading-normal font-bold text-[#fca311]">{titlecenter}</p>}
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d8e6fb] md:pl-6">
        {titleright && <p class="text-xl leading-normal font-bold text-[#7fb2ff]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
