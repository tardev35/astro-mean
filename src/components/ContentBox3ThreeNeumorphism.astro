---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label } = Astro.props;

// GEN4: ไฟล์นี้ผ่านม่วง ทองหรู หยกเขียว และทองคู่เงินโครเมียมมาตามลำดับ รอบนี้ย้าย
// มาเป็นน้ำเงินอิเล็กทริกคู่แดงของแบรนด์นี้ — น้ำเงิน #0071d5 / #01a3f3 / #6fd2ff /
// #00408a คู่แดง #e8241c / #ff5a33 (สีของเลข 4 ในโลโก้ ใช้เป็นสีเน้นรองเท่านั้น)
// บนผิว #0b1b3a เนื้อความ #d7e7ff หัวข้อ #eaf4ff (ค่า hex ของแบรนด์เก่าไม่พิมพ์ไว้
// ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจาก
// ค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// Neumorphism แปลว่าเงาสองด้านต้องเป็นเฉดเข้ม/อ่อนของสีการ์ดเอง ไม่ใช่สีแบรนด์:
// #03060f (เข้มกว่าพื้นหน้า) เป็นเงาทอด และ #12295c (ผิวการ์ดยกขึ้นหนึ่งขั้น) เป็น
// ไฮไลต์ ถ้าเอา #01a3f3 ไปแทน การ์ดจะกลายเป็นแสงเรืองแทนผิวนูน
//
// `title` คือหัวข้อเดียวที่ปล่อยออกมาได้ (แบก section ของ docx) ส่วน
// titleleft/titlecenter/titleright เป็น <p> เพราะมันตั้งชื่อคอลัมน์ ไม่ใช่ section
//
// text-center อยู่บน <header> ซึ่งเป็นพี่น้องของกริด ไม่ใช่บนการ์ด ถ้าย้ายขึ้นไป
// วางบนการ์ดมันจะ inherit ลงไปใน slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
const sectionLabel = title ? undefined : (label ?? titleleft ?? titlecenter ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#0071d5]/30 bg-[#0b1b3a] p-8 shadow-[10px_10px_20px_#03060f,-10px_-10px_20px_#12295c] transition-all duration-300 hover:shadow-[15px_15px_30px_#03060f,-15px_-15px_30px_#17347a]">
    {
      title && (
        <header class="mb-8 border-b border-[#e8241c]/30 pb-4 text-center">
          <HeadingTag class="bg-gradient-to-r from-[#eaf4ff] via-[#01a3f3] to-[#e8241c] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#0071d5]/25 pb-6 text-left text-base leading-relaxed text-[#d7e7ff] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {titleleft && <p class="text-xl leading-normal font-bold text-[#6fd2ff]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#0071d5]/25 pb-6 text-left text-base leading-relaxed text-[#d7e7ff] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {titlecenter && <p class="text-xl leading-normal font-bold text-[#ff5a33]">{titlecenter}</p>}
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d7e7ff] md:pl-6">
        {titleright && <p class="text-xl leading-normal font-bold text-[#6fd2ff]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
