---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label } = Astro.props;

// TITANWIN168: ไฟล์นี้ผ่านมาหลายแบรนด์ และมาถึงรอบนี้ในชุดน้ำเงินอิเล็กทริกคู่แดง
// ของแบรนด์ก่อนหน้า รอบนี้ย้ายทั้งไฟล์มาเป็นม่วงไททันคู่มงกุฎทอง — ม่วง #a855f7 /
// #c084fc / #ede4ff / #7c3aed / #6d28d9 คู่ทองมงกุฎ #e3c176 / #f2dda3 และโครเมียม
// เงิน #dfe4f0 / #b9c0d0 บนผิว #160a2b เนื้อความ #ddd2f5 (ค่า hex ของแบรนด์เก่า
// ไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen
// คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// สีคู่ของแบรนด์ก่อนอยู่ที่คอลัมน์กลางกับเส้นใต้หัวข้อ รอบนี้ทองมงกุฎรับตำแหน่งนั้น
// แทน เพื่อให้สีคู่มีที่ยืนจริง ไม่ใช่ม่วงล้วนทั้งใบ
//
// Neumorphism แปลว่าเงาสองด้านต้องเป็นเฉดเข้ม/อ่อนของสีการ์ดเอง ไม่ใช่สีแบรนด์:
// #050210 (เข้มกว่าพื้นหน้า) เป็นเงาทอด และ #2e1065 (ผิวการ์ดยกขึ้นหนึ่งขั้น) เป็น
// ไฮไลต์ ถ้าเอาม่วงนีออนไปแทน การ์ดจะกลายเป็นแสงเรืองแทนผิวนูน
//
// `title` คือหัวข้อเดียวที่ปล่อยออกมาได้ (แบก section ของ docx ที่ระดับที่ prop `as`
// สั่ง) ส่วน titleleft/titlecenter/titleright เป็น <p> เพราะมันตั้งชื่อคอลัมน์
// ไม่ใช่ section — docx รอบนี้แบน H1 + H2 ล้วน ไม่มี H3 เลย
//
// text-center อยู่บน <header> ซึ่งเป็นพี่น้องของกริด ไม่ใช่บนการ์ด ถ้าย้ายขึ้นไป
// วางบนการ์ดมันจะ inherit ลงไปใน slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
const sectionLabel = title ? undefined : (label ?? titleleft ?? titlecenter ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#6d28d9]/30 bg-[#160a2b] p-8 shadow-[10px_10px_20px_#050210,-10px_-10px_20px_#2e1065] transition-all duration-300 hover:shadow-[15px_15px_30px_#050210,-15px_-15px_30px_#3b0d73]">
    {
      title && (
        <header class="mb-8 border-b border-[#e3c176]/30 pb-4 text-center">
          <HeadingTag class="bg-gradient-to-r from-[#dfe4f0] via-[#c084fc] to-[#e3c176] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#6d28d9]/25 pb-6 text-left text-base leading-relaxed text-[#ddd2f5] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {titleleft && <p class="text-xl leading-normal font-bold text-[#c084fc]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#6d28d9]/25 pb-6 text-left text-base leading-relaxed text-[#ddd2f5] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {titlecenter && <p class="text-xl leading-normal font-bold text-[#e3c176]">{titlecenter}</p>}
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ddd2f5] md:pl-6">
        {titleright && <p class="text-xl leading-normal font-bold text-[#c084fc]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
