---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label } = Astro.props;

// JAICHUA: ไฟล์นี้ผ่านมาหลายแบรนด์ และมาถึงรอบนี้ในชุดสีของแบรนด์ก่อนหน้า รอบนี้
// ย้ายทั้งไฟล์มาเป็นทองคำคู่น้ำเงินรอยัลบนกรมท่าเกือบดำ — ทอง #fbeec9 / #f6d67e /
// #d8a83f / #a97722 / #6d4a12 คู่น้ำเงิน #cfe0fb / #5b8ede / #2f5fb0 บนผิว #0a1226
// เนื้อความ #dce6f8 ข้อความรอง #a9b7d4 (ค่า hex ของแบรนด์เก่าไม่พิมพ์ไว้ตรงนี้ —
// Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มี
// ใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// คอลัมน์กลางแยกตัวออกด้วยน้ำเงินสว่าง (#5b8ede) ซึ่งเป็นสีที่สองจริงของแบรนด์
// (โล่กรมท่าที่รองป้ายทองในโลโก้) ไม่ใช่ทองอีกน้ำหนักหนึ่ง
//
// Neumorphism แปลว่าเงาสองด้านต้องเป็นเฉดเข้ม/อ่อนของสีการ์ดเอง ไม่ใช่สีแบรนด์:
// #02050d (เข้มกว่าพื้นหน้า) เป็นเงาทอด และ #132244 (ผิวการ์ดยกขึ้นหนึ่งขั้น) เป็น
// ไฮไลต์ ถ้าเอาทองสดไปแทน การ์ดจะกลายเป็นแสงเรืองแทนผิวนูน
//
// `title` คือหัวข้อเดียวที่ปล่อยออกมาได้ (แบก section ของ docx ที่ระดับที่ prop `as`
// สั่ง) ส่วน titleleft/titlecenter/titleright เป็น <p> เพราะมันตั้งชื่อคอลัมน์
// ไม่ใช่ section — docx รอบนี้แบน H1 + H2 ล้วน มี h3 ได้เฉพาะใน FeatureHighlights
//
// รอบนี้บล็อกนี้แบกหัวข้อ docx ข้อ 3 เรื่องเกมดังหลายสไตล์ที่สลับอารมณ์ได้
//
// text-center อยู่บน <header> ซึ่งเป็นพี่น้องของกริด ไม่ใช่บนการ์ด ถ้าย้ายขึ้นไป
// วางบนการ์ดมันจะ inherit ลงไปใน slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
const sectionLabel = title ? undefined : (label ?? titleleft ?? titlecenter ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#6d4a12]/40 bg-[#0a1226] p-8 shadow-[10px_10px_20px_#02050d,-10px_-10px_20px_#132244] transition-all duration-300 hover:shadow-[15px_15px_30px_#02050d,-15px_-15px_30px_#16274e]">
    {
      title && (
        <header class="mb-8 border-b border-[#d8a83f]/30 pb-4 text-center">
          <HeadingTag class="bg-gradient-to-r from-[#fbeec9] via-[#f6d67e] to-[#5b8ede] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#6d4a12]/30 pb-6 text-left text-base leading-relaxed text-[#dce6f8] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {titleleft && <p class="text-xl leading-normal font-bold text-[#f6d67e]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#6d4a12]/30 pb-6 text-left text-base leading-relaxed text-[#dce6f8] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {titlecenter && <p class="text-xl leading-normal font-bold text-[#5b8ede]">{titlecenter}</p>}
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dce6f8] md:pl-6">
        {titleright && <p class="text-xl leading-normal font-bold text-[#f6d67e]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
