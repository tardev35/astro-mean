---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label } = Astro.props;

// QUEEN189: ไฟล์นี้ผ่านมาหลายแบรนด์ และมาถึงรอบนี้ในชุดสีของแบรนด์ก่อนหน้า รอบนี้
// ย้ายทั้งไฟล์มาเป็นทองราชสำนักบนดำสนิท — ทอง #fdf3d2 / #fceb83 / #e4bb53 /
// #c38d29 / #7a5615 บนผิว #1a1108 เนื้อความ #f3e4c4 ข้อความรอง #c2a878 (ค่า hex
// ของแบรนด์เก่าไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็น
// คอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git
// history)
//
// แบรนด์นี้เป็นทองวรรณะเดียว คอลัมน์กลางจึงแยกตัวด้วยทองสว่างขึ้น (#fceb83) ไม่ใช่
// ด้วยสีที่สองที่ไม่มีอยู่ในอาร์ตของแบรนด์
//
// Neumorphism แปลว่าเงาสองด้านต้องเป็นเฉดเข้ม/อ่อนของสีการ์ดเอง ไม่ใช่สีแบรนด์:
// #050301 (เข้มกว่าพื้นหน้า) เป็นเงาทอด และ #271a0c (ผิวการ์ดยกขึ้นหนึ่งขั้น) เป็น
// ไฮไลต์ ถ้าเอาทองสดไปแทน การ์ดจะกลายเป็นแสงเรืองแทนผิวนูน
//
// `title` คือหัวข้อเดียวที่ปล่อยออกมาได้ (แบก section ของ docx ที่ระดับที่ prop `as`
// สั่ง) ส่วน titleleft/titlecenter/titleright เป็น <p> เพราะมันตั้งชื่อคอลัมน์
// ไม่ใช่ section — docx รอบนี้แบน H1 + H2 ล้วน มี h3 ได้เฉพาะใน FeatureHighlights
//
// text-center อยู่บน <header> ซึ่งเป็นพี่น้องของกริด ไม่ใช่บนการ์ด ถ้าย้ายขึ้นไป
// วางบนการ์ดมันจะ inherit ลงไปใน slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
const sectionLabel = title ? undefined : (label ?? titleleft ?? titlecenter ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#7a5615]/40 bg-[#1a1108] p-8 shadow-[10px_10px_20px_#050301,-10px_-10px_20px_#271a0c] transition-all duration-300 hover:shadow-[15px_15px_30px_#050301,-15px_-15px_30px_#3c2505]">
    {
      title && (
        <header class="mb-8 border-b border-[#e4bb53]/30 pb-4 text-center">
          <HeadingTag class="bg-gradient-to-r from-[#fdf3d2] via-[#fceb83] to-[#c38d29] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#7a5615]/30 pb-6 text-left text-base leading-relaxed text-[#f3e4c4] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {titleleft && <p class="text-xl leading-normal font-bold text-[#e4bb53]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#7a5615]/30 pb-6 text-left text-base leading-relaxed text-[#f3e4c4] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {titlecenter && <p class="text-xl leading-normal font-bold text-[#fceb83]">{titlecenter}</p>}
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e4c4] md:pl-6">
        {titleright && <p class="text-xl leading-normal font-bold text-[#e4bb53]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
