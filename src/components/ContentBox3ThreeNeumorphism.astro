---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright, label } = Astro.props;

// SGD88: variant นี้ยังเป็นสีเทากลางๆ ที่ตกทอดมาจากแบรนด์เก่า (#141414 / #202020
// เนื้อความ gray-400 หัวคอลัมน์ text-white) รอบนี้ย้ายมาที่ม่วงบานเย็นนีออน
// #f7d0ff / #e879f9 / #bc07e2 คู่ม่วงเข้ม #930ac5 / #4c0a6b บนผิว #1b0d2e
// เนื้อความ #f3e8ff ข้อความรอง #cbb5e6
//
// Neumorphism แปลว่าเงาสองด้านต้องเป็นเฉดเข้ม/อ่อนของสีการ์ดเอง ไม่ใช่สีแบรนด์:
// #0d0617 (เข้มกว่าพื้นหน้า) เป็นเงาทอด และ #291445 (ผิวการ์ดยกขึ้นหนึ่งขั้น) เป็น
// ไฮไลต์ ถ้าเอา #bc07e2 ไปแทน การ์ดจะกลายเป็นแสงเรืองแทนผิวนูน
//
// เดิม component นี้ไม่มี prop `title` เลย และป้ายหัวคอลัมน์สามตัว render เป็น
// <h3> ทั้งชุด ซึ่งเป็นหัวข้อที่ docx ไม่เคยมี รอบนี้ `title` คือหัวข้อเดียวที่
// ปล่อยออกมาได้ (แบก section ของ docx) ส่วน titleleft/titlecenter/titleright
// ลดลงมาเป็น <p> โดยเก็บคลาสเดิมไว้ เพราะมันตั้งชื่อคอลัมน์ ไม่ใช่ section
//
// text-center อยู่บน <header> ซึ่งเป็นพี่น้องของกริด ไม่ใช่บนการ์ด ถ้าย้ายขึ้นไป
// วางบนการ์ดมันจะ inherit ลงไปใน slot แล้วย่อหน้าเนื้อความจะถูกจัดกึ่งกลางตามไปด้วย
const sectionLabel = title ? undefined : (label ?? titleleft ?? titlecenter ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#bc07e2]/30 bg-[#1b0d2e] p-8 shadow-[10px_10px_20px_#0d0617,-10px_-10px_20px_#291445] transition-all duration-300 hover:shadow-[15px_15px_30px_#080310,-15px_-15px_30px_#33195a]">
    {
      title && (
        <header class="mb-8 border-b border-[#bc07e2]/25 pb-4 text-center">
          <HeadingTag class="bg-gradient-to-r from-[#f7d0ff] via-[#e879f9] to-[#bc07e2] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#bc07e2]/20 pb-6 text-left text-base leading-relaxed text-[#f3e8ff] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {titleleft && <p class="text-xl leading-normal font-bold text-[#e879f9]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#bc07e2]/20 pb-6 text-left text-base leading-relaxed text-[#f3e8ff] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {titlecenter && <p class="text-xl leading-normal font-bold text-[#e879f9]">{titlecenter}</p>}
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e8ff] md:pl-6">
        {titleright && <p class="text-xl leading-normal font-bold text-[#e879f9]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
