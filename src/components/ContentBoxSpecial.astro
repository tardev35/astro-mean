---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;

// MONEY777: ย้ายจากเขียวมรกตคู่ทองของ UOK789 มาเป็นแดงส้มคู่ทองของแบรนด์นี้ —
// แดง #ff6a2b / #e0330a / #8b1406 คู่ทอง #ffe08a / #f6c945 / #a3760a บนผิว
// #1a0503 / #0b0101 / #2a0301 เนื้อความ #ffe6d8 (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้
// เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่า
// ที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// ไอคอนใบแรกเป็นทอง ใบที่สองเป็นแดงส้ม ทั้งคู่จึงอ่านเป็นคู่สีของแบรนด์ ไม่ใช่
// สี่เหลี่ยมสีเดียวกันสองใบ — รอบนี้บล็อกนี้แบกหัวข้อ docx ข้อ 4 (ค่ายดังส่งเกม
// ตัวไหนมาบ้าง) ไอคอนจึงเป็นถ้วยรางวัลของค่ายระดับตำนานกับจอยเกมของเกมมาใหม่
// แล้วต่อด้วย ProviderGrid ที่เป็นภาพประกอบของหัวข้อนี้โดยตรง
//
// แต่ละครึ่งเป็น flex row ของ [ไอคอน, slot] ผู้เรียกจึงต้องส่ง "หนึ่ง element
// ต่อหนึ่ง slot" เท่านั้น ไม่งั้นแต่ละ <p> จะกลายเป็น flex item แยกข้างไอคอน
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f6c945]/25 bg-[#1a0503]/90 p-6 text-[#ffe6d8] shadow-[0_10px_30px_rgba(246,201,69,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffe08a]/55 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#f6c945] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f6c945]/25 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe08a] to-[#8b1406] shadow-[0_0_10px_rgba(246,201,69,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff4ec] via-[#f6c945] to-[#e0330a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#f6c945]/20 bg-[#0b0101] p-6 text-left text-base leading-relaxed text-[#ffe6d8] transition-all duration-300 hover:-translate-y-2 hover:border-[#ffe08a]/55 hover:bg-[#2a0301] hover:shadow-[0_15px_40px_rgba(246,201,69,0.22)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#a3760a]/45 bg-gradient-to-br from-[#ffe08a] via-[#f6c945] to-[#a3760a] text-2xl shadow-[0_5px_15px_rgba(246,201,69,0.35)]">
          🏆
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#f6c945]/20 bg-[#0b0101] p-6 text-left text-base leading-relaxed text-[#ffe6d8] transition-all duration-300 hover:-translate-y-2 hover:border-[#ffe08a]/55 hover:bg-[#2a0301] hover:shadow-[0_15px_40px_rgba(246,201,69,0.22)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#ffa46b]/60 bg-gradient-to-br from-[#ff6a2b] via-[#e0330a] to-[#8b1406] text-2xl shadow-[0_5px_15px_rgba(224,51,10,0.45)]">
          🎮
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
