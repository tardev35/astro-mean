---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;

// XTOP666: ส้มไฟคู่ทอง — ส้ม #fc5b02 / #ff8c3a / #ffd9bd / #7a2601 คู่ทอง
// #ffb020 / #ffd76e / #8a5a00 บนผิว #0a0503 / #1c0d05 / #2a1206 เนื้อความ #ffe8d8
// ตัวอักษรสว่าง #fff3ea (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์
// เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น
// CSS ตาย ดูของเดิมได้จาก git history)
//
// ไอคอนใบแรกเป็นส้ม ใบที่สองเป็นทอง ทั้งคู่จึงอ่านเป็นคู่สีของแบรนด์ ไม่ใช่
// สี่เหลี่ยมสีเดียวกันสองใบ — รอบนี้บล็อกนี้แบกหัวข้อ docx ข้อ 3 (ลิงก์ตรงช่วยตัด
// ขั้นตอนไหนบ้างก่อนพาเข้าสู่เกมค่ายดัง) ไอคอนจึงเป็นลิงก์กับจรวดพุ่งเข้าล็อบบี้
//
// แต่ละครึ่งเป็น flex row ของ [ไอคอน, slot] ผู้เรียกจึงต้องส่ง "หนึ่ง element
// ต่อหนึ่ง slot" เท่านั้น ไม่งั้นแต่ละ <p> จะกลายเป็น flex item แยกข้างไอคอน
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#fc5b02]/25 bg-[#1c0d05]/90 p-6 text-[#ffe8d8] shadow-[0_10px_30px_rgba(252,91,2,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff8c3a]/55 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#ffb020] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#fc5b02]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fc5b02] to-[#ffb020] shadow-[0_0_10px_rgba(252,91,2,0.4)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff3ea] via-[#ff8c3a] to-[#fc5b02] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#fc5b02]/20 bg-[#0a0503] p-6 text-left text-base leading-relaxed text-[#ffe8d8] transition-all duration-300 hover:-translate-y-2 hover:border-[#fc5b02]/55 hover:bg-[#2a1206] hover:shadow-[0_15px_40px_rgba(252,91,2,0.22)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#7a2601]/45 bg-gradient-to-br from-[#ffd9bd] via-[#fc5b02] to-[#7a2601] text-2xl shadow-[0_5px_15px_rgba(252,91,2,0.35)]">
          🔗
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#fc5b02]/20 bg-[#0a0503] p-6 text-left text-base leading-relaxed text-[#ffe8d8] transition-all duration-300 hover:-translate-y-2 hover:border-[#ffd76e]/55 hover:bg-[#2a1206] hover:shadow-[0_15px_40px_rgba(255,176,32,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#ffd76e]/60 bg-gradient-to-br from-[#ffd76e] via-[#ffb020] to-[#8a5a00] text-2xl shadow-[0_5px_15px_rgba(255,176,32,0.45)]">
          🚀
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
