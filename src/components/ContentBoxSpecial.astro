---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;

// SETH88: ทองคำอียิปต์คู่บรอนซ์บนดำอมน้ำตาลของหินวิหาร — ทอง #fdf3d4 / #f7d774 /
// #e0a92b / #a9711a คู่บรอนซ์ #6b4210 บนผิว #0c0703 / #1b1109 / #2a1a0d
// ขอบ #6b4210 เนื้อความ #f0e3cd (ย้ายมาจากชุดสีของแบรนด์ก่อนคนละเจ้า)
// (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history)
//
// แบรนด์นี้เป็นทองล้วนไม่มีสีคู่ตรงข้าม ไอคอนสองใบจึงแยกกันด้วยน้ำหนักของทอง:
// ใบซ้ายรับทองสว่างซึ่งเป็นสีนำ ใบขวารับบรอนซ์เข้มซึ่งเป็นเฉดลึกของโลหะเดียวกัน —
// รอบนี้บล็อกนี้แบกหัวข้อ docx ข้อ 4 (หลายค่ายลูกเล่นเยอะ) ไอคอนจึงเป็นจอยเกมฝั่ง
// ความหลากหลายของค่าย กับประกายฟีเจอร์ฝั่งลูกเล่นใหม่ที่เจอเมื่อสลับเกม
//
// แต่ละครึ่งเป็น flex row ของ [ไอคอน, slot] ผู้เรียกจึงต้องส่ง "หนึ่ง element
// ต่อหนึ่ง slot" เท่านั้น ไม่งั้นแต่ละ <p> จะกลายเป็น flex item แยกข้างไอคอน
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#6b4210]/60 bg-[#1b1109]/92 p-6 text-[#f0e3cd] shadow-[0_10px_30px_rgba(107,66,16,0.45)] backdrop-blur-xl transition-all duration-500 hover:border-[#e0a92b]/55 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#e0a92b] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#6b4210]/60 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f7d774] to-[#6b4210] shadow-[0_0_10px_rgba(224,169,43,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdf3d4] via-[#f7d774] to-[#e0a92b] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#6b4210]/50 bg-[#0c0703] p-6 text-left text-base leading-relaxed text-[#f0e3cd] transition-all duration-300 hover:-translate-y-2 hover:border-[#e0a92b]/55 hover:bg-[#2a1a0d] hover:shadow-[0_15px_40px_rgba(224,169,43,0.25)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#6b4210]/80 bg-gradient-to-br from-[#fdf3d4] via-[#e0a92b] to-[#6b4210] text-2xl shadow-[0_5px_15px_rgba(224,169,43,0.3)]">
          🎮
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#6b4210]/50 bg-[#0c0703] p-6 text-left text-base leading-relaxed text-[#f0e3cd] transition-all duration-300 hover:-translate-y-2 hover:border-[#a9711a]/70 hover:bg-[#2a1a0d] hover:shadow-[0_15px_40px_rgba(169,113,26,0.35)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#a9711a]/60 bg-gradient-to-br from-[#f7d774] via-[#a9711a] to-[#6b4210] text-2xl shadow-[0_5px_15px_rgba(169,113,26,0.4)]">
          ✨
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
