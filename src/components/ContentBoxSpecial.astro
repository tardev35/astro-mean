---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;

// AURA456: นีออนบานเย็นคู่ฟ้าอิเล็กทริก — บานเย็น #ff2fb0 / #ff7fd4 / #ffc9ee /
// #c81d8e คู่ฟ้า #3ba9ff / #7fd0ff / #d8f2ff กับม่วง #8b3cf7 / #4a179e บนผิว
// #05021a / #0b0528 / #1c1046 เนื้อความ #d8d3f0
// (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history)
//
// ไอคอนใบแรกเป็นบานเย็น ใบที่สองเป็นฟ้า ทั้งคู่จึงอ่านเป็นคู่สีของแบรนด์ ไม่ใช่
// สี่เหลี่ยมสีเดียวกันสองใบ — รอบนี้บล็อกนี้แบกหัวข้อ docx ข้อ 4 (ตัวฮิตขึ้นหน้า
// ไม่ต้องตามหา) ไอคอนจึงเป็นเปลวไฟหมวดเกมฮิตกับลูกศรสลับค่าย
//
// แต่ละครึ่งเป็น flex row ของ [ไอคอน, slot] ผู้เรียกจึงต้องส่ง "หนึ่ง element
// ต่อหนึ่ง slot" เท่านั้น ไม่งั้นแต่ละ <p> จะกลายเป็น flex item แยกข้างไอคอน
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8b3cf7]/25 bg-[#0b0528]/90 p-6 text-[#d8d3f0] shadow-[0_10px_30px_rgba(139,60,247,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff7fd4]/55 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#ff2fb0] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#8b3cf7]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff2fb0] to-[#3ba9ff] shadow-[0_0_10px_rgba(255,47,176,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f6ebff] via-[#ff7fd4] to-[#3ba9ff] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#8b3cf7]/20 bg-[#05021a] p-6 text-left text-base leading-relaxed text-[#d8d3f0] transition-all duration-300 hover:-translate-y-2 hover:border-[#ff2fb0]/55 hover:bg-[#1c1046] hover:shadow-[0_15px_40px_rgba(255,47,176,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#c81d8e]/60 bg-gradient-to-br from-[#ffc9ee] via-[#ff2fb0] to-[#c81d8e] text-2xl shadow-[0_5px_15px_rgba(255,47,176,0.35)]">
          🔥
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#8b3cf7]/20 bg-[#05021a] p-6 text-left text-base leading-relaxed text-[#d8d3f0] transition-all duration-300 hover:-translate-y-2 hover:border-[#3ba9ff]/55 hover:bg-[#1c1046] hover:shadow-[0_15px_40px_rgba(59,169,255,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#3ba9ff]/60 bg-gradient-to-br from-[#d8f2ff] via-[#3ba9ff] to-[#4a179e] text-2xl shadow-[0_5px_15px_rgba(59,169,255,0.4)]">
          🔀
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
