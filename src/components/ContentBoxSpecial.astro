---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;

// GALA89: ไฟล์นี้เคยเป็นทองบนม่วงพลัมของแบรนด์ก่อนหน้า (#ffe9a8 / #fcc30b / #e09a05
// / #ce5a03 คู่ม่วง #c79bf0 / #7e3ac7 / #3c0f52 บนผิว #3c0f52 / #1c0620 / #2a0a2e
// เนื้อความ #f7e6c4) ตอนนี้ย้ายมาชมพูกลอสคู่ทอง — ชมพู #ff4d9c / #d41c6b /
// #9e154a กับทอง #ffe0a3 / #f0c274 / #b8801f บนผิว #3c0214 / #12010a / #1f0311
// เนื้อความ #f7dce8 ไอคอนใบแรกเป็นทอง ใบที่สองเป็นชมพู ทั้งคู่จึงอ่านเป็นคู่สีของ
// แบรนด์ ไม่ใช่สี่เหลี่ยมสีเดียวกันสองใบ
//
// แต่ละครึ่งเป็น flex row ของ [ไอคอน, slot] ผู้เรียกจึงต้องส่ง "หนึ่ง element
// ต่อหนึ่ง slot" เท่านั้น ไม่งั้นแต่ละ <p> จะกลายเป็น flex item แยกข้างไอคอน
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f0c274]/25 bg-[#3c0214]/90 p-6 text-[#f7dce8] shadow-[0_10px_30px_rgba(240,194,116,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffe0a3]/55 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#f0c274] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f0c274]/25 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe0a3] to-[#d41c6b] shadow-[0_0_10px_rgba(240,194,116,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe0a3] via-[#f0c274] to-[#ff4d9c] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#f0c274]/20 bg-[#12010a] p-6 text-left text-base leading-relaxed text-[#f7dce8] transition-all duration-300 hover:-translate-y-2 hover:border-[#ffe0a3]/55 hover:bg-[#1f0311] hover:shadow-[0_15px_40px_rgba(240,194,116,0.22)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#b8801f]/45 bg-gradient-to-br from-[#ffe0a3] via-[#f0c274] to-[#b8801f] text-2xl shadow-[0_5px_15px_rgba(240,194,116,0.35)]">
          🔐
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#f0c274]/20 bg-[#12010a] p-6 text-left text-base leading-relaxed text-[#f7dce8] transition-all duration-300 hover:-translate-y-2 hover:border-[#ffe0a3]/55 hover:bg-[#1f0311] hover:shadow-[0_15px_40px_rgba(240,194,116,0.22)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f9a8cd]/60 bg-gradient-to-br from-[#f9a8cd] via-[#d41c6b] to-[#5a0526] text-2xl shadow-[0_5px_15px_rgba(212,28,107,0.4)]">
          🛡️
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
