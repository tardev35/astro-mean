---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;

// HAPPYSUPERWIN: แคนดี้มาเจนต้าคู่เหลืองลูกอมบนม่วงองุ่นเกือบดำ — มาเจนต้า #ff5ae6 /
// #e11ccc / #fff0fc / #8a1f9e / #4c0d6b คู่เหลือง #f0b429 / #ffd83d บนผิว #0e0119 /
// #190430 / #280747 เนื้อความ #f7e2ff
// (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history)
//
// ไอคอนสองใบแยกกันด้วยน้ำหนักของสีคนละระดับ ไม่ใช่ด้วยสีที่สาม — รอบนี้บล็อกนี้แบก
// หัวข้อ docx ข้อ 5 (ฟีเจอร์ครบหลายสไตล์) ไอคอนจึงเป็นวงล้อสล็อตฝั่งลูกเล่นบนรีล
// กับประกายฝั่งตัวคูณและ Wild ซ้อนทับ
//
// แต่ละครึ่งเป็น flex row ของ [ไอคอน, slot] ผู้เรียกจึงต้องส่ง "หนึ่ง element
// ต่อหนึ่ง slot" เท่านั้น ไม่งั้นแต่ละ <p> จะกลายเป็น flex item แยกข้างไอคอน
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8a1f9e]/30 bg-[#190430]/92 p-6 text-[#f7e2ff] shadow-[0_10px_30px_rgba(76,13,107,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#e11ccc]/55 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#e11ccc] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#8a1f9e]/35 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff5ae6] to-[#4c0d6b] shadow-[0_0_10px_rgba(225,28,204,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff0fc] via-[#ff5ae6] to-[#e11ccc] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#8a1f9e]/25 bg-[#0e0119] p-6 text-left text-base leading-relaxed text-[#f7e2ff] transition-all duration-300 hover:-translate-y-2 hover:border-[#e11ccc]/55 hover:bg-[#280747] hover:shadow-[0_15px_40px_rgba(225,28,204,0.25)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#4c0d6b]/70 bg-gradient-to-br from-[#fff0fc] via-[#e11ccc] to-[#4c0d6b] text-2xl shadow-[0_5px_15px_rgba(225,28,204,0.3)]">
          🎰
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#8a1f9e]/25 bg-[#0e0119] p-6 text-left text-base leading-relaxed text-[#f7e2ff] transition-all duration-300 hover:-translate-y-2 hover:border-[#ff5ae6]/55 hover:bg-[#280747] hover:shadow-[0_15px_40px_rgba(255,216,61,0.2)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#e11ccc]/60 bg-gradient-to-br from-[#ffd83d] via-[#f0b429] to-[#8a1f9e] text-2xl shadow-[0_5px_15px_rgba(255,216,61,0.3)]">
          ✨
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
