---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;

// MONACO89: ย้ายจากชุดสีชมพูกลอสคู่ทองของแบรนด์เก่ากว่า (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history) มาที่ทองแอมเบอร์–คอปเปอร์คู่แดงรอยัลบนมะฮอกกานีดำ — ทอง #ffe9b8 /
// #ffd77a / #ef8f22 / #a44516 คู่แดง #d1201a / #7e120e บนผิว #26150a / #160d05 /
// #0b0602 เนื้อความ #f6e3c0 ไอคอนใบแรกเป็นทอง ใบที่สองเป็นแดง ทั้งคู่จึงอ่านเป็น
// คู่สีของแบรนด์ ไม่ใช่สี่เหลี่ยมสีเดียวกันสองใบ
//
// แต่ละครึ่งเป็น flex row ของ [ไอคอน, slot] ผู้เรียกจึงต้องส่ง "หนึ่ง element
// ต่อหนึ่ง slot" เท่านั้น ไม่งั้นแต่ละ <p> จะกลายเป็น flex item แยกข้างไอคอน
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#ef8f22]/25 bg-[#26150a]/90 p-6 text-[#f6e3c0] shadow-[0_10px_30px_rgba(239,143,34,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffd77a]/55 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#ef8f22] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#ef8f22]/25 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd77a] to-[#d1201a] shadow-[0_0_10px_rgba(239,143,34,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe9b8] via-[#ef8f22] to-[#d1201a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#ef8f22]/20 bg-[#0b0602] p-6 text-left text-base leading-relaxed text-[#f6e3c0] transition-all duration-300 hover:-translate-y-2 hover:border-[#ffd77a]/55 hover:bg-[#160d05] hover:shadow-[0_15px_40px_rgba(239,143,34,0.22)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#a44516]/45 bg-gradient-to-br from-[#ffd77a] via-[#ef8f22] to-[#a44516] text-2xl shadow-[0_5px_15px_rgba(239,143,34,0.35)]">
          🎰
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#ef8f22]/20 bg-[#0b0602] p-6 text-left text-base leading-relaxed text-[#f6e3c0] transition-all duration-300 hover:-translate-y-2 hover:border-[#ffd77a]/55 hover:bg-[#160d05] hover:shadow-[0_15px_40px_rgba(239,143,34,0.22)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#ffd77a]/60 bg-gradient-to-br from-[#d1201a] via-[#a44516] to-[#7e120e] text-2xl shadow-[0_5px_15px_rgba(209,32,26,0.4)]">
          🔍
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
