---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#fcda3d]/25 bg-[#12071f]/92 p-6 text-[#efe3f7] shadow-[0_10px_30px_rgba(252,218,61,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#fcda3d]/50 md:p-10">
    <div aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#fcda3d] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#fcda3d]/25 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe98a] to-[#a9760d] shadow-[0_0_10px_rgba(252,218,61,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe98a] via-[#fcda3d] to-[#a9760d] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
            {title}
          </HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#fcda3d]/20 bg-[#1a0b2e]/95 p-6 text-left text-base leading-relaxed text-[#efe3f7] transition-all duration-300 hover:-translate-y-2 hover:border-[#fcda3d]/50 hover:bg-[#2c014b]/90 hover:shadow-[0_15px_40px_rgba(252,218,61,0.28)]">
        <div aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#fcda3d]/30 bg-gradient-to-br from-[#ffe98a] via-[#fcda3d] to-[#a9760d] text-2xl shadow-[0_5px_15px_rgba(252,218,61,0.28)]">
          ⚡
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#fcda3d]/20 bg-[#1a0b2e]/95 p-6 text-left text-base leading-relaxed text-[#efe3f7] transition-all duration-300 hover:-translate-y-2 hover:border-[#fcda3d]/50 hover:bg-[#2c014b]/90 hover:shadow-[0_15px_40px_rgba(252,218,61,0.28)]">
        <div aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#5b0374]/60 bg-gradient-to-br from-[#c77dff] via-[#8b2fc9] to-[#5b0374] text-2xl shadow-[0_5px_15px_rgba(91,3,116,0.45)]">
          📱
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
