---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;

// DEED888: ม้าเพลิงคู่ทองหลอมบนพื้นดำอมน้ำตาลไหม้ — ส้มไฟ #e95b0b / #ff9d4d /
// #fff4e8 / #93300a / #5c1c03 คู่ทอง #f4940c / #ffcf6b บนผิว #150401 / #210702 /
// #2a0a02 เนื้อความ #fbe3d0
// (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history)
//
// ไอคอนสองใบแยกกันด้วยน้ำหนักของไฟคนละระดับ ไม่ใช่ด้วยสีที่สาม — รอบนี้บล็อกนี้แบก
// หัวข้อ docx ข้อ 5 (ฟีเจอร์ใหม่น่าลองมีอะไรเด็ด) ไอคอนจึงเป็นวงล้อสล็อตฝั่งลูกเล่น
// บนรีล กับกล่องของขวัญฝั่งโหมดซื้อฟรีสปิน
//
// แต่ละครึ่งเป็น flex row ของ [ไอคอน, slot] ผู้เรียกจึงต้องส่ง "หนึ่ง element
// ต่อหนึ่ง slot" เท่านั้น ไม่งั้นแต่ละ <p> จะกลายเป็น flex item แยกข้างไอคอน
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#93300a]/30 bg-[#210702]/92 p-6 text-[#fbe3d0] shadow-[0_10px_30px_rgba(92,28,3,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#e95b0b]/55 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#e95b0b] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#93300a]/35 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff9d4d] to-[#5c1c03] shadow-[0_0_10px_rgba(233,91,11,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff4e8] via-[#ff9d4d] to-[#e95b0b] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#93300a]/25 bg-[#150401] p-6 text-left text-base leading-relaxed text-[#fbe3d0] transition-all duration-300 hover:-translate-y-2 hover:border-[#e95b0b]/55 hover:bg-[#2a0a02] hover:shadow-[0_15px_40px_rgba(233,91,11,0.25)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#5c1c03]/70 bg-gradient-to-br from-[#fff4e8] via-[#e95b0b] to-[#5c1c03] text-2xl shadow-[0_5px_15px_rgba(233,91,11,0.3)]">
          🎰
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#93300a]/25 bg-[#150401] p-6 text-left text-base leading-relaxed text-[#fbe3d0] transition-all duration-300 hover:-translate-y-2 hover:border-[#ff9d4d]/55 hover:bg-[#2a0a02] hover:shadow-[0_15px_40px_rgba(255,207,107,0.2)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#e95b0b]/60 bg-gradient-to-br from-[#ffcf6b] via-[#ff9d4d] to-[#93300a] text-2xl shadow-[0_5px_15px_rgba(255,207,107,0.3)]">
          🎁
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
