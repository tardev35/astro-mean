---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;

// THUNDER87: remapped off 249UP's single-hue gold (#ffe9a8 / #ffd86b / #f5b626 /
// #c98a12 / #8a5c08 / #3a2606 over #150e05 / #1e1409, body #f0e4cd) onto this
// brand's electric-yellow lightning on near-black — #fff89a / #fae61c / #dcb309
// / #ffd60a / #8a7405 / #2b2606 over #17150a / #080703, body text #f0ead6
//
// แต่ละครึ่งเป็น flex row ของ [ไอคอน, slot] ผู้เรียกจึงต้องส่ง "หนึ่ง element
// ต่อหนึ่ง slot" เท่านั้น ไม่งั้นแต่ละ <p> จะกลายเป็น flex item แยกข้างไอคอน
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#fae61c]/25 bg-[#17150a]/90 p-6 text-[#f0ead6] shadow-[0_10px_30px_rgba(250,230,28,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#fff89a]/50 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#fae61c] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#fae61c]/25 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff89a] to-[#8a7405] shadow-[0_0_10px_rgba(250,230,28,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff89a] via-[#fae61c] to-[#dcb309] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#fae61c]/20 bg-[#080703] p-6 text-left text-base leading-relaxed text-[#f0ead6] transition-all duration-300 hover:-translate-y-2 hover:border-[#fff89a]/50 hover:bg-[#2b2606] hover:shadow-[0_15px_40px_rgba(250,230,28,0.22)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#dcb309]/40 bg-gradient-to-br from-[#fff89a] via-[#ffd60a] to-[#dcb309] text-2xl shadow-[0_5px_15px_rgba(250,230,28,0.35)]">
          🎰
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#fae61c]/20 bg-[#080703] p-6 text-left text-base leading-relaxed text-[#f0ead6] transition-all duration-300 hover:-translate-y-2 hover:border-[#fff89a]/50 hover:bg-[#2b2606] hover:shadow-[0_15px_40px_rgba(250,230,28,0.22)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#8a7405]/60 bg-gradient-to-br from-[#fae61c] via-[#dcb309] to-[#8a7405] text-2xl shadow-[0_5px_15px_rgba(220,179,9,0.35)]">
          🃏
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
