---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;

// ROSTY59: ทองอำพันคู่โครเมียมเงินบนดำสนิท — ทอง #ffeec2 / #ffc94a / #f2a01a /
// #b06a0d / #6b3f07 คู่เงิน #dbe1e8 / #a3adba บนผิว #070505 / #150e07 / #26180a
// ขอบ #4a2f0d เนื้อความ #ece0cc (ย้ายมาจากชุดแคนดี้มาเจนต้าคู่เหลืองลูกอมของแบรนด์
// ก่อนหน้า)
// (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history)
//
// ไอคอนสองใบแยกกันด้วยสีคู่ของแบรนด์: ใบซ้ายรับทองอำพันซึ่งเป็นสีนำ ใบขวารับเงิน
// โครเมียมซึ่งเป็นสีที่สอง — รอบนี้บล็อกนี้แบกหัวข้อ docx ข้อ 5 (ฟีเจอร์ใหม่พร้อม
// ลั่น) ไอคอนจึงเป็นวงล้อสล็อตฝั่งลูกเล่นบนรีล กับประกายฝั่งตัวคูณและ Wild ซ้อนทับ
//
// แต่ละครึ่งเป็น flex row ของ [ไอคอน, slot] ผู้เรียกจึงต้องส่ง "หนึ่ง element
// ต่อหนึ่ง slot" เท่านั้น ไม่งั้นแต่ละ <p> จะกลายเป็น flex item แยกข้างไอคอน
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#4a2f0d]/60 bg-[#150e07]/92 p-6 text-[#ece0cc] shadow-[0_10px_30px_rgba(107,63,7,0.35)] backdrop-blur-xl transition-all duration-500 hover:border-[#f2a01a]/55 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#f2a01a] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#4a2f0d]/60 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffc94a] to-[#6b3f07] shadow-[0_0_10px_rgba(242,160,26,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffeec2] via-[#ffc94a] to-[#f2a01a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#4a2f0d]/50 bg-[#070505] p-6 text-left text-base leading-relaxed text-[#ece0cc] transition-all duration-300 hover:-translate-y-2 hover:border-[#f2a01a]/55 hover:bg-[#26180a] hover:shadow-[0_15px_40px_rgba(242,160,26,0.25)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#6b3f07]/80 bg-gradient-to-br from-[#ffeec2] via-[#f2a01a] to-[#6b3f07] text-2xl shadow-[0_5px_15px_rgba(242,160,26,0.3)]">
          🎰
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#4a2f0d]/50 bg-[#070505] p-6 text-left text-base leading-relaxed text-[#ece0cc] transition-all duration-300 hover:-translate-y-2 hover:border-[#dbe1e8]/55 hover:bg-[#26180a] hover:shadow-[0_15px_40px_rgba(219,225,232,0.2)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#a3adba]/60 bg-gradient-to-br from-[#dbe1e8] via-[#a3adba] to-[#5d6773] text-2xl shadow-[0_5px_15px_rgba(219,225,232,0.3)]">
          ✨
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
