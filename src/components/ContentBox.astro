---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#15803d]/30 bg-[#040d07]/90 p-8 text-left text-base leading-relaxed text-[#d6ecdd] shadow-[0_10px_30px_rgba(21,128,61,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#22c55e]/50 hover:shadow-[0_15px_40px_rgba(34,197,94,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#15803d]/30 blur-[60px] transition-all duration-500 group-hover:bg-[#22c55e]/45"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#052e16]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#4ade80]/35"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#15803d]/30 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#22c55e] to-[#052e16] shadow-[0_0_10px_rgba(34,197,94,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#dcfce7] via-[#4ade80] to-[#22c55e] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
