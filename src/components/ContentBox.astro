---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// AURORA688: ย้ายจากน้ำเงินคู่ทองของ BOOST168 (#3f8cff / #9ecbff คู่ #ffc233 /
// #ffe680 / #b26a00 บนผิว #050818 เนื้อความ #e6ecfb) มาที่ทองคู่เงินของแบรนด์นี้
// — ทองหลัก #e2c443 / #ffe9a3 / #c9a13a / #7d5714 คู่เงินโครเมียม #c3cddb /
// #eef2f7 บนผิว #0a0806 เนื้อความ #f2ead6
//
// ไฟล์นี้เป็นการ์ดถาวรของ terms/privacy ด้วย — ข้างในสองหน้านั้นไม่ระบุสีเลย
// โดยตั้งใจ สีเนื้อความจึงต้องอยู่บนการ์ดใบนี้เสมอ ห้ามย้ายออก
//
// การ์ดใบนี้ flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่
// wrapper <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e2c443]/35 bg-[#0a0806]/90 p-8 text-left text-base leading-relaxed text-[#f2ead6] shadow-[0_10px_30px_rgba(226,196,67,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffe9a3]/55 hover:shadow-[0_15px_40px_rgba(226,196,67,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e2c443]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe9a3]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#7d5714]/55 blur-[60px] transition-all duration-500 group-hover:bg-[#c9a13a]/40"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#e2c443]/35 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a3] to-[#c9a13a] shadow-[0_0_10px_rgba(226,196,67,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#eef2f7] via-[#e2c443] to-[#c9a13a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
