---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#ff2b2b]/25 bg-[#170506]/85 p-8 text-left text-base leading-relaxed text-[#f7ddd8] shadow-[0_10px_30px_rgba(255,43,43,0.15)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff2b2b]/50 hover:shadow-[0_15px_40px_rgba(255,197,49,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ffc531]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#ffc531]/40"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#c1121f]/30 blur-[60px] transition-all duration-500 group-hover:bg-[#ff2b2b]/35"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#ff2b2b]/25 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffc531] to-[#c1121f] shadow-[0_0_10px_rgba(255,43,43,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ff2b2b] via-[#c1121f] to-[#ffc531] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
