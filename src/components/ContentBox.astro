---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// ASHTON168: ย้ายจากน้ำเงินอิเล็กทริกคู่แดงของแบรนด์ก่อน มาเป็นทองสว่างคู่เงิน
// โครเมียมของแบรนด์นี้ — ทอง #f5c518 / #ffd75e / #ffe9a3 / #a87908 คู่เงิน
// #e2e5e9 / #f0f2f5 บนผิวดำอมน้ำตาล #080502 / #120b02 / #160e03 เนื้อความ
// #f0e6d2 (วัดจาก palette.json: vivid ของโลโก้เป็นทอง #dbac1b / #fffd94 ส่วน
// dominant ของแบนเนอร์กับสไลด์เป็นดำอมน้ำตาลเกือบสนิท)
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// ไฟล์นี้เป็นการ์ดถาวรของ terms/privacy ด้วย — ข้างในสองหน้านั้นไม่ระบุสีเลย
// โดยตั้งใจ สีเนื้อความจึงต้องอยู่บนการ์ดใบนี้เสมอ ห้ามย้ายออก และนี่คือเหตุผล
// ที่ตระกูล ContentBox หมุน variant ไม่ได้จริงในรอบไหนก็ตาม
//
// การ์ดใบนี้ flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่
// wrapper <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f5c518]/35 bg-[#080502]/90 p-8 text-left text-base leading-relaxed text-[#f0e6d2] shadow-[0_10px_30px_rgba(245,197,24,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffe9a3]/55 hover:shadow-[0_15px_40px_rgba(245,197,24,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#a87908]/50 blur-[60px] transition-all duration-500 group-hover:bg-[#f5c518]/40"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#2a1c06]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#e2e5e9]/35"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#f5c518]/35 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a3] to-[#f5c518] shadow-[0_0_10px_rgba(245,197,24,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdf6e6] via-[#ffd75e] to-[#e2e5e9] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
