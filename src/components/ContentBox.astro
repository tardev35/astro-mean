---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// QUEEN189: ย้ายจากชมพูบานเย็นคู่เหลืองลูกกวาดบนพื้นองุ่นเข้มของแบรนด์ก่อน มาเป็น
// ทองราชสำนักบนดำสนิท — ทอง #fdf3d2 / #fceb83 / #e4bb53 / #c38d29 / #7a5615
// บนผิว #0b0704 / #1a1108 / #271a0c เนื้อความ #f3e4c4
//
// อาร์ตเวิร์กรอบนี้เป็นห้องโถงพระราชวังทองคำ: โลโก้เป็นมงกุฎประดับเพชรเหนือคำว่า
// Queen ตัวอักษรทองคำ ค่า vivid ของโลโก้ (#e4bb53 / #c38d29 / #ba954a) กับของ
// slide1 (#fceb83 / #feddc2) เป็นทองทั้งชุด ส่วนค่า dominant ของทุกไฟล์เป็นดำอม
// น้ำตาลซึ่งคือพื้นหลัง ไม่ใช่สีเน้น — palette.json จัดอันดับให้ แต่ไม่ได้ตีความให้
// แบรนด์นี้เป็นทองล้วนไล่ระดับ ไม่มีสีที่สองมาตัด ถ้าอยากได้คอนทราสต์ให้ใช้ทองสว่าง
// ขึ้นหรือทองเข้มลง ไม่ใช่ไปหยิบวรรณะสีอื่นมา
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// ไฟล์นี้เป็นการ์ดถาวรของ terms/privacy — ข้างในสองหน้านั้นไม่ระบุสีเลยโดยตั้งใจ
// สีเนื้อความจึงต้องอยู่บนการ์ดใบนี้เสมอ ห้ามย้ายออก และนี่คือเหตุผลที่สองหน้านั้น
// หมุน variant ตาม index ไม่ได้ในรอบไหนก็ตาม รอบนี้หน้าย่อยอื่น (promotion /
// about-us / contact-us / ทางเข้า / ทดลองเล่น) ใช้การ์ดใบนี้ด้วย และหน้าแรกเรียก
// ใบนี้หนึ่งครั้งในหัวข้อ docx ข้อสุดท้าย
//
// การ์ดใบนี้ flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่
// wrapper <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#7a5615]/45 bg-[#1a1108]/90 p-8 text-left text-base leading-relaxed text-[#f3e4c4] shadow-[0_10px_30px_rgba(122,86,21,0.3)] backdrop-blur-xl transition-all duration-500 hover:border-[#e4bb53]/60 hover:shadow-[0_15px_40px_rgba(228,187,83,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#271a0c]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#e4bb53]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#1a1108]/60 blur-[60px] transition-all duration-500 group-hover:bg-[#c38d29]/30"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#7a5615]/45 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf3d2] via-[#e4bb53] to-[#7a5615] shadow-[0_0_10px_rgba(228,187,83,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdf3d2] via-[#fceb83] to-[#c38d29] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
