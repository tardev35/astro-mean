---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e40613]/30 bg-[#170506]/90 p-8 text-left text-base leading-relaxed text-[#f4e7dd] shadow-[0_10px_30px_rgba(228,6,19,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffc531]/50 hover:shadow-[0_15px_40px_rgba(255,197,49,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e40613]/30 blur-[60px] transition-all duration-500 group-hover:bg-[#ff3b2f]/45"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#a8720a]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe27a]/35"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#e40613]/30 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffc531] to-[#8f0206] shadow-[0_0_10px_rgba(228,6,19,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe27a] via-[#ffc531] to-[#e40613] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
