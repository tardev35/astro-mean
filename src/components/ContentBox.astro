---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// VIPSAND356: ย้ายจากทองคำอียิปต์คู่เงินขาวบนดำอมน้ำตาลของแบรนด์ก่อน มาเป็นฟ้า
// อะซูร์คู่ทองส้มบนกรมท่าเข้ม — ฟ้า #eaf6ff / #a2d2ef / #5dbcfe / #2a93e0 /
// #1465a8 / #0b3f70 คู่ทอง #fcde61 / #eba554 / #c07c20 บนผิว #061c33 / #0a2b4a /
// #103a5f เนื้อความ #e6f2ff
//
// อาร์ตเวิร์กรอบนี้เป็นคาสิโนริมทะเลกลางวัน: ป้ายโลโก้ในกรอบทองที่คำว่า VIP เป็น
// ฟ้าใสและ SANDS เป็นส้มทอง กองเหรียญทองเต็มพื้นล่าง ฉลามสวมมงกุฎทอง และท้องฟ้า
// ฟ้าสดใส — vivid ของ logo.webp คือ #4aa8eb คู่ #eba554 / #a2d2ef / #fcde61 จึง
// เป็นสีเน้นจริงทั้งชุด และ vivid ของ slide1 (#7ccbfe / #5dbcfe) ยืนยันฝั่งฟ้า
// ส่วน dominant ของ banner1 ที่เป็นน้ำตาลเข้ม #54240c คือไม้กับเงาในฉาก ไม่ใช่
// สีแบรนด์ — palette.json จัดอันดับให้ แต่ไม่ได้ตีความให้
//
// ข้อจำกัดสำคัญของรอบนี้: bg.png เป็นฟ้า "สว่าง" (ท้องฟ้าการ์ตูนกับเมฆขาว) ไม่ใช่
// พื้นเกือบดำเหมือนแบรนด์ก่อนๆ การ์ดจึงเป็นกรมท่าเข้มลอยอยู่บนวอลเปเปอร์สว่าง
// และการ์ดใบนี้ต้องประกาศสีเนื้อความ (#e6f2ff) บนตัวการ์ดเสมอ เพราะ BRAND_TEXT
// รอบนี้เป็นกรมท่าเข้ม (สำหรับ 404 ที่วางเนื้อความบนวอลเปเปอร์ตรงๆ)
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// ไฟล์นี้เป็นการ์ดถาวรของ terms/privacy — ข้างในสองหน้านั้นไม่ระบุสีเลยโดยตั้งใจ
// สีเนื้อความจึงต้องอยู่บนการ์ดใบนี้เสมอ ห้ามย้ายออก และนี่คือเหตุผลที่สองหน้านั้น
// หมุน variant ตาม index ไม่ได้ในรอบไหนก็ตาม รอบนี้หน้าย่อยที่ใช้การ์ดใบนี้คือ
// promotion / about-us / contact-us / ทางเข้า / ทดลองเล่น ส่วนหน้าแรกไม่ได้เรียก
// ใบนี้เลย เพราะทรงของหน้าแรกหมุนเป็นชุด CyberCut / TwoPremium / 3ThreeCyberCut /
// SevenThree / SevenThreeCyberCut / Neumorphism / TwoNeumorphism
//
// การ์ดใบนี้ flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่
// wrapper <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#2a93e0]/60 bg-[#0a2b4a]/90 p-8 text-left text-base leading-relaxed text-[#e6f2ff] shadow-[0_10px_30px_rgba(11,63,112,0.45)] backdrop-blur-xl transition-all duration-500 hover:border-[#eba554]/70 hover:shadow-[0_15px_40px_rgba(42,147,224,0.32)] md:p-10">
    <div
      class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#103a5f]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#2a93e0]/35">
    </div>
    <div
      class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#103a5f]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#eba554]/30">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#2a93e0]/60 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fcde61] via-[#eba554] to-[#c07c20] shadow-[0_0_10px_rgba(235,165,84,0.65)]" />
          <HeadingTag class="bg-gradient-to-r from-[#eaf6ff] via-[#a2d2ef] to-[#5dbcfe] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
