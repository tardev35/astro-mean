---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// UOK789: ย้ายจากนีออนม่วงคู่ทองของ PABO88 (#bf3cfa / #e3b8ff / #8b1fd6 /
// #4a0b8f คู่ทอง #f5c518 / #ffe9a3 / #8f6205 บนผิว #0a0118 เนื้อความ #ece0ff)
// มาเป็นเขียวมรกตคู่ทองของแบรนด์นี้ — เขียว #2fc44f / #b6ecbd / #12923a /
// #0a4d1c คู่ทอง #f6c945 / #fdf3c9 / #8a6a1c บนผิว #04140a เนื้อความ #e8f3e4
// (วัดจาก palette.json: vivid ของโลโก้เป็นทอง #a5833d / #fdfadb ส่วนพื้น
// แบนเนอร์กับสไลด์เป็นเขียวมรกตเข้ม #031400 / #2c3c03 / #133b05)
//
// ไฟล์นี้เป็นการ์ดถาวรของ terms/privacy ด้วย — ข้างในสองหน้านั้นไม่ระบุสีเลย
// โดยตั้งใจ สีเนื้อความจึงต้องอยู่บนการ์ดใบนี้เสมอ ห้ามย้ายออก และนี่คือเหตุผล
// ที่ตระกูล ContentBox หมุน variant ไม่ได้จริงในรอบไหนก็ตาม
//
// การ์ดใบนี้ flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่
// wrapper <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#2fc44f]/35 bg-[#04140a]/90 p-8 text-left text-base leading-relaxed text-[#e8f3e4] shadow-[0_10px_30px_rgba(47,196,79,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#b6ecbd]/55 hover:shadow-[0_15px_40px_rgba(47,196,79,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#2fc44f]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#b6ecbd]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#0a4d1c]/60 blur-[60px] transition-all duration-500 group-hover:bg-[#12923a]/45"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#2fc44f]/35 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf3c9] to-[#8a6a1c] shadow-[0_0_10px_rgba(246,201,69,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f4fdf3] via-[#b6ecbd] to-[#2fc44f] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
