---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e01a1a]/25 bg-[#150809]/88 p-8 text-left text-base leading-relaxed text-[#e7e3e1] shadow-[0_10px_30px_rgba(224,26,26,0.15)] backdrop-blur-xl transition-all duration-500 hover:border-[#e01a1a]/50 hover:shadow-[0_15px_40px_rgba(255,95,82,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e01a1a]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#ff5f52]/40"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#4a5157]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#d9dde3]/35"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#e01a1a]/25 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff5f52] to-[#8c0102] shadow-[0_0_10px_rgba(224,26,26,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#d9dde3] via-[#ff5f52] to-[#e01a1a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
