---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e8b923]/35 bg-[#15100a]/90 p-8 text-left text-base leading-relaxed text-[#f3e2b8] shadow-[0_10px_30px_rgba(232,185,35,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffe98a]/55 hover:shadow-[0_15px_40px_rgba(232,185,35,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e8b923]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe98a]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#6d1410]/55 blur-[60px] transition-all duration-500 group-hover:bg-[#b4231c]/40"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#e8b923]/35 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe98a] to-[#b4231c] shadow-[0_0_10px_rgba(232,185,35,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe98a] via-[#e8b923] to-[#a5760a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
