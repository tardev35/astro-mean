---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// 9KPLUS: ย้ายจากฟ้าอะซูร์คู่ทองส้มบนกรมท่าเข้มของแบรนด์ก่อน มาเป็นแดงนีออนคู่ชมพู
// บานเย็นบนพื้นเกือบดำ — ชมพูขาว #ffd8e7 / #ff8fb8 / #ff4fa3 / #f5003e / #b3022c /
// #7c1040 บนผิว #120309 / #1f0611 / #4d012c เนื้อความ #ffe3ee
//
// อาร์ตเวิร์กรอบนี้เป็นคาสิโนนีออนกลางคืน: ตรากลม 9K PLUS สีชมพูบนแผ่นดำ ตัวอักษร
// 9KPLUS สามมิติสีชมพูขอบขาว ตู้สล็อตกับชิปคาสิโนสีชมพู และป้ายนีออนสีชมพูรอบภาพ —
// vivid ของ logo.webp คือ #f5003e คู่ #ffd8e7 / #b3022c จึงเป็นสีเน้นจริงทั้งชุด
// และ vivid ของ slide1 (#4d012c / #d93f98) ยืนยันฝั่งชมพูบานเย็น ส่วน dominant ของ
// banner1 ที่เป็นดำอมแดง #0c0202 คือพื้นหลังของฉาก ไม่ใช่สีแบรนด์ — palette.json
// จัดอันดับให้ แต่ไม่ได้ตีความให้
//
// รอบนี้ bg.png กลับมาเป็นพื้นเกือบดำ (ลายวงจรแดงเข้มบนดำ) การ์ดจึงเป็นแดงเลือดหมู
// เข้มลอยอยู่บนวอลเปเปอร์มืด และการ์ดใบนี้ยังต้องประกาศสีเนื้อความ (#ffe3ee) บนตัว
// การ์ดเสมอ ไม่พึ่ง BRAND_TEXT ที่ inherit ลงมา
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// ไฟล์นี้เป็นการ์ดถาวรของ terms/privacy — ข้างในสองหน้านั้นไม่ระบุสีเลยโดยตั้งใจ
// สีเนื้อความจึงต้องอยู่บนการ์ดใบนี้เสมอ ห้ามย้ายออก และนี่คือเหตุผลที่สองหน้านั้น
// หมุน variant ตาม index ไม่ได้ในรอบไหนก็ตาม รอบนี้หน้าย่อยที่ใช้การ์ดใบนี้คือ
// promotion / about-us / contact-us / ทางเข้า / ทดลองเล่น และหน้าแรกเรียกใบนี้หนึ่ง
// ครั้งที่หัวข้อ docx ข้อ 5 ส่วนทรงที่เหลือของหน้าแรกหมุนเป็นชุด Premium /
// 3ThreePremium / TwoCyberCut / Special / SevenThreePremium / SevenThreeNeumorphism
//
// การ์ดใบนี้ flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่
// wrapper <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f5003e]/60 bg-[#1f0611]/90 p-8 text-left text-base leading-relaxed text-[#ffe3ee] shadow-[0_10px_30px_rgba(124,16,64,0.45)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff4fa3]/70 hover:shadow-[0_15px_40px_rgba(245,0,62,0.32)] md:p-10">
    <div
      class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#4d012c]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#f5003e]/35">
    </div>
    <div
      class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#4d012c]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#ff4fa3]/30">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#f5003e]/60 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff4fa3] via-[#f5003e] to-[#b3022c] shadow-[0_0_10px_rgba(245,0,62,0.65)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffd8e7] via-[#ff8fb8] to-[#ff4fa3] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
