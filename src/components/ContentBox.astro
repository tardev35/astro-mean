---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e3b64a]/25 bg-[#1c110a]/88 p-8 text-left text-base leading-relaxed text-[#f2e2c4] shadow-[0_10px_30px_rgba(227,182,74,0.15)] backdrop-blur-xl transition-all duration-500 hover:border-[#e3b64a]/50 hover:shadow-[0_15px_40px_rgba(255,233,163,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e3b64a]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe9a3]/40"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#5c0a0c]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#a3161c]/45"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#e3b64a]/25 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a3] to-[#5c0a0c] shadow-[0_0_10px_rgba(227,182,74,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe9a3] via-[#e3b64a] to-[#b8862c] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
