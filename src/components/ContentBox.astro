---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// PROFIT55: ย้ายจากแดงส้มคู่ทองของ MONEY777 (#e0330a / #ffa46b / #8b1406 /
// #3c0c03 คู่ทอง #f6c945 / #ffe08a / #a3760a บนผิว #0b0101 เนื้อความ #ffe6d8)
// มาเป็นทองคู่เงินโครเมียมของแบรนด์นี้ — ทอง #e3ac22 / #f6d24a / #ffe9a8 /
// #a97d12 คู่เงิน #cfd8e2 / #eef3f8 / #8b96a4 บนผิว #0a0702 / #2a1d05
// เนื้อความ #f3e6c4 (วัดจาก palette.json: vivid ของโลโก้เป็นทอง #d5a921 /
// #d1a624 / #dcb329 ส่วน dominant ของแบนเนอร์เป็นดำอมน้ำตาล #130b02 / #1d1203 /
// #0b0501 และตัวอักษร PROFIT ในโลโก้เป็นโครเมียมเงิน)
//
// ไฟล์นี้เป็นการ์ดถาวรของ terms/privacy ด้วย — ข้างในสองหน้านั้นไม่ระบุสีเลย
// โดยตั้งใจ สีเนื้อความจึงต้องอยู่บนการ์ดใบนี้เสมอ ห้ามย้ายออก และนี่คือเหตุผล
// ที่ตระกูล ContentBox หมุน variant ไม่ได้จริงในรอบไหนก็ตาม
//
// การ์ดใบนี้ flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่
// wrapper <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e3ac22]/35 bg-[#0a0702]/90 p-8 text-left text-base leading-relaxed text-[#f3e6c4] shadow-[0_10px_30px_rgba(227,172,34,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffe9a8]/55 hover:shadow-[0_15px_40px_rgba(227,172,34,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e3ac22]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe9a8]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#2a1d05]/60 blur-[60px] transition-all duration-500 group-hover:bg-[#8b96a4]/45"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#e3ac22]/35 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#eef3f8] to-[#8b96a4] shadow-[0_0_10px_rgba(207,216,226,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fffaf0] via-[#ffe9a8] to-[#e3ac22] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
