---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#ff6a13]/35 bg-[#1e1105]/90 p-8 text-left text-base leading-relaxed text-[#f6e6c2] shadow-[0_10px_30px_rgba(255,106,19,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffcc4b]/55 hover:shadow-[0_15px_40px_rgba(255,204,75,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ff6a13]/30 blur-[60px] transition-all duration-500 group-hover:bg-[#ffcc4b]/40"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#2c1808]/55 blur-[60px] transition-all duration-500 group-hover:bg-[#eb9a1d]/35"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#ff6a13]/35 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffcc4b] to-[#ff6a13] shadow-[0_0_10px_rgba(255,204,75,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe974] via-[#ffcc4b] to-[#eb9a1d] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
