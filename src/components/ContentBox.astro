---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// JAICHUA: ย้ายจากน้ำเงินธงชาติคู่แดงบนกรมท่าเข้มของแบรนด์ก่อน มาเป็นทองคำคู่
// น้ำเงินรอยัล บนกรมท่าเกือบดำ — ทอง #fbeec9 / #f6d67e / #d8a83f / #a97722 /
// #6d4a12 คู่น้ำเงิน #cfe0fb / #5b8ede / #2f5fb0 / #16336b บนผิว #040915 /
// #0a1226 / #0e1a33 / #132244 เนื้อความ #dce6f8
//
// อาร์ตเวิร์กรอบนี้คือป้ายทองคำสามมิติบนโล่น้ำเงินกรมท่า ทั้งตัวอักษร จ่ายชัวร์888
// ตัวอักษร JAI CHUA ดาวเข็มทิศด้านบน และเหรียญจีนสองข้างเป็นทองคำทั้งชุด ส่วนโล่
// ที่รองอยู่กับฉากหลังของแบนเนอร์เป็นน้ำเงินกรมท่า — ทองจึงเป็นสีนำ น้ำเงินเป็นสี
// ที่สองจริง ไม่ใช่เงาของทอง ค่า vivid ของ logo.webp เด่นสุดเป็นทอง (#946335)
// ส่วน dominant ของแบนเนอร์เป็นน้ำตาลเข้ม/ดำอมน้ำเงินซึ่งคือพื้นหลัง ไม่ใช่สีเน้น
// — palette.json จัดอันดับให้ แต่ไม่ได้ตีความให้
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// ไฟล์นี้เป็นการ์ดถาวรของ terms/privacy — ข้างในสองหน้านั้นไม่ระบุสีเลยโดยตั้งใจ
// สีเนื้อความจึงต้องอยู่บนการ์ดใบนี้เสมอ ห้ามย้ายออก และนี่คือเหตุผลที่สองหน้านั้น
// หมุน variant ตาม index ไม่ได้ในรอบไหนก็ตาม รอบนี้หน้าย่อยที่ใช้การ์ดใบนี้คือ
// promotion / about-us / contact-us / ทางเข้า / ทดลองเล่น และหน้าแรกเรียกใบนี้หนึ่ง
// ครั้งที่หัวข้อ docx ข้อ 4 ส่วนทรงที่เหลือของหน้าแรกหมุนเป็นชุด CyberCut /
// TwoPremium / 3ThreeNeumorphism / Neumorphism / SevenThree / SevenThreeCyberCut
//
// การ์ดใบนี้ flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่
// wrapper <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a97722]/75 bg-[#0a1226]/90 p-8 text-left text-base leading-relaxed text-[#dce6f8] shadow-[0_10px_30px_rgba(22,39,78,0.45)] backdrop-blur-xl transition-all duration-500 hover:border-[#d8a83f]/70 hover:shadow-[0_15px_40px_rgba(216,168,63,0.3)] md:p-10">
    <div
      class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#0e1a33]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#d8a83f]/35">
    </div>
    <div
      class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#132244]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#2f5fb0]/30">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#a97722]/75 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f6d67e] via-[#d8a83f] to-[#2f5fb0] shadow-[0_0_10px_rgba(216,168,63,0.65)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fbeec9] via-[#f6d67e] to-[#d8a83f] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
