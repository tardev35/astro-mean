---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f5b626]/25 bg-[#150e05]/88 p-8 text-left text-base leading-relaxed text-[#f0e4cd] shadow-[0_10px_30px_rgba(245,182,38,0.15)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5b626]/50 hover:shadow-[0_15px_40px_rgba(255,216,107,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f5b626]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#ffd86b]/40"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#8a5c08]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe9a8]/35"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#f5b626]/25 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd86b] to-[#8a5c08] shadow-[0_0_10px_rgba(245,182,38,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe9a8] via-[#ffd86b] to-[#f5b626] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
