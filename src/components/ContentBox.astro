---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// PAY69: ย้ายจากม่วงไททันคู่มงกุฎทองของแบรนด์ก่อน มาเป็นทองแชมเปญเดี่ยวบนดำสนิท
// — ทอง #e8c37a / #f7dfa5 / #fdf4e0 / #a87c2e / #6b4d15 บนผิว #08070a /
// #12100c / #1c1811 เนื้อความ #e6dac2
//
// อาร์ตเวิร์กรอบนี้เป็นทองล้วนบนดำ ไม่มีสีคู่: พื้นหลังแบนเนอร์เป็นดำสนิท ควันกับ
// เส้นแสงเป็นทอง โลโก้เป็นตัวอักษรทองแชมเปญในกรอบดำ ค่า vivid ของโลโก้ใน
// palette.json (#ecdbb4 / #f2dcbb / #e5cca5) จึงเป็นสีเน้นจริง ส่วน dominant
// ที่ออกมาเป็นดำ (#14191c / #13171c) คือ "พื้น" ไม่ใช่สีเน้น — palette.json
// จัดอันดับให้ แต่ไม่ได้ตีความให้
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// ไฟล์นี้เป็นการ์ดถาวรของ terms/privacy — ข้างในสองหน้านั้นไม่ระบุสีเลยโดยตั้งใจ
// สีเนื้อความจึงต้องอยู่บนการ์ดใบนี้เสมอ ห้ามย้ายออก และนี่คือเหตุผลที่สองหน้านั้น
// หมุน variant ตาม index ไม่ได้ในรอบไหนก็ตาม รอบนี้หน้าย่อยอื่น (promotion /
// about-us / contact-us / ทางเข้า / ทดลองเล่น) ก็ใช้การ์ดใบนี้ด้วย
//
// การ์ดใบนี้ flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่
// wrapper <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a87c2e]/40 bg-[#12100c]/90 p-8 text-left text-base leading-relaxed text-[#e6dac2] shadow-[0_10px_30px_rgba(107,77,21,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#e8c37a]/60 hover:shadow-[0_15px_40px_rgba(232,195,122,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#1c1811]/60 blur-[60px] transition-all duration-500 group-hover:bg-[#e8c37a]/45"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#12100c]/50 blur-[60px] transition-all duration-500 group-hover:bg-[#a87c2e]/35"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#a87c2e]/40 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf4e0] via-[#f7dfa5] to-[#a87c2e] shadow-[0_0_10px_rgba(232,195,122,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdf4e0] via-[#f7dfa5] to-[#e8c37a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
