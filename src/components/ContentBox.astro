---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// SETH88: ย้ายจากทองคำคู่น้ำเงินรอยัลบนกรมท่าเกือบดำของแบรนด์ก่อน มาเป็นทองคำ
// อียิปต์คู่เงินขาว บนดำอมน้ำตาลของหินวิหาร — ทอง #fdf3d4 / #f7d774 / #e0a92b /
// #a9711a / #6b4210 คู่เงิน #d8dade บนผิว #0c0703 / #1b1109 / #2a1a0d
// เนื้อความ #f0e3cd
//
// อาร์ตเวิร์กรอบนี้คือโลโก้ทองคำสามมิติที่มีหัวเทพอนูบิสอยู่ด้านบนและสัญลักษณ์
// อังค์มีปีกอยู่ด้านล่าง ตัวอักษร SETH เป็นทองขัดเงา ส่วนเลข 88 เป็นเงินขาวขอบทอง
// พื้นหลังของแบนเนอร์เป็นวิหารอียิปต์โทนดำอมน้ำตาลใต้แสงคบเพลิง — ทองจึงเป็นสีนำ
// เดี่ยว ส่วนเงินขาวเป็นสีที่สองที่มาจากเลข 88 จริง ไม่ใช่เงาของทอง ค่า vivid ของ
// logo.webp เป็นบรอนซ์เข้ม (#643b0c) ซึ่งคือเงาของทอง ส่วน dominant ของแบนเนอร์
// เป็นดำอมน้ำตาล (#1b0c03) ซึ่งคือพื้นหลัง — palette.json จัดอันดับให้ แต่ไม่ได้
// ตีความให้ ทองสว่างที่ตาเห็นจริงมาจาก vivid ของ slide1 ที่ #935111
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// ไฟล์นี้เป็นการ์ดถาวรของ terms/privacy — ข้างในสองหน้านั้นไม่ระบุสีเลยโดยตั้งใจ
// สีเนื้อความจึงต้องอยู่บนการ์ดใบนี้เสมอ ห้ามย้ายออก และนี่คือเหตุผลที่สองหน้านั้น
// หมุน variant ตาม index ไม่ได้ในรอบไหนก็ตาม รอบนี้หน้าย่อยที่ใช้การ์ดใบนี้คือ
// promotion / about-us / contact-us / ทางเข้า / ทดลองเล่น ส่วนหน้าแรกไม่ได้เรียก
// ใบนี้เลย เพราะทรงของหน้าแรกหมุนเป็นชุด Premium / TwoCyberCut / 3ThreePremium /
// Special / SevenThreePremium / SevenThreeNeumorphism / FloatingBadge
//
// การ์ดใบนี้ flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่
// wrapper <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a9711a]/75 bg-[#1b1109]/90 p-8 text-left text-base leading-relaxed text-[#f0e3cd] shadow-[0_10px_30px_rgba(107,66,16,0.45)] backdrop-blur-xl transition-all duration-500 hover:border-[#e0a92b]/70 hover:shadow-[0_15px_40px_rgba(224,169,43,0.3)] md:p-10">
    <div
      class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#2a1a0d]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#e0a92b]/35">
    </div>
    <div
      class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#2a1a0d]/70 blur-[60px] transition-all duration-500 group-hover:bg-[#a9711a]/30">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#a9711a]/75 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf3d4] via-[#e0a92b] to-[#6b4210] shadow-[0_0_10px_rgba(224,169,43,0.65)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdf3d4] via-[#f7d774] to-[#e0a92b] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
