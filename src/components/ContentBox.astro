---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// DEKDDD: ย้ายจากทองคู่เงินโครเมียมของ AURORA688 (#e2c443 / #ffe9a3 / #c9a13a /
// #7d5714 คู่ #c3cddb / #eef2f7 บนผิว #0a0806 เนื้อความ #f2ead6) มาที่ทองคู่แดง
// ของแบรนด์นี้ — ทองหลัก #eebb1a / #ffe08a / #a3760a คู่แดง #a80d10 / #e01f26 /
// #5c0201 บนผิว #1a0503 เนื้อความ #f7e7c8 (วัดจากโลโก้โล่ทอง-ชุดแดงใน
// palette.json: vivid #eebb1a กับ #940100)
//
// ไฟล์นี้เป็นการ์ดถาวรของ terms/privacy ด้วย — ข้างในสองหน้านั้นไม่ระบุสีเลย
// โดยตั้งใจ สีเนื้อความจึงต้องอยู่บนการ์ดใบนี้เสมอ ห้ามย้ายออก
//
// การ์ดใบนี้ flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่
// wrapper <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#eebb1a]/35 bg-[#1a0503]/90 p-8 text-left text-base leading-relaxed text-[#f7e7c8] shadow-[0_10px_30px_rgba(238,187,26,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffe08a]/55 hover:shadow-[0_15px_40px_rgba(238,187,26,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#eebb1a]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe08a]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#a80d10]/55 blur-[60px] transition-all duration-500 group-hover:bg-[#e01f26]/45"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#eebb1a]/35 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe08a] to-[#a3760a] shadow-[0_0_10px_rgba(238,187,26,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff6dd] via-[#eebb1a] to-[#e01f26] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
