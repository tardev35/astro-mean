---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// PHOENIX168: ย้ายจากทองแชมเปญเดี่ยวบนดำสนิทของแบรนด์ก่อน มาเป็นไฟฟีนิกซ์คู่ทอง
// — ส้มไฟ #ff5a1e / #ffa14a / #ffe2c4 / #c04a12 / #7a2408 บนผิว #0a0402 /
// #150604 / #1f0a05 เนื้อความ #f2ddc9
//
// อาร์ตเวิร์กรอบนี้เป็นไฟส้มแดงคู่ทองบนดำอมแดง: ตัวนกฟีนิกซ์กับเปลวไฟเป็นส้มแดง
// ปลายขนปีกกับเลข 168 เป็นทอง ค่า vivid ของโลโก้กับ slide1 ใน palette.json
// (#fc3b0c / #f3ac3c / #ba130d / #f4dc6d) จึงเป็นสีเน้นจริง ส่วน dominant ที่
// ออกมาเป็นดำ (#030101 / #140301 / #1c1b1c) คือ "พื้น" ไม่ใช่สีเน้น —
// palette.json จัดอันดับให้ แต่ไม่ได้ตีความให้
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// ไฟล์นี้เป็นการ์ดถาวรของ terms/privacy — ข้างในสองหน้านั้นไม่ระบุสีเลยโดยตั้งใจ
// สีเนื้อความจึงต้องอยู่บนการ์ดใบนี้เสมอ ห้ามย้ายออก และนี่คือเหตุผลที่สองหน้านั้น
// หมุน variant ตาม index ไม่ได้ในรอบไหนก็ตาม รอบนี้หน้าย่อยอื่น (promotion /
// about-us / contact-us / ทางเข้า / ทดลองเล่น) ก็ใช้การ์ดใบนี้ด้วย
//
// การ์ดใบนี้ flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่
// wrapper <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#c04a12]/40 bg-[#150604]/90 p-8 text-left text-base leading-relaxed text-[#f2ddc9] shadow-[0_10px_30px_rgba(122,36,8,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff5a1e]/60 hover:shadow-[0_15px_40px_rgba(255,90,30,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#1f0a05]/60 blur-[60px] transition-all duration-500 group-hover:bg-[#ff5a1e]/45"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#150604]/50 blur-[60px] transition-all duration-500 group-hover:bg-[#c04a12]/35"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#c04a12]/40 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe2c4] via-[#ffa14a] to-[#c04a12] shadow-[0_0_10px_rgba(255,90,30,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe2c4] via-[#ffa14a] to-[#ff5a1e] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
