---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// HAPPYSUPERWIN: ย้ายจากทองหลอมคู่เงินโครเมียมของแบรนด์ก่อน มาเป็นชมพูบานเย็นคู่
// เหลืองลูกกวาดบนพื้นองุ่นเข้ม — บานเย็น #e11ccc / #ff5ae6 / #8a1f9e / #4c0d6b
// คู่เหลืองลูกกวาด #ffd83d / #fff0fc และเขียวมะนาว #a8e831 ที่มาจากคำว่า HAPPY
// ในโลโก้ บนผิว #190430 / #280747 / #380a5f เนื้อความ #f7e2ff
//
// อาร์ตเวิร์กรอบนี้เป็นแดนลูกกวาด: โลโก้เป็นตัวอักษรลูกกวาดสามมิติ HAPPY เขียว
// มะนาว คู่ SUPERWIN เหลืองไล่ส้มขอบม่วง ค่า vivid ของโลโก้ (#fdec6d / #fac442 /
// #facb44) จึงเป็นเหลืองล้วน แต่ตัวที่ทำหน้าที่ "สีเน้น" จริงคือม่วง/บานเย็นจาก
// slide1 (#3c0e94 กับ #eb34f9) ที่เป็นพื้นหลังของงานอาร์ตทั้งชุด — palette.json
// จัดอันดับให้ แต่ไม่ได้ตีความให้ ส่วนเขียวมะนาวเป็นสีที่สามจากตัวอักษร HAPPY
// ใช้เฉพาะจุดที่ต้องการคอนทราสต์สดใส
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// ไฟล์นี้เป็นการ์ดถาวรของ terms/privacy — ข้างในสองหน้านั้นไม่ระบุสีเลยโดยตั้งใจ
// สีเนื้อความจึงต้องอยู่บนการ์ดใบนี้เสมอ ห้ามย้ายออก และนี่คือเหตุผลที่สองหน้านั้น
// หมุน variant ตาม index ไม่ได้ในรอบไหนก็ตาม รอบนี้หน้าย่อยอื่น (promotion /
// about-us / contact-us / ทางเข้า / ทดลองเล่น) ก็ใช้การ์ดใบนี้ด้วย ส่วนหน้าแรก
// รอบนี้หมุนไปใช้ชุด Premium/Special/FloatingBadge จึงไม่ได้เรียกใบนี้
//
// การ์ดใบนี้ flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่
// wrapper <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#8a1f9e]/40 bg-[#280747]/90 p-8 text-left text-base leading-relaxed text-[#f7e2ff] shadow-[0_10px_30px_rgba(76,13,107,0.3)] backdrop-blur-xl transition-all duration-500 hover:border-[#e11ccc]/60 hover:shadow-[0_15px_40px_rgba(225,28,204,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#380a5f]/60 blur-[60px] transition-all duration-500 group-hover:bg-[#e11ccc]/45"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#280747]/50 blur-[60px] transition-all duration-500 group-hover:bg-[#8a1f9e]/35"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#8a1f9e]/40 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#a8e831] via-[#ffd83d] to-[#e11ccc] shadow-[0_0_10px_rgba(225,28,204,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff0fc] via-[#ffd83d] to-[#ff5ae6] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
