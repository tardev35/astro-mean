---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// PABO88: ย้ายจากน้ำเงินรอยัลคู่ทองของ LUCKYBKK (#3f9dfb / #cfe8ff / #1f5fd0 /
// #0a2a86 คู่ทอง #f0b323 / #ffdf7e / #9a6c05 บนผิว #030b28 เนื้อความ #e4eeff)
// มาเป็นนีออนม่วงคู่ทองของแบรนด์นี้ — ม่วง #bf3cfa / #e3b8ff / #8b1fd6 /
// #4a0b8f คู่ทอง #f5c518 / #ffe9a3 / #8f6205 บนผิว #0a0118 เนื้อความ #ece0ff
// (วัดจาก palette.json: vivid ของโลโก้คือ #bf3cfa / #6a0bb4 / #b13af4 /
// #cb64f4 ส่วนขอบตัวอักษรกับเหรียญบนแบนเนอร์เป็นทอง และเลข 88 เป็นเงิน)
//
// ไฟล์นี้เป็นการ์ดถาวรของ terms/privacy ด้วย — ข้างในสองหน้านั้นไม่ระบุสีเลย
// โดยตั้งใจ สีเนื้อความจึงต้องอยู่บนการ์ดใบนี้เสมอ ห้ามย้ายออก
//
// การ์ดใบนี้ flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่
// wrapper <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#bf3cfa]/35 bg-[#0a0118]/90 p-8 text-left text-base leading-relaxed text-[#ece0ff] shadow-[0_10px_30px_rgba(191,60,250,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#e3b8ff]/55 hover:shadow-[0_15px_40px_rgba(191,60,250,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#bf3cfa]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#e3b8ff]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#4a0b8f]/60 blur-[60px] transition-all duration-500 group-hover:bg-[#8b1fd6]/45"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#bf3cfa]/35 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a3] to-[#8f6205] shadow-[0_0_10px_rgba(245,197,24,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#faf5ff] via-[#e3b8ff] to-[#bf3cfa] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
