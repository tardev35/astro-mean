---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#7e3ac7]/35 bg-[#1c0620]/90 p-8 text-left text-base leading-relaxed text-[#f7e6c4] shadow-[0_10px_30px_rgba(126,58,199,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#fcc30b]/55 hover:shadow-[0_15px_40px_rgba(252,195,11,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#7e3ac7]/30 blur-[60px] transition-all duration-500 group-hover:bg-[#fcc30b]/40"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#3c0f52]/55 blur-[60px] transition-all duration-500 group-hover:bg-[#ce5a03]/35"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#7e3ac7]/35 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fcc30b] to-[#7e3ac7] shadow-[0_0_10px_rgba(252,195,11,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe9a8] via-[#fcc30b] to-[#e09a05] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
