---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// ROSTY59: ย้ายจากทองแชมเปญราชสำนักบนดำอมน้ำตาลของแบรนด์ก่อน มาเป็นทองอำพัน
// ออกส้มคู่โครเมียมเงินบนดำสนิท — ทอง #ffeec2 / #ffc94a / #f2a01a / #b06a0d /
// #6b3f07 คู่เงิน #dbe1e8 / #a3adba / #5d6773 บนผิว #070505 / #150e07 / #26180a
// ขอบ #4a2f0d เนื้อความ #ece0cc
//
// อาร์ตเวิร์กรอบนี้เป็นเหรียญทองนูน: โลโก้เป็นตัว R ทองคำสามมิติในวงแหวนทอง
// คำว่า Rosty เป็นทอง ส่วนเลข 59 เป็นโครเมียมเงิน — เงินจึงเป็นสีที่สองจริง
// ไม่ใช่แค่เงาของทอง ค่า vivid ของโลโก้ (#cc841d) เป็นทองอำพันออกส้ม ส่วนค่า
// dominant ของทุกไฟล์เป็นดำอมน้ำตาลซึ่งคือพื้นหลัง ไม่ใช่สีเน้น — palette.json
// จัดอันดับให้ แต่ไม่ได้ตีความให้
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// ไฟล์นี้เป็นการ์ดถาวรของ terms/privacy — ข้างในสองหน้านั้นไม่ระบุสีเลยโดยตั้งใจ
// สีเนื้อความจึงต้องอยู่บนการ์ดใบนี้เสมอ ห้ามย้ายออก และนี่คือเหตุผลที่สองหน้านั้น
// หมุน variant ตาม index ไม่ได้ในรอบไหนก็ตาม รอบนี้หน้าย่อยอื่น (promotion /
// about-us / contact-us / ทางเข้า / ทดลองเล่น) ใช้การ์ดใบนี้ด้วย ส่วนหน้าแรกหมุน
// ไปใช้ทรง Premium / FloatingBadge / Special ทั้งหมดจึงไม่ได้เรียกใบนี้รอบนี้
//
// การ์ดใบนี้ flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่
// wrapper <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#4a2f0d]/70 bg-[#150e07]/90 p-8 text-left text-base leading-relaxed text-[#ece0cc] shadow-[0_10px_30px_rgba(107,63,7,0.4)] backdrop-blur-xl transition-all duration-500 hover:border-[#f2a01a]/60 hover:shadow-[0_15px_40px_rgba(242,160,26,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#26180a]/75 blur-[60px] transition-all duration-500 group-hover:bg-[#f2a01a]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#150e07]/60 blur-[60px] transition-all duration-500 group-hover:bg-[#dbe1e8]/20"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#4a2f0d]/70 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffeec2] via-[#f2a01a] to-[#6b3f07] shadow-[0_0_10px_rgba(242,160,26,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffeec2] via-[#ffc94a] to-[#b06a0d] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
