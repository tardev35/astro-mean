---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// BLACKJACK789: ย้ายจากทองอำพันออกส้มคู่โครเมียมเงินของแบรนด์ก่อน มาเป็นทอง
// แอนทีคอมน้ำผึ้งคู่กราไฟต์บนดำสนิท — ทอง #fdf1ce / #f2cf70 / #d3aa4b /
// #b8862c / #5c4113 คู่กราไฟต์ #cfd6e0 / #8e97a6 / #454d5c บนผิว #050403 /
// #100b05 / #1e150a ขอบ #3a2a11 เนื้อความ #ede0c4
//
// อาร์ตเวิร์กรอบนี้เป็นโพดำทองคำ: ตัวโพเป็นทองแอนทีค ส่วนคำว่า Black Jack กับ
// เลข 789 เป็นโลหะเทากราไฟต์ขอบทอง — กราไฟต์จึงเป็นสีที่สองจริง ไม่ใช่เงาของทอง
// ค่า vivid ของโลโก้เป็นทองอมเหลืองน้ำผึ้ง ส่วนค่า dominant ของแบนเนอร์กับสไลด์
// เป็นดำอมน้ำตาลซึ่งคือพื้นหลัง ไม่ใช่สีเน้น — palette.json จัดอันดับให้ แต่ไม่ได้
// ตีความให้
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// ไฟล์นี้เป็นการ์ดถาวรของ terms/privacy — ข้างในสองหน้านั้นไม่ระบุสีเลยโดยตั้งใจ
// สีเนื้อความจึงต้องอยู่บนการ์ดใบนี้เสมอ ห้ามย้ายออก และนี่คือเหตุผลที่สองหน้านั้น
// หมุน variant ตาม index ไม่ได้ในรอบไหนก็ตาม รอบนี้หน้าย่อยอื่น (promotion /
// about-us / contact-us / ทางเข้า / ทดลองเล่น) ใช้การ์ดใบนี้ด้วย ส่วนหน้าแรกหมุน
// ไปใช้ทรง CyberCut / Neumorphism ทั้งหมดจึงไม่ได้เรียกใบนี้รอบนี้
//
// การ์ดใบนี้ flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่
// wrapper <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#3a2a11]/70 bg-[#100b05]/90 p-8 text-left text-base leading-relaxed text-[#ede0c4] shadow-[0_10px_30px_rgba(92,65,19,0.4)] backdrop-blur-xl transition-all duration-500 hover:border-[#d3aa4b]/60 hover:shadow-[0_15px_40px_rgba(211,170,75,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#1e150a]/75 blur-[60px] transition-all duration-500 group-hover:bg-[#d3aa4b]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#100b05]/60 blur-[60px] transition-all duration-500 group-hover:bg-[#cfd6e0]/20"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#3a2a11]/70 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf1ce] via-[#d3aa4b] to-[#5c4113] shadow-[0_0_10px_rgba(211,170,75,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdf1ce] via-[#f2cf70] to-[#8c6623] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
