---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// GUESS168: ย้ายจากน้ำเงินรอยัลสนามไฟคู่ทองของแบรนด์ก่อน มาเป็นทองหลอมคู่ส้มไฟ
// ของแบรนด์นี้ — ทอง #fecc02 / #ffe680 / #ffd54a / #c58a00 คู่ส้ม #fe9c01 /
// #a35800 บนผิวดำอมน้ำตาล #140800 / #231005 / #33180a เนื้อความ #f7e7c6
// (วัดจาก palette.json: vivid ของโลโก้เป็นทอง #fecc02 / #fed402 / #ffc401 /
// #feb302 / #fe9c01 ส่วน dominant ของแบนเนอร์เป็นดำอมน้ำตาล #140500 / #230c00 /
// #1b0a01 และ dominant ของสไลด์เป็น #020000 / #0b0303)
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// ไฟล์นี้เป็นการ์ดถาวรของ terms/privacy — ข้างในสองหน้านั้นไม่ระบุสีเลยโดยตั้งใจ
// สีเนื้อความจึงต้องอยู่บนการ์ดใบนี้เสมอ ห้ามย้ายออก และนี่คือเหตุผลที่สองหน้านั้น
// หมุน variant ตาม index ไม่ได้ในรอบไหนก็ตาม รอบนี้หน้าย่อยอื่น (promotion /
// about-us / contact-us / ทางเข้า / ทดลองเล่น) ก็ใช้การ์ดใบนี้ด้วย
//
// การ์ดใบนี้ flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่
// wrapper <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#c58a00]/40 bg-[#140800]/90 p-8 text-left text-base leading-relaxed text-[#f7e7c6] shadow-[0_10px_30px_rgba(197,138,0,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffd54a]/60 hover:shadow-[0_15px_40px_rgba(254,156,1,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#33180a]/60 blur-[60px] transition-all duration-500 group-hover:bg-[#c58a00]/45"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#231005]/50 blur-[60px] transition-all duration-500 group-hover:bg-[#fe9c01]/35"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#c58a00]/40 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe680] to-[#c58a00] shadow-[0_0_10px_rgba(254,156,1,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff6e0] via-[#fecc02] to-[#fe9c01] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
