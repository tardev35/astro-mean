---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// GEN4: ย้ายจากส้มไฟคู่ทองของแบรนด์ก่อน มาเป็นน้ำเงินอิเล็กทริกคู่แดงของแบรนด์นี้ —
// น้ำเงิน #0071d5 / #01a3f3 / #a9ddff / #00408a คู่แดง #e8241c / #ff5a33 /
// #7a1410 บนผิวกรมท่าเกือบดำ #050b1a / #081428 / #0b1b3a เนื้อความ #d7e7ff
// (วัดจาก palette.json: vivid ของโลโก้เป็น #006fd5 / #007cdd / #01a3f3 ส่วน
// dominant ของแบนเนอร์เป็นกรมท่าเกือบดำ)
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// ไฟล์นี้เป็นการ์ดถาวรของ terms/privacy ด้วย — ข้างในสองหน้านั้นไม่ระบุสีเลย
// โดยตั้งใจ สีเนื้อความจึงต้องอยู่บนการ์ดใบนี้เสมอ ห้ามย้ายออก และนี่คือเหตุผล
// ที่ตระกูล ContentBox หมุน variant ไม่ได้จริงในรอบไหนก็ตาม
//
// การ์ดใบนี้ flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่
// wrapper <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#0071d5]/35 bg-[#050b1a]/90 p-8 text-left text-base leading-relaxed text-[#d7e7ff] shadow-[0_10px_30px_rgba(0,113,213,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#a9ddff]/55 hover:shadow-[0_15px_40px_rgba(0,113,213,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#00408a]/50 blur-[60px] transition-all duration-500 group-hover:bg-[#0071d5]/40"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#7a1410]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#e8241c]/35"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#0071d5]/35 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#a9ddff] to-[#0071d5] shadow-[0_0_10px_rgba(0,113,213,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#eaf4ff] via-[#01a3f3] to-[#e8241c] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
