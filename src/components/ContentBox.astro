---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// VIREL168: ย้ายจากม่วงลึกคู่มาเจนต้าของแบรนด์ก่อน มาเป็นทองคู่เงินโครเมียม —
// ทอง #faca4c / #ebb134 / #e2a52d / #ffeec2 / #855a14 คู่เงิน #e1e1e1 / #949494
// บนผิว #0a0501 / #1b0d02 / #2e1a04 ขอบ #442503 เนื้อความ #f4e7cd (วัดจาก
// palette.json: vivid ของโลโก้เป็นทอง #faca4c / #f8c442 / #e2a52d / #ebb134 /
// #855a14 ส่วน dominant ของแบนเนอร์กับสไลด์เป็นดำอมน้ำตาล #020101 / #0b0501 /
// #241403 และคำว่า VIREL ในโลโก้เป็นเงินโครเมียม)
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// ไฟล์นี้เป็นการ์ดถาวรของ terms/privacy ด้วย — ข้างในสองหน้านั้นไม่ระบุสีเลย
// โดยตั้งใจ สีเนื้อความจึงต้องอยู่บนการ์ดใบนี้เสมอ ห้ามย้ายออก และนี่คือเหตุผล
// ที่ตระกูล ContentBox หมุน variant ไม่ได้จริงในรอบไหนก็ตาม
//
// การ์ดใบนี้ flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่
// wrapper <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e2a52d]/35 bg-[#0a0501]/90 p-8 text-left text-base leading-relaxed text-[#f4e7cd] shadow-[0_10px_30px_rgba(250,202,76,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffeec2]/55 hover:shadow-[0_15px_40px_rgba(250,202,76,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#855a14]/50 blur-[60px] transition-all duration-500 group-hover:bg-[#e2a52d]/40"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e1e1e1]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#949494]/35"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#e2a52d]/35 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffeec2] to-[#e2a52d] shadow-[0_0_10px_rgba(250,202,76,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff8e4] via-[#faca4c] to-[#e1e1e1] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
