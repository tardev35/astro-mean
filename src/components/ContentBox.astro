---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#fb0660]/30 bg-[#1f0524]/92 p-8 text-left text-base leading-relaxed text-[#f6dfec] shadow-[0_10px_30px_rgba(251,6,96,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#fb0660]/60 hover:shadow-[0_15px_40px_rgba(251,6,96,0.26)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fb0660]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#fb0660]/32"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#8b3fd9]/38 blur-[60px] transition-all duration-500 group-hover:bg-[#fd841b]/38"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#fb0660]/30 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffb457] to-[#fb0660] shadow-[0_0_10px_rgba(251,6,96,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffb457] via-[#fd841b] to-[#fb0660] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
