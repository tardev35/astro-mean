---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// XTOP666: ย้ายจากทองสว่างคู่เงินโครเมียมของแบรนด์ก่อน มาเป็นส้มไฟคู่แดงเลือดของ
// แบรนด์นี้ — ส้ม #fc5b03 / #ff8a3d / #ffc9a3 / #a33200 คู่แดง #e11212 / #ff5a4d
// บนผิวเกือบดำอมแดง #0a0403 / #1a0603 / #2e0c04 เนื้อความ #f6e5dc
// (วัดจาก palette.json: vivid ของโลโก้เป็นส้ม #fc5b03 / #fc6303 / #fa5302 ส่วน
// vivid ของสไลด์เป็นแดงเข้ม #9b0101 / #940101 และ dominant ของแบนเนอร์เป็นดำ
// อมแดงเกือบสนิท #020101 / #1b0201 / #240201)
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// ไฟล์นี้เป็นการ์ดถาวรของ terms/privacy — ข้างในสองหน้านั้นไม่ระบุสีเลยโดยตั้งใจ
// สีเนื้อความจึงต้องอยู่บนการ์ดใบนี้เสมอ ห้ามย้ายออก และนี่คือเหตุผลที่สองหน้านั้น
// หมุน variant ตาม index ไม่ได้ในรอบไหนก็ตาม
//
// การ์ดใบนี้ flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่
// wrapper <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#fc5b03]/35 bg-[#0a0403]/90 p-8 text-left text-base leading-relaxed text-[#f6e5dc] shadow-[0_10px_30px_rgba(252,91,3,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffc9a3]/55 hover:shadow-[0_15px_40px_rgba(252,91,3,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#a33200]/50 blur-[60px] transition-all duration-500 group-hover:bg-[#fc5b03]/40"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#2e0c04]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#e11212]/35"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#fc5b03]/35 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffc9a3] to-[#fc5b03] shadow-[0_0_10px_rgba(252,91,3,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff0e6] via-[#ff8a3d] to-[#ff5a4d] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
