---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// ORCA789: ย้ายจากทองคู่แดงของ DEKDDD (#eebb1a / #ffe08a / #a3760a คู่ #a80d10 /
// #e01f26 / #5c0201 บนผิว #1a0503 เนื้อความ #f7e7c8) มาเป็นฟ้านีออนใต้ทะเลคู่ทอง
// ของแบรนด์นี้ — ฟ้าหลัก #00abfc / #84ccfb / #016cfa / #011dc4 คู่ทอง #ffd54a /
// #ffe89a บนผิว #010614 เนื้อความ #dbeafe (วัดจาก palette.json: vivid ของโลโก้
// วาฬออร์ก้าคือ #011dc4 / #84ccfb / #00abfc ส่วนมงกุฎ-เหรียญบนแบนเนอร์เป็นทอง)
//
// ไฟล์นี้เป็นการ์ดถาวรของ terms/privacy ด้วย — ข้างในสองหน้านั้นไม่ระบุสีเลย
// โดยตั้งใจ สีเนื้อความจึงต้องอยู่บนการ์ดใบนี้เสมอ ห้ามย้ายออก
//
// การ์ดใบนี้ flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่
// wrapper <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#00abfc]/35 bg-[#010614]/90 p-8 text-left text-base leading-relaxed text-[#dbeafe] shadow-[0_10px_30px_rgba(0,171,252,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#84ccfb]/55 hover:shadow-[0_15px_40px_rgba(0,171,252,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#00abfc]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#84ccfb]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#011dc4]/55 blur-[60px] transition-all duration-500 group-hover:bg-[#016cfa]/45"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#00abfc]/35 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd54a] to-[#8a6206] shadow-[0_0_10px_rgba(255,213,74,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f0f9ff] via-[#84ccfb] to-[#00abfc] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
