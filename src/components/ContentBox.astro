---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#ef8f22]/35 bg-[#160d05]/90 p-8 text-left text-base leading-relaxed text-[#f6e3c0] shadow-[0_10px_30px_rgba(239,143,34,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffd77a]/55 hover:shadow-[0_15px_40px_rgba(239,143,34,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ef8f22]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#ffd77a]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#7e120e]/55 blur-[60px] transition-all duration-500 group-hover:bg-[#d1201a]/40"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#ef8f22]/35 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd77a] to-[#d1201a] shadow-[0_0_10px_rgba(239,143,34,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe9b8] via-[#ef8f22] to-[#a44516] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
