---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;

// pt-32/md:pt-28 — the badge hangs at -top-6, so its bottom edge lands
// (badge height − 24px) below the card's top edge. A full-sentence Thai H2
// wraps to two or three lines here, and the old pt-28/md:pt-24 left the last
// line of the badge sitting on the image. PODK888's docx H2 for this block is
// 76 Thai characters: on a 360px phone the badge's inner text width is ~270px,
// so it wraps to 3 lines of 27px = 81px + 24px of chrome = 105px, bottom edge
// at 81px against pt-32 (128px) → 47px of clearance (still positive at 4
// lines). At md the badge is max-w-2xl, 2 lines of 36px = 96px, bottom edge
// 72px against md:pt-28 (112px) → 40px. The badge is w-[92%] max-w-2xl
// text-center, never whitespace-nowrap. Kept one step shallower than
// ContentBoxFloatingBadge.astro, which anchors its badge the same way but
// spends ~52px of badge width on two decorative ✦ spans.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#f670b7]/30 bg-gradient-to-b from-[#2a0f2e]/95 to-[#12060f]/95 p-8 pt-32 shadow-[0_10px_30px_rgba(246,112,183,0.18)] md:pt-28">
    <div class="pointer-events-none absolute -right-10 -bottom-16 -z-10 h-40 w-40 rounded-full bg-[#02dbfd]/30 blur-[60px]"></div>
    <div class="pointer-events-none absolute -top-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#e01e83]/30 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 w-[92%] max-w-2xl -translate-x-1/2 rounded-lg border-2 border-[#f670b7]/45 bg-[#12060f] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(224,30,131,0.35)] sm:px-8">
          <h2 class="bg-gradient-to-r from-[#fed0b9] via-[#f670b7] to-[#02dbfd] bg-clip-text text-lg leading-normal font-black tracking-tight text-transparent sm:text-xl md:text-2xl">
            {title}
          </h2>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3d7e7]">
        {titleleft && <h2 class="text-2xl leading-normal font-bold text-[#f670b7]">{titleleft}</h2>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3d7e7] md:border-l md:border-[#f670b7]/30 md:pl-10">
        {titleright && <h2 class="text-2xl leading-normal font-bold text-[#f670b7]">{titleright}</h2>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
