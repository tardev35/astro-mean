---
// ห้ามขึ้นต้น message ด้วย emoji — marquee นี้ render ข้อความซ้ำสองรอบ (ไม่มี seam)
// screen reader จึงอ่าน emoji ตัวนั้นซ้ำด้วย และ emoji ที่อยู่ใน prop ทำ aria-hidden
// ไม่ได้ ส่วนกระดิ่ง 🔔 ด้านซ้ายเป็น element ของตัวเองจึงมี aria-hidden ได้
//
// ค่า default ต้องเป็นคำโฆษณาของแบรนด์ปัจจุบันเสมอ — หน้าย่อยทุกหน้าเรียก
// <Announcement /> เปล่าๆ จึงตกมาใช้ค่านี้ ถ้าลืมอัปเดต ทั้งเว็บยกเว้นหน้าแรก
// จะวิ่งข้อความของแบรนด์ก่อนหน้า
//
// LUCKYBKK: ย้ายจากแดงเลือดหมูคู่ทองของ DEKDDD (#eebb1a / #ffe08a / #2a0806 /
// #a80d10 / #e01f26 เนื้อความ #f7e7c8) มาเป็นน้ำเงินรอยัลคู่ทอง — น้ำเงิน
// #3f9dfb / #cfe8ff / #1f5fd0 / #0a2a86 กับทอง #f0b323 / #ffdf7e บนผิว #030b28 /
// #061442 เนื้อความ #e4eeff
const {
  message = "LUCKYBKK คาสิโนอันดับต้น เกมสดคุณภาพ VIP ระบบตรงไว้ใจได้ • ศูนย์รวมความบันเทิงระดับพรีเมียมที่นำเสนอเกมสดส่งตรงจากสตูดิโอชั้นนำ โดดเด่นด้วยระบบตรงที่ไม่ผ่านคนกลาง เสถียร ปลอดภัย และโปร่งใสในทุกมิติ • ยิงตรงสัญญาณสดความละเอียดสูง คมชัดระดับ HD ทั้งภาพและเสียง ครบทั้งบาคาร่า รูเล็ต เสือมังกร และไฮโล ดำเนินเกมโดยดีลเลอร์มืออาชีพตลอด 24 ชั่วโมง • คัดสรรโต๊ะเดิมพันและค่ายเกมชั้นนำมารวมไว้ในที่เดียว มีห้องให้เลือกหลากหลายระดับ ตั้งแต่เบทเริ่มต้นสบายๆ ไปจนถึงห้องระดับ High Roller สำหรับสายลุยหนัก • หน้าต่างการใช้งานแสดงข้อมูลและสถิติย้อนหลังได้ชัดเจน ช่วยให้วางแผนเดิมพันได้ง่ายและแม่นยำยิ่งขึ้น • ทุกขั้นตอนโปร่งใสตรวจสอบได้จริง อัตราการจ่ายได้มาตรฐานสากล ผลการเดิมพันยุติธรรมตรงไปตรงมา ไร้เงื่อนไขซับซ้อน • ระบบหลังบ้านเสถียร รองรับผู้เข้าใช้งานพร้อมกันจำนวนมากโดยไม่หน่วงหรือกระตุก สลับโต๊ะเดิมพันได้ฉับไว • ฝากถอนผ่านระบบออโต้ด้วยตัวเองในไม่กี่ขั้นตอน ยอดเงินอัปเดตไว พร้อมหน้าต่างเช็กประวัติย้อนหลังที่เปิดดูได้ชัดเจน • ทีมแอดมินมืออาชีพดูแลและซัพพอร์ตสมาชิกทุกคนตลอด 24 ชั่วโมง สุภาพ รวดเร็ว และเป็นกันเอง",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#f0b323]/55 bg-[#061442] shadow-[0_0_15px_rgba(240,179,35,0.3)]">
    <div class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#ffdf7e] to-[#0a2a86]"></div>
    <div class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#3f9dfb]/35"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#ffdf7e] to-[#0a2a86] py-2.5">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(3,11,40,0.7)]">🔔</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#061442] to-transparent"></div>
        <div class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#061442] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#e4eeff]">
          <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#f0b323] shadow-[0_0_5px_rgba(240,179,35,0.9)]"></span>{message}</span>
          <span aria-hidden="true" class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#f0b323] shadow-[0_0_5px_rgba(240,179,35,0.9)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
