---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "gold" | "red";
}

export interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;

// นี่คือที่เดียวบนหน้าแรกที่ได้รับอนุญาตให้มี <h3> — หัวข้อย่อยแบบ bullet ใต้
// section ของ docx หนึ่งข้อ (ข้อ 4 ของ CK1968: เลิกส่งสลิปให้แอดมินตรวจ / ระบบ AI
// จัดการธุรกรรมอัตโนมัติเต็มรูปแบบ / ยอดเงินเข้ากระเป๋าในไม่กี่วินาที / ฝากดึกถอน
// เช้าตรู่ก็ลื่นไหลไม่สะดุด) ส่วน h2 ของ section ยังอยู่ที่ ContentBoxTwoPremium
// ที่อยู่เหนือมัน
//
// item.icon เป็นอิโมจิ/สัญลักษณ์ตกแต่งล้วน กล่องที่ครอบมันจึงต้องมี
// aria-hidden="true" เสมอ ไม่งั้น screen reader จะอ่านชื่อ CLDR ของอิโมจินำหน้า
// หัวข้อจริง และ verify-build จะฟ้องเป็น error ว่ามีอิโมจิอยู่นอก aria-hidden
//
// CK1968: ย้ายจากทองแอนทีคคู่กราไฟต์ของแบรนด์ก่อน มาเป็นทองคำคู่แดงเลือดหมูบนดำ
// อมน้ำตาล — ทอง #ffefc4 / #ffd45c / #f0a80c / #a76806 / #5d3a05 คู่แดง #ff4b52 /
// #d4090f / #8c0206 / #3d0203 บนผิว #090302 / #170806 / #2a100a ขอบ #4d1f0d
// เนื้อความ #f6e4c0 ข้อความรอง #cdb494
//
// คีย์ accent สองตัวตรงกับสองสีบนโลโก้จริง: "gold" คือตัว C กับเลข 1968 และวงแหวน
// ทองคำ ส่วน "red" คือตัว K มงกุฎประดับทับทิม ไพ่ชุดแดง และลูกเต๋าแดง
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history)
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isGold = item.accent !== "red";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#4d1f0d]/60 bg-[#170806]/70 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isGold
              ? "hover:border-[#f0a80c]/60 hover:bg-[#2a100a] hover:shadow-[0_10px_20px_rgba(240,168,12,0.2)]"
              : "hover:border-[#ff4b52]/60 hover:bg-[#2a100a] hover:shadow-[0_10px_20px_rgba(212,9,15,0.22)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold
                ? "border border-[#f0a80c]/50 bg-gradient-to-br from-[#f0a80c] to-[#5d3a05] shadow-[0_0_15px_rgba(240,168,12,0.45)] group-hover:rotate-3"
                : "border border-[#ff4b52]/50 bg-gradient-to-br from-[#d4090f] to-[#3d0203] shadow-[0_0_15px_rgba(212,9,15,0.45)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <h3
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isGold ? "bg-gradient-to-r from-[#ffefc4] to-[#f0a80c] bg-clip-text text-transparent" : "bg-gradient-to-r from-[#ff4b52] to-[#8c0206] bg-clip-text text-transparent"
              }`}>
              {item.title}
            </h3>
            <p class="text-left text-base leading-relaxed text-[#cdb494] transition-colors group-hover:text-[#f6e4c0]">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
