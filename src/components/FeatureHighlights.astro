---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "gold" | "silver";
}

export interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;

// นี่คือที่เดียวบนหน้าแรกที่ได้รับอนุญาตให้มี <h3> — หัวข้อย่อยแบบ bullet ใต้
// section ของ docx หนึ่งข้อ (ข้อ 4 ของ QUEEN189: Multipliers ตัวคูณสะสม / โหมด
// ซื้อฟรีสปิน / Cascading คอมโบแตกต่อเนื่อง) ส่วน h2 ของ section ยังอยู่ที่
// ContentBoxSevenThreeCyberCut ที่อยู่เหนือมัน
//
// item.icon เป็นอิโมจิ/สัญลักษณ์ตกแต่งล้วน กล่องที่ครอบมันจึงต้องมี
// aria-hidden="true" เสมอ ไม่งั้น screen reader จะอ่านชื่อ CLDR ของอิโมจินำหน้า
// หัวข้อจริง และ verify-build จะฟ้องเป็น error ว่ามีอิโมจิอยู่นอก aria-hidden
//
// QUEEN189: ย้ายจากแคนดี้มาเจนต้าคู่เหลืองลูกอมของแบรนด์ก่อน มาเป็นทองราชสำนัก
// บนดำสนิทแบบ hex ตรงชุดเดียวกับ ContentBoxSevenThreeCyberCut — ทอง #fdf3d2 /
// #fceb83 / #e4bb53 / #c38d29 / #7a5615 บนผิว #1a1108 / #271a0c / #3c2505
// เนื้อความ #f3e4c4 ข้อความรอง #c2a878 accent "gold" เป็นค่า default (ทองหลัก)
// ส่วน accent "silver" ใช้สลับให้ลิสต์ไม่จำเจ (ทองสว่างขึ้นหนึ่งขั้น) — ชื่อคีย์
// ทั้งสองเป็น API เดิมของ component นี้ที่หน้าเรียกใช้ข้ามรีแบรนด์ ไม่ได้ผูกกับสี
// จริงของแบรนด์ และแบรนด์นี้เป็นทองวรรณะเดียว จึงไม่หยิบสีที่สองมาแยกสองแบบ
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history)
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isGold = item.accent !== "silver";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#7a5615]/40 bg-[#1a1108]/70 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isGold
              ? "hover:border-[#e4bb53]/60 hover:bg-[#271a0c] hover:shadow-[0_10px_20px_rgba(228,187,83,0.16)]"
              : "hover:border-[#fceb83]/60 hover:bg-[#271a0c] hover:shadow-[0_10px_20px_rgba(252,235,131,0.16)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold
                ? "border border-[#e4bb53]/50 bg-gradient-to-br from-[#c38d29] to-[#3c2505] shadow-[0_0_15px_rgba(228,187,83,0.45)] group-hover:rotate-3"
                : "border border-[#fceb83]/50 bg-gradient-to-br from-[#fceb83] to-[#7a5615] shadow-[0_0_15px_rgba(252,235,131,0.35)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <h3
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isGold ? "bg-gradient-to-r from-[#fdf3d2] to-[#c38d29] bg-clip-text text-transparent" : "bg-gradient-to-r from-[#fceb83] to-[#e4bb53] bg-clip-text text-transparent"
              }`}>
              {item.title}
            </h3>
            <p class="text-left text-base leading-relaxed text-[#c2a878] transition-colors group-hover:text-[#f3e4c4]">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
