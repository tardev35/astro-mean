---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "crimson" | "pink";
}

export interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;

// นี่คือที่เดียวบนหน้าแรกที่ได้รับอนุญาตให้มี <h3> — หัวข้อย่อยแบบ bullet ใต้
// section ของ docx หนึ่งข้อ (ข้อ 5 ของ 9KPLUS: ตัวคูณทวีคูณ Multipliers /
// Expanding Wild ยืดเต็มรีล / คอมโบแตกต่อเนื่อง Cascading / โหมด Bonus Buy)
// ส่วน h2 ของ section ยังอยู่ที่ ContentBox ที่อยู่เหนือมัน
//
// item.icon เป็นอิโมจิ/สัญลักษณ์ตกแต่งล้วน กล่องที่ครอบมันจึงต้องมี
// aria-hidden="true" เสมอ ไม่งั้น screen reader จะอ่านชื่อ CLDR ของอิโมจินำหน้า
// หัวข้อจริง และ verify-build จะฟ้องเป็น error ว่ามีอิโมจิอยู่นอก aria-hidden
//
// 9KPLUS: ย้ายจากชุดสีฟ้าคู่ทองของแบรนด์ก่อน มาเป็นแดงนีออนคู่ชมพูบานเย็นบนพื้น
// เกือบดำ — แดง #ffe3ee / #f0b9cd / #ff4a74 / #f5003e / #b3022c / #7c1040 คู่ชมพู
// #ffd8e7 / #ff4fa3 บนผิว #120309 / #1f0611 / #4d012c ขอบ #f5003e เนื้อความ #ffe3ee
// ข้อความรอง #f0b9cd
//
// คีย์ accent สองตัวคือคู่สีจริงของโลโก้: "crimson" คือแดงนีออนของวงแหวนรอบตรากลม
// และตัวอักษร 9K ซึ่งเป็นสีนำ ส่วน "pink" คือชมพูบานเย็นของตู้สล็อตกับป้ายนีออนใน
// แบนเนอร์ซึ่งเป็นแกนสีที่สอง — คีย์เดิมที่เป็นชื่อคู่สีของแบรนด์ก่อนจึงถูกเปลี่ยน
// ชื่อไปพร้อมกับสี (ไฟล์นี้ถูกเรียกจาก index.astro หน้าเดียว การเปลี่ยนชื่อคีย์จึง
// กระทบแค่ที่นั่น) ค่าปริยายคือ "crimson" ซึ่งเป็นสีนำของแบรนด์
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history)
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isCrimson = item.accent !== "pink";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#f5003e]/55 bg-[#1f0611]/85 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isCrimson
              ? "hover:border-[#ff4a74]/70 hover:bg-[#4d012c] hover:shadow-[0_10px_20px_rgba(255,74,116,0.25)]"
              : "hover:border-[#ff4fa3]/70 hover:bg-[#4d012c] hover:shadow-[0_10px_20px_rgba(255,79,163,0.28)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isCrimson
                ? "border border-[#ff4a74]/55 bg-gradient-to-br from-[#ff4a74] to-[#7c1040] shadow-[0_0_15px_rgba(245,0,62,0.5)] group-hover:rotate-3"
                : "border border-[#ff4fa3]/60 bg-gradient-to-br from-[#ffd8e7] to-[#b3022c] shadow-[0_0_15px_rgba(255,79,163,0.5)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <h3
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isCrimson ? "bg-gradient-to-r from-[#ffe3ee] to-[#ff4a74] bg-clip-text text-transparent" : "bg-gradient-to-r from-[#ffd8e7] to-[#ff4fa3] bg-clip-text text-transparent"
              }`}>
              {item.title}
            </h3>
            <p class="text-left text-base leading-relaxed text-[#f0b9cd] transition-colors group-hover:text-[#ffe3ee]">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
