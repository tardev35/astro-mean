---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "gold" | "silver";
}

export interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;

// นี่คือที่เดียวบนหน้าแรกที่ได้รับอนุญาตให้มี <h3> — หัวข้อย่อยแบบ bullet ใต้
// section ของ docx หนึ่งข้อ (ข้อ 4 ของ BLACKJACK789: Multipliers ตัวคูณทวีคูณ /
// Expanding Wild ขยายเต็มรีล / Cascading คอมโบแตกต่อเนื่อง / Bonus Buy ซื้อฟรีสปิน)
// ส่วน h2 ของ section ยังอยู่ที่ ContentBoxTwoNeumorphism ที่อยู่เหนือมัน
//
// item.icon เป็นอิโมจิ/สัญลักษณ์ตกแต่งล้วน กล่องที่ครอบมันจึงต้องมี
// aria-hidden="true" เสมอ ไม่งั้น screen reader จะอ่านชื่อ CLDR ของอิโมจินำหน้า
// หัวข้อจริง และ verify-build จะฟ้องเป็น error ว่ามีอิโมจิอยู่นอก aria-hidden
//
// BLACKJACK789: ย้ายจากทองอำพันคู่โครเมียมของแบรนด์ก่อน มาเป็นทองแอนทีค/แชมเปญคู่
// กราไฟต์บนดำเกือบสนิท — ทอง #fdf1ce / #f2cf70 / #d3aa4b / #8c6623 / #5c4113
// คู่กราไฟต์ #cfd6e0 / #8e97a6 / #454d5c บนผิว #050403 / #100b05 / #1e150a
// ขอบ #3a2a11 เนื้อความ #ede0c4 ข้อความรอง #c0ab84
//
// คีย์ accent สองตัวตรงกับโลหะสองชนิดบนโลโก้จริง: "gold" คือทองแชมเปญของโพดำและ
// ขอบตัวอักษร ส่วน "silver" คือกราไฟต์/กันเมทัลของตัวอักษร Black Jack กับเลข 789
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history)
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isGold = item.accent !== "silver";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#3a2a11]/60 bg-[#100b05]/70 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isGold
              ? "hover:border-[#d3aa4b]/60 hover:bg-[#1e150a] hover:shadow-[0_10px_20px_rgba(211,170,75,0.18)]"
              : "hover:border-[#cfd6e0]/60 hover:bg-[#1e150a] hover:shadow-[0_10px_20px_rgba(207,214,224,0.16)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold
                ? "border border-[#d3aa4b]/50 bg-gradient-to-br from-[#d3aa4b] to-[#5c4113] shadow-[0_0_15px_rgba(211,170,75,0.45)] group-hover:rotate-3"
                : "border border-[#cfd6e0]/50 bg-gradient-to-br from-[#8e97a6] to-[#454d5c] shadow-[0_0_15px_rgba(207,214,224,0.35)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <h3
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isGold ? "bg-gradient-to-r from-[#fdf1ce] to-[#d3aa4b] bg-clip-text text-transparent" : "bg-gradient-to-r from-[#cfd6e0] to-[#8e97a6] bg-clip-text text-transparent"
              }`}>
              {item.title}
            </h3>
            <p class="text-left text-base leading-relaxed text-[#c0ab84] transition-colors group-hover:text-[#ede0c4]">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
