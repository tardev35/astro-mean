---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "gold" | "silver";
}

export interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;

// นี่คือที่เดียวบนหน้าแรกที่ได้รับอนุญาตให้มี <h3> — หัวข้อย่อยแบบ bullet ใต้
// section ของ docx หนึ่งข้อ (ข้อ 5 ของ ROSTY59: Multiplier สะสมตัวคูณ / Cascading
// สัญลักษณ์แตกต่อเนื่อง / รีลขยาย Wild ซ้อนทับ / Bonus Buy ซื้อฟรีสปิน) ส่วน h2
// ของ section ยังอยู่ที่ ContentBoxSpecial ที่อยู่เหนือมัน
//
// item.icon เป็นอิโมจิ/สัญลักษณ์ตกแต่งล้วน กล่องที่ครอบมันจึงต้องมี
// aria-hidden="true" เสมอ ไม่งั้น screen reader จะอ่านชื่อ CLDR ของอิโมจินำหน้า
// หัวข้อจริง และ verify-build จะฟ้องเป็น error ว่ามีอิโมจิอยู่นอก aria-hidden
//
// ROSTY59: ย้ายจากทองราชสำนักวรรณะเดียวของแบรนด์ก่อน มาเป็นทองอำพันคู่โครเมียมเงิน
// บนดำสนิท — ทอง #ffeec2 / #ffc94a / #f2a01a / #b06a0d / #6b3f07 คู่เงิน #dbe1e8 /
// #a3adba / #5d6773 บนผิว #070505 / #150e07 / #26180a ขอบ #4a2f0d เนื้อความ #ece0cc
// ข้อความรอง #bda98c
//
// รอบนี้คีย์ accent สองตัวได้ความหมายจริงคืนมา: "gold" คือทองอำพัน (ตัว R กับคำว่า
// Rosty บนเหรียญโลโก้) และ "silver" คือเงินโครเมียม (เลข 59) ซึ่งเป็นสีที่สองของ
// แบรนด์นี้จริงๆ ไม่ใช่ทองที่สว่างขึ้นหนึ่งขั้นเหมือนรอบก่อน
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history)
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isGold = item.accent !== "silver";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#4a2f0d]/60 bg-[#150e07]/70 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isGold
              ? "hover:border-[#f2a01a]/60 hover:bg-[#26180a] hover:shadow-[0_10px_20px_rgba(242,160,26,0.18)]"
              : "hover:border-[#dbe1e8]/60 hover:bg-[#26180a] hover:shadow-[0_10px_20px_rgba(219,225,232,0.16)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold
                ? "border border-[#f2a01a]/50 bg-gradient-to-br from-[#f2a01a] to-[#6b3f07] shadow-[0_0_15px_rgba(242,160,26,0.45)] group-hover:rotate-3"
                : "border border-[#dbe1e8]/50 bg-gradient-to-br from-[#a3adba] to-[#5d6773] shadow-[0_0_15px_rgba(219,225,232,0.35)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <h3
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isGold ? "bg-gradient-to-r from-[#ffeec2] to-[#f2a01a] bg-clip-text text-transparent" : "bg-gradient-to-r from-[#dbe1e8] to-[#a3adba] bg-clip-text text-transparent"
              }`}>
              {item.title}
            </h3>
            <p class="text-left text-base leading-relaxed text-[#bda98c] transition-colors group-hover:text-[#ece0cc]">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
