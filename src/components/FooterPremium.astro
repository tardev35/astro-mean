---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// TITANWIN168: ย้ายจากทองสว่างคู่เงินโครเมียมของแบรนด์ก่อน มาเป็นม่วงไททันคู่มงกุฎ
// ทองของแบรนด์นี้ — ม่วง #a855f7 / #c084fc / #ede4ff / #7c3aed / #6d28d9 / #3b0d73
// คู่ทองมงกุฎ #e3c176 / #f2dda3 / #a9803a และโครเมียมเงิน #dfe4f0 / #b9c0d0 บนผิว
// #07030f / #160a2b / #22104a เนื้อความ #ddd2f5
//
// TITANWIN168 เป็นเว็บสล็อต หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ (อยู่ใน
// src/pages-disabled/) ห้ามมีลิงก์ถึงทั้งสองหน้าในไฟล์นี้
//
// บล็อก <address> ด้านล่างคัดมาตามต้นฉบับใน SKILL.md แบบไม่แต่งสี — border-white/15
// กับ bg-black/20 ลงตัวกับ footer ทุก variant ในคลัง (มืดหมด) การพิมพ์สีแบรนด์ทับ
// ไม่ได้อะไรเพิ่ม และเป็นทางที่ทำให้ hex ของแบรนด์ก่อนค้างในรอบถัดไป
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#a855f7]/40 bg-[#07030f] pt-16 pb-8 font-sans text-[#ddd2f5] shadow-[0_-15px_40px_rgba(168,85,247,0.26)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#6d28d9]/45 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ TITANWIN168 ตัวอักษรโลหะโครเมียมเงินทรงเหลี่ยมคมแบบตราศึกอ่านว่า TITANWIN มีมงกุฎทองประดับอัญมณีสีม่วงวางอยู่ด้านบนตรงกลาง ขนาบด้วยปีกโลหะสีดำเงาขอบม่วงแผ่ออกสองข้าง ใต้ตัวอักษรเป็นเลข 168 สีเงินไล่เป็นม่วง"
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(168,85,247,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#dfe4f0] to-[#8d93a8] bg-clip-text text-4xl font-black tracking-widest text-transparent">
                TITANWIN<span class="bg-gradient-to-r from-[#f2dda3] to-[#a9803a] bg-clip-text text-transparent">168</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#a855f7]/50 pl-4 text-sm leading-relaxed text-[#ddd2f5]/75">
          TITANWIN168 เว็บตรง API แท้ ยิงสัญญาณตรงจากเซิร์ฟเวอร์หลักโดยไม่ผ่านเอเย่นต์ คัดสรรเกมสล็อตแตกง่ายที่อัตราจ่าย RTP ยุติธรรมตรงตามสเปกโรงงาน
          คลังเกมคัดเกรดจากค่ายชั้นนำอย่าง PG Soft, Pragmatic Play และ Joker Gaming มีให้เลือกครบทุกสไตล์ สลับค่ายได้อิสระด้วยกระเป๋าเดียวไม่ต้องโยกเงิน
          ระบบการเงินฝากถอนออโต้ทันใจไว 3 วิ ประมวลผลผ่าน Gateway ตรง ไม่ต้องส่งสลิปและไม่ต้องรอคิวอนุมัติ ถอนเงินออกได้เต็มจำนวนทุกยอดตลอด 24 ชั่วโมง
        </p>
        <div class="mt-4 flex gap-3">
          <span class="rounded-full border border-[#dfe4f0]/40 bg-[#22104a]/60 px-4 py-1 text-xs font-medium text-[#ddd2f5] backdrop-blur-sm">เกมคัดเกรด ค่ายชั้นนำ</span>
          <span class="rounded-full border border-[#e3c176]/35 bg-[#e3c176]/10 px-4 py-1 text-xs font-medium text-[#f2dda3] backdrop-blur-sm">AUTO 3 SEC</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#dfe4f0] uppercase drop-shadow-sm">QUICK LINKS</p>
        <div class="h-[1px] w-12 bg-[#a855f7]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#ddd2f5]/70">
          <li><a href="/" class="transition-colors hover:text-[#c084fc]">หน้าหลัก (Home)</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#c084fc]">โปรโมชั่น (Promotions)</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#c084fc]">ทางเข้า (Access)</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#c084fc]">ทดลองเล่น (Demo)</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#c084fc]">เกี่ยวกับเรา (About Us)</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#c084fc]">ติดต่อเรา (Contact)</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#c084fc]">สมัครสมาชิก (Join Us)</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#c084fc]">เข้าสู่ระบบ (Login)</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#dfe4f0] uppercase drop-shadow-sm">CUSTOMER SUPPORT</p>
        <div class="h-[1px] w-12 bg-[#a855f7]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#e3c176]/80 uppercase">Supported Payments</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#a855f7]/30 pt-8 text-xs font-medium tracking-wide text-[#ddd2f5]/55 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} TITANWIN168. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#c084fc]">TERMS &amp; CONDITIONS</a>
        <a href="/privacy/" class="transition-colors hover:text-[#c084fc]">PRIVACY POLICY</a>
      </div>
    </div>
  </div>
</footer>
