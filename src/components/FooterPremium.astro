---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// JAICHUA: ย้ายจากทองคำคู่แดงเลือดหมูบนดำอมน้ำตาลของแบรนด์ก่อนที่เคยใช้ footer
// ตัวนี้ มาเป็นทองคำคู่น้ำเงินรอยัลบนกรมท่าเกือบดำ — ทอง #fbeec9 / #f6d67e /
// #d8a83f / #a97722 / #6d4a12 คู่น้ำเงิน #cfe0fb / #5b8ede / #2f5fb0 / #16336b
// บนผิว #040915 / #0a1226 / #132244 เนื้อความ #dce6f8
//
// อาร์ตเวิร์กรอบนี้เป็นป้ายทองคำบนโล่น้ำเงินกรมท่า: ตัวอักษร จ่ายชัวร์888 กับ
// JAI CHUA เป็นทองคำนูนทั้งชุด ดาวเข็มทิศด้านบนและเหรียญจีนสองข้างก็ทอง ส่วนโล่
// ที่รองตัวอักษรและฉากหลังแบนเนอร์เป็นน้ำเงินกรมท่า — ทองจึงเป็นสีนำ น้ำเงินเป็น
// สีที่สองจริง ไม่ใช่แค่เงาของทอง
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// JAICHUA เป็นเว็บสล็อต หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ (อยู่ใน
// src/pages-disabled/) ห้ามมีลิงก์ถึงทั้งสองหน้าในไฟล์นี้
//
// โลโก้ตรง fallback เป็น <p>/<span> ไม่ใช่หัวข้อ และป้ายหัวคอลัมน์ก็เป็น <p> —
// chrome ห้ามกินแท็กหัวข้อ เพราะรายการ h1/h2 ของทุกหน้าถูก diff กับหัวข้อใน docx
// ตอน verify และ footer ขึ้นทุกหน้า
//
// บล็อก <address> ด้านล่างคัดมาตามต้นฉบับใน SKILL.md แบบไม่แต่งสี — border-white/15
// กับ bg-black/20 ลงตัวกับ footer ทุก variant ในคลัง (มืดหมด) การพิมพ์สีแบรนด์ทับ
// ไม่ได้อะไรเพิ่ม และเป็นทางที่ทำให้ hex ของแบรนด์ก่อนค้างในรอบถัดไป ที่อยู่กับ
// อีเมลมาจาก BRAND_ADDRESS ซึ่งผูกกับ BRAND_NAME และ site: ห้ามพิมพ์ทับเอง

const LOGO_ALT =
  "โลโก้ JAICHUA เป็นป้ายทองคำสามมิติบนโล่สีน้ำเงินกรมท่า ตัวอักษรไทยทองนูนอ่านว่า จ่ายชัวร์888 ใต้ลงมาเป็นตัวอักษรละติน JAI CHUA คั่นกลางด้วยดาวประกายทอง และแถบล่างสุดเขียนว่า CASINO ONLINE ด้านบนป้ายเป็นดาวเข็มทิศทองบนวงกลมน้ำเงิน มุมล่างสองข้างเป็นเหรียญจีนทองรูสี่เหลี่ยม";
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#d8a83f]/40 bg-[#040915] pt-16 pb-8 font-sans text-[#dce6f8] shadow-[0_-15px_40px_rgba(216,168,63,0.22)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#16336b]/55 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={LOGO_ALT}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(216,168,63,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#fbeec9] to-[#a97722] bg-clip-text text-3xl font-black tracking-widest text-transparent">
                JAI<span class="bg-gradient-to-r from-[#cfe0fb] to-[#2f5fb0] bg-clip-text text-transparent">CHUA</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#2f5fb0]/60 pl-4 text-sm leading-relaxed text-[#dce6f8]/75">
          JAICHUA สล็อตเว็บตรง API แท้ ยิงตรงจากคลังเกมหลัก ไม่ผ่านเอเย่นต์ การันตีอัตราการจ่ายเงินรางวัลตามมาตรฐานสากล ค่า RTP ตรงตามสเปกโรงงาน ชนะเท่าไหร่ถอนได้เท่านั้น ไม่มีหมกเม็ด ไม่ล็อกยูส
          ปั่นได้สบายใจด้วยระบบฝากถอนออโต้ไฮสปีด ทำรายการไวใน 3 วินาที รองรับทั้งธนาคารและ TrueMoney Wallet ยอดเงินอัปเดตเข้าเกมทันที จ่ายจริงจ่ายไว สมชื่อจ่ายชัวร์แบบไม่ต้องเดา
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#d8a83f]/40 bg-[#132244]/70 px-4 py-1 text-xs font-medium text-[#f6d67e] backdrop-blur-sm">เว็บตรง API แท้ 100%</span>
          <span class="rounded-full border border-[#2f5fb0]/45 bg-[#2f5fb0]/12 px-4 py-1 text-xs font-medium text-[#5b8ede] backdrop-blur-sm">ออโต้ไว 3 วินาที</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#f6d67e] uppercase drop-shadow-sm">QUICK LINKS</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#2f5fb0] to-[#d8a83f]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#dce6f8]/70">
          <li><a href="/" class="transition-colors hover:text-[#f6d67e]">หน้าหลัก (Home)</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#f6d67e]">โปรโมชั่น (Promotions)</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#f6d67e]">ทางเข้า (Access)</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#f6d67e]">ทดลองเล่น (Demo)</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#f6d67e]">เกี่ยวกับเรา (About Us)</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#f6d67e]">ติดต่อเรา (Contact)</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#f6d67e]">สมัครสมาชิก (Join Us)</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#f6d67e]">เข้าสู่ระบบ (Login)</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#f6d67e] uppercase drop-shadow-sm">CUSTOMER SUPPORT</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#2f5fb0] to-[#d8a83f]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#a9b7d4] uppercase">Supported Payments</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#6d4a12]/80 pt-8 text-xs font-medium tracking-wide text-[#dce6f8]/55 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} JAICHUA. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#f6d67e]">TERMS &amp; CONDITIONS</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f6d67e]">PRIVACY POLICY</a>
        <a href="#top" class="transition-colors hover:text-[#f6d67e]">BACK TO TOP</a>
      </div>
    </div>
  </div>
</footer>
