---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// HAPPYSUPERWIN: ย้ายจากม่วงไททันคู่มงกุฎทองของแบรนด์ก่อน มาเป็นชมพูบานเย็นคู่
// เหลืองลูกกวาดบนพื้นองุ่นเข้มของแบรนด์นี้ — บานเย็น #e11ccc / #ff5ae6 / #8a1f9e /
// #4c0d6b คู่เหลืองลูกกวาด #ffd83d / #ffe98a / #f0b429 และเขียวมะนาว #a8e831 /
// #7dbd1f ที่มาจากคำว่า HAPPY ในโลโก้ บนผิว #0e0119 / #280747 / #380a5f
// เนื้อความ #f7e2ff
//
// อาร์ตเวิร์กรอบนี้เป็นธีมแดนลูกกวาด โลโก้เป็นตัวอักษรลูกกวาดสามมิติเขียวมะนาว
// คู่เหลืองส้มขอบม่วง (vivid ของโลโก้คือ #fdec6d / #fac442 / #facb44 = เหลือง)
// ส่วน slide1 ให้คู่ #fedb42 กับม่วง #3c0e94 และบานเย็น #eb34f9 — ม่วง/บานเย็น
// จึงเป็น "สีเน้น" จริง เหลืองกับเขียวเป็นสีคู่ ส่วน dominant ของแบนเนอร์ที่ออกมา
// เป็นชมพูอมเบจคือ "พื้น" ไม่ใช่สีเน้น palette.json จัดอันดับให้ แต่ไม่ตีความให้
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// HAPPYSUPERWIN เป็นเว็บสล็อต หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ (อยู่ใน
// src/pages-disabled/) ห้ามมีลิงก์ถึงทั้งสองหน้าในไฟล์นี้
//
// โลโก้ตรง fallback เป็น <p>/<span> ไม่ใช่หัวข้อ และป้ายหัวคอลัมน์ก็เป็น <p> —
// chrome ห้ามกินแท็กหัวข้อ เพราะรายการ h1/h2 ของทุกหน้าถูก diff กับหัวข้อใน docx
// ตอน verify และ footer ขึ้นทุกหน้า
//
// บล็อก <address> ด้านล่างคัดมาตามต้นฉบับใน SKILL.md แบบไม่แต่งสี — border-white/15
// กับ bg-black/20 ลงตัวกับ footer ทุก variant ในคลัง (มืดหมด) การพิมพ์สีแบรนด์ทับ
// ไม่ได้อะไรเพิ่ม และเป็นทางที่ทำให้ hex ของแบรนด์ก่อนค้างในรอบถัดไป ที่อยู่กับ
// อีเมลมาจาก BRAND_ADDRESS ซึ่งผูกกับ BRAND_NAME และ site: ห้ามพิมพ์ทับเอง

const LOGO_ALT =
  "โลโก้ HAPPYSUPERWIN คำว่า HAPPY เป็นตัวอักษรลูกกวาดสามมิติสีเขียวมะนาวเงาวาว วางเหลื่อมอยู่บนคำว่า SUPERWIN ตัวอักษรอ้วนกลมสีเหลืองไล่ส้ม ตัดขอบหนาสีม่วงสด มีอมยิ้มเกลียวสีรุ้งเสียบไม้อยู่มุมขวาบน";
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#e11ccc]/40 bg-[#0e0119] pt-16 pb-8 font-sans text-[#f7e2ff] shadow-[0_-15px_40px_rgba(225,28,204,0.26)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#8a1f9e]/45 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={LOGO_ALT}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(225,28,204,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#c6ff6e] to-[#7dbd1f] bg-clip-text text-3xl font-black tracking-widest text-transparent">
                HAPPY<span class="bg-gradient-to-r from-[#ffe98a] to-[#f0b429] bg-clip-text text-transparent">SUPERWIN</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#e11ccc]/50 pl-4 text-sm leading-relaxed text-[#f7e2ff]/75">
          HAPPYSUPERWIN สล็อตรวมตัวจี๊ด เว็บตรง API แท้ ยิงตรงจากเซิร์ฟนอกโดยไม่ผ่านเอเย่นต์ ค่า RTP เป็นมาตรฐานสากล ไม่มีปรับลดอัตราแตก
          คัดเฉพาะสล็อตตัวจี๊ดแตกง่ายจากค่ายใหญ่อย่าง PG Soft, Pragmatic Play และ Joker Gaming ให้สลับเล่นได้หลายแนวในกระเป๋าเดียวโดยไม่ต้องโยกเงิน
          พร้อมโบนัสฟรีที่กดรับสิทธิ์ได้เองไม่ต้องรอแอดมิน และระบบฝากถอนออโต้ที่ทำรายการเสร็จใน 3 วินาที ถอนเงินออกได้เต็มยอด ไร้เงื่อนไขจุกจิก
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#a8e831]/40 bg-[#380a5f]/60 px-4 py-1 text-xs font-medium text-[#c6ff6e] backdrop-blur-sm">เกมดังคัดมาดี ค่ายชั้นนำ</span>
          <span class="rounded-full border border-[#ffd83d]/35 bg-[#ffd83d]/10 px-4 py-1 text-xs font-medium text-[#ffe98a] backdrop-blur-sm">AUTO 3 SEC</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#a8e831] uppercase drop-shadow-sm">QUICK LINKS</p>
        <div class="h-[1px] w-12 bg-[#e11ccc]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#f7e2ff]/70">
          <li><a href="/" class="transition-colors hover:text-[#ff5ae6]">หน้าหลัก (Home)</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#ff5ae6]">โปรโมชั่น (Promotions)</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#ff5ae6]">ทางเข้า (Access)</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#ff5ae6]">ทดลองเล่น (Demo)</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#ff5ae6]">เกี่ยวกับเรา (About Us)</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#ff5ae6]">ติดต่อเรา (Contact)</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#ff5ae6]">สมัครสมาชิก (Join Us)</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#ff5ae6]">เข้าสู่ระบบ (Login)</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#a8e831] uppercase drop-shadow-sm">CUSTOMER SUPPORT</p>
        <div class="h-[1px] w-12 bg-[#e11ccc]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#ffd83d]/80 uppercase">Supported Payments</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#e11ccc]/30 pt-8 text-xs font-medium tracking-wide text-[#f7e2ff]/55 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} HAPPYSUPERWIN. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ff5ae6]">TERMS &amp; CONDITIONS</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ff5ae6]">PRIVACY POLICY</a>
        <a href="#top" class="transition-colors hover:text-[#ff5ae6]">BACK TO TOP</a>
      </div>
    </div>
  </div>
</footer>
