---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#f670b7]/40 bg-[#12060f] pt-16 pb-8 font-sans text-white shadow-[0_-15px_40px_rgba(246,112,183,0.26)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#e01e83]/20 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ PODK888 ตัวการ์ตูนสาวผมชมพูสวมหูฟังเกมมิ่งบนโล่สีดำ พร้อมตัวอักษร PODK สีขาวและเลข 888 สีชมพูนีออน"
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(246,112,183,0.4)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#fed0b9] to-[#f670b7] bg-clip-text text-4xl font-black tracking-widest text-transparent">
                PODK<span class="bg-gradient-to-r from-[#f670b7] to-[#e01e83] bg-clip-text text-transparent">888</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#f670b7]/50 pl-4 text-sm leading-relaxed text-[#f3d7e7]/65">
          PODK888 เว็บตรงเกมครบทุกสาย รวมสล็อต บาคาร่า และคาสิโนสดไว้ในแพลตฟอร์มเดียว ไม่ต้องสลับเว็บให้เสียเวลา คัดเฉพาะค่ายแท้ภาพคมชัด พร้อมระบบใหม่โอนไวที่ทำรายการฝากถอนได้ในไม่กี่วินาที
          เข้าเล่นผ่านมือถือได้ทันทีโดยไม่ต้องดาวน์โหลด
        </p>
        <div class="mt-4 flex gap-3">
          <span class="rounded-full border border-[#f670b7]/30 bg-[#e01e83]/25 px-4 py-1 text-xs font-medium text-[#f670b7] backdrop-blur-sm">ONE WALLET</span>
          <span class="rounded-full border border-[#02dbfd]/30 bg-[#02dbfd]/15 px-4 py-1 text-xs font-medium text-[#02dbfd] backdrop-blur-sm">AUTO 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-white uppercase drop-shadow-sm">QUICK LINKS</p>
        <div class="h-[1px] w-12 bg-[#f670b7]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#f3d7e7]/65">
          <li><a href="/" class="transition-colors hover:text-[#02dbfd]">หน้าหลัก (Home)</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#02dbfd]">โปรโมชั่น (Promotions)</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#02dbfd]">ทางเข้า (Access)</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#02dbfd]">ทดลองเล่น (Demo)</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#02dbfd]">เกี่ยวกับเรา (About Us)</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#02dbfd]">สมัครสมาชิก (Join Us)</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#02dbfd]">เข้าสู่ระบบ (Login)</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-white uppercase drop-shadow-sm">CUSTOMER SUPPORT</p>
        <div class="h-[1px] w-12 bg-[#f670b7]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        <div class="mt-4 text-xs font-medium tracking-widest text-[#f670b7]/60 uppercase">Supported Payments</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#f670b7]/30 pt-8 text-xs font-medium tracking-wide text-[#f3d7e7]/45 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} PODK888. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#02dbfd]">TERMS &amp; CONDITIONS</a>
        <a href="/privacy/" class="transition-colors hover:text-[#02dbfd]">PRIVACY POLICY</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
