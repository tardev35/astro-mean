---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#d41c6b]/40 bg-[#12010a] pt-16 pb-8 font-sans text-white shadow-[0_-15px_40px_rgba(212,28,107,0.26)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#9e154a]/35 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ GALA89 ตัวอักษร GALA89 สีขาวลายกรันจ์ขอบดำหนา ด้านหน้าเป็นรูปหกเหลี่ยมทรงลูกบาศก์สีทองที่มีหน้าสีชมพูบานเย็น"
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(212,28,107,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#ffe6f2] to-[#d41c6b] bg-clip-text text-4xl font-black tracking-widest text-transparent">
                GALA<span class="bg-gradient-to-r from-[#d41c6b] to-[#9e154a] bg-clip-text text-transparent">89</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#d41c6b]/50 pl-4 text-sm leading-relaxed text-[#f9a8cd]/75">
          GALA89 สล็อตทรงท็อปอันดับ 1 ที่รวบรวมเกมสล็อตลิขสิทธิ์แท้ส่งตรงจากค่ายยักษ์ใหญ่ไว้ในล็อบบี้เดียว ทั้งตัวเด็ดตัวฮิตจากต่างประเทศและเกมสไตล์เอเชียยอดนิยม
          มาพร้อมฟีเจอร์โบนัสจัดเต็ม ทั้งฟรีสปิน ตัวคูณรางวัลสะสม และสัญลักษณ์พิเศษ ระบบประมวลผลระดับไฮสปีดตอบสนองทันจังหวะ ฝากถอนออโต้โอนไวใส่ใจทุกยอด
          พร้อมระบบปกป้องข้อมูลสมาชิกขั้นสูงในทุกขั้นตอนการใช้งาน
        </p>
        <div class="mt-4 flex gap-3">
          <span class="rounded-full border border-[#d41c6b]/40 bg-[#3c0214]/60 px-4 py-1 text-xs font-medium text-[#f9a8cd] backdrop-blur-sm">LICENSED 100%</span>
          <span class="rounded-full border border-[#f0c274]/35 bg-[#f0c274]/10 px-4 py-1 text-xs font-medium text-[#f0c274] backdrop-blur-sm">AUTO 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-white uppercase drop-shadow-sm">QUICK LINKS</p>
        <div class="h-[1px] w-12 bg-[#d41c6b]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#f9a8cd]/70">
          <li><a href="/" class="transition-colors hover:text-[#ffe0a3]">หน้าหลัก (Home)</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#ffe0a3]">โปรโมชั่น (Promotions)</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#ffe0a3]">ทางเข้า (Access)</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#ffe0a3]">ทดลองเล่น (Demo)</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#ffe0a3]">เกี่ยวกับเรา (About Us)</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#ffe0a3]">ติดต่อเรา (Contact)</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#ffe0a3]">สมัครสมาชิก (Join Us)</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#ffe0a3]">เข้าสู่ระบบ (Login)</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-white uppercase drop-shadow-sm">CUSTOMER SUPPORT</p>
        <div class="h-[1px] w-12 bg-[#d41c6b]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#d41c6b]/80 uppercase">Supported Payments</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#d41c6b]/30 pt-8 text-xs font-medium tracking-wide text-[#f9a8cd]/55 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} GALA89. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ffe0a3]">TERMS &amp; CONDITIONS</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffe0a3]">PRIVACY POLICY</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
