---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ROSTY59: ย้ายจากชมพูบานเย็นคู่เหลืองลูกกวาดบนพื้นองุ่นเข้มของแบรนด์ก่อนที่เคยใช้
// footer ตัวนี้ มาเป็นทองอำพันออกส้มคู่โครเมียมเงินบนดำสนิท — ทอง #ffeec2 /
// #ffc94a / #f2a01a / #b06a0d / #6b3f07 คู่เงิน #dbe1e8 / #a3adba / #5d6773
// บนผิว #070505 / #150e07 / #26180a ขอบ #4a2f0d เนื้อความ #ece0cc
//
// อาร์ตเวิร์กรอบนี้เป็นเหรียญทองนูนบนดำสนิท: โลโก้เป็นตัว R ทองคำสามมิติในวงแหวน
// ทอง คำว่า Rosty เป็นทอง ส่วนเลข 59 เป็นโครเมียมเงิน (vivid ของโลโก้เด่นสุดคือ
// #cc841d ทองอำพันออกส้ม) เงินจึงเป็นสีที่สองจริง ไม่ใช่แค่เงาของทอง ส่วนค่า
// dominant ของทุกไฟล์เป็นดำอมน้ำตาลซึ่งคือ "พื้น" — palette.json จัดอันดับให้
// แต่ไม่ตีความให้
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// ROSTY59 เป็นเว็บสล็อต หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ (อยู่ใน
// src/pages-disabled/) ห้ามมีลิงก์ถึงทั้งสองหน้าในไฟล์นี้
//
// โลโก้ตรง fallback เป็น <p>/<span> ไม่ใช่หัวข้อ และป้ายหัวคอลัมน์ก็เป็น <p> —
// chrome ห้ามกินแท็กหัวข้อ เพราะรายการ h1/h2 ของทุกหน้าถูก diff กับหัวข้อใน docx
// ตอน verify และ footer ขึ้นทุกหน้า
//
// บล็อก <address> ด้านล่างคัดมาตามต้นฉบับใน SKILL.md แบบไม่แต่งสี — border-white/15
// กับ bg-black/20 ลงตัวกับ footer ทุก variant ในคลัง (มืดหมด) การพิมพ์สีแบรนด์ทับ
// ไม่ได้อะไรเพิ่ม และเป็นทางที่ทำให้ hex ของแบรนด์ก่อนค้างในรอบถัดไป ที่อยู่กับ
// อีเมลมาจาก BRAND_ADDRESS ซึ่งผูกกับ BRAND_NAME และ site: ห้ามพิมพ์ทับเอง

const LOGO_ALT =
  "โลโก้ ROSTY59 เป็นเหรียญกลมขอบทองคำนูนบนพื้นดำ กลางเหรียญเป็นตัว R ทองคำสามมิติขนาดใหญ่ ใต้ลงมาเป็นคำว่า Rosty ตัวอักษรทองคำเอียงต่อด้วยเลข 59 สีเงินโครเมียม ล่างสุดเป็นปีกรูปตัววีสีทอง";
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#f2a01a]/40 bg-[#070505] pt-16 pb-8 font-sans text-[#ece0cc] shadow-[0_-15px_40px_rgba(242,160,26,0.22)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#6b3f07]/50 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={LOGO_ALT}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(242,160,26,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#ffeec2] to-[#b06a0d] bg-clip-text text-3xl font-black tracking-widest text-transparent">
                ROSTY<span class="bg-gradient-to-r from-[#dbe1e8] to-[#5d6773] bg-clip-text text-transparent">59</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#f2a01a]/50 pl-4 text-sm leading-relaxed text-[#ece0cc]/75">
          ROSTY59 สล็อตเว็บตรงฟอร์มแรง สัญญาณ API แท้เชื่อมตรงเซิร์ฟนอกโดยไม่ผ่านเอเย่นต์ ค่า RTP ตรงตามมาตรฐานสากลจากค่ายแม่ ไม่มีปรับลดเปอร์เซ็นต์ชนะ ไร้ประวัติล็อกยูส
          คัดเฉพาะเกมสล็อตลิขสิทธิ์แท้จากค่ายยักษ์ใหญ่อย่าง PG Soft, Pragmatic Play และ Joker Gaming จัดคลังเป็นหมวดหมู่ให้ค้นหาง่าย เปลี่ยนสไตล์การเล่นได้ในกระเป๋าเดียวโดยไม่ต้องโยกเงิน
          พร้อมโปรที่กดรับสิทธิ์เองผ่านหน้าเว็บ และระบบฝากถอนออโต้ที่ทำรายการเสร็จใน 3 วินาที ถอนยอดไหนก็เงินเข้าเต็มจำนวนทันที
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#f2a01a]/40 bg-[#26180a]/70 px-4 py-1 text-xs font-medium text-[#ffc94a] backdrop-blur-sm">เกมแท้จัดเต็ม ค่ายดังลิขสิทธิ์</span>
          <span class="rounded-full border border-[#dbe1e8]/35 bg-[#dbe1e8]/10 px-4 py-1 text-xs font-medium text-[#dbe1e8] backdrop-blur-sm">AUTO 3 SEC</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#ffc94a] uppercase drop-shadow-sm">QUICK LINKS</p>
        <div class="h-[1px] w-12 bg-[#f2a01a]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#ece0cc]/70">
          <li><a href="/" class="transition-colors hover:text-[#ffc94a]">หน้าหลัก (Home)</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#ffc94a]">โปรโมชั่น (Promotions)</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#ffc94a]">ทางเข้า (Access)</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#ffc94a]">ทดลองเล่น (Demo)</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#ffc94a]">เกี่ยวกับเรา (About Us)</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#ffc94a]">ติดต่อเรา (Contact)</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#ffc94a]">สมัครสมาชิก (Join Us)</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#ffc94a]">เข้าสู่ระบบ (Login)</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#ffc94a] uppercase drop-shadow-sm">CUSTOMER SUPPORT</p>
        <div class="h-[1px] w-12 bg-[#f2a01a]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#dbe1e8]/80 uppercase">Supported Payments</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#4a2f0d]/70 pt-8 text-xs font-medium tracking-wide text-[#ece0cc]/55 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} ROSTY59. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ffc94a]">TERMS &amp; CONDITIONS</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffc94a]">PRIVACY POLICY</a>
        <a href="#top" class="transition-colors hover:text-[#ffc94a]">BACK TO TOP</a>
      </div>
    </div>
  </div>
</footer>
