---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// ASHTON168: ย้ายจากเขียวมรกตคู่ทองของแบรนด์ก่อน มาเป็นทองสว่างคู่เงินโครเมียม
// ของแบรนด์นี้ — ทอง #f5c518 / #ffd75e / #ffe9a3 / #a87908 / #c8941a คู่เงิน
// #e2e5e9 / #f0f2f5 / #8d949c บนผิว #080502 / #160e03 / #2a1c06 เนื้อความ
// #f0e6d2 (วัดจาก palette.json: vivid ของโลโก้เป็นทอง #dbac1b ส่วน dominant
// ของแบนเนอร์กับสไลด์เป็นดำอมน้ำตาลเกือบสนิท)
//
// ASHTON168 เป็นเว็บสล็อต หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ (อยู่ใน
// src/pages-disabled/) ห้ามมีลิงก์ถึงทั้งสองหน้าในไฟล์นี้
//
// บล็อก <address> ด้านล่างคัดมาตามต้นฉบับใน SKILL.md แบบไม่แต่งสี — border-white/15
// กับ bg-black/20 ลงตัวกับ footer ทุก variant ในคลัง (มืดหมด) การพิมพ์สีแบรนด์ทับ
// ไม่ได้อะไรเพิ่ม และเป็นทางที่ทำให้ hex ของแบรนด์ก่อนค้างในรอบถัดไป
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#f5c518]/40 bg-[#080502] pt-16 pb-8 font-sans text-[#f0e6d2] shadow-[0_-15px_40px_rgba(245,197,24,0.26)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#a87908]/45 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ ASHTON168 ตัวอักษรโครเมียมเงินสามมิติ ขึ้นต้นด้วยตัว A ทรงจั่วคล้ายโพดำซ้อนกับตัว S สีทองเงาวาว ต่อด้วย HTON สีเงิน โดยตัว O มีข้าวหลามตัดสีทองอยู่ตรงกลาง ปิดท้ายด้วยเลข 168 สีทอง"
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(245,197,24,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#f0f2f5] to-[#8d949c] bg-clip-text text-4xl font-black tracking-widest text-transparent">
                ASHTON<span class="bg-gradient-to-r from-[#ffd75e] to-[#a87908] bg-clip-text text-transparent">168</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#f5c518]/50 pl-4 text-sm leading-relaxed text-[#f0e6d2]/75">
          ASHTON168 เว็บสล็อตที่วางโครงสร้างระบบหลังบ้านไว้แน่นหนา เชื่อมตรงเข้าเซิร์ฟเวอร์หลักของค่ายเกมชั้นนำ ทุกเกมจึงพร้อมรันได้ลื่นไหลไม่มีอาการกระตุกหรือหลุดกลางรอบโบนัส
          ล็อบบี้จัดหมวดหมู่เกมไว้ชัดเจน แยกตามค่ายและหมวดเกมยอดฮิต กดหาตัวที่ใช่เจอในไม่กี่คลิกโดยไม่ต้องค้นหลายรอบ
          ระบบออโต้ไฮสปีดดูแลการฝากถอนได้เองในไม่กี่วินาที ไม่ต้องส่งสลิปและไม่ต้องรอแอดมินอนุมัติ เปิดให้เข้าทำกำไรได้ตลอด 24 ชั่วโมง
        </p>
        <div class="mt-4 flex gap-3">
          <span class="rounded-full border border-[#e2e5e9]/40 bg-[#2a1c06]/60 px-4 py-1 text-xs font-medium text-[#f0e6d2] backdrop-blur-sm">ระบบแน่น เกมพร้อมรัน</span>
          <span class="rounded-full border border-[#f5c518]/35 bg-[#f5c518]/10 px-4 py-1 text-xs font-medium text-[#ffe9a3] backdrop-blur-sm">AUTO 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#f0f2f5] uppercase drop-shadow-sm">QUICK LINKS</p>
        <div class="h-[1px] w-12 bg-[#f5c518]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#f0e6d2]/70">
          <li><a href="/" class="transition-colors hover:text-[#ffd75e]">หน้าหลัก (Home)</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#ffd75e]">โปรโมชั่น (Promotions)</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#ffd75e]">ทางเข้า (Access)</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#ffd75e]">ทดลองเล่น (Demo)</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#ffd75e]">เกี่ยวกับเรา (About Us)</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#ffd75e]">ติดต่อเรา (Contact)</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#ffd75e]">สมัครสมาชิก (Join Us)</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#ffd75e]">เข้าสู่ระบบ (Login)</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#f0f2f5] uppercase drop-shadow-sm">CUSTOMER SUPPORT</p>
        <div class="h-[1px] w-12 bg-[#f5c518]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#f5c518]/80 uppercase">Supported Payments</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#f5c518]/30 pt-8 text-xs font-medium tracking-wide text-[#f0e6d2]/55 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} ASHTON168. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ffd75e]">TERMS &amp; CONDITIONS</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffd75e]">PRIVACY POLICY</a>
      </div>
    </div>
  </div>
</footer>
