---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#e4a434]/40 bg-[#150d04] pt-16 pb-8 font-sans text-white shadow-[0_-15px_40px_rgba(250,196,44,0.26)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#cc8425]/25 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ JUDTEM168 ตัวอักษร JT สีทองไล่เฉดส้ม มีวงแหวนทองโคจรพาดรอบตัวอักษร"
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(250,196,44,0.4)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#feeb33] to-[#e4a434] bg-clip-text text-4xl font-black tracking-widest text-transparent">
                JUDTEM<span class="bg-gradient-to-r from-[#e4a434] to-[#cc8425] bg-clip-text text-transparent">168</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#e4a434]/50 pl-4 text-sm leading-relaxed text-[#f3e3c4]/70">
          JUDTEM168 ทางเข้าเว็บสล็อตอันดับ 1 ที่รวมเกมลิขสิทธิ์แท้จากค่ายดังไว้ครบในที่เดียว เซิร์ฟเวอร์หลักและลิงก์สำรองพร้อมใช้งานตลอด 24 ชั่วโมง
          ฝากถอนออโต้ไม่มีขั้นต่ำ ประมวลผลไม่เกิน 3 วินาที ถอนได้ไม่อั้น ไม่จำกัดจำนวนครั้งต่อวัน และการันตีไม่ล็อคยูสเซอร์
        </p>
        <div class="mt-4 flex gap-3">
          <span class="rounded-full border border-[#e4a434]/40 bg-[#7a4a0d]/30 px-4 py-1 text-xs font-medium text-[#fac42c] backdrop-blur-sm">ONE WALLET</span>
          <span class="rounded-full border border-[#feeb33]/30 bg-[#feeb33]/10 px-4 py-1 text-xs font-medium text-[#feeb33] backdrop-blur-sm">AUTO 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-white uppercase drop-shadow-sm">QUICK LINKS</p>
        <div class="h-[1px] w-12 bg-[#e4a434]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#f3e3c4]/65">
          <li><a href="/" class="transition-colors hover:text-[#feeb33]">หน้าหลัก (Home)</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#feeb33]">โปรโมชั่น (Promotions)</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#feeb33]">ทางเข้า (Access)</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#feeb33]">ทดลองเล่น (Demo)</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#feeb33]">เกี่ยวกับเรา (About Us)</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#feeb33]">สมัครสมาชิก (Join Us)</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#feeb33]">เข้าสู่ระบบ (Login)</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-white uppercase drop-shadow-sm">CUSTOMER SUPPORT</p>
        <div class="h-[1px] w-12 bg-[#e4a434]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#e4a434]/70 uppercase">Supported Payments</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#e4a434]/30 pt-8 text-xs font-medium tracking-wide text-[#f3e3c4]/50 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} JUDTEM168. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#feeb33]">TERMS &amp; CONDITIONS</a>
        <a href="/privacy/" class="transition-colors hover:text-[#feeb33]">PRIVACY POLICY</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
