---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// `title` คือหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้รับหัวข้อ docx ของ
// section — ป้ายหัวคอลัมน์สองตัว (titleleft/titleright) ยังเป็น <p> เหมือนเดิม:
// มันตั้งชื่อแผง UI ไม่ใช่ section ของ docx ถ้าเลื่อนขึ้นเป็นหัวข้อ จำนวน h2 บนหน้า
// จะไม่ตรงกับ checklist ของ brief ซึ่งเป็นสิ่งที่ทำให้การตรวจรอบถัดไปเชื่อถือไม่ได้
//
// เมื่อส่ง `title` มาแล้ว หัวข้อทำหน้าที่ตั้งชื่อ section ให้เอง จึงไม่ต้องมี
// aria-label ซ้อนทับ ถ้าไม่มี title ให้ section ใช้ `label` เป็นชื่อแทน
//
// <div> ครอบ intro ข้างล่างเป็นหนึ่งในสามตัวของทั้งตระกูล ContentBox* ที่ต้องอยู่
// ต่อไป: มันถือ mb-8 จริงและวางอยู่ข้างกริด จึง hoist ขึ้นการ์ดไม่ได้ ห้ามแบนทิ้ง
//
// GEN4: ย้ายชุดสีของไฟล์นี้จากส้มไฟคู่ทองของแบรนด์ก่อน มาเป็นน้ำเงินอิเล็กทริกคู่
// แดงของแบรนด์นี้ที่วัดจากอาร์ตจริง — น้ำเงิน #0071d5 / #01a3f3 / #6fd2ff /
// #00408a บนผิว #0b1b3a / #050b1a เนื้อความ #d7e7ff หัวข้อ #eaf4ff ส่วนแดง
// #e8241c / #ff5a33 (สีของเลข 4 ในโลโก้) เป็นสีเน้นรองที่ถือเส้นมุมฝั่งล่างขวากับ
// ป้ายคอลัมน์ขวาเท่านั้น (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์
// เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น
// CSS ตาย ดูของเดิมได้จาก git history)
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#0071d5]/35 bg-[#0b1b3a]/92 p-8 text-[#d7e7ff] shadow-[0_10px_30px_rgba(0,113,213,0.22)] backdrop-blur-md transition-all duration-300 hover:border-[#01a3f3]/60 hover:shadow-[0_15px_40px_rgba(1,163,243,0.3)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#01a3f3] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#e8241c] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#01a3f3] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#e8241c] to-transparent"></div>

    {title && <HeadingTag class="mb-4 bg-gradient-to-r from-[#eaf4ff] via-[#6fd2ff] to-[#0071d5] bg-clip-text text-center text-2xl leading-normal font-black text-transparent">{title}</HeadingTag>}

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#d7e7ff]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#d7e7ff]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#0071d5]/35 pb-2 text-xl leading-normal font-black text-[#6fd2ff]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#01a3f3] shadow-[0_0_5px_rgba(1,163,243,0.8)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#d7e7ff] md:border-l md:border-[#0071d5]/35 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#e8241c]/35 pb-2 text-xl leading-normal font-black text-[#ff5a33]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#e8241c] shadow-[0_0_5px_rgba(232,36,28,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
