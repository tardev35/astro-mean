---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// `title` คือหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้รับหัวข้อ docx ของ
// section — ป้ายหัวคอลัมน์สองตัว (titleleft/titleright) ยังเป็น <p> เหมือนเดิม:
// มันตั้งชื่อแผง UI ไม่ใช่ section ของ docx ถ้าเลื่อนขึ้นเป็นหัวข้อ จำนวน h2 บนหน้า
// จะไม่ตรงกับ checklist ของ brief ซึ่งเป็นสิ่งที่ทำให้การตรวจรอบถัดไปเชื่อถือไม่ได้
//
// เมื่อส่ง `title` มาแล้ว หัวข้อทำหน้าที่ตั้งชื่อ section ให้เอง จึงไม่ต้องมี
// aria-label ซ้อนทับ ถ้าไม่มี title ให้ section ใช้ `label` เป็นชื่อแทน
//
// <div> ครอบ intro ข้างล่างเป็นหนึ่งในสามตัวของทั้งตระกูล ContentBox* ที่ต้องอยู่
// ต่อไป: มันถือ mb-8 จริงและวางอยู่ข้างกริด จึง hoist ขึ้นการ์ดไม่ได้
//
// AURORA688: ไฟล์นี้เป็นม่วงมาสองแบรนด์ติด (PHANTOM569 #ede9fe / #b794ff / #8b5cf6
// แล้ว GDK88 #a855f7 / #d8b4fe / #f3e8ff คู่ทองโลโก้ #f0b429 / #ffd85e บนผิว
// #1b0733 เนื้อความ #ece0ff) รอบนี้ย้ายมาทองหรูคู่เงินโครเมียม — สีเน้นหลัก
// #e2c443 / #ffe9a3 / #eef2f7 บนผิว #15120a เนื้อความ #f2ead6 และเงิน #c3cddb เป็น
// สีเน้นรองที่ถือเส้นมุมฝั่งล่างขวากับคอลัมน์ขวา ให้ตรงกับโลโก้ (AURORA ทอง / 688 เงิน)
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#e2c443]/30 bg-[#15120a]/92 p-8 text-[#f2ead6] shadow-[0_10px_30px_rgba(226,196,67,0.2)] backdrop-blur-md transition-all duration-300 hover:border-[#ffe9a3]/60 hover:shadow-[0_15px_40px_rgba(255,233,163,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#e2c443] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#c3cddb] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#e2c443] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#c3cddb] to-transparent"></div>

    {title && <HeadingTag class="mb-4 bg-gradient-to-r from-[#eef2f7] via-[#ffe9a3] to-[#c9a13a] bg-clip-text text-center text-2xl leading-normal font-black text-transparent">{title}</HeadingTag>}

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f2ead6]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2ead6]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#e2c443]/30 pb-2 text-xl leading-normal font-black text-[#ffe9a3]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#e2c443] shadow-[0_0_5px_rgba(226,196,67,0.8)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2ead6] md:border-l md:border-[#e2c443]/30 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#c3cddb]/30 pb-2 text-xl leading-normal font-black text-[#eef2f7]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#c3cddb] shadow-[0_0_5px_rgba(195,205,219,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
