---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// `title` คือหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้รับหัวข้อ docx ของ
// section — ป้ายหัวคอลัมน์สองตัว (titleleft/titleright) ยังเป็น <p> เหมือนเดิม:
// มันตั้งชื่อแผง UI ไม่ใช่ section ของ docx ถ้าเลื่อนขึ้นเป็นหัวข้อ จำนวน h2 บนหน้า
// จะไม่ตรงกับ checklist ของ brief ซึ่งเป็นสิ่งที่ทำให้การตรวจรอบถัดไปเชื่อถือไม่ได้
//
// เมื่อส่ง `title` มาแล้ว หัวข้อทำหน้าที่ตั้งชื่อ section ให้เอง จึงไม่ต้องมี
// aria-label ซ้อนทับ ถ้าไม่มี title ให้ section ใช้ `label` เป็นชื่อแทน
//
// <div> ครอบ intro ข้างล่างเป็นหนึ่งในสามตัวของทั้งตระกูล ContentBox* ที่ต้องอยู่
// ต่อไป: มันถือ mb-8 จริงและวางอยู่ข้างกริด จึง hoist ขึ้นการ์ดไม่ได้ ห้ามแบนทิ้ง
//
// ROOM89: ย้ายชุดสีของไฟล์นี้มาที่ทองคำขัดเงาคู่เงินแพลตินัมของแบรนด์นี้ — ทอง
// #f7edc4 / #e6cf72 / #c9a227 / #6b5424 บนผิว #161009 / #0b0805 เนื้อความ #f0e6cf
// ส่วนเงิน #e8ebef / #b9c2cc / #7c8794 เป็นโลหะที่สองที่ถือเส้นมุมฝั่งล่างขวากับ
// ป้ายคอลัมน์ขวา ตรงตามโลโก้ที่คำว่า ROOM เป็นทองและเลข 89 เป็นเงิน (ห้ามพิมพ์ hex
// ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์
// จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// รอบนี้ไฟล์นี้แบกหัวข้อ docx ข้อ 5 เรื่องฟีเจอร์น่าลองในแต่ละเกม แล้วต่อด้วย
// FeatureHighlights ที่กางสี่ฟีเจอร์ซึ่งย่อหน้าเดียวกันเอ่ยชื่อไว้
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#c9a227]/35 bg-[#161009]/92 p-8 text-[#f0e6cf] shadow-[0_10px_30px_rgba(201,162,39,0.22)] backdrop-blur-md transition-all duration-300 hover:border-[#e6cf72]/60 hover:shadow-[0_15px_40px_rgba(230,207,114,0.3)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#e6cf72] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#b9c2cc] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#e6cf72] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#b9c2cc] to-transparent"></div>

    {title && <HeadingTag class="mb-4 bg-gradient-to-r from-[#f7edc4] via-[#e6cf72] to-[#c9a227] bg-clip-text text-center text-2xl leading-normal font-black text-transparent">{title}</HeadingTag>}

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f0e6cf]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6cf]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#c9a227]/35 pb-2 text-xl leading-normal font-black text-[#e6cf72]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#c9a227] shadow-[0_0_5px_rgba(201,162,39,0.8)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e6cf] md:border-l md:border-[#c9a227]/35 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#b9c2cc]/35 pb-2 text-xl leading-normal font-black text-[#e8ebef]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#b9c2cc] shadow-[0_0_5px_rgba(185,194,204,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
