---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// `title` คือหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้รับหัวข้อ docx ของ
// section — เดิมมันถูก render เป็น <p> ตอนที่ variant นี้ถูกใช้เป็น widget แต่รอบ
// นี้มันแบกหัวข้อ docx จริง จึงเป็น HeadingTag เหมือนที่ ContentBoxTwo ทำ
//
// ป้ายหัวคอลัมน์สองตัว (titleleft/titleright) ยังเป็น <p> เหมือนเดิม: มันตั้งชื่อ
// แผง UI ไม่ใช่ section ของ docx ถ้าเลื่อนขึ้นเป็นหัวข้อ จำนวน h2 บนหน้าจะไม่ตรง
// กับ checklist ของ brief ซึ่งเป็นสิ่งที่ทำให้การตรวจรอบถัดไปเชื่อถือไม่ได้
//
// เมื่อส่ง `title` มาแล้ว หัวข้อทำหน้าที่ตั้งชื่อ section ให้เอง จึงไม่ต้องมี
// aria-label ซ้อนทับ ถ้าไม่มี title ให้ section ใช้ `label` เป็นชื่อแทน
//
// <div> ครอบ intro ข้างล่างเป็นหนึ่งในสามตัวของทั้งตระกูล ContentBox* ที่ต้องอยู่
// ต่อไป: มันถือ mb-8 จริงและวางอยู่ข้างกริด จึง hoist ขึ้นการ์ดไม่ได้
//
// SGD88: ย้ายจากทองมังกร + ไฟของ LONGSAP168 (#ffd76a / #f2b024 / #d81f26 กับ
// #ff4d2e บนผิว #170806 เนื้อความ #f6e4c8) มาที่ม่วงบานเย็นนีออน #f7d0ff /
// #e879f9 / #bc07e2 คู่ม่วงเข้ม #930ac5 / #4c0a6b บนผิว #1b0d2e เนื้อความ #f3e8ff
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#bc07e2]/30 bg-[#1b0d2e]/92 p-8 text-[#f3e8ff] shadow-[0_10px_30px_rgba(188,7,226,0.2)] backdrop-blur-md transition-all duration-300 hover:border-[#e879f9]/60 hover:shadow-[0_15px_40px_rgba(232,121,249,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#bc07e2] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#930ac5] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#bc07e2] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#930ac5] to-transparent"></div>

    {title && <HeadingTag class="mb-4 bg-gradient-to-r from-[#f7d0ff] via-[#e879f9] to-[#bc07e2] bg-clip-text text-center text-2xl leading-normal font-black text-transparent">{title}</HeadingTag>}

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f3e8ff]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e8ff]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#bc07e2]/30 pb-2 text-xl leading-normal font-black text-[#e879f9]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#e879f9] shadow-[0_0_5px_rgba(232,121,249,0.8)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e8ff] md:border-l md:border-[#bc07e2]/30 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#bc07e2]/30 pb-2 text-xl leading-normal font-black text-[#f7d0ff]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#bc07e2] shadow-[0_0_5px_rgba(188,7,226,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
