---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// `title` คือหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้รับหัวข้อ docx ของ
// section — ป้ายหัวคอลัมน์สองตัว (titleleft/titleright) ยังเป็น <p> เหมือนเดิม:
// มันตั้งชื่อแผง UI ไม่ใช่ section ของ docx ถ้าเลื่อนขึ้นเป็นหัวข้อ จำนวน h2 บนหน้า
// จะไม่ตรงกับ checklist ของ brief ซึ่งเป็นสิ่งที่ทำให้การตรวจรอบถัดไปเชื่อถือไม่ได้
//
// เมื่อส่ง `title` มาแล้ว หัวข้อทำหน้าที่ตั้งชื่อ section ให้เอง จึงไม่ต้องมี
// aria-label ซ้อนทับ ถ้าไม่มี title ให้ section ใช้ `label` เป็นชื่อแทน
//
// <div> ครอบ intro ข้างล่างเป็นหนึ่งในสามตัวของทั้งตระกูล ContentBox* ที่ต้องอยู่
// ต่อไป: มันถือ mb-8 จริงและวางอยู่ข้างกริด จึง hoist ขึ้นการ์ดไม่ได้ ห้ามแบนทิ้ง
//
// PABO88: ไฟล์นี้ถูกดึงกลับมาใช้งานตามการหมุน variant รอบนี้ (LoginRtpSection
// ย้ายจาก ContentBoxTwoPremium มาที่ตัวนี้) ของเดิมเป็นทองหรูคู่เงินโครเมียมของ
// AURORA688 รอบนี้ย้ายมาเป็นนีออนม่วง/ไวโอเล็ตคู่ทอง — ม่วง #bf3cfa / #e3b8ff /
// #8b1fd6 บนผิว #160333 เนื้อความ #ece0ff ส่วนทอง #f5c518 / #ffe9a3 เป็นสีเน้นรอง
// ที่ถือเส้นมุมฝั่งล่างขวากับป้ายหัวคอลัมน์ขวา (ค่า hex ของแบรนด์เก่าไม่พิมพ์ไว้
// ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก
// git history)
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#bf3cfa]/30 bg-[#160333]/92 p-8 text-[#ece0ff] shadow-[0_10px_30px_rgba(191,60,250,0.2)] backdrop-blur-md transition-all duration-300 hover:border-[#e3b8ff]/60 hover:shadow-[0_15px_40px_rgba(227,184,255,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#bf3cfa] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#f5c518] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#bf3cfa] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#f5c518] to-transparent"></div>

    {title && <HeadingTag class="mb-4 bg-gradient-to-r from-[#faf5ff] via-[#e3b8ff] to-[#f5c518] bg-clip-text text-center text-2xl leading-normal font-black text-transparent">{title}</HeadingTag>}

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#ece0ff]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece0ff]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#bf3cfa]/30 pb-2 text-xl leading-normal font-black text-[#e3b8ff]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#bf3cfa] shadow-[0_0_5px_rgba(191,60,250,0.8)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece0ff] md:border-l md:border-[#bf3cfa]/30 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#f5c518]/30 pb-2 text-xl leading-normal font-black text-[#ffe9a3]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#f5c518] shadow-[0_0_5px_rgba(245,197,24,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
