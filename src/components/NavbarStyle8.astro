---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// เมนูชุดเดียวใช้ทั้งแถบจอใหญ่และลิ้นชักมือถือ ไอคอนอยู่ในข้อมูลแล้ว render เป็น
// <span aria-hidden> ที่เป็นพี่น้องของข้อความ ไม่ใช่แทรกอยู่ในตัวข้อความ
//
// ลำดับ: หน้าแรก → โปรโมชั่น → (สมัคร/เข้าสู่ระบบ ถ้าเปิด cta toggle) → ที่เหลือ
// VIPSAND356 ปิด cta toggle (/login กับ /register ยังเป็นหน้า forward แบบ noindex)
// จึงไม่มีสองรายการนั้นในเมนู เหลือปุ่ม CTA มุมขวาตามที่ variant นี้วางไว้ และ
// /ทางเข้า ยังอยู่ในเมนูตามปกติ
//
// VIPSAND356 เป็นเว็บสล็อต หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ (อยู่ใน
// src/pages-disabled/) ห้ามมีลิงก์ถึง
//
// ไอคอนเลือกให้ตรงกับอาร์ตของแบรนด์ซึ่งเป็นคาสิโนริมทะเลกองเหรียญทอง — 🦈 คือ
// ฉลามสวมมงกุฎทองที่เป็นมาสคอตฝั่งขวาของแบนเนอร์ ใช้แทนหน้าเกี่ยวกับเรา 🎰 คือ
// ตู้สล็อตทองขึ้นเลข 777 ในแบนเนอร์ ใช้แทนหน้าทดลองเล่น 🎁 แทนหน้าโปรโมชั่น
// และ 🚪 แทนลิงก์ตรงทางเข้าเว็บหลัก
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🚪" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🦈" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];

// โลโก้ไม่ใส่ fetchpriority="high" — LCP ของทุกหน้าคือ hero banner ใน MainLayout
// ใส่ที่นี่ด้วยจะกลายเป็นสองรูปแย่ง priority สูงสุดกันในคำขอเดียว
const LOGO_ALT =
  "โลโก้ VIPSAND356 เป็นป้ายสามมิติในกรอบทองหนา พื้นในเป็นแผ่นไม้สีน้ำตาล ตัวอักษร VIP เป็นสีฟ้าใสไล่ขาวขอบเข้ม ใต้ลงมาเป็นคำว่า SANDS สีส้มทอง มีไพ่ข้าวหลามตัดกับไพ่ดอกจิกเสียบอยู่ที่ตัว D และล่างสุดเป็นเลข 356 สีฟ้าขาว ด้านบนกรอบมีอัญมณีทรงข้าวหลามตัดสีฟ้า ด้านล่างมีใบปาล์มเขียวและเหรียญทองวางประกอบสองข้าง";

// VIPSAND356: ย้ายจากม่วงลูกกวาดคู่บานเย็นและเขียวมะนาวของแบรนด์ที่เคยใช้แถบนี้
// มาเป็นฟ้าอะซูร์คู่ทองส้มบนกรมท่าเข้ม ตามโลโก้ที่คำว่า VIP เป็นฟ้าและ SANDS
// เป็นทองส้ม — ฟ้า #2a93e0 / #5dbcfe / #a2d2ef / #eaf6ff / #1465a8 / #0b3f70
// คู่ทอง #eba554 / #fcde61 / #c07c20 บนผิว #061c33 / #0a2b4a / #103a5f
// เนื้อความ #e6f2ff เมนูรอง #a2d2ef
// (วัดจาก palette.json: vivid ของ logo.webp คือ #4aa8eb คู่ #eba554 / #a2d2ef /
// #fcde61 ซึ่งเป็นสีเน้นจริงทั้งชุด ส่วน dominant ของ banner1 เป็นน้ำตาลเข้ม
// #54240c ซึ่งคือไม้กับเงาในฉาก ไม่ใช่สีแบรนด์ — palette.json จัดอันดับให้ แต่
// ไม่ได้ตีความให้)
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-40 w-full bg-[#061c33]/95 shadow-[0_4px_20px_rgba(6,28,51,0.7)] backdrop-blur-lg">
    <div class="bg-theme-oklab absolute bottom-0 left-0 h-[2px] w-full opacity-90"></div>

    <div class="flex h-[65px] w-full items-center justify-between px-3 md:px-6 lg:h-[80px]">
      <div class="flex items-center">
        <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={LOGO_ALT}
                loading="eager"
                widths={[130, 260, 390]}
                sizes="(max-width: 1023px) 100px, 130px"
                class="h-[35px] w-auto drop-shadow-[0_0_10px_rgba(42,147,224,0.55)] lg:h-[45px]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-b from-[#eaf6ff] via-[#5dbcfe] to-[#eba554] bg-clip-text text-xl font-black tracking-widest text-transparent">VIPSAND356</span>
            )
          }
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-7 lg:flex xl:gap-9">
        {
          links.map((link) => (
            <a href={link.path} class="group relative flex h-full items-center gap-2 text-sm font-bold transition-all xl:text-base">
              <span aria-hidden="true" class="absolute left-0 -ml-3 text-[#fcde61] opacity-0 transition-all duration-300 group-hover:-ml-4 group-hover:opacity-100">
                [
              </span>
              <span aria-hidden="true" class="text-base leading-none">
                {link.icon}
              </span>
              <span class={`transition-colors duration-300 ${isActive(link.path) ? "text-[#fcde61] drop-shadow-[0_0_8px_rgba(252,222,97,0.75)]" : "text-[#e6f2ff]/75 group-hover:text-[#5dbcfe]"}`}>
                {link.name}
              </span>
              <span aria-hidden="true" class="absolute right-0 -mr-3 text-[#fcde61] opacity-0 transition-all duration-300 group-hover:-mr-4 group-hover:opacity-100">
                ]
              </span>
              {isActive(link.path) && <div class="absolute bottom-0 left-0 h-[3px] w-full rounded-t-md bg-[#2a93e0] shadow-[0_-2px_10px_rgba(42,147,224,0.9)]" />}
            </a>
          ))
        }
      </div>

      <div class="z-50 flex items-center gap-2 md:gap-4">
        <a
          href="/login"
          class="hidden items-center justify-center rounded border border-[#2a93e0]/70 px-6 py-2 text-sm font-bold text-[#a2d2ef] transition-all hover:bg-[#2a93e0]/20 hover:shadow-[0_0_15px_rgba(42,147,224,0.45)] lg:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/register"
          class="bg-theme-gold hidden items-center justify-center rounded px-6 py-2 text-sm font-extrabold text-[#061c33] shadow-[0_0_20px_rgba(235,165,84,0.45)] transition-all hover:brightness-110 lg:flex">
          สมัครสมาชิก
        </a>

        <div class="flex items-center gap-2 lg:hidden">
          <a
            href="/register"
            class="bg-theme-gold flex items-center justify-center rounded px-3 py-1.5 text-[11px] font-bold text-[#061c33] shadow-[0_0_10px_rgba(235,165,84,0.45)] md:px-4 md:text-xs">
            สมัครสมาชิก
          </a>
          <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 rounded border border-[#2a93e0]/50 bg-[#2a93e0]/10 p-1.5" aria-label="เปิดเมนู">
            <span class="hamburger-line h-[2px] w-5 origin-center rounded-full bg-[#fcde61] transition-all duration-300"></span>
            <span class="hamburger-line h-[2px] w-5 rounded-full bg-[#fcde61] transition-all duration-300"></span>
            <span class="hamburger-line h-[2px] w-5 origin-center rounded-full bg-[#fcde61] transition-all duration-300"></span>
          </button>
        </div>
      </div>
    </div>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-40 bg-[#061c33]/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-50 h-screen w-[260px] translate-x-full transform overflow-y-auto border-l border-[#2a93e0]/45 bg-[#061c33] shadow-[-10px_0_30px_rgba(6,28,51,0.9)] transition-transform duration-400 ease-[cubic-bezier(0.3,1,0.3,1)] lg:hidden">
    <div class="flex items-center justify-between border-b border-[#a2d2ef]/10 px-5 py-5">
      <span class="text-sm font-extrabold tracking-wider text-[#e6f2ff]">MENU</span>
      <button id="close-sidebar-btn" class="p-1 text-xl text-[#fcde61] hover:text-[#eaf6ff]" aria-label="ปิดเมนู">✕</button>
    </div>

    <div class="flex flex-col space-y-2 px-4 pt-4 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center rounded-lg border px-4 py-3.5 transition-all ${isActive(link.path) ? "border-[#2a93e0]/60 bg-[#2a93e0]/20 text-[#fcde61]" : "border-transparent bg-[#103a5f]/45 text-[#e6f2ff]/75 hover:bg-[#103a5f]/70"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }

      <div class="mt-6 flex flex-col gap-3 border-t border-[#2a93e0]/40 pt-6">
        <a
          href="/login"
          class="sidebar-item hover:bg-theme-gold flex items-center justify-center gap-2 rounded-lg border border-[#fcde61]/70 bg-transparent py-3.5 text-sm font-bold text-[#a2d2ef] transition-colors hover:border-transparent hover:text-[#061c33]">
          <span aria-hidden="true">🔒</span> เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  .bg-theme-oklab {
    background-image: linear-gradient(in oklab to right, #0b3f70, #2a93e0, #eba554);
  }

  .bg-theme-gold {
    background-image: linear-gradient(in oklab to right, #fcde61, #eba554, #c07c20);
  }

  .hover\:bg-theme-gold:hover {
    background-image: linear-gradient(in oklab to right, #fcde61, #eba554, #c07c20);
  }

  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.3s cubic-bezier(0.3, 1, 0.3, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }
  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const closeBtn = document.getElementById("close-sidebar-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleSidebar = () => {
    hamburgerBtn?.classList.toggle("active");

    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");

    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleSidebar);
  closeBtn?.addEventListener("click", toggleSidebar);
  overlay?.addEventListener("click", toggleSidebar);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleSidebar();
      }
    });
  });
</script>
