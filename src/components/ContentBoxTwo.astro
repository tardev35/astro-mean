---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// AM88K: ย้ายจากฟ้านีออนใต้ทะเลคู่ทองของ ORCA789 มาเป็นเขียวมิ้นต์คู่ทองของแบรนด์
// นี้ — มิ้นต์ #8cdcad / #d6fbe8 / #4cb783 / #1d6f47 คู่ทอง #e4b314 / #f3db6b /
// #a8790a / #5d440a บนผิว #08200f / #04120a ขอบ/แถบยก #0e3319 เนื้อความ #e6f6ec
// หมึกบนพื้นสว่าง #04120a (ค่า hex ของแบรนด์เก่าไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกน
// ไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history)
//
// มิ้นต์เป็นสีหลักของโลโก้ (ตัวอักษร Am) ส่วนทองเป็นสีเน้นรอง (มงกุฎ ตัว k ปุ่ม CTA)
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้ให้บล็อกนี้แบก
// section ของ docx ได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น <p>: มันตั้งชื่อแผง UI (ฟอร์ม
// เข้าสู่ระบบ, ตารางอ้างอิง) ไม่ใช่ section ของ docx การเลื่อนขึ้นเป็นหัวข้อจะเพิ่ม
// ระดับหัวข้อที่ brief ไม่เคยขอ
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ ถ้าไม่มี
// title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");

// ใส่ chrome ของการ์ดเฉพาะตอนบล็อกนี้แบก section ของ docx (`title`) เท่านั้น เวลา
// ถูกใช้เป็นโครงสองคอลัมน์เปล่าๆ — LoginRtpSection ส่งแผงของตัวเองเข้า slot —
// คอลัมน์จะแบนราบไว้ ไม่งั้นหน้าเว็บจะได้การ์ดซ้อนการ์ด
const columnBase = "flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6f6ec]";
const columnCard =
  "rounded-3xl border border-[#8cdcad]/25 bg-[#08200f]/88 p-6 shadow-[0_10px_30px_rgba(140,220,173,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#8cdcad]/50 hover:shadow-[0_15px_40px_rgba(76,183,131,0.32)] md:p-8";
const columnClass = title ? `${columnBase} ${columnCard}` : columnBase;
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#8cdcad]/30 pb-4">
        <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f3db6b] via-[#e4b314] to-[#4cb783] shadow-[0_0_10px_rgba(228,179,20,0.55)]" />
        <HeadingTag class="bg-gradient-to-r from-[#f4fdf8] via-[#d6fbe8] to-[#8cdcad] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class={columnClass}>
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#e4b314]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#f3db6b] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e4b314]/55 bg-gradient-to-br from-[#e4b314] via-[#a8790a] to-[#0e3319] text-sm text-[#f4fdf8] shadow-[0_5px_15px_rgba(228,179,20,0.4)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class={columnClass}>
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#4cb783]/35 pb-3 text-xl leading-normal font-black tracking-widest text-[#8cdcad] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#8cdcad]/60 bg-gradient-to-br from-[#8cdcad] via-[#4cb783] to-[#1d6f47] text-sm text-[#f4fdf8] shadow-[0_5px_15px_rgba(76,183,131,0.4)]">
              💎
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
