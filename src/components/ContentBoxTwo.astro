---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// IOK66: ย้ายจากทองเข้ม + ไฟมังกรของแบรนด์ก่อน (#ffd76a / #f2b024 / #a86a0c คู่กับ
// #ff4d2e / #d81f26 / #7d0508 บนผิว #170806 / #24100c / #0a0402 เนื้อความ
// #f6e4c8 ข้อความรอง #e3c9ab) มาที่ทองหลวง + แดงชาด — #ffe9a3 / #f0cd6a /
// #e3b64a / #b8862c / #5c3a10 คู่กับ #a3161c / #5c0a0c บนผิว #1c110a / #150c07 /
// #0d0705 เนื้อความ #f2e2c4 ข้อความรอง #ddc8a4 หมึกบนพื้นทอง #0d0705
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้ให้บล็อกนี้แบก
// section ของ docx ได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น <p>: มันตั้งชื่อแผง UI (ฟอร์ม
// เข้าสู่ระบบ, ตารางอ้างอิง) ไม่ใช่ section ของ docx การเลื่อนขึ้นเป็นหัวข้อจะเพิ่ม
// ระดับหัวข้อที่ brief ไม่เคยขอ
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ ถ้าไม่มี
// title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");

// ใส่ chrome ของการ์ดเฉพาะตอนบล็อกนี้แบก section ของ docx (`title`) เท่านั้น เวลา
// ถูกใช้เป็นโครงสองคอลัมน์เปล่าๆ — LoginRtpSection ส่งแผงของตัวเองเข้า slot —
// คอลัมน์จะแบนราบไว้ ไม่งั้นหน้าเว็บจะได้การ์ดซ้อนการ์ด
const columnBase = "flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2e2c4]";
const columnCard =
  "rounded-3xl border border-[#e3b64a]/25 bg-[#1c110a]/88 p-6 shadow-[0_10px_30px_rgba(227,182,74,0.15)] backdrop-blur-xl transition-all duration-500 hover:border-[#e3b64a]/50 hover:shadow-[0_15px_40px_rgba(163,22,28,0.26)] md:p-8";
const columnClass = title ? `${columnBase} ${columnCard}` : columnBase;
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#e3b64a]/30 pb-4">
        <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a3] via-[#e3b64a] to-[#5c0a0c] shadow-[0_0_10px_rgba(227,182,74,0.5)]" />
        <HeadingTag class="bg-gradient-to-r from-[#ffe9a3] via-[#e3b64a] to-[#a3161c] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class={columnClass}>
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#e3b64a]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#e3b64a] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e3b64a]/45 bg-gradient-to-br from-[#ffe9a3] via-[#f0cd6a] to-[#b8862c] text-sm text-[#0d0705] shadow-[0_5px_15px_rgba(227,182,74,0.3)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class={columnClass}>
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#e3b64a]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#e3b64a] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#a3161c]/50 bg-gradient-to-br from-[#ffe9a3] via-[#d4472a] to-[#a3161c] text-sm text-[#0d0705] shadow-[0_5px_15px_rgba(163,22,28,0.4)]">
              🐉
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
