---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// XTOP666: ย้ายชุดสีของแบรนด์ก่อนออกทั้งหมด มาที่ส้มเรซซิ่งคู่แดงหลอมเหลวบนผิวดำ
// อมแดงที่วัดจากอาร์ตจริง คอลัมน์ซ้ายรับส้มซึ่งเป็นสีหลัก คอลัมน์ขวารับคู่แดงเพื่อ
// ให้สองแผงแยกกันออกในกล่องเดียว (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind
// สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้
// ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้ให้บล็อกนี้แบก
// section ของ docx ได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น <p>: มันตั้งชื่อแผง UI (ฟอร์ม
// เข้าสู่ระบบ, ตารางอ้างอิง) ไม่ใช่ section ของ docx การเลื่อนขึ้นเป็นหัวข้อจะเพิ่ม
// ระดับหัวข้อที่ brief ไม่เคยขอ รอบนี้ผู้เรียกเดียวคือ LoginRtpSection ซึ่งเป็น
// widget จึงส่งแค่ `label` ไม่ส่ง `title`
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ ถ้าไม่มี
// title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");

// ใส่ chrome ของการ์ดเฉพาะตอนบล็อกนี้แบก section ของ docx (`title`) เท่านั้น เวลา
// ถูกใช้เป็นโครงสองคอลัมน์เปล่าๆ — LoginRtpSection ส่งแผงของตัวเองเข้า slot —
// คอลัมน์จะแบนราบไว้ ไม่งั้นหน้าเว็บจะได้การ์ดซ้อนการ์ด
const columnBase = "flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e5dc]";
const columnCard =
  "rounded-3xl border border-[#d94a02]/30 bg-[#1a0603]/88 p-6 shadow-[0_10px_30px_rgba(252,91,3,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#fc5b03]/55 hover:shadow-[0_15px_40px_rgba(252,91,3,0.34)] md:p-8";
const columnClass = title ? `${columnBase} ${columnCard}` : columnBase;
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#d94a02]/35 pb-4">
        <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffc9a3] via-[#fc5b03] to-[#a33200] shadow-[0_0_10px_rgba(252,91,3,0.55)]" />
        <HeadingTag class="bg-gradient-to-r from-[#fff0e6] via-[#fc5b03] to-[#d94a02] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class={columnClass}>
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#d94a02]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#fc5b03] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#d94a02]/55 bg-gradient-to-br from-[#ffc9a3] via-[#fc5b03] to-[#a33200] text-sm text-[#0a0403] shadow-[0_5px_15px_rgba(252,91,3,0.4)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class={columnClass}>
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#ff5a4d]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#ff5a4d] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ff5a4d]/60 bg-gradient-to-br from-[#ffb9b0] via-[#ff5a4d] to-[#7a0101] text-sm text-[#0a0403] shadow-[0_5px_15px_rgba(225,18,18,0.4)]">
              💎
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
