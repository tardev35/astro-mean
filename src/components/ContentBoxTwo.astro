---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  iconleft?: string;
  iconright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, iconleft = "🔐", iconright = "💎", label } = Astro.props;

// CK1968: ย้ายชุดทองอำพันคู่โครเมียมเงินของแบรนด์ก่อนออกทั้งหมด มาที่ทองคำคู่แดง
// เลือดหมูบนดำอมน้ำตาล — ทอง #ffefc4 / #ffd45c / #f0a80c / #a76806 / #5d3a05
// คู่แดง #ff4b52 / #d4090f / #8c0206 / #3d0203 บนผิว #090302 / #170806 / #2a100a
// ขอบ #4d1f0d เนื้อความ #f6e4c0 ข้อความรอง #cdb494
// สองคอลัมน์แยกกันด้วยสีคู่จริงของแบรนด์รอบนี้ (ซ้ายรับทองคำ ขวารับแดงเลือดหมู ซึ่ง
// มาจากตัว K ในโลโก้ ทับทิมบนมงกุฎ ไพ่ชุดแดงและลูกเต๋าแดง) ไม่ใช่ด้วยทองสองน้ำหนัก
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history)
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น
// <p>: มันตั้งชื่อแผง UI (ฟอร์มเข้าสู่ระบบ, ตารางอ้างอิง) ไม่ใช่ section ของ docx
// การเลื่อนขึ้นเป็นหัวข้อจะเพิ่มระดับหัวข้อที่ brief ไม่เคยขอ
//
// รอบนี้มีผู้เรียกรายเดียวคือ LoginRtpSection ซึ่งเป็น widget — ส่งแค่ `label` แล้ว
// ใช้ค่า default กุญแจ/เพชร บล็อกนี้จึงไม่ปล่อยหัวข้อออกมาเลยบนหน้าแรกรอบนี้
// อิโมจิอยู่ใน <span aria-hidden="true"> แยกจากข้อความป้ายเสมอ
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ ถ้าไม่มี
// title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");

// ใส่ chrome ของการ์ดเฉพาะตอนบล็อกนี้แบก section ของ docx (`title`) เท่านั้น เวลา
// ถูกใช้เป็นโครงสองคอลัมน์เปล่าๆ — LoginRtpSection ส่งแผงของตัวเองเข้า slot —
// คอลัมน์จะแบนราบไว้ ไม่งั้นหน้าเว็บจะได้การ์ดซ้อนการ์ด
const columnBase = "flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e4c0]";
const columnCard =
  "rounded-3xl border border-[#4d1f0d]/70 bg-[#170806]/90 p-6 shadow-[0_10px_30px_rgba(93,58,5,0.35)] backdrop-blur-xl transition-all duration-500 hover:border-[#f0a80c]/60 hover:shadow-[0_15px_40px_rgba(240,168,12,0.3)] md:p-8";
const columnClass = title ? `${columnBase} ${columnCard}` : columnBase;
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#4d1f0d]/70 pb-4">
        <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffefc4] via-[#f0a80c] to-[#5d3a05] shadow-[0_0_10px_rgba(240,168,12,0.55)]" />
        <HeadingTag class="bg-gradient-to-r from-[#ffefc4] via-[#ffd45c] to-[#ff4b52] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class={columnClass}>
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#4d1f0d]/60 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffd45c] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f0a80c]/55 bg-gradient-to-br from-[#ffefc4] via-[#f0a80c] to-[#5d3a05] text-sm text-[#090302] shadow-[0_5px_15px_rgba(240,168,12,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class={columnClass}>
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#d4090f]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#ff4b52] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#d4090f]/60 bg-gradient-to-br from-[#ff4b52] via-[#d4090f] to-[#3d0203] text-sm text-[#ffefc4] shadow-[0_5px_15px_rgba(212,9,15,0.4)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
