---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// 249UP: ย้ายจากแดงสัญญาณ + โครมเงินของ FUSIONNEW (#ff5f52 / #e01a1a / #8c0102 คู่
// กับ #d9dde3 / #97a0a8 / #4a5157 บนผิว #150809 / #1f0c0d / #0a0405 เนื้อความ
// #e7e3e1 ข้อความรอง #c3bcb9) มาที่ทองหรูบนพื้นเกือบดำ — #ffe9a8 / #ffd86b /
// #f5b626 / #c98a12 / #8a5c08 / #3a2606 บนผิว #150e05 / #1e1409 / #0b0703
// เนื้อความ #f0e4cd หมึกบนพื้นทอง #0b0703
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้ให้บล็อกนี้แบก
// section ของ docx ได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น <p>: มันตั้งชื่อแผง UI (ฟอร์ม
// เข้าสู่ระบบ, ตารางอ้างอิง) ไม่ใช่ section ของ docx การเลื่อนขึ้นเป็นหัวข้อจะเพิ่ม
// ระดับหัวข้อที่ brief ไม่เคยขอ
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ ถ้าไม่มี
// title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");

// ใส่ chrome ของการ์ดเฉพาะตอนบล็อกนี้แบก section ของ docx (`title`) เท่านั้น เวลา
// ถูกใช้เป็นโครงสองคอลัมน์เปล่าๆ — LoginRtpSection ส่งแผงของตัวเองเข้า slot —
// คอลัมน์จะแบนราบไว้ ไม่งั้นหน้าเว็บจะได้การ์ดซ้อนการ์ด
const columnBase = "flex flex-col gap-4 text-left text-base leading-relaxed text-[#f0e4cd]";
const columnCard =
  "rounded-3xl border border-[#f5b626]/25 bg-[#150e05]/88 p-6 shadow-[0_10px_30px_rgba(245,182,38,0.15)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5b626]/50 hover:shadow-[0_15px_40px_rgba(255,216,107,0.26)] md:p-8";
const columnClass = title ? `${columnBase} ${columnCard}` : columnBase;
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#f5b626]/30 pb-4">
        <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a8] via-[#f5b626] to-[#8a5c08] shadow-[0_0_10px_rgba(245,182,38,0.5)]" />
        <HeadingTag class="bg-gradient-to-r from-[#ffe9a8] via-[#ffd86b] to-[#c98a12] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class={columnClass}>
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#f5b626]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffd86b] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f5b626]/45 bg-gradient-to-br from-[#ffe9a8] via-[#f5b626] to-[#8a5c08] text-sm text-[#0b0703] shadow-[0_5px_15px_rgba(245,182,38,0.3)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class={columnClass}>
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#f5b626]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffd86b] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ffe9a8]/50 bg-gradient-to-br from-[#ffe9a8] via-[#ffd86b] to-[#c98a12] text-sm text-[#0b0703] shadow-[0_5px_15px_rgba(255,233,168,0.3)]">
              🎮
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
