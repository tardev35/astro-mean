---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// JUDTEM168: rethemed off the previous brand's blue (#3b8df1 / #0a2563 /
// #dbe7fb) onto the gold-on-black palette — #fac42c / #e4a434 / #cc8425 on
// #150d04 / #1e1206, body text #f3e3c4, muted #d8c49a.
//
// `title` is the ONLY heading this component may emit, and it is there so the
// component can carry a docx section. Both COLUMN titles stay <p>: they label
// UI panels (a login form, a reference table), not docx sections, so promoting
// them would add heading levels the brief never asked for.
//
// When `title` is passed the heading already names the section, so no
// aria-label is added on top of it; without a title the section falls back to
// `label` for its accessible name.
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");

// Card chrome only when this block carries a docx section (`title`). Used as a
// bare two-column wrapper — LoginRtpSection passes its own panels into the
// slots — the columns stay flat, or the page gets a card inside a card.
const columnBase = "flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e3c4]";
const columnCard =
  "rounded-3xl border border-[#e4a434]/25 bg-[#150d04]/88 p-6 shadow-[0_10px_30px_rgba(250,196,44,0.15)] backdrop-blur-xl transition-all duration-500 hover:border-[#e4a434]/50 hover:shadow-[0_15px_40px_rgba(254,235,51,0.26)] md:p-8";
const columnClass = title ? `${columnBase} ${columnCard}` : columnBase;
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#e4a434]/30 pb-4">
        <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#feeb33] via-[#e4a434] to-[#7a4a0d] shadow-[0_0_10px_rgba(250,196,44,0.5)]" />
        <HeadingTag class="bg-gradient-to-r from-[#feeb33] via-[#fac42c] to-[#cc8425] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class={columnClass}>
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#e4a434]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#fac42c] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e4a434]/45 bg-gradient-to-br from-[#feeb33] via-[#fac42c] to-[#7a4a0d] text-sm text-[#1a1003] shadow-[0_5px_15px_rgba(250,196,44,0.3)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class={columnClass}>
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#e4a434]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#fac42c] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#cc8425]/50 bg-gradient-to-br from-[#feeb33] via-[#e4a434] to-[#cc8425] text-sm text-[#1a1003] shadow-[0_5px_15px_rgba(250,196,44,0.4)]">
              🎰
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
