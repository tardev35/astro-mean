---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  iconleft?: string;
  iconright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, iconleft = "🔑", iconright = "📊", label } = Astro.props;

// JAICHUA: ย้ายชุดน้ำเงินธงชาติคู่แดงของแบรนด์ก่อนออกทั้งหมด มาที่ทองคำคู่น้ำเงิน
// รอยัล — ทอง #fbeec9 / #f6d67e / #d8a83f / #a97722 / #6d4a12 คู่น้ำเงิน #cfe0fb /
// #5b8ede / #2f5fb0 / #16336b บนผิว #040915 / #0a1226 / #0e1a33 / #132244
// ขอบ #6d4a12 เนื้อความ #dce6f8 ข้อความรอง #a9b7d4
// สองคอลัมน์แยกกันด้วยคู่สีจริงของแบรนด์รอบนี้ (ซ้ายรับทองซึ่งคือป้ายจ่ายชัวร์888
// ขวารับน้ำเงินซึ่งคือโล่ที่รองอยู่) ไม่ใช่ด้วยทองสองน้ำหนัก
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history)
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น
// <p>: มันตั้งชื่อแผง UI (ฟอร์มเข้าสู่ระบบ, ตารางอ้างอิง) ไม่ใช่ section ของ docx
// การเลื่อนขึ้นเป็นหัวข้อจะเพิ่มระดับหัวข้อที่ brief ไม่เคยขอ
//
// รอบนี้มีผู้เรียกรายเดียวคือ LoginRtpSection ซึ่งเป็น widget — ส่งแค่ `label` แล้ว
// ใช้ค่า default กุญแจ/ตารางสถิติ บล็อกนี้จึงไม่ปล่อยหัวข้อออกมาเลยบนหน้าแรกรอบนี้
// อิโมจิอยู่ใน <span aria-hidden="true"> แยกจากข้อความป้ายเสมอ
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ ถ้าไม่มี
// title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");

// ใส่ chrome ของการ์ดเฉพาะตอนบล็อกนี้แบก section ของ docx (`title`) เท่านั้น เวลา
// ถูกใช้เป็นโครงสองคอลัมน์เปล่าๆ — LoginRtpSection ส่งแผงของตัวเองเข้า slot —
// คอลัมน์จะแบนราบไว้ ไม่งั้นหน้าเว็บจะได้การ์ดซ้อนการ์ด
const columnBase = "flex flex-col gap-4 text-left text-base leading-relaxed text-[#dce6f8]";
const columnCard =
  "rounded-3xl border border-[#6d4a12]/70 bg-[#0a1226]/90 p-6 shadow-[0_10px_30px_rgba(22,39,78,0.45)] backdrop-blur-xl transition-all duration-500 hover:border-[#d8a83f]/60 hover:shadow-[0_15px_40px_rgba(216,168,63,0.3)] md:p-8";
const columnClass = title ? `${columnBase} ${columnCard}` : columnBase;
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#6d4a12]/70 pb-4">
        <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fbeec9] via-[#d8a83f] to-[#16336b] shadow-[0_0_10px_rgba(216,168,63,0.55)]" />
        <HeadingTag class="bg-gradient-to-r from-[#fbeec9] via-[#f6d67e] to-[#5b8ede] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class={columnClass}>
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#6d4a12]/60 pb-3 text-xl leading-normal font-black tracking-widest text-[#f6d67e] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#d8a83f]/55 bg-gradient-to-br from-[#fbeec9] via-[#d8a83f] to-[#6d4a12] text-sm text-[#040915] shadow-[0_5px_15px_rgba(216,168,63,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class={columnClass}>
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#2f5fb0]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#cfe0fb] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#2f5fb0]/60 bg-gradient-to-br from-[#cfe0fb] via-[#2f5fb0] to-[#16336b] text-sm text-[#040915] shadow-[0_5px_15px_rgba(47,95,176,0.4)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
