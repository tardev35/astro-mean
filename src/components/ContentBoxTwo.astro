---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// BOOST168: ย้ายจากนีออนม่วงคู่ทองของแบรนด์ก่อนหน้า (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ —
// Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มี
// ใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history) มาที่ทองบูสต์คู่น้ำเงินไฟฉาย —
// ทอง #ffe680 /
// #ffc233 / #b26a00 คู่น้ำเงิน #9ecbff / #3f8cff บนผิว #0e1430 / #050818 / #03060f /
// #18204a เนื้อความ #e6ecfb หมึกบนพื้นสว่าง #0a0f22
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้ให้บล็อกนี้แบก
// section ของ docx ได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น <p>: มันตั้งชื่อแผง UI (ฟอร์ม
// เข้าสู่ระบบ, ตารางอ้างอิง) ไม่ใช่ section ของ docx การเลื่อนขึ้นเป็นหัวข้อจะเพิ่ม
// ระดับหัวข้อที่ brief ไม่เคยขอ
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ ถ้าไม่มี
// title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");

// ใส่ chrome ของการ์ดเฉพาะตอนบล็อกนี้แบก section ของ docx (`title`) เท่านั้น เวลา
// ถูกใช้เป็นโครงสองคอลัมน์เปล่าๆ — LoginRtpSection ส่งแผงของตัวเองเข้า slot —
// คอลัมน์จะแบนราบไว้ ไม่งั้นหน้าเว็บจะได้การ์ดซ้อนการ์ด
const columnBase = "flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6ecfb]";
const columnCard =
  "rounded-3xl border border-[#ffc233]/25 bg-[#0e1430]/88 p-6 shadow-[0_10px_30px_rgba(255,194,51,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffc233]/50 hover:shadow-[0_15px_40px_rgba(255,194,51,0.32)] md:p-8";
const columnClass = title ? `${columnBase} ${columnCard}` : columnBase;
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#ffc233]/30 pb-4">
        <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe680] via-[#ffc233] to-[#3f8cff] shadow-[0_0_10px_rgba(255,194,51,0.55)]" />
        <HeadingTag class="bg-gradient-to-r from-[#fff6dd] via-[#ffc233] to-[#b26a00] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class={columnClass}>
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#ffc233]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe680] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ffc233]/55 bg-gradient-to-br from-[#ffc233] via-[#b26a00] to-[#18204a] text-sm text-[#fff6dd] shadow-[0_5px_15px_rgba(255,194,51,0.4)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class={columnClass}>
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#3f8cff]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#9ecbff] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#9ecbff]/60 bg-gradient-to-br from-[#9ecbff] via-[#3f8cff] to-[#12306e] text-sm text-[#0a0f22] shadow-[0_5px_15px_rgba(63,140,255,0.35)]">
              💎
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
