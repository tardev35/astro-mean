---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  iconleft?: string;
  iconright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, iconleft = "🔐", iconright = "💎", label } = Astro.props;

// QUEEN189: ย้ายชุดสีของแบรนด์ก่อนออกทั้งหมด มาที่ทองราชสำนักบนดำสนิท — ทอง
// #fdf3d2 / #fceb83 / #e4bb53 / #c38d29 / #7a5615 บนผิว #0b0704 / #1a1108 /
// #271a0c เนื้อความ #f3e4c4 ข้อความรอง #c2a878
// สองคอลัมน์แยกกันด้วยทองสว่างกับทองเข้ม (ซ้ายรับทองสว่าง ขวารับทองลึก) ไม่ใช่ด้วย
// สีที่สองที่ไม่มีอยู่ในอาร์ตของแบรนด์ — แบรนด์นี้เป็นทองวรรณะเดียวไล่ระดับ
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history)
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น
// <p>: มันตั้งชื่อแผง UI (ฟอร์มเข้าสู่ระบบ, ตารางอ้างอิง) ไม่ใช่ section ของ docx
// การเลื่อนขึ้นเป็นหัวข้อจะเพิ่มระดับหัวข้อที่ brief ไม่เคยขอ
//
// รอบนี้มีผู้เรียกรายเดียวคือ LoginRtpSection ซึ่งเป็น widget — ส่งแค่ `label` แล้ว
// ใช้ค่า default กุญแจ/เพชร บล็อกนี้จึงไม่ปล่อยหัวข้อออกมาเลยบนหน้าแรกรอบนี้
// อิโมจิอยู่ใน <span aria-hidden="true"> แยกจากข้อความป้ายเสมอ
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ ถ้าไม่มี
// title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");

// ใส่ chrome ของการ์ดเฉพาะตอนบล็อกนี้แบก section ของ docx (`title`) เท่านั้น เวลา
// ถูกใช้เป็นโครงสองคอลัมน์เปล่าๆ — LoginRtpSection ส่งแผงของตัวเองเข้า slot —
// คอลัมน์จะแบนราบไว้ ไม่งั้นหน้าเว็บจะได้การ์ดซ้อนการ์ด
const columnBase = "flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e4c4]";
const columnCard =
  "rounded-3xl border border-[#7a5615]/45 bg-[#1a1108]/90 p-6 shadow-[0_10px_30px_rgba(122,86,21,0.3)] backdrop-blur-xl transition-all duration-500 hover:border-[#e4bb53]/60 hover:shadow-[0_15px_40px_rgba(228,187,83,0.3)] md:p-8";
const columnClass = title ? `${columnBase} ${columnCard}` : columnBase;
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#7a5615]/50 pb-4">
        <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdf3d2] via-[#e4bb53] to-[#7a5615] shadow-[0_0_10px_rgba(228,187,83,0.55)]" />
        <HeadingTag class="bg-gradient-to-r from-[#fdf3d2] via-[#fceb83] to-[#c38d29] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class={columnClass}>
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#7a5615]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#fceb83] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e4bb53]/55 bg-gradient-to-br from-[#fdf3d2] via-[#e4bb53] to-[#7a5615] text-sm text-[#0b0704] shadow-[0_5px_15px_rgba(228,187,83,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class={columnClass}>
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#e4bb53]/35 pb-3 text-xl leading-normal font-black tracking-widest text-[#e4bb53] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#c38d29]/60 bg-gradient-to-br from-[#fceb83] via-[#c38d29] to-[#3c2505] text-sm text-[#0b0704] shadow-[0_5px_15px_rgba(195,141,41,0.35)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
