---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// GEN4: ย้ายชุดสีจากส้มหลอมเหลวของแบรนด์ก่อน มาที่น้ำเงินอิเล็กทริกคู่แดงของแบรนด์
// นี้ที่วัดจากอาร์ตจริง (โลโก้ตัวอักษร GEN สีน้ำเงินกับเลข 4 สีแดง บนฉากกรมท่า
// เกือบดำ) — น้ำเงิน #0071d5 / #01a3f3 / #6fd2ff / #00408a คู่แดง #e8241c /
// #ff5a33 / #8a1410 บนผิว #050b1a / #0b1b3a ขอบ/แถบยก #102a5c เนื้อความ #d7e7ff
// หัวข้อ #eaf4ff (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็น
// ข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS
// ตาย ดูของเดิมได้จาก git history)
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้ให้บล็อกนี้แบก
// section ของ docx ได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น <p>: มันตั้งชื่อแผง UI (ฟอร์ม
// เข้าสู่ระบบ, ตารางอ้างอิง) ไม่ใช่ section ของ docx การเลื่อนขึ้นเป็นหัวข้อจะเพิ่ม
// ระดับหัวข้อที่ brief ไม่เคยขอ รอบนี้ผู้เรียกเดียวคือ LoginRtpSection ซึ่งเป็น
// widget จึงส่งแค่ `label` ไม่ส่ง `title`
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ ถ้าไม่มี
// title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");

// ใส่ chrome ของการ์ดเฉพาะตอนบล็อกนี้แบก section ของ docx (`title`) เท่านั้น เวลา
// ถูกใช้เป็นโครงสองคอลัมน์เปล่าๆ — LoginRtpSection ส่งแผงของตัวเองเข้า slot —
// คอลัมน์จะแบนราบไว้ ไม่งั้นหน้าเว็บจะได้การ์ดซ้อนการ์ด
const columnBase = "flex flex-col gap-4 text-left text-base leading-relaxed text-[#d7e7ff]";
const columnCard =
  "rounded-3xl border border-[#0071d5]/30 bg-[#0b1b3a]/88 p-6 shadow-[0_10px_30px_rgba(0,113,213,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#01a3f3]/55 hover:shadow-[0_15px_40px_rgba(1,163,243,0.34)] md:p-8";
const columnClass = title ? `${columnBase} ${columnCard}` : columnBase;
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#0071d5]/35 pb-4">
        <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#6fd2ff] via-[#01a3f3] to-[#00408a] shadow-[0_0_10px_rgba(1,163,243,0.55)]" />
        <HeadingTag class="bg-gradient-to-r from-[#eaf4ff] via-[#01a3f3] to-[#0071d5] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class={columnClass}>
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#0071d5]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#01a3f3] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#0071d5]/55 bg-gradient-to-br from-[#6fd2ff] via-[#01a3f3] to-[#00408a] text-sm text-[#050b1a] shadow-[0_5px_15px_rgba(1,163,243,0.4)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class={columnClass}>
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#e8241c]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#ff5a33] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e8241c]/60 bg-gradient-to-br from-[#ff5a33] via-[#e8241c] to-[#8a1410] text-sm text-[#050b1a] shadow-[0_5px_15px_rgba(232,36,28,0.4)]">
              💎
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
