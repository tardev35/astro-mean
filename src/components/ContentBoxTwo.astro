---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// PROFIT55: รอบก่อนเป็นแดงส้มคู่ทอง รอบนี้กลับด้านเป็น "ทองหลัก คู่
// เงินโครเมียม" ตามโลโก้ (ตัวอักษร PROFIT โครเมียม + เลข 55 ทอง) — ทอง #e3ac22 /
// #f6d24a / #ffe9a8 / #8a6410 คู่เงิน #cfd8e2 / #eef3f8 / #8b96a4 บนผิว #161004 /
// #0a0702 ขอบ/แถบยก #2a1d05 เนื้อความ #f3e6c4 ตัวอักษรสว่าง #fffaf0 (ค่า hex ของ
// แบรนด์เก่าไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็น
// คอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history)
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้ให้บล็อกนี้แบก
// section ของ docx ได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น <p>: มันตั้งชื่อแผง UI (ฟอร์ม
// เข้าสู่ระบบ, ตารางอ้างอิง) ไม่ใช่ section ของ docx การเลื่อนขึ้นเป็นหัวข้อจะเพิ่ม
// ระดับหัวข้อที่ brief ไม่เคยขอ รอบนี้ผู้เรียกเดียวคือ LoginRtpSection ซึ่งเป็น
// widget จึงส่งแค่ `label` ไม่ส่ง `title`
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ ถ้าไม่มี
// title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");

// ใส่ chrome ของการ์ดเฉพาะตอนบล็อกนี้แบก section ของ docx (`title`) เท่านั้น เวลา
// ถูกใช้เป็นโครงสองคอลัมน์เปล่าๆ — LoginRtpSection ส่งแผงของตัวเองเข้า slot —
// คอลัมน์จะแบนราบไว้ ไม่งั้นหน้าเว็บจะได้การ์ดซ้อนการ์ด
const columnBase = "flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e6c4]";
const columnCard =
  "rounded-3xl border border-[#e3ac22]/25 bg-[#161004]/88 p-6 shadow-[0_10px_30px_rgba(227,172,34,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffe9a8]/50 hover:shadow-[0_15px_40px_rgba(227,172,34,0.32)] md:p-8";
const columnClass = title ? `${columnBase} ${columnCard}` : columnBase;
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#e3ac22]/30 pb-4">
        <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#eef3f8] via-[#cfd8e2] to-[#e3ac22] shadow-[0_0_10px_rgba(207,216,226,0.55)]" />
        <HeadingTag class="bg-gradient-to-r from-[#fffaf0] via-[#ffe9a8] to-[#e3ac22] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class={columnClass}>
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#cfd8e2]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#eef3f8] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#cfd8e2]/55 bg-gradient-to-br from-[#eef3f8] via-[#8b96a4] to-[#2a1d05] text-sm text-[#161004] shadow-[0_5px_15px_rgba(207,216,226,0.4)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class={columnClass}>
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#e3ac22]/35 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe9a8] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ffe9a8]/60 bg-gradient-to-br from-[#f6d24a] via-[#e3ac22] to-[#8a6410] text-sm text-[#161004] shadow-[0_5px_15px_rgba(227,172,34,0.4)]">
              💎
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
