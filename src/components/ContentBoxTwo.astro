---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  iconleft?: string;
  iconright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, iconleft = "🔐", iconright = "💎", label } = Astro.props;

// AURA456: ย้ายชุดสีของแบรนด์ก่อนออกทั้งหมด มาที่นีออนบานเย็นคู่ฟ้าอิเล็กทริกที่
// วัดจากอาร์ตจริง — บานเย็น #ff2fb0 / #ffc9ee / #ff7fd4 / #c81d8e คู่ฟ้า #d8f2ff /
// #7fd0ff / #3ba9ff / #5f7fb8 กับม่วง #8b3cf7 / #4a179e บนผิว #05021a / #0b0528 /
// #120a33 / #1c1046 เนื้อความ #d8d3f0 ข้อความรอง #9b93c4
// คอลัมน์ซ้ายรับบานเย็นซึ่งเป็นสีหลัก คอลัมน์ขวารับฟ้าเพื่อให้สองแผงแยกกันออกใน
// กล่องเดียว (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของ
// เดิมได้จาก git history)
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้ให้บล็อกนี้แบก
// section ของ docx ได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น <p>: มันตั้งชื่อแผง UI (ฟอร์ม
// เข้าสู่ระบบ, ตารางอ้างอิง) ไม่ใช่ section ของ docx การเลื่อนขึ้นเป็นหัวข้อจะเพิ่ม
// ระดับหัวข้อที่ brief ไม่เคยขอ
//
// รอบนี้ผู้เรียกมีรายเดียวคือ LoginRtpSection ซึ่งเป็น widget ส่งแค่ `label` และใช้
// ค่า default กุญแจ/เพชร ส่วน `iconleft`/`iconright` ยังเปิดเป็น prop ไว้ให้รอบที่
// บล็อกนี้ต้องแบกหัวข้อ docx อิโมจิอยู่ใน <span aria-hidden="true"> แยกจากข้อความ
// ป้ายเสมอ
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ ถ้าไม่มี
// title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");

// ใส่ chrome ของการ์ดเฉพาะตอนบล็อกนี้แบก section ของ docx (`title`) เท่านั้น เวลา
// ถูกใช้เป็นโครงสองคอลัมน์เปล่าๆ — LoginRtpSection ส่งแผงของตัวเองเข้า slot —
// คอลัมน์จะแบนราบไว้ ไม่งั้นหน้าเว็บจะได้การ์ดซ้อนการ์ด
const columnBase = "flex flex-col gap-4 text-left text-base leading-relaxed text-[#d8d3f0]";
const columnCard =
  "rounded-3xl border border-[#8b3cf7]/30 bg-[#120a33]/88 p-6 shadow-[0_10px_30px_rgba(139,60,247,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff2fb0]/55 hover:shadow-[0_15px_40px_rgba(59,169,255,0.24)] md:p-8";
const columnClass = title ? `${columnBase} ${columnCard}` : columnBase;
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#8b3cf7]/35 pb-4">
        <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffc9ee] via-[#3ba9ff] to-[#4a179e] shadow-[0_0_10px_rgba(255,47,176,0.55)]" />
        <HeadingTag class="bg-gradient-to-r from-[#f6ebff] via-[#7fd0ff] to-[#ff2fb0] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class={columnClass}>
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#8b3cf7]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#ff2fb0] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ff2fb0]/55 bg-gradient-to-br from-[#ffc9ee] via-[#ff2fb0] to-[#8b3cf7] text-sm text-[#05021a] shadow-[0_5px_15px_rgba(255,47,176,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class={columnClass}>
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#3ba9ff]/35 pb-3 text-xl leading-normal font-black tracking-widest text-[#7fd0ff] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#3ba9ff]/60 bg-gradient-to-br from-[#d8f2ff] via-[#7fd0ff] to-[#5f7fb8] text-sm text-[#05021a] shadow-[0_5px_15px_rgba(59,169,255,0.35)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
