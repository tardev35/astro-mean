---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// DRACO65: ย้ายจากม่วงโกธิคของ PHANTOM569 (#ede9fe / #b794ff / #8b5cf6 /
// #6d28d9 / #4c1d95 / #2a0a52 บนผิว #1c0343 / #12002b เนื้อความ #ded4f5
// ข้อความรอง #a99ac9 ทอง #f6c445) มาที่เขียวมังกรนีออน — #dcfce7 / #4ade80 /
// #22c55e / #15803d / #14532d / #0a3318 บนผิว #062011 / #04150a เนื้อความ
// #d6ecdd ข้อความรอง #9dbfa8 หมึกบนพื้นสว่าง #04150a และสีรองเป็นเงิน/โครเมียม
// #e2e8e4 แบรนด์นี้ไม่มีม่วงและไม่มีทองเหลืออยู่ในโค้ด
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้ให้บล็อกนี้แบก
// section ของ docx ได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น <p>: มันตั้งชื่อแผง UI (ฟอร์ม
// เข้าสู่ระบบ, ตารางอ้างอิง) ไม่ใช่ section ของ docx การเลื่อนขึ้นเป็นหัวข้อจะเพิ่ม
// ระดับหัวข้อที่ brief ไม่เคยขอ
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ ถ้าไม่มี
// title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");

// ใส่ chrome ของการ์ดเฉพาะตอนบล็อกนี้แบก section ของ docx (`title`) เท่านั้น เวลา
// ถูกใช้เป็นโครงสองคอลัมน์เปล่าๆ — LoginRtpSection ส่งแผงของตัวเองเข้า slot —
// คอลัมน์จะแบนราบไว้ ไม่งั้นหน้าเว็บจะได้การ์ดซ้อนการ์ด
const columnBase = "flex flex-col gap-4 text-left text-base leading-relaxed text-[#d6ecdd]";
const columnCard =
  "rounded-3xl border border-[#22c55e]/25 bg-[#062011]/88 p-6 shadow-[0_10px_30px_rgba(34,197,94,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#22c55e]/50 hover:shadow-[0_15px_40px_rgba(74,222,128,0.28)] md:p-8";
const columnClass = title ? `${columnBase} ${columnCard}` : columnBase;
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#22c55e]/30 pb-4">
        <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#dcfce7] via-[#4ade80] to-[#14532d] shadow-[0_0_10px_rgba(34,197,94,0.5)]" />
        <HeadingTag class="bg-gradient-to-r from-[#dcfce7] via-[#4ade80] to-[#22c55e] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class={columnClass}>
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#22c55e]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#4ade80] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#22c55e]/45 bg-gradient-to-br from-[#15803d] via-[#14532d] to-[#0a3318] text-sm text-[#dcfce7] shadow-[0_5px_15px_rgba(21,128,61,0.35)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class={columnClass}>
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#22c55e]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#4ade80] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e2e8e4]/50 bg-gradient-to-br from-[#dcfce7] via-[#4ade80] to-[#22c55e] text-sm text-[#04150a] shadow-[0_5px_15px_rgba(34,197,94,0.3)]">
              🎰
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
