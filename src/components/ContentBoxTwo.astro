---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  iconleft?: string;
  iconright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, iconleft = "🔐", iconright = "💎", label } = Astro.props;

// DEED888: ย้ายชุดสีของแบรนด์ก่อนออกทั้งหมด มาที่ส้มเพลิงคู่ทองหลอมบนดำอมน้ำตาลไหม้
// — ส้ม #e95b0b / #ff9d4d / #fff4e8 / #93300a / #6b2205 คู่ทอง #f4940c / #ffcf6b
// บนผิว #150401 / #210702 / #2a0a02 เนื้อความ #fbe3d0 ข้อความรอง #d9b096
// สองคอลัมน์แยกกันด้วยน้ำหนักของไฟคนละระดับ (ซ้ายรับส้มสว่าง ขวารับครีมขอบไฟ)
// ไม่ใช่ด้วยสีที่สามที่ไม่มีอยู่ในอาร์ตของแบรนด์ (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้
// ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจาก
// ค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้ให้บล็อกนี้แบก
// section ของ docx ได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น <p>: มันตั้งชื่อแผง UI (ฟอร์ม
// เข้าสู่ระบบ, ตารางอ้างอิง) ไม่ใช่ section ของ docx การเลื่อนขึ้นเป็นหัวข้อจะเพิ่ม
// ระดับหัวข้อที่ brief ไม่เคยขอ
//
// รอบนี้มีผู้เรียกสองราย: หน้าแรกส่ง `title` เข้ามาให้แบกหัวข้อ docx ข้อ 6 เรื่อง
// ล็อบบี้อัปเดตต่อเนื่อง และ LoginRtpSection ซึ่งเป็น widget ส่งแค่ `label` แล้วใช้
// ค่า default กุญแจ/เพชร อิโมจิอยู่ใน <span aria-hidden="true"> แยกจากข้อความป้ายเสมอ
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ ถ้าไม่มี
// title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");

// ใส่ chrome ของการ์ดเฉพาะตอนบล็อกนี้แบก section ของ docx (`title`) เท่านั้น เวลา
// ถูกใช้เป็นโครงสองคอลัมน์เปล่าๆ — LoginRtpSection ส่งแผงของตัวเองเข้า slot —
// คอลัมน์จะแบนราบไว้ ไม่งั้นหน้าเว็บจะได้การ์ดซ้อนการ์ด
const columnBase = "flex flex-col gap-4 text-left text-base leading-relaxed text-[#fbe3d0]";
const columnCard =
  "rounded-3xl border border-[#93300a]/35 bg-[#210702]/90 p-6 shadow-[0_10px_30px_rgba(107,34,5,0.28)] backdrop-blur-xl transition-all duration-500 hover:border-[#e95b0b]/60 hover:shadow-[0_15px_40px_rgba(233,91,11,0.3)] md:p-8";
const columnClass = title ? `${columnBase} ${columnCard}` : columnBase;
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#93300a]/40 pb-4">
        <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff4e8] via-[#ff9d4d] to-[#6b2205] shadow-[0_0_10px_rgba(233,91,11,0.55)]" />
        <HeadingTag class="bg-gradient-to-r from-[#fff4e8] via-[#ff9d4d] to-[#e95b0b] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class={columnClass}>
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#93300a]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#ff9d4d] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e95b0b]/55 bg-gradient-to-br from-[#fff4e8] via-[#e95b0b] to-[#6b2205] text-sm text-[#150401] shadow-[0_5px_15px_rgba(233,91,11,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class={columnClass}>
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#e95b0b]/35 pb-3 text-xl leading-normal font-black tracking-widest text-[#fff4e8] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#fff4e8]/60 bg-gradient-to-br from-[#ffcf6b] via-[#f4940c] to-[#93300a] text-sm text-[#150401] shadow-[0_5px_15px_rgba(244,148,12,0.3)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
