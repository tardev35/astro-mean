---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// MONACO89: ย้ายจากชุดสีทองมังกรจีนคู่แดงบนดำของแบรนด์ก่อนหน้า (ค่า hex เดิมไม่พิมพ์ไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history) มาที่ทองแอมเบอร์–คอปเปอร์คู่แดงรอยัลบนมะฮอกกานีดำ — ทอง #ffe9b8 /
// #ffd77a / #ef8f22 / #a44516 คู่แดง #d1201a / #7e120e บนผิว #26150a / #160d05 /
// #0b0602 / #3a2109 เนื้อความ #f6e3c0 ข้อความรอง #c9a06a
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้ให้บล็อกนี้แบก
// section ของ docx ได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น <p>: มันตั้งชื่อแผง UI (ฟอร์ม
// เข้าสู่ระบบ, ตารางอ้างอิง) ไม่ใช่ section ของ docx การเลื่อนขึ้นเป็นหัวข้อจะเพิ่ม
// ระดับหัวข้อที่ brief ไม่เคยขอ
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ ถ้าไม่มี
// title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");

// ใส่ chrome ของการ์ดเฉพาะตอนบล็อกนี้แบก section ของ docx (`title`) เท่านั้น เวลา
// ถูกใช้เป็นโครงสองคอลัมน์เปล่าๆ — LoginRtpSection ส่งแผงของตัวเองเข้า slot —
// คอลัมน์จะแบนราบไว้ ไม่งั้นหน้าเว็บจะได้การ์ดซ้อนการ์ด
const columnBase = "flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e3c0]";
const columnCard =
  "rounded-3xl border border-[#ef8f22]/25 bg-[#26150a]/88 p-6 shadow-[0_10px_30px_rgba(239,143,34,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#ef8f22]/50 hover:shadow-[0_15px_40px_rgba(239,143,34,0.32)] md:p-8";
const columnClass = title ? `${columnBase} ${columnCard}` : columnBase;
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#ef8f22]/30 pb-4">
        <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd77a] via-[#ef8f22] to-[#d1201a] shadow-[0_0_10px_rgba(239,143,34,0.55)]" />
        <HeadingTag class="bg-gradient-to-r from-[#ffe9b8] via-[#ef8f22] to-[#a44516] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class={columnClass}>
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#ef8f22]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#ef8f22] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#d1201a]/55 bg-gradient-to-br from-[#d1201a] via-[#7e120e] to-[#3a2109] text-sm text-[#ffd77a] shadow-[0_5px_15px_rgba(209,32,26,0.4)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class={columnClass}>
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#ef8f22]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#ef8f22] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ffd77a]/60 bg-gradient-to-br from-[#ffd77a] via-[#ef8f22] to-[#a44516] text-sm text-[#1a0d03] shadow-[0_5px_15px_rgba(239,143,34,0.35)]">
              💎
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
