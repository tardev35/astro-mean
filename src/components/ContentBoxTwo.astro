---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// MAHAHENG333: ย้ายจากชมพูกลอสคู่ทองของ GALA89 (#ff4d9c / #d41c6b / #9e154a คู่ทอง
// #ffe0a3 / #f0c274 / #b8801f บนผิว #1f0311 / #12010a / #3c0214 เนื้อความ #f7dce8
// ข้อความรอง #f9a8cd) มาที่ทองมังกรจีนบนดำ — ทอง #ffe98a / #e8b923 / #a5760a คู่แดง
// #b4231c / #6d1410 บนผิว #221708 / #15100a / #0a0704 / #33230b เนื้อความ #f3e2b8
// ข้อความรอง #c2a469 ไม่มีชมพู/โรสเหลืออยู่ในไฟล์
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้ให้บล็อกนี้แบก
// section ของ docx ได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น <p>: มันตั้งชื่อแผง UI (ฟอร์ม
// เข้าสู่ระบบ, ตารางอ้างอิง) ไม่ใช่ section ของ docx การเลื่อนขึ้นเป็นหัวข้อจะเพิ่ม
// ระดับหัวข้อที่ brief ไม่เคยขอ
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ ถ้าไม่มี
// title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");

// ใส่ chrome ของการ์ดเฉพาะตอนบล็อกนี้แบก section ของ docx (`title`) เท่านั้น เวลา
// ถูกใช้เป็นโครงสองคอลัมน์เปล่าๆ — LoginRtpSection ส่งแผงของตัวเองเข้า slot —
// คอลัมน์จะแบนราบไว้ ไม่งั้นหน้าเว็บจะได้การ์ดซ้อนการ์ด
const columnBase = "flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e2b8]";
const columnCard =
  "rounded-3xl border border-[#e8b923]/25 bg-[#221708]/88 p-6 shadow-[0_10px_30px_rgba(232,185,35,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#e8b923]/50 hover:shadow-[0_15px_40px_rgba(232,185,35,0.32)] md:p-8";
const columnClass = title ? `${columnBase} ${columnCard}` : columnBase;
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#e8b923]/30 pb-4">
        <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe98a] via-[#e8b923] to-[#b4231c] shadow-[0_0_10px_rgba(232,185,35,0.55)]" />
        <HeadingTag class="bg-gradient-to-r from-[#ffe98a] via-[#e8b923] to-[#a5760a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class={columnClass}>
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#e8b923]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#e8b923] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#b4231c]/55 bg-gradient-to-br from-[#b4231c] via-[#6d1410] to-[#33230b] text-sm text-[#ffe98a] shadow-[0_5px_15px_rgba(180,35,28,0.4)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class={columnClass}>
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#e8b923]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#e8b923] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ffe98a]/60 bg-gradient-to-br from-[#ffe98a] via-[#e8b923] to-[#a5760a] text-sm text-[#0a0704] shadow-[0_5px_15px_rgba(232,185,35,0.35)]">
              💎
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
