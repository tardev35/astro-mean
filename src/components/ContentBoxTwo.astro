---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

// VIREL168: ย้ายชุดสีมาที่ทองของแบรนด์นี้ที่วัดจากอาร์ตจริง (โมโนแกรม V ทองสามมิติ
// คู่ตัวอักษร VIREL สีเงินโครเมียม) — ทอง #faca4c / #ebb134 / #e2a52d / #ffeec2 /
// #855a14 คู่เงิน #e1e1e1 / #949494 บนผิว #0a0501 / #1b0d02 ขอบ/แถบยก #2e1a04 /
// #442503 เนื้อความ #f4e7cd ข้อความรอง #c4ab7d (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้
// ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจาก
// ค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history)
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้ให้บล็อกนี้แบก
// section ของ docx ได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น <p>: มันตั้งชื่อแผง UI (ฟอร์ม
// เข้าสู่ระบบ, ตารางอ้างอิง) ไม่ใช่ section ของ docx การเลื่อนขึ้นเป็นหัวข้อจะเพิ่ม
// ระดับหัวข้อที่ brief ไม่เคยขอ รอบนี้ผู้เรียกเดียวคือ LoginRtpSection ซึ่งเป็น
// widget จึงส่งแค่ `label` ไม่ส่ง `title`
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ ถ้าไม่มี
// title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");

// ใส่ chrome ของการ์ดเฉพาะตอนบล็อกนี้แบก section ของ docx (`title`) เท่านั้น เวลา
// ถูกใช้เป็นโครงสองคอลัมน์เปล่าๆ — LoginRtpSection ส่งแผงของตัวเองเข้า slot —
// คอลัมน์จะแบนราบไว้ ไม่งั้นหน้าเว็บจะได้การ์ดซ้อนการ์ด
const columnBase = "flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4e7cd]";
const columnCard =
  "rounded-3xl border border-[#e2a52d]/25 bg-[#1b0d02]/88 p-6 shadow-[0_10px_30px_rgba(226,165,45,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffeec2]/50 hover:shadow-[0_15px_40px_rgba(250,202,76,0.32)] md:p-8";
const columnClass = title ? `${columnBase} ${columnCard}` : columnBase;
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#e2a52d]/30 pb-4">
        <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffeec2] via-[#faca4c] to-[#855a14] shadow-[0_0_10px_rgba(250,202,76,0.55)]" />
        <HeadingTag class="bg-gradient-to-r from-[#fff8e4] via-[#ffeec2] to-[#e2a52d] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class={columnClass}>
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#e2a52d]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffeec2] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e2a52d]/55 bg-gradient-to-br from-[#ffeec2] via-[#faca4c] to-[#855a14] text-sm text-[#0a0501] shadow-[0_5px_15px_rgba(250,202,76,0.4)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class={columnClass}>
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#949494]/35 pb-3 text-xl leading-normal font-black tracking-widest text-[#e1e1e1] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e1e1e1]/60 bg-gradient-to-br from-[#e1e1e1] via-[#949494] to-[#442503] text-sm text-[#0a0501] shadow-[0_5px_15px_rgba(225,225,225,0.4)]">
              💎
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
