---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  iconleft?: string;
  iconright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, iconleft = "🔐", iconright = "💎", label } = Astro.props;

// TITANWIN168: ย้ายชุดสีของแบรนด์ก่อนออกทั้งหมด มาที่ม่วงไททันคู่มงกุฎทองที่วัดจาก
// อาร์ตจริง — ม่วง #a855f7 / #ede4ff / #c084fc / #7c3aed / #6d28d9 / #3b0d73
// คู่ทอง #f2dda3 / #e3c176 กับโครมเงิน #dfe4f0 บนผิว #0a0417 / #160a2b / #22104a /
// #2e1065 เนื้อความ #ddd2f5 ข้อความรอง #a396c9 / #8a7cb5
// คอลัมน์ซ้ายรับม่วงซึ่งเป็นสีหลัก คอลัมน์ขวารับทองเพื่อให้สองแผงแยกกันออกใน
// กล่องเดียว (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของ
// เดิมได้จาก git history)
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ และมีไว้ให้บล็อกนี้แบก
// section ของ docx ได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น <p>: มันตั้งชื่อแผง UI (ฟอร์ม
// เข้าสู่ระบบ, ตารางอ้างอิง) ไม่ใช่ section ของ docx การเลื่อนขึ้นเป็นหัวข้อจะเพิ่ม
// ระดับหัวข้อที่ brief ไม่เคยขอ
//
// รอบนี้ผู้เรียกมีรายเดียวคือ LoginRtpSection ซึ่งเป็น widget ส่งแค่ `label` และใช้
// ค่า default กุญแจ/เพชร ส่วน `iconleft`/`iconright` ยังเปิดเป็น prop ไว้ให้รอบที่
// บล็อกนี้ต้องแบกหัวข้อ docx อิโมจิอยู่ใน <span aria-hidden="true"> แยกจากข้อความ
// ป้ายเสมอ
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ ถ้าไม่มี
// title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");

// ใส่ chrome ของการ์ดเฉพาะตอนบล็อกนี้แบก section ของ docx (`title`) เท่านั้น เวลา
// ถูกใช้เป็นโครงสองคอลัมน์เปล่าๆ — LoginRtpSection ส่งแผงของตัวเองเข้า slot —
// คอลัมน์จะแบนราบไว้ ไม่งั้นหน้าเว็บจะได้การ์ดซ้อนการ์ด
const columnBase = "flex flex-col gap-4 text-left text-base leading-relaxed text-[#ddd2f5]";
const columnCard =
  "rounded-3xl border border-[#6d28d9]/30 bg-[#22104a]/88 p-6 shadow-[0_10px_30px_rgba(109,40,217,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#a855f7]/55 hover:shadow-[0_15px_40px_rgba(227,193,118,0.24)] md:p-8";
const columnClass = title ? `${columnBase} ${columnCard}` : columnBase;
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#6d28d9]/35 pb-4">
        <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ede4ff] via-[#e3c176] to-[#3b0d73] shadow-[0_0_10px_rgba(168,85,247,0.55)]" />
        <HeadingTag class="bg-gradient-to-r from-[#ede4ff] via-[#f2dda3] to-[#a855f7] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class={columnClass}>
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#6d28d9]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#a855f7] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#a855f7]/55 bg-gradient-to-br from-[#ede4ff] via-[#a855f7] to-[#6d28d9] text-sm text-[#0a0417] shadow-[0_5px_15px_rgba(168,85,247,0.4)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class={columnClass}>
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#e3c176]/35 pb-3 text-xl leading-normal font-black tracking-widest text-[#f2dda3] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e3c176]/60 bg-gradient-to-br from-[#dfe4f0] via-[#f2dda3] to-[#8a7cb5] text-sm text-[#0a0417] shadow-[0_5px_15px_rgba(227,193,118,0.35)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
