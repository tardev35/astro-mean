---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  iconleft?: string;
  iconright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, iconleft = "🔑", iconright = "📊", label } = Astro.props;

// 9KPLUS: ย้ายชุดสีฟ้าคู่ทองของแบรนด์ก่อนออกทั้งหมด มาที่แดงนีออนคู่ชมพูบานเย็น —
// แดง #ffe3ee / #f0b9cd / #ff4a74 / #f5003e / #b3022c / #7c1040 คู่ชมพู #ffd8e7 /
// #ff4fa3 บนผิว #120309 / #1f0611 / #4d012c ขอบ #f5003e เนื้อความ #ffe3ee
// ข้อความรอง #f0b9cd
// สองคอลัมน์แยกกันด้วยคู่สีจริงของโลโก้ (ซ้ายรับแดงนีออนของวงแหวนกับตัวอักษร 9K
// ขวารับชมพูบานเย็นของตู้สล็อตกับป้ายนีออนในแบนเนอร์) ตัวหนังสือบนพื้นชมพูสว่างใช้
// #120309 ซึ่งเป็นผิวเข้มสุด
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก
// git history)
//
// `title` เป็นหัวข้อเดียวที่ component นี้ปล่อยออกมาได้ ส่วนหัวคอลัมน์ทั้งสองยังเป็น
// <p>: มันตั้งชื่อแผง UI (ฟอร์มเข้าสู่ระบบ, ตารางอ้างอิง) ไม่ใช่ section ของ docx
// การเลื่อนขึ้นเป็นหัวข้อจะเพิ่มระดับหัวข้อที่ brief ไม่เคยขอ
//
// รอบนี้มีผู้เรียกรายเดียวคือ LoginRtpSection ซึ่งเป็น widget — ส่งแค่ `label` แล้ว
// ใช้ค่า default กุญแจ/ตารางสถิติ บล็อกนี้จึงไม่ปล่อยหัวข้อออกมาเลยบนหน้าแรกรอบนี้
// อิโมจิอยู่ใน <span aria-hidden="true"> แยกจากข้อความป้ายเสมอ
//
// เมื่อส่ง title มา หัวข้อตั้งชื่อ section ให้แล้ว จึงไม่เพิ่ม aria-label ทับ ถ้าไม่มี
// title ให้ section ใช้ `label` เป็นชื่อสำหรับ assistive tech แทน
const sectionLabel = title ? undefined : (label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ");

// ใส่ chrome ของการ์ดเฉพาะตอนบล็อกนี้แบก section ของ docx (`title`) เท่านั้น เวลา
// ถูกใช้เป็นโครงสองคอลัมน์เปล่าๆ — LoginRtpSection ส่งแผงของตัวเองเข้า slot —
// คอลัมน์จะแบนราบไว้ ไม่งั้นหน้าเว็บจะได้การ์ดซ้อนการ์ด
const columnBase = "flex flex-col gap-4 text-left text-base leading-relaxed text-[#ffe3ee]";
const columnCard =
  "rounded-3xl border border-[#f5003e]/60 bg-[#1f0611]/90 p-6 shadow-[0_10px_30px_rgba(124,16,64,0.45)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff4fa3]/70 hover:shadow-[0_15px_40px_rgba(245,0,62,0.32)] md:p-8";
const columnClass = title ? `${columnBase} ${columnCard}` : columnBase;
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#f5003e]/60 pb-4">
        <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd8e7] via-[#ff4fa3] to-[#b3022c] shadow-[0_0_10px_rgba(255,79,163,0.6)]" />
        <HeadingTag class="bg-gradient-to-r from-[#ffe3ee] via-[#f0b9cd] to-[#ff4a74] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class={columnClass}>
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#f5003e]/55 pb-3 text-xl leading-normal font-black tracking-widest text-[#ff4a74] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ff4a74]/55 bg-gradient-to-br from-[#f0b9cd] via-[#f5003e] to-[#7c1040] text-sm text-[#ffe3ee] shadow-[0_5px_15px_rgba(245,0,62,0.45)]">
              {iconleft}
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class={columnClass}>
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#ff4fa3]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffd8e7] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ff4fa3]/60 bg-gradient-to-br from-[#ffd8e7] via-[#ff4fa3] to-[#7c1040] text-sm text-[#120309] shadow-[0_5px_15px_rgba(255,79,163,0.45)]">
              {iconright}
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
