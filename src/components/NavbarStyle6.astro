---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

const logoAlt =
  "โลโก้ CK1968 เป็นวงกลมขอบทองคำนูนบนพื้นดำ กลางวงเป็นตัวอักษร C ทองคำสามมิติคู่กับตัว K สีแดงเลือดหมูขอบทอง ใต้ลงมาเป็นเลข 1968 ทองคำนูน ด้านบนเป็นมงกุฎทองประดับทับทิมแดง ขวาบนเป็นไพ่ K Q J สีแดงเรียงซ้อนกัน ข้างวงมีข้าวหลามตัดแดงและโพดำดำ ล่างสุดเป็นชิปคาสิโนดำ-ทองสองใบกับลูกเต๋าแดงสองลูก";

// CK1968: ย้ายจากทองอำพันออกส้มคู่โครเมียมเงินของแบรนด์ก่อนที่เคยใช้นาวบาร์ตัวนี้
// มาเป็นทองคำคู่แดงเลือดหมูบนดำอมน้ำตาล — ทอง #ffefc4 / #ffd45c / #f0a80c /
// #a76806 / #5d3a05 คู่แดง #ff4b52 / #d4090f / #8c0206 บนผิว #090302 / #170806 /
// #2a100a ขอบ #4d1f0d เนื้อความ #f6e4c0 รอง #cdb494
//
// แดงเป็นสีที่สองจริงไม่ใช่เงาของทอง: ตัว K ในโลโก้เป็นแดงเลือดหมูล้วน มงกุฎประดับ
// ทับทิมแดง และไพ่ในโลโก้เป็นชุดแดงทั้งหมด (vivid ของโลโก้เด่นสุดคือ #a40205 กับ
// #c3020a ซึ่งเป็นแดง ส่วน dominant ของทุกไฟล์เป็นดำอมน้ำตาลซึ่งคือพื้นหลัง ไม่ใช่
// สีเน้น — palette.json จัดอันดับให้ แต่ไม่ได้ตีความให้) เส้นเน้นเมนูจึงไล่จากแดงไปทอง
//
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน
//
// เมนูชุดเดียวใช้ทั้งแถบข้างเดสก์ท็อปและลิ้นชักมือถือ — ไอคอนอยู่ใน array แล้ว
// render เป็น <span aria-hidden> ที่เป็นพี่น้องกับ label ไม่ใช่แทรกในข้อความ
//
// แบรนด์นี้เป็นสล็อต/คาสิโน หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ใน
// src/pages-disabled/ ห้ามมีลิงก์ถึง ส่วน /login กับ /register เป็นหน้า
// interstitial (noindex) ไม่ใช่หน้าเมนู จึงไม่มีรายการเมนูของสองหน้านั้น กฎลำดับ
// "สมัครสมาชิก/เข้าสู่ระบบ ต่อจากโปรโมชั่น" จึงไม่มีผลกับแบรนด์นี้ และ /ทางเข้า
// ยังอยู่ในเมนูตามปกติ
//
// ไอคอนเลือกให้เข้าธีม "มงกุฎ/ไพ่/คาสิโนทองแดง" ของแบรนด์นี้
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "👑" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];
---

<header class="sticky top-0 z-50 w-full font-sans shadow-lg">
  <div class="pointer-events-none absolute top-0 left-0 z-50 hidden h-0 w-full items-start justify-center lg:flex">
    <div
      class="pointer-events-auto flex h-[65px] w-[120px] items-center justify-center rounded-b-3xl border-x border-b border-[#f0a80c] bg-gradient-to-b from-[#2a100a] to-[#090302] shadow-[0_5px_15px_rgba(240,168,12,0.4)]">
      <a href="/" class="drop-shadow-[0_0_8px_rgba(212,9,15,0.55)] transition-transform hover:scale-110">
        <Picture src={mainLogo!} alt={logoAlt} loading="eager" widths={[110, 220, 330]} sizes="110px" class="h-[35px] w-auto" formats={["avif", "webp"]} fallbackFormat="webp" />
      </a>
    </div>
  </div>

  <aside
    class="fixed top-1/2 left-3 z-40 hidden h-[450px] w-[90px] -translate-y-1/2 flex-col items-center justify-center rounded-2xl border border-[#4d1f0d]/90 bg-[#090302]/95 p-2 shadow-[5px_0_20px_rgba(9,3,2,0.85)] backdrop-blur-md lg:flex">
    <div class="relative flex h-full w-full flex-col gap-2 overflow-hidden rounded-xl">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative w-full h-full flex flex-col items-center justify-center rounded-lg transition-all ${isActive(item.path) ? "bg-[#2a100a]" : "hover:bg-[#2a100a]/70"}`}>
            <span aria-hidden="true" class="mb-1 text-3xl drop-shadow-md transition-transform group-hover:scale-110">
              {item.icon}
            </span>
            <span class={`text-xs font-bold transition-colors ${isActive(item.path) ? "text-[#ffd45c]" : "text-[#cdb494] group-hover:text-[#ffd45c]"}`}>{item.name}</span>
            <span
              aria-hidden="true"
              class={`absolute left-0 top-0 h-full w-[3px] bg-gradient-to-b from-[#d4090f] to-[#f0a80c] transition-transform duration-300 origin-top ${isActive(item.path) ? "scale-y-100" : "scale-y-0 group-hover:scale-y-100"}`}
            />
          </a>
        ))
      }
    </div>
  </aside>

  <nav class="relative z-40 flex h-[60px] items-center justify-between border-b border-[#f0a80c]/45 bg-[#170806] px-3 shadow-xl lg:hidden">
    <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 p-2" aria-label="เปิด-ปิดเมนู">
      <span class="hamburger-line h-0.5 w-6 origin-center bg-[#f6e4c0] transition-all duration-300"></span>
      <span class="hamburger-line h-0.5 w-6 bg-[#f6e4c0] transition-all duration-300"></span>
      <span class="hamburger-line h-0.5 w-6 origin-center bg-[#f6e4c0] transition-all duration-300"></span>
    </button>

    <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
      <Picture src={mainLogo!} alt={logoAlt} loading="eager" widths={[96, 192, 288]} sizes="96px" class="h-[30px] w-auto drop-shadow-md" formats={["avif", "webp"]} fallbackFormat="webp" />
    </a>

    <a
      href="/login"
      class="flex h-[32px] items-center justify-center rounded border border-[#f0a80c]/60 bg-gradient-to-r from-[#ffd45c] to-[#a76806] px-4 text-xs font-bold text-[#090302] shadow-[0_0_12px_rgba(240,168,12,0.4)] transition-transform active:scale-95">
      เข้าสู่ระบบ
    </a>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-30 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 left-0 z-50 h-screen w-[260px] -translate-x-full transform overflow-y-auto border-r border-[#f0a80c]/30 bg-[#170806] shadow-[10px_0_30px_rgba(9,3,2,0.9)] transition-transform duration-300 ease-out lg:hidden">
    <div class="flex flex-col space-y-2.5 px-4 pt-16 pb-8">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`sidebar-item flex items-center px-4 py-3 rounded-lg border transition-all ${isActive(item.path) ? "bg-[#2a100a] border-[#f0a80c] text-[#ffd45c] shadow-inner" : "bg-white/5 border-transparent text-[#cdb494] hover:bg-white/10 hover:text-[#ffd45c]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {item.icon}
            </span>
            <span class="text-sm font-bold">{item.name}</span>
          </a>
        ))
      }

      <div class="mt-5 flex flex-col gap-2 border-t border-[#4d1f0d] pt-5">
        <a
          href="/register"
          class="sidebar-item flex justify-center gap-1.5 rounded border border-[#f0a80c]/60 bg-gradient-to-r from-[#ffefc4] via-[#ffd45c] to-[#a76806] py-3 text-sm font-bold text-[#090302] shadow-md transition-transform active:scale-95">
          <span aria-hidden="true">👑</span> สมัครสมาชิกใหม่
        </a>
      </div>
    </div>
  </div>

  <div class="fixed top-4 right-6 z-50 hidden items-center gap-3 lg:flex">
    <a
      href="/login"
      class="group flex items-center gap-1.5 rounded border border-[#d4090f]/60 bg-[#170806]/90 px-6 py-2 text-sm font-bold text-[#ff4b52] shadow-md backdrop-blur-sm transition-all hover:border-[#ffd45c] hover:bg-[#2a100a]/90 hover:text-[#ffd45c]">
      <span aria-hidden="true">🔒</span> เข้าสู่ระบบ
    </a>
    <a
      href="/register"
      class="group flex items-center gap-1.5 rounded border border-[#f0a80c]/60 bg-gradient-to-r from-[#ffefc4] via-[#ffd45c] to-[#a76806] px-6 py-2 text-sm font-bold text-[#090302] shadow-[0_0_15px_rgba(240,168,12,0.4)] transition-all hover:scale-105">
      <span aria-hidden="true">👑</span> สมัครสมาชิก
    </a>
  </div>
</header>

<div class="hidden h-[15px] w-full lg:block"></div>

<style is:global>
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .sidebar-item {
    opacity: 0;
    transform: translateX(-20px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }

  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      transition: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleSidebar = () => {
    hamburgerBtn?.classList.toggle("active");
    sidebar?.classList.toggle("-translate-x-full");
    sidebar?.classList.toggle("translate-x-0");
    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleSidebar);
  overlay?.addEventListener("click", toggleSidebar);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleSidebar();
      }
    });
  });
</script>
