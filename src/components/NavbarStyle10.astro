---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// PABO88: ย้ายจากทองอำพันของ GSYBET (amber-* / #100b03 / #3a2703 / #0a0703 /
// #2a1c04 / #fef08a / #ca8a04) มาเป็นนีออนม่วงคู่ทองของแบรนด์นี้ —
// ม่วง #bf3cfa / #e3b8ff / #8b1fd6 / #4a0b8f บนผิว #0a0118 / #160333 /
// #20064a คู่ทอง #f5c518 / #ffe9a3 / #8f6205 และเงิน #d9d9e3 สำหรับเลข 88
// ให้ตรงกับโลโก้ที่ตัวอักษร PABO เป็นม่วงเมทัลลิกและ 88 เป็นเงิน
//
// เมนูชุดเดียว ไม่แยก desktop/mobile อีกแล้ว — ของเดิมประกาศอาร์เรย์เดียวกัน
// สองรอบ ซึ่งแปลว่าคนถัดไปที่เพิ่มเมนูจะแก้แค่ที่เดียวแล้วหลุดอีกที่
//
// ทุกรายการมีไอคอนเป็น <span aria-hidden> ที่เป็น "พี่น้อง" ของ label ไม่ใช่
// อยู่ในข้อความ — ฝังในข้อความแล้ว screen reader จะอ่านชื่อ emoji ปนชื่อเมนู
//
// PABO88 เป็นเว็บสล็อต หน้า /ตรวจหวย กับ /แนวทาง ปิดอยู่ (อยู่ใน
// src/pages-disabled/) ห้ามมีลิงก์ถึงทั้งสองหน้าในไฟล์นี้
//
// /login กับ /register ยังเป็นหน้า interstitial (noindex) ไม่ใช่หน้าปุ่ม จึง
// ไม่มีรายการเมนูของสองหน้านั้น — ปุ่ม CTA มุมขวาเป็นคนละเรื่อง อยู่ต่อได้
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🚪" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🛡️" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];
---

<div class="hidden w-full border-b border-[#bf3cfa]/30 bg-gradient-to-r from-[#0a0118] via-[#2b0555] to-[#0a0118] px-4 py-1.5 font-sans text-xs font-bold text-[#e3b8ff]/85 lg:block">
  <div class="mx-auto flex max-w-7xl justify-between">
    <div class="flex gap-4">
      <span class="flex items-center gap-1"><span aria-hidden="true" class="text-[#f5c518]">👑</span> PABO88 เว็บสล็อตคัดของดี เกมเด็ดเกินเรื่อง</span>
      <span class="flex items-center gap-1 text-[#4ade80]"><span aria-hidden="true" class="text-[#22c55e]">✔</span> ฝาก-ถอน ออโต้ 24 ชม.</span>
    </div>
    <div class="flex gap-4">
      <a href="/line" class="flex items-center gap-1 transition-colors hover:text-white">ติดต่อแอดมิน LINE: @PABO88</a>
    </div>
  </div>
</div>

<header class="sticky top-2 z-50 mt-2 w-full px-2 font-sans md:px-4">
  <nav
    class="relative mx-auto flex h-[75px] w-full max-w-7xl items-center justify-between rounded-[20px] border border-[#bf3cfa]/40 bg-[#0a0118]/90 px-4 shadow-[0_10px_30px_rgba(191,60,250,0.18)] backdrop-blur-lg xl:px-8">
    <a href="/" class="z-50 flex-shrink-0 transition-transform hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt="โลโก้ PABO88 อักษร PABO สีม่วงเมทัลลิกไล่เงา ต่อด้วยเลข 88 สีเงิน"
            loading="eager"
            fetchpriority="high"
            widths={[130, 260, 390]}
            sizes="(max-width: 1279px) 130px, 150px"
            class="h-[40px] w-auto drop-shadow-[0_0_10px_rgba(191,60,250,0.55)] xl:h-[45px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <span class="text-3xl font-black drop-shadow-[0_0_8px_rgba(191,60,250,0.45)]">
            <span class="bg-gradient-to-b from-[#e3b8ff] to-[#8b1fd6] bg-clip-text text-transparent">PABO</span>
            <span class="bg-gradient-to-b from-[#f5f5f7] to-[#8e8ea3] bg-clip-text text-transparent">88</span>
          </span>
        )
      }
    </a>

    <div class="hidden h-full items-center gap-5 lg:flex xl:gap-7">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1.5 text-sm font-bold tracking-wide transition-colors xl:text-base ${isActive(item.path) ? "text-[#e3b8ff] drop-shadow-[0_0_8px_rgba(191,60,250,0.5)]" : "text-[#ece0ff]/80 hover:text-[#e3b8ff]"}`}>
            <span aria-hidden="true" class="text-base leading-none">
              {item.icon}
            </span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-[18px] left-0 h-[2px] w-full origin-center bg-[#bf3cfa] shadow-[0_0_8px_rgba(191,60,250,0.8)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-50 flex items-center gap-3">
      <a
        href="/login"
        class="hidden items-center justify-center rounded-full border border-[#bf3cfa]/50 bg-[#20064a] px-6 py-2 text-sm font-bold text-[#e3b8ff] shadow-sm transition-all hover:bg-[#bf3cfa]/25 lg:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center rounded-full bg-gradient-to-r from-[#ffe9a3] via-[#f5c518] to-[#8f6205] px-6 py-2 text-sm font-black text-[#1a0430] shadow-[0_0_15px_rgba(245,197,24,0.4)] transition-all hover:scale-105 lg:flex">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[42px] w-[42px] flex-col items-center justify-center gap-[5px] rounded-full border border-[#bf3cfa]/35 bg-gradient-to-b from-[#20064a] to-[#0a0118] shadow-sm lg:hidden"
        aria-label="เปิดเมนู">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#bf3cfa] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#bf3cfa] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#bf3cfa] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div id="fullscreen-menu" class="pointer-events-none fixed inset-0 z-[40] flex flex-col items-center justify-center bg-[#0a0118]/98 opacity-0 backdrop-blur-xl transition-opacity duration-500">
    <div class="flex w-full flex-col items-center space-y-5 px-6">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`fs-item flex items-center gap-3 text-2xl font-black tracking-widest transition-all duration-300 ${isActive(item.path) ? "text-[#e3b8ff] drop-shadow-[0_0_10px_rgba(191,60,250,0.6)]" : "text-white/80 hover:text-white"}`}>
            <span aria-hidden="true" class="text-xl leading-none">
              {item.icon}
            </span>
            <span>{item.name}</span>
          </a>
        ))
      }
      <div class="fs-item mt-4 flex w-full max-w-[280px] flex-col gap-4 pt-6">
        <a
          href="/register"
          class="flex w-full items-center justify-center rounded-full bg-gradient-to-r from-[#ffe9a3] to-[#8f6205] py-3.5 text-lg font-black text-[#1a0430] shadow-[0_0_20px_rgba(245,197,24,0.45)]">
          สมัครสมาชิกใหม่
        </a>
        <a
          href="/login"
          class="flex w-full items-center justify-center rounded-full border-2 border-[#bf3cfa]/50 bg-[#20064a] py-3.5 text-lg font-bold text-[#e3b8ff] transition-colors hover:bg-[#bf3cfa]/25">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  #hamburger-btn.active .line-1 {
    transform: translateY(7px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-7px) rotate(-45deg);
  }

  .fs-item {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .fs-item.show {
    opacity: 1;
    transform: translateY(0);
  }
  .fs-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .fs-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .fs-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .fs-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .fs-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .fs-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .fs-item:nth-child(7) {
    transition-delay: 0.4s;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const fsMenu = document.getElementById("fullscreen-menu");
  const fsItems = document.querySelectorAll(".fs-item");

  const toggleFsMenu = () => {
    hamburgerBtn?.classList.toggle("active");
    fsMenu?.classList.toggle("opacity-0");
    fsMenu?.classList.toggle("pointer-events-none");

    if (!fsMenu?.classList.contains("opacity-0")) {
      document.body.style.overflow = "hidden";
      fsItems.forEach((item) => item.classList.add("show"));
    } else {
      document.body.style.overflow = "";
      fsItems.forEach((item) => item.classList.remove("show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleFsMenu);
  fsItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (!fsMenu?.classList.contains("opacity-0")) toggleFsMenu();
    });
  });
</script>
