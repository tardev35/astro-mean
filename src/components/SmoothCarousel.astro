---
import { Picture } from "astro:assets";

import slideGoldWheel from "../assets/slide1.png";
import slideReferFriend from "../assets/slide2.png";

// ตัวนี้เคยเป็น Swiper: JavaScript 158,890 ไบต์ (86,801 ไบต์เป็นโมดูลที่ config
// ไม่เคยแตะ) เพื่อเลื่อนรูปไปทางข้างตลอดกาล ตอนนี้เป็น CSS animation — เทคนิค
// เดียวกับที่ ticker ประกาศใช้อยู่แล้ว — และ component นี้ไม่ ship JavaScript เลย
// ห้ามเอา Swiper กลับมา
//
// สามอย่างดีขึ้นพร้อมกับจำนวนไบต์:
//   * มันหยุดได้ Swiper รันด้วย `delay: 0` และ `disableOnInteraction: false`
//     ผู้เข้าชมทำอะไรก็ไม่หยุด
//   * มันเคารพ prefers-reduced-motion ซึ่ง transform ที่ JS ขับของ Swiper ทำไม่ได้
//   * สไลด์เป็น markup ธรรมดา crawler และ screen reader จึงเห็นครบทุกใบ
// แต่ละใบบรรยายด้วยสิ่งที่มันเขียนไว้จริง ไม่ใช่ลำดับที่มันอยู่ในลิสต์
// "…ภาพที่ 1" "…ภาพที่ 2" ไม่ได้บอกอะไรผู้ใช้ screen reader นอกจากว่ามีรูปอีก
// เนื้อหาทั้งใบของโปสเตอร์โปรโมชั่นคือตัวหนังสือบนรูป ตัวหนังสือนั้นจึงเป็น alt
//
// GUESS168: แถบนี้ยังใช้ slide1 กับ slide2 คู่เดิม — slide1 ถูก render อยู่แล้วใน
// บล็อก ContentBoxSevenThreeNeumorphism ของหัวข้อ docx ข้อสุดท้าย ส่วน slide2
// มีที่อยู่จริงบนหน้า /promotion แถบนี้จึงเป็นที่เดียวบนหน้าแรกที่ slide2 ปรากฏ
// ทั้งสองใบถูก import อยู่แล้ว แถบนี้จึงไม่ได้เพิ่มไฟล์รูปใหม่ลง dist/ เลย
// ส่วน slide4 กับไฟล์ banner ที่ไม่ใช่ banner1 เป็นอาร์ตค้างของแบรนด์ก่อน
// ห้าม import ที่นี่ — การ import คือการ emit ลง dist/ ถึงจะไม่มีใคร render ก็ตาม
//
// ไฟล์สไลด์บนดิสก์รอบนี้เป็น .png ทั้งชุด จึง import ตามนามสกุลจริง
//
// สไลด์ชุดนี้เป็นแบนเนอร์แนวนอน ให้เห็นพร้อมกัน 2 ช่องบนมือถือ / 3 ช่องบนเดสก์ท็อป
// ที่ max-w-[820px] ค่า --shift ใน stylesheet ข้างล่างคำนวณจากจำนวนรูปต้นฉบับ
// (สองใบรอบนี้) เทียบกับจำนวนช่องที่เห็น: หนึ่งชุดเต็ม = 2 × basis + 2 × gap
// ถ้าเปลี่ยนจำนวนรูปหรือจำนวนช่อง ต้องคิด --shift ใหม่ทั้งสอง breakpoint และปรับ
// duration ตาม
const images = [
  {
    src: slideGoldWheel,
    alt: "โปสเตอร์โปรโมชั่นของ GUESS168 พื้นสีดำตกแต่งด้วยสีทองและแดง หัวเรื่องตัวใหญ่ว่า ปั่นกงล้อรับทองคำ วันละ 1 บาท บรรทัดรองว่า ปั่นได้ทุกวัน วันละ 1 ครั้ง กลางภาพเป็นวงล้อเสี่ยงโชคสีแดงสลับขาว ช่องรางวัลเขียนว่า ทอง 1 บาท 50 บาท 100 บาท 150 บาท 200 บาท 250 บาท 400 บาท 500 บาท 1,000 บาท และ 2,000 บาท ด้านซ้ายเป็นกองทองคำแท่ง ด้านขวาเป็นสร้อยคอทองคำในกล่องกำมะหยี่สีแดง มุมขวาบนเป็นโลโก้ Guess168 และล่างสุดเป็นป้ายไลน์ @Guess168th",
  },
  {
    src: slideReferFriend,
    alt: "โปสเตอร์กิจกรรมของ GUESS168 พื้นสีน้ำเงินอมม่วงโรยด้วยเหรียญทอง ข้อความว่า เปิดแล้วจ้า กิจกรรมชวนเพื่อน ชวนเพื่อน 1 คนรับฟรี 1 บาท วงเล็บว่า เพื่อนที่สมัครต่อไม่จำเป็นต้องฝาก ถัดมาว่า มีแอดมินคอยดูแลลูกค้า ตลอด 24 ชั่วโมง ด้านซ้ายเป็นผู้หญิงสวมชุดสีทอง มุมซ้ายบนเป็นโลโก้ Guess168 แถบล่างสุดเป็นไอคอนธนาคารและข้อความว่า PAY WITH TrueMoney Wallet",
  },
];

// สามชุด: หนึ่งชุดครอบคลุมช่องที่มองเห็นได้เกินพอ บวกชุดที่กำลังเลื่อนเข้า และอีก
// ชุดคลุมจังหวะรีเซ็ต แอนิเมชันเลื่อนไปพอดีหนึ่งชุด ลูปจึงไม่มีรอยต่อให้เห็น
const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();

// สไลด์ทุกใบตรงนี้เป็น lazy: LCP ของหน้าคือ hero banner ใน MainLayout.astro และ
// แถบนี้อยู่ต่ำกว่า fold ลงไปมาก ไม่มีอะไรใน component นี้ที่ควรไปแย่ง priority
//
// ปุ่มหยุดข้างล่างไม่มีต้นทุนทางสายตา: checkbox เข้าถึงได้ด้วยคีย์บอร์ดและ screen
// reader อ่านออก ส่วน label จะปรากฏก็ต่อเมื่อมัน focus แล้ว ผู้ใช้เมาส์ได้ :hover
// pause จาก stylesheet
// (บันทึกอยู่ใน frontmatter เพราะ HTML comment ในเทมเพลตจะถูก ship ไปทุกหน้า)
//
// สองชุดท้ายคือรูปชุดเดิมซ้ำอีก เป็นของตกแต่งที่มีไว้ให้ลูปไม่มีรอยต่อ alt="" บวก
// aria-hidden บนตัวครอบทำให้มันอยู่นอก accessibility tree ถ้าไม่ทำ ประโยคเดียวกัน
// จะถูกอ่านซ้ำสามรอบ
---

<div class="marquee mx-auto w-full max-w-[820px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#fecc02]/60 peer-focus-visible:bg-[#33180a] peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffd54a]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#c58a00]/45 object-cover shadow-[0_10px_30px_rgba(197,138,0,0.28)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 300, 400]}
              sizes="(max-width: 767px) 46vw, 252px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  /* --shift คือหนึ่งชุดเต็มของรูป: สองสไลด์บวกช่องว่างที่ตามมาสองช่อง วัดเทียบ
     กับความกว้างของ track (ซึ่งเท่ากับความกว้างของกล่อง — สไลด์ล้นออกไป ซึ่งเป็น
     จุดประสงค์) ตั้งค่านี้ผิดไปหนึ่งพิกเซลคือสิ่งที่ทำให้ marquee กระตุกทุกรอบลูป
     เขียนเป็น calc ซ้อนตามสูตรตรงๆ แทนการย่อเป็นทศนิยม เพราะฝั่งเดสก์ท็อปหารสาม
     ไม่ลงตัว

     mobile:  2 * ((100% - 12px)/2 + 12px) = 100% + 12px
     desktop: 2 * ((100% - 32px)/3 + 16px) */
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-2 * ((100% - 12px) / 2 + 12px));
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-2 * ((100% - 32px) / 3 + 16px));
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    /* 9 วินาทีต่อสไลด์ คูณสองใบ — ความเร็วต่อสไลด์เท่าเดิมทุกรอบรีแบรนด์ */
    animation: carousel-scroll 18s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  /* `animation: none` ไม่ใช่แค่ paused และไม่ใช่แค่กฎ reduced-motion กลางใน
     global.css: กฎนั้นย่อ duration เหลือ 0.01ms ซึ่งจะดีดแถบไปที่ตำแหน่ง "จบ"
     แทนที่จะปล่อยไว้ที่จุดเริ่ม การฆ่าแอนิเมชันทิ้งเลยคือพฤติกรรมที่ถูกต้องตรงนี้ */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
