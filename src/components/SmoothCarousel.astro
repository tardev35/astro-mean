---
import { Picture } from "astro:assets";

import slideNextGen from "../assets/slide1.png";
import slideCashback from "../assets/slide2.png";
import slideDaily from "../assets/slide3.png";

// ตัวนี้เคยเป็น Swiper: JavaScript 158,890 ไบต์ (86,801 ไบต์เป็นโมดูลที่ config
// ไม่เคยแตะ) เพื่อเลื่อนรูปไปทางข้างตลอดกาล ตอนนี้เป็น CSS animation — เทคนิค
// เดียวกับที่ ticker ประกาศใช้อยู่แล้ว — และ component นี้ไม่ ship JavaScript เลย
// ห้ามเอา Swiper กลับมา
//
// สามอย่างดีขึ้นพร้อมกับจำนวนไบต์:
//   * มันหยุดได้ Swiper รันด้วย `delay: 0` และ `disableOnInteraction: false`
//     ผู้เข้าชมทำอะไรก็ไม่หยุด
//   * มันเคารพ prefers-reduced-motion ซึ่ง transform ที่ JS ขับของ Swiper ทำไม่ได้
//   * สไลด์เป็น markup ธรรมดา crawler และ screen reader จึงเห็นครบทุกใบ
// แต่ละใบบรรยายด้วยสิ่งที่มันเขียนไว้จริง ไม่ใช่ลำดับที่มันอยู่ในลิสต์
// "…ภาพที่ 1" "…ภาพที่ 2" ไม่ได้บอกอะไรผู้ใช้ screen reader นอกจากว่ามีรูปอีก
// เนื้อหาทั้งใบของโปสเตอร์โปรโมชั่นคือตัวหนังสือบนรูป ตัวหนังสือนั้นจึงเป็น alt
//
// GEN4: asset drop รอบนี้มีสไลด์ของแบรนด์นี้สี่ใบ และแถบนี้ถือสามใบแรก — slide1
// (ก้าวสู่มิติใหม่ สล็อตยุค 5G), slide2 (คืนยอดเสีย 5% คืนสูงสุด 99,999 บาท) และ
// slide3 (โปรพิเศษขาประจำ ฝากครบ 3 วัน รับโบนัสทันที 200 บาท) ส่วน slide4
// (ประกาศไม่ใช้บัญชีม้า ฝาก-ถอนแบบ PAYMENT) อยู่ในบล็อก ContentBoxSevenThree*
// ของหน้าแรกแล้ว ไฟล์ banner ที่ไม่ใช่ banner1 เป็นอาร์ตค้างจากแบรนด์ก่อนๆ
// ห้าม import — การ import คือการ emit ลง dist/ ถึงจะไม่มีใคร render ก็ตาม
// สีขอบ/เงาย้ายมาเป็นน้ำเงินอิเล็กทริก #0071d5 ของแบรนด์นี้
//
// แถบนี้ยังถือสไลด์ใบที่หน้าแรกใช้ไปแล้วในบล็อก ContentBoxSevenThree* ด้วย เพราะ
// ทั้งชุดเป็นโปรโมชั่นชุดเดียวกันของ asset drop นี้ และเพดานของ playbook คือ
// สองบล็อก SevenThree จึงมีใบที่ไม่มีบล็อกให้ลง
//
// ไฟล์สไลด์บนดิสก์รอบนี้เป็น .png ทั้งชุด จึง import ตามนามสกุลจริง
//
// สไลด์ชุดนี้เป็นแบนเนอร์แนวนอน 600×250 (2.4:1) ไม่ใช่ภาพจัตุรัสเหมือน drop ก่อน
// จึงให้เห็นพร้อมกัน 1 ช่องบนมือถือ / 2 ช่องบนเดสก์ท็อป (drop ก่อนเป็น 3) ที่
// max-w-[820px] แต่ละใบจึงวาดราวๆ 386px ซึ่งไม่เกินความกว้างจริงของไฟล์ ค่า
// --shift ใน stylesheet ข้างล่างคำนวณจากจำนวนรูปต้นฉบับ (สามใบรอบนี้) เทียบกับ
// จำนวนช่องที่เห็น: หนึ่งชุดเต็ม = 3 × basis + 3 × gap ถ้าเปลี่ยนจำนวนรูปหรือ
// จำนวนช่อง ต้องคิด --shift ใหม่ทั้งสอง breakpoint และปรับ duration ตาม
const images = [
  {
    src: slideNextGen,
    alt: "แบนเนอร์โปรโมชั่นของ GEN4 พื้นไล่สีชมพูอมม่วงมีเงาเส้นขอบฟ้าตึกสูงอยู่ด้านหลัง มุมบนซ้ายเป็นโลโก้ GEN4 ตัวอักษร GEN สีน้ำเงินคู่กับเลข 4 สีแดง ถัดลงมาเป็นข้อความสีม่วงตัวใหญ่ว่า ก้าวสู่มิติใหม่ แล้วต่อด้วยคำว่า GEN4 ในกรอบสีน้ำเงินคู่กับข้อความสีแดงว่า สล็อตยุค 5G ใต้ลงมามีปุ่มสีชมพูเขียนว่า สมัครเลย และบรรทัดว่า สัมผัสความเร็ว แรง บนแพลตฟอร์มสล็อตออนไลน์ที่เหนือระดับ แถวล่างสุดเป็นป้าย PLAY NOW ป้ายร้านแอป และป้ายคำว่า GEN 4 ด้านขวาเป็นผู้หญิงผมยาวสวมแจ็คเก็ตสีแดงยิ้มอยู่ ข้างกันเป็นตัวละครในเกมสามตัว ทั้งนักรบหญิงสวมเครื่องประดับศีรษะขนนก เทพเจ้าแห่งโชคลาภชุดเขียวทอง และนักฟุตบอลชุดแข่งหมายเลข 8",
  },
  {
    src: slideCashback,
    alt: "แบนเนอร์โปรโมชั่นของ GEN4 พื้นไล่สีชมพูอ่อนมีเหรียญทองปลิวอยู่รอบภาพ มุมบนซ้ายเป็นโลโก้ GEN4 ตัวอักษร GEN สีน้ำเงินคู่กับเลข 4 สีแดง ด้านซ้ายเป็นผู้ชายสวมแจ็คเก็ตสีแดงคลี่ธนบัตรดอลลาร์เป็นรูปพัดอยู่ในมือ ข้างกันเป็นถุงเหรียญทองกับลูกศรชี้ขึ้น ตรงกลางเป็นตัวละครนักรบหญิงสวมเครื่องประดับศีรษะขนนก ด้านขวาเป็นข้อความสีชมพูตัวใหญ่ว่า คืนยอดเสีย ตามด้วยตัวเลข 5 เปอร์เซ็นต์ขนาดใหญ่ และบรรทัดว่า คืนสูงสุด 99,999 บาท ใต้ลงมาเป็นกล่องเงื่อนไขสองกล่อง เขียนว่า ฝากขั้นต่ำ 100 บาท คืนยอดเสียทุกวัน 05:00 น. และ เฉพาะหมวดสล็อต ไม่มีเทิร์น ไม่อั้นถอน ถอนได้เต็มที่",
  },
  {
    src: slideDaily,
    alt: "แบนเนอร์โปรโมชั่นของ GEN4 พื้นไล่สีชมพูอ่อนมีเหรียญทองและกล่องของขวัญปลิวอยู่รอบภาพ มุมบนซ้ายเป็นโลโก้ GEN4 ตัวอักษร GEN สีน้ำเงินคู่กับเลข 4 สีแดง ตรงกลางเป็นผู้ชายสวมแจ็คเก็ตสีแดงถือโทรศัพท์มือถือที่หน้าจอมีโลโก้ GEN4 ด้านขวาเป็นข้อความสีม่วงว่า โปรพิเศษ! ตามด้วยคำว่า ขาประจำ ในแถบสีชมพู แล้วต่อด้วย ฝากครบ 3 วัน และ รับโบนัสทันที! คู่กับตัวเลข 200 บาทขนาดใหญ่ มุมล่างซ้ายเป็นข้อความเล็กว่า ยุคของสายบวก ทำไมใครก็ย้ายมา GEN4",
  },
];

// สามชุด: หนึ่งชุดครอบคลุมช่องที่มองเห็นได้เกินพอ บวกชุดที่กำลังเลื่อนเข้า และอีก
// ชุดคลุมจังหวะรีเซ็ต แอนิเมชันเลื่อนไปพอดีหนึ่งชุด ลูปจึงไม่มีรอยต่อให้เห็น
const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();

// สไลด์ทุกใบตรงนี้เป็น lazy: LCP ของหน้าคือ hero banner ใน MainLayout.astro และ
// แถบนี้อยู่ต่ำกว่า fold ลงไปมาก ไม่มีอะไรใน component นี้ที่ควรไปแย่ง priority
//
// ปุ่มหยุดข้างล่างไม่มีต้นทุนทางสายตา: checkbox เข้าถึงได้ด้วยคีย์บอร์ดและ screen
// reader อ่านออก ส่วน label จะปรากฏก็ต่อเมื่อมัน focus แล้ว ผู้ใช้เมาส์ได้ :hover
// pause จาก stylesheet
// (บันทึกอยู่ใน frontmatter เพราะ HTML comment ในเทมเพลตจะถูก ship ไปทุกหน้า)
//
// สองชุดท้ายคือรูปชุดเดิมซ้ำอีก เป็นของตกแต่งที่มีไว้ให้ลูปไม่มีรอยต่อ alt="" บวก
// aria-hidden บนตัวครอบทำให้มันอยู่นอก accessibility tree ถ้าไม่ทำ ประโยคเดียวกัน
// จะถูกอ่านซ้ำสามรอบ
---

<div class="marquee mx-auto w-full max-w-[820px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#01a3f3]/60 peer-focus-visible:bg-[#102a5c] peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#6fd2ff]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#0071d5]/45 object-cover shadow-[0_10px_30px_rgba(0,113,213,0.28)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 400, 600]}
              sizes="(max-width: 767px) 92vw, 386px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  /* --shift คือหนึ่งชุดเต็มของรูป: สามสไลด์บวกช่องว่างที่ตามมาสามช่อง วัดเทียบ
     กับความกว้างของ track (ซึ่งเท่ากับความกว้างของกล่อง — สไลด์ล้นออกไป ซึ่งเป็น
     จุดประสงค์) ตั้งค่านี้ผิดไปหนึ่งพิกเซลคือสิ่งที่ทำให้ marquee กระตุกทุกรอบลูป

     mobile:  3 * (100% + 12px) = 300% + 36px
     desktop: 3 * ((100% - 16px)/2 + 16px) = 150% + 24px */
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-300% - 36px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-150% - 24px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    /* 9 วินาทีต่อสไลด์ คูณสามใบ — ความเร็วต่อสไลด์เท่าเดิมทุกรอบรีแบรนด์ */
    animation: carousel-scroll 27s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  /* `animation: none` ไม่ใช่แค่ paused และไม่ใช่แค่กฎ reduced-motion กลางใน
     global.css: กฎนั้นย่อ duration เหลือ 0.01ms ซึ่งจะดีดแถบไปที่ตำแหน่ง "จบ"
     แทนที่จะปล่อยไว้ที่จุดเริ่ม การฆ่าแอนิเมชันทิ้งเลยคือพฤติกรรมที่ถูกต้องตรงนี้ */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
