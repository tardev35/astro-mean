---
import { Picture } from "astro:assets";

import slideDirect from "../assets/slide1.png";
import slideReferral from "../assets/slide2.png";
import slideNoAgent from "../assets/slide3.png";

// ตัวนี้เคยเป็น Swiper: JavaScript 158,890 ไบต์ (86,801 ไบต์เป็นโมดูลที่ config
// ไม่เคยแตะ) เพื่อเลื่อนรูปไปทางข้างตลอดกาล ตอนนี้เป็น CSS animation — เทคนิค
// เดียวกับที่ ticker ประกาศใช้อยู่แล้ว — และ component นี้ไม่ ship JavaScript เลย
// ห้ามเอา Swiper กลับมา
//
// สามอย่างดีขึ้นพร้อมกับจำนวนไบต์:
//   * มันหยุดได้ Swiper รันด้วย `delay: 0` และ `disableOnInteraction: false`
//     ผู้เข้าชมทำอะไรก็ไม่หยุด
//   * มันเคารพ prefers-reduced-motion ซึ่ง transform ที่ JS ขับของ Swiper ทำไม่ได้
//   * สไลด์เป็น markup ธรรมดา crawler และ screen reader จึงเห็นครบทุกใบ
// แต่ละใบบรรยายด้วยสิ่งที่มันเขียนไว้จริง ไม่ใช่ลำดับที่มันอยู่ในลิสต์
// "…ภาพที่ 1" "…ภาพที่ 2" ไม่ได้บอกอะไรผู้ใช้ screen reader นอกจากว่ามีรูปอีก
// เนื้อหาทั้งใบของโปสเตอร์โปรโมชั่นคือตัวหนังสือบนรูป ตัวหนังสือนั้นจึงเป็น alt
//
// ASHTON168: asset drop รอบนี้มีสไลด์ของแบรนด์นี้สามใบ และแถบนี้ถือครบทั้งสามใบ —
// slide1 (เว็บตรง ลิขสิทธิ์แท้ ฝาก-ถอน AUTO 3 นาที), slide2 (แนะนำเพื่อน รับค่า
// คอมมิชชั่น 3% คืนยอดเสียด้วยระบบ Auto) และ slide3 (สล็อตเว็บตรง ไม่ผ่านเอเยนต์)
// สองใบแรกยังไปปรากฏในบล็อก ContentBoxSevenThree* ของหน้าแรกด้วย เพราะทั้งชุดเป็น
// โปรโมชั่นชุดเดียวกันของ asset drop นี้ ส่วน slide4 เป็นอาร์ตค้างของแบรนด์ก่อน
// ห้าม import ที่นี่ เช่นเดียวกับไฟล์ banner ที่ไม่ใช่ banner1 — การ import คือ
// การ emit ลง dist/ ถึงจะไม่มีใคร render ก็ตาม
// สีขอบ/เงาย้ายมาเป็นทองสว่าง #f5c518 / #c8941a ของแบรนด์นี้
//
// ไฟล์สไลด์บนดิสก์รอบนี้เป็น .png ทั้งชุด จึง import ตามนามสกุลจริง
//
// สไลด์ชุดนี้เป็นภาพจัตุรัส 600×600 (1:1) ไม่ใช่แบนเนอร์แนวนอนเหมือน drop ก่อน
// จึงให้เห็นพร้อมกัน 2 ช่องบนมือถือ / 3 ช่องบนเดสก์ท็อป ที่ max-w-[820px] แต่ละใบ
// จึงวาดราวๆ 252px บนเดสก์ท็อป ซึ่งไม่เกินความกว้างจริงของไฟล์ ค่า --shift ใน
// stylesheet ข้างล่างคำนวณจากจำนวนรูปต้นฉบับ (สามใบรอบนี้) เทียบกับจำนวนช่องที่
// เห็น: หนึ่งชุดเต็ม = 3 × basis + 3 × gap ถ้าเปลี่ยนจำนวนรูปหรือจำนวนช่อง ต้องคิด
// --shift ใหม่ทั้งสอง breakpoint และปรับ duration ตาม
const images = [
  {
    src: slideDirect,
    alt: "โปสเตอร์โปรโมชั่นของ ASHTON168 พื้นสีดำมีลำแสงทองและเหรียญทองปลิวอยู่ ด้านซ้ายเป็นผู้หญิงผมยาวสวมชุดสีทองเมทัลลิก ด้านขวาเป็นข้อความสีขาวว่า เว็บตรง แล้วต่อด้วยข้อความสีทองตัวใหญ่ว่า ลิขสิทธิ์แท้ ถัดลงมาเป็นบรรทัดว่า ฝาก-ถอน AUTO 3 นาที และ ระบบเกมดีสุดใน ASIA ใต้ลงมาเป็นปุ่มขอบทองเขียนว่า สมัครฟรี ไม่มีขั้นต่ำ ตามด้วยบรรทัดเล็กว่า การันตีความมั่นคง 100% แถวล่างสุดเป็นโลโก้ค่ายเกมพันธมิตรสีทองเรียงกันเจ็ดอัน",
  },
  {
    src: slideReferral,
    alt: "โปสเตอร์โปรโมชั่นของ ASHTON168 พื้นสีดำมีริบบิ้นทองและรูปโพดำสีทองปลิวอยู่รอบภาพ ตรงกลางเป็นผู้หญิงผมยาวสวมชุดสีทองประดับเลื่อมและต่างหูทรงข้าวหลามตัด ด้านล่างเป็นข้อความสีขาวตัวใหญ่ว่า แนะนำเพื่อน คู่กับข้อความสีทองว่า รับค่าคอมมิชชั่น และตัวเลข 3 เปอร์เซ็นต์ขนาดใหญ่สีทอง ปิดท้ายด้วยกรอบมนขอบทองเขียนว่า คืนยอดเสียด้วยระบบ Auto",
  },
  {
    src: slideNoAgent,
    alt: "โปสเตอร์โปรโมชั่นของ ASHTON168 พื้นสีดำมีไพ่ ลูกเต๋า และสัญลักษณ์โพดำสีทองปลิวอยู่รอบภาพ ตรงกลางเป็นผู้หญิงผมยาวสวมชุดสีทอง ด้านล่างเป็นข้อความสีทองตัวใหญ่ว่า สล็อตเว็บตรง และ ไม่ผ่านเอเยนต์ ถัดลงมาเป็นกรอบมนขอบทองเขียนว่า จ่ายเต็ม เท่าไหร่ก็ถอนได้ แถวล่างสุดเป็นบรรทัดเล็กสีขาวว่า ฝาก-ถอน ไม่มีขั้นต่ำ ด้วยระบบ AUTO รวดเร็วภายใน 3 วินาที",
  },
];

// สามชุด: หนึ่งชุดครอบคลุมช่องที่มองเห็นได้เกินพอ บวกชุดที่กำลังเลื่อนเข้า และอีก
// ชุดคลุมจังหวะรีเซ็ต แอนิเมชันเลื่อนไปพอดีหนึ่งชุด ลูปจึงไม่มีรอยต่อให้เห็น
const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();

// สไลด์ทุกใบตรงนี้เป็น lazy: LCP ของหน้าคือ hero banner ใน MainLayout.astro และ
// แถบนี้อยู่ต่ำกว่า fold ลงไปมาก ไม่มีอะไรใน component นี้ที่ควรไปแย่ง priority
//
// ปุ่มหยุดข้างล่างไม่มีต้นทุนทางสายตา: checkbox เข้าถึงได้ด้วยคีย์บอร์ดและ screen
// reader อ่านออก ส่วน label จะปรากฏก็ต่อเมื่อมัน focus แล้ว ผู้ใช้เมาส์ได้ :hover
// pause จาก stylesheet
// (บันทึกอยู่ใน frontmatter เพราะ HTML comment ในเทมเพลตจะถูก ship ไปทุกหน้า)
//
// สองชุดท้ายคือรูปชุดเดิมซ้ำอีก เป็นของตกแต่งที่มีไว้ให้ลูปไม่มีรอยต่อ alt="" บวก
// aria-hidden บนตัวครอบทำให้มันอยู่นอก accessibility tree ถ้าไม่ทำ ประโยคเดียวกัน
// จะถูกอ่านซ้ำสามรอบ
---

<div class="marquee mx-auto w-full max-w-[820px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#f5c518]/60 peer-focus-visible:bg-[#2a1c06] peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffe9a3]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#c8941a]/45 object-cover shadow-[0_10px_30px_rgba(245,197,24,0.28)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 300, 400]}
              sizes="(max-width: 767px) 46vw, 252px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  /* --shift คือหนึ่งชุดเต็มของรูป: สามสไลด์บวกช่องว่างที่ตามมาสามช่อง วัดเทียบ
     กับความกว้างของ track (ซึ่งเท่ากับความกว้างของกล่อง — สไลด์ล้นออกไป ซึ่งเป็น
     จุดประสงค์) ตั้งค่านี้ผิดไปหนึ่งพิกเซลคือสิ่งที่ทำให้ marquee กระตุกทุกรอบลูป

     mobile:  3 * ((100% - 12px)/2 + 12px) = 150% + 18px
     desktop: 3 * ((100% - 32px)/3 + 16px) = 100% + 16px */
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-150% - 18px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-100% - 16px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    /* 9 วินาทีต่อสไลด์ คูณสามใบ — ความเร็วต่อสไลด์เท่าเดิมทุกรอบรีแบรนด์ */
    animation: carousel-scroll 27s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  /* `animation: none` ไม่ใช่แค่ paused และไม่ใช่แค่กฎ reduced-motion กลางใน
     global.css: กฎนั้นย่อ duration เหลือ 0.01ms ซึ่งจะดีดแถบไปที่ตำแหน่ง "จบ"
     แทนที่จะปล่อยไว้ที่จุดเริ่ม การฆ่าแอนิเมชันทิ้งเลยคือพฤติกรรมที่ถูกต้องตรงนี้ */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
