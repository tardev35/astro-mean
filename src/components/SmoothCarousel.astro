---
import { Picture } from "astro:assets";

import slideFreeBonus500 from "../assets/slide1.png";
import slideCashback5 from "../assets/slide2.png";

// ตัวนี้เคยเป็น Swiper: JavaScript 158,890 ไบต์ (86,801 ไบต์เป็นโมดูลที่ config
// ไม่เคยแตะ) เพื่อเลื่อนรูปไปทางข้างตลอดกาล ตอนนี้เป็น CSS animation — เทคนิค
// เดียวกับที่ ticker ประกาศใช้อยู่แล้ว — และ component นี้ไม่ ship JavaScript เลย
// ห้ามเอา Swiper กลับมา
//
// สามอย่างดีขึ้นพร้อมกับจำนวนไบต์:
//   * มันหยุดได้ Swiper รันด้วย `delay: 0` และ `disableOnInteraction: false`
//     ผู้เข้าชมทำอะไรก็ไม่หยุด
//   * มันเคารพ prefers-reduced-motion ซึ่ง transform ที่ JS ขับของ Swiper ทำไม่ได้
//   * สไลด์เป็น markup ธรรมดา crawler และ screen reader จึงเห็นครบทุกใบ
// แต่ละแบนเนอร์บรรยายด้วยสิ่งที่มันเขียนไว้จริง ไม่ใช่ลำดับที่มันอยู่ในลิสต์
// "…ภาพที่ 1" "…ภาพที่ 2" ไม่ได้บอกอะไรผู้ใช้ screen reader นอกจากว่ามีรูปอีก
// เนื้อหาทั้งใบของแบนเนอร์โปรโมชั่นคือตัวหนังสือบนรูป ตัวหนังสือนั้นจึงเป็น alt
//
// UOK789: แถบนี้ถือสไลด์ของ asset drop รอบนี้สองใบ — slide1 (รับฟรีโบนัส สูงสุด
// 500.-) และ slide2 (คืนยอดเสียทุกวัน 5%) ส่วน slide3 กับ slide4 เป็นอาร์ตของ
// โปรโมชันอื่นที่หน้า /promotion ถือไว้แล้ว จึงไม่ import ซ้ำที่นี่ — รูปที่ import
// คือรูปที่ถูก emit ถึงจะไม่มีใคร render ก็ตาม เช่นเดียวกับ banner.png และ
// banner2/3/4 ที่ห้ามแตะ สีขอบ/เงาย้ายจากนีออนม่วงมาเป็นเขียวมรกต #2fc44f
//
// slide1 กับ slide2 ถูกใช้ในบล็อก ContentBoxSevenThree สองอันบนหน้าแรกด้วย แต่
// แถบนี้ยังถือทั้งคู่ เพราะถ้าเหลือใบเดียวก็ไม่มีอะไรให้เลื่อน
//
// ไฟล์สไลด์บนดิสก์รอบนี้เป็น .png ทั้งชุด จึง import ตามนามสกุลจริง
//
// สไลด์ชุดนี้เป็นแบนเนอร์จัตุรัส 1:1 ให้เห็นพร้อมกัน 1 ช่องบนมือถือ / 2 ช่องบน
// เดสก์ท็อป แล้วบีบกล่องเป็น max-w-[820px] เพื่อให้แต่ละใบวาดราวๆ 386px ค่า
// --shift ใน stylesheet ข้างล่างคำนวณจากจำนวนรูปต้นฉบับ (สองใบรอบนี้ ไม่ใช่สาม)
// ถ้าเปลี่ยนจำนวนต้องคิด --shift ใหม่ทั้งสอง breakpoint และปรับ duration ตาม
const images = [
  {
    src: slideFreeBonus500,
    alt: "แบนเนอร์โปรโมชั่นของ UOK789 พื้นเขียวมรกตเข้มมีวงล้อรูเล็ตและริบบิ้นทองปลิว เขียนตัวทองใหญ่ว่า รับฟรีโบนัส สูงสุด 500.- เพียงทำการฝากในช่วงเวลา 20:00-22:00 ด้านขวาเป็นหญิงสาวสวมแจ็คเก็ตหนังเงาสีเขียวเข้ม แถบล่างมีโลโก้ทอง UOK789 คำว่า คาสิโนออนไลน์จาก USA โลโก้ช่องทางชำระเงินกับค่ายเกม และป้าย TrueMoney Wallet",
  },
  {
    src: slideCashback5,
    alt: "แบนเนอร์โปรโมชั่นของ UOK789 พื้นเขียวมรกตเข้มมีเหรียญและริบบิ้นทองปลิว เขียนตัวทองใหญ่ว่า คืนยอดเสียทุกวัน 5% ถอนได้ทันที ไม่มีเทิร์น ด้านขวาเป็นหญิงสาวสวมแจ็คเก็ตหนังเงาสีเขียวเข้ม แถบล่างมีโลโก้ทอง UOK789 คำว่า คาสิโนออนไลน์จาก USA โลโก้ช่องทางชำระเงินกับค่ายเกม และป้าย TrueMoney Wallet",
  },
];

// สามชุด: หนึ่งชุดครอบคลุมช่องที่มองเห็นได้เกินพอ บวกชุดที่กำลังเลื่อนเข้า และอีก
// ชุดคลุมจังหวะรีเซ็ต แอนิเมชันเลื่อนไปพอดีหนึ่งชุด ลูปจึงไม่มีรอยต่อให้เห็น
const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();

// สไลด์ทุกใบตรงนี้เป็น lazy: LCP ของหน้าคือ hero banner ใน MainLayout.astro และ
// แถบนี้อยู่ต่ำกว่า fold ลงไปมาก ไม่มีอะไรใน component นี้ที่ควรไปแย่ง priority
//
// ปุ่มหยุดข้างล่างไม่มีต้นทุนทางสายตา: checkbox เข้าถึงได้ด้วยคีย์บอร์ดและ screen
// reader อ่านออก ส่วน label จะปรากฏก็ต่อเมื่อมัน focus แล้ว ผู้ใช้เมาส์ได้ :hover
// pause จาก stylesheet
// (บันทึกอยู่ใน frontmatter เพราะ HTML comment ในเทมเพลตจะถูก ship ไปทุกหน้า)
//
// สองชุดท้ายคือรูปชุดเดิมซ้ำอีก เป็นของตกแต่งที่มีไว้ให้ลูปไม่มีรอยต่อ alt="" บวก
// aria-hidden บนตัวครอบทำให้มันอยู่นอก accessibility tree ถ้าไม่ทำ ประโยคเดียวกัน
// จะถูกอ่านซ้ำสามรอบ
---

<div class="marquee mx-auto w-full max-w-[820px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#2fc44f]/60 peer-focus-visible:bg-[#0c3d18] peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#b6ecbd]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#2fc44f]/35 object-cover shadow-[0_10px_30px_rgba(47,196,79,0.22)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 400, 600]}
              sizes="(max-width: 767px) 92vw, 386px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  /* --shift คือหนึ่งชุดเต็มของรูป: สองสไลด์บวกช่องว่างที่ตามมาสองช่อง วัดเทียบ
     กับความกว้างของ track (ซึ่งเท่ากับความกว้างของกล่อง — สไลด์ล้นออกไป ซึ่งเป็น
     จุดประสงค์) ตั้งค่านี้ผิดไปหนึ่งพิกเซลคือสิ่งที่ทำให้ marquee กระตุกทุกรอบลูป

     mobile:  2 * (100% + 12px) = 200% + 24px
     desktop: 2 * ((100% - 16px)/2 + 16px) = 2 * (50% + 8px) = 100% + 16px */
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-100% - 16px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    /* 9 วินาทีต่อสไลด์ คูณสองใบ — ความเร็วต่อสไลด์เท่าเดิมทุกรอบรีแบรนด์ */
    animation: carousel-scroll 18s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  /* `animation: none` ไม่ใช่แค่ paused และไม่ใช่แค่กฎ reduced-motion กลางใน
     global.css: กฎนั้นย่อ duration เหลือ 0.01ms ซึ่งจะดีดแถบไปที่ตำแหน่ง "จบ"
     แทนที่จะปล่อยไว้ที่จุดเริ่ม การฆ่าแอนิเมชันทิ้งเลยคือพฤติกรรมที่ถูกต้องตรงนี้ */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
