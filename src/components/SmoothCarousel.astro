---
import { Picture } from "astro:assets";

import slideDeposit60 from "../assets/slide2.png";
import slideDeposit80 from "../assets/slide3.png";

// ตัวนี้เคยเป็น Swiper: JavaScript 158,890 ไบต์ (86,801 ไบต์เป็นโมดูลที่ config
// ไม่เคยแตะ) เพื่อเลื่อนรูปไปทางข้างตลอดกาล ตอนนี้เป็น CSS animation — เทคนิค
// เดียวกับที่ ticker ประกาศใช้อยู่แล้ว — และ component นี้ไม่ ship JavaScript เลย
// ห้ามเอา Swiper กลับมา
//
// สามอย่างดีขึ้นพร้อมกับจำนวนไบต์:
//   * มันหยุดได้ Swiper รันด้วย `delay: 0` และ `disableOnInteraction: false`
//     ผู้เข้าชมทำอะไรก็ไม่หยุด
//   * มันเคารพ prefers-reduced-motion ซึ่ง transform ที่ JS ขับของ Swiper ทำไม่ได้
//   * สไลด์เป็น markup ธรรมดา crawler และ screen reader จึงเห็นครบทุกใบ
// แต่ละแบนเนอร์บรรยายด้วยสิ่งที่มันเขียนไว้จริง ไม่ใช่ลำดับที่มันอยู่ในลิสต์
// "…ภาพที่ 1" "…ภาพที่ 2" ไม่ได้บอกอะไรผู้ใช้ screen reader นอกจากว่ามีรูปอีก
// เนื้อหาทั้งใบของแบนเนอร์โปรโมชั่นคือตัวหนังสือบนรูป ตัวหนังสือนั้นจึงเป็น alt
//
// TANGTEM168: แถบนี้ถือ slide2 (ฝาก 60 รับ 300) กับ slide3 (ฝาก 80 รับ 410)
// ส่วน slide4 (Lucky Spin) กับ slide1 (ฝาก 20 รับ 100) ไปอยู่ในบล็อก
// ContentBoxSevenThree สองบล็อกของหน้าแลนดิ้ง แต่ละใบมีบ้านเดียวบนหน้าเว็บ
// การโชว์อาร์ตใบเดียวกันสองที่ในหน้าเดียวคือสิ่งที่การแบ่งแบบนี้เลี่ยงอยู่ ส่วน
// banner / banner2-4 เป็นอาร์ตค้างของแบรนด์ก่อน จึงไม่ถูก import ที่ไหนทั้งสิ้น
// ไฟล์สไลด์บนดิสก์รอบนี้เป็น .png ทั้งชุด (600x600) จึง import ตามนามสกุลจริง
//
// สไลด์ชุดนี้เป็นแบนเนอร์จัตุรัส 600x600 และมีสองใบ จึงให้เห็นพร้อมกัน 1 ช่อง
// บนมือถือ / 2 ช่องบนเดสก์ท็อป แล้วบีบกล่องเป็น max-w-[820px] เพื่อให้แต่ละใบวาด
// ราวๆ 386px ซึ่งต่ำกว่าความกว้างจริงของไฟล์ (600px) จึงไม่มีการอัปสเกล ค่า
// --shift ใน stylesheet ข้างล่างคำนวณจากจำนวนรูปต้นฉบับ (สองใบ) ถ้าเปลี่ยนจำนวน
// ต้องคิด --shift ใหม่ทั้งสอง breakpoint
const images = [
  {
    src: slideDeposit60,
    alt: "แบนเนอร์โปรโมชั่น TANGTEM168 ข้อความ สายสล็อต ห้ามพลาด!! ฝาก 60 รับ 300 ทำยอด 5 เท่า ถอนได้ 300 พร้อมบรรทัดเล่นได้แค่สล็อตเท่านั้น กดรับโบนัสก่อนฝากเท่านั้น และซื้อฟรีสปินได้ รับได้วันละครั้ง ด้านบนเป็นโลโก้ TANGTEM168 รูปเทพเจ้าจีนถือทอง สองข้างเป็นพรีเซนเตอร์หญิงชุดสีชมพูขาว บนพื้นชมพูพาสเทลกับกองเหรียญทอง แถบล่างเรียงโลโก้ค่ายเกม",
  },
  {
    src: slideDeposit80,
    alt: "แบนเนอร์โปรโมชั่น TANGTEM168 ข้อความ ฝากไม่เกินร้อย ได้สอยตังแน่ ฝาก 80 รับ 410 ทำยอด 5 เท่า ถอนได้ 420 พร้อมบรรทัดเล่นได้แค่สล็อตเท่านั้น กดรับโบนัสก่อนฝากเท่านั้น และซื้อฟรีสปินได้ รับได้วันละครั้ง ด้านบนเป็นโลโก้ TANGTEM168 รูปเทพเจ้าจีนถือทอง สองข้างเป็นพรีเซนเตอร์หญิงชุดสีชมพูขาว บนพื้นชมพูพาสเทลกับเพชรสีฟ้า แถบล่างเรียงโลโก้ค่ายเกม",
  },
];

// สี่ชุด: หนึ่งชุดต่อหนึ่งช่องที่มองเห็น บวกชุดที่กำลังเลื่อนเข้า และอีกชุดคลุม
// จังหวะรีเซ็ต แอนิเมชันเลื่อนไปพอดีหนึ่งชุด ลูปจึงไม่มีรอยต่อให้เห็น
const COPIES = 4;
const slides = Array.from({ length: COPIES }, () => images).flat();

// สไลด์ทุกใบตรงนี้เป็น lazy: LCP ของหน้าคือ hero banner ใน MainLayout.astro และ
// แถบนี้อยู่ต่ำกว่า fold ลงไปมาก ไม่มีอะไรใน component นี้ที่ควรไปแย่ง priority
//
// ปุ่มหยุดข้างล่างไม่มีต้นทุนทางสายตา: checkbox เข้าถึงได้ด้วยคีย์บอร์ดและ screen
// reader อ่านออก ส่วน label จะปรากฏก็ต่อเมื่อมัน focus แล้ว ผู้ใช้เมาส์ได้ :hover
// pause จาก stylesheet
// (บันทึกอยู่ใน frontmatter เพราะ HTML comment ในเทมเพลตจะถูก ship ไปทุกหน้า)
---

<div class="marquee mx-auto w-full max-w-[820px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#fcc30b]/60 peer-focus-visible:bg-[#3c0f52] peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#fcc30b]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        // สามชุดท้ายคือรูปชุดเดิมซ้ำอีก เป็นของตกแต่งที่มีไว้ให้ลูปไม่มีรอยต่อ
        // alt="" บวก aria-hidden บนตัวครอบทำให้มันอยู่นอก accessibility tree
        // ถ้าไม่ทำ ประโยคเดียวกันจะถูกอ่านซ้ำสี่รอบ
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#fcc30b]/35 object-cover shadow-[0_10px_30px_rgba(252,195,11,0.22)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 500, 600]}
              sizes="(max-width: 767px) 92vw, 386px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  /* --shift คือหนึ่งชุดเต็มของรูป: สองสไลด์บวกช่องว่างที่ตามมาสองช่อง วัดเทียบ
     กับความกว้างของ track (ซึ่งเท่ากับความกว้างของกล่อง — สไลด์ล้นออกไป ซึ่งเป็น
     จุดประสงค์) ตั้งค่านี้ผิดไปหนึ่งพิกเซลคือสิ่งที่ทำให้ marquee กระตุกทุกรอบลูป

     mobile:  2 * (100% + 12px) = 200% + 24px
     desktop: 2 * ((100% - 16px)/2 + 16px) = 100% + 16px */
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-100% - 16px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 18s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  /* `animation: none` ไม่ใช่แค่ paused และไม่ใช่แค่กฎ reduced-motion กลางใน
     global.css: กฎนั้นย่อ duration เหลือ 0.01ms ซึ่งจะดีดแถบไปที่ตำแหน่ง "จบ"
     แทนที่จะปล่อยไว้ที่จุดเริ่ม การฆ่าแอนิเมชันทิ้งเลยคือพฤติกรรมที่ถูกต้องตรงนี้ */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
