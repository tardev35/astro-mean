---
import { Picture } from "astro:assets";

import slideRefer from "../assets/slide2.png";
import slideCashback from "../assets/slide3.png";

// ตัวนี้เคยเป็น Swiper: JavaScript 158,890 ไบต์ (86,801 ไบต์เป็นโมดูลที่ config
// ไม่เคยแตะ) เพื่อเลื่อนรูปไปทางข้างตลอดกาล ตอนนี้เป็น CSS animation — เทคนิค
// เดียวกับที่ ticker ประกาศใช้อยู่แล้ว — และ component นี้ไม่ ship JavaScript เลย
// ห้ามเอา Swiper กลับมา
//
// สามอย่างดีขึ้นพร้อมกับจำนวนไบต์:
//   * มันหยุดได้ Swiper รันด้วย `delay: 0` และ `disableOnInteraction: false`
//     ผู้เข้าชมทำอะไรก็ไม่หยุด
//   * มันเคารพ prefers-reduced-motion ซึ่ง transform ที่ JS ขับของ Swiper ทำไม่ได้
//   * สไลด์เป็น markup ธรรมดา crawler และ screen reader จึงเห็นครบทุกใบ
// แต่ละแบนเนอร์บรรยายด้วยสิ่งที่มันเขียนไว้จริง ไม่ใช่ลำดับที่มันอยู่ในลิสต์
// "…ภาพที่ 1" "…ภาพที่ 2" ไม่ได้บอกอะไรผู้ใช้ screen reader นอกจากว่ามีรูปอีก
// เนื้อหาทั้งใบของแบนเนอร์โปรโมชั่นคือตัวหนังสือบนรูป ตัวหนังสือนั้นจึงเป็น alt
//
// LONGSAP168 วางสองสไลด์ไว้ตรงนี้: slide2 (แนะนำเพื่อน) กับ slide3 (คืนยอดเสีย)
// ส่วน slide1 และ slide4 ไม่ถูก import ในไฟล์นี้โดยตั้งใจ — แต่ละใบมีบ้านเดียว
// บนหน้าเว็บ อยู่ในบล็อก ContentBoxSevenThree* (slide1 → หัวข้อโต๊ะสด,
// slide4 → หัวข้อฝากไวถอนคล่อง) ตัวแปรตั้งชื่อตามอาร์ตบนรูป ไม่ใช่เลขไฟล์
// เพราะรอบอัพโหลด 2026-08-11 สลับตัวไฟล์ slide1 กับ slide2 จากรอบก่อน
// การโชว์อาร์ตใบเดียวกันสองที่ในหน้าเดียวคือสิ่งที่การแบ่งแบบนี้เลี่ยงอยู่ ค่า
// --shift ใน stylesheet ข้างล่างคำนวณจากจำนวนรูป ถ้าเปลี่ยนจำนวนต้องคิดใหม่ทั้งคู่
const images = [
  {
    src: slideRefer,
    alt: "แบนเนอร์โปรโมชั่น LONGSAP168 แนะนำเพื่อน รับไปเลยสูงสุด 0.7% ยิ่งชวนมาก ยิ่งได้มาก พร้อมภาพเหรียญทองปลิวและผังสายแนะนำเพื่อนเป็นวงกลมสีแดง ไล่จาก YOU ลงมาชั้น 0.5% และชั้น 0.1%",
  },
  {
    src: slideCashback,
    alt: "แบนเนอร์โปรโมชั่น LONGSAP168 คืนยอดเสีย รับไปเลยสูงสุด 5% ของทุกสัปดาห์ สูงสุด 500,000 บาท พร้อมภาพหญิงสาวเสื้อกล้ามดำบนพื้นแดงเข้ม และเหรียญทองลอยรอบตัว",
  },
];

// สามชุด: ชุดหนึ่งอยู่บนจอ ชุดหนึ่งกำลังเลื่อนเข้า อีกชุดคลุมจังหวะรีเซ็ต
// แอนิเมชันเลื่อนไปพอดีหนึ่งชุด ลูปจึงไม่มีรอยต่อให้เห็น
const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();

// สไลด์ทุกใบตรงนี้เป็น lazy: LCP ของหน้าคือ hero banner ใน MainLayout.astro และ
// แถบนี้อยู่ต่ำกว่า fold ลงไปมาก ไม่มีอะไรใน component นี้ที่ควรไปแย่ง priority
//
// ปุ่มหยุดข้างล่างไม่มีต้นทุนทางสายตา: checkbox เข้าถึงได้ด้วยคีย์บอร์ดและ screen
// reader อ่านออก ส่วน label จะปรากฏก็ต่อเมื่อมัน focus แล้ว ผู้ใช้เมาส์ได้ :hover
// pause จาก stylesheet
// (บันทึกอยู่ใน frontmatter เพราะ HTML comment ในเทมเพลตจะถูก ship ไปทุกหน้า)
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#f2b024]/60 peer-focus-visible:bg-[#24100c] peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffd76a]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        // สองชุดท้ายคือรูปสองใบเดิมซ้ำอีก เป็นของตกแต่งที่มีไว้ให้ลูปไม่มีรอยต่อ
        // alt="" บวก aria-hidden บนตัวครอบทำให้มันอยู่นอก accessibility tree
        // ถ้าไม่ทำ ประโยคเดียวกันจะถูกอ่านซ้ำสามรอบ
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#f2b024]/30 object-cover shadow-[0_10px_30px_rgba(242,176,36,0.18)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  /* --shift คือหนึ่งชุดเต็มของรูป: สไลด์สองใบบวกช่องว่างสองช่องระหว่างกัน วัดเทียบ
     กับความกว้างของ track (ซึ่งเท่ากับความกว้างของกล่อง — สไลด์ล้นออกไป ซึ่งเป็น
     จุดประสงค์) ตั้งค่านี้ผิดไปหนึ่งพิกเซลคือสิ่งที่ทำให้ marquee กระตุกทุกรอบลูป

     mobile:  2 * (100% - 12px)/2 + 2*12px = 100% + 12px
     desktop: 2 * (100% - 32px)/3 + 2*16px = 66.6667% + 10.667px */
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-100% - 12px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-66.6667% - 10.667px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 18s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  /* `animation: none` ไม่ใช่แค่ paused และไม่ใช่แค่กฎ reduced-motion กลางใน
     global.css: กฎนั้นย่อ duration เหลือ 0.01ms ซึ่งจะดีดแถบไปที่ตำแหน่ง "จบ"
     แทนที่จะปล่อยไว้ที่จุดเริ่ม การฆ่าแอนิเมชันทิ้งเลยคือพฤติกรรมที่ถูกต้องตรงนี้ */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
