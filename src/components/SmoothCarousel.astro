---
import { Picture } from "astro:assets";

import bannerPgSoft from "../assets/gamedemo11.webp";
import bannerPopularGame from "../assets/gamedemo8.webp";
import bannerSbobet from "../assets/gamedemo12.webp";
import bannerJoker from "../assets/gamedemo17.webp";
import bannerSkywind from "../assets/gamedemo10.webp";
import bannerNewGame from "../assets/gamedemo16.webp";

// ตัวนี้เคยเป็น Swiper: JavaScript 158,890 ไบต์ (86,801 ไบต์เป็นโมดูลที่ config
// ไม่เคยแตะ) เพื่อเลื่อนรูปไปทางข้างตลอดกาล ตอนนี้เป็น CSS animation — เทคนิค
// เดียวกับที่ ticker ประกาศใช้อยู่แล้ว — และ component นี้ไม่ ship JavaScript เลย
// ห้ามเอา Swiper กลับมา
//
// สามอย่างดีขึ้นพร้อมกับจำนวนไบต์:
//   * มันหยุดได้ Swiper รันด้วย `delay: 0` และ `disableOnInteraction: false`
//     ผู้เข้าชมทำอะไรก็ไม่หยุด
//   * มันเคารพ prefers-reduced-motion ซึ่ง transform ที่ JS ขับของ Swiper ทำไม่ได้
//   * สไลด์เป็น markup ธรรมดา crawler และ screen reader จึงเห็นครบทุกใบ
// แต่ละใบบรรยายด้วยสิ่งที่มันเขียนไว้จริง ไม่ใช่ลำดับที่มันอยู่ในลิสต์
// "…ภาพที่ 1" "…ภาพที่ 2" ไม่ได้บอกอะไรผู้ใช้ screen reader นอกจากว่ามีรูปอีก
// เนื้อหาทั้งใบของแบนเนอร์คือตัวหนังสือกับตัวละครบนรูป สิ่งนั้นจึงเป็น alt
//
// ROOM89: แถบนี้ไม่ใช้ slide* — slide1 กับ slide2 ไปอยู่ในบล็อก
// ContentBoxSevenThree* บนหน้าแรกแล้ว (เต็มเพดานสองบล็อกของ playbook) ส่วน slide3
// ปล่อยไม่ใช้บนหน้าแรก ให้หน้า /promotion เอาไปใช้ ส่วนไฟล์ banner ทุกตัวและ slide4
// ของแบรนด์ก่อน เป็นอาร์ตที่มีชื่อของแบรนด์อื่นพิมพ์อยู่บนรูป ห้าม import ที่นี่หรือ
// ที่ไหนก็ตาม — การ import คือการ emit ลง dist/ ถึงจะไม่มีใคร render ก็ตาม
// แถบนี้จึงชี้ไปที่แบนเนอร์ค่ายพันธมิตร/เกมออกใหม่ที่เป็นกลางกับแบรนด์แทน วางต่อท้าย
// ชุด widget ปลายหน้า ซึ่งอยู่หลังหัวข้อ docx ข้อสุดท้ายทั้งหมด
//
// ชุดสีรอบนี้ย้ายจากทองคำคู่แดงเลือดหมูของแบรนด์ก่อน มาเป็นทองคำขัดเงาคู่เงิน
// แพลตินัมบนดำอมน้ำตาล — ขอบสไลด์ #4a3a18 เงา rgba(201,162,39,X) และปุ่มหยุดที่
// โผล่ตอน focus รับทอง #c9a227 / #e6cf72 บนผิว #1a1208
// (ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ตรงนี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่า
// เป็นคอมเมนต์ ดูของเดิมได้จาก git history)
//
// alt ของแต่ละใบบรรยาย "ตัวหนังสือที่พิมพ์อยู่บนรูปจริง" ห้ามเขียนใหม่ให้เข้าธีม
// ของแบรนด์ — นั่นคือ alt ที่ไม่ตรงกับรูป ถ้าวันไหนต้องการให้แถบนี้อ่านเป็นชุดอื่น
// ต้องเปลี่ยนไฟล์รูปก่อน แล้วค่อยเปลี่ยน alt ตาม
//
// แบนเนอร์ชุดนี้เป็นภาพแนวนอน (อัตราส่วนราว 1.58:1) จำนวนช่องที่เห็นคือ 2 ช่องบน
// มือถือ / 3 ช่องบนเดสก์ท็อป ที่ max-w-[820px] ความกว้างของช่องจึงคงที่ sizes ตาม
// ค่านั้น ส่วนความสูงมาจาก width/height ที่ส่งจาก src ของแต่ละไฟล์เอง
//
// ค่า --shift ใน stylesheet ข้างล่างคำนวณจากจำนวนรูปต้นฉบับ (หกใบรอบนี้) เทียบกับ
// จำนวนช่องที่เห็น: หนึ่งชุดเต็ม = 6 × basis + 6 × gap ถ้าเปลี่ยนจำนวนรูปหรือจำนวน
// ช่อง ต้องคิด --shift ใหม่ทั้งสอง breakpoint และปรับ duration ตาม
const images = [
  {
    src: bannerPgSoft,
    alt: "แบนเนอร์ค่ายเกม PG Soft โลโก้พิกเซลตัวอักษร PG ข้างตัวละครหญิงนักรบสวมเครื่องประดับทองและหมวกขนนกสีสด",
  },
  {
    src: bannerPopularGame,
    alt: "แบนเนอร์เกมยอดนิยม ตัวอักษรทองคำว่า POPULAR GAME อยู่กลางภาพ ขนาบด้วยตัวละครกระต่ายถือหีบสมบัติและแมวสวมแว่นกันแดด มีชิปคาสิโนและเหรียญทองปลิวรอบวงกลมสัญลักษณ์โพดำ",
  },
  {
    src: bannerSbobet,
    alt: "แบนเนอร์ค่ายเกม SBOBET โลโก้ตัวอักษรสีขาวบนพื้นดำ ข้างภาพตัวละครหญิงผมบลอนด์สวมชุดกิโมโนสีชมพูถือลูกอมเกลียวสีรุ้ง",
  },
  {
    src: bannerJoker,
    alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรขาวทองข้างนักรบโรมันสวมหมวกขนนกและสิงโตคำรามในสนามประลอง",
  },
  {
    src: bannerSkywind,
    alt: "แบนเนอร์ค่ายเกม Skywind Group โลโก้วงกลมสี่สีข้างแมวกวักญี่ปุ่นสีขาวคอกระพรวนทอง มีไหเงินและป้ายทองท่ามกลางดอกซากุระ",
  },
  {
    src: bannerNewGame,
    alt: "แบนเนอร์เกมออกใหม่ New Game ตัวอักษรขาวบนฟลอร์นีออนสีสด ขนาบด้วยตัวการ์ตูนฟักทองสวมหมวกและโครงกระดูกยิ้ม",
  },
];

// สามชุด: หนึ่งชุดครอบคลุมช่องที่มองเห็นได้เกินพอ บวกชุดที่กำลังเลื่อนเข้า และอีก
// ชุดคลุมจังหวะรีเซ็ต แอนิเมชันเลื่อนไปพอดีหนึ่งชุด ลูปจึงไม่มีรอยต่อให้เห็น
const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();

// สไลด์ทุกใบตรงนี้เป็น lazy: LCP ของหน้าคือ hero banner ใน MainLayout.astro และ
// แถบนี้อยู่ต่ำกว่า fold ลงไปมาก ไม่มีอะไรใน component นี้ที่ควรไปแย่ง priority
//
// ปุ่มหยุดข้างล่างไม่มีต้นทุนทางสายตา: checkbox เข้าถึงได้ด้วยคีย์บอร์ดและ screen
// reader อ่านออก ส่วน label จะปรากฏก็ต่อเมื่อมัน focus แล้ว ผู้ใช้เมาส์ได้ :hover
// pause จาก stylesheet
// (บันทึกอยู่ใน frontmatter เพราะ HTML comment ในเทมเพลตจะถูก ship ไปทุกหน้า)
//
// สองชุดท้ายคือรูปชุดเดิมซ้ำอีก เป็นของตกแต่งที่มีไว้ให้ลูปไม่มีรอยต่อ alt="" บวก
// aria-hidden บนตัวครอบทำให้มันอยู่นอก accessibility tree ถ้าไม่ทำ ประโยคเดียวกัน
// จะถูกอ่านซ้ำสามรอบ
---

<div class="marquee mx-auto w-full max-w-[820px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#c9a227]/60 peer-focus-visible:bg-[#1a1208] peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#e6cf72]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#4a3a18]/70 object-cover shadow-[0_10px_30px_rgba(201,162,39,0.3)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 300, 400, 520]}
              sizes="(max-width: 767px) 46vw, 252px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  /* --shift คือหนึ่งชุดเต็มของรูป: หกสไลด์บวกช่องว่างที่ตามมาหกช่อง วัดเทียบ
     กับความกว้างของ track (ซึ่งเท่ากับความกว้างของกล่อง — สไลด์ล้นออกไป ซึ่งเป็น
     จุดประสงค์) ตั้งค่านี้ผิดไปหนึ่งพิกเซลคือสิ่งที่ทำให้ marquee กระตุกทุกรอบลูป
     เขียนเป็น calc ซ้อนตามสูตรตรงๆ แทนการย่อเป็นทศนิยม เพราะฝั่งเดสก์ท็อปหารสาม
     ไม่ลงตัว

     mobile:  6 * ((100% - 12px)/2 + 12px)
     desktop: 6 * ((100% - 32px)/3 + 16px) */
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-6 * ((100% - 12px) / 2 + 12px));
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-6 * ((100% - 32px) / 3 + 16px));
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    /* 9 วินาทีต่อสไลด์ คูณหกใบ — ความเร็วต่อสไลด์เท่าเดิมทุกรอบรีแบรนด์ */
    animation: carousel-scroll 54s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  /* `animation: none` ไม่ใช่แค่ paused และไม่ใช่แค่กฎ reduced-motion กลางใน
     global.css: กฎนั้นย่อ duration เหลือ 0.01ms ซึ่งจะดีดแถบไปที่ตำแหน่ง "จบ"
     แทนที่จะปล่อยไว้ที่จุดเริ่ม การฆ่าแอนิเมชันทิ้งเลยคือพฤติกรรมที่ถูกต้องตรงนี้ */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
