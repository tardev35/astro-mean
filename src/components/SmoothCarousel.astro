---
import { Picture } from "astro:assets";

import slideCashback from "../assets/slide1.png";
import slideBest from "../assets/slide2.png";
import slideAllCamps from "../assets/slide3.png";

// ตัวนี้เคยเป็น Swiper: JavaScript 158,890 ไบต์ (86,801 ไบต์เป็นโมดูลที่ config
// ไม่เคยแตะ) เพื่อเลื่อนรูปไปทางข้างตลอดกาล ตอนนี้เป็น CSS animation — เทคนิค
// เดียวกับที่ ticker ประกาศใช้อยู่แล้ว — และ component นี้ไม่ ship JavaScript เลย
// ห้ามเอา Swiper กลับมา
//
// สามอย่างดีขึ้นพร้อมกับจำนวนไบต์:
//   * มันหยุดได้ Swiper รันด้วย `delay: 0` และ `disableOnInteraction: false`
//     ผู้เข้าชมทำอะไรก็ไม่หยุด
//   * มันเคารพ prefers-reduced-motion ซึ่ง transform ที่ JS ขับของ Swiper ทำไม่ได้
//   * สไลด์เป็น markup ธรรมดา crawler และ screen reader จึงเห็นครบทุกใบ
// แต่ละใบบรรยายด้วยสิ่งที่มันเขียนไว้จริง ไม่ใช่ลำดับที่มันอยู่ในลิสต์
// "…ภาพที่ 1" "…ภาพที่ 2" ไม่ได้บอกอะไรผู้ใช้ screen reader นอกจากว่ามีรูปอีก
// เนื้อหาทั้งใบของโปสเตอร์โปรโมชั่นคือตัวหนังสือบนรูป ตัวหนังสือนั้นจึงเป็น alt
//
// VIREL168: asset drop รอบนี้มีสไลด์ที่เป็นของแบรนด์นี้จริงสามใบ — slide1
// (คืนยอดเสีย 5% ทุกสัปดาห์), slide2 (เว็บเดิมพันออนไลน์ที่ดีที่สุด) และ slide3
// (รวมทุกค่ายเดิมพัน ไม่มีขั้นต่ำ ครบจบในที่เดียว) ส่วน slide4 กับไฟล์ banner ที่
// ไม่ใช่ banner1 เป็นอาร์ตค้างจากแบรนด์ก่อนๆ ห้าม import — การ import คือการ emit
// ลง dist/ ถึงจะไม่มีใคร render ก็ตาม สีขอบ/เงาย้ายมาเป็นทอง #e2a52d ของแบรนด์นี้
//
// แถบนี้ยังถือ slide1 กับ slide3 ทั้งที่หน้าแรกใช้ไปแล้วในบล็อก
// ContentBoxSevenThree* เพราะทั้งสามใบเป็นชุดโปรโมชั่นชุดเดียวกันของ asset drop นี้
// และ slide2 ไม่มีบล็อก SevenThree ให้ลง (เพดานของ playbook คือสองบล็อก)
//
// ไฟล์สไลด์บนดิสก์รอบนี้เป็น .png ทั้งชุด จึง import ตามนามสกุลจริง
//
// สไลด์ชุดนี้เป็นแบนเนอร์ 600×300 (2:1) ให้เห็นพร้อมกัน 1 ช่องบนมือถือ / 2 ช่องบน
// เดสก์ท็อป แล้วบีบกล่องเป็น max-w-[820px] เพื่อให้แต่ละใบวาดราวๆ 386px ซึ่งยัง
// ไม่เกินความกว้างจริงของไฟล์ ค่า --shift ใน stylesheet ข้างล่างคำนวณจากจำนวนรูป
// ต้นฉบับ (สามใบรอบนี้) ถ้าเปลี่ยนจำนวนต้องคิด --shift ใหม่ทั้งสอง breakpoint
// และปรับ duration ตาม
const images = [
  {
    src: slideCashback,
    alt: "แบนเนอร์โปรโมชั่นของ VIREL168 พื้นดำตัดทอง มุมบนซ้ายเป็นโลโก้ VIREL168 ตรงกลางเป็นผู้หญิงยิ้มผมสองหางทำมือเป็นรูปหัวใจ ยืนข้างกระปุกออมสินรูปหมูสีทองที่มีเหรียญทองร่วงลงมาโดยรอบ ด้านขวาเขียนตัวหนังสือว่า คืนยอดเสีย 5% ทุกสัปดาห์ พร้อมปุ่มสีทองเขียนว่า สมัครสมาชิก",
  },
  {
    src: slideBest,
    alt: "แบนเนอร์โปรโมชั่นของ VIREL168 พื้นดำตัดทอง ด้านซ้ายเป็นผู้หญิงชุดดำถือธนบัตรดอลลาร์คลี่เป็นรูปพัด รายล้อมด้วยเหรียญทองและชิปคาสิโน ด้านขวาเขียนตัวหนังสือว่า เว็บเดิมพันออนไลน์ ที่ดีที่สุด พร้อมปุ่มสีทองเขียนว่า สมัครสมาชิก",
  },
  {
    src: slideAllCamps,
    alt: "แบนเนอร์โปรโมชั่นของ VIREL168 พื้นดำตัดทอง ด้านซ้ายเป็นผู้หญิงชุดสีส้มแดงถือไพ่เอซสี่ใบ ข้างๆ มีมาสคอตเพนกวินสีฟ้าและตัวการ์ตูนตัวเล็กชุดทอง รายล้อมด้วยเหรียญทองและชิปคาสิโน ด้านขวาเขียนตัวหนังสือว่า รวมทุกค่ายเดิมพัน ไม่มีขั้นต่ำ ครบจบในที่เดียว พร้อมปุ่มสีทองเขียนว่า สมัครสมาชิก",
  },
];

// สามชุด: หนึ่งชุดครอบคลุมช่องที่มองเห็นได้เกินพอ บวกชุดที่กำลังเลื่อนเข้า และอีก
// ชุดคลุมจังหวะรีเซ็ต แอนิเมชันเลื่อนไปพอดีหนึ่งชุด ลูปจึงไม่มีรอยต่อให้เห็น
const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();

// สไลด์ทุกใบตรงนี้เป็น lazy: LCP ของหน้าคือ hero banner ใน MainLayout.astro และ
// แถบนี้อยู่ต่ำกว่า fold ลงไปมาก ไม่มีอะไรใน component นี้ที่ควรไปแย่ง priority
//
// ปุ่มหยุดข้างล่างไม่มีต้นทุนทางสายตา: checkbox เข้าถึงได้ด้วยคีย์บอร์ดและ screen
// reader อ่านออก ส่วน label จะปรากฏก็ต่อเมื่อมัน focus แล้ว ผู้ใช้เมาส์ได้ :hover
// pause จาก stylesheet
// (บันทึกอยู่ใน frontmatter เพราะ HTML comment ในเทมเพลตจะถูก ship ไปทุกหน้า)
//
// สองชุดท้ายคือรูปชุดเดิมซ้ำอีก เป็นของตกแต่งที่มีไว้ให้ลูปไม่มีรอยต่อ alt="" บวก
// aria-hidden บนตัวครอบทำให้มันอยู่นอก accessibility tree ถ้าไม่ทำ ประโยคเดียวกัน
// จะถูกอ่านซ้ำสามรอบ
---

<div class="marquee mx-auto w-full max-w-[820px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#e2a52d]/60 peer-focus-visible:bg-[#2e1a04] peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffeec2]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#e2a52d]/40 object-cover shadow-[0_10px_30px_rgba(226,165,45,0.25)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 400, 600]}
              sizes="(max-width: 767px) 92vw, 386px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  /* --shift คือหนึ่งชุดเต็มของรูป: สามสไลด์บวกช่องว่างที่ตามมาสามช่อง วัดเทียบ
     กับความกว้างของ track (ซึ่งเท่ากับความกว้างของกล่อง — สไลด์ล้นออกไป ซึ่งเป็น
     จุดประสงค์) ตั้งค่านี้ผิดไปหนึ่งพิกเซลคือสิ่งที่ทำให้ marquee กระตุกทุกรอบลูป

     mobile:  3 * (100% + 12px) = 300% + 36px
     desktop: 3 * ((100% - 16px)/2 + 16px) = 3 * (50% + 8px) = 150% + 24px */
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-300% - 36px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-150% - 24px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    /* 9 วินาทีต่อสไลด์ คูณสามใบ — ความเร็วต่อสไลด์เท่าเดิมทุกรอบรีแบรนด์ */
    animation: carousel-scroll 27s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  /* `animation: none` ไม่ใช่แค่ paused และไม่ใช่แค่กฎ reduced-motion กลางใน
     global.css: กฎนั้นย่อ duration เหลือ 0.01ms ซึ่งจะดีดแถบไปที่ตำแหน่ง "จบ"
     แทนที่จะปล่อยไว้ที่จุดเริ่ม การฆ่าแอนิเมชันทิ้งเลยคือพฤติกรรมที่ถูกต้องตรงนี้ */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
