---
import { Picture } from "astro:assets";

import slideMigrate from "../assets/slide1.png";
import slideCashbackReferral from "../assets/slide2.png";
import slideSpinPrize from "../assets/slide3.png";
import slideNewMemberSpin from "../assets/slide4.png";

// ตัวนี้เคยเป็น Swiper: JavaScript 158,890 ไบต์ (86,801 ไบต์เป็นโมดูลที่ config
// ไม่เคยแตะ) เพื่อเลื่อนรูปไปทางข้างตลอดกาล ตอนนี้เป็น CSS animation — เทคนิค
// เดียวกับที่ ticker ประกาศใช้อยู่แล้ว — และ component นี้ไม่ ship JavaScript เลย
// ห้ามเอา Swiper กลับมา
//
// สามอย่างดีขึ้นพร้อมกับจำนวนไบต์:
//   * มันหยุดได้ Swiper รันด้วย `delay: 0` และ `disableOnInteraction: false`
//     ผู้เข้าชมทำอะไรก็ไม่หยุด
//   * มันเคารพ prefers-reduced-motion ซึ่ง transform ที่ JS ขับของ Swiper ทำไม่ได้
//   * สไลด์เป็น markup ธรรมดา crawler และ screen reader จึงเห็นครบทุกใบ
// แต่ละแบนเนอร์บรรยายด้วยสิ่งที่มันเขียนไว้จริง ไม่ใช่ลำดับที่มันอยู่ในลิสต์
// "…ภาพที่ 1" "…ภาพที่ 2" ไม่ได้บอกอะไรผู้ใช้ screen reader นอกจากว่ามีรูปอีก
// เนื้อหาทั้งใบของแบนเนอร์โปรโมชั่นคือตัวหนังสือบนรูป ตัวหนังสือนั้นจึงเป็น alt
//
// ORCA789: แถบนี้ถือสไลด์ของ asset drop รอบนี้ครบทั้งสี่ใบ — slide1 (ลูกค้าใหม่
// ย้ายค่าย สุดคุ้ม 100%) slide2 (คืนยอดเสีย 10% / แนะนำเพื่อน รับค่าคอม 1%)
// slide3 (ทุกยอดฝาก 300 ได้ 1 สิทธิ์การหมุน ลุ้นโบนัสสูงสุด 100,000) และ slide4
// (สมาชิกใหม่ ทุกยอดฝาก 50 ได้ 1 สิทธิ์การหมุน ลุ้นโบนัสสูงสุด 10,000)
// สีขอบ/เงาย้ายจากทองคู่แดงของ DEKDDD มาเป็นฟ้านีออน #00abfc ของแบรนด์นี้
//
// ทำไมต้องสี่: slide3 กับ slide2 ถูกใช้ไปแล้วในบล็อก ContentBoxSevenThree* สอง
// อันบนหน้าแรก ถ้าแถบนี้ถือแค่สองใบนั้น หน้าแรกจะโชว์รูปเดิมซ้ำสองรอบ และบน
// เดสก์ท็อปที่เห็นพร้อมกัน 2 ช่องก็จะเห็นทั้งชุดพร้อมกันจนไม่เหลือความเป็น
// carousel เลย อีกสองใบเป็นอาร์ตของ drop รอบนี้เหมือนกัน (หน้า /promotion ใช้ครบ
// ทั้งสี่อยู่แล้ว) จึงไม่ใช่ของค้างจากแบรนด์เก่า
//
// ไฟล์สไลด์บนดิสก์รอบนี้เป็น .png ทั้งชุด จึง import ตามนามสกุลจริง ห้าม import
// banner.png กับ banner2-4 ที่เป็นอาร์ตค้างของแบรนด์ก่อนๆ — รูปที่ import คือรูป
// ที่ถูก emit ถึงจะไม่มีใคร render ก็ตาม
//
// สไลด์ชุดนี้เป็นแบนเนอร์แนวนอน 2:1 ให้เห็นพร้อมกัน 1 ช่องบนมือถือ / 2 ช่องบน
// เดสก์ท็อป แล้วบีบกล่องเป็น max-w-[820px] เพื่อให้แต่ละใบวาดราวๆ 386px ค่า
// --shift ใน stylesheet ข้างล่างคำนวณจากจำนวนรูปต้นฉบับ (สี่ใบ) ถ้าเปลี่ยนจำนวน
// ต้องคิด --shift ใหม่ทั้งสอง breakpoint และปรับ duration ตาม
const images = [
  {
    src: slideMigrate,
    alt: "แบนเนอร์โปรโมชั่นพื้นน้ำเงิน เขียนว่า ลูกค้าใหม่ ย้ายค่าย สุดคุ้ม 100% พร้อมตารางสี่ช่อง ฝาก 50 เครดิตครบ 500 รับ 100 ถอนได้ 250, ฝาก 100 เครดิตครบ 1000 รับ 200 ถอนได้ 500, ฝาก 200 เครดิตครบ 2000 รับ 400 ถอนได้ 1000 และ ฝาก 300 เครดิตครบ 3000 รับ 600 ถอนได้ 1500 ด้านขวาเป็นหญิงสาวชุดฟ้าทำมือเป็นรูปหัวใจ ล้อมด้วยเหรียญทอง โลโก้ ORCA789 มุมขวาบน",
  },
  {
    src: slideCashbackReferral,
    alt: "แบนเนอร์โปรโมชั่นเขียนว่า คืนยอดเสีย 10% และ แนะนำเพื่อน รับค่าคอม 1% ภาพหญิงสาวชุดเขียวเข้ม ล้อมด้วยเหรียญทองและชิปคาสิโนสีฟ้า พื้นหลังน้ำเงินเข้ม โลโก้ ORCA789 อยู่มุมซ้ายบน",
  },
  {
    src: slideSpinPrize,
    alt: "แบนเนอร์โปรโมชั่นเขียนว่า สมาชิกเก่าและใหม่ ทุกยอดฝาก 300 บาท ได้ 1 สิทธิ์การหมุน รางวัลมอเตอร์ไซต์ 2 รางวัล iPhone 2 รางวัล ทองคำ 5 รางวัล ลุ้นรางวัลโบนัสสูงสุด 100,000 ภาพหญิงสาวชุดน้ำเงินถือไพ่ ล้อมด้วยเหรียญทอง มงกุฎ สร้อยทอง มือถือ และมอเตอร์ไซค์ พื้นหลังใต้ทะเลสีน้ำเงิน",
  },
  {
    src: slideNewMemberSpin,
    alt: "แบนเนอร์โปรโมชั่นพื้นน้ำเงิน เขียนว่า สมาชิกใหม่ ทุกยอดฝาก 50 บาท ได้ 1 สิทธิ์การหมุน ลุ้นรางวัลโบนัสสูงสุด 10,000 ภาพหญิงสาวชุดน้ำเงินสวมมงกุฎทอง ด้านหลังเป็นไพ่เอซและวงแหวนเรืองแสง ล้อมด้วยเหรียญทองและชิปคาสิโน โลโก้ ORCA789 มุมซ้ายบน",
  },
];

// สามชุด: หนึ่งชุดครอบคลุมช่องที่มองเห็นได้เกินพอ บวกชุดที่กำลังเลื่อนเข้า และอีก
// ชุดคลุมจังหวะรีเซ็ต แอนิเมชันเลื่อนไปพอดีหนึ่งชุด ลูปจึงไม่มีรอยต่อให้เห็น
const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();

// สไลด์ทุกใบตรงนี้เป็น lazy: LCP ของหน้าคือ hero banner ใน MainLayout.astro และ
// แถบนี้อยู่ต่ำกว่า fold ลงไปมาก ไม่มีอะไรใน component นี้ที่ควรไปแย่ง priority
//
// ปุ่มหยุดข้างล่างไม่มีต้นทุนทางสายตา: checkbox เข้าถึงได้ด้วยคีย์บอร์ดและ screen
// reader อ่านออก ส่วน label จะปรากฏก็ต่อเมื่อมัน focus แล้ว ผู้ใช้เมาส์ได้ :hover
// pause จาก stylesheet
// (บันทึกอยู่ใน frontmatter เพราะ HTML comment ในเทมเพลตจะถูก ship ไปทุกหน้า)
//
// สองชุดท้ายคือรูปชุดเดิมซ้ำอีก เป็นของตกแต่งที่มีไว้ให้ลูปไม่มีรอยต่อ alt="" บวก
// aria-hidden บนตัวครอบทำให้มันอยู่นอก accessibility tree ถ้าไม่ทำ ประโยคเดียวกัน
// จะถูกอ่านซ้ำสามรอบ
---

<div class="marquee mx-auto w-full max-w-[820px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#00abfc]/60 peer-focus-visible:bg-[#08203f] peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#84ccfb]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#00abfc]/35 object-cover shadow-[0_10px_30px_rgba(0,171,252,0.22)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 400, 600]}
              sizes="(max-width: 767px) 92vw, 386px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  /* --shift คือหนึ่งชุดเต็มของรูป: สี่สไลด์บวกช่องว่างที่ตามมาสี่ช่อง วัดเทียบ
     กับความกว้างของ track (ซึ่งเท่ากับความกว้างของกล่อง — สไลด์ล้นออกไป ซึ่งเป็น
     จุดประสงค์) ตั้งค่านี้ผิดไปหนึ่งพิกเซลคือสิ่งที่ทำให้ marquee กระตุกทุกรอบลูป

     mobile:  4 * (100% + 12px) = 400% + 48px
     desktop: 4 * ((100% - 16px)/2 + 16px) = 4 * (50% + 8px) = 200% + 32px */
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-400% - 48px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-200% - 32px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    /* 9 วินาทีต่อสไลด์ คูณสี่ใบ — ความเร็วต่อสไลด์เท่าเดิมทุกรอบรีแบรนด์ */
    animation: carousel-scroll 36s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  /* `animation: none` ไม่ใช่แค่ paused และไม่ใช่แค่กฎ reduced-motion กลางใน
     global.css: กฎนั้นย่อ duration เหลือ 0.01ms ซึ่งจะดีดแถบไปที่ตำแหน่ง "จบ"
     แทนที่จะปล่อยไว้ที่จุดเริ่ม การฆ่าแอนิเมชันทิ้งเลยคือพฤติกรรมที่ถูกต้องตรงนี้ */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
