---
import { Picture } from "astro:assets";

import slideSlotStudios from "../assets/slide1.png";
import slideBaccaratBonus from "../assets/slide2.png";
import slideFootball from "../assets/slide3.png";
import slideBoxing from "../assets/slide4.png";

// ตัวนี้เคยเป็น Swiper: JavaScript 158,890 ไบต์ (86,801 ไบต์เป็นโมดูลที่ config
// ไม่เคยแตะ) เพื่อเลื่อนรูปไปทางข้างตลอดกาล ตอนนี้เป็น CSS animation — เทคนิค
// เดียวกับที่ ticker ประกาศใช้อยู่แล้ว — และ component นี้ไม่ ship JavaScript เลย
// ห้ามเอา Swiper กลับมา
//
// สามอย่างดีขึ้นพร้อมกับจำนวนไบต์:
//   * มันหยุดได้ Swiper รันด้วย `delay: 0` และ `disableOnInteraction: false`
//     ผู้เข้าชมทำอะไรก็ไม่หยุด
//   * มันเคารพ prefers-reduced-motion ซึ่ง transform ที่ JS ขับของ Swiper ทำไม่ได้
//   * สไลด์เป็น markup ธรรมดา crawler และ screen reader จึงเห็นครบทุกใบ
// แต่ละแบนเนอร์บรรยายด้วยสิ่งที่มันเขียนไว้จริง ไม่ใช่ลำดับที่มันอยู่ในลิสต์
// "…ภาพที่ 1" "…ภาพที่ 2" ไม่ได้บอกอะไรผู้ใช้ screen reader นอกจากว่ามีรูปอีก
// เนื้อหาทั้งใบของแบนเนอร์โปรโมชั่นคือตัวหนังสือบนรูป ตัวหนังสือนั้นจึงเป็น alt
//
// BOOST168: แถบนี้ถือสไลด์ของ asset drop รอบนี้ครบทั้งสี่ใบ — slide1 (เว็บสล็อต
// ค่ายดัง) slide2 (เว็บบาคาร่า) slide3 (เว็บแทงบอล) slide4 (แทงมวย)
//
// ทำไมต้องสี่: slide1 กับ slide2 ถูกใช้ไปแล้วในบล็อก ContentBoxSevenThree* สอง
// อันบนหน้าเดียวกัน ถ้าแถบนี้ถือแค่สองใบนั้น หน้าแรกจะโชว์รูปเดิมซ้ำสองรอบ และบน
// เดสก์ท็อปที่เห็นพร้อมกัน 2 ช่องก็จะเห็นทั้งชุดพร้อมกันจนไม่เหลือความเป็น
// carousel เลย อีกสองใบเป็นอาร์ตของ drop รอบนี้เหมือนกัน (หน้า /promotion ใช้ครบ
// ทั้งสี่อยู่แล้ว) จึงไม่ใช่ของค้างจากแบรนด์เก่า
//
// ไฟล์สไลด์บนดิสก์รอบนี้เป็น .png ทั้งชุด จึง import ตามนามสกุลจริง ห้าม import
// banner.png กับ banner2-4 ที่เป็นอาร์ตค้างของแบรนด์ก่อนๆ — รูปที่ import คือรูป
// ที่ถูก emit ถึงจะไม่มีใคร render ก็ตาม
//
// สไลด์ชุดนี้เป็นแบนเนอร์แนวนอน 2:1 ให้เห็นพร้อมกัน 1 ช่องบนมือถือ / 2 ช่องบน
// เดสก์ท็อป แล้วบีบกล่องเป็น max-w-[820px] เพื่อให้แต่ละใบวาดราวๆ 386px ค่า
// --shift ใน stylesheet ข้างล่างคำนวณจากจำนวนรูปต้นฉบับ (สี่ใบ) ถ้าเปลี่ยนจำนวน
// ต้องคิด --shift ใหม่ทั้งสอง breakpoint และปรับ duration ตาม
const images = [
  {
    src: slideSlotStudios,
    alt: "แบนเนอร์โปรโมชั่นแนวนอนพื้นม่วงน้ำเงิน มุมบนซ้ายเป็นโลโก้ BOOST168 พร้อมจรวด ข้อความตัวใหญ่สีขาวขอบทองว่า เว็บสล็อต ค่ายดัง และแถบว่า การันตีคุณภาพ ใต้ลงมาเขียนว่า สล็อตแตกจริง จ่ายจริง ปลอดภัย 100% พร้อมไอคอนสามข้อ ระบบออโต้ฝากถอนรวดเร็วทันใจ มาตรฐานสากลมั่นคงปลอดภัยเชื่อถือได้ และบริการลูกค้า 24 ชั่วโมง ด้านขวาเป็นหญิงสาวชุดม่วงถือไพ่เอสองใบยืนหน้าตู้สล็อต มีเหรียญทองลอยรอบตัว และป้ายสมัครสมาชิกใหม่รับโบนัสสูงสุด 100% ฝาก-ถอนไม่มีขั้นต่ำ แถบล่างเป็นโลโก้ทรูมันนี่วอลเล็ต ค่ายเกม และไลน์ไอดี @boost168",
  },
  {
    src: slideBaccaratBonus,
    alt: "แบนเนอร์โปรโมชั่นแนวนอนพื้นม่วงทอง มุมบนซ้ายเป็นโลโก้ BOOST168 พร้อมจรวด ข้อความตัวใหญ่สีขาวขอบทองว่า เว็บบาคาร่า ครบทุกค่ายชั้นนำ และแถบว่า รวมบาคาร่าออนไลน์ เดิมพันเริ่มต้นเพียง 10 บาท ใต้ลงมาเป็นไอคอนสามข้อ ระบบออโต้ฝากถอนรวดเร็วทันใจ มาตรฐานสากลมั่นคงปลอดภัยเชื่อถือได้ และบริการลูกค้า 24 ชั่วโมง ด้านขวาเป็นหญิงสาวสองคนในชุดราตรีทองและม่วงถือไพ่ มีป้ายสมาชิกใหม่รับโบนัสสูงสุด 100% ฝาก-ถอนรวดเร็วทันใจ แถบล่างเป็นโลโก้ทรูมันนี่วอลเล็ต ค่ายเกมชั้นนำ และไลน์ไอดี @boost168",
  },
  {
    src: slideFootball,
    alt: "แบนเนอร์โปรโมชั่นแนวนอนพื้นน้ำเงินเข้ม มุมบนซ้ายเป็นโลโก้ BOOST168 พร้อมจรวด ข้อความตัวใหญ่สีขาวขอบทองว่า เว็บแทงบอล และแถบว่า ครบทุกลีก ทั่วโลก ราคาดีที่สุด จ่ายจริง ไม่มีโกง ใต้ลงมาเป็นไอคอนสี่ข้อ บอลเดี่ยวขั้นต่ำ 10 บาท บอลสเต็ปค่าน้ำสูง ถ่ายทอดสดดูบอล 24 ชั่วโมง และแทงง่ายผ่านมือถือ มุมล่างซ้ายเป็นป้ายสมัครวันนี้รับโบนัส 100% ด้านขวาเป็นนักฟุตบอลสามคนในชุดแข่งกำลังตะโกนดีใจ ถัดมาเป็นมือถือแสดงหน้าเว็บราคาบอล พร้อมถ้วยรางวัลทอง ลูกฟุตบอล และไลน์ไอดี @boost168",
  },
  {
    src: slideBoxing,
    alt: "แบนเนอร์โปรโมชั่นแนวนอนพื้นเวทีมวยโทนแดงส้ม มุมบนซ้ายเป็นโลโก้ BOOST168 พร้อมจรวด ข้อความตัวใหญ่สีขาวขอบทองว่า แทงมวย และแถบว่า ครบทุกคู่ มันส์ทุกไฟท์ ราคาดีที่สุด จ่ายจริง ไม่อั้น ใต้ลงมาเป็นไอคอนสี่ข้อ ราคาดีที่สุดจ่ายจริงไม่อั้น อัปเดตราคาน้ำทันทุกคู่ทุกสนาม ถ่ายทอดสดครบทุกสนาม และแทงสะดวกผ่านมือถือ 24 ชั่วโมง มุมล่างซ้ายเป็นป้ายสมัครวันนี้รับโบนัส 100% สูงสุด 1,000 บาท ด้านขวาเป็นนักมวยไทยสองคนกำลังปะทะเข่ากลางเวทีที่มีป้าย MUAY THAI ถัดมาเป็นมือถือแสดงหน้าเว็บราคามวย พร้อมถ้วยรางวัลทอง นวมแดง และไลน์ไอดี @boost168",
  },
];

// สามชุด: หนึ่งชุดครอบคลุมช่องที่มองเห็นได้เกินพอ บวกชุดที่กำลังเลื่อนเข้า และอีก
// ชุดคลุมจังหวะรีเซ็ต แอนิเมชันเลื่อนไปพอดีหนึ่งชุด ลูปจึงไม่มีรอยต่อให้เห็น
const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();

// สไลด์ทุกใบตรงนี้เป็น lazy: LCP ของหน้าคือ hero banner ใน MainLayout.astro และ
// แถบนี้อยู่ต่ำกว่า fold ลงไปมาก ไม่มีอะไรใน component นี้ที่ควรไปแย่ง priority
//
// ปุ่มหยุดข้างล่างไม่มีต้นทุนทางสายตา: checkbox เข้าถึงได้ด้วยคีย์บอร์ดและ screen
// reader อ่านออก ส่วน label จะปรากฏก็ต่อเมื่อมัน focus แล้ว ผู้ใช้เมาส์ได้ :hover
// pause จาก stylesheet
// (บันทึกอยู่ใน frontmatter เพราะ HTML comment ในเทมเพลตจะถูก ship ไปทุกหน้า)
//
// สองชุดท้ายคือรูปชุดเดิมซ้ำอีก เป็นของตกแต่งที่มีไว้ให้ลูปไม่มีรอยต่อ alt="" บวก
// aria-hidden บนตัวครอบทำให้มันอยู่นอก accessibility tree ถ้าไม่ทำ ประโยคเดียวกัน
// จะถูกอ่านซ้ำสามรอบ
---

<div class="marquee mx-auto w-full max-w-[820px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#ffc233]/60 peer-focus-visible:bg-[#18204a] peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffe680]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#ffc233]/35 object-cover shadow-[0_10px_30px_rgba(255,194,51,0.22)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 400, 600]}
              sizes="(max-width: 767px) 92vw, 386px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  /* --shift คือหนึ่งชุดเต็มของรูป: สี่สไลด์บวกช่องว่างที่ตามมาสี่ช่อง วัดเทียบ
     กับความกว้างของ track (ซึ่งเท่ากับความกว้างของกล่อง — สไลด์ล้นออกไป ซึ่งเป็น
     จุดประสงค์) ตั้งค่านี้ผิดไปหนึ่งพิกเซลคือสิ่งที่ทำให้ marquee กระตุกทุกรอบลูป

     mobile:  4 * (100% + 12px) = 400% + 48px
     desktop: 4 * ((100% - 16px)/2 + 16px) = 4 * (50% + 8px) = 200% + 32px */
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-400% - 48px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-200% - 32px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    /* 9 วินาทีต่อสไลด์ คูณสี่ใบ — ความเร็วต่อสไลด์เท่าเดิมทุกรอบรีแบรนด์ */
    animation: carousel-scroll 36s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  /* `animation: none` ไม่ใช่แค่ paused และไม่ใช่แค่กฎ reduced-motion กลางใน
     global.css: กฎนั้นย่อ duration เหลือ 0.01ms ซึ่งจะดีดแถบไปที่ตำแหน่ง "จบ"
     แทนที่จะปล่อยไว้ที่จุดเริ่ม การฆ่าแอนิเมชันทิ้งเลยคือพฤติกรรมที่ถูกต้องตรงนี้ */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
