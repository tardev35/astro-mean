---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// ASHTON168: ย้ายจากน้ำเงินอิเล็กทริกคู่แดงของแบรนด์ก่อน มาเป็นทองสว่างคู่เงิน
// โครเมียมที่วัดจากอาร์ตของแบรนด์นี้ — ทอง #f5c518 / #ffd75e / #ffe9a3 /
// #a87908 / #c8941a คู่เงิน #e2e5e9 / #f0f2f5 บนผิวไล่เฉด #160e03 → #080502
// ขอบ #2a1c06 เนื้อความ #f0e6d2 (palette.json: vivid ของโลโก้เป็นทอง #dbac1b /
// #fffd94 ส่วน dominant ของแบนเนอร์เป็นดำอมน้ำตาลเกือบสนิท #020100 / #231402)
//
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// รอบนี้การ์ดใบนี้เป็นกล่องหลักของ "หน้าย่อย" ทุกหน้า (about-us, contact-us,
// promotion, ทดลองเล่น, ทางเข้า) และเป็นกล่องที่แบกหัวข้อ docx ข้อ 1 (H1) ของ
// หน้าแรกด้วย — headingSize จึงแยก h1 เป็น text-3xl ออกจาก h2 ที่เป็น text-2xl
//
// การ์ด flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่ wrapper
// <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f5c518]/35 bg-gradient-to-br from-[#160e03]/92 to-[#080502]/88 p-8 text-left text-base leading-relaxed text-[#f0e6d2] shadow-[0_10px_30px_rgba(245,197,24,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffd75e]/70 hover:shadow-[0_15px_40px_rgba(226,229,233,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#a87908]/60 blur-[55px] transition-all duration-500 group-hover:bg-[#f5c518]/45"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#2a1c06]/60 blur-[55px] transition-all duration-500 group-hover:bg-[#e2e5e9]/40"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f5c518]/35 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a3] via-[#f5c518] to-[#e2e5e9] shadow-[0_0_10px_rgba(245,197,24,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fdf6e6] via-[#ffd75e] to-[#e2e5e9] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
