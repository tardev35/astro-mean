---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// LOTTOTAX: ไฟล์นี้เป็น inventory ที่มาถึงรอบนี้ในชุดทองคำคู่แดงเลือดหมูบนดำอมน้ำตาล
// ของแบรนด์ก่อนคนละเจ้า รอบนี้ย้ายทั้งไฟล์มาเป็นน้ำเงินธงชาติคู่แดงบนผิวกรมท่าเข้ม —
// น้ำเงิน #dbeafe / #5c9bf0 / #1e63d8 / #12357e / #0d2559 คู่แดง #ffd9d1 / #e63c28 /
// #a81c04 บนผิว #04091a / #081530 / #0b1b3a / #0f2246 ขอบ #12357e เนื้อความ #e6eefb
//
// น้ำเงินเป็นสีนำ แดงเป็นสีรอง ตามโลโก้จริงที่คำว่า LOTTO เป็นน้ำเงินไล่เฉดและ TAX
// เป็นแดงไล่เฉด — แดงจึงถูกวางไว้ที่สต็อปท้ายของไล่เฉดหัวข้อ ที่ปลายล่างของแถบขีด
// หัวข้อ และที่ออร่ามุมขวาล่างตอน hover ส่วนน้ำเงินถือขอบการ์ด เงา และสต็อปต้น-กลาง
//
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิม
// ได้จาก git history
//
// รอบนี้การ์ดใบนี้แบกหัวข้อ docx ข้อ 1 (H1) ของหน้าแรก — headingSize จึงแยก h1 เป็น
// text-3xl ออกจาก h2 ที่เป็น text-2xl
//
// การ์ด flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่ wrapper
// <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#12357e]/70 bg-gradient-to-br from-[#0f2246]/92 to-[#04091a]/88 p-8 text-left text-base leading-relaxed text-[#e6eefb] shadow-[0_10px_30px_rgba(30,99,216,0.26)] backdrop-blur-xl transition-all duration-500 hover:border-[#1e63d8]/70 hover:shadow-[0_15px_40px_rgba(230,60,40,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#0b1b3a]/70 blur-[55px] transition-all duration-500 group-hover:bg-[#1e63d8]/45"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#12357e]/60 blur-[55px] transition-all duration-500 group-hover:bg-[#e63c28]/40"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#12357e]/70 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#5c9bf0] via-[#1e63d8] to-[#a81c04] shadow-[0_0_10px_rgba(30,99,216,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#dbeafe] via-[#5c9bf0] to-[#e63c28] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
