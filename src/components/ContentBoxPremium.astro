---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// SETH88: ไฟล์นี้เป็น inventory ที่ค้างชุดสีของแบรนด์ก่อนคนละเจ้ามา รอบนี้ย้ายทั้งไฟล์
// มาเป็นทองคำอียิปต์คู่บรอนซ์บนดำอมน้ำตาลของหินวิหาร — ทอง #fdf3d4 / #f7d774 /
// #e0a92b / #a9711a คู่บรอนซ์ #6b4210 บนผิว #0c0703 / #1b1109 / #2a1a0d
// ขอบ #6b4210 เนื้อความ #f0e3cd
//
// แบรนด์นี้ไม่มีสีน้ำเงินอยู่เลย แกนสีที่สองจึงเป็นบรอนซ์เข้ม ไม่ใช่คู่สีตรงข้าม —
// ทองสว่างถือสต็อปต้นของไล่เฉดหัวข้อ ทองหลักถือกลาง และบรอนซ์ถือปลาย
//
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิม
// ได้จาก git history
//
// รอบนี้การ์ดใบนี้แบกหัวข้อ docx ข้อ 1 (H1) ของหน้าแรก — headingSize จึงแยก h1 เป็น
// text-3xl ออกจาก h2 ที่เป็น text-2xl
//
// การ์ด flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่ wrapper
// <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#6b4210]/70 bg-gradient-to-br from-[#1b1109]/92 to-[#0c0703]/88 p-8 text-left text-base leading-relaxed text-[#f0e3cd] shadow-[0_10px_30px_rgba(224,169,43,0.26)] backdrop-blur-xl transition-all duration-500 hover:border-[#e0a92b]/70 hover:shadow-[0_15px_40px_rgba(247,215,116,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#2a1a0d]/70 blur-[55px] transition-all duration-500 group-hover:bg-[#e0a92b]/45"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#6b4210]/60 blur-[55px] transition-all duration-500 group-hover:bg-[#f7d774]/40"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#6b4210]/70 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f7d774] via-[#e0a92b] to-[#6b4210] shadow-[0_0_10px_rgba(224,169,43,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fdf3d4] via-[#f7d774] to-[#a9711a] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
