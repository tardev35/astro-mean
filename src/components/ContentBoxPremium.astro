---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// 9KPLUS: ไฟล์นี้ค้างชุดสีทองคำของแบรนด์ก่อนคนละเจ้ามา รอบนี้ย้ายทั้งไฟล์มาเป็น
// แดงนีออนคู่ชมพูบานเย็นบนพื้นเกือบดำ — ชมพูขาว #ffd8e7 / ชมพูบานเย็น #ff4fa3 /
// แดงนีออน #f5003e / แดงเข้ม #b3022c คู่ชมพูเข้ม #7c1040 บนผิว #120309 / #1f0611 /
// #4d012c ขอบ #7c1040 เนื้อความ #ffe3ee
//
// vivid ของ logo.webp คือ #f5003e คู่ #ffd8e7 / #b3022c จึงเป็นสีเน้นจริงทั้งชุด
// ส่วนชมพูบานเย็น #ff4fa3 มาจากแบนเนอร์กับ slide1 เป็นแกนสีที่สอง — ทองสว่างเดิม
// ถือสต็อปต้นของไล่เฉดหัวข้อ รอบนี้เป็นชมพูขาวถือสต็อปต้นแทน
//
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิม
// ได้จาก git history
//
// รอบนี้การ์ดใบนี้แบกหัวข้อ docx ข้อ 1 (H1) ของหน้าแรก — headingSize จึงแยก h1 เป็น
// text-3xl ออกจาก h2 ที่เป็น text-2xl
//
// การ์ด flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่ wrapper
// <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#7c1040]/70 bg-gradient-to-br from-[#1f0611]/92 to-[#120309]/88 p-8 text-left text-base leading-relaxed text-[#ffe3ee] shadow-[0_10px_30px_rgba(245,0,62,0.26)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5003e]/70 hover:shadow-[0_15px_40px_rgba(255,79,163,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#4d012c]/70 blur-[55px] transition-all duration-500 group-hover:bg-[#f5003e]/45"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#7c1040]/60 blur-[55px] transition-all duration-500 group-hover:bg-[#ff4fa3]/40"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#7c1040]/70 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff4fa3] via-[#f5003e] to-[#7c1040] shadow-[0_0_10px_rgba(245,0,62,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ffd8e7] via-[#ff4fa3] to-[#b3022c] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
