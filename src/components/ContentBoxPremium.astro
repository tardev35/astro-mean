---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// HAPPYSUPERWIN: ไฟล์นี้มาถึงรอบนี้ในชุดส้มเพลิงคู่ทองหลอมของแบรนด์ก่อนหน้า ตอนนี้
// ย้ายทั้งไฟล์มาเป็นแคนดี้มาเจนต้าคู่เหลืองลูกอม — มาเจนต้า #ff5ae6 / #e11ccc /
// #8a1f9e / #4c0d6b คู่เหลือง #ffd83d / #f0b429 บนผิวม่วงองุ่น #0e0119 / #190430 /
// #280747 เนื้อความ #f7e2ff ตัวอักษรสว่าง #fff0fc
//
// เหลืองลูกอมเป็น "สีคู่" ไม่ใช่สีนำ — มันคือตัวอักษร SUPERWIN บนอาร์ตของแบรนด์
// จึงถูกวางไว้ท้ายไล่เฉดหัวข้อและออร่ามุมขวาล่างตอน hover ส่วนมาเจนต้าคือสีของ
// ปุ่มสมัครกับปราสาทพาสเทลบนแบนเนอร์ ซึ่งเป็นแกนกลางของแบรนด์ จึงถือทั้งขอบการ์ด
// เงา และสต็อปกลางของไล่เฉด
//
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิม
// ได้จาก git history
//
// รอบนี้การ์ดใบนี้แบกหัวข้อ docx ข้อ 1 (H1) ของหน้าแรก — headingSize จึงแยก h1 เป็น
// text-3xl ออกจาก h2 ที่เป็น text-2xl
//
// การ์ด flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่ wrapper
// <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#8a1f9e]/45 bg-gradient-to-br from-[#280747]/92 to-[#0e0119]/88 p-8 text-left text-base leading-relaxed text-[#f7e2ff] shadow-[0_10px_30px_rgba(225,28,204,0.26)] backdrop-blur-xl transition-all duration-500 hover:border-[#e11ccc]/70 hover:shadow-[0_15px_40px_rgba(240,180,41,0.22)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#190430]/70 blur-[55px] transition-all duration-500 group-hover:bg-[#e11ccc]/45"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#4c0d6b]/60 blur-[55px] transition-all duration-500 group-hover:bg-[#f0b429]/30"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#8a1f9e]/40 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd83d] via-[#ff5ae6] to-[#4c0d6b] shadow-[0_0_10px_rgba(225,28,204,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fff0fc] via-[#ff5ae6] to-[#ffd83d] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
