---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// AM88K: ย้ายจากทองคู่แดงของ DEKDDD (#eebb1a / #ffe08a / #a3760a คู่ #a80d10 /
// #e01f26 / #5c0201 บนผิว #2a0806 → #0b0100 เนื้อความ #f7e7c8) มาเป็นเขียวมิ้นต์
// คู่ทองของแบรนด์นี้ — มิ้นต์ #8cdcad / #d6fbe8 / #4cb783 / #1d6f47 คู่ทอง #e4b314 /
// #f3db6b / #a8790a บนผิวไล่เฉด #08200f → #04120a เนื้อความ #e6f6ec
//
// การ์ดใบนี้เป็นกล่องหลักของหน้าย่อยทุกหน้ารอบนี้ (about-us / contact-us /
// promotion / ทดลองเล่น / ทางเข้า) และเป็นกล่อง H1 ของหน้าแรกด้วย
//
// การ์ด flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่ wrapper
// <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#8cdcad]/35 bg-gradient-to-br from-[#08200f]/92 to-[#04120a]/88 p-8 text-left text-base leading-relaxed text-[#e6f6ec] shadow-[0_10px_30px_rgba(140,220,173,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#d6fbe8]/70 hover:shadow-[0_15px_40px_rgba(228,179,20,0.35)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#1d6f47]/60 blur-[55px] transition-all duration-500 group-hover:bg-[#8cdcad]/45"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e4b314]/30 blur-[55px] transition-all duration-500 group-hover:bg-[#a8790a]/45"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#8cdcad]/35 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#d6fbe8] via-[#8cdcad] to-[#e4b314] shadow-[0_0_10px_rgba(140,220,173,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#f4fdf8] via-[#8cdcad] to-[#e4b314] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
