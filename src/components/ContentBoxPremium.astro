---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// NEOCLUB88: ย้ายจากน้ำเงินรอยัลคู่ทองของแบรนด์ก่อน มาเป็นทองคลับคู่แพลทินัมตาม
// โลโก้จริง — ทอง #f2cc53 / #ffe89a / #f6d977 / #c39b3c / #a8842c / #8a6415 คู่
// แพลทินัมเงิน #eef1f5 / #c6ccd4 / #8d949e บนผิวเกือบดำ #241303 / #140b02 /
// #0a0602 / #050301 เนื้อความ #ede0c4 หัวข้อไล่เฉด #fbf4e4
//
// แพลทินัมคือสีรองที่แบรนด์ก่อนไม่มี (แบรนด์ก่อนเป็นทองล้วน) จึงถูกวางไว้ในจุดที่
// มองเห็นชัด: สต็อปกลางของไล่เฉดหัวข้อ แถบขีดหัวข้อ และออร่ามุมขวาล่างตอน hover
//
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
// ไม่รู้ว่าเป็นคอมเมนต์ จึง gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิม
// ได้จาก git history
//
// รอบนี้การ์ดใบนี้แบกหัวข้อ docx ข้อ 1 (H1) และข้อ 7 (H2) ของหน้าแรก — headingSize
// จึงแยก h1 เป็น text-3xl ออกจาก h2 ที่เป็น text-2xl
//
// การ์ด flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่ wrapper
// <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a8842c]/45 bg-gradient-to-br from-[#241303]/92 to-[#0a0602]/88 p-8 text-left text-base leading-relaxed text-[#ede0c4] shadow-[0_10px_30px_rgba(195,155,60,0.26)] backdrop-blur-xl transition-all duration-500 hover:border-[#f2cc53]/70 hover:shadow-[0_15px_40px_rgba(230,236,243,0.22)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#140b02]/70 blur-[55px] transition-all duration-500 group-hover:bg-[#c39b3c]/45"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#33230b]/60 blur-[55px] transition-all duration-500 group-hover:bg-[#c6ccd4]/25"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#a8842c]/40 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe89a] via-[#c6ccd4] to-[#a8842c] shadow-[0_0_10px_rgba(242,204,83,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#fbf4e4] via-[#c6ccd4] to-[#f2cc53] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
