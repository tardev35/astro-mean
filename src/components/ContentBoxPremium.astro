---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#59cb13]/30 bg-gradient-to-br from-[#0a2c0d]/92 to-[#020b01]/88 p-8 text-left text-base leading-relaxed text-[#e9f9dc] shadow-[0_10px_30px_rgba(89,203,19,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#f6c445]/60 hover:shadow-[0_15px_40px_rgba(28,90,6,0.34)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#0f3a11]/50 blur-[55px] transition-all duration-500 group-hover:bg-[#1c5a06]/50"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#59cb13]/35 blur-[55px] transition-all duration-500 group-hover:bg-[#8ef04a]/50"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#59cb13]/30 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f6c445] via-[#59cb13] to-[#0f3a11] shadow-[0_0_10px_rgba(89,203,19,0.5)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#dcffc0] via-[#8ef04a] to-[#2c7a08] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
