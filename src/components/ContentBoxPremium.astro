---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// SBOGOOL: ย้ายจากทองสว่างคู่เงินโครเมียมของแบรนด์ก่อน มาเป็นน้ำเงินรอยัล
// สนามไฟของแบรนด์นี้ — น้ำเงิน #1e4bb8 / #2f6fe4 / #5b9cff / #7fb0ff / #0b1f52
// คู่ทอง #f5c518 / #ffe07a / #a87908 คู่เงินโครเมียมจากตัวอักษรโลโก้ #e8eefc /
// #c3cfe6 บนผิวไล่เฉด #071433 → #030b22 ขอบ #0d1f4d เนื้อความ #dce7fb
// (palette.json: vivid ของโลโก้เป็นน้ำเงิน #33559a / #1c4190 / #18449d ส่วน
// dominant ของแบนเนอร์เป็นกรมท่าเกือบดำ #02143c / #021443)
//
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// รอบนี้การ์ดใบนี้เป็นกล่องหลักของ "หน้าย่อย" ทุกหน้า (about-us, contact-us,
// promotion, ทดลองเล่น, ทางเข้า) และเป็นกล่องที่แบกหัวข้อ docx ข้อ 1 (H1) ของ
// หน้าแรกด้วย — headingSize จึงแยก h1 เป็น text-3xl ออกจาก h2 ที่เป็น text-2xl
//
// การ์ด flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่ wrapper
// <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#1e4bb8]/40 bg-gradient-to-br from-[#071433]/92 to-[#030b22]/88 p-8 text-left text-base leading-relaxed text-[#dce7fb] shadow-[0_10px_30px_rgba(30,75,184,0.26)] backdrop-blur-xl transition-all duration-500 hover:border-[#5b9cff]/70 hover:shadow-[0_15px_40px_rgba(245,197,24,0.22)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#0b1f52]/70 blur-[55px] transition-all duration-500 group-hover:bg-[#2f6fe4]/45"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#0d1f4d]/60 blur-[55px] transition-all duration-500 group-hover:bg-[#f5c518]/25"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#1e4bb8]/40 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe07a] via-[#5b9cff] to-[#1e4bb8] shadow-[0_0_10px_rgba(47,111,228,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#eef4ff] via-[#7fb0ff] to-[#f5c518] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
