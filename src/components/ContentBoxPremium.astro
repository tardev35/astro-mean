---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// GEN4: ย้ายจากส้มไฟคู่ทองของแบรนด์ก่อน มาเป็นน้ำเงินอิเล็กทริกที่วัดจากอาร์ตของ
// แบรนด์นี้ — น้ำเงิน #0071d5 / #01a3f3 / #a9ddff / #00408a คู่แดง #e8241c /
// #ff5a33 / #7a1410 บนผิวไล่เฉด #0b1b3a → #050b1a ขอบ #102a5c เนื้อความ #d7e7ff
// (palette.json: vivid ของโลโก้เป็น #006fd5 / #007cdd / #01a3f3 ส่วน dominant
// ของแบนเนอร์เป็นกรมท่าเกือบดำ)
//
// ห้ามพิมพ์ hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความดิบ
//
// รอบนี้การ์ดใบนี้เป็นกล่องหลักของ "หน้าย่อย" ทุกหน้า (about-us, contact-us,
// promotion, ทดลองเล่น, ทางเข้า) ไม่ใช่ของหน้าแรก
//
// การ์ด flatten แล้ว (isolate บนการ์ด + -z-10 บนเลเยอร์ตกแต่ง) ห้ามใส่ wrapper
// <div class="relative z-10"> กลับเข้ามา
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#0071d5]/35 bg-gradient-to-br from-[#0b1b3a]/92 to-[#050b1a]/88 p-8 text-left text-base leading-relaxed text-[#d7e7ff] shadow-[0_10px_30px_rgba(0,113,213,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#01a3f3]/70 hover:shadow-[0_15px_40px_rgba(232,36,28,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#00408a]/60 blur-[55px] transition-all duration-500 group-hover:bg-[#0071d5]/45"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#7a1410]/60 blur-[55px] transition-all duration-500 group-hover:bg-[#e8241c]/40"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#0071d5]/35 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#a9ddff] via-[#0071d5] to-[#e8241c] shadow-[0_0_10px_rgba(0,113,213,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#eaf4ff] via-[#01a3f3] to-[#ff5a33] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
