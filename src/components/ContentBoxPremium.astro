---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#fcc30b]/35 bg-gradient-to-br from-[#3c0f52]/92 to-[#1c0620]/88 p-8 text-left text-base leading-relaxed text-[#f7e6c4] shadow-[0_10px_30px_rgba(252,195,11,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffe9a8]/70 hover:shadow-[0_15px_40px_rgba(126,58,199,0.4)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#7e3ac7]/50 blur-[55px] transition-all duration-500 group-hover:bg-[#54178f]/55"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fcc30b]/35 blur-[55px] transition-all duration-500 group-hover:bg-[#ce5a03]/50"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#fcc30b]/35 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a8] via-[#fcc30b] to-[#7e3ac7] shadow-[0_0_10px_rgba(252,195,11,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ffe9a8] via-[#fcc30b] to-[#ce5a03] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
