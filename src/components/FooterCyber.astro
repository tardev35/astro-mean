---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// โลโก้ตรง fallback เป็น <p> ไม่ใช่หัวข้อ — chrome ห้ามกินแท็กหัวข้อ เพราะรายการ
// h1/h2 ของทุกหน้าถูก diff กับหัวข้อใน docx ตอน verify และ footer ขึ้นทุกหน้า
//
// บล็อก <address> ด้านล่างจงใจไม่ใส่สีของแบรนด์ (ใช้ border-white/15, bg-black/20
// และ opacity ทับสีตัวอักษรที่ inherit มา) — footer ทุก variant ในคลังเป็นพื้นเข้ม
// ทั้งหมด บล็อกนี้จึงลงตัวทุกตัวโดยไม่ต้องแก้ และไม่ทิ้ง hex ของแบรนด์นี้ไว้ให้
// รอบหน้า ป้ายชื่อเป็น <p> ไม่ใช่หัวข้อด้วยเหตุผลเดียวกัน
//
// ORCA789 เป็นเว็บสล็อต ไม่ใช่เว็บหวย — DIRECTORY ด้านล่างจึงไม่มี /ตรวจหวย กับ
// /แนวทาง (สองหน้านั้นอยู่ใน src/pages-disabled/ ไม่มี route จริง)
//
// ORCA789: ย้ายจากม่วงนีออนของ GDK88 (#a855f7 / #5b1497 / #d8b4fe / #c9a6f0 บนผิว
// #0a0118 / #1b0733) มาเป็นฟ้านีออนใต้ทะเลคู่ทอง — #00abfc / #84ccfb / #011dc4
// บนผิว #010614 / #08203f เนื้อความ #dbeafe เมนูรอง #9dc3e6 ทองเน้น #ffd54a
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#00abfc]/40 bg-[#010614] pt-16 pb-8 font-sans text-[#dbeafe]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.14]"
    style="background-image: linear-gradient(#011dc4 1px, transparent 1px), linear-gradient(90deg, #062a6b 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ ORCA789 รูปวาฬออร์ก้าสีดำลายฟ้านีออนกระโดดขึ้นจากน้ำ สวมมงกุฎทองประดับพลอยแดง ด้านขวาเป็นตัวอักษร ORCA ไล่เฉดฟ้าโครเมียมและเลข 789 สีเงิน มีเหรียญทองและใบโคลเวอร์สี่แฉกสีฟ้าประกอบ"
                loading="lazy"
                decoding="async"
                widths={[150, 300, 450]}
                sizes="150px"
                class="h-[52px] w-auto drop-shadow-[0_4px_12px_rgba(0,171,252,0.5)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="text-3xl font-black tracking-widest text-[#84ccfb]">ORCA789</p>
            )
          }
        </a>
        <p class="border-l-2 border-[#00abfc] pl-4 text-sm leading-relaxed text-[#9dc3e6]">
          ORCA789 สล็อตตัวฮิตมาแรง เกมเด็ดครบเครื่อง รวมความตื่นเต้นครบทุกมิติไว้ในที่เดียว ทั้งสล็อตกระแสแรง บาคาร่าสด คาสิโน และแทงบอลออนไลน์ ระบบประมวลผลเร็ว เสถียร ลื่นไหล ฝากถอนออโต้ไฮสปีดจบใน 3 วินาที ไม่ต้องส่งสลิป ไม่ต้องรอแอดมินอนุมัติ
        </p>
        <div class="mt-4 flex gap-3">
          <span class="border border-[#00abfc]/50 bg-[#08203f] px-3 py-1 font-mono text-xs text-[#84ccfb]">ORCA_ALL_MODE</span>
          <span class="border border-[#ffd54a]/50 bg-[#08203f] px-3 py-1 font-mono text-xs text-[#ffd54a]">AUTO_3_SEC</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#f0f9ff] uppercase"><span aria-hidden="true">///</span> DIRECTORY</p>
        <ul class="flex flex-col gap-3 font-mono text-sm text-[#9dc3e6]">
          <li><a href="/" class="transition-colors hover:text-[#84ccfb]"><span aria-hidden="true">&gt;</span> หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#84ccfb]"><span aria-hidden="true">&gt;</span> โปรโมชั่น</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#84ccfb]"><span aria-hidden="true">&gt;</span> ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#84ccfb]"><span aria-hidden="true">&gt;</span> ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#84ccfb]"><span aria-hidden="true">&gt;</span> เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#84ccfb]"><span aria-hidden="true">&gt;</span> ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#f0f9ff] uppercase"><span aria-hidden="true">///</span> SUPPORT_LINK</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          LINE CONNECT
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="/register"
          class="flex w-full items-center justify-center gap-2 bg-gradient-to-r from-[#011dc4] via-[#00abfc] to-[#ffd54a] py-3 font-black text-[#010614] transition-all hover:brightness-110"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          สมัครสมาชิก
        </a>

        <div class="mt-2 font-mono text-xs text-[#9dc3e6]">ACCEPTED_PAYMENTS</div>
        <BankStrip size={28} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#00abfc]/30 pt-6 font-mono text-xs text-[#9dc3e6] md:flex-row">
      <p>SYSTEM_COPYRIGHT &copy; {new Date().getFullYear()} ORCA789</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="hover:text-[#84ccfb]">TERMS_OF_SERVICE</a>
        <a href="/privacy/" class="hover:text-[#84ccfb]">PRIVACY_POLICY</a>
        <a href="#top" class="hover:text-[#84ccfb]">BACK_TO_TOP</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  .font-mono {
    font-family: monospace;
  }
</style>
