---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// โลโก้ตรง fallback เป็น <p> ไม่ใช่หัวข้อ — chrome ห้ามกินแท็กหัวข้อ เพราะรายการ
// h1/h2 ของทุกหน้าถูก diff กับหัวข้อใน docx ตอน verify และ footer ขึ้นทุกหน้า
//
// บล็อก <address> ด้านล่างจงใจไม่ใส่สีของแบรนด์ (ใช้ border-white/15, bg-black/20
// และ opacity ทับสีตัวอักษรที่ inherit มา) — footer ทุก variant ในคลังเป็นพื้นเข้ม
// ทั้งหมด บล็อกนี้จึงลงตัวทุกตัวโดยไม่ต้องแก้ และไม่ทิ้ง hex ของแบรนด์นี้ไว้ให้
// รอบหน้า ป้ายชื่อเป็น <p> ไม่ใช่หัวข้อด้วยเหตุผลเดียวกัน
//
// GDK88 เป็นเว็บสล็อต ไม่ใช่เว็บหวย — DIRECTORY ด้านล่างจึงไม่มี /ตรวจหวย กับ
// /แนวทาง (สองหน้านั้นอยู่ใน src/pages-disabled/ ไม่มี route จริง)
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#a855f7]/40 bg-[#0a0118] pt-16 pb-8 font-sans text-[#ece0ff]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.14]"
    style="background-image: linear-gradient(#5b1497 1px, transparent 1px), linear-gradient(90deg, #2a0f45 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ GDK88 ตัวอักษร GDK สีทองไล่เงาสามมิติต่อด้วยเลข 88 สีม่วงขอบทอง มีมงกุฎทองประดับพลอยสีน้ำเงินอยู่ด้านบน ล้อมด้วยสายฟ้าสีม่วง ลูกเต๋าสีขาว และชิปคาสิโนสีน้ำเงิน"
                loading="lazy"
                decoding="async"
                widths={[150, 300, 450]}
                sizes="150px"
                class="h-[52px] w-auto drop-shadow-[0_4px_12px_rgba(168,85,247,0.5)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="text-3xl font-black tracking-widest text-[#d8b4fe]">GDK88</p>
            )
          }
        </a>
        <p class="border-l-2 border-[#a855f7] pl-4 text-sm leading-relaxed text-[#c9a6f0]">
          GDK88 เว็บสล็อตลื่นจัด รวมค่ายเกมฮิตระดับท็อปไว้ครบในล็อบบี้เดียว เลือกเกมแล้วเข้าหน้าสปินได้ทันทีโดยไม่มีอาการค้างหรือจอดำ ระบบฝากถอนผ่านวอเลทและบัญชีธนาคารแบบไม่กั้นทุน จัดการยอดได้ยืดหยุ่นตามสไตล์ ฝากง่าย ถอนไว เงินเข้าตรงทุกบาทโดยไม่ต้องผ่านแอดมิน
        </p>
        <div class="mt-4 flex gap-3">
          <span class="border border-[#a855f7]/50 bg-[#1b0733] px-3 py-1 font-mono text-xs text-[#d8b4fe]">GDK_ALL_CAMP</span>
          <span class="border border-[#f0b429]/50 bg-[#1b0733] px-3 py-1 font-mono text-xs text-[#ffd85e]">WALLET_NO_LIMIT</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#f3e8ff] uppercase"><span aria-hidden="true">///</span> DIRECTORY</p>
        <ul class="flex flex-col gap-3 font-mono text-sm text-[#c9a6f0]">
          <li><a href="/" class="transition-colors hover:text-[#d8b4fe]"><span aria-hidden="true">&gt;</span> หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#d8b4fe]"><span aria-hidden="true">&gt;</span> โปรโมชั่น</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#d8b4fe]"><span aria-hidden="true">&gt;</span> ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#d8b4fe]"><span aria-hidden="true">&gt;</span> ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#d8b4fe]"><span aria-hidden="true">&gt;</span> เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#d8b4fe]"><span aria-hidden="true">&gt;</span> ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#f3e8ff] uppercase"><span aria-hidden="true">///</span> SUPPORT_LINK</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          LINE CONNECT
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="/register"
          class="flex w-full items-center justify-center gap-2 bg-gradient-to-r from-[#5b1497] via-[#a855f7] to-[#f0b429] py-3 font-black text-[#0f0320] transition-all hover:brightness-110"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          สมัครสมาชิก
        </a>

        <div class="mt-2 font-mono text-xs text-[#c9a6f0]">ACCEPTED_PAYMENTS</div>
        <BankStrip size={28} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#a855f7]/30 pt-6 font-mono text-xs text-[#c9a6f0] md:flex-row">
      <p>SYSTEM_COPYRIGHT &copy; {new Date().getFullYear()} GDK88</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="hover:text-[#d8b4fe]">TERMS_OF_SERVICE</a>
        <a href="/privacy/" class="hover:text-[#d8b4fe]">PRIVACY_POLICY</a>
        <a href="#top" class="hover:text-[#d8b4fe]">BACK_TO_TOP</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  .font-mono {
    font-family: monospace;
  }
</style>
