---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// โลโก้ตรง fallback เคยเป็น <h2> — chrome ห้ามกินแท็กหัวข้อ เพราะรายการ h2 ของ
// ทุกหน้าถูก diff กับหัวข้อใน docx ตอน verify เปลี่ยนเป็น <p> โดยคงคลาสเดิมไว้
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#ff2f28]/35 bg-[#0a0202] pt-16 pb-8 font-sans text-[#f3dede]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.14]"
    style="background-image: linear-gradient(#8f0806 1px, transparent 1px), linear-gradient(90deg, #a97a10 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ ZEED321 ตัวอักษรแดงโครเมียมใต้มงกุฎทอง"
                loading="lazy"
                decoding="async"
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[60px] w-auto drop-shadow-[0_4px_12px_rgba(255,47,40,0.4)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="text-3xl font-black tracking-widest text-[#f5c542]">ZEED321</p>
            )
          }
        </a>
        <p class="border-l-2 border-[#ff2f28] pl-4 text-sm leading-relaxed text-[#c2a0a0]">
          ZEED321 เว็บสล็อตสายมันส์ที่รวมเกมครบมือจากค่ายแท้ไว้ในบัญชีเดียว จังหวะดีทุกการเล่นตั้งแต่เข้าเกมจนถึงสปินสุดท้าย โบนัสแน่นทุกช่วงเวลา ระบบเสถียร ฝาก-ถอนออโต้ เล่นต่อเนื่องได้แบบไม่มีสะดุดทุกอุปกรณ์
        </p>
        <div class="mt-4 flex gap-3">
          <span class="border border-[#ff2f28]/45 bg-[#170506] px-3 py-1 font-mono text-xs text-[#ffe08a]">SLOT_ALL_CAMP</span>
          <span class="border border-[#a97a10]/50 bg-[#170506] px-3 py-1 font-mono text-xs text-[#c2a0a0]">AUTO_24H</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#f5c542] uppercase">/// DIRECTORY</p>
        <ul class="flex flex-col gap-3 font-mono text-sm text-[#c2a0a0]">
          <li><a href="/" class="transition-colors hover:text-[#ff2f28]">> หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#ff2f28]">> โปรโมชั่น</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#ff2f28]">> ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#ff2f28]">> ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#ff2f28]">> เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#ff2f28]">> ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#f5c542] uppercase">/// SUPPORT_LINK</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          LINE CONNECT
        </a>

        <a
          href="/register"
          class="flex w-full items-center justify-center gap-2 bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#a97a10] py-3 font-black text-[#2a0605] transition-all hover:brightness-110"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          สมัครสมาชิก
        </a>

        <div class="mt-2 font-mono text-xs text-[#c2a0a0]">ACCEPTED_PAYMENTS</div>
        <BankStrip size={28} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#ff2f28]/25 pt-6 font-mono text-xs text-[#c2a0a0] md:flex-row">
      <p>SYSTEM_COPYRIGHT &copy; {new Date().getFullYear()} ZEED321</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="hover:text-[#ff2f28]">TERMS_OF_SERVICE</a>
        <a href="/privacy/" class="hover:text-[#ff2f28]">PRIVACY_POLICY</a>
        <a href="#top" class="hover:text-[#ff2f28]">BACK_TO_TOP</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  .font-mono {
    font-family: monospace;
  }
</style>
