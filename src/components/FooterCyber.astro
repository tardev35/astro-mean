---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// โลโก้ตรง fallback เคยเป็น <h2> — chrome ห้ามกินแท็กหัวข้อ เพราะรายการ h2 ของ
// ทุกหน้าถูก diff กับหัวข้อใน docx ตอน verify เปลี่ยนเป็น <p> โดยคงคลาสเดิมไว้
//
// บล็อก <address> ด้านล่างจงใจไม่ใส่สีของแบรนด์ (ใช้ border-white/15, bg-black/20
// และ opacity ทับสีตัวอักษรที่ inherit มา) — footer ทุก variant ในคลังเป็นพื้นเข้ม
// ทั้งหมด บล็อกนี้จึงลงตัวทุกตัวโดยไม่ต้องแก้ และไม่ทิ้ง hex ของแบรนด์นี้ไว้ให้
// รอบหน้า ป้ายชื่อเป็น <p> ไม่ใช่หัวข้อ เพราะ footer ขึ้นทุกหน้า
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#e01a1a]/35 bg-[#0a0405] pt-16 pb-8 font-sans text-[#e7e3e1]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.14]"
    style="background-image: linear-gradient(#8c0102 1px, transparent 1px), linear-gradient(90deg, #4a5157 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ FUSIONNEW ตัวอักษร FUSION สีเงินและ NEW สีแดง บนแถบสีดำเงา มีสัญลักษณ์ FN สีแดงและเงิน พร้อมข้อความ SPORT BETTING AND CASINO"
                loading="lazy"
                decoding="async"
                widths={[150, 300, 450]}
                sizes="150px"
                class="h-[52px] w-auto drop-shadow-[0_4px_12px_rgba(224,26,26,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="text-3xl font-black tracking-widest text-[#e01a1a]">FUSIONNEW</p>
            )
          }
        </a>
        <p class="border-l-2 border-[#e01a1a] pl-4 text-sm leading-relaxed text-[#c3bcb9]">
          FUSIONNEW สล็อตเจนใหม่ที่รวมเกมดีจากทุกค่ายชั้นนำไว้ในเว็บเดียว จับเกมฮิตติดระดับตำนานมาโคจรพบเกมมาใหม่ล่าสุด สลับฟีลได้ทั้งวันโดยไม่ต้องเปลี่ยนเว็บ ระบบฝากถอนอัตโนมัติทำรายการไว จังหวะสปินต่อเนื่องไม่มีดรอปแม้ช่วงผู้เล่นหนาแน่น
        </p>
        <div class="mt-4 flex gap-3">
          <span class="border border-[#e01a1a]/45 bg-[#1f0c0d] px-3 py-1 font-mono text-xs text-[#ff5f52]">FUSION_ALL_CAMP</span>
          <span class="border border-[#97a0a8]/50 bg-[#1f0c0d] px-3 py-1 font-mono text-xs text-[#d9dde3]">NO_DROP_24H</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#d9dde3] uppercase">/// DIRECTORY</p>
        <ul class="flex flex-col gap-3 font-mono text-sm text-[#c3bcb9]">
          <li><a href="/" class="transition-colors hover:text-[#ff5f52]">> หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#ff5f52]">> โปรโมชั่น</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#ff5f52]">> ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#ff5f52]">> ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#ff5f52]">> เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#ff5f52]">> ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#d9dde3] uppercase">/// SUPPORT_LINK</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          LINE CONNECT
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="/register"
          class="flex w-full items-center justify-center gap-2 bg-gradient-to-r from-[#ff5f52] via-[#e01a1a] to-[#8c0102] py-3 font-black text-[#f7f5f4] transition-all hover:brightness-110"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          สมัครสมาชิก
        </a>

        <div class="mt-2 font-mono text-xs text-[#c3bcb9]">ACCEPTED_PAYMENTS</div>
        <BankStrip size={28} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#e01a1a]/25 pt-6 font-mono text-xs text-[#c3bcb9] md:flex-row">
      <p>SYSTEM_COPYRIGHT &copy; {new Date().getFullYear()} FUSIONNEW</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="hover:text-[#ff5f52]">TERMS_OF_SERVICE</a>
        <a href="/privacy/" class="hover:text-[#ff5f52]">PRIVACY_POLICY</a>
        <a href="#top" class="hover:text-[#ff5f52]">BACK_TO_TOP</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  .font-mono {
    font-family: monospace;
  }
</style>
