---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// โลโก้ตรง fallback เป็น <p> ไม่ใช่หัวข้อ — chrome ห้ามกินแท็กหัวข้อ เพราะรายการ
// h1/h2 ของทุกหน้าถูก diff กับหัวข้อใน docx ตอน verify และ footer ขึ้นทุกหน้า
//
// บล็อก <address> ด้านล่างจงใจไม่ใส่สีของแบรนด์ (ใช้ border-white/15, bg-black/20
// และ opacity ทับสีตัวอักษรที่ inherit มา) — footer ทุก variant ในคลังเป็นพื้นเข้ม
// ทั้งหมด บล็อกนี้จึงลงตัวทุกตัวโดยไม่ต้องแก้ และไม่ทิ้ง hex ของแบรนด์นี้ไว้ให้
// รอบหน้า ป้ายชื่อเป็น <p> ไม่ใช่หัวข้อด้วยเหตุผลเดียวกัน ที่อยู่กับอีเมลมาจาก
// BRAND_ADDRESS ซึ่งผูกกับ BRAND_NAME และ site: ห้ามพิมพ์ทับเอง
//
// VIPSAND356 เป็นเว็บสล็อต ไม่ใช่เว็บหวย — DIRECTORY ด้านล่างจึงไม่มี /ตรวจหวย
// กับ /แนวทาง (สองหน้านั้นอยู่ใน src/pages-disabled/ ไม่มี route จริง)
//
// VIPSAND356: ย้ายจากน้ำเงินรอยัลคู่ทองส้มของแบรนด์ที่เคยใช้ footer ตัวนี้ มาเป็น
// ฟ้าอะซูร์คู่ทองส้มของแบรนด์นี้ — ฟ้า #2a93e0 / #5dbcfe / #a2d2ef / #1465a8 /
// #0b3f70 คู่ทอง #eba554 / #fcde61 / #c07c20 บนผิวกรมท่าเข้ม #061c33 / #103a5f
// เนื้อความ #e6f2ff เมนูรอง #a2d2ef หัวคอลัมน์ #eaf6ff
//
// อาร์ตเวิร์กรอบนี้เป็นป้ายโลโก้ในกรอบทองที่คำว่า VIP เป็นฟ้าใสและ SANDS เป็น
// ส้มทอง — vivid ของ logo.webp (#4aa8eb คู่ #eba554) จึงเป็นสีเน้นจริงทั้งคู่
// ส่วน dominant ของ banner1 ที่เป็นน้ำตาลเข้มคือไม้กับเงาในฉาก ไม่ใช่สีแบรนด์
//
// ห้ามพิมพ์ค่า hex ของแบรนด์ก่อนไว้ในคอมเมนต์นี้ — Tailwind สแกนไฟล์เป็นข้อความ
// ดิบ ไม่รู้ว่าเป็นคอมเมนต์ ดูของเดิมได้จาก git history แทน

const LOGO_ALT =
  "โลโก้ VIPSAND356 เป็นป้ายสามมิติในกรอบทองหนา พื้นในเป็นแผ่นไม้สีน้ำตาล ตัวอักษร VIP เป็นสีฟ้าใสไล่ขาวขอบเข้ม ใต้ลงมาเป็นคำว่า SANDS สีส้มทอง มีไพ่ข้าวหลามตัดกับไพ่ดอกจิกเสียบอยู่ที่ตัว D และล่างสุดเป็นเลข 356 สีฟ้าขาว ด้านบนกรอบมีอัญมณีทรงข้าวหลามตัดสีฟ้า ด้านล่างมีใบปาล์มเขียวและเหรียญทองวางประกอบสองข้าง";
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#2a93e0]/40 bg-[#061c33] pt-16 pb-8 font-sans text-[#e6f2ff]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.14]"
    style="background-image: linear-gradient(#1465a8 1px, transparent 1px), linear-gradient(90deg, #2a93e0 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={LOGO_ALT}
                loading="lazy"
                decoding="async"
                widths={[150, 300, 450]}
                sizes="150px"
                class="h-[52px] w-auto drop-shadow-[0_4px_12px_rgba(42,147,224,0.5)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="text-3xl font-black tracking-widest text-[#a2d2ef]">VIPSAND356</p>
            )
          }
        </a>
        <p class="border-l-2 border-[#eba554] pl-4 text-sm leading-relaxed text-[#a2d2ef]">
          VIPSAND356 เว็บตรงสล็อตพรีเมียมที่เชื่อม API แท้ยิงตรงจากคลังเกมหลักสากล ไม่ผ่านเอเย่นต์ ค่า RTP ตรงตามสเปกโรงงานผู้พัฒนา ไร้การดัดแปลงระบบ ไม่ล็อกยูส
          คัดเฉพาะเกมเกรด A-List มาจัดหมวดหมู่ไว้ในล็อบบี้เดียว พร้อมฝากถอนออโต้ที่ประมวลผลไวใน 3 วินาที และทีมงานดูแลระดับ VIP ตลอด 24 ชั่วโมง
        </p>
        <div class="mt-4 flex gap-3">
          <span class="border border-[#eba554]/50 bg-[#103a5f] px-3 py-1 font-mono text-xs text-[#fcde61]">RTP_TRUE_API</span>
          <span class="border border-[#2a93e0]/50 bg-[#103a5f] px-3 py-1 font-mono text-xs text-[#a2d2ef]">AUTO_3_SEC</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#eaf6ff] uppercase"><span aria-hidden="true">///</span> DIRECTORY</p>
        <ul class="flex flex-col gap-3 font-mono text-sm text-[#a2d2ef]">
          <li><a href="/" class="transition-colors hover:text-[#fcde61]"><span aria-hidden="true">&gt;</span> หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#fcde61]"><span aria-hidden="true">&gt;</span> โปรโมชั่น</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#fcde61]"><span aria-hidden="true">&gt;</span> ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#fcde61]"><span aria-hidden="true">&gt;</span> ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#fcde61]"><span aria-hidden="true">&gt;</span> เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#fcde61]"><span aria-hidden="true">&gt;</span> ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#eaf6ff] uppercase"><span aria-hidden="true">///</span> SUPPORT_LINK</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          LINE CONNECT
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="/register"
          class="flex w-full items-center justify-center gap-2 bg-gradient-to-r from-[#fcde61] via-[#eba554] to-[#c07c20] py-3 font-black text-[#061c33] transition-all hover:brightness-110"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          สมัครสมาชิก
        </a>

        <div class="mt-2 font-mono text-xs text-[#a2d2ef]">ACCEPTED_PAYMENTS</div>
        <BankStrip size={28} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#2a93e0]/30 pt-6 font-mono text-xs text-[#a2d2ef] md:flex-row">
      <p>SYSTEM_COPYRIGHT &copy; {new Date().getFullYear()} VIPSAND356</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="hover:text-[#fcde61]">TERMS_OF_SERVICE</a>
        <a href="/privacy/" class="hover:text-[#fcde61]">PRIVACY_POLICY</a>
        <a href="#top" class="hover:text-[#fcde61]">BACK_TO_TOP</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  .font-mono {
    font-family: monospace;
  }
</style>
