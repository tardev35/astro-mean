---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { brandFlag, brandPick } from "../lib/brandProfile";

// GALA89: this feed variant last shipped the previous brand's neon green + gold
// (#dcffc0 / #8ef04a / #59cb13 / #3b9b0d over #041b06 / #0a2c0d / #0f3a11, muted
// #a8c99a, body #e9f9dc, gold #f6c445) and still carried that brand's name in
// the heading and the section label. Remapped onto this brand's glossy hot pink
// with gold as the second colour — #ffe6f2 / #ff4d9c / #d41c6b / #9e154a over
// #12010a / #1f0311 / #3c0214, muted #f9a8cd, body #f7dce8, gold #f0c274.
//
// Bank swatches are the banks' own brand colours, not this site's palette —
// they stay exactly as they are through every rebrand.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

// Ported off `<script define:vars={{ bankPool }}>` — see src/lib/winnersFeed.ts.
// Rows are server-rendered; values come from the domain hash, never
// Math.random(), which in frontmatter would run at build time and make two
// builds of the same domain differ.
const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const initialRows = Array.from({ length: 4 }, (_, i) => ({
  bank: bankPool[pick(`card-bank-${i}`, bankPool.length)],
  user: `${LETTERS.charAt(pick(`card-a-${i}`, 26))}${LETTERS.charAt(pick(`card-b-${i}`, 26))}***${digits(`card-u${i}`, 4)}`,
  amount: (15000 + pick(`card-amount-${i}`, 80001)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `card-pending-${i}`),
}));

// The two status looks are passed to the feed module as data-* strings so the
// module never has to learn this brand's palette. The "done" pill is near-black
// wine ink on the hot-pink/gold gradient — #2b0210 on #ff4d9c is 6.0:1 and on
// #f0c274 is 11.4:1, while white on either is under 3.
const PENDING_CLASS = "text-[#f9a8cd] bg-[#3c0214] animate-pulse";
const DONE_CLASS = "text-[#2b0210] bg-gradient-to-r from-[#ff4d9c] via-[#f0c274] to-[#ff4d9c] font-black shadow-md";
---

<div class="mx-auto w-full max-w-[1300px] p-4 font-sans">
  <section
    aria-label="รายการถอนเงินล่าสุดของสมาชิก GALA89"
    class="relative overflow-hidden rounded-[30px] border-2 border-[#d41c6b]/25 bg-[#12010a]/92 px-4 py-8 shadow-[0_10px_30px_rgba(212,28,107,0.18)] backdrop-blur-md md:p-10">
    <div class="pointer-events-none absolute -top-10 left-1/2 h-32 w-64 -translate-x-1/2 rounded-full bg-[#9e154a]/35 blur-[50px]"></div>

    <div class="relative z-10 mb-8 flex items-center justify-center gap-3">
      <span aria-hidden="true" class="text-2xl">🏆</span>
      <p class="bg-gradient-to-r from-[#ffe6f2] via-[#ff4d9c] to-[#f0c274] bg-clip-text text-xl font-black tracking-wide text-transparent md:text-3xl">รายการถอนเงินล่าสุดของสมาชิก GALA89</p>
      <span aria-hidden="true" class="text-2xl">🏆</span>
    </div>

    <div
      data-winners-feed
      data-interval="5000"
      data-max-rows="4"
      data-amount-min="15000"
      data-amount-max="95000"
      data-pending-chance="0.4"
      data-user-style="letters"
      data-user-digits="4"
      class="relative z-10 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-card transition-all duration-500 ease-out">
            <div class="flex flex-col rounded-[20px] border border-[#d41c6b]/25 bg-[#1f0311]/95 p-5 shadow-sm transition-all hover:border-[#ff4d9c]/50 hover:bg-[#3c0214]/90">
              <div class="mb-4 flex items-start justify-between">
                <div data-winner-bank class={`flex h-10 w-10 items-center justify-center rounded-full border border-white/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
                </div>
                <div
                  data-winner-status
                  data-pending-text="กำลังดำเนินการ"
                  data-done-text="ถอนสำเร็จแล้ว"
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`rounded-full px-3 py-1 text-[10px] ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? "กำลังดำเนินการ" : "ถอนสำเร็จแล้ว"}
                </div>
              </div>
              <div>
                <div class="text-sm text-[#f9a8cd]">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-[#f7dce8]">
                    {row.user}
                  </span>
                </div>
                <div class="mt-1 text-2xl font-black text-[#ff4d9c]">
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs text-[#f9a8cd]">THB</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <p class="relative z-10 mt-6 text-center text-[11px] tracking-wide text-[#f9a8cd]">
      ก่อนฝากหรือถอนควรตรวจยอด ช่องทาง และชื่อบัญชีรับเงินให้ตรงกับข้อมูลสมาชิก หากรายการยังประมวลผลอยู่ไม่ควรกดซ้ำทันที
    </p>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .winner-card.is-entering {
    transform: scale(0.95);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-card {
      transition: none;
    }
  }
</style>
