---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

const { title, faqs = [] } = Astro.props;

// VIPSAND356: ไฟล์นี้เป็น inventory ที่ถูกธีมไว้ให้แบรนด์เก่าคนละเจ้า (ค่า hex เดิม
// ไม่พิมพ์ไว้ตรงนี้ เพราะ Tailwind สแกนไฟล์เป็นข้อความดิบ ไม่รู้ว่าเป็นคอมเมนต์ จึง
// gen คลาสจากค่าที่ไม่มีใครใช้ออกมาเป็น CSS ตาย ดูของเดิมได้จาก git history) รอบนี้
// ย้ายมาที่ฟ้าอะซูร์คู่ทองส้มของแบรนด์นี้ — ฟ้า #eaf6ff / #a2d2ef / #5dbcfe /
// #2a93e0 / #1465a8 / #0b3f70 คู่ทอง #fcde61 / #eba554 / #c07c20 บนผิว #061c33 /
// #0a2b4a / #103a5f เนื้อความ #e6f2ff
//
// บล็อกนี้เป็น widget ไม่ใช่ section ของ docx — บรรทัดหัวจึงเป็น <p> (คลาสเดิมทุกตัว)
// ไม่ใช่ <h2> และชื่อสำหรับ assistive tech ย้ายไปอยู่ที่ aria-label บน <section>
// ที่ครอบ ถ้าปล่อยให้เป็น <h2> หน้าแรกจะมี h2 เจ็ดตัวทั้งที่ docx มีหัวข้อ H2 หกข้อ
//
// คำถามแต่ละข้ออยู่ใน <span> ภายใน <summary> ไม่ใช่ heading ส่วนการเปิด/ปิดมาจาก
// attribute [open] ของ <details name="…"> ล้วนๆ ห้ามเอา <script> + max-height
// accordion กลับมา
const sectionLabel = title ?? "คำถามที่พบบ่อย";
---

<section aria-label={sectionLabel} class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {title && <p class="mb-8 bg-gradient-to-r from-[#eaf6ff] via-[#a2d2ef] to-[#fcde61] bg-clip-text text-center text-2xl font-black tracking-tight text-transparent md:text-4xl">{title}</p>}

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        // `name` makes this an exclusive accordion natively — opening one closes
        // the rest, which is what the removed script did by hand.
        <details name="faq-plain" class="faq-item group overflow-hidden rounded-xl border border-[#2a93e0]/30 bg-gradient-to-br from-[#103a5f] to-[#061c33] transition-all hover:border-[#5dbcfe]/55">
          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="text-base font-bold text-[#a2d2ef] md:text-lg">{faq.q}</span>
            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#eba554]/45 text-lg leading-none font-black text-[#fcde61] transition-transform duration-300">
              +
            </span>
          </summary>
          <div class="faq-answer border-t border-[#0b3f70]/60 p-5 pt-0 text-left text-base leading-relaxed text-[#e6f2ff]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</section>

<style>
  /* State comes from the [open] attribute now, not from an `active` class a
     script toggles. Note the old rule was `.is-open { transform: rotate(45deg) }`
     — a hand-written class whose name collides with nothing, but which sat one
     grep away from Tailwind's rotate-45 utility. Keying off [open] removes the
     ambiguity along with the script. */
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(42, 147, 224, 0.6);
    box-shadow: 0 0 20px rgba(235, 165, 84, 0.3);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #eba554;
    color: #fcde61;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
